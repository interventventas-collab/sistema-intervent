@page "/stock/ideal"
@attribute [Authorize]
@inject ApiClient Api
@inject ToastService ToastService
@inject IJSRuntime JS
@using System.Globalization
@using Microsoft.AspNetCore.Components.Forms

@* 2026-09-02: "Stock ideal" — cuánto queremos tener siempre de cada producto, para armar
   los pedidos al proveedor. Tres solapas:
     · Para pedir  — la lista que se acumula sola. El producto entra cuando cruza por debajo
                     del ideal y QUEDA hasta que alguien lo marca como pedido, aunque en el
                     medio entren unas pocas unidades (ese caso se perdía antes).
     · Faltantes   — la foto de ahora: los que están por debajo en este momento.
     · Configurar  — la planilla donde se cargan los ideales, a mano o por Excel.
   La lista se refresca sola cada minuto, para el que la deja abierta en el depósito.
   OJO: el "stock ideal" NO es el "stock mínimo para MeLi" (ese vive en la ficha del
   producto y en Stock masivo). Son dos números distintos a propósito. *@
@implements IDisposable

<div class="card">
    <div class="card-header" style="display:flex; justify-content:space-between; align-items:center; flex-wrap:wrap; gap:0.5rem;">
        <div>
            <h3 style="margin:0;">📦 Stock ideal</h3>
            <p class="text-muted" style="margin:0.3rem 0 0; font-size:0.82rem;">
                Lo que hay que pedir para volver a tener el stock que querés tener siempre.
            </p>
        </div>
        <div style="display:flex; gap:0.5rem;">
            <button class="btn btn-secondary" @onclick="Recargar" disabled="@cargando">🔄 Actualizar</button>
            @if (solapa != "config")
            {
                <button class="btn btn-primary" @onclick="BajarExcelPedido" disabled="@(bajandoPedido || SinNadaQuePedir)">
                    @(bajandoPedido ? "Generando..." : "📄 Bajar Excel del pedido")
                </button>
            }
        </div>
    </div>

    @* ===== Solapas ===== *@
    <div style="display:flex; gap:2px; padding:0 1rem; background:#f9fafb; border-bottom:1px solid #e5e7eb; flex-wrap:wrap;">
        <button class="si-tab @(solapa == "pedir" ? "on" : "")" @onclick='() => CambiarSolapa("pedir")'>
            Para pedir@(pendientes is not null ? $" ({pendientes.Total})" : "")
        </button>
        <button class="si-tab @(solapa == "faltantes" ? "on" : "")" @onclick='() => CambiarSolapa("faltantes")'>
            Faltantes ahora@(resumen is not null ? $" ({resumen.Faltantes})" : "")
        </button>
        <button class="si-tab @(solapa == "config" ? "on" : "")" @onclick='() => CambiarSolapa("config")'>
            Configurar los ideales
        </button>
    </div>

    @* ===== Filtros (compartidos por las dos solapas) ===== *@
    <div class="card-body" style="background:#f8fafc; border-bottom:1px solid #e5e7eb; padding:0.8rem 1rem;">
        <div style="display:flex; gap:0.7rem; flex-wrap:wrap; align-items:flex-end;">
            <div style="min-width:170px;">
                <label class="form-label">Marca</label>
                <select class="form-control" @bind="marca" @bind:after="Recargar">
                    <option value="">— Todas —</option>
                    @foreach (var m in marcas)
                    {
                        <option value="@m">@m</option>
                    }
                </select>
            </div>
            <div style="min-width:200px;">
                <label class="form-label">Buscar</label>
                <input type="text" class="form-control" placeholder="código o nombre"
                       @bind="busqueda" @bind:event="oninput" @onkeyup="OnBuscarKeyUp" />
            </div>
            <div style="min-width:140px; @(solapa == "pedir" ? "display:none;" : "")">
                <label class="form-label">Categoría</label>
                <select class="form-control" @bind="categoria" @bind:after="Recargar">
                    <option value="">— Todas —</option>
                    <option value="CAFE">CAFE</option>
                    <option value="OTROS">OTROS</option>
                </select>
            </div>
            <button class="btn btn-secondary" @onclick="Recargar" disabled="@cargando">
                @(cargando ? "Buscando..." : "🔍 Buscar")
            </button>
        </div>
    </div>

    @* ===== Resumen ===== *@
    @if (solapa == "pedir" && pendientes is not null && !cargando)
    {
        <div style="padding:0.7rem 1rem; font-size:0.85rem; color:#374151; border-bottom:1px solid #e5e7eb;">
            @if (pendientes.Total == 0)
            {
                <span>✅ No hay nada anotado para pedir. Los productos entran solos acá cuando su stock queda por debajo del ideal.</span>
            }
            else
            {
                <span>
                    <strong>@pendientes.Total</strong> productos anotados para pedir
                    @if (pendientes.EnCero > 0)
                    {
                        <span style="color:#b91c1c;"> · @pendientes.EnCero en cero</span>
                    }
                    @if (pendientes.YaRepuestos > 0)
                    {
                        <span class="text-muted"> · @pendientes.YaRepuestos ya se repusieron (quedan anotados hasta que los saques)</span>
                    }
                </span>
            }
            <span class="text-muted"> · se actualiza sola cada minuto</span>
        </div>
    }
    else if (solapa != "pedir" && resumen is not null && !cargando)
    {
        <div style="padding:0.7rem 1rem; font-size:0.85rem; color:#374151; border-bottom:1px solid #e5e7eb;">
            @if (resumen.ConIdeal == 0)
            {
                <span>
                    Todavía no cargaste ningún stock ideal.
                    @if (solapa != "config")
                    {
                        <text>Andá a <strong>Configurar los ideales</strong> y poné cuánto querés tener de cada producto.</text>
                    }
                    else
                    {
                        <text>Empezá a poner números en la columna amarilla.</text>
                    }
                </span>
            }
            else if (resumen.Faltantes == 0)
            {
                <span>✅ No falta nada · @resumen.ConIdeal productos con ideal cargado, todos por encima.</span>
            }
            else
            {
                <span>
                    <strong>@resumen.Faltantes</strong> productos abajo del ideal ·
                    faltan <strong>@Num(resumen.UnidadesFaltantes)</strong> en total (entre unidades y kilos)
                    @if (resumen.EnCero > 0)
                    {
                        <span style="color:#b91c1c;"> · @resumen.EnCero en cero</span>
                    }
                    <span class="text-muted"> · @resumen.ConIdeal de @resumen.Total productos tienen ideal cargado</span>
                </span>
            }
        </div>
    }

    @* ===== Contenido ===== *@
    <div class="card-body" style="padding:0;">
        @if (cargando)
        {
            <p class="text-muted" style="padding:1.5rem;">Cargando...</p>
        }
        else if (solapa == "pedir")
        {
            @if (pendientes is null || pendientes.Filas.Count == 0)
            {
                <p class="text-muted" style="padding:1.5rem;">
                    Todavía no hay nada anotado. Cargá el stock ideal de tus productos en
                    <strong>Configurar los ideales</strong> y acá van a ir apareciendo solos los que bajen.
                </p>
            }
            else
            {
                <div style="overflow-x:auto;">
                    <table class="table" style="margin:0; font-size:0.85rem;">
                        <thead>
                            <tr>
                                <th class="si-cod">Código</th>
                                <th class="si-prod">Producto</th>
                                @if (SinFiltroDeMarca)
                                {
                                    <th class="si-marca">Marca</th>
                                }
                                <th class="si-num">Tenía</th>
                                <th class="si-num">Tiene ahora</th>
                                <th class="si-num">Ideal</th>
                                <th class="si-num">Faltan</th>
                                <th class="si-uni"></th>
                                <th class="si-uni">Anotado</th>
                                <th style="width:150px;"></th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var f in pendientes.Filas)
                            {
                                var id = f.Id;
                                <tr style="@(f.YaRepuesto ? "background:#f9fafb;" : "")">
                                    <td class="si-cod"><code>@(string.IsNullOrWhiteSpace(f.Codigo) ? "—" : f.Codigo)</code></td>
                                    <td class="si-prod">
                                        @f.Nombre
                                        @if (f.YaRepuesto)
                                        {
                                            <span class="text-muted" style="font-size:0.75rem;"> · ya repuesto</span>
                                        }
                                    </td>
                                    @if (SinFiltroDeMarca)
                                    {
                                        <td class="si-marca">@(f.Marca ?? "—")</td>
                                    }
                                    <td class="si-num text-muted">@Num(f.StockAlDetectar)</td>
                                    <td class="si-num" style="@(f.StockAhora <= 0 ? "color:#b91c1c; font-weight:700;" : "")">@Num(f.StockAhora)</td>
                                    <td class="si-num" style="color:#6b7280;">@(f.IdealAhora?.ToString() ?? f.IdealAlDetectar.ToString())</td>
                                    <td class="si-num" style="font-weight:700; @(f.Faltan > 0 ? "color:#b91c1c;" : "color:#9ca3af;")">@Num(f.Faltan)</td>
                                    <td class="si-uni text-muted">@(f.Unidad == "kg" ? "kilos" : "unidades")</td>
                                    <td class="si-uni text-muted">@FechaCorta(f.DetectadoAt)</td>
                                    <td style="white-space:nowrap;">
                                        <button class="btn btn-sm btn-primary" style="font-size:0.75rem;"
                                                @onclick="() => MarcarPedido(id)" disabled="@resolviendo">✓ Ya lo pedí</button>
                                        <button class="btn btn-sm btn-secondary" style="font-size:0.75rem;"
                                                title="Sacarlo de la lista sin pedirlo"
                                                @onclick="() => Descartar(id)" disabled="@resolviendo">✕</button>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        }
        else if (solapa == "faltantes")
        {
            @if (filas.Count == 0)
            {
                <p class="text-muted" style="padding:1.5rem;">No hay productos por debajo del stock ideal con esos filtros.</p>
            }
            else
            {
                <div style="overflow-x:auto;">
                    <table class="table" style="margin:0; font-size:0.85rem;">
                        <thead>
                            <tr>
                                <th class="si-cod">Código</th>
                                <th class="si-prod">Producto</th>
                                @if (SinFiltroDeMarca)
                                {
                                    <th class="si-marca">Marca</th>
                                }
                                <th class="si-num">Tenés</th>
                                <th class="si-num">Ideal</th>
                                <th class="si-num">Faltan</th>
                                <th class="si-uni"></th>
                                <th class="si-uni">Última entrada</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var f in filas)
                            {
                                <tr>
                                    <td class="si-cod"><code>@(string.IsNullOrWhiteSpace(f.Codigo) ? "—" : f.Codigo)</code></td>
                                    <td class="si-prod">@f.Nombre</td>
                                    @if (SinFiltroDeMarca)
                                    {
                                        <td class="si-marca">@(f.Marca ?? "—")</td>
                                    }
                                    <td class="si-num" style="@(f.StockActual <= 0 ? "color:#b91c1c; font-weight:700;" : "")">@Num(f.StockActual)</td>
                                    <td class="si-num" style="color:#6b7280;">@(f.StockIdeal?.ToString() ?? "—")</td>
                                    <td class="si-num" style="font-weight:700; color:#b91c1c;">@Num(f.Faltan)</td>
                                    <td class="si-uni text-muted">@(f.Unidad == "kg" ? "kilos" : "unidades")</td>
                                    <td class="si-uni text-muted">@FechaCorta(f.UltimaEntrada)</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        }
        else
        {
            @* ===== Solapa Configurar ===== *@
            <div style="padding:0.8rem 1rem; border-bottom:1px solid #e5e7eb; display:flex; gap:0.5rem; flex-wrap:wrap; align-items:center;">
                <span class="text-muted" style="font-size:0.82rem; flex:1; min-width:240px;">
                    Escribí cuánto querés tener siempre de cada producto. Se guarda solo al salir del casillero.
                    Dejalo vacío para no controlar ese producto. Mirá la columna de la derecha: el café va en
                    <b>kilos</b> y el resto en <b>unidades</b>.
                </span>
                <button class="btn btn-secondary" @onclick="BajarExcelConfig" disabled="@bajandoConfig">
                    @(bajandoConfig ? "Generando..." : "⬇ Bajar Excel")
                </button>
                <label class="btn btn-secondary" style="margin:0; cursor:pointer;">
                    ⬆ Subir Excel
                    <InputFile OnChange="OnArchivoChange" style="display:none;" accept=".xlsx" />
                </label>
            </div>

            @* --- Vista previa del Excel subido --- *@
            @if (errorExcel is not null)
            {
                <div style="padding:0.8rem 1rem; background:#fef2f2; border-bottom:1px solid #fecaca; color:#991b1b; font-size:0.85rem;">
                    @errorExcel
                </div>
            }
            @if (preview is not null)
            {
                <div style="padding:0.8rem 1rem; background:#fffbeb; border-bottom:1px solid #fde68a; font-size:0.85rem;">
                    <div style="margin-bottom:0.5rem;">
                        <strong>Vista previa de @(archivo?.Name ?? "el Excel")</strong> — todavía no se aplicó nada.
                    </div>
                    <div style="margin-bottom:0.6rem;">
                        @preview.Asignan con ideal nuevo · @preview.Quitan a los que se les saca el ideal ·
                        @preview.SinCambios sin cambios
                        @if (preview.NoEncontrados > 0)
                        {
                            <span style="color:#b91c1c;"> · @preview.NoEncontrados filas no se pudieron emparejar</span>
                        }
                    </div>
                    @if (preview.Errores.Count > 0)
                    {
                        <ul style="margin:0 0 0.6rem; padding-left:1.2rem; color:#92400e;">
                            @foreach (var e in preview.Errores.Take(10))
                            {
                                <li>@e</li>
                            }
                        </ul>
                    }
                    @if (preview.Cambios.Count > 0)
                    {
                        <div style="max-height:220px; overflow:auto; background:#fff; border:1px solid #fde68a; border-radius:6px; margin-bottom:0.6rem;">
                            <table class="table" style="margin:0; font-size:0.8rem;">
                                <thead><tr><th>Código</th><th>Producto</th><th style="text-align:right;">Antes</th><th style="text-align:right;">Ahora</th></tr></thead>
                                <tbody>
                                    @foreach (var c in preview.Cambios.Take(200))
                                    {
                                        <tr>
                                            <td><code>@(c.Codigo ?? "—")</code></td>
                                            <td>@c.Descripcion</td>
                                            <td style="text-align:right; color:#6b7280;">@(c.IdealViejo?.ToString() ?? "—")</td>
                                            <td style="text-align:right; font-weight:600;">@(c.IdealNuevo?.ToString() ?? "sin ideal")</td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                        @if (preview.Cambios.Count > 200)
                        {
                            <p class="text-muted" style="margin:0 0 0.6rem; font-size:0.8rem;">(se muestran los primeros 200 de @preview.Cambios.Count)</p>
                        }
                    }
                    <div style="display:flex; gap:0.5rem;">
                        <button class="btn btn-primary" @onclick="AplicarExcel" disabled="@(procesando || preview.Cambios.Count == 0)">
                            @(procesando ? "Aplicando..." : $"Aplicar {preview.Cambios.Count} cambios")
                        </button>
                        <button class="btn btn-secondary" @onclick="CancelarExcel" disabled="@procesando">Cancelar</button>
                    </div>
                </div>
            }

            @if (filas.Count == 0)
            {
                <p class="text-muted" style="padding:1.5rem;">No hay productos con esos filtros.</p>
            }
            else
            {
                <div style="overflow-x:auto;">
                    <table class="table" style="margin:0; font-size:0.85rem;">
                        <thead>
                            <tr>
                                <th class="si-cod">Código</th>
                                <th class="si-prod">Producto</th>
                                @if (SinFiltroDeMarca)
                                {
                                    <th class="si-marca">Marca</th>
                                }
                                <th class="si-num">Stock hoy</th>
                                <th class="si-num">Stock ideal</th>
                                <th class="si-uni"></th>
                                <th style="width:90px;"></th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var f in filas)
                            {
                                var pid = f.ProductoId;
                                <tr>
                                    <td class="si-cod"><code>@(string.IsNullOrWhiteSpace(f.Codigo) ? "—" : f.Codigo)</code></td>
                                    <td class="si-prod">@f.Nombre</td>
                                    @if (SinFiltroDeMarca)
                                    {
                                        <td class="si-marca">@(f.Marca ?? "—")</td>
                                    }
                                    <td class="si-num" style="@(f.StockActual <= 0 ? "color:#b91c1c; font-weight:700;" : "")">@Num(f.StockActual)</td>
                                    <td class="si-num">
                                        <input type="text" inputmode="numeric" class="si-input @(f.StockIdeal.HasValue ? "set" : "")"
                                               value="@(edits.TryGetValue(pid, out var v) ? v : (f.StockIdeal?.ToString() ?? ""))"
                                               placeholder="—"
                                               @onchange="@(e => OnIdealChange(pid, e.Value?.ToString()))" />
                                    </td>
                                    <td class="si-uni text-muted">@(f.Unidad == "kg" ? "kilos" : "unidades")</td>
                                    <td style="font-size:0.75rem;">
                                        @if (guardados.Contains(pid))
                                        {
                                            <span style="color:#16a34a;">guardado</span>
                                        }
                                        else if (!f.StockIdeal.HasValue)
                                        {
                                            <span class="text-muted">sin ideal</span>
                                        }
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        }
    </div>
</div>

<style>
.si-tab {
    background:transparent; border:none; border-bottom:2px solid transparent;
    padding:0.65rem 1rem; font-size:0.88rem; color:#6b7280; cursor:pointer;
}
.si-tab.on { color:#111827; font-weight:600; border-bottom-color:#2563eb; background:#fff; }
.si-input {
    width:80px; border:1px solid #d1d5db; border-radius:6px;
    padding:0.25rem 0.45rem; text-align:right; font-size:0.85rem;
}
.si-input.set { background:#fffbeb; border-color:#fcd34d; }
/* Las columnas se pisaban ("MARCA STOCK HOY" pegado): el nombre del producto se comia todo
   el ancho. Los numeros y las etiquetas van en una sola linea y con aire a la izquierda. */
.si-num { text-align:right; white-space:nowrap; padding-left:1.1rem !important; }
.si-uni { white-space:nowrap; font-size:0.78rem; padding-left:0.8rem !important; }
.si-cod { white-space:nowrap; }
.si-marca { white-space:nowrap; padding-left:0.8rem !important; }
.si-prod { min-width:220px; }
</style>

@code {
    // Arranca en "Para pedir": es la lista que se usa todos los días.
    private string solapa = "pedir";
    private bool cargando;
    private bool resolviendo;
    private StockIdealPendientesResultDto? pendientes;
    private System.Threading.Timer? autoRefresh;
    // Cada minuto: alcanza para el que la deja abierta en el depósito y no castiga a la API.
    private const int SegundosRefresco = 60;
    private string? marca;
    private string? categoria;
    private string busqueda = "";

    private List<string> marcas = new();
    private List<StockIdealRowDto> filas = new();
    private StockIdealListResultDto? resumen;

    // Lo que el usuario está tipeando en la planilla (por producto), para que no se pierda
    // si la fila se vuelve a dibujar antes de que llegue la respuesta del guardado.
    private readonly Dictionary<int, string> edits = new();
    private readonly HashSet<int> guardados = new();

    private bool bajandoPedido, bajandoConfig, procesando;
    private IBrowserFile? archivo;
    private byte[]? archivoBytes;
    private StockIdealPreviewDto? preview;
    private string? errorExcel;

    protected override async Task OnInitializedAsync()
    {
        await CargarAsync();
        // Refresco solo: si el stock se mueve mientras la pantalla está abierta, la lista se
        // actualiza sin que nadie toque nada. No corre en la solapa de configurar, para no
        // pisarle lo que está tipeando.
        autoRefresh = new System.Threading.Timer(async _ =>
        {
            if (cargando || solapa == "config") return;
            await InvokeAsync(async () =>
            {
                await CargarAsync(silencioso: true);
                StateHasChanged();
            });
        }, null, TimeSpan.FromSeconds(SegundosRefresco), TimeSpan.FromSeconds(SegundosRefresco));
    }

    public void Dispose() => autoRefresh?.Dispose();

    /// <summary>Con qué se llena el botón de Excel y si tiene sentido habilitarlo.</summary>
    private bool SinNadaQuePedir => solapa == "pedir"
        ? (pendientes is null || pendientes.Filas.Count(f => f.Faltan > 0) == 0)
        : (resumen is null || resumen.Faltantes == 0);

    private async Task CambiarSolapa(string s)
    {
        if (solapa == s) return;
        solapa = s;
        CancelarExcel();
        await CargarAsync();
    }

    /// <summary>silencioso = viene del refresco automático: no muestra el "Cargando..." ni
    /// molesta con un cartel de error si justo falló la red.</summary>
    private async Task CargarAsync(bool silencioso = false)
    {
        if (!silencioso) cargando = true;
        try
        {
            if (solapa == "pedir")
            {
                var pend = await Api.GetStockIdealPendientesAsync(marca, busqueda);
                if (pend is null)
                {
                    if (!silencioso) ToastService.Error("No se pudo cargar la lista");
                    return;
                }
                // Si el refresco encontró productos nuevos, avisar: es la gracia de la pantalla.
                if (silencioso && pend.NuevosEnganchados > 0)
                    ToastService.Info(pend.NuevosEnganchados == 1
                        ? "Entró un producto nuevo a la lista para pedir"
                        : $"Entraron {pend.NuevosEnganchados} productos nuevos a la lista para pedir");
                pendientes = pend;
                // Las marcas para el filtro salen de la otra consulta; si todavía no están, se piden.
                if (marcas.Count == 0)
                {
                    var res0 = await Api.GetStockIdealListaAsync(true, null, null, null);
                    if (res0 is not null && res0.Marcas.Count > 0) marcas = res0.Marcas;
                }
                return;
            }

            edits.Clear();
            guardados.Clear();
            // En Faltantes solo se traen los que están abajo del ideal; en Configurar, todos.
            var res = await Api.GetStockIdealListaAsync(
                soloFaltantes: solapa == "faltantes",
                marca: marca, q: busqueda, categoria: categoria);
            if (res is null)
            {
                if (!silencioso) ToastService.Error("No se pudo cargar la lista");
                return;
            }
            resumen = res;
            filas = res.Filas;
            if (res.Marcas.Count > 0) marcas = res.Marcas;
        }
        catch (Exception ex)
        {
            if (!silencioso) ToastService.Error("Error: " + ex.Message);
        }
        finally { if (!silencioso) cargando = false; }
    }

    /// <summary>"Ya lo pedí": sale de la lista y queda registrado quién y cuándo.</summary>
    private async Task MarcarPedido(int id)
    {
        resolviendo = true;
        try
        {
            if (await Api.MarcarStockIdealPedidoAsync(id))
            {
                pendientes?.Filas.RemoveAll(f => f.Id == id);
                if (pendientes is not null) pendientes.Total = pendientes.Filas.Count;
                ToastService.Success("Anotado como pedido");
            }
            else ToastService.Error("No se pudo marcar");
        }
        catch (Exception ex) { ToastService.Error("Error: " + ex.Message); }
        finally { resolviendo = false; }
    }

