    /// <summary>Lee lo que tipearon. Devuelve (false, _) si no es un número.
    /// Aguanta el "1.500" con punto de miles.</summary>
    private bool LeerNumero(string texto, out int? valor)
    {
        valor = null;
        if (texto.Length == 0) return true;
        var limpio = texto.Replace(".", "").Replace(" ", "");
        if (!int.TryParse(limpio, NumberStyles.Any, CultureInfo.InvariantCulture, out var n))
            return false;
        valor = Math.Max(0, n);
        return true;
    }

    /// <summary>Guarda el PISO de una fila al salir del casillero. Vacío = sin piso (avisa con el ideal).</summary>
    private async Task OnPisoChange(int productoId, string? valor)
    {
        var texto = (valor ?? "").Trim();
        editsPiso[productoId] = texto;

        if (!LeerNumero(texto, out var nuevo))
        {
            ToastService.Error($"'{texto}' no es un número");
            editsPiso.Remove(productoId);
            return;
        }

        var fila = filas.FirstOrDefault(f => f.ProductoId == productoId);
        if (fila is not null && fila.StockPiso == nuevo) { editsPiso.Remove(productoId); return; }

        try
        {
            var req = new StockIdealBulkRequestDto
            {
                Items = new List<StockIdealBulkItemDto>
                {
                    // TocaIdeal=false: si no, guardar el piso le borraría el ideal.
                    new StockIdealBulkItemDto
                    {
                        ProductoId = productoId, StockPiso = nuevo,
                        TocaPiso = true, TocaIdeal = false
                    }
                }
            };
            var res = await Api.SaveStockIdealBulkAsync(req);
            if (res is null) { ToastService.Error("No se pudo guardar"); return; }

            if (fila is not null)
            {
                fila.StockPiso = nuevo;
                RecalcularFila(fila);
            }
            editsPiso.Remove(productoId);
            guardados.Add(productoId);
            pendientes = null;
        }
        catch (Exception ex) { ToastService.Error("Error al guardar: " + ex.Message); }
    }

    /// <summary>Guarda el ideal de una fila apenas el usuario sale del casillero.
    /// Vacío = sacarle el ideal. Texto que no sea número = se ignora y se deja como estaba.</summary>
    private async Task OnIdealChange(int productoId, string? valor)
    {
        var texto = (valor ?? "").Trim();
        edits[productoId] = texto;

        if (!LeerNumero(texto, out var nuevo))
        {
            ToastService.Error($"'{texto}' no es un número");
            edits.Remove(productoId);
            return;
        }

        var fila = filas.FirstOrDefault(f => f.ProductoId == productoId);
        if (fila is not null && fila.StockIdeal == nuevo) { edits.Remove(productoId); return; }

        try
        {
            var req = new StockIdealBulkRequestDto
            {
                Items = new List<StockIdealBulkItemDto>
                {
                    new StockIdealBulkItemDto { ProductoId = productoId, StockIdeal = nuevo, TocaIdeal = true }
                }
            };
            var res = await Api.SaveStockIdealBulkAsync(req);
            if (res is null) { ToastService.Error("No se pudo guardar"); return; }

            // Actualizo la fila en memoria para no tener que recargar toda la lista (recargar
            // mientras está tipeando le sacaría el foco del casillero).
            if (fila is not null)
            {
                bool teniaIdeal = fila.StockIdeal.HasValue;
                fila.StockIdeal = nuevo;
                RecalcularFila(fila);
                if (resumen is not null)
                {
                    if (!teniaIdeal && nuevo.HasValue) resumen.ConIdeal++;
                    else if (teniaIdeal && !nuevo.HasValue && !fila.StockPiso.HasValue) resumen.ConIdeal--;
                }
            }
            edits.Remove(productoId);
            guardados.Add(productoId);
            // El contador de "Para pedir" queda viejo: los productos se enganchan recién cuando
            // se abre esa solapa. Lo dejo sin número en vez de mostrar uno que miente.
            pendientes = null;
        }
        catch (Exception ex) { ToastService.Error("Error al guardar: " + ex.Message); }
    }

    /// <summary>Vuelve a sacar la cuenta de una fila y acomoda los contadores de arriba.
    /// La regla es la misma que en el servidor: dispara el PISO (o el ideal si no hay piso),
    /// y se pide hasta el IDEAL. Si esto se desincroniza del backend, la pantalla miente.</summary>
    private void RecalcularFila(StockIdealRowDto fila)
    {
        bool faltabaAntes = fila.Faltan > 0;
        decimal faltabanAntes = fila.Faltan;

        // Misma regla que el servidor: con piso se avisa al TOCARLO (<=); sin piso, al bajar
        // del ideal (<). Ver StockFaltantesService.HayQuePedir.
        bool hayQuePedir = fila.StockPiso.HasValue
            ? fila.StockActual <= fila.StockPiso.Value
            : fila.StockIdeal.HasValue && fila.StockActual < fila.StockIdeal.Value;

        decimal ahora = 0m;
        if (hayQuePedir)
        {
            var hasta = fila.StockIdeal ?? fila.StockPiso ?? 0;
            ahora = Math.Max(0m, hasta - fila.StockActual);
        }
        fila.Faltan = ahora;

        if (resumen is null) return;
        bool faltaAhora = fila.Faltan > 0;
        if (faltaAhora != faltabaAntes)
        {
            resumen.Faltantes += faltaAhora ? 1 : -1;
            if (fila.StockActual <= 0) resumen.EnCero += faltaAhora ? 1 : -1;
        }
        resumen.UnidadesFaltantes += fila.Faltan - faltabanAntes;
    }

