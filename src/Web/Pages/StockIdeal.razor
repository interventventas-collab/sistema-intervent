    /// <summary>Guarda el ideal de una fila apenas el usuario sale del casillero.
    /// Vacío = sacarle el ideal. Texto que no sea número = se ignora y se deja como estaba.</summary>
    private async Task OnIdealChange(int productoId, string? valor)
    {
        var texto = (valor ?? "").Trim();
        edits[productoId] = texto;

        int? nuevo;
        if (texto.Length == 0) nuevo = null;
        else
        {
            // Aguanta que escriban "1.500" (separador de miles argentino).
            var limpio = texto.Replace(".", "").Replace(" ", "");
            if (!int.TryParse(limpio, NumberStyles.Any, CultureInfo.InvariantCulture, out var n))
            {
                ToastService.Error($"'{texto}' no es un número");
                edits.Remove(productoId);
                return;
            }
            nuevo = Math.Max(0, n);
        }

        var fila = filas.FirstOrDefault(f => f.ProductoId == productoId);
        if (fila is not null && fila.StockIdeal == nuevo) { edits.Remove(productoId); return; }

        try
        {
            var req = new StockIdealBulkRequestDto
            {
                Items = new List<StockIdealBulkItemDto>
                {
                    new StockIdealBulkItemDto { ProductoId = productoId, StockIdeal = nuevo }
                }
            };
            var res = await Api.SaveStockIdealBulkAsync(req);
            if (res is null) { ToastService.Error("No se pudo guardar"); return; }

            // Actualizo la fila en memoria para no tener que recargar toda la lista (recargar
            // mientras está tipeando le sacaría el foco del casillero).
            if (fila is not null)
            {
                bool teniaIdeal = fila.StockIdeal.HasValue;
                bool faltabaAntes = fila.Faltan > 0;
                decimal faltabanAntes = fila.Faltan;

                fila.StockIdeal = nuevo;
                fila.Faltan = nuevo.HasValue ? Math.Max(0m, nuevo.Value - fila.StockActual) : 0m;

                // Y los contadores de arriba, si no el cartel sigue diciendo "todavía no
                // cargaste ningún stock ideal" cuando ya cargaste diez.
                if (resumen is not null)
                {
                    if (!teniaIdeal && nuevo.HasValue) resumen.ConIdeal++;
                    else if (teniaIdeal && !nuevo.HasValue) resumen.ConIdeal--;

                    bool faltaAhora = fila.Faltan > 0;
                    if (faltaAhora != faltabaAntes)
                    {
                        resumen.Faltantes += faltaAhora ? 1 : -1;
                        if (fila.StockActual <= 0) resumen.EnCero += faltaAhora ? 1 : -1;
                    }
                    resumen.UnidadesFaltantes += fila.Faltan - faltabanAntes;
                }
            }
            edits.Remove(productoId);
            guardados.Add(productoId);
            // El contador de "Para pedir" queda viejo: los productos se enganchan recién cuando
            // se abre esa solapa. Lo dejo sin número en vez de mostrar uno que miente.
            pendientes = null;
        }
        catch (Exception ex) { ToastService.Error("Error al guardar: " + ex.Message); }
    }

