    private async Task OnArchivoChange(InputFileChangeEventArgs e)
    {
        errorExcel = null; preview = null; archivoBytes = null;
        archivo = e.File;
        try
        {
            using var src = archivo.OpenReadStream(maxAllowedSize: 100_000_000);
            using var ms = new MemoryStream();
            await src.CopyToAsync(ms);
            archivoBytes = ms.ToArray();

            // Muestro la vista previa sola, sin pedir otro clic.
            using var ms2 = new MemoryStream(archivoBytes);
            preview = await Api.PreviewStockIdealAsync(ms2, archivo.Name);
        }
        catch (Exception ex) { errorExcel = "No pude leer el archivo: " + ex.Message; archivo = null; }
    }

    private async Task AplicarExcel()
    {
        if (archivoBytes is null) return;
        procesando = true; errorExcel = null;
        try
        {
            using var ms = new MemoryStream(archivoBytes);
            var res = await Api.ApplyStockIdealAsync(ms, archivo?.Name ?? "stock-ideal.xlsx");
            if (res is not null)
            {
                ToastService.Success($"Listo: {res.Actualizados} con ideal, {res.Quitados} sin ideal");
                CancelarExcel();
                await CargarAsync();
            }
        }
        catch (Exception ex) { errorExcel = ex.Message; }
        finally { procesando = false; }
    }

    private void CancelarExcel()
    {
        preview = null; archivo = null; archivoBytes = null; errorExcel = null;
    }

    /// <summary>Muestra el número lindo: sin decimales si es entero, con coma si tiene kilos partidos.</summary>
    private static string Num(decimal v)
    {
        var ar = CultureInfo.GetCultureInfo("es-AR");
        return v == Math.Truncate(v) ? v.ToString("N0", ar) : v.ToString("N2", ar);
    }

    private static string FechaCorta(DateTime? utc)
    {
        if (utc is null) return "—";
        // Las fechas se guardan en UTC; se muestran en hora argentina.
        return utc.Value.AddHours(-3).ToString("dd/MM/yy");
    }
