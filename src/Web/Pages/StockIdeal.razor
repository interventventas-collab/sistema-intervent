    /// <summary>Enter baja al mismo casillero de la fila siguiente, para cargar de corrido sin mouse.
    /// El salto se hace por JS porque Blazor no tiene forma directa de mover el foco a otro elemento.</summary>
    private async Task OnCasilleroKeyDown(KeyboardEventArgs e, int productoId, string campo)
    {
        if (e.Key != "Enter") return;
        var idx = filas.FindIndex(f => f.ProductoId == productoId);
        if (idx < 0 || idx + 1 >= filas.Count) return;
        var siguiente = filas[idx + 1].ProductoId;
        try { await JS.InvokeVoidAsync("focusCasilleroStock", siguiente, campo); }
        catch { /* si falla, no pasa nada: se sigue pudiendo con Tab */ }
    }

    /// <summary>Botón "piso = mitad del ideal": lo aplica a TODO lo que esté filtrado y tenga ideal.
    /// Es la regla que viene usando a mano (6/3, 4/2, 50.000/25.000), así carga de a muchos.</summary>
    private async Task PonerPisoMitad()
    {
        var candidatos = filas.Where(f => f.StockIdeal.HasValue && f.StockIdeal.Value > 0).ToList();
        if (candidatos.Count == 0)
        {
            ToastService.Info("Primero cargá el stock ideal: el piso se calcula a partir de él.");
            return;
        }

        // Los que ya tienen justo la mitad no se tocan.
        var cambios = candidatos
            .Select(f => new { Fila = f, Mitad = Math.Max(1, (int)Math.Round(f.StockIdeal!.Value / 2.0)) })
            .Where(x => x.Fila.StockPiso != x.Mitad)
            .ToList();
        if (cambios.Count == 0)
        {
            ToastService.Info("Ya están todos con el piso en la mitad del ideal.");
            return;
        }

        var ejemplo = cambios.First();
        if (!await Confirmar($"Voy a poner el piso en la mitad del ideal en {cambios.Count} productos. " +
                             $"Por ejemplo: {ejemplo.Fila.Nombre} pasa a piso {Miles(ejemplo.Mitad)} (ideal {Miles(ejemplo.Fila.StockIdeal)}). ¿Sigo?"))
            return;

        aplicandoMitad = true;
        try
        {
            var req = new StockIdealBulkRequestDto
            {
                Items = cambios.Select(x => new StockIdealBulkItemDto
                {
                    ProductoId = x.Fila.ProductoId,
                    StockPiso = x.Mitad,
                    TocaPiso = true,
                    TocaIdeal = false,
                }).ToList()
            };
            var res = await Api.SaveStockIdealBulkAsync(req);
            if (res is null) { ToastService.Error("No se pudo guardar"); return; }

            foreach (var x in cambios)
            {
                x.Fila.StockPiso = x.Mitad;
                RecalcularFila(x.Fila);
                guardados.Add(x.Fila.ProductoId);
            }
            editsPiso.Clear();
            pendientes = null;
            ToastService.Success($"Listo: {cambios.Count} productos con el piso en la mitad del ideal");
        }
        catch (Exception ex) { ToastService.Error("Error: " + ex.Message); }
        finally { aplicandoMitad = false; }
    }

