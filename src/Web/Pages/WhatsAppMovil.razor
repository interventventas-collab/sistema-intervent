@page "/whatsapp-movil"
@page "/wa"
@attribute [Authorize]
@layout Web.Layout.EmptyLayout
@using Web.Services
@inject ApiClient Api
@inject NavigationManager Nav
@inject Microsoft.JSInterop.IJSRuntime JS
@inject Web.Services.WaAparienciaService Apariencia
@inject Web.Services.PresenceService Vivo
@implements IDisposable

@* 2026-08-06: pantalla DEDICADA de WhatsApp para el celu (como las que usan los repartidores).
   Sin menú ni escritorio atrás: solo el WhatsApp, a pantalla completa. Buscás una conversación,
   la abrís y respondés (texto + nota de voz, vía PinnedWaChat). El enlace/QR para el celu apunta
   acá: https://app.palanica.com.ar/whatsapp-movil (o /wa). Necesita estar logueado. *@

@* 2026-08-18: PWA — se puede agregar a la pantalla de inicio del celu (hace falta en iPhone
   para que lleguen los avisos con la pantalla cerrada, y en Android queda como una app mas). *@
<HeadContent>
    <link rel="manifest" href="/manifest-wa.json" />
    <meta name="theme-color" content="#075e54" />
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent" />
    @* 2026-08-19: se llama "Frisaap" y usa ícono propio (blanco con el globito en negro) para no
       confundirse con el WhatsApp de verdad en la pantalla de inicio del celu. *@
    <meta name="apple-mobile-web-app-title" content="Frisaap" />
    <link rel="apple-touch-icon" href="/img/frisaap-icon.png" />
    <title>Frisaap · FRIKAF</title>
</HeadContent>

@if (!desbloqueado)
{
    @* Candado de la pantalla. 2026-08-19: la HUELLA es la forma principal de entrar (lo pidió el
       dueño por seguridad); el código de 4 dígitos queda de respaldo, escondido detrás de un enlace.
       Si el teléfono no ofrece huella, se muestra directamente el teclado. *@
    <div class="wam-lock">
        <div class="wam-lock-card">
            <div class="wam-lock-ic">💬</div>
            <div class="wam-lock-title">WhatsApp</div>

            @if (!modoClave)
            {
                @* ── Entrada principal: la huella ── *@
                <div class="wam-lock-sub">Entrá con tu huella</div>
                <button type="button" class="wam-huella-grande" @onclick="EntrarConHuella" disabled="@(verificando || huellaOcupada)">
                    <span class="wam-huella-ic">👆</span>
                    <span>@(huellaOcupada ? "Tocá el lector…" : "Entrar con huella")</span>
                </button>
                <div class="wam-lock-foot">@(verificando ? "Verificando…" : huellaMsg)</div>
                <button type="button" class="wam-lock-link" @onclick="@(() => { modoClave = true; huellaMsg = null; })">
                    Usar el código de 4 dígitos
                </button>
            }
            else
            {
                @* ── Respaldo: el código de siempre ── *@
                <div class="wam-lock-sub">
                    @(modoRegistroHuella ? "Poné tu código para registrar la huella" : "Ingresá tu código de 4 dígitos")
                </div>
                @if (modoRegistroHuella)
                {
                    @* 2026-08-19: cartel bien visible, para que no haya dudas de en qué modo está. *@
                    <div class="wam-lock-modo">👆 Registrando huella — al completar el código, el celu te va a pedir el dedo</div>
                }
                <div class="wam-lock-dots">
                    @for (int i = 0; i < 4; i++)
                    {
                        <span class="wam-dot @(pin.Length > i ? "on" : "")"></span>
                    }
                </div>
                @if (!string.IsNullOrEmpty(pinError))
                {
                    <div class="wam-lock-err">@pinError</div>
                }
                <div class="wam-keys">
                    @foreach (var d in new[] { "1", "2", "3", "4", "5", "6", "7", "8", "9" })
                    {
                        <button type="button" class="wam-key" @onclick="() => Tecla(d)" disabled="@verificando">@d</button>
                    }
                    <span></span>
                    <button type="button" class="wam-key" @onclick='() => Tecla("0")' disabled="@verificando">0</button>
                    <button type="button" class="wam-key wam-key-del" @onclick="Borrar" disabled="@verificando">⌫</button>
                </div>
                <div class="wam-lock-foot">@(verificando ? "Verificando…" : huellaMsg)</div>
                <div class="wam-huella">
                    @if (modoRegistroHuella)
                    {
                        <button type="button" class="wam-lock-link" @onclick="CancelarRegistroHuella">Cancelar el registro</button>
                    }
                    else
                    {
                        @* Registrar la huella necesita el código: se toca acá y el teclado lo pide. *@
                        <button type="button" class="wam-huella-reg" @onclick="RegistrarHuella" disabled="@(verificando || huellaOcupada)"
                                title="Tocá acá y poné tu código: el celu te va a pedir la huella">👆 Registrar mi huella en este celu</button>
                        @if (huellaDisponible)
                        {
                            <button type="button" class="wam-lock-link" @onclick="@(() => { modoClave = false; pinError = null; huellaMsg = null; })">
                                Volver a la huella
                            </button>
                        }
                    }
                </div>
            }
        </div>
    </div>
}
else
{
@* 2026-08-15: se ve claro u oscuro según la línea con la que estás trabajando. *@
<div class="wam-root @Apariencia.ClasesPara(chatAbierto?.Linea ?? filtroLinea)">
    <div class="wam-header">
        @if (chatAbierto is not null)
        {
            <button type="button" class="wam-hbtn" @onclick="Volver" title="Volver a la lista">←</button>
            <span class="wam-title" title="@NombreDe(chatAbierto)">@NombreDe(chatAbierto)</span>
        }
        else
        {
            <svg viewBox="0 0 24 24" fill="currentColor" width="24" height="24" aria-hidden="true" style="flex:none;">
                <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51l-.57-.01c-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.872.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/>
            </svg>
            <span class="wam-title">WhatsApp</span>
            <div class="wam-head-actions">
                <button type="button" class="wam-bell" @onclick="ToggleAvisos"
                        title="@(avisos ? "Avisos activados (tocá para silenciar)" : "Avisos silenciados (tocá para activar)")">
                    @(avisos ? "🔔" : "🔕")
                </button>
                @* 2026-08-18: avisos con la pantalla CERRADA (se instala el aviso en el celu) *@
                <button type="button" class="wam-bell @(pushActivo ? "on" : "")" @onclick="TogglePush" disabled="@pushOcupado"
                        title="@(pushActivo ? "Este celular recibe avisos aunque cierres la pantalla (tocá para apagarlo)" : "Recibir avisos aunque cierres la pantalla")">
                    @(pushOcupado ? "⏳" : (pushActivo ? "📳" : "📴"))
                </button>
                @if (!string.IsNullOrEmpty(persona))
                {
                    <button type="button" class="wam-persona" @onclick="CambiarPersona" title="No soy yo / cambiar de persona">@persona ✕</button>
                }
            </div>
        }
    </div>

    @if (chatAbierto is null)
    {
        @* Selector de LÍNEA (chips) — solo si hay más de una *@
        var _lineas = LineasDisponibles();
        if (_lineas.Count > 1)
        {
            <div class="wam-lineas">
                <button type="button" class="wam-linea-chip @(filtroLinea == null ? "on" : "")" @onclick="@(() => filtroLinea = null)">Todas</button>
                @foreach (var l in _lineas)
                {
                    <button type="button" class="wam-linea-chip @(filtroLinea == l.Id ? "on" : "")" @onclick="@(() => filtroLinea = l.Id)">@l.Nombre</button>
                }
            </div>
        }
        @if (!string.IsNullOrEmpty(pushMsg))
        {
            <div class="wam-pushmsg" @onclick="@(() => pushMsg = null)">@pushMsg <span style="opacity:.6">(tocá para cerrar)</span></div>
        }
        <div class="wam-search">
            @* 2026-08-18: sin autofocus. Antes el teclado del celu saltaba solo al abrir la
               pantalla y tapaba media lista, que no es lo que hace WhatsApp. *@
            <input class="wam-search-input" placeholder="Buscar por nombre o número…"
                   @bind="busqueda" @bind:event="oninput" />
        </div>
        <div class="wam-list">
            @if (cargando && convs.Count == 0)
            {
                <div class="wam-vacio">Cargando conversaciones…</div>
            }
            else
            {
                var filtradas = Filtradas().ToList();
                if (filtradas.Count == 0)
                {
                    <div class="wam-vacio">@(string.IsNullOrWhiteSpace(busqueda) ? "Todavía no hay conversaciones." : "No encontré ninguna conversación con eso.")</div>
                }
                else
                {
                    foreach (var c in filtradas)
                    {
                        var sinLeer = NoLeido(c);
                        <div class="wam-conv @(sinLeer ? "nuevo" : "") @(c.Fijado ? "fijado" : "")" @onclick="() => AbrirChat(c)">
                            <div class="wam-avatar">@Inicial(c)</div>
                            <div class="wam-conv-txt">
                                <div class="wam-conv-nombre" title="@NombreDe(c)">@(c.Fijado ? "📌 " : "")@NombreDe(c)</div>
                                <div class="wam-conv-ultimo">@Recortar(UltimoTexto(c), 44)</div>
                            </div>
                            <div class="wam-conv-meta">
                                <div class="wam-conv-hora">@FormatHoraLista(c.UltimoAt)</div>
                                @if (sinLeer)
                                {
                                    <span class="wam-conv-punto" title="Mensaje sin leer"></span>
                                }
                            </div>
                            @* 2026-08-19: chinche para fijar el chat arriba de todo (hasta 5, igual
                               que en la pantalla grande; lo que fijás acá se ve tambien alla). *@
                            <button class="wam-conv-pin @(c.Fijado ? "on" : "")" type="button"
                                    title="@(c.Fijado ? "Sacar de los fijados" : "Fijar arriba de todo")"
                                    @onclick:stopPropagation="true" @onclick="() => FijarChat(c)">📌</button>
                        </div>
                    }
                }
            }
        </div>
    }
    else
    {
        <div class="wam-chat">
            <PinnedWaChat Numero="@chatAbierto.Numero" LineaPhoneId="@chatAbierto.Linea"
                          TituloContacto="@NombreDe(chatAbierto)"
                          NombreLinea="@(chatAbierto.LineaNumero ?? chatAbierto.Linea ?? "WhatsApp")"
                          PuedeAbrirEnGrande="false" AccionesCompletas="true" Movil="true" />
        </div>
    }
</div>
}

<style>
    .wam-root { position: fixed; inset: 0; display: flex; flex-direction: column;
        background: #efeae2; overflow: hidden; }
    .wam-header { display: flex; align-items: center; gap: 10px; flex: 0 0 auto;
        background: #075e54; color: #fff; padding: 12px 14px; padding-top: max(12px, env(safe-area-inset-top)); }
    .wam-title { font-weight: 800; font-size: 1.05rem; flex: 1;
        white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
    .wam-hbtn { background: rgba(255,255,255,0.18); border: none; color: #fff; border-radius: 8px;
        width: 34px; height: 32px; font-size: 1.1rem; cursor: pointer; flex: none; }

    .wam-lineas { display: flex; gap: 8px; flex-wrap: wrap; padding: 10px 10px 0; background: #f8fafb; }
    .wam-linea-chip { border: 1px solid #d1d5db; background: #fff; color: #374151; border-radius: 999px;
        padding: 7px 14px; font-size: 0.85rem; font-weight: 700; cursor: pointer; white-space: nowrap; }
    .wam-linea-chip.on { background: #075e54; color: #fff; border-color: #075e54; }

    .wam-search { padding: 10px; background: #f8fafb; border-bottom: 1px solid #eef0f2; flex: 0 0 auto; }
    .wam-search-input { width: 100%; box-sizing: border-box; border: 1px solid #d1d5db;
        border-radius: 12px; padding: 12px 14px; font-size: 16px; font-family: inherit; }
    .wam-search-input:focus { outline: none; border-color: #25d366; box-shadow: 0 0 0 2px rgba(37,211,102,0.18); }

    .wam-list { flex: 1; min-height: 0; overflow-y: auto; background: #fff; }
    .wam-vacio { color: #6b7280; font-size: 0.9rem; text-align: center; padding: 1.5rem 1rem; }
    .wam-conv { display: flex; align-items: center; gap: 12px; padding: 14px; cursor: pointer;
        border-bottom: 1px solid #f3f4f6; }
    .wam-conv:active { background: #f0fdf4; }
    .wam-avatar { width: 46px; height: 46px; border-radius: 50%; background: #25d366; color: #fff;
        display: flex; align-items: center; justify-content: center; font-weight: 800; font-size: 1.1rem; flex: none; }
    .wam-conv-txt { min-width: 0; }
    .wam-conv-nombre { font-weight: 700; color: #111827; font-size: 1rem;
        white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
    .wam-conv-ultimo { font-size: 0.85rem; color: #6b7280;
        white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
    /* 2026-08-18: hora + punto de "sin leer", como WhatsApp */
    .wam-conv-txt { flex: 1; }
    .wam-conv-meta { flex: none; display: flex; flex-direction: column; align-items: flex-end; gap: 6px; }
    .wam-conv-hora { font-size: 0.72rem; color: #6b7280; white-space: nowrap; }
    .wam-conv-punto { width: 11px; height: 11px; border-radius: 50%; background: #25d366; display: block; }
    .wam-conv.nuevo .wam-conv-nombre { font-weight: 800; }
    .wam-conv.nuevo .wam-conv-ultimo { color: #111827; font-weight: 600; }
    .wam-conv.nuevo .wam-conv-hora { color: #25d366; font-weight: 700; }
    /* 2026-08-19: chats FIJADOS (chinche 📌) — van arriba de todo, con fondo apenas distinto */
    .wam-conv.fijado { background: #fffbeb; }
    .wam-conv.fijado:active { background: #fef3c7; }
    .wam-conv-pin { flex: none; background: transparent; border: none; font-size: 1.05rem; padding: 6px;
        line-height: 1; cursor: pointer; opacity: 0.25; filter: grayscale(1); }
    .wam-conv-pin.on { opacity: 1; filter: none; }

    .wam-chat { flex: 1; min-height: 0; }
    /* PinnedWaChat trae su propio marco; acá lo dejamos a ras, ocupando toda la pantalla. */
    .wam-chat .pwa-card { height: 100%; min-height: 0; border: none; border-radius: 0; box-shadow: none; }

    /* Acciones a la derecha del header (campanita + persona) */
    .wam-head-actions { margin-left: auto; flex: none; display: flex; align-items: center; gap: 8px; }
    .wam-bell { flex: none; background: rgba(255,255,255,0.18); color: #fff; border: none; border-radius: 999px;
        width: 36px; height: 32px; font-size: 1rem; cursor: pointer; display: inline-flex; align-items: center; justify-content: center; }
    .wam-bell:hover { background: rgba(255,255,255,0.3); }
    .wam-bell.on { background: #25d366; }
    .wam-pushmsg { background: #fef3c7; color: #92400e; font-size: 0.82rem; padding: 10px 12px;
        border-bottom: 1px solid #fde68a; cursor: pointer; }
    /* Chip "Conectado como …" */
    .wam-persona { flex: none; background: rgba(255,255,255,0.18); color: #fff;
        border: none; border-radius: 999px; padding: 5px 12px; font-size: 0.82rem; font-weight: 700; cursor: pointer; }
    .wam-persona:hover { background: rgba(255,255,255,0.3); }

    /* Candado de 4 dígitos */
    .wam-lock { position: fixed; inset: 0; background: #075e54; display: flex; align-items: center;
        justify-content: center; padding: 20px; }
    .wam-lock-card { background: #fff; border-radius: 18px; padding: 1.6rem 1.4rem; width: 100%;
        max-width: 340px; text-align: center; box-shadow: 0 16px 40px rgba(0,0,0,0.3); }
    .wam-lock-ic { font-size: 2.4rem; line-height: 1; }
    .wam-lock-title { font-weight: 800; font-size: 1.3rem; color: #111827; margin-top: 0.3rem; }
    .wam-lock-sub { color: #6b7280; font-size: 0.9rem; margin-top: 0.3rem; }
    .wam-lock-dots { display: flex; gap: 14px; justify-content: center; margin: 1.1rem 0 0.6rem; }
    .wam-dot { width: 16px; height: 16px; border-radius: 50%; border: 2px solid #25d366; background: transparent; }
    .wam-dot.on { background: #25d366; }
    .wam-lock-err { color: #dc2626; font-weight: 700; font-size: 0.85rem; margin-bottom: 0.4rem; }
    .wam-keys { display: grid; grid-template-columns: repeat(3, 1fr); gap: 12px; margin-top: 0.6rem; }
    .wam-key { height: 62px; border: none; border-radius: 14px; background: #f3f4f6; color: #111827;
        font-size: 1.5rem; font-weight: 700; cursor: pointer; }
    .wam-key:hover:not(:disabled) { background: #e5e7eb; }
    .wam-key:active { transform: scale(0.96); }
    .wam-key:disabled { opacity: 0.5; cursor: not-allowed; }
    .wam-key-del { background: transparent; color: #6b7280; font-size: 1.6rem; }
    .wam-lock-foot { min-height: 1.2rem; color: #6b7280; font-size: 0.85rem; margin-top: 0.7rem; }
    .wam-huella { margin-top: 0.6rem; border-top: 1px solid #eef0f2; padding-top: 0.9rem; display: flex; flex-direction: column; gap: 0.55rem; }
    .wam-huella-btn { background: #075e54; color: #fff; border: none; border-radius: 12px; padding: 12px; font-size: 1rem; font-weight: 800; cursor: pointer; }
    .wam-huella-btn:disabled { opacity: 0.6; cursor: wait; }
    /* 2026-08-19: la huella es la entrada principal — botón grande y a la vista. */
    .wam-huella-grande { width: 100%; margin-top: 1rem; background: #075e54; color: #fff; border: none;
        border-radius: 16px; padding: 18px 12px; font-size: 1.05rem; font-weight: 800; cursor: pointer;
        display: flex; flex-direction: column; align-items: center; gap: 8px; }
    .wam-huella-grande:active { transform: scale(0.98); }
    .wam-huella-grande:disabled { opacity: 0.7; cursor: wait; }
    .wam-huella-ic { font-size: 2.6rem; line-height: 1; }
    .wam-lock-modo { background: #d1fae5; color: #065f46; border-radius: 10px; padding: 8px 10px;
        font-size: 0.8rem; font-weight: 700; margin-top: 0.5rem; }
    .wam-lock-link { background: transparent; border: none; color: #075e54; font-size: 0.85rem;
        font-weight: 700; text-decoration: underline; cursor: pointer; margin-top: 0.9rem; }
    .wam-huella-reg { background: transparent; border: none; color: #6b7280; font-size: 0.78rem; cursor: pointer; text-decoration: underline; }
    .wam-huella-reg:disabled { opacity: 0.6; }
</style>

@code {
    private bool cargando;
    private string busqueda = "";
    private List<ApiClient.TwConvDto> convs = new();
    private ApiClient.TwConvDto? chatAbierto;
    // Selector de línea (FRIKAF by INTERVENT / FIJO TRANSRADIO / …)
    private List<ApiClient.TwLineaConfigDto> lineasConfig = new();
    private string? filtroLinea;   // null = todas

    // Candado de 4 dígitos (Osmar/Germán/Gabriel)
    private bool desbloqueado;
    private string? persona;
    private string pin = "";
    private string? pinError;
    private bool verificando;
    private const string PersonaKey = "wamovil.persona";
    // 2026-08-18: a los 15 minutos sin tocarla vuelve a pedir código/huella (lo pidió el dueño).
    private const int MinutosCandado = 15;
    private DotNetObjectReference<WhatsAppMovil>? refCandado;
    // Huella (WebAuthn)
    private bool huellaDisponible;
    private bool huellaOcupada;
    private string? huellaMsg;
    // 2026-08-19: la huella pasa a ser la forma PRINCIPAL de entrar. modoClave=true muestra el
    // teclado de 4 dígitos (respaldo), y se activa solo si el teléfono no ofrece huella.
    private bool modoClave;
    // 2026-08-19: el teclado está pidiendo el código PARA REGISTRAR la huella (no para entrar).
    private bool modoRegistroHuella;
    private const string HuellaRegistradaKey = "wamovil.huellaRegistrada";

    // Avisos (campanita): sonido + aviso visual del sistema al llegar un mensaje nuevo (pantalla abierta).
    private bool avisos;
    private bool _notifInit;
    private System.Threading.Timer? notifTimer;
    private DateTime lastIncomingSeen = DateTime.MinValue;
    private const string AvisosKey = "wamovil.avisos";

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;
        // 2026-08-18: registrar el service worker para que el celu la pueda instalar y para
        // poder recibir los avisos con la pantalla cerrada.
        try
        {
            await JS.InvokeVoidAsync("eval", @"
                if ('serviceWorker' in navigator) {
                    navigator.serviceWorker.register('/sw.js', { scope: '/wa' })
                        .catch(err => console.log('SW register failed:', err));
                }
            ");
        }
        catch { /* navegador viejo o sin permisos, no pasa nada */ }
        // ¿El celu soporta huella? (para mostrar el botón)
        try { huellaDisponible = await JS.InvokeAsync<bool>("webAuthnAvailable"); } catch { huellaDisponible = false; }
        // 2026-08-19: si el teléfono no ofrece huella, arrancamos directo en el teclado para no
        // dejar a nadie afuera; si la ofrece, la huella es lo primero que se ve.
        modoClave = !huellaDisponible;
        if (!huellaDisponible)
            huellaMsg = "Este teléfono no ofrece huella al navegador (suele ser porque no tiene bloqueo de pantalla configurado). Entrá con el código.";
        // ¿Ya se identificó en este celu antes? (cada uno usa el suyo, así se lo acuerda)
        string? guardada = null;
        try { guardada = await JS.InvokeAsync<string?>("localStorage.getItem", PersonaKey); } catch { }
        if (!string.IsNullOrWhiteSpace(guardada))
        {
            persona = guardada;
            // 2026-08-18: antes entraba de una PARA SIEMPRE: el código se pedía solo la primera vez.
            // Ahora, si pasaron más de 15 minutos sin usarla, vuelve a pedirlo (o la huella, que es
            // un toque). Nos guardamos quién es, así no hay que volver a elegir persona.
            var vencido = true;
            try { vencido = await JS.InvokeAsync<bool>("waCandado.vencido", MinutosCandado); } catch { vencido = false; }
            if (!vencido)
            {
                desbloqueado = true;
                await CargarConversaciones();
            }
            else
            {
                huellaMsg = $"Pasaron más de {MinutosCandado} minutos: poné tu código o entrá con la huella.";
            }
        }
        // Vigilar la inactividad de acá en adelante (marca cada toque; al volver, si venció, bloquea).
        try
        {
            refCandado ??= DotNetObjectReference.Create(this);
            await JS.InvokeVoidAsync("waCandado.iniciar", refCandado, MinutosCandado);
        }
        catch { }
        StateHasChanged();
    }

    /// <summary>2026-08-19: el navegador a veces contesta "este teléfono no tiene huella" aunque
    /// sí la tenga (Chrome es conservador y depende de cómo esté configurado el celu). Antes eso
    /// FRENABA el registro y el usuario terminaba entrando con el código sin poder registrar nada.
    /// Ahora es solo un aviso: se intenta igual y, si de verdad no se puede, el propio teléfono
    /// devuelve el error y lo mostramos.</summary>
    private void AvisarSiNoHayHuella()
    {
        if (huellaDisponible) return;
        huellaMsg = "Este celu le dijo al navegador que no tiene huella disponible. Probamos igual: "
                  + "si no aparece el lector, fijate que el teléfono tenga bloqueo de pantalla configurado.";
    }

    private async Task EntrarConHuella()
    {
        AvisarSiNoHayHuella();
        huellaOcupada = true; huellaMsg = "Tocá la huella…"; pinError = null; StateHasChanged();
        try
        {
            var begin = await Api.WaHuellaLoginBeginAsync();
            if (begin is null || !begin.Ok)
            {
                // Todavía nadie registró su huella: se registra desde el teclado, con el código.
                huellaMsg = (begin?.Mensaje ?? "Todavía no hay huellas registradas.")
                          + " Entrá con el código y tocá \"Registrar mi huella en este celu\".";
                modoClave = true;
                return;
            }
            var credJs = await JS.InvokeAsync<System.Text.Json.JsonElement>("webAuthnGet", begin.Options!);
            if (credJs.TryGetProperty("_error", out var errEl2))
            {
                huellaMsg = "No se pudo leer la huella: " + (errEl2.GetString() ?? "sin detalle") + ". Podés entrar con el código.";
                return;
            }
            var comp = await Api.WaHuellaLoginCompleteAsync(new { SessionId = begin.SessionId, AssertionResponse = credJs });
            if (comp is null || !comp.Ok || string.IsNullOrWhiteSpace(comp.Nombre))
            {
                huellaMsg = (comp?.Mensaje ?? "Huella no reconocida.") + " Podés entrar con el código.";
                return;
            }
            persona = comp.Nombre;
            desbloqueado = true;
            try { await JS.InvokeVoidAsync("localStorage.setItem", PersonaKey, persona); } catch { }
            await CargarConversaciones();
        }
        catch { huellaMsg = "No se pudo usar la huella."; }
        finally { huellaOcupada = false; StateHasChanged(); }
    }

    /// <summary>Arranca el registro: pide el código en el teclado y, al completarlo, registra la huella.</summary>
    private void RegistrarHuella()
    {
        modoRegistroHuella = true;
        modoClave = true;
        pin = "";
        pinError = null;
        huellaMsg = "Poné tu código de 4 dígitos y el celu te va a pedir la huella.";
        AvisarSiNoHayHuella();   // si el navegador dijo que no, lo aclara pero seguimos igual
        StateHasChanged();
    }

    private void CancelarRegistroHuella()
    {
        modoRegistroHuella = false;
        pin = "";
        huellaMsg = null;
        StateHasChanged();
    }

    private async Task RegistrarHuellaCon(string codigo)
    {
        huellaOcupada = true; huellaMsg = "Ahora tocá el lector de huella del celu…"; StateHasChanged();
        try
        {
            var begin = await Api.WaHuellaRegBeginAsync(codigo, "Celular");
            if (begin is null || !begin.Ok) { huellaMsg = begin?.Mensaje ?? "No se pudo iniciar el registro."; return; }
            var credJs = await JS.InvokeAsync<System.Text.Json.JsonElement>("webAuthnCreate", begin.Options!);
            if (credJs.TryGetProperty("_error", out var errEl))
            {
                // 2026-08-19: mostramos lo que contestó el teléfono, así se puede diagnosticar de lejos.
                huellaMsg = "El celu no pudo registrar la huella: " + (errEl.GetString() ?? "sin detalle")
                          + ". Si dice algo de \"no soportado\", revisá que el teléfono tenga bloqueo de pantalla.";
                return;
            }
            var comp = await Api.WaHuellaRegCompleteAsync(new { SessionId = begin.SessionId, AttestationResponse = credJs });
            if (comp is null || !comp.Ok) { huellaMsg = comp?.Mensaje ?? "No se pudo registrar la huella."; return; }
            huellaMsg = "✅ Huella registrada. Ahora entrá con la huella."; pin = "";
            try { await JS.InvokeVoidAsync("localStorage.setItem", HuellaRegistradaKey, "1"); } catch { }
            modoRegistroHuella = false;
            modoClave = false;   // volver a la pantalla de huella, que ahora ya sirve
        }
        catch { huellaMsg = "No se pudo registrar la huella."; }
        finally { huellaOcupada = false; pin = ""; StateHasChanged(); }
    }

    private async Task Tecla(string d)
    {
        if (verificando || pin.Length >= 4) return;
        pinError = null;
        pin += d;
        if (pin.Length == 4)
        {
            // 2026-08-19 BUG: antes, al llegar al 4to dígito SIEMPRE entraba. Por eso era
            // IMPOSIBLE registrar la huella: la instrucción decía "poné el código y después tocá
            // Registrar", pero el código te metía adentro antes de poder tocar nada. Resultado:
            // nunca hubo ninguna huella registrada y la pantalla nunca la pedía.
            // Ahora, si estás en modo registro, el código sirve para registrar la huella.
            if (modoRegistroHuella) await RegistrarHuellaCon(pin);
            else await VerificarPin();
        }
        else StateHasChanged();
    }

    private void Borrar()
    {
        if (verificando || pin.Length == 0) return;
        pin = pin.Substring(0, pin.Length - 1);
        pinError = null;
    }

    private async Task VerificarPin()
    {
        verificando = true;
        StateHasChanged();
        var nombre = await Api.VerificarCodigoWaMovilAsync(pin);
        verificando = false;
        if (!string.IsNullOrWhiteSpace(nombre))
        {
            persona = nombre;
            desbloqueado = true;
            pin = "";
            try { await JS.InvokeVoidAsync("localStorage.setItem", PersonaKey, nombre); } catch { }
            await CargarConversaciones();
        }
        else
        {
            pinError = "Código incorrecto";
            pin = "";
        }
        StateHasChanged();
    }

    /// <summary>2026-08-18: lo llama el JS cuando volvés a la pantalla después de 15 minutos.
    /// No borra quién sos: solo vuelve a pedir el código (o la huella).</summary>
    [JSInvokable]
    public Task Bloquear()
    {
        if (!desbloqueado) return Task.CompletedTask;
        desbloqueado = false;
        chatAbierto = null;
        pin = "";
        pinError = null;
        modoClave = !huellaDisponible;   // 2026-08-19: si el celu tiene huella, se pide la huella
        huellaMsg = $"Pasaron más de {MinutosCandado} minutos. Entrá de nuevo.";
        StateHasChanged();
        return Task.CompletedTask;
    }

    private async Task CambiarPersona()
    {
        try { await JS.InvokeVoidAsync("localStorage.removeItem", PersonaKey); } catch { }
        desbloqueado = false;
        persona = null;
        pin = "";
        pinError = null;
        chatAbierto = null;
        StateHasChanged();
    }

    private async Task CargarConversaciones()
    {
        try { await JS.InvokeVoidAsync("waCandado.marcar"); } catch { }
        if (cargando) return;
        cargando = true;
        try { convs = await Api.GetTwConversacionesAsync(); }
        catch { convs ??= new(); }
        if (lineasConfig.Count == 0)
            try { lineasConfig = await Api.GetTwLineasConfigAsync(); } catch { }
        if (vistos.Count == 0) await CargarVistos();
        await RevisarPushAsync();
        // 2026-08-15: tema (claro/oscuro) de cada línea + letra elegida
        await Apariencia.EnsureLoadedAsync();
        cargando = false;

        // La primera vez: recordar hasta dónde llegamos (para NO avisar de mensajes viejos),
        // leer la preferencia de avisos y arrancar el chequeo periódico de mensajes nuevos.
        if (!_notifInit)
        {
            _notifInit = true;
            lastIncomingSeen = convs.Where(c => c.UltimoDireccion == "INCOMING")
                                    .Select(c => c.UltimoAt).DefaultIfEmpty(DateTime.UtcNow).Max();
            try { avisos = (await JS.InvokeAsync<string?>("localStorage.getItem", AvisosKey)) == "1"; } catch { }
            // 2026-08-18: EN VIVO. El servidor avisa apenas entra o sale un mensaje, así la lista se
            // actualiza en el momento (como WhatsApp) en vez de esperar al sondeo. El timer queda
            // igual pero MUCHO más lento (60 s), solo como red por si se corta la conexión en vivo.
            try
            {
                await Vivo.EnsureStartedAsync();
                Vivo.OnNuevoMensaje += AvisoEnVivo;
            }
            catch { }
            notifTimer ??= new System.Threading.Timer(async _ => await InvokeAsync(RevisarNuevosAsync), null, 60000, 60000);
        }
        StateHasChanged();
    }

    // ═══ 2026-08-18: avisos con la PANTALLA CERRADA (Web Push) ═══
    // La campanita 🔔 de al lado sigue siendo el aviso de siempre: suena mientras la pantalla
    // esta abierta. Este otro boton (📳) anota al telefono para que lo despierten aunque el
    // navegador este cerrado. Son cosas distintas y se prenden por separado a proposito.
    private bool pushActivo, pushOcupado;
    private string? pushMsg;

    private async Task RevisarPushAsync()
    {
        try
        {
            var ep = await JS.InvokeAsync<string?>("waPush.estado");
            pushActivo = !string.IsNullOrWhiteSpace(ep);
        }
        catch { pushActivo = false; }
    }

    private async Task TogglePush()
    {
        pushOcupado = true; pushMsg = null; StateHasChanged();
        try
        {
            if (pushActivo)
            {
                var ep = await JS.InvokeAsync<string?>("waPush.desactivar");
                if (!string.IsNullOrWhiteSpace(ep)) await Api.WaPushBajaAsync(ep!);
                pushActivo = false;
                pushMsg = "Listo: este celular ya no recibe avisos con la pantalla cerrada.";
            }
            else
            {
                var clave = await Api.GetWaPushClaveAsync();
                if (clave is null || string.IsNullOrWhiteSpace(clave.Clave))
                {
                    pushMsg = "No se pudo pedir la clave al sistema. Probá de nuevo en un rato.";
                    return;
                }
                var r = await JS.InvokeAsync<System.Text.Json.JsonElement>("waPush.activar", clave.Clave);
                var ok = r.TryGetProperty("ok", out var okEl) && okEl.GetBoolean();
                if (!ok)
                {
                    pushMsg = r.TryGetProperty("motivo", out var mEl) ? mEl.GetString() : "No se pudo activar en este teléfono.";
                    return;
                }
                var endpoint = r.TryGetProperty("endpoint", out var epEl) ? epEl.GetString() : null;
                if (string.IsNullOrWhiteSpace(endpoint)) { pushMsg = "No se pudo activar en este teléfono."; return; }
                await Api.WaPushSuscribirAsync(endpoint!, persona);
                pushActivo = true;
                pushMsg = "✅ Listo. Este celular va a avisarte aunque cierres la pantalla.";
            }
        }
        catch (Exception ex) { pushMsg = "No se pudo cambiar el aviso: " + ex.Message; }
        finally { pushOcupado = false; StateHasChanged(); }
    }

    /// <summary>Prende/apaga los avisos. Al prender, pide permiso para el aviso visual del sistema.</summary>
    private async Task ToggleAvisos()
    {
        avisos = !avisos;
        try { await JS.InvokeVoidAsync("localStorage.setItem", AvisosKey, avisos ? "1" : "0"); } catch { }
        if (avisos)
        {
            try { await JS.InvokeAsync<string>("waMovilNotif.pedirPermiso"); } catch { }
            try { await JS.InvokeVoidAsync("waNotifSound"); } catch { } // pitido de confirmación
        }
        StateHasChanged();
    }

    /// <summary>Cada 15s: refresca la lista y, si hay un mensaje ENTRANTE nuevo, suena + aviso visual.</summary>
    private async Task RevisarNuevosAsync()
    {
        List<ApiClient.TwConvDto> lista;
        try { lista = await Api.GetTwConversacionesAsync(); }
        catch { return; }
        convs = lista;

        var entrantes = convs.Where(c => c.UltimoDireccion == "INCOMING" && c.UltimoAt > lastIncomingSeen).ToList();
        if (entrantes.Count > 0)
        {
            lastIncomingSeen = entrantes.Max(c => c.UltimoAt);
            var top = entrantes.OrderByDescending(c => c.UltimoAt).First();
            // No molestar si justo estás mirando ese chat.
            if (avisos && (chatAbierto == null || chatAbierto.Numero != top.Numero))
            {
                try { await JS.InvokeVoidAsync("waNotifSound"); } catch { }
                var titulo = entrantes.Count == 1 ? NombreDe(top) : $"{entrantes.Count} chats nuevos";
                var cuerpo = Recortar(top.UltimoMensaje, 80);
                try { await JS.InvokeVoidAsync("waMovilNotif.mostrar", titulo, cuerpo); } catch { }
            }
        }
        StateHasChanged();
    }

    /// <summary>2026-08-18: llegó/salió un mensaje. Refresca la lista al toque (sin esperar el sondeo).</summary>
    private void AvisoEnVivo(string convId, string direccion, DateTime at)
        => _ = InvokeAsync(RevisarNuevosAsync);

    public void Dispose()
    {
        notifTimer?.Dispose();
        try { Vivo.OnNuevoMensaje -= AvisoEnVivo; } catch { }
        refCandado?.Dispose();
    }

    private async Task AbrirChat(ApiClient.TwConvDto c)
    {
        chatAbierto = c;
        await MarcarLeido(c);   // 2026-08-18: al abrirla deja de estar "sin leer"
        StateHasChanged();
    }
    private async Task Volver()
    {
        // 2026-08-18: al salir del chat lo damos por leido hasta el ultimo mensaje que haya
        // entrado mientras lo mirabas (si no, volvia a aparecer con el punto verde).
        if (chatAbierto is not null)
        {
            var actual = convs.FirstOrDefault(x => x.Numero == chatAbierto.Numero && x.Linea == chatAbierto.Linea) ?? chatAbierto;
            await MarcarLeido(actual);
        }
        chatAbierto = null;
        StateHasChanged();
    }

    // Líneas que tienen chats, con su nombre lindo (FRIKAF by INTERVENT / FIJO TRANSRADIO)
    private List<(string? Id, string Nombre)> LineasDisponibles()
    {
        var nombres = new Dictionary<string, string>();
        foreach (var lc in lineasConfig)
            if (!string.IsNullOrWhiteSpace(lc.LineaId))
                nombres[lc.LineaId] = !string.IsNullOrWhiteSpace(lc.Nombre) ? lc.Nombre!
                    : (!string.IsNullOrWhiteSpace(lc.NumeroReal) ? lc.NumeroReal! : lc.LineaId);
        return convs
            .Select(c => c.Linea)
            .Distinct()
            .Select(id =>
            {
                string nom = (id != null && nombres.TryGetValue(id, out var n)) ? n
                    : (convs.FirstOrDefault(c => c.Linea == id)?.LineaNumero ?? "Sin línea");
                return (Id: id, Nombre: nom);
            })
            .OrderBy(x => x.Nombre)
            .ToList();
    }

    private IEnumerable<ApiClient.TwConvDto> Filtradas()
    {
        IEnumerable<ApiClient.TwConvDto> src = convs;
        // 2026-08-18: las charlas archivadas NO van en el listado (igual que en la pantalla grande).
        // Si el cliente vuelve a escribir, el backend las desarchiva solo y reaparecen.
        src = src.Where(c => !c.Archivado);
        if (filtroLinea != null) src = src.Where(c => c.Linea == filtroLinea);
        if (string.IsNullOrWhiteSpace(busqueda))
            return src.Take(60);
        var q = busqueda.Trim().ToLowerInvariant();
        var qDigits = new string(q.Where(char.IsDigit).ToArray());
        return src.Where(c =>
                (NombreDe(c).ToLowerInvariant().Contains(q))
                || ((c.Numero ?? "").ToLowerInvariant().Contains(q))
                || (qDigits.Length >= 3 && new string((c.Numero ?? "").Where(char.IsDigit).ToArray()).Contains(qDigits)))
            .Take(100);
    }

    // ═══ 2026-08-18: hora, "sin leer" y texto del ultimo mensaje (como WhatsApp) ═══

    /// <summary>Hora corta para la lista: hoy la hora, ayer "Ayer", antes la fecha.</summary>
    private static string FormatHoraLista(DateTime utc)
    {
        var local = utc.ToArTime();
        var hoy = DateTime.Now.Date;
        if (local.Date == hoy) return local.ToString("HH:mm");
        if (local.Date == hoy.AddDays(-1)) return "Ayer";
        if (local.Date > hoy.AddDays(-7)) return local.ToString("dddd", new System.Globalization.CultureInfo("es-AR"));
        return local.ToString("dd/MM/yy");
    }

    /// <summary>Lo que se muestra en el renglon. Si el ultimo mensaje era una foto/audio/archivo
    /// no hay texto, y antes el renglon quedaba VACIO; ahora dice que fue.</summary>
    private static string UltimoTexto(ApiClient.TwConvDto c)
    {
        if (!string.IsNullOrWhiteSpace(c.UltimoMensaje)) return c.UltimoMensaje!;
        var u = (c.UltimoMediaUrl ?? "").ToLowerInvariant();
        if (string.IsNullOrEmpty(u)) return "";
        if (u.Contains(".ogg") || u.Contains(".mp3") || u.Contains(".m4a") || u.Contains(".opus") || u.Contains(".wav")) return "🎤 Mensaje de voz";
        if (u.Contains(".jpg") || u.Contains(".jpeg") || u.Contains(".png") || u.Contains(".webp") || u.Contains(".gif")) return "📷 Foto";
        if (u.Contains(".mp4") || u.Contains(".3gp") || u.Contains(".mov")) return "🎥 Video";
        if (u.Contains(".pdf")) return "📄 Documento";
        return "📎 Archivo";
    }

    // "Sin leer" por celular: guardamos hasta que fecha vimos cada chat en ESTE telefono.
    // El sistema no lleva leido/no-leido por usuario, y como cada uno usa su propio celu
    // (igual que el codigo de 4 digitos), guardarlo en el telefono alcanza.
    private const string VistosKey = "wamovil.vistos";
    private Dictionary<string, DateTime> vistos = new();

    private static string ClaveConv(ApiClient.TwConvDto c) => (c.Numero ?? "") + "|" + (c.Linea ?? "");

    // 2026-08-19: fijar / sacar de fijados desde el celu. Hasta 5, compartido con la pantalla
    // grande (el tope lo controla el servidor). Sin toasts en esta pantalla: se avisa con alert.
    private const int MaxFijados = 5;
    private async Task FijarChat(ApiClient.TwConvDto c)
    {
        var fijar = !c.Fijado;
        if (fijar && convs.Count(x => x.Fijado) >= MaxFijados)
        {
            await JS.InvokeVoidAsync("alert", $"Ya hay {MaxFijados} chats fijados. Sacá uno para poder fijar este 📌");
            return;
        }
        var (ok, error) = await Api.FijarConversacionAsync(c.Numero, c.Linea, fijar);
        if (!ok)
        {
            await JS.InvokeVoidAsync("alert", error ?? "No se pudo fijar el chat");
            return;
        }
        try { convs = await Api.GetTwConversacionesAsync(); } catch { }
        StateHasChanged();
    }

    private bool NoLeido(ApiClient.TwConvDto c)
    {
        if (c.UltimoDireccion != "INCOMING") return false;   // lo ultimo lo mandamos nosotros
        return !vistos.TryGetValue(ClaveConv(c), out var visto) || c.UltimoAt > visto;
    }

    private async Task CargarVistos()
    {
        try
        {
            var json = await JS.InvokeAsync<string?>("localStorage.getItem", VistosKey);
            if (!string.IsNullOrWhiteSpace(json))
                vistos = System.Text.Json.JsonSerializer.Deserialize<Dictionary<string, DateTime>>(json!) ?? new();
        }
        catch { vistos = new(); }
    }

    private async Task MarcarLeido(ApiClient.TwConvDto c)
    {
        vistos[ClaveConv(c)] = c.UltimoAt;
        try
        {
            await JS.InvokeVoidAsync("localStorage.setItem", VistosKey,
                System.Text.Json.JsonSerializer.Serialize(vistos));
        }
        catch { }
    }

    private static string NombreDe(ApiClient.TwConvDto c)
        => !string.IsNullOrWhiteSpace(c.ClienteNombre) ? c.ClienteNombre!
         : !string.IsNullOrWhiteSpace(c.NombrePerfil) ? c.NombrePerfil!
         : (c.Numero ?? "Contacto").Replace("whatsapp:", "").Replace("ig:", "IG ");

    private static string Inicial(ApiClient.TwConvDto c)
    {
        var n = NombreDe(c).Trim();
        return string.IsNullOrEmpty(n) ? "?" : n[..1].ToUpperInvariant();
    }

    private static string Recortar(string? s, int max)
    {
        if (string.IsNullOrWhiteSpace(s)) return "";
        s = s.Replace("\n", " ").Trim();
        return s.Length <= max ? s : s.Substring(0, max) + "…";
    }
}
