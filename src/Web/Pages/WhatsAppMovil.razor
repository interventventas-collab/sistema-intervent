        await SincronizarAtrasAsync();
        if (!firstRender) return;
        // 2026-08-20: aplicar el tamaño de letra guardado en ESTE celular, antes que nada, para
        // que la pantalla aparezca ya del tamaño elegido y no salte a la vista.
        await CargarEscalaAsync();
        // 2026-08-18: registrar el service worker para que el celu la pueda instalar y para
        // poder recibir los avisos con la pantalla cerrada.
        try
        {
            await JS.InvokeVoidAsync("eval", @"
                if ('serviceWorker' in navigator) {
                    navigator.serviceWorker.register('/sw.js', { scope: '/wa' })
