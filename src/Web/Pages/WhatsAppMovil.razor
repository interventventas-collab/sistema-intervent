        }
        ctrlOcupado = true; ctrlError = null; StateHasChanged();
        try
        {
            var r = await Api.WaRevalidarAsync(credencialId ?? "", ctrlUsuario.Trim(), ctrlClave);
            if (r?.Ok == true)
            {
                ctrlUsuario = ""; ctrlClave = "";
                modoControlClave = false;
                desbloqueado = true;
                await CargarConversaciones();
            }
            else ctrlError = r?.Mensaje ?? "No se pudo verificar. Probá de nuevo.";
        }
        catch (Exception ex) { ctrlError = "Error: " + ex.Message; }
        finally { ctrlOcupado = false; StateHasChanged(); }
    }
    private string? persona;
    private string pin = "";
    private string? pinError;
    private bool verificando;
    private const string PersonaKey = "wamovil.persona";
    // 2026-08-18: a los 15 minutos sin tocarla vuelve a pedir código/huella (lo pidió el dueño).
    private const int MinutosCandado = 15;
