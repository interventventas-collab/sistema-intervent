    /// <summary>2026-08-20: el chat abierto, para poder abrirle el buscador desde la lupa.</summary>
    private PinnedWaChat? chatRef;

    private void AbrirBuscadorChat() => chatRef?.ToggleBuscador();

    // ═══ 2026-08-20: TAMAÑO DE LA LETRA (pedido del dueño: "ayer se veía espectacular, ahora se ve
    // pequeño"). Se comprobó que el sistema dibuja igual que ayer, así que lo que cambia es el
    // celular (el zoom se resetea cuando la app instalada se actualiza). Con esto ya no importa:
    // el tamaño lo manda ESTA pantalla y queda guardado en ESTE celular.
    //
    // Se escala desde la RAÍZ (html { font-size }) y no con zoom ni con font-size en el contenedor.
    // Medido con Playwright a 360 y 412 px: la raíz es la única que agranda de verdad TODO —lista,
    // nombres, mensajes, horas— sin que la pantalla deje de cubrir el celular. Con zoom la caja
    // fija dejaba un borde blanco, y con font-size en el contenedor no pasaba nada, porque las
    // reglas están en rem (que miran la raíz, no al padre).
    private const string EscalaKey = "wamovil.escalaLetra";
    private const double EscalaBase = 16.0;   // px de la raíz cuando la escala es 1
    private double escala = 1.0;
    private bool panelEscala;

    private static readonly (string Nombre, double Valor)[] EscalasDisponibles = new[]
    {
        ("Chica",       0.9),
        ("Mediana",     1.0),   // la de siempre: si nadie toca nada, todo queda como está hoy
        ("Grande",      1.2),
        ("Muy grande",  1.45),
    };

    /// <summary>Aplica la escala a la raíz del documento. Se hace por JS porque el tamaño de la
    /// raíz vive fuera del componente.</summary>
    private async Task AplicarEscalaAsync()
    {
        try
        {
            await JS.InvokeVoidAsync("document.documentElement.style.setProperty",
                "font-size", (EscalaBase * escala).ToString("0.##", System.Globalization.CultureInfo.InvariantCulture) + "px");
        }
        catch { }
    }

    /// <summary>Deja la raíz como estaba. IMPORTANTE al salir de la pantalla: si no, el tamaño
    /// grande se lo lleva puesto el resto del sistema.</summary>
    private async Task SoltarEscalaAsync()
    {
        try { await JS.InvokeVoidAsync("document.documentElement.style.setProperty", "font-size", ""); }
        catch { }
    }

    private async Task CargarEscalaAsync()
    {
        try
        {
            var g = await JS.InvokeAsync<string?>("localStorage.getItem", EscalaKey);
            if (!string.IsNullOrWhiteSpace(g)
                && double.TryParse(g, System.Globalization.NumberStyles.Float, System.Globalization.CultureInfo.InvariantCulture, out var v)
                && v >= 0.8 && v <= 1.6)
                escala = v;
        }
        catch { }
        if (Math.Abs(escala - 1.0) > 0.001) await AplicarEscalaAsync();
    }

    private async Task CambiarEscalaAsync(double v)
    {
        escala = v;
        await AplicarEscalaAsync();
        try
        {
            await JS.InvokeVoidAsync("localStorage.setItem", EscalaKey,
                v.ToString("0.##", System.Globalization.CultureInfo.InvariantCulture));
        }
        catch { }
        StateHasChanged();
    }

    private void CerrarPanelEscala() => panelEscala = false;
    // Huella (WebAuthn)
    private bool huellaDisponible;
    private bool huellaOcupada;
    private string? huellaMsg;
    // 2026-08-19: la huella pasa a ser la forma PRINCIPAL de entrar. modoClave=true muestra el
    // teclado de 4 dígitos (respaldo), y se activa solo si el teléfono no ofrece huella.
    private bool modoClave;
    // 2026-08-19: el teclado está pidiendo el código PARA REGISTRAR la huella (no para entrar).
    private bool modoRegistroHuella;
    private const string HuellaRegistradaKey = "wamovil.huellaRegistrada";

    // Avisos (campanita): sonido + aviso visual del sistema al llegar un mensaje nuevo (pantalla abierta).
    private bool avisos;
    private bool _notifInit;
    private System.Threading.Timer? notifTimer;
    private DateTime lastIncomingSeen = DateTime.MinValue;
    private const string AvisosKey = "wamovil.avisos";
    // 2026-08-19: sonido de aviso elegido para CADA linea (el mismo que se configura desde la PC con
    // el lapicito de la linea). Antes el celu tocaba siempre la campanita y se comia esa eleccion.
    private Dictionary<string, string?> lineaSonidos = new();

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        // 2026-08-27: despues de CADA dibujado le decimos al telefono cuantas cosas hay abiertas,
        // asi su boton "atras" siempre tiene con que volver (ver wa-atras.js). Va primero para que
