@page "/cafe/tesoreria/cheques"
@attribute [Authorize]
@inject ApiClient Api
@inject ToastService ToastService
@using Web.Models

<div class="card">
    <div class="card-header" style="display:flex; justify-content:space-between; align-items:center; flex-wrap:wrap; gap:0.5rem;">
        <h3 style="margin:0;">📄 Cheques en cartera (@(cheques?.Count(c => c.Estado == "EN_CARTERA") ?? 0))</h3>
        <div style="display:flex; gap:0.4rem; align-items:center; flex-wrap:wrap;">
            <button class="btn btn-success" style="font-size:0.8rem;" @onclick="AbrirNuevo">➕ Nuevo cheque</button>
            <div style="width:1px; height:24px; background:#d1d5db; margin:0 0.25rem;"></div>
            @foreach (var e in estados)
            {
                <button class="btn @(estadoFiltro == e.key ? "btn-primary" : "btn-secondary")" style="font-size:0.8rem;" @onclick="() => SetFiltro(e.key)">@e.label</button>
            }
        </div>
    </div>
    <div class="card-body" style="padding:0;">
        @if (loading)
        {
            <p class="text-muted" style="padding:1rem;">Cargando...</p>
        }
        else if (cheques is null || !ChequesFiltrados.Any())
        {
            <p class="text-muted" style="padding:1rem;">Sin cheques con este filtro.</p>
        }
        else
        {
            <div style="overflow-x:auto;">
                <table class="table table-compact">
                    <thead>
                        <tr>
                            <th>Banco</th>
                            <th>Número</th>
                            <th>Emisor</th>
                            <th>Cliente origen</th>
                            <th style="text-align:right;">Importe</th>
                            <th>Vence</th>
                            <th>Estado</th>
                            <th>Acciones</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var c in ChequesFiltrados)
                        {
                            <tr>
                                <td>@c.Banco</td>
                                <td><b>@c.Numero</b></td>
                                <td>@(c.Emisor ?? "—")</td>
                                <td>@(c.ClienteOrigenNombre ?? "—")</td>
                                <td style="text-align:right; font-weight:600;">$@c.Importe.ToString("N2")</td>
                                <td>@(c.FechaVencimiento?.ToString("dd/MM/yyyy") ?? "—")</td>
                                <td><span class="badge @EstadoClass(c.Estado)">@EstadoLabel(c.Estado)</span></td>
                                <td>
                                    @if (c.Estado == "EN_CARTERA")
                                    {
                                        @* 2026-08-18: hacer la cobranza con ESTE cheque (antes habia que re-tipearlo
                                           en Cobranzas, y ese camino creaba un cheque duplicado en cartera). *@
                                        @if (!c.CobranzaOrigenId.HasValue)
                                        {
                                            <button class="btn-icon" title="Hacer la cobranza — imputar este cheque a las facturas del cliente"
                                                    @onclick="() => AbrirCobranza(c)">📥</button>
                                        }
                                        <button class="btn-icon" title="Lo mandé al banco — todavía no se acreditó" @onclick="() => MandarAlBanco(c)">📤</button>
                                        <button class="btn-icon" title="Depositar y dar por acreditado (en un solo paso)" @onclick="() => Depositar(c)">🏦</button>
                                        <button class="btn-icon" title="Cobrar por ventanilla" @onclick="() => CobrarVent(c)">💵</button>
                                        <button class="btn-icon" title="Rechazar (rebotó)" @onclick="() => Rechazar(c)">❌</button>
                                    }
                                    else if (c.Estado == "DEPOSITADO")
                                    {
                                        @* 2026-08-18: el cheque está en el banco esperando que se acredite *@
                                        <button class="btn-icon" title="El banco ya lo acreditó" @onclick="() => Acreditar(c)">✅</button>
                                        <button class="btn-icon" title="Rechazar (rebotó)" @onclick="() => Rechazar(c)">❌</button>
                                    }
                                    else
                                    {
                                        <span style="color:#6b7280; font-size:0.78rem;">(sin acciones)</span>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </div>
</div>

@* ════════════ Modal Hacer la cobranza (2026-08-18) ════════════
   Mismo circuito que "Cheques del banco" pero para un cheque de papel que ya esta en cartera:
   se elige el cliente que pago, se tildan las facturas que cubre y se genera la cobranza
   USANDO ESTE cheque como forma de cobro. *@
@if (cobChe is not null)
{
    <div class="modal-overlay">
        <div class="modal-card" style="max-width: 720px; width:92vw; max-height:90vh; overflow-y:auto;">
            <div class="modal-header">
                <h3 style="margin:0;">📥 Hacer la cobranza — cheque N° @cobChe.Numero</h3>
                <button class="btn-close" @onclick="CerrarCobranza">✕</button>
            </div>
            <div class="modal-body">
                <div style="display:flex; gap:1rem; flex-wrap:wrap; font-size:0.88rem; margin-bottom:0.8rem;">
                    <div><span style="color:#6b7280;">Banco:</span> <strong>@cobChe.Banco</strong></div>
                    <div><span style="color:#6b7280;">Importe:</span> <strong style="color:#16a34a;">$@cobChe.Importe.ToString("N2")</strong></div>
                    <div><span style="color:#6b7280;">Vence:</span> <strong>@(cobChe.FechaVencimiento?.ToString("dd/MM/yyyy") ?? "—")</strong></div>
                </div>

                <div class="form-group">
                    <label class="form-label">Cliente que pagó *</label>
                    @if (cobCliente is not null)
                    {
                        <div style="display:flex; justify-content:space-between; align-items:center; background:#ecfdf5; border:1px solid #059669; padding:0.5rem 0.7rem; border-radius:6px;">
                            <div>
                                <strong>@(cobCliente.CodigoInterno?.ToString() ?? "—") · @cobCliente.Nombre</strong>
                                @if (!string.IsNullOrEmpty(cobCliente.Cuit))
                                {
                                    <span style="font-size:0.75rem; color:#065f46;"> · CUIT @cobCliente.Cuit</span>
                                }
                            </div>
                            <button class="btn-icon" @onclick="QuitarClienteCobranza" title="Cambiar cliente">✕</button>
                        </div>
                    }
                    else
                    {
                        <input class="form-input" @bind="cobClienteSearch" @bind:event="oninput" placeholder="Buscar por nombre, código o CUIT..." />
                        @if (!string.IsNullOrWhiteSpace(cobClienteSearch) && clientes is not null)
                        {
                            var matches = clientes.Where(c => c.IsActive &&
                                (c.Nombre.MatchesSearch(cobClienteSearch) ||
                                 (c.RazonSocial ?? "").MatchesSearch(cobClienteSearch) ||
                                 (c.Cuit ?? "").Contains(cobClienteSearch, StringComparison.OrdinalIgnoreCase) ||
                                 (c.CodigoInterno?.ToString() ?? "").Contains(cobClienteSearch)))
                                .Take(10).ToList();
                            <div style="max-height:200px; overflow-y:auto; border:1px solid #e5e7eb; border-radius:4px; margin-top:0.3rem;">
                                @foreach (var c in matches)
                                {
                                    var cli = c;
                                    <div style="padding:0.4rem 0.6rem; cursor:pointer; border-bottom:1px solid #f3f4f6;" @onclick="() => ElegirClienteCobranza(cli)">
                                        <strong>@(cli.CodigoInterno?.ToString() ?? "—") · @cli.Nombre</strong>
                                        @if (!string.IsNullOrEmpty(cli.Cuit)) { <span style="font-size:0.75rem; color:#6b7280;"> · CUIT @cli.Cuit</span> }
                                    </div>
                                }
                            </div>
                        }
                    }
                </div>

                @if (cobCliente is not null)
                {
                    @if (cobCargandoComp)
                    {
                        <p class="text-muted">Cargando comprobantes pendientes...</p>
                    }
                    else if (cobComprobantes is { Count: > 0 })
                    {
                        <div class="form-group">
                            <label class="form-label">Imputar a comprobantes pendientes</label>
                            <p style="font-size:0.72rem; color:#6b7280; margin:0 0 0.4rem;">
                                Tildá los que cubrís con este cheque. Imputado: <strong>$@CobTotalImputar.ToString("N2")</strong>
                                de <strong>$@CobTotalEsperado.ToString("N2")</strong>
                                @(cobRetenciones > 0 ? $"(cheque ${cobChe.Importe:N2} + retenciones ${cobRetenciones:N2})" : "")
                            </p>
                            <table style="width:100%; font-size:0.85rem;">
                                <thead>
                                    <tr style="border-bottom:1px solid #e5e7eb;">
                                        <th style="width:30px;"></th>
                                        <th style="text-align:left;">Comprobante</th>
                                        <th style="text-align:right;">Saldo</th>
                                        <th style="width:130px; text-align:right;">A imputar</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @for (int i = 0; i < cobComprobantes.Count; i++)
                                    {
                                        var idx = i;
                                        var comp = cobComprobantes[idx];
                                        var sel = cobSeleccion[idx];
                                        <tr>
                                            <td><input type="checkbox" checked="@sel.Tildado"
                                                       @onchange="@(e => OnTildarComprobanteCobranza(idx, (bool)e.Value!))" /></td>
                                            <td><strong>@comp.Numero</strong> <span style="color:#6b7280; font-size:0.78rem;">@comp.Fecha.ToString("dd/MM/yyyy")</span></td>
                                            <td style="text-align:right;">$@comp.Saldo.ToString("N2")</td>
                                            <td style="text-align:right;">
                                                @* 2026-08-18: texto formateado ("386.370,00") para que se lea igual que el saldo de al lado *@
                                                <input class="form-input" type="text" inputmode="decimal" style="text-align:right; padding:0.2rem 0.4rem; font-size:0.85rem;"
                                                       value="@MontoInput.Formato(sel.Importe)" disabled="@(!sel.Tildado)"
                                                       @onchange="@(e => OnImporteComprobanteCobranza(idx, e.Value?.ToString()))" />
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    }
                    else
                    {
                        <p style="font-size:0.82rem; color:#6b7280;">Este cliente no tiene comprobantes con saldo. Se va a registrar como "a cuenta".</p>
                    }
                    @* 2026-08-18: cuanto le falta a las facturas tildadas para quedar saldadas con este cheque *@
                    @if (CobFaltaCubrir > 0.01m)
                    {
                        <div style="padding:0.6rem 0.8rem; background:#fdf4ff; border:1px solid #f0abfc; border-radius:6px; margin-bottom:0.6rem;">
                            <div style="font-size:0.85rem;">
                                Las facturas tildadas suman <strong>$@CobSaldoTildado.ToString("N2")</strong> y el cheque es de
                                <strong>$@cobChe.Importe.ToString("N2")</strong>: quedan
                                <strong style="color:#a21caf;">$@CobFaltaCubrir.ToString("N2")</strong> sin cubrir.
                            </div>
                            <button type="button" class="btn btn-secondary" style="font-size:0.78rem; padding:0.25rem 0.6rem; margin-top:0.4rem;"
                                    @onclick="PonerFaltanteComoRetencionCobranza">
                                Poner $@CobFaltaCubrir.ToString("N2") como retención y saldar las facturas
                            </button>
                        </div>
                    }
                    <div class="form-row">
                        <div class="form-group" style="flex:1;">
                            <label class="form-label">Retenciones</label>
                            <input class="form-input" type="number" step="0.01" min="0" @bind="cobRetenciones" />
                            <p style="font-size:0.7rem; color:#6b7280; margin:0.2rem 0 0;">Si el cliente descontó retenciones del pago, ponelas acá.</p>
                        </div>
                        <div class="form-group" style="flex:2;">
                            <label class="form-label">Observaciones (opcional)</label>
                            <input class="form-input" @bind="cobObservaciones" placeholder="Notas internas" />
                        </div>
                    </div>
                }

                @if (!string.IsNullOrEmpty(cobError))
                {
                    <div style="background:#fee2e2; color:#991b1b; padding:0.5rem 0.7rem; border-radius:4px; font-size:0.82rem; margin-top:0.5rem;">@cobError</div>
                }
                <div style="background:#dbeafe; color:#1e40af; padding:0.4rem 0.6rem; border-radius:4px; font-size:0.78rem; margin-top:0.5rem;">
                    💡 Al confirmar se crea la cobranza con <strong>este mismo cheque</strong> como forma de cobro (no se carga uno nuevo),
                    queda asociado al cliente y se descuenta el saldo de las facturas elegidas.
                </div>
            </div>
            <div class="modal-footer">
                <button class="btn btn-secondary" @onclick="CerrarCobranza" disabled="@cobGuardando">Cancelar</button>
                <button class="btn btn-primary" @onclick="ConfirmarCobranza" disabled="@(cobGuardando || cobCliente is null)">
                    @(cobGuardando ? "Guardando..." : "Confirmar cobranza")
                </button>
            </div>
        </div>
    </div>
}

@* ════════════ Modal Nuevo cheque ════════════ *@
@if (showNuevo)
{
    <div class="modal-overlay">
        <div class="modal-card" style="max-width: 560px;">
            <div class="modal-header">
                <h3 style="margin:0;">➕ Nuevo cheque (alta manual)</h3>
                <button class="btn-close" @onclick="CerrarNuevo">✕</button>
            </div>
            <div class="modal-body">
                <p style="font-size:0.78rem; color:#6b7280; margin:0 0 0.7rem;">
                    Cargá un cheque físico (papel) que recibiste. Entra a cartera "sin asignar".
                    Cuando lo uses en una cobranza queda asociado al cliente que pagó.
                </p>
                <div class="form-row">
                    <div class="form-group" style="flex:2;">
                        <label class="form-label">Banco *</label>
                        <select class="form-input" @bind="fBancoId">
                            <option value="0">— Elegí un banco —</option>
                            @if (bancos is not null)
                            {
                                @foreach (var b in bancos.OrderBy(x => x.SortOrder).ThenBy(x => x.Display))
                                {
                                    <option value="@b.Id">@b.Display</option>
                                }
                            }
                        </select>
                        <p style="font-size:0.7rem; color:#6b7280; margin:0.2rem 0 0;">
                            ¿Falta el banco?
                            <a href="/cafe/configuracion/bancos" target="_blank" style="color:#2563eb;">Agregalo al catálogo</a>
                            y volvé.
                        </p>
                    </div>
                    <div class="form-group" style="flex:1.2;">
                        <label class="form-label">Número *</label>
                        <input class="form-input" @bind="fNumero" placeholder="Ej: 12345678" />
                    </div>
                </div>
                <div class="form-group">
                    <label class="form-label">Emisor (libra el cheque) — opcional</label>
                    <input class="form-input" @bind="fEmisor" placeholder="Razón social o nombre del firmante" />
                </div>
                <div class="form-row">
                    <div class="form-group" style="flex:1;">
                        <label class="form-label">Importe *</label>
                        <input class="form-input" type="number" step="0.01" min="0" @bind="fImporte" />
                    </div>
                    <div class="form-group" style="flex:1;">
                        <label class="form-label">Fecha cobro / vencimiento</label>
                        <input class="form-input" type="date"
                               value="@(fVenc?.ToString("yyyy-MM-dd"))"
                               @onchange="@(e => fVenc = string.IsNullOrEmpty(e.Value?.ToString()) ? null : DateTime.Parse(e.Value.ToString()!))" />
                    </div>
                </div>
                <div class="form-group">
                    <label class="form-label">Observaciones — opcional</label>
                    <textarea class="form-input" rows="2" @bind="fObs"></textarea>
                </div>
                @if (!string.IsNullOrEmpty(formError))
                {
                    <div style="background:#fee2e2; color:#991b1b; padding:0.5rem 0.7rem; border-radius:4px; font-size:0.82rem; margin-top:0.5rem;">@formError</div>
                }
            </div>
            <div class="modal-footer">
                <button class="btn btn-secondary" @onclick="CerrarNuevo" disabled="@savingNuevo">Cancelar</button>
                <button class="btn btn-primary" @onclick="GuardarNuevo" disabled="@savingNuevo">@(savingNuevo ? "Guardando..." : "Guardar cheque")</button>
            </div>
        </div>
    </div>
}

@code {
    private List<CafeChequeDto>? cheques;
    private bool loading = true;
    private string estadoFiltro = "EN_CARTERA";

    // ===== Modal Nuevo cheque =====
    private bool showNuevo;
    private bool savingNuevo;
    private string? formError;
    private int fBancoId;
    private string fNumero = "";
    private string fEmisor = "";
    private decimal fImporte;
    private DateTime? fVenc;
    private string fObs = "";
    private List<CafeBancoDto>? bancos;

    private async Task AbrirNuevo()
    {
        fBancoId = 0; fNumero = ""; fEmisor = ""; fImporte = 0; fVenc = null; fObs = "";
        formError = null;
        // Cargar catalogo de bancos en cada apertura (puede haber cambiado en otra pestaña)
        try { bancos = await Api.GetBancosAsync() ?? new(); }
        catch { bancos = new(); }
        showNuevo = true;
    }

    private void CerrarNuevo()
    {
        if (savingNuevo) return;
        showNuevo = false;
    }

    private async Task GuardarNuevo()
    {
        formError = null;
        if (fBancoId <= 0) { formError = "Elegí un banco del catálogo"; return; }
        if (string.IsNullOrWhiteSpace(fNumero)) { formError = "Número obligatorio"; return; }
        if (fImporte <= 0) { formError = "Importe debe ser mayor a 0"; return; }
        savingNuevo = true;
        try
        {
            var (cheque, err) = await Api.CrearChequeAsync(new CreateChequeRequest
            {
                BancoId = fBancoId,
                Numero = fNumero.Trim(),
                Emisor = string.IsNullOrWhiteSpace(fEmisor) ? null : fEmisor.Trim(),
                Importe = fImporte,
                FechaVencimiento = fVenc,
                FechaCobro = fVenc,
                Observaciones = string.IsNullOrWhiteSpace(fObs) ? null : fObs.Trim()
            });
            if (cheque is null) { formError = err ?? "No se pudo guardar"; return; }
            ToastService.Success($"Cheque {cheque.Banco} N° {cheque.Numero} agregado a cartera");
            showNuevo = false;
            await Load();
        }
        finally { savingNuevo = false; }
    }

    // ═══ 2026-08-18: Hacer la cobranza desde un cheque en cartera ═══
    private CafeChequeDto? cobChe;
    private List<CafeClienteDto>? clientes;
    private CafeClienteDto? cobCliente;
    private string cobClienteSearch = "";
    private List<ComprobantePendienteDto>? cobComprobantes;
    private class CobSelState { public bool Tildado; public decimal Importe; }
    private List<CobSelState> cobSeleccion = new();
    private decimal cobRetenciones;
    private string cobObservaciones = "";
    private bool cobCargandoComp, cobGuardando;
    private string? cobError;

    private decimal CobTotalImputar => cobSeleccion.Where(x => x.Tildado).Sum(x => x.Importe);
    private decimal CobTotalEsperado => (cobChe?.Importe ?? 0m) + cobRetenciones;

    private async Task AbrirCobranza(CafeChequeDto ch)
    {
        cobChe = ch;
        cobCliente = null;
        cobClienteSearch = "";
        cobComprobantes = null;
        cobSeleccion = new();
        cobRetenciones = 0m;
        cobObservaciones = "";
        cobError = null;
        try
        {
            clientes ??= await Api.GetCafeClientesAsync() ?? new();
            // Si el cheque ya venia con cliente origen cargado a mano, lo pre-elegimos
            if (ch.ClienteOrigenId.HasValue)
            {
                var pre = clientes.FirstOrDefault(c => c.Id == ch.ClienteOrigenId.Value);
                if (pre is not null) await ElegirClienteCobranza(pre);
            }
        }
        catch (Exception ex) { cobError = "Error cargando clientes: " + ex.Message; }
    }

    private void CerrarCobranza()
    {
        if (cobGuardando) return;
        cobChe = null;
    }

    private async Task ElegirClienteCobranza(CafeClienteDto c)
    {
        cobCliente = c;
        cobClienteSearch = "";
        cobCargandoComp = true;
        try
        {
            cobComprobantes = await Api.GetComprobantesPendientesAsync(c.Id, true) ?? new();
            cobSeleccion = cobComprobantes.Select(_ => new CobSelState()).ToList();
            // Pre-tildar de la mas vieja a la mas nueva hasta cubrir el importe del cheque
            decimal restante = cobChe?.Importe ?? 0m;
            for (int i = 0; i < cobComprobantes.Count && restante > 0.01m; i++)
            {
                var aImputar = Math.Min(cobComprobantes[i].Saldo, restante);
                if (aImputar <= 0m) continue;
                cobSeleccion[i].Tildado = true;
                cobSeleccion[i].Importe = Math.Round(aImputar, 2);
                restante -= aImputar;
            }
        }
        catch (Exception ex) { cobError = "Error cargando comprobantes: " + ex.Message; }
        finally { cobCargandoComp = false; }
    }

    private void QuitarClienteCobranza()
    {
        cobCliente = null;
        cobComprobantes = null;
        cobSeleccion = new();
    }

    private void OnTildarComprobanteCobranza(int idx, bool tildado)
    {
        if (idx < 0 || idx >= cobSeleccion.Count) return;
        cobSeleccion[idx].Tildado = tildado;
        if (tildado && cobSeleccion[idx].Importe <= 0m && cobComprobantes is not null)
            cobSeleccion[idx].Importe = cobComprobantes[idx].Saldo;
        if (!tildado) cobSeleccion[idx].Importe = 0m;
    }

    private void OnImporteComprobanteCobranza(int idx, string? raw)
    {
        if (idx < 0 || idx >= cobSeleccion.Count) return;
        if (MontoInput.TryParse(raw, out var v) && v >= 0)
            cobSeleccion[idx].Importe = Math.Round(v, 2);
    }

    /// <summary>Suma de los saldos de las facturas tildadas.</summary>
    private decimal CobSaldoTildado => cobComprobantes is null ? 0m
        : cobSeleccion.Select((s, i) => s.Tildado ? cobComprobantes[i].Saldo : 0m).Sum();

    /// <summary>Lo que le falta al cheque (+ retenciones ya cargadas) para saldar las facturas tildadas.</summary>
    private decimal CobFaltaCubrir => Math.Round(CobSaldoTildado - ((cobChe?.Importe ?? 0m) + cobRetenciones), 2);

    /// <summary>Sube cada factura tildada a su saldo total y pone la diferencia como retención.</summary>
    private void PonerFaltanteComoRetencionCobranza()
    {
        if (cobComprobantes is null) return;
        var falta = CobFaltaCubrir;
        if (falta <= 0.01m) return;
        cobRetenciones = Math.Round(cobRetenciones + falta, 2);
        for (int i = 0; i < cobSeleccion.Count; i++)
            if (cobSeleccion[i].Tildado) cobSeleccion[i].Importe = cobComprobantes[i].Saldo;
    }

    private async Task ConfirmarCobranza()
    {
        if (cobChe is null || cobCliente is null) { cobError = "Falta elegir el cliente"; return; }
        cobError = null;

        var items = cobSeleccion
            .Select((sel, i) => new { sel, comp = cobComprobantes![i] })
            .Where(x => x.sel.Tildado && x.sel.Importe > 0m)
            .Select(x => new ImputarComprobanteItem { VentaId = x.comp.VentaId, Importe = x.sel.Importe })
            .ToList();

        // Lo que sobre del cheque (+ retenciones) queda a cuenta del cliente
        var diferencia = Math.Round(CobTotalEsperado - CobTotalImputar, 2);
        if (diferencia < -0.01m)
        {
            cobError = $"Imputaste ${CobTotalImputar:N2} pero el cheque + retenciones suman ${CobTotalEsperado:N2}. Reducí algún importe.";
            return;
        }
        if (diferencia > 0.01m)
            items.Add(new ImputarComprobanteItem { VentaId = null, Importe = diferencia });
        if (items.Count == 0)
        {
            cobError = "No hay nada para imputar";
            return;
        }

        cobGuardando = true;
        try
        {
            var (numero, err) = await Api.CrearCobranzaDesdeChequeAsync(cobChe.Id, new AsociarECheqRequest
            {
                ClienteId = cobCliente.Id,
                Retenciones = cobRetenciones,
                Observaciones = string.IsNullOrWhiteSpace(cobObservaciones) ? null : cobObservaciones.Trim(),
                Comprobantes = items
            });
            if (err is not null) { cobError = err; return; }
            ToastService.Success($"✓ Cobranza {numero} creada con el cheque N° {cobChe.Numero}");
            cobChe = null;
            await Load();
        }
        finally { cobGuardando = false; }
    }

    private readonly (string key, string label)[] estados = new[]
    {
        ("EN_CARTERA", "En cartera"),
        // 2026-08-18: solapa nueva — los que están en el banco esperando acreditación
        ("DEPOSITADO", "En el banco"),
        ("ACREDITADO", "Acreditados"),
        ("COBRADO_VENTANILLA", "Cobrados ventanilla"),
        ("ENDOSADO", "Endosados"),
        ("RECHAZADO", "Rechazados"),
        ("", "Todos")
    };

    private IEnumerable<CafeChequeDto> ChequesFiltrados =>
        cheques?.Where(c => string.IsNullOrEmpty(estadoFiltro) || c.Estado == estadoFiltro) ?? Enumerable.Empty<CafeChequeDto>();

    protected override async Task OnInitializedAsync() => await Load();

    private async Task Load()
    {
        loading = true;
        try { cheques = await Api.GetCafeChequesAsync() ?? new(); }
        catch { ToastService.Error("Error al cargar"); cheques = new(); }
        loading = false;
    }

    private async Task SetFiltro(string k) { estadoFiltro = k; await Task.CompletedTask; }

    private async Task Depositar(CafeChequeDto c)
    {
        try { await Api.DepositarChequeAsync(c.Id); ToastService.Success("Depositado / Acreditado"); await Load(); }
        catch (Exception ex) { ToastService.Error(ex.Message); }
    }
    /// <summary>2026-08-18: paso 1 — lo mandé al banco, queda esperando acreditación (solapa "En el banco").</summary>
    private async Task MandarAlBanco(CafeChequeDto c)
    {
        try { await Api.MandarChequeAlBancoAsync(c.Id); ToastService.Success("Mandado al banco — esperando acreditación"); await Load(); }
        catch (Exception ex) { ToastService.Error(ex.Message); }
    }
    /// <summary>2026-08-18: paso 2 — el banco lo acreditó.</summary>
    private async Task Acreditar(CafeChequeDto c)
    {
        try { await Api.AcreditarChequeAsync(c.Id); ToastService.Success("Acreditado"); await Load(); }
        catch (Exception ex) { ToastService.Error(ex.Message); }
    }
    private async Task CobrarVent(CafeChequeDto c)
    {
        try { await Api.CobrarChequeVentanillaAsync(c.Id); ToastService.Success("Cobrado por ventanilla"); await Load(); }
        catch (Exception ex) { ToastService.Error(ex.Message); }
    }
    private async Task Rechazar(CafeChequeDto c)
    {
        try { await Api.RechazarChequeAsync(c.Id); ToastService.Success("Rechazado (rebotó)"); await Load(); }
        catch (Exception ex) { ToastService.Error(ex.Message); }
    }

    private static string EstadoLabel(string e) => e switch
    {
        "EN_CARTERA" => "📥 En cartera",
        "DEPOSITADO" => "🏦 En el banco",
        "ACREDITADO" => "✅ Acreditado",
        "COBRADO_VENTANILLA" => "💵 Cobrado ventanilla",
        "ENDOSADO" => "➡ Endosado",
        "RECHAZADO" => "❌ Rechazado",
        _ => e
    };
    private static string EstadoClass(string e) => e switch
    {
        "EN_CARTERA" or "DEPOSITADO" => "badge-warning",
        "ACREDITADO" or "COBRADO_VENTANILLA" => "badge-success",
        "ENDOSADO" => "badge-secondary",
        "RECHAZADO" => "badge-danger",
        _ => "badge-secondary"
    };
}
