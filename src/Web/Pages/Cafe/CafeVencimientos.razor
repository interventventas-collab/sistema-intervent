@page "/cafe/vencimientos"
@attribute [Authorize]
@implements IDisposable
@inject ApiClient Api
@inject ToastService ToastService

@* 2026-11-04: "Asignar vencimientos". Buscás producto o marca y le asignás cantidad + fecha.
   Lo que queda de cada fecha lo calcula el sistema con el stock (sale primero lo que vence antes).
   Pensada para usar desde el celu del depósito también: una columna, botones grandes. *@

<style>
    .vc-wrap { max-width: 900px; margin: 0 auto; padding: 1rem; }
    .vc-top { display: flex; gap: 0.6rem; flex-wrap: wrap; align-items: center; margin-bottom: 0.8rem; }
    .vc-top input[type=search] { flex: 1; min-width: 220px; font-size: 1rem; padding: 0.6rem 0.8rem; border: 1px solid #d1d5db; border-radius: 8px; }
    .vc-chk { font-size: 0.85rem; color: #374151; display: flex; align-items: center; gap: 0.35rem; cursor: pointer; }
    .vc-ayuda { font-size: 0.8rem; color: #6b7280; margin-bottom: 0.8rem; }
    .vc-card { background: #fff; border: 1px solid #e5e7eb; border-radius: 10px; padding: 0.7rem 0.8rem; margin-bottom: 0.6rem; }
    .vc-tit { font-size: 0.95rem; font-weight: 600; color: #111827; }
    .vc-sku { color: #1e40af; font-family: monospace; font-weight: 600; margin-right: 0.35rem; }
    .vc-sub { font-size: 0.78rem; color: #6b7280; margin-top: 2px; }
    .vc-sub b { color: #374151; }
    .vc-falta { color: #b45309; font-weight: 700; }
    .vc-fila { display: flex; align-items: center; gap: 0.5rem; font-size: 0.88rem; padding: 0.35rem 0; border-top: 1px solid #f3f4f6; }
    .vc-fila .f { flex: 1; }
    .vc-fila.term { color: #9ca3af; }
    .vc-venc { color: #dc2626; font-weight: 700; }
    .vc-form { display: flex; gap: 0.4rem; align-items: center; flex-wrap: wrap; margin-top: 0.45rem; }
    .vc-form input { font-size: 0.95rem; padding: 0.45rem 0.55rem; border: 1px solid #d1d5db; border-radius: 6px; }
    .vc-form .cant { width: 90px; }
    .vc-btn { background: #1d4ed8; color: #fff; border: none; border-radius: 6px; padding: 0.5rem 0.8rem; font-weight: 600; font-size: 0.85rem; cursor: pointer; }
    .vc-btn:disabled { opacity: 0.5; }
    /* 2026-11-04: hechos bien visibles + filtros por estado y marca (botones, no desplegable) */
    .vc-card.hecho { border-left: 5px solid #16a34a; background: #f0fdf4; }
    .vc-listo { float: right; color: #15803d; font-weight: 800; font-size: 0.9rem; white-space: nowrap; margin-left: 0.5rem; }
    .vc-chips { display: flex; flex-wrap: wrap; gap: 0.35rem; margin-bottom: 0.55rem; }
    .vc-chip { border: 1px solid #d1d5db; background: #fff; color: #374151; border-radius: 999px; padding: 0.3rem 0.75rem; font-size: 0.82rem; cursor: pointer; }
    .vc-chip.on { background: #1d4ed8; border-color: #1d4ed8; color: #fff; font-weight: 600; }
    .vc-chips-lbl { font-size: 0.78rem; color: #6b7280; align-self: center; margin-right: 0.2rem; }
    /* 2026-11-04 v2 (opción B): tarjeta compacta. Foto chica + nombre + lugar + etiquetas; stock en cajita a la derecha. */
    .vc-head { display: flex; gap: 0.7rem; align-items: flex-start; }
    .vc-fotob { width: 56px; height: 56px; border-radius: 8px; border: 1px solid #e5e7eb; background: #fff; flex-shrink: 0; position: relative; cursor: pointer; display: flex; align-items: center; justify-content: center; }
    .vc-fotob img { width: 100%; height: 100%; object-fit: contain; border-radius: 8px; }
    .vc-fotob.no { border-style: dashed; font-size: 0.65rem; color: #9ca3af; }
    .vc-fotob .cam { position: absolute; right: -7px; bottom: -7px; background: #fff; border: 1px solid #d1d5db; border-radius: 50%; width: 22px; height: 22px; font-size: 0.7rem; display: flex; align-items: center; justify-content: center; }
    .vc-info { flex: 1; min-width: 0; }
    .vc-lugar { margin-top: 1px; }
    .vc-chips2 { display: flex; gap: 0.3rem; flex-wrap: wrap; margin-top: 0.3rem; align-items: center; }
    .vc-et { font-size: 0.72rem; padding: 0.1rem 0.5rem; border-radius: 999px; border: 1px solid #e5e7eb; background: #fff; color: #6b7280; white-space: nowrap; }
    .vc-et.ok { border-color: #86efac; color: #15803d; background: #f0fdf4; }
    .vc-et.no { border-color: #fcd34d; color: #92400e; background: #fffbeb; }
    .vc-listo2 { color: #15803d; font-weight: 800; font-size: 0.8rem; margin-left: 0.2rem; }
    .vc-stock { text-align: center; border: 1px solid #e5e7eb; border-radius: 8px; padding: 0.3rem 0.6rem; min-width: 84px; background: #f9fafb; flex-shrink: 0; }
    .vc-stock .l { font-size: 0.62rem; color: #6b7280; text-transform: uppercase; letter-spacing: 0.4px; }
    .vc-stock .n { font-size: 1.35rem; font-weight: 800; line-height: 1.15; }
    .vc-stock .acc { font-size: 0.7rem; color: #6b7280; white-space: nowrap; }
    .vc-stock .acc a { color: #4b5563; }
    .vc-stock.ok { border-color: #86efac; background: #f0fdf4; }
    .vc-stock.ok .acc { color: #15803d; }
    .vc-stock.abierto { border-color: #f59e0b; background: #fffbeb; text-align: left; min-width: 220px; max-width: 280px; }
    .vc-stock.abierto .row { display: flex; gap: 0.3rem; align-items: center; margin-top: 0.3rem; flex-wrap: wrap; }
    .vc-stock.abierto input { width: 64px; font-size: 0.95rem; padding: 0.3rem 0.4rem; border: 1px solid #d1d5db; border-radius: 6px; }
    .vc-bnar { background: #f59e0b; color: #fff; border: none; border-radius: 6px; padding: 0.35rem 0.6rem; font-weight: 700; font-size: 0.8rem; cursor: pointer; }
    .vc-bnar:disabled { opacity: 0.5; }
    @@media (max-width: 600px) { .vc-head { flex-wrap: wrap; } .vc-stock.abierto { max-width: none; width: 100%; } }
    .vc-bx { background: #fff; border: 1px solid #d1d5db; border-radius: 6px; padding: 0.3rem 0.5rem; font-size: 0.78rem; cursor: pointer; }
    .vc-card > .vc-fila:first-of-type { margin-top: 0.4rem; }
    .vc-sec { display: flex; align-items: center; gap: 0.5rem; flex-wrap: wrap; font-size: 0.88rem; padding: 0.4rem 0; border-bottom: 1px solid #f3f4f6; }
    .vc-sec .cant { font-size: 0.95rem; padding: 0.4rem 0.5rem; border: 1px solid #d1d5db; border-radius: 6px; }
    .vc-lbl { width: 6.7rem; flex-shrink: 0; color: #6b7280; font-size: 0.78rem; font-weight: 700; }
    .vc-foto { width: 56px; height: 56px; object-fit: contain; border-radius: 8px; border: 1px solid #e5e7eb; background: #fff; cursor: pointer; }
    .vc-foto-no { display: inline-flex; align-items: center; justify-content: center; font-size: 0.7rem; color: #9ca3af; }
    .vc-ok { color: #15803d; font-weight: 600; }
    .vc-ic { background: #f3f4f6; border: 1px solid #e5e7eb; border-radius: 6px; padding: 0.3rem 0.5rem; cursor: pointer; font-size: 0.85rem; }
</style>

<div class="vc-wrap">
    <h2 style="margin: 0 0 0.6rem;">📅 Asignar vencimientos</h2>
    <div class="vc-top">
        <input type="search" placeholder="Buscar producto, código o marca (ej: cremuccino)" @bind="busqueda" @bind:event="oninput" @bind:after="Buscar" />
    </div>
    <div class="vc-chips">
        <span class="vc-chips-lbl">Ver:</span>
        <button class="vc-chip @(estado == "TODOS" ? "on" : "")" @onclick="@(() => CambiarEstado("TODOS"))">Todos</button>
        <button class="vc-chip @(estado == "PEND" ? "on" : "")" @onclick="@(() => CambiarEstado("PEND"))">Pendientes@(productos is not null && estado != "HECHOS" ? $" ({productos.Count(x => !Hecho(x))})" : "")</button>
        <button class="vc-chip @(estado == "HECHOS" ? "on" : "")" @onclick="@(() => CambiarEstado("HECHOS"))">✅ Hechos@(productos is not null ? $" ({productos.Count(Hecho)})" : "")</button>
    </div>
    @if (marcas is { Count: > 0 })
    {
        <div class="vc-chips">
            <span class="vc-chips-lbl">Marca:</span>
            <button class="vc-chip @(marca is null ? "on" : "")" @onclick="@(() => CambiarMarca(null))">Todas</button>
            @foreach (var m in marcas)
            {
                <button class="vc-chip @(marca == m ? "on" : "")" @onclick="@(() => CambiarMarca(m))">@m</button>
            }
        </div>
    }
    <div class="vc-ayuda">
        Poné cuántos hay con cada fecha. El stock no cambia: solo le ponés fecha a lo que ya está.
        El sistema va indicando sacar primero el que vence antes.
    </div>

    @if (cargando)
    {
        <p style="color:#6b7280;">Buscando...</p>
    }
    else if (productos is null || productos.Count == 0)
    {
        <p style="color:#9ca3af;">@(string.IsNullOrWhiteSpace(busqueda) && marca is null && estado != "HECHOS" ? "Escribí un producto o tocá una marca para empezar." : "No encontré productos.")</p>
    }
    else
    {
        @foreach (var p in productos.Where(x => estado == "TODOS" || (estado == "HECHOS") == Hecho(x)))
        {
            var f = Form(p.ProductoId);
            var hecho = Hecho(p);
            var c = Conteo(p.ProductoId);
            var fotoUrl = FotoUrl(p);
            var contadoOk = !p.EsCafe && p.UltimoConteoAt is DateTime cOk && cOk >= DateTime.UtcNow.AddDays(-30);
            <div class="vc-card @(hecho ? "hecho" : "")">
                <div class="vc-head">
                    @* FOTO chiquita: tocás y se abre la ventanita de foto (ver · cambiar · está mal) *@
                    <div class="vc-fotob @(fotoUrl is null ? "no" : "")" title="Foto: ver, cambiar o avisar que está mal" @onclick="() => fotoAbierta = p">
                        @if (fotoUrl is not null) { <img src="@fotoUrl" alt="" /> } else { <span>sin foto</span> }
                        <span class="cam">📷</span>
                    </div>
                    <div class="vc-info">
                        <div class="vc-tit">@if (!string.IsNullOrEmpty(p.Sku)) { <span class="vc-sku">@p.Sku</span> }@p.Nombre</div>
                        <div class="vc-lugar">
                            <LugarProducto ProductoId="p.ProductoId" Lugar="@p.Ubicacion" Dudoso="p.LugarDudoso" Editable="true" PermitirCambiar="true"
                                           OfrecerNoEsta="false" Tamano="0.78rem" OnCambio="() => Recargar(p.ProductoId)" />
                        </div>
                        <div class="vc-chips2">
                            <span class="vc-et @(fotoUrl is not null && p.FotoEstado != "REPORTADA" ? "ok" : "no")">📷 @(fotoUrl is null ? "sin foto" : p.FotoEstado == "REPORTADA" ? "foto mal" : "foto")</span>
                            @if (!p.EsCafe)
                            {
                                <span class="vc-et @(contadoOk ? "ok" : "no")">📦 @(contadoOk ? $"contado {p.UltimoConteoAt!.Value.AddHours(-3):dd/MM}" : "sin contar")</span>
                            }
                            <span class="vc-et @(string.IsNullOrEmpty(p.Ubicacion) ? "no" : "ok")">📍 @(string.IsNullOrEmpty(p.Ubicacion) ? "sin lugar" : p.Ubicacion)</span>
                            <span class="vc-et @(p.Filas.Count > 0 && p.SinVencimiento <= 0 ? "ok" : "no")">📅 @(p.Filas.Count == 0 ? "sin fechas" : p.SinVencimiento > 0 ? $"faltan {Cant(p.SinVencimiento, p.EsCafe)}" : "fechas")</span>
                            @if (hecho) { <span class="vc-listo2">✅ LISTO</span> }
                        </div>
                    </div>

                    @* STOCK: cajita arriba a la derecha. Se toca solo si está mal (naranja) o para decir que está bien. *@
                    @if (p.EsCafe)
                    {
                        <div class="vc-stock" title="El café se corrige desde Stock (va en kilos)"><div class="l">stock</div><div class="n">@Cant(p.Stock, true)</div></div>
                    }
                    else if (c.Confirmar is not null)
                    {
                        var cf = c.Confirmar;
                        <div class="vc-stock abierto">
                            <div class="l">el sistema dice @cf.StockAntes</div>
                            <div style="font-size:0.8rem; margin-top:3px;">Quedaría en <b>@cf.StockDespues</b>@(cf.Apartados > 0 ? $" ({c.Contado} − {cf.Apartados} vendidos sin armar)" : ""). ¿Lo contaste bien?</div>
                            <div class="row">
                                <button class="vc-bnar" disabled="@c.Guardando" @onclick="() => Contar(p, true)">Sí, corregir</button>
                                <button class="vc-bx" @onclick="() => c.Confirmar = null">Vuelvo a contar</button>
                            </div>
                        </div>
                    }
                    else if (c.Abierto)
                    {
                        <div class="vc-stock abierto">
                            <div class="l">stock · el sistema dice @Cant(p.Stock, false)</div>
                            <div class="row">
                                <span style="font-size:0.85rem;">Contaste</span>
                                <input type="number" min="0" step="1" @bind="c.Contado" />
                                <button class="vc-bnar" disabled="@c.Guardando" @onclick="() => Contar(p, false)">Corregir</button>
                                <button class="vc-bx" title="Cerrar" @onclick="() => { c.Abierto = false; c.Contado = null; }">✕</button>
                            </div>
                            <div style="font-size:0.68rem; color:#92400e; margin-top:3px;">No cuentes lo ya armado para pedidos.</div>
                        </div>
                    }
                    else
                    {
                        <div class="vc-stock @(contadoOk ? "ok" : "")">
                            <div class="l">stock</div>
                            <div class="n">@Cant(p.Stock, false)</div>
                            <div class="acc">
                                <a href="javascript:void(0)" @onclick="() => c.Abierto = true">✏️ corregir</a>
                                @if (!contadoOk)
                                {
                                    <span> · </span><a href="javascript:void(0)" title="Lo que hay en el estante coincide" @onclick="() => EstaBien(p)">✓ bien</a>
                                }
                                else
                                {
                                    <span> · ✓ contado</span>
                                }
                            </div>
                        </div>
                    }
                </div>
                @foreach (var fl in p.Filas)
                {
                    var term = fl.Quedan <= 0;
                    var vencido = fl.FechaVence.Date < Hoy && !term;
                    <div class="vc-fila @(term ? "term" : "")">
                        @if (editandoId == fl.Id)
                        {
                            <input class="cant" type="number" min="0" step="@(p.EsCafe ? "0.1" : "1")" @bind="editCant" style="width:80px;font-size:0.9rem;padding:0.3rem;border:1px solid #d1d5db;border-radius:6px;" />
                            <input type="date" @bind="editFecha" style="font-size:0.9rem;padding:0.3rem;border:1px solid #d1d5db;border-radius:6px;" />
                            <button class="vc-btn" @onclick="() => GuardarEdicion(p, fl)">Guardar</button>
                            <button class="vc-ic" @onclick="() => editandoId = null">✕</button>
                        }
                        else
                        {
                            <span class="f">
                                <b>@Cant(fl.Cantidad, p.EsCafe)</b> · vence <b class="@(vencido ? "vc-venc" : "")">@fl.FechaVence.ToString("dd/MM/yyyy")</b>@(vencido ? " (vencido)" : "")
                                <span style="color:#6b7280;"> · @(term ? "terminado" : $"quedan {Cant(fl.Quedan, p.EsCafe)}")@(!term && fl.FechaVence == p.ProximoVence ? " · sacar primero" : "")</span>
                            </span>
                            <button class="vc-ic" title="Corregir" @onclick="() => EmpezarEdicion(fl)">✏️</button>
                            <button class="vc-ic" title="Borrar" @onclick="() => Borrar(p, fl)">🗑</button>
                        }
                    </div>
                }
                <div class="vc-form">
                    <input class="cant" type="number" min="0" step="@(p.EsCafe ? "0.1" : "1")" placeholder="@(p.EsCafe ? "kg" : "cant.")" @bind="f.Cantidad" />
                    <input type="date" @bind="f.Fecha" />
                    <button class="vc-btn" disabled="@(f.Guardando)" @onclick="() => Asignar(p)">+ Asignar vencimiento</button>
                </div>
            </div>
        }
    }
</div>

@if (fotoAbierta is not null)
{
    <FotoProductoModal ProductoId="fotoAbierta.ProductoId" Sku="@fotoAbierta.Sku" Nombre="@fotoAbierta.Nombre"
                       FotoPropiaArchivo="@fotoAbierta.FotoPropiaArchivo" MeliThumb="@fotoAbierta.MeliThumb" Estado="@fotoAbierta.FotoEstado"
                       OnCambio="OnFotoCambio" OnCerrar="() => fotoAbierta = null" />
}

@code {
    private class FormFila { public decimal? Cantidad; public DateTime? Fecha; public bool Guardando; }

    private string busqueda = "";
    private string estado = "TODOS";          // TODOS | PEND | HECHOS
    private string? marca;
    private List<string>? marcas;
    private bool cargando;
    private List<VencProductoDto>? productos;
    private readonly Dictionary<int, FormFila> forms = new();
    private int? editandoId;
    private decimal? editCant;
    private DateTime? editFecha;
    private CancellationTokenSource? cts;
    private static DateTime Hoy => DateTime.UtcNow.AddHours(-3).Date;   // hora argentina

    /// <summary>✅ LISTO = todo el stock con fecha + con lugar + contado en los últimos 30 días (café: sin conteo).</summary>
    private static bool Hecho(VencProductoDto p) => p.Filas.Count > 0 && p.SinVencimiento <= 0
        && !string.IsNullOrEmpty(p.Ubicacion)
        && (p.EsCafe || (p.UltimoConteoAt is DateTime c && c >= DateTime.UtcNow.AddDays(-30)));

    private class ConteoFila { public int? Contado; public bool Guardando; public VencContarResp? Confirmar; public bool Abierto; }
    private readonly Dictionary<int, ConteoFila> conteos = new();
    private ConteoFila Conteo(int id) { if (!conteos.TryGetValue(id, out var c)) conteos[id] = c = new ConteoFila(); return c; }
    private VencProductoDto? fotoAbierta;

    private static string? FotoUrl(VencProductoDto p)
    {
        if (!string.IsNullOrEmpty(p.FotoPropiaArchivo)) return $"/api/public/producto-foto/img/{p.FotoPropiaArchivo}";
        if (p.FotoEstado == "REPORTADA") return null;   // la de MeLi está marcada como mal: no mostrarla
        return string.IsNullOrEmpty(p.MeliThumb) ? null : p.MeliThumb.Replace("http://", "https://");
    }

    private async Task Contar(VencProductoDto p, bool confirmado)
    {
        var c = Conteo(p.ProductoId);
        if (c.Contado is not int n || n < 0) { ToastService.Error("Poné cuántos contaste"); return; }
        c.Guardando = true;
        try
        {
            var r = await Api.ContarStockVencimientosAsync(p.ProductoId, n, confirmado);
            if (r is null) return;
            if (r.Confirmar) { c.Confirmar = r; return; }
            c.Confirmar = null; c.Contado = null; c.Abierto = false;
            Reemplazar(r.Producto);
            ToastService.Success(r.StockAntes == r.StockDespues ? "Contado: coincide con el sistema" : $"Stock arreglado: {r.StockAntes} → {r.StockDespues}");
        }
        catch (Exception ex) { ToastService.Error(ex.Message); }
        finally { c.Guardando = false; }
    }

    /// <summary>"✓ bien": lo que hay en el estante coincide con el sistema (queda anotado como contado, sin tocar el stock).</summary>
    private async Task EstaBien(VencProductoDto p)
    {
        var c = Conteo(p.ProductoId);
        c.Guardando = true;
        try
        {
            var r = await Api.ContarStockVencimientosAsync(p.ProductoId, 0, false, coincide: true);
            Reemplazar(r?.Producto);
            ToastService.Success("Anotado: el stock está bien");
        }
        catch (Exception ex) { ToastService.Error(ex.Message); }
        finally { c.Guardando = false; }
    }

    private async Task Recargar(int productoId)
    {
        try { Reemplazar(await Api.GetVencimientosProductoAsync(productoId)); StateHasChanged(); } catch { }
    }

    private async Task OnFotoCambio((string? Archivo, string? Estado) x)
    {
        if (fotoAbierta is not null) await Recargar(fotoAbierta.ProductoId);
    }

    protected override async Task OnInitializedAsync()
    {
        try { marcas = await Api.GetVencimientosMarcasAsync(); } catch { marcas = null; }
    }

    private async Task CambiarEstado(string e) { estado = e; await Buscar(); }
    private async Task CambiarMarca(string? m) { marca = m; await Buscar(); }

    private FormFila Form(int productoId)
    {
        if (!forms.TryGetValue(productoId, out var f)) forms[productoId] = f = new FormFila();
        return f;
    }

    /// <summary>4.000 → 4 (sin ceros de más, para que no parezca cuatro mil).</summary>
    private static decimal Limpio(decimal v) => v / 1.000000000000000000000000000000000m;

    private static string Cant(decimal v, bool esCafe) =>
        esCafe ? $"{v:0.#} kg" : v.ToString("N0");

    private async Task Buscar()
    {
        cts?.Cancel();
        cts = new CancellationTokenSource();
        var tk = cts.Token;
        try { await Task.Delay(350, tk); } catch (TaskCanceledException) { return; }
        cargando = true; StateHasChanged();
        try
        {
            var r = await Api.GetVencimientosCargaAsync(busqueda, true, estado == "HECHOS", marca);
            if (tk.IsCancellationRequested) return;
            productos = r ?? new();
            // la cantidad sugerida = lo que falta asignar
            foreach (var p in productos)
            {
                var f = Form(p.ProductoId);
                if (f.Cantidad is null && p.SinVencimiento > 0) f.Cantidad = Limpio(p.SinVencimiento);
            }
        }
        catch (Exception ex) { ToastService.Error(ex.Message); }
        finally { if (!tk.IsCancellationRequested) { cargando = false; StateHasChanged(); } }
    }

    private void Reemplazar(VencProductoDto? nuevo)
    {
        if (nuevo is null || productos is null) return;
        var i = productos.FindIndex(x => x.ProductoId == nuevo.ProductoId);
        if (i >= 0) productos[i] = nuevo;
    }

    private async Task Asignar(VencProductoDto p)
    {
        var f = Form(p.ProductoId);
        if (f.Cantidad is not > 0) { ToastService.Error("Poné cuántos vencen en esa fecha"); return; }
        if (f.Fecha is null) { ToastService.Error("Poné la fecha de vencimiento"); return; }
        f.Guardando = true;
        try
        {
            var r = await Api.AsignarVencimientoAsync(p.ProductoId, f.Cantidad.Value, f.Fecha.Value);
            Reemplazar(r);
            f.Cantidad = r is { SinVencimiento: > 0 } ? Limpio(r.SinVencimiento) : null;
            f.Fecha = null;
            ToastService.Success("Vencimiento asignado");
        }
        catch (Exception ex) { ToastService.Error(ex.Message); }
        finally { f.Guardando = false; }
    }

    private void EmpezarEdicion(VencFilaDto fl)
    {
        editandoId = fl.Id; editCant = Limpio(fl.Cantidad); editFecha = fl.FechaVence;
    }

    private async Task GuardarEdicion(VencProductoDto p, VencFilaDto fl)
    {
        if (editCant is not > 0 || editFecha is null) { ToastService.Error("Completá cantidad y fecha"); return; }
        try
        {
            Reemplazar(await Api.EditarVencimientoAsync(fl.Id, editCant.Value, editFecha.Value));
            editandoId = null;
        }
        catch (Exception ex) { ToastService.Error(ex.Message); }
    }

    private async Task Borrar(VencProductoDto p, VencFilaDto fl)
    {
        try
        {
            if (await Api.BorrarVencimientoAsync(fl.Id))
                Reemplazar(await Api.GetVencimientosProductoAsync(p.ProductoId));
        }
        catch (Exception ex) { ToastService.Error(ex.Message); }
    }

    public void Dispose() { cts?.Cancel(); cts?.Dispose(); }
}
