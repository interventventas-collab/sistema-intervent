@page "/cafe/tesoreria/pagos"
@attribute [Authorize]
@inject ApiClient Api
@inject ToastService ToastService
@inject IJSRuntime JS
@inject AuthService AuthSvc

<div class="card">
    <div class="card-header" style="display:flex; justify-content:space-between; align-items:center; flex-wrap:wrap; gap:0.5rem;">
        <h3 style="margin:0;">📤 Pagos a proveedores (@(pagos?.Count ?? 0))</h3>
        <button class="btn btn-primary" @onclick="ShowNuevo">+ Nuevo pago</button>
    </div>
    <div class="card-body" style="padding:0;">
        @if (loading)
        {
            <p class="text-muted" style="padding:1rem;">Cargando...</p>
        }
        else if (pagos is null || pagos.Count == 0)
        {
            <p class="text-muted" style="padding:1rem;">Sin pagos cargados.</p>
        }
        else
        {
            <table class="table table-compact">
                <thead>
                    <tr>
                        <th>Número</th><th>Fecha</th><th>Proveedor</th>
                        <th style="text-align:right;">Retenciones</th><th style="text-align:right;">Total</th>
                        <th>Estado</th><th>Acciones</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var p in pagos)
                    {
                        <tr style="@(p.Estado == "ANULADA" ? "opacity:0.5; text-decoration:line-through;" : "")">
                            <td><b>@p.Numero</b></td>
                            <td>@p.Fecha.ToArTime().ToString("dd/MM/yyyy")</td>
                            <td>@p.ProveedorNombre</td>
                            <td style="text-align:right;">@(p.Retenciones > 0 ? $"${p.Retenciones:N2}" : "—")</td>
                            <td style="text-align:right; font-weight:600;">$@p.Total.ToString("N2")</td>
                            <td><span class="badge @(p.Estado == "VIGENTE" ? "badge-success" : "badge-danger")">@p.Estado</span></td>
                            <td>
                                @if (p.Estado == "VIGENTE")
                                {
                                    <button class="btn-icon" @onclick="() => AnularPago(p)" title="Anular pago">❌</button>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        }
    </div>
</div>

@if (showNuevo)
{
    <div class="modal-overlay" @onclick="CloseNuevo">
        <div class="modal-card" @onclick:stopPropagation="true" style="max-width: 900px; width:90vw; max-height: 90vh; overflow-y:auto;">
            <div class="modal-header">
                <h4 style="margin:0;">@(aQuien == "empleado" ? "💵 Nuevo pago a empleado" : "📤 Nuevo pago a proveedor")</h4>
                <button class="btn-close" @onclick="CloseNuevo">&times;</button>
            </div>
            <div class="modal-body">
                @* 2026-11-16: "Nuevo pago" también para empleados (sueldo, horas extras, feriado...). Solo quien ve Sueldos. *@
                @if (puedeEmpleados)
                {
                    <div style="display:flex; gap:0.4rem; margin-bottom:0.8rem;">
                        <span style="align-self:center; color:#6b7280; font-size:0.85rem;">¿A quién?</span>
                        <button type="button" class="btn @(aQuien == "proveedor" ? "btn-primary" : "btn-secondary")" @onclick='() => aQuien = "proveedor"'>Proveedor</button>
                        <button type="button" class="btn @(aQuien == "empleado" ? "btn-primary" : "btn-secondary")" @onclick='() => aQuien = "empleado"'>Empleado</button>
                    </div>
                }
                @if (aQuien == "empleado")
                {
                    <PagoEmpleadoForm />
                }
                else
                {
                @if (gastoWa is not null)
                {
                    @* 18/11/2026: abierto desde un "#gasto" de WhatsApp: el mensaje (y la foto) arriba. *@
                    <div style="display:flex; gap:0.7rem; border-left:3px solid #2563eb; background:#f7f9ff; padding:0.6rem 0.8rem; margin-bottom:0.9rem; border-radius:4px;">
                        @if (!string.IsNullOrEmpty(gastoWa.MediaUrl))
                        {
                            <a href="@gastoWa.MediaUrl" target="_blank" title="Ver el ticket grande">
                                @if ((gastoWa.MediaFilename ?? "").EndsWith(".pdf", StringComparison.OrdinalIgnoreCase))
                                {
                                    <span style="font-size:0.85rem;">📎 @gastoWa.MediaFilename</span>
                                }
                                else
                                {
                                    <img src="@gastoWa.MediaUrl" alt="ticket" style="width:70px; height:90px; object-fit:cover; border-radius:4px; border:1px solid #e5e7eb;" />
                                }
                            </a>
                        }
                        <div style="font-size:0.9rem;">
                            <div style="color:#6b7280; font-size:0.78rem;">💸 #gasto por WhatsApp · @(gastoWa.Quien ?? gastoWa.Numero) · @gastoWa.CreatedAt.ToArTime().ToString("dd/MM HH:mm")</div>
                            <b>@gastoWa.Texto</b>
                            @foreach (var c in gastoWa.Comentarios)
                            {
                                <div style="font-size:0.8rem; color:#374151;">💬 @c.Texto <span style="color:#9ca3af;">· @c.Usuario</span></div>
                            }
                            <div style="color:#6b7280; font-size:0.78rem; margin-top:0.2rem;">Elegí a quién se le pagó. Importe y forma de pago vienen del mensaje: revisalos. Al guardar, el gasto queda con ✅.</div>
                        </div>
                    </div>
                }
                @if (programado is not null)
                {
                    <div style="margin-bottom:0.8rem; font-size:0.85rem; color:#374151;">
                        📅 Pago programado para el @FechaPalabras.Corta(programado.Fecha) · <b>$@programado.Importe.ToString("N2")</b>@(string.IsNullOrWhiteSpace(programado.Nota) ? "" : " · " + programado.Nota).
                        Al guardarlo sale de la lista de programados.
                    </div>
                }
                @* --- Proveedor --- *@
                <div class="form-group" style="position:relative;">
                    <label class="form-label">Proveedor</label>
                    @if (selProveedorId > 0)
                    {
                        var pSel = proveedores?.FirstOrDefault(x => x.Id == selProveedorId);
                        <div style="display:flex; gap:0.3rem; align-items:center;">
                            <div class="form-input" style="flex:1; background:#ecfdf5; border-color:#10b981;">
                                <strong>@(pSel?.Nombre ?? "?")</strong>
                                @if (pSel is not null && !string.IsNullOrEmpty(pSel.Cuit)) { <span style="font-size:0.72rem; color:#6b7280;"> · @pSel.Cuit</span> }
                            </div>
                            <button class="btn btn-secondary" type="button" @onclick="ClearProveedor">×</button>
                        </div>
                    }
                    else
                    {
                        <input class="form-input" @bind="provSearch" @bind:event="oninput" @onfocus="() => provSearchOpen = true" @onblur="CerrarBusquedaLuego"
                               placeholder="🔍 Buscar proveedor por nombre o CUIT..." />
                        @if (provSearchOpen && (!string.IsNullOrWhiteSpace(provSearch) || uso.Count > 0))
                        {
                            // 19/11/2026: sin escribir nada se ven los ⭐ frecuentes; al escribir, frecuentes primero.
                            var matches = string.IsNullOrWhiteSpace(provSearch)
                                ? (proveedores ?? new()).Where(p => p.IsActive && EsFrecuente(p)).OrderBy(p => p.Nombre).Take(40).ToList()
                                : ProveedoresMatching(provSearch).Take(25).ToList();
                            var hayFrec = matches.Any(EsFrecuente);
                            <div style="background:white; border:1px solid #d1d5db; border-radius:6px; max-height:280px; overflow-y:auto; z-index:100; box-shadow:0 4px 14px rgba(0,0,0,0.12); margin-top:0.2rem;">
                                @if (matches.Count == 0)
                                {
                                    <div style="padding:0.6rem; color:#6b7280; font-size:0.85rem;">Sin resultados.</div>
                                }
                                else
                                {
                                    var titulo = "";
                                    @foreach (var p in matches)
                                    {
                                        var pId = p.Id;
                                        var t = !hayFrec ? "" : EsFrecuente(p) ? "⭐ Frecuentes" : "Todos";
                                        if (t != titulo)
                                        {
                                            titulo = t;
                                            <div style="padding:0.3rem 0.6rem 0.15rem; font-size:0.68rem; color:#6b7280; text-transform:uppercase; letter-spacing:0.04em; background:#f9fafb;">@t</div>
                                        }
                                        <div @onclick="() => SelectProveedor(pId)" style="padding:0.4rem 0.6rem; cursor:pointer; border-bottom:1px solid #f3f4f6; font-size:0.85rem; display:flex; justify-content:space-between; gap:0.5rem;">
                                            <span>
                                                <strong>@p.Nombre</strong>
                                                @if (!string.IsNullOrEmpty(p.Cuit)) { <span style="color:#6b7280; font-size:0.78rem;"> · @p.Cuit</span> }
                                            </span>
                                            <span style="color:#9ca3af; font-size:0.72rem; white-space:nowrap;">@UsoTexto(p)</span>
                                        </div>
                                    }
                                }
                            </div>
                        }
                    }
                </div>

                @if (selProveedorId > 0)
                {
                    @* --- Comprobantes a pagar --- *@
                    <div style="margin: 1rem 0; padding: 0.8rem; background: #f9fafb; border-radius: 8px;">
                        <div style="display:flex; justify-content:space-between; align-items:center; margin-bottom:0.5rem;">
                            <h5 style="margin:0;">Qué se paga</h5>
                            @if (pendientes is not null && pendientes.Count > 0)
                            {
                                <button class="btn btn-secondary" style="font-size:0.78rem;" @onclick="PagarTodo">⚡ Pagar todo lo pendiente</button>
                            }
                        </div>
                        @* 17/09/2026: lo pendiente sale de la CUENTA CORRIENTE del proveedor (facturas de AFIP +
                           cotizaciones), no de las compras de stock. *@
                        @if (ctaProveedor is not null && ctaProveedor.CuentaCorriente)
                        {
                            <div style="font-size:0.85rem; margin-bottom:0.5rem;">
                                Le debés <b style="color:@(ctaProveedor.Total > 0.01m ? "#b91c1c" : "inherit");">$@ctaProveedor.Total.ToString("N2")</b>
                                <span style="color:#6b7280;"> · oficial $@ctaProveedor.Oficial.ToString("N2") · no oficial $@ctaProveedor.NoOficial.ToString("N2")@(ctaProveedor.ACuenta > 0.01m ? $" · a cuenta −${ctaProveedor.ACuenta:N2}" : "")</span>
                            </div>
                        }
                        @if (pendientes is null)
                        {
                            <p class="text-muted">Cargando...</p>
                        }
                        else if (ctaProveedor is not null && !ctaProveedor.CuentaCorriente && pendientes.Count == 0)
                        {
                            <p class="text-muted" style="margin:0 0 0.5rem;">
                                No tiene facturas de ARCA sin pagar en los últimos 6 meses: el pago queda "A cuenta".
                                <a href="/cafe/proveedores/@selProveedorId/estado-cuenta">Prenderle la cuenta corriente</a>
                            </p>
                        }
                        else if (pendientes.Count == 0)
                        {
                            <p class="text-muted" style="margin:0;">No tiene nada pendiente. Podés cargar como "A cuenta".</p>
                        }
                        else
                        {
                            @if (ctaProveedor is not null && !ctaProveedor.CuentaCorriente)
                            {
                                <p class="text-muted" style="margin:0 0 0.4rem; font-size:0.8rem;">Sus facturas de ARCA de los últimos 6 meses que no figuran pagadas (no lleva cuenta corriente).</p>
                            }
                            <table class="table table-compact" style="margin-bottom:0.5rem;">
                                <thead><tr><th></th><th>Comprobante</th><th></th><th>Fecha</th><th style="text-align:right;">Debe</th><th style="text-align:right;">A pagar</th></tr></thead>
                                <tbody>
                                    @foreach (var p in pendientes)
                                    {
                                        var clave = p.Clave;
                                        <tr>
                                            <td><input type="checkbox" @bind="imputaciones[clave].Seleccionado" @bind:after="RecalcularTotal" /></td>
                                            <td><b>@p.Etiqueta</b></td>
                                            <td style="font-size:0.78rem; color:#6b7280;">@(p.Oficial ? "oficial" : "no oficial")</td>
                                            <td>@p.Fecha.ToString("dd/MM/yyyy")</td>
                                            <td style="text-align:right;">$@p.Saldo.ToString("N2")</td>
                                            <td style="text-align:right;">
                                                @* 2026-08-18: idem Cobranzas — texto con punto de miles (antes quedaba vacio) *@
                                                <input class="form-input" type="text" inputmode="decimal" data-monto style="text-align:right; width:120px; display:inline-block;"
                                                       @bind="imputaciones[clave].ImporteTexto" @bind:event="onchange" @bind:after="@(() => OnImputeAfter(clave))" />
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        }
                        <div style="display:flex; align-items:center; gap:0.5rem;">
                            <label class="form-check"><input type="checkbox" @bind="aCuentaActivo" @bind:after="RecalcularTotal" /> A cuenta:</label>
                            @* 2026-08-28: idem Cobranzas — type=number vaciaba el casillero. *@
                            <input class="form-input" type="text" inputmode="decimal" data-monto style="width:140px;"
                                   @bind="ACuentaImporteTexto" @bind:event="onchange" @bind:after="RecalcularTotal" disabled="@(!aCuentaActivo)" />
                        </div>
                        <div style="margin-top:0.5rem; text-align:right; font-weight:700;">
                            Total imputado: $@TotalImputado.ToString("N2")
                        </div>
                    </div>

                    @* --- Formas de pago --- *@
                    <div style="margin: 1rem 0; padding: 0.8rem; background: #fef3c7; border-radius: 8px;">
                        <h5 style="margin:0 0 0.5rem;">Forma de pago</h5>
                        @* 20/10/2026: e-cheq que le firmamos a este proveedor (los baja el banco) y que todavía
                           no se usaron en ningún pago. Con "Usar" pasan a ser una forma de pago. *@
                        @if (echeqsPropios.Count > 0)
                        {
                            <div style="background:white; border-radius:6px; padding:0.6rem; margin-bottom:0.6rem; font-size:0.85rem;">
                                <div style="display:flex; justify-content:space-between; align-items:center; margin-bottom:0.3rem;">
                                    <span style="color:#6b7280;">E-cheq que le firmaste y todavía no aplicaste:</span>
                                    @if (echeqsPropios.Count(e => !EcheqUsado(e.Id)) > 1)
                                    {
                                        <button class="btn btn-secondary" style="font-size:0.75rem;" @onclick="UsarTodosEcheqs">Usar todos</button>
                                    }
                                </div>
                                @foreach (var e in echeqsPropios)
                                {
                                    var ev = e;
                                    <div style="display:flex; justify-content:space-between; align-items:center; padding:0.2rem 0;">
                                        <span>N° @ev.Numero · vence @(ev.FechaPago?.ToString("dd/MM/yyyy") ?? "—") · <b>$@ev.Importe.ToString("N2")</b></span>
                                        @if (EcheqUsado(ev.Id))
                                        {
                                            <span style="color:#6b7280;">✓ en este pago</span>
                                        }
                                        else
                                        {
                                            <button class="btn btn-secondary" style="font-size:0.75rem;" @onclick="() => UsarEcheq(ev)">Usar</button>
                                        }
                                    </div>
                                }
                            </div>
                        }
                        @for (int i = 0; i < formMedios.Count; i++)
                        {
                            var idx = i; var m = formMedios[idx];
                            <div style="display:grid; grid-template-columns: 2fr 1fr 2fr 30px; gap:0.4rem; margin-bottom:0.4rem; align-items:start;">
                                <select class="form-input" style="@(m.CajaId <= 0 ? "border-color:#dc2626;" : "")" value="@m.CajaId" @onchange="@(e => OnCajaChange(idx, e.Value?.ToString()))" disabled="@(m.ChequeBancoId.HasValue)">
                                    <option value="0">— Caja —</option>
                                    @if (cajas is not null)
                                    {
                                        @foreach (var c in cajas.Where(x => x.IsActive && !x.EnDolares))
                                        {
                                            <option value="@c.Id">@c.Nombre</option>
                                        }
                                    }
                                </select>
                                @* 2026-08-28: idem Cobranzas — type=number vaciaba el casillero. *@
                                <input class="form-input" type="text" inputmode="decimal" data-monto placeholder="Importe"
                                       @bind="m.ImporteTexto" @bind:event="onchange" @bind:after="RecalcularTotal" disabled="@(m.ChequeExistenteId.HasValue || m.ChequeBancoId.HasValue)" />
                                <input class="form-input" placeholder="Referencia" @bind="m.Referencia" />
                                <button class="btn-icon" @onclick="() => { formMedios.RemoveAt(idx); RecalcularTotal(); }">🗑</button>
                            </div>
                            @if (m.ChequeBancoId.HasValue)
                            {
                                <div style="margin:-0.2rem 0 0.5rem 0.2rem; font-size:0.78rem; color:#6b7280;">
                                    La factura queda paga hoy. Del banco sale cuando lo debiten.
                                </div>
                            }
                            @if (m.TipoCaja == "CHEQUES_CARTERA")
                            {
                                <div style="margin-left:1rem; padding:0.6rem; background:white; border-radius:6px; margin-bottom:0.5rem;">
                                    <div style="font-size:0.78rem; color:#6b7280; margin-bottom:0.3rem;">Elegí un cheque de cartera para endosar:</div>
                                    <select class="form-input" value="@m.ChequeExistenteId" @onchange="@(e => OnChequeEndosoChange(idx, e.Value?.ToString()))">
                                        <option value="">— Elegir cheque para endosar —</option>
                                        @if (chequesEnCartera is not null)
                                        {
                                            @foreach (var ch in chequesEnCartera)
                                            {
                                                <option value="@ch.Id">@ch.Banco · N° @ch.Numero · $@ch.Importe.ToString("N2") @(ch.FechaVencimiento.HasValue ? $"· Vto {ch.FechaVencimiento.Value:dd/MM}" : "")</option>
                                            }
                                        }
                                    </select>
                                </div>
                            }
                        }
                        <button class="btn btn-secondary" style="font-size:0.8rem;" @onclick="AgregarMedio">+ Agregar forma de pago</button>
                    </div>

                    @* --- Retenciones --- *@
                    <div class="form-group">
                        <label class="form-label">Retenciones (si te aplicaron alguna)</label>
                        <input class="form-input" type="text" inputmode="decimal" data-monto @bind="FormRetencionesTexto" @bind:event="onchange" @bind:after="RecalcularTotal" />
                    </div>

                    @* --- Observaciones --- *@
                    <div class="form-group">
                        <label class="form-label">Observaciones</label>
                        <input class="form-input" @bind="formObservaciones" />
                    </div>

                    @* --- Resumen --- *@
                    <div style="padding:0.6rem; background:#dbeafe; border-radius:6px;">
                        <div style="display:flex; justify-content:space-between;"><span>Total medios de pago:</span><b>$@TotalMedios.ToString("N2")</b></div>
                        <div style="display:flex; justify-content:space-between;"><span>+ Retenciones:</span><b>$@formRetenciones.ToString("N2")</b></div>
                        <div style="display:flex; justify-content:space-between;"><span>= Debe igualar el imputado:</span><b style="color:@(CuadraTotal ? "#059669" : "#dc2626");">$@TotalImputado.ToString("N2")</b></div>
                        @* 01/10/2026: mismo cartel grande de diferencia que Cobranzas (antes solo decia "tienen que sumar" sin decir cuanto) *@
                        @if (!CuadraTotal)
                        {
                            var dif = TotalImputado - (TotalMedios + formRetenciones);
                            var falta = dif > 0;
                            <div style="margin-top:0.6rem; padding:0.7rem 0.9rem; border-radius:8px;
                                        background:@(falta ? "#fee2e2" : "#fef3c7");
                                        border:2px solid @(falta ? "#dc2626" : "#d97706");
                                        display:flex; justify-content:space-between; align-items:center;">
                                <div style="font-weight:700; color:@(falta ? "#991b1b" : "#92400e"); font-size:0.95rem;">
                                    @if (falta)
                                    {
                                        <span>⚠ Falta pagar:</span>
                                    }
                                    else
                                    {
                                        <span>⚠ Sobra (pagás de más):</span>
                                    }
                                </div>
                                <div style="font-weight:800; font-size:1.35rem; color:@(falta ? "#dc2626" : "#d97706"); font-family:monospace;">
                                    $@Math.Abs(dif).ToString("N2")
                                </div>
                            </div>
                            <div style="color:#6b7280; font-size:0.78rem; margin-top:0.4rem; line-height:1.35;">
                                @if (falta)
                                {
                                    <span>💡 Agregá una forma de pago por <b>$@Math.Abs(dif).ToString("N2")</b>, o bajá el importe a pagar a ese mismo valor.</span>
                                }
                                else
                                {
                                    <span>💡 Subí lo que pagás de los comprobantes (o "A cuenta") por <b>$@Math.Abs(dif).ToString("N2")</b>, o bajá las formas de pago.</span>
                                }
                            </div>
                        }
                    </div>
                }
                }
            </div>
            <div class="modal-footer">
                <button class="btn btn-secondary" @onclick="CloseNuevo" disabled="@guardando">@(aQuien == "empleado" ? "Cerrar" : "Cancelar")</button>
                @if (aQuien != "empleado")
                {
                <button class="btn btn-primary" @onclick="GuardarPago" disabled="@(!CuadraTotal || TotalImputado <= 0 || guardando)">
                    @(guardando ? "..." : "Guardar pago")
                </button>
                }
            </div>
        </div>
    </div>
}

@code {
    private List<PagoListDto>? pagos;
    private bool loading = true;
    private List<CafeProveedorDto>? proveedores;
    private List<CafeCajaDto>? cajas;
    private List<CafeChequeDto>? chequesEnCartera;
    private List<ApiClient.EcheqPropioDto> echeqsPropios = new();

    private bool showNuevo, guardando;
    private int selProveedorId;
    private string provSearch = ""; private bool provSearchOpen;
    private List<CtaCteDocDto>? pendientes;
    private PendientesProveedorDto? ctaProveedor;
    private Dictionary<string, ImputData> imputaciones = new();
    private bool aCuentaActivo; private decimal aCuentaImporte;
    private decimal formRetenciones;
    /// <summary>2026-08-18: version texto de los importes que se tipean (con punto de miles).</summary>
    private string FormRetencionesTexto
    {
        get => MontoInput.Formato(formRetenciones);
        set { MontoInput.TryParse(value, out formRetenciones); }
    }
    private string ACuentaImporteTexto
    {
        get => MontoInput.Formato(aCuentaImporte);
        set { MontoInput.TryParse(value, out aCuentaImporte); }
    }
    private string? formObservaciones;
    private List<MedioForm> formMedios = new();

    [Parameter, SupplyParameterFromQuery(Name = "proveedor")] public int? PreProveedorId { get; set; }
    /// <summary>19/11/2026: "💸 Pagar" de Facturas recibidas: la factura de ARCA (IdComprobante) queda tildada,
    /// con su saldo y una forma de pago por ese importe para elegir de dónde sale.</summary>
    [Parameter, SupplyParameterFromQuery(Name = "factura")] public string? PreFactura { get; set; }
    /// <summary>19/11/2026: ⭐ frecuentes primero al buscar proveedor.</summary>
    private Dictionary<int, ApiClient.ProveedorUsoDto> uso = new();
    /// <summary>17/11/2026: "Pagar" de un pago PROGRAMADO (¿A quién le debo?): abre el pago ya completo y, al
    /// guardarlo, el programado queda pagado.</summary>
    [Parameter, SupplyParameterFromQuery(Name = "programado")] public int? PreProgramadoId { get; set; }
    private ApiClient.PagoProgramadoDto? programado;
    /// <summary>18/11/2026: "Cargar" de un #gasto por WhatsApp: abre el pago con el mensaje arriba y, al
    /// guardarlo, el gasto queda APLICADO (con tilde).</summary>
    [Parameter, SupplyParameterFromQuery(Name = "gasto")] public int? PreGastoId { get; set; }
    private ApiClient.GastoWaDto? gastoWa;
    /// <summary>17/09/2026: botón "Pago" de la barra (y N+P): abre el formulario vacío. Trae una marca de
    /// tiempo para que vuelva a abrirse aunque ya se esté en esta pantalla.</summary>
    [Parameter, SupplyParameterFromQuery(Name = "nueva")] public long? PreNueva { get; set; }
    private long? nuevaAtendida;

    private class ImputData
    {
        public bool Seleccionado { get; set; }
        public decimal Importe { get; set; }
        /// <summary>2026-08-18: lo que se ve y se tipea en el casillero. Con @bind sobre esta
        /// propiedad, al salir del campo Blazor reescribe el texto ya formateado ("61.710,00").
        /// Con value+onchange NO lo hace: queda lo que tipeo el usuario (medido con Playwright).</summary>
        public string ImporteTexto
        {
            get => MontoInput.Formato(Importe);
            set { MontoInput.TryParse(value, out var v); Importe = v; }
        }
    }
    private class MedioForm
    {
        public int CajaId { get; set; }
        public string TipoCaja { get; set; } = "";
        public decimal Importe { get; set; }
        /// <summary>26/11/2026: el importe lo puso el sistema (lo que falta cubrir) y se sigue
        /// acomodando solo cuando se tildan facturas. Apenas el usuario lo escribe, queda fijo.</summary>
        public bool ImporteAuto { get; set; }
        /// <summary>2026-08-18: importe como texto con puntos de miles (ver MontoInput).</summary>
        public string ImporteTexto
        {
            get => MontoInput.Formato(Importe);
            set { MontoInput.TryParse(value, out var v); Importe = v; ImporteAuto = false; }
        }
        public string? Referencia { get; set; }
        public int? ChequeExistenteId { get; set; }
        public int? ChequeBancoId { get; set; }
    }

    private decimal TotalImputado => imputaciones.Where(kv => kv.Value.Seleccionado).Sum(kv => kv.Value.Importe) + (aCuentaActivo ? aCuentaImporte : 0);
    private decimal TotalMedios => formMedios.Sum(m => m.Importe);
    private bool CuadraTotal => Math.Abs(TotalImputado - (TotalMedios + formRetenciones)) < 0.01m;

    private string aQuien = "proveedor";
    private bool puedeEmpleados;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            var u = await AuthSvc.GetUserAsync();
            puedeEmpleados = u is not null && (string.Equals(u.Role, "admin", StringComparison.OrdinalIgnoreCase) || (u.Permissions?.Contains("nominas") ?? false));
        }
        catch { puedeEmpleados = false; }
        proveedores = await Api.GetCafeProveedoresAsync() ?? new();
        try { uso = (await Api.GetProveedoresUsoAsync()).ToDictionary(u => u.Id); } catch { }
        cajas = await Api.GetCafeCajasAsync() ?? new();
        chequesEnCartera = (await Api.GetCafeChequesAsync("EN_CARTERA")) ?? new();
        await Load();
        if (PreGastoId is > 0)
        {
            gastoAtendido = PreGastoId;
            await AbrirDesdeGasto(PreGastoId.Value);
        }
        else if (PreProgramadoId is > 0)
        {
            await AbrirDesdeProgramado(PreProgramadoId.Value);
        }
        else if (PreProveedorId.HasValue && PreProveedorId.Value > 0)
        {
            ShowNuevo();
            await SelectProveedor(PreProveedorId.Value);
            if (!string.IsNullOrWhiteSpace(PreFactura)) TildarFactura(PreFactura);
        }
    }

    private void TildarFactura(string idAfip)
    {
        if (!imputaciones.TryGetValue("AFIP:" + idAfip, out var imp))
        {
            ToastService.Error("Esa factura ya figura pagada (o no es de este proveedor)");
            return;
        }
        imp.Seleccionado = true;
        // De dónde sale la plata: se elige (Galicia, efectivo, MP, cheque…). El importe ya va puesto.
        if (formMedios.Count == 0) formMedios.Add(new MedioForm { CajaId = 0, Importe = imp.Importe });
        RecalcularTotal();
    }

    private int? gastoAtendido;
    protected override async Task OnParametersSetAsync()
    {
        // 18/11/2026: tocar otro #gasto (campanita / tarjeta) estando ya en esta pantalla.
        if (PreGastoId is > 0 && PreGastoId != gastoAtendido && cajas is not null)
        {
            gastoAtendido = PreGastoId;
            await AbrirDesdeGasto(PreGastoId.Value);
        }
        OnParametersSetNueva();
    }

    private void OnParametersSetNueva()
    {
        if (PreNueva is > 0 && PreNueva != nuevaAtendida)
        {
            nuevaAtendida = PreNueva;
            if (!showNuevo) ShowNuevo();
        }
    }

    private async Task Load()
    {
        loading = true;
        try { pagos = await Api.GetCafePagosProveedorAsync() ?? new(); }
        catch { ToastService.Error("Error al cargar"); pagos = new(); }
        loading = false;
    }

    /// <summary>17/11/2026: completa el Nuevo pago con lo programado: proveedor, comprobantes tildados (hasta
    /// cubrir el importe; lo que sobra va "a cuenta"), una forma de pago según cómo se iba a pagar y la nota.</summary>
    private async Task AbrirDesdeProgramado(int id)
    {
        ApiClient.PagoProgramadoDto? p = null;
        try { p = await Api.GetPagoProgramadoAsync(id); } catch { }
        if (p is null) { ToastService.Error("No encontré ese pago programado"); return; }
        if (p.Estado != "PENDIENTE") { ToastService.Error("Ese pago programado ya no está pendiente"); return; }
        ShowNuevo();
        programado = p;
        await SelectProveedor(p.ProveedorId);
        var resta = p.Importe;
        foreach (var clave in p.Claves)
        {
            if (resta <= 0) break;
            if (!imputaciones.TryGetValue(clave, out var imp)) continue;   // ya se pagó por otro lado
            imp.Seleccionado = true;
            imp.Importe = Math.Min(imp.Importe, resta);
            resta -= imp.Importe;
        }
        if (resta > 0.009m) { aCuentaActivo = true; aCuentaImporte = resta; }
        // Forma de pago: transferencia → banco (Galicia primero), efectivo → caja de efectivo.
        // E-cheq: se deja para elegir el e-cheq de la lista (o el banco a mano).
        CafeCajaDto? caja = p.Medio switch
        {
            "TRANSFERENCIA" => cajas?.Where(c => c.IsActive && c.Tipo == "BANCO" && !c.EnDolares)
                .OrderByDescending(c => c.Nombre.Contains("Galicia")).ThenBy(c => c.Id).FirstOrDefault(),
            "EFECTIVO" => cajas?.Where(c => c.IsActive && c.Tipo == "EFECTIVO" && !c.EnDolares).OrderBy(c => c.Id).FirstOrDefault(),
            _ => null,
        };
        if (caja is not null)
            formMedios.Add(new MedioForm { CajaId = caja.Id, TipoCaja = caja.Tipo, Importe = p.Importe });
        formObservaciones = p.Nota;
    }

    private async Task AbrirDesdeGasto(int id)
    {
        ApiClient.GastoWaDto? g = null;
        try { g = await Api.GetGastoWaAsync(id); } catch { }
        if (g is null) { ToastService.Error("No encontré ese gasto"); return; }
        if (g.Estado != "PENDIENTE") { ToastService.Error(g.Estado == "APLICADO" ? $"Ese gasto ya está cargado (pago {g.PagoNumero})" : "Ese gasto está ignorado (volvelo a pendiente desde Gastos por WhatsApp)"); return; }
        ShowNuevo();
        gastoWa = g;
        formObservaciones = g.Texto.Length > 400 ? g.Texto[..400] : g.Texto;
        if (g.Importe is decimal imp && imp > 0)
        {
            // Sin factura que imputar: va "a cuenta" del proveedor que elijas (se puede cambiar).
            aCuentaActivo = true; aCuentaImporte = imp;
            CafeCajaDto? caja = g.Medio switch
            {
                "TRANSFERENCIA" => cajas?.Where(c => c.IsActive && c.Tipo == "BANCO" && !c.EnDolares)
                    .OrderByDescending(c => c.Nombre.Contains("Galicia")).ThenBy(c => c.Id).FirstOrDefault(),
                "EFECTIVO" => cajas?.Where(c => c.IsActive && c.Tipo == "EFECTIVO" && !c.EnDolares).OrderBy(c => c.Id).FirstOrDefault(),
                "MERCADOPAGO" => cajas?.Where(c => c.IsActive && !c.EnDolares && c.Nombre.Contains("Mercado", StringComparison.OrdinalIgnoreCase)).OrderBy(c => c.Id).FirstOrDefault(),
                _ => null,
            };
            formMedios.Add(new MedioForm { CajaId = caja?.Id ?? 0, TipoCaja = caja?.Tipo ?? "", Importe = imp });
        }
    }

    private void ShowNuevo()
    {
        programado = null;
        gastoWa = null;
        selProveedorId = 0; provSearch = ""; provSearchOpen = false;
        pendientes = null; imputaciones = new(); echeqsPropios = new();
        aCuentaActivo = false; aCuentaImporte = 0;
        formMedios = new(); formRetenciones = 0; formObservaciones = null;
        aQuien = "proveedor";
        showNuevo = true;
    }

    private void CloseNuevo() { if (guardando) return; showNuevo = false; }

    private IEnumerable<CafeProveedorDto> ProveedoresMatching(string q)
    {
        if (proveedores is null) return Enumerable.Empty<CafeProveedorDto>();
        var t = q.Trim();
        if (string.IsNullOrEmpty(t)) return proveedores;
        bool h(string? s) => !string.IsNullOrEmpty(s) && s.Contains(t, StringComparison.OrdinalIgnoreCase);
        return proveedores.Where(p => p.IsActive && (h(p.Nombre) || h(p.Cuit) || h(p.Contacto) || h(p.Telefono) || h(p.Email)))
            .OrderByDescending(EsFrecuente).ThenBy(p => p.Nombre);
    }
    /// <summary>Al salir del buscador se cierra la lista (con una pausa para que el clic en un renglón llegue).</summary>
    private async Task CerrarBusquedaLuego()
    {
        await Task.Delay(200);
        if (selProveedorId == 0 && string.IsNullOrWhiteSpace(provSearch)) { provSearchOpen = false; StateHasChanged(); }
    }
    private bool EsFrecuente(CafeProveedorDto p) => uso.TryGetValue(p.Id, out var u) && u.Frecuente;
    private string UsoTexto(CafeProveedorDto p)
    {
        if (!uso.TryGetValue(p.Id, out var u)) return "";
        var partes = new List<string>();
        if (u.Facturas90 > 0) partes.Add(u.Facturas90 == 1 ? "1 factura en 3 meses" : $"{u.Facturas90} facturas en 3 meses");
        if (u.Ultima is DateTime d) partes.Add("último " + d.ToString("dd/MM/yy"));
        else if (u.SinMovimiento) partes.Add("sin movimiento en el año");
        return string.Join(" · ", partes);
    }

    private async Task SelectProveedor(int id)
    {
        selProveedorId = id;
        provSearch = ""; provSearchOpen = false;
        imputaciones = new(); ctaProveedor = null; pendientes = null; echeqsPropios = new();
        formMedios.RemoveAll(m => m.ChequeBancoId.HasValue);
        try { echeqsPropios = await Api.GetEcheqsPropiosAsync(id); } catch { }
        try
        {
            ctaProveedor = await Api.GetPendientesProveedorAsync(id);
            pendientes = ctaProveedor?.Documentos ?? new();
            foreach (var p in pendientes)
                imputaciones[p.Clave] = new ImputData { Seleccionado = false, Importe = p.Saldo };
        }
        catch { ToastService.Error("Error al traer pendientes"); pendientes = new(); }
    }

    private void ClearProveedor()
    {
        selProveedorId = 0; provSearch = ""; provSearchOpen = false;
        pendientes = null; ctaProveedor = null; imputaciones = new(); echeqsPropios = new();
        formMedios.RemoveAll(m => m.ChequeBancoId.HasValue);
    }

    /// <summary>2026-08-18: corre despues de que @bind ya guardo el importe tipeado (ImporteTexto).</summary>
    private void OnImputeAfter(string clave)
    {
        if (imputaciones.TryGetValue(clave, out var imp))
        {
            if (imp.Importe > 0) imp.Seleccionado = true;
            RecalcularTotal();
        }
    }

    private void OnCajaChange(int idx, string? value)
    {
        if (int.TryParse(value, out var cajaId))
        {
            formMedios[idx].CajaId = cajaId;
            formMedios[idx].TipoCaja = cajas?.FirstOrDefault(c => c.Id == cajaId)?.Tipo ?? "";
            if (formMedios[idx].TipoCaja != "CHEQUES_CARTERA")
                formMedios[idx].ChequeExistenteId = null;
            // 26/11/2026: al elegir la forma de pago, el importe aparece solo con lo que falta
            // cubrir de lo tildado arriba. Un cheque de cartera trae su propio importe.
            var med = formMedios[idx];
            if (med.TipoCaja == "CHEQUES_CARTERA" || med.ChequeBancoId.HasValue) med.ImporteAuto = false;
            else if (cajaId > 0 && (med.Importe <= 0m || med.ImporteAuto))
            {
                foreach (var otro in formMedios) otro.ImporteAuto = false;
                med.ImporteAuto = true;
            }
        }
        RecalcularTotal();
    }

    private void OnChequeEndosoChange(int idx, string? value)
    {
        if (int.TryParse(value, out var chId))
        {
            formMedios[idx].ChequeExistenteId = chId;
            // Auto-completar importe con el del cheque
            var ch = chequesEnCartera?.FirstOrDefault(x => x.Id == chId);
            if (ch is not null) { formMedios[idx].Importe = ch.Importe; formMedios[idx].ImporteAuto = false; }
            RecalcularTotal();
        }
        else
        {
            formMedios[idx].ChequeExistenteId = null;
        }
    }

    private void AgregarMedio() => formMedios.Add(new MedioForm());

    private bool EcheqUsado(int id) => formMedios.Any(m => m.ChequeBancoId == id);

    /// <summary>20/10/2026: el e-cheq propio sale del banco (la caja BANCO, Galicia primero).</summary>
    private void UsarEcheq(ApiClient.EcheqPropioDto e)
    {
        if (EcheqUsado(e.Id)) return;
        var banco = cajas?.Where(c => c.IsActive && c.Tipo == "BANCO")
            .OrderByDescending(c => c.Nombre.Contains("Galicia")).ThenBy(c => c.Id).FirstOrDefault();
        if (banco is null) { ToastService.Error("No encontré la caja del banco en Tesorería"); return; }
        // Si había un renglón vacío (el que se agrega a mano), lo reemplaza.
        formMedios.RemoveAll(m => m.CajaId == 0 && m.Importe == 0 && !m.ChequeExistenteId.HasValue);
        formMedios.Add(new MedioForm
        {
            CajaId = banco.Id, TipoCaja = banco.Tipo, Importe = e.Importe, ChequeBancoId = e.Id,
            Referencia = $"E-cheq propio N° {e.Numero}" + (e.FechaPago.HasValue ? $" · vence {e.FechaPago.Value:dd/MM/yyyy}" : "")
        });
        RecalcularTotal();
    }

    private void UsarTodosEcheqs()
    {
        foreach (var e in echeqsPropios) UsarEcheq(e);
    }

    private void PagarTodo()
    {
        if (pendientes is null) return;
        foreach (var p in pendientes)
        {
            if (imputaciones.TryGetValue(p.Clave, out var imp))
            {
                imp.Seleccionado = true;
                imp.Importe = p.Saldo;
            }
        }
        RecalcularTotal();
    }

    private void RecalcularTotal()
    {
        // 26/11/2026: la forma de pago que se cargó sola sigue lo que falta cubrir.
        var auto = formMedios.FirstOrDefault(x => x.ImporteAuto && x.CajaId > 0);
        if (auto is not null)
        {
            var resto = TotalImputado - formRetenciones - formMedios.Where(x => x != auto).Sum(x => x.Importe);
            auto.Importe = Math.Max(0m, Math.Round(resto, 2));
        }
        StateHasChanged();
    }

    private async Task GuardarPago()
    {
        if (selProveedorId <= 0) { ToastService.Error("Elegí un proveedor"); return; }
        if (!CuadraTotal) { ToastService.Error("No cuadra"); return; }
        if (formMedios.Any(m => m.CajaId <= 0)) { ToastService.Error("Elegí la caja en la forma de pago (de dónde sale la plata)"); return; }

        var comps = new List<ApiClient.CrearCompraItemRequest>();
        foreach (var kv in imputaciones)
            if (kv.Value.Seleccionado && kv.Value.Importe > 0)
                comps.Add(new ApiClient.CrearCompraItemRequest(null, kv.Value.Importe, kv.Key));
        if (aCuentaActivo && aCuentaImporte > 0)
            comps.Add(new ApiClient.CrearCompraItemRequest(null, aCuentaImporte));

        var medios = formMedios.Select(m => new ApiClient.CrearMedioPagoRequest(
            m.CajaId, m.Importe, m.Referencia, m.ChequeExistenteId, m.ChequeBancoId)).ToList();

        guardando = true;
        try
        {
            var r = await Api.CrearCafePagoProveedorAsync(selProveedorId, formRetenciones, null, formObservaciones, comps, medios);
            if (r is null) { ToastService.Error("No se pudo guardar"); return; }
            ToastService.Success($"Pago {r.Numero} creado");
            if (gastoWa is not null)
            {
                if (await Api.AplicarGastoWaAsync(gastoWa.Id, r.Id)) ToastService.Success("✅ Gasto de WhatsApp aplicado");
                else ToastService.Error("El pago quedó guardado, pero el gasto sigue pendiente: avisame");
                gastoWa = null;
            }
            if (programado is not null)
            {
                try { await Api.MarcarPagoProgramadoPagadoAsync(programado.Id, r.Id); }
                catch { ToastService.Error("El pago quedó guardado, pero el programado sigue en la lista: sacalo con ✕"); }
                programado = null;
            }
            showNuevo = false;
            chequesEnCartera = (await Api.GetCafeChequesAsync("EN_CARTERA")) ?? new(); // refrescar (cheques endosados ya no aparecen)
            await Load();
        }
        catch (Exception ex) { ToastService.Error(ex.Message); }
        finally { guardando = false; }
    }

    private async Task AnularPago(PagoListDto p)
    {
        if (!await JS.InvokeAsync<bool>("confirm", $"¿Anular el pago {p.Numero}? Si endoso un cheque, vuelve a cartera."))
            return;
        try { await Api.AnularCafePagoProveedorAsync(p.Id); ToastService.Success("Pago anulado"); await Load(); }
        catch (Exception ex) { ToastService.Error(ex.Message); }
    }
