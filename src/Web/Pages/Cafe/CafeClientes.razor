    private async Task GuardarDireccion()
    {
        if (!editingId.HasValue) return;
        if (string.IsNullOrWhiteSpace(dirDireccion)) { dirError = "La dirección es obligatoria."; return; }
        dirGuardando = true; dirError = null;
        try
        {
            var req = new CafeDireccionUpsertRequest
            {
                Etiqueta = dirEtiqueta, Direccion = dirDireccion.Trim(), EntreCalles = dirEntreCalles,
                NotasInternas = dirNotasInternas, Localidad = dirLocalidad,
                Cp = dirCp, Telefono = dirTelefono, MapeoLink = dirMapeoLink,
                EsPrincipal = false  // el principal es siempre el "domicilio de siempre"; los alternativos nunca son principales
            };
            if (dirEditandoId.HasValue)
            {
                var upd = await Api.UpdateCafeDireccionAsync(dirEditandoId.Value, req);
                if (upd is null) { dirError = "No se pudo guardar."; return; }
            }
            else
            {
                var cre = await Api.CreateCafeDireccionAsync(editingId.Value, req);
                if (cre is null) { dirError = "No se pudo agregar."; return; }
            }
            await LoadDirecciones(editingId.Value);
            CerrarModalDireccion();
        }
        catch (Exception ex) { dirError = "Error: " + ex.Message; }
        finally { dirGuardando = false; }
    }

