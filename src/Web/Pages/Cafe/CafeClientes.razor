    {
        if (!editingId.HasValue) return;
        dirGuardando = true;
        try
        {
            await Api.DeleteCafeDireccionAsync(d.Id);
            await LoadDirecciones(editingId.Value);
            if (dirEditandoId == d.Id) ResetSubformDireccion();
        }
        catch (Exception ex) { dirError = "Error: " + ex.Message; }
        finally { dirGuardando = false; }
    }

