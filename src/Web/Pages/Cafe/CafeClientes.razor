                    Direccion = formDireccion, EntreCalles = formEntreCalles, DomicilioEntrega = formDomicilioEntrega,
                    Localidad = formLocalidad, Ciudad = formCiudad, Cp = formCp,
                    CondicionIvaDefault = formCondicionIvaDefault,
                    Notas = formNotas, ComentariosComprobante = formComentariosComprobante,
                    IsActive = formIsActive,
                    TieneMiniImpresora = formTieneMiniImpresora,
                    SolicitarFirmaEntrega = formSolicitarFirmaEntrega,
                    MapeoLink = string.IsNullOrEmpty(mapeoLinkClean) ? null : mapeoLinkClean,
                    ClearMapeoLink = string.IsNullOrEmpty(mapeoLinkClean),
                    MeliBuyerId = formMeliBuyerId,
                    MeliNickname = formMeliNickname,
                    ClearMeliVinculo = !formMeliBuyerId.HasValue
                });
                if (u is null) { formError = "No se pudo actualizar"; return; }
                idGuardado = u.Id;
                ToastService.Success("Cliente actualizado");
            }
            else
            {
                var mapeoLinkClean = (formMapeoLink ?? "").Trim();
                var pedidoCodigo = formCodigoInterno;
                var c = await Api.CreateCafeClienteAsync(new CreateCafeClienteRequest
                {
                    Nombre = formNombre, RazonSocial = formRazonSocial, Tipo = formTipo,
                    Cuit = formCuit, Telefono = formTelefono, Telefono2 = formTelefono2, Email = formEmail,
                    Direccion = formDireccion, EntreCalles = formEntreCalles, DomicilioEntrega = formDomicilioEntrega,
                    Localidad = formLocalidad, Ciudad = formCiudad, Cp = formCp,
                    CondicionIvaDefault = formCondicionIvaDefault,
                    Notas = formNotas, ComentariosComprobante = formComentariosComprobante,
                    MapeoLink = string.IsNullOrEmpty(mapeoLinkClean) ? null : mapeoLinkClean,
                    CodigoInterno = formCodigoInterno,
                    MeliBuyerId = formMeliBuyerId,
                    MeliNickname = formMeliNickname
                });
                if (c is null) { formError = "No se pudo crear"; return; }
                idGuardado = c.Id;
                // 2026-05-28: si crearon con "Mini impresora" tildado, hacemos un update inmediato
                // (no esta en el CreateRequest porque es un flag opcional).
                if (formTieneMiniImpresora)
                {
                    await Api.UpdateCafeClienteAsync(c.Id, new UpdateCafeClienteRequest { TieneMiniImpresora = true });
                }
                // Si el backend tuvo que reasignar (porque alguien tomó el código entre medio), avisamos.
                if (pedidoCodigo.HasValue && c.CodigoInterno.HasValue && c.CodigoInterno.Value != pedidoCodigo.Value)
                {
                    ToastService.Success($"Cliente creado. El código {pedidoCodigo} ya estaba tomado, te asignamos el {c.CodigoInterno}.");
                }
                else if (c.CodigoInterno.HasValue)
                {
                    ToastService.Success($"Cliente creado con código {c.CodigoInterno}");
                }
                else
                {
                    ToastService.Success("Cliente creado");
                }
                // Si veníamos de terminar de cargar una solicitud del enlace, la sacamos de pendientes.
                if (finalizandoAltaId.HasValue)
                {
                    try { await Api.MarcarAltaCargadaAsync(finalizandoAltaId.Value, c.Id, Operator.Current); } catch { }
                    finalizandoAltaId = null;
                    await LoadPendientes();
                }
            }
            showForm = false;
            await Load();
            // 2026-06-18: si vinimos como popup desde Nueva Venta, avisar al opener y cerrar la ventana.
            if (idGuardado.HasValue)
            {
                try
                {
                    await JS.InvokeVoidAsync("eval", $@"
                        if (window.opener && !window.opener.closed) {{
                            window.opener.postMessage({{type:'cafe-cliente-guardado', id:{idGuardado.Value}}}, '*');
                            setTimeout(function() {{ window.close(); }}, 200);
                        }}
                    ");
                }
                catch { }
            }
        }
        catch (Exception ex) { formError = ex.Message; }
        finally { saving = false; }
    }

    private void ConfirmDelete(CafeClienteDto c) { toDelete = c; showDeleteConfirm = true; }

    private async Task Delete()
    {
        if (toDelete is null) return;
        try
        {
            var r = await Api.DeleteCafeClienteAsync(toDelete.Id);
            if (r.Deleted)
            {
                ToastService.Success("Cliente eliminado");
                await Load();
            }
            else if (r.SoftDeleted)
            {
                // No se pudo borrar del todo (tiene movimientos) -> quedo Inactivo y se oculta.
                ToastService.Info(r.Message ?? "El cliente quedó marcado como Inactivo y se ocultó de la lista.");
                await Load();
            }
            else
            {
                ToastService.Error(r.Message ?? "No se pudo eliminar el cliente.");
            }
        }
        catch (Exception ex) { ToastService.Error("Error: " + ex.Message); }
        finally { showDeleteConfirm = false; toDelete = null; }
    }
}
