@page "/cafe/clientes"
@attribute [Authorize]
@using Web.Models
@inject ApiClient Api
@inject ToastService ToastService
@inject CpService CpService
@inject OperatorService Operator
@inject NavigationManager Nav
@inject IJSRuntime JS


<div class="card">
    <div class="card-header" style="display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 0.5rem;">
        <h3>👥 Clientes <span style="font-weight: 500; font-size: 0.85rem; color: #6b7280;">(@(visibles.Count) de @(clientes?.Count ?? 0))</span></h3>
        <div style="display: flex; gap: 0.4rem; align-items: center; flex-wrap: wrap;">
            <input class="form-input" style="min-width: 280px; font-size: 0.9rem;"
                   @bind="filtro" @bind:event="oninput"
                   placeholder="🔍 Buscar por código, nombre, CUIT, tel, email, dirección, localidad, CP..." />
            <label style="display: flex; align-items: center; gap: 0.3rem; font-size: 0.82rem; color: #6b7280; cursor: pointer; user-select: none;" title="Los clientes marcados como Inactivos se ocultan de la lista">
                <input type="checkbox" @bind="mostrarInactivos" style="cursor: pointer;" /> Mostrar inactivos
            </label>
            <button class="btn btn-secondary" @onclick="AbrirLinkModal" title="Enlace para que el cliente cargue sus datos solo">🔗 Enlace de alta</button>
            <button class="btn btn-primary" @onclick="ShowCreate">+ Nuevo Cliente</button>
        </div>
    </div>

    @* Franja de clientes que se cargaron solos desde el enlace público — están para terminar de cargar. *@
    @if (pendientesAltas.Count > 0)
    {
        <div style="background: #ecfdf5; border-bottom: 1px solid #a7f3d0; padding: 0.75rem 1.1rem;">
            <div style="font-weight: 700; color: #065f46; font-size: 0.92rem; margin-bottom: 0.5rem;">
                🆕 @pendientesAltas.Count cliente@(pendientesAltas.Count == 1 ? "" : "s") cargaron sus datos desde el enlace — terminá de cargarlos
            </div>
            <div style="display: flex; flex-direction: column; gap: 0.4rem;">
                @foreach (var a in pendientesAltas)
                {
                    <div style="display: flex; align-items: center; gap: 0.6rem; flex-wrap: wrap; background: white; border: 1px solid #d1fae5; border-radius: 8px; padding: 0.5rem 0.7rem;">
                        <span style="font-weight: 700; color: #111827;">🏪 @a.NombreFantasia</span>
                        @if (!string.IsNullOrWhiteSpace(a.Cuit)) { <span style="font-size: 0.82rem; color: #6b7280;">🧾 @a.Cuit</span> }
                        <span style="font-size: 0.82rem; color: #6b7280;">📞 @a.Telefono</span>
                        @if (!string.IsNullOrWhiteSpace(a.Localidad)) { <span style="font-size: 0.82rem; color: #6b7280;">📍 @a.Localidad</span> }
                        <span style="font-size: 0.72rem; color: #9ca3af;">· @a.CreatedAt.ToLocalTime().ToString("dd/MM HH:mm")</span>
                        <div style="margin-left: auto; display: flex; gap: 0.35rem;">
                            <button class="btn btn-success" style="padding: 0.35rem 0.8rem; font-size: 0.85rem;" @onclick="() => TerminarCargarAlta(a)">✅ Terminar de cargar</button>
                            <button class="btn btn-secondary" style="padding: 0.35rem 0.6rem; font-size: 0.85rem;" @onclick="() => DescartarAlta(a)" title="Descartar esta solicitud">🗑️</button>
                        </div>
                    </div>
                }
            </div>
        </div>
    }

    <div class="card-body" style="padding: 0;">
        @if (loading)
        {
            <p class="text-muted" style="padding: 1.5rem;">Cargando...</p>
        }
        else if (clientes is null || clientes.Count == 0)
        {
            <p class="text-muted" style="padding: 1.5rem;">No hay clientes cargados.</p>
        }
        else if (visibles.Count == 0)
        {
            <p class="text-muted" style="padding: 1.5rem;">
                Sin resultados para "<strong>@filtro</strong>". Probá con otra búsqueda.
            </p>
        }
        else
        {
            <div class="table-responsive">
                <table class="data-table">
                    <thead>
                        <tr>
                            <th style="width: 80px;">Código</th>
                            <th>Nombre</th>
                            <th>Tipo</th>
                            <th>CUIT/DNI</th>
                            <th>
                                <span style="display:inline-flex; align-items:center; gap:0.3rem;">
                                    Teléfono
                                    <button @onclick="() => editTelHabilitado = !editTelHabilitado"
                                            title="@(editTelHabilitado ? "Bloquear edición de teléfonos" : "Desbloquear para editar teléfonos")"
                                            style="background:@(editTelHabilitado ? "#fef3c7" : "#f3f4f6"); border:1px solid #d1d5db; border-radius:4px; padding:0.1rem 0.4rem; cursor:pointer; font-size:0.85rem;">
                                        @(editTelHabilitado ? "🔓" : "🔒")
                                    </button>
                                </span>
                            </th>
                            <th>
                                <span style="display:inline-flex; align-items:center; gap:0.3rem;">
                                    Email
                                    <button @onclick="() => editMailHabilitado = !editMailHabilitado"
                                            title="@(editMailHabilitado ? "Bloquear edición de emails" : "Desbloquear para editar emails")"
                                            style="background:@(editMailHabilitado ? "#fef3c7" : "#f3f4f6"); border:1px solid #d1d5db; border-radius:4px; padding:0.1rem 0.4rem; cursor:pointer; font-size:0.85rem;">
                                        @(editMailHabilitado ? "🔓" : "🔒")
                                    </button>
                                </span>
                            </th>
                            <th title="Domicilio de entrega del cliente (no el domicilio fiscal)">Dirección entrega</th>
                            <th style="width:130px;">
                                <span style="display:inline-flex; align-items:center; gap:0.3rem;">
                                    Maps
                                    <button @onclick="() => editMapsHabilitado = !editMapsHabilitado"
                                            title="@(editMapsHabilitado ? "Bloquear edición de Maps" : "Desbloquear para editar Maps")"
                                            style="background:@(editMapsHabilitado ? "#fef3c7" : "#f3f4f6"); border:1px solid #d1d5db; border-radius:4px; padding:0.1rem 0.4rem; cursor:pointer; font-size:0.85rem;">
                                        @(editMapsHabilitado ? "🔓" : "🔒")
                                    </button>
                                </span>
                            </th>
                            <th>Estado</th>
                            <th style="width: 130px;">Acciones</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var c in visibles.Take(maxVisibles))
                        {
                            <tr>
                                <td style="font-family: monospace; font-weight: 700; color: #1d4ed8;">
                                    @(c.Codigo ?? "—")
                                    @if (c.CodigoInterno.HasValue)
                                    {
                                        <div title="Código interno asignado por vos" style="margin-top:0.2rem; display:inline-block; padding:0.1rem 0.4rem; background:#fef3c7; color:#92400e; border:1px solid #d97706; border-radius:4px; font-size:0.72rem; font-weight:800; letter-spacing:0.3px;">
                                            #@c.CodigoInterno
                                        </div>
                                    }
                                </td>
                                <td>
                                    @{
                                        var nombreMostrar = !string.IsNullOrWhiteSpace(c.Nombre) ? c.Nombre : (c.RazonSocial ?? "—");
                                        var dirMostrar = !string.IsNullOrWhiteSpace(c.DomicilioEntrega) ? c.DomicilioEntrega : c.Direccion;
                                    }
                                    <strong>@nombreMostrar</strong>
                                    @if (c.MeliBuyerId.HasValue)
                                    {
                                        <span title="@($"Vinculado a MercadoLibre: {(string.IsNullOrWhiteSpace(c.MeliNickname) ? "ID " + c.MeliBuyerId : c.MeliNickname)}")"
                                              style="display:inline-block; margin-left:0.35rem; padding:0.05rem 0.4rem; background:#fef3c7; color:#92400e; border:1px solid #f59e0b; border-radius:999px; font-size:0.68rem; font-weight:700; vertical-align:middle;">
                                            🛒 @(string.IsNullOrWhiteSpace(c.MeliNickname) ? "ML" : c.MeliNickname)
                                        </span>
                                    }
                                    @if (!string.IsNullOrEmpty(dirMostrar))
                                    {
                                        <div style="color: #6b7280; font-size: 0.75rem; margin-top: 0.15rem;">📍 @dirMostrar</div>
                                    }
                                </td>
                                <td>
                                    @if (c.Tipo == "BAR")
                                    {
                                        <span style="display:inline-block; padding:0.15rem 0.5rem; background:#dbeafe; color:#1e40af; border-radius:999px; font-size:0.72rem; font-weight:700;">🍺 BAR</span>
                                    }
                                    else
                                    {
                                        <span style="display:inline-block; padding:0.15rem 0.5rem; background:#dcfce7; color:#166534; border-radius:999px; font-size:0.72rem; font-weight:700;">🏢 Comercial</span>
                                    }
                                </td>
                                <td style="font-family: monospace; font-size: 0.85rem;">@(c.Cuit ?? "—")</td>
                                <td>
                                    @if (editTelHabilitado)
                                    {
                                        <input class="form-input" style="padding:0.2rem 0.4rem; font-size:0.85rem; width:140px; background:#fef3c7;"
                                               value="@(c.Telefono ?? "")"
                                               @onchange="@(async e => await GuardarInlineAsync(c, "tel", e.Value?.ToString()))" />
                                    }
                                    else
                                    {
                                        @(c.Telefono ?? "—")
                                    }
                                </td>
                                <td style="font-size: 0.85rem;">
                                    @if (editMailHabilitado)
                                    {
                                        <input class="form-input" style="padding:0.2rem 0.4rem; font-size:0.85rem; width:180px; background:#fef3c7;"
                                               value="@(c.Email ?? "")"
                                               @onchange="@(async e => await GuardarInlineAsync(c, "mail", e.Value?.ToString()))" />
                                    }
                                    else
                                    {
                                        @(c.Email ?? "—")
                                    }
                                </td>
                                <td style="font-size: 0.85rem; color: #6b7280;" title="Domicilio de entrega (no el fiscal)">@(c.DomicilioEntrega ?? "—")</td>
                                <td style="text-align:center;">
                                    @if (editMapsHabilitado)
                                    {
                                        <input class="form-input" style="padding:0.2rem 0.4rem; font-size:0.78rem; width:150px; background:#fef3c7;"
                                               value="@(c.MapeoLink ?? "")"
                                               placeholder="maps.app.goo.gl/..."
                                               @onchange="@(async e => await GuardarInlineAsync(c, "maps", e.Value?.ToString()))" />
                                    }
                                    else if (!string.IsNullOrEmpty(c.MapeoLink))
                                    {
                                        <span style="display:inline-flex; gap:0.2rem; align-items:center;">
                                            <a href="@c.MapeoLink" target="_blank" title="Abrir en Google Maps"
                                               style="padding:0.2rem 0.4rem; background:#dbeafe; color:#1e40af; border:1px solid #1d4ed8; border-radius:4px; font-size:0.78rem; font-weight:700; text-decoration:none;">📍 Abrir</a>
                                            <button class="btn-icon" style="padding:0.2rem 0.4rem; background:#f3f4f6; color:#4b5563; border:1px solid #d1d5db; border-radius:4px; font-size:0.78rem; font-weight:700;"
                                                    @onclick="@(() => CopiarMaps(c.MapeoLink!))" title="Copiar link">📋</button>
                                        </span>
                                    }
                                    else
                                    {
                                        <span style="color:#9ca3af;">—</span>
                                    }
                                </td>
                                <td>
                                    <span class="status-badge @(c.IsActive ? "status-active" : "status-inactive")">@(c.IsActive ? "Activo" : "Inactivo")</span>
                                </td>
                                <td class="actions-cell">
                                    <button class="btn-icon btn-edit" @onclick="() => ShowEdit(c)" title="Editar">@SvgIcons.Edit</button>
                                    <button class="btn-icon" @onclick='() => Nav.NavigateTo($"/cafe/clientes/{c.Id}/estado-cuenta")' title="Estado de cuenta">📒</button>
                                    <button class="btn-icon" style="color:#059669;" @onclick='() => Nav.NavigateTo($"/cafe/tesoreria/cobranzas?cliente={c.Id}")' title="Cobrar a este cliente">💰</button>
                                    <button class="btn-icon btn-delete" @onclick="() => ConfirmDelete(c)" title="Eliminar">@SvgIcons.AlertCircle</button>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
                @if (visibles.Count > maxVisibles)
                {
                    <div style="padding: 0.7rem; text-align: center; background: #f9fafb; border-top: 1px solid #e5e7eb;">
                        <span style="color: #6b7280; font-size: 0.85rem; margin-right: 0.5rem;">
                            Mostrando @maxVisibles de @visibles.Count resultados
                        </span>
                        <button class="btn btn-secondary" @onclick="() => maxVisibles += 200" style="font-size: 0.85rem;">
                            Mostrar 200 más
                        </button>
                    </div>
                }
            </div>
        }
    </div>
</div>

@if (showForm)
{
    <div class="modal-overlay" @onclick="CloseForm">
        <div class="modal-card" @onclick:stopPropagation="true"
             style="max-width: min(1280px, 96vw); width: 96vw; max-height: 94vh; display: flex; flex-direction: column;">
            <div class="modal-header" style="background: whitesmoke;">
                <h3>@(isEditing ? "Editar cliente" : "Nuevo cliente")</h3>
                <button class="btn-close" @onclick="CloseForm">&times;</button>
            </div>
            <div class="modal-body" style="overflow-y: auto; flex: 1 1 auto;">
                @if (!string.IsNullOrEmpty(formError))
                {
                    <div class="form-error">@formError</div>
                }
                @* ─── Franja superior: Código interno + comprador de MercadoLibre, mitad y mitad.
                     auto-fit hace que en el celular se apilen solas (no entran al lado). ─── *@
                <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(270px, 1fr)); gap: 0.7rem; margin-bottom: 1rem;">

                    @* ─── Código interno (se puede asignar antes de guardar) ─── *@
                    <div style="background: #eff6ff; border: 2px solid #3b82f6; border-radius: 8px; padding: 0.7rem 0.9rem;">
                        <label class="form-label" style="font-size: 0.9rem; color: #1e3a8a; font-weight: 700; margin-bottom: 0.35rem;"
                               title="Código único de este cliente para uso interno (búsquedas rápidas, etiquetas, etc).">
                            🆔 Código interno
                        </label>
                        @if (formCodigoInterno.HasValue)
                        {
                            <div style="display: flex; gap: 0.6rem; align-items: center; flex-wrap: wrap;">
                                <span style="font-family: monospace; font-weight: 800; font-size: 1.5rem; color: #1e40af; line-height: 1;">@formCodigoInterno</span>
                                <button type="button" class="btn btn-secondary" @onclick="QuitarCodigoInterno"
                                        style="font-size: 0.78rem; padding: 0.3rem 0.6rem;">🗑 Quitar</button>
                            </div>
                            @if (!isEditing)
                            {
                                <p style="font-size: 0.7rem; color: #1e3a8a; margin: 0.35rem 0 0;">
                                    Se guarda al apretar <strong>Crear</strong>. Si otro usuario tomó ese número, se asigna el siguiente y te avisamos.
                                </p>
                            }
                        }
                        else
                        {
                            <div style="display: flex; gap: 0.6rem; align-items: center; flex-wrap: wrap;">
                                <span style="font-size: 0.85rem; color: #6b7280; font-style: italic;">— sin asignar —</span>
                                <button type="button" class="btn btn-primary" @onclick="AsignarCodigoInterno"
                                        disabled="@asignandoCodigo"
                                        style="font-size: 0.85rem; padding: 0.4rem 0.85rem; font-weight: 600;">
                                    @(asignandoCodigo ? "⏳ Asignando..." : "🎯 Asignar código")
                                </button>
                            </div>
                            <p style="font-size: 0.7rem; color: #1e3a8a; margin: 0.35rem 0 0;">
                                Toma el próximo código disponible.
                            </p>
                        }
                    </div>

                    @* ─── 2026-08-14: Vincular con un comprador de MercadoLibre (trae sus datos) ─── *@
                    <div style="background: #fffbeb; border: 2px solid #f59e0b; border-radius: 8px; padding: 0.7rem 0.9rem;">
                        @if (formMeliBuyerId.HasValue)
                        {
                            <label class="form-label" style="font-size: 0.9rem; color: #92400e; font-weight: 700; margin-bottom: 0.35rem;">
                                🛒 Cliente de MercadoLibre
                            </label>
                            <div style="display: flex; align-items: center; gap: 0.5rem; flex-wrap: wrap;">
                                <span style="display:inline-flex; align-items:center; gap:0.35rem; background:#fef3c7; color:#92400e; border:1px solid #f59e0b; border-radius:999px; padding:0.2rem 0.7rem; font-weight:700; font-size:0.85rem;">
                                    @(string.IsNullOrWhiteSpace(formMeliNickname) ? $"ID {formMeliBuyerId}" : formMeliNickname)
                                </span>
                                <button type="button" class="btn btn-secondary" style="font-size:0.78rem; padding:0.3rem 0.6rem;" @onclick="QuitarVinculoMeli">🗑 Quitar</button>
                            </div>
                            <p style="font-size:0.7rem; color:#92400e; margin:0.35rem 0 0;">Queda enganchado con su usuario de ML, así no lo cargás dos veces.</p>
                        }
                        else
                        {
                            <label class="form-label" style="font-size: 0.9rem; color:#92400e; font-weight: 700; margin-bottom:0.35rem;"
                                   title="Si el cliente te compra por MercadoLibre, escribí su usuario acá y el sistema completa lo que sepa de él. Si no, dejalo vacío y cargá los datos a mano.">
                                🛒 Cliente de MercadoLibre
                            </label>
                            <input class="form-input" value="@meliSearch" @oninput="OnMeliSearchInput"
                                   style="font-size: 0.85rem; padding: 0.4rem 0.6rem;"
                                   placeholder="Usuario de ML, nombre, teléfono..." />
                            @if (meliBuscando)
                            {
                                <p style="font-size:0.7rem; color:#6b7280; margin:0.35rem 0 0;">Buscando…</p>
                            }
                            else if (meliResults is not null && meliResults.Count == 0 && !string.IsNullOrWhiteSpace(meliSearch))
                            {
                                <p style="font-size:0.7rem; color:#6b7280; margin:0.35rem 0 0;">Sin resultados para "<strong>@meliSearch</strong>". Probá con el usuario, el nombre o el teléfono.</p>
                            }
                            else if (meliResults is not null && meliResults.Count > 0)
                            {
                                <div style="margin-top:0.4rem; max-height:200px; overflow-y:auto; display:flex; flex-direction:column; gap:0.3rem;">
                                    @foreach (var m in meliResults)
                                    {
                                        <button type="button" @onclick="() => VincularMeli(m)"
                                                style="text-align:left; background:white; border:1px solid #e5e7eb; border-radius:6px; padding:0.45rem 0.6rem; cursor:pointer; display:flex; flex-direction:column; gap:0.15rem;">
                                            <span style="font-weight:700; color:#111827; font-size:0.85rem;">
                                                🛒 @(string.IsNullOrWhiteSpace(m.Nickname) ? "(sin usuario)" : m.Nickname)
                                                @if (!string.IsNullOrWhiteSpace(m.ReceiverName)) { <span style="font-weight:500; color:#4b5563;">· @m.ReceiverName</span> }
                                            </span>
                                            <span style="font-size:0.75rem; color:#6b7280; display:flex; gap:0.7rem; flex-wrap:wrap;">
                                                @if (!string.IsNullOrWhiteSpace(m.Phone)) { <span>📞 @m.Phone</span> }
                                                @if (!string.IsNullOrWhiteSpace(m.City)) { <span>📍 @m.City@(string.IsNullOrWhiteSpace(m.State) ? "" : $", {m.State}")</span> }
                                                <span>🛍 @m.OrdersCount compra@(m.OrdersCount == 1 ? "" : "s")</span>
                                            </span>
                                        </button>
                                    }
                                </div>
                                <p style="font-size:0.68rem; color:#6b7280; margin:0.35rem 0 0;">Tocá uno para traer nombre, teléfono y dirección. El CUIT lo cargás vos: MercadoLibre no lo da.</p>
                            }
                            else
                            {
                                <p style="font-size:0.7rem; color:#6b7280; margin:0.35rem 0 0;">Buscalo y traé sus datos. Si no compra por ML, dejalo vacío.</p>
                            }
                        }
                    </div>

                </div>

                @* ═══════════════ Sección 1: Datos comerciales (lo que cargás vos) ═══════════════ *@
                <div style="background: white; border: 1px solid #e2e8f0; border-radius: 8px; padding: 1rem 1.1rem; margin-bottom: 1rem;">
                    <div style="display: flex; align-items: center; gap: 0.6rem; margin-bottom: 0.9rem; padding-bottom: 0.6rem; border-bottom: 1px solid #e2e8f0;">
                        <span style="background: #ede9fe; color: #6d28d9; font-size: 0.78rem; padding: 0.28rem 0.7rem; border-radius: 6px; font-weight: 700;">
                            🧑‍💼 1 · Datos comerciales
                        </span>
                        <span style="font-size: 0.78rem; color: #6b7280;">los cargás vos</span>
                    </div>

                    <div class="form-row">
                        <div class="form-group" style="flex: 2;">
                            <label class="form-label">Nombre fantasía *</label>
                            <input class="form-input" @bind="formNombre" placeholder="Ej: Bar Don Pepe" autofocus />
                            <p style="font-size: 0.7rem; color: #6b7280; margin: 0.2rem 0 0;">Nombre comercial / cómo lo conocés.</p>
                        </div>
                        <div class="form-group" style="flex: 1;">
                            <label class="form-label">Tipo *</label>
                            <select class="form-input" @bind="formTipo">
                                <option value="BAR">🍺 BAR</option>
                                <option value="OTRO">🏢 Comercial</option>
                            </select>
                            <p style="font-size: 0.7rem; color: #6b7280; margin: 0.2rem 0 0;">
                                Define qué descuento aplica según las reglas de precios.
                            </p>
                        </div>
                    </div>
                    <div class="form-row">
                        <div class="form-group" style="flex: 1;">
                            <label class="form-label">Email</label>
                            <input class="form-input" type="email" @bind="formEmail" placeholder="email@ejemplo.com" />
                        </div>
                    </div>
                    <div class="form-row">
                        <div class="form-group" style="flex: 1;">
                            <label class="form-label">Teléfono</label>
                            <input class="form-input" @bind="formTelefono" placeholder="Ej: 5491141234567" />
                        </div>
                        <div class="form-group" style="flex: 1;">
                            <label class="form-label">Teléfono 2</label>
                            <input class="form-input" @bind="formTelefono2" placeholder="Teléfono alternativo (opcional)" />
                        </div>
                    </div>
                    <p style="font-size: 0.72rem; color: #6b7280; margin: -0.3rem 0 0.6rem;">
                        💡 Para que el link de WhatsApp del comprobante funcione, cargá el número en <strong>formato internacional sin el +</strong>
                        (ej: <code>5491141234567</code> = 54 + 9 + 11 + número). El icono 📱 que aparece en el PDF abre WhatsApp directo a este número.
                    </p>
                    <div class="form-group">
                        <div style="display:flex; align-items:center; justify-content:space-between; gap:0.5rem;">
                            <label class="form-label" style="margin:0;">📍 Domicilio de entrega principal</label>
                            @if (!string.IsNullOrWhiteSpace(formMapeoLink))
                            {
                                <a href="@formMapeoLink" target="_blank" rel="noopener"
                                   style="display:inline-flex; align-items:center; gap:0.25rem; font-size:0.72rem; font-weight:700; color:#1e40af; background:#dbeafe; padding:0.15rem 0.5rem; border-radius:999px; text-decoration:none; white-space:nowrap;"
                                   title="Abrir el pin de este domicilio en Google Maps">🗺 Ver en Maps</a>
                            }
                        </div>
                        <input class="form-input" @bind="formDomicilioEntrega" placeholder="Donde se entregan los pedidos (si difiere del fiscal)" />
                        <p style="font-size: 0.7rem; color: #6b7280; margin: 0.2rem 0 0;">Si está vacío, se usa la dirección fiscal. Es el domicilio de siempre (su entre calles y enlace de Maps van acá abajo). Si el cliente entrega en más de un lugar, sumá domicilios alternativos.</p>
                    </div>
                    <div class="form-group">
                        <label class="form-label">Entre calles</label>
                        <input class="form-input" @bind="formEntreCalles" placeholder="Ej: entre Larroque y Beruti (referencia para la entrega)" />
                    </div>
                    @* ─── Enlace Google Maps del domicilio principal ─── *@
                    <div style="background: #eff6ff; border: 1px solid #3b82f6; border-radius: 6px; padding: 0.6rem 0.8rem; margin-top: 0.5rem;">
                        <div class="form-group" style="margin-bottom: 0;">
                            <label class="form-label" style="font-size: 0.78rem; color: #1e40af;">🗺 Enlace Google Maps (corto)</label>
                            <input class="form-input" @bind="formMapeoLink"
                                   placeholder="https://maps.app.goo.gl/..." />
                            @if (formMapeoLat.HasValue && formMapeoLng.HasValue)
                            {
                                <p style="font-size: 0.7rem; color: #15803d; margin: 0.2rem 0 0;">
                                    ✓ Coordenadas extraídas: <strong>@formMapeoLat?.ToString("0.######"), @formMapeoLng?.ToString("0.######")</strong>
                                </p>
                            }
                            else if (!string.IsNullOrEmpty(formMapeoLink) && isEditing)
                            {
                                <p style="font-size: 0.7rem; color: #d97706; margin: 0.2rem 0 0; display: flex; gap: 0.4rem; align-items: center; flex-wrap: wrap;">
                                    ⚠ No se pudieron extraer coordenadas todavía.
                                    <button type="button" class="btn btn-secondary"
                                            @onclick="ReExtraerCoords" disabled="@reExtrayendo"
                                            style="font-size: 0.7rem; padding: 0.2rem 0.4rem;">
                                        @(reExtrayendo ? "⏳..." : "🔄 Re-extraer")
                                    </button>
                                </p>
                            }
                            <p style="font-size: 0.7rem; color: #6b7280; margin: 0.2rem 0 0;">
                                Pegá el enlace corto que sale al compartir la ubicación desde Google Maps en el celular.
                                Al guardar, el sistema extrae automáticamente las coordenadas para usarlas en el mapa.
                            </p>
                        </div>
                    </div>
                    @* ─── 2026-07-30: Domicilios de entrega alternativos (se cargan por modal) ─── *@
                    <div style="background: #f0fdf4; border: 1px solid #16a34a; border-radius: 6px; padding: 0.6rem 0.8rem; margin-top: 0.5rem;">
                        <label class="form-label" style="font-size: 0.82rem; color: #166534;">🚚 Domicilios de entrega alternativos</label>
                        @if (!isEditing)
                        {
                            <p style="font-size: 0.72rem; color: #6b7280; margin: 0.2rem 0 0;">
                                Guardá el cliente primero y volvé a abrirlo para sumarle otros domicilios (sucursales / puntos de entrega). Al hacer una venta vas a poder elegir a cuál se entrega.
                            </p>
                        }
                        else
                        {
                            @if (direccionesCliente.Count == 0)
                            {
                                <p style="font-size: 0.72rem; color: #6b7280; margin: 0.2rem 0 0.5rem;">
                                    Este cliente entrega en un solo lugar (el domicilio principal de arriba). Si tiene más de un punto de entrega, sumalos acá.
                                </p>
                            }
                            else
                            {
                                <div style="display: flex; flex-direction: column; gap: 0.35rem; margin: 0.35rem 0 0.5rem;">
                                    @foreach (var d in direccionesCliente)
                                    {
                                        <div style="display: flex; align-items: center; gap: 0.5rem; background: white; border: 1px solid #d1d5db; border-radius: 6px; padding: 0.4rem 0.55rem;">
                                            <div style="flex: 1; min-width: 0;">
                                                <div style="font-weight: 600; font-size: 0.82rem;">
                                                    @(string.IsNullOrWhiteSpace(d.Etiqueta) ? "(sin nombre)" : d.Etiqueta)
                                                </div>
                                                <div style="font-size: 0.75rem; color: #4b5563;">@d.Direccion@(string.IsNullOrWhiteSpace(d.Localidad) ? "" : $" · {d.Localidad}")</div>
                                                @if (!string.IsNullOrWhiteSpace(d.EntreCalles) || !string.IsNullOrWhiteSpace(d.Telefono) || !string.IsNullOrWhiteSpace(d.MapeoLink))
                                                {
                                                    <div style="font-size: 0.7rem; color: #6b7280; display: flex; gap: 0.6rem; flex-wrap: wrap; margin-top: 0.1rem;">
                                                        @if (!string.IsNullOrWhiteSpace(d.EntreCalles)) { <span>↔ @d.EntreCalles</span> }
                                                        @if (!string.IsNullOrWhiteSpace(d.Telefono)) { <span>📞 @d.Telefono</span> }
                                                        @if (!string.IsNullOrWhiteSpace(d.MapeoLink)) { <a href="@d.MapeoLink" target="_blank" rel="noopener" style="color:#1e40af; text-decoration:none;">🗺 Maps</a> }
                                                    </div>
                                                }
                                            </div>
                                            <button type="button" class="btn btn-secondary" style="font-size: 0.68rem; padding: 0.2rem 0.4rem;" @onclick="() => AbrirModalDireccion(d)" disabled="@dirGuardando" title="Editar">✏️</button>
                                            <button type="button" class="btn btn-secondary" style="font-size: 0.68rem; padding: 0.2rem 0.4rem; color: #dc2626;" @onclick="() => BorrarDireccion(d)" disabled="@dirGuardando" title="Borrar">🗑</button>
                                        </div>
                                    }
                                </div>
                            }
                            <button type="button" class="btn btn-primary" style="font-size: 0.78rem; padding: 0.4rem 0.85rem; margin-top: 0.2rem;" @onclick="() => AbrirModalDireccion(null)" disabled="@dirGuardando">
                                ➕ Cargar domicilio alternativo
                            </button>
                        }
                    </div>
                    <div class="form-group">
                        <label class="form-label">Notas internas</label>
                        <textarea class="form-input" @bind="formNotas" rows="2" placeholder="Notas que solo ves vos (no aparecen en comprobante)"></textarea>
                    </div>
                    <div class="form-group">
                        <label class="form-label">Comentarios para comprobante</label>
                        <textarea class="form-input" @bind="formComentariosComprobante" rows="2"
                                  placeholder="Ej: Entregar antes de las 11 hs · Solicitar firma del recepcionista"></textarea>
                        <p style="font-size: 0.7rem; color: #6b7280; margin: 0.2rem 0 0;">
                            Estos comentarios <strong>aparecen en TODOS los comprobantes</strong> de este cliente.
                        </p>
                    </div>
                    @if (isEditing)
                    {
                        <div class="form-group" style="margin-top: 0.8rem;">
                            <label class="form-label">Estado</label>
                            <select class="form-input" @bind="formIsActive">
                                <option value="@true">Activo</option>
                                <option value="@false">Inactivo</option>
                            </select>
                        </div>
                    }
                    @* 2026-06-22: si se activa, todas las ventas nuevas para este cliente piden firma al entregar *@
                    <div class="form-group" style="grid-column: 1 / -1; padding: 0.6rem; background: #eff6ff; border-left: 3px solid #2563eb; border-radius: 4px; margin-top: 0.8rem; margin-bottom: 0;">
                        <label style="display: flex; align-items: center; gap: 0.5rem; cursor: pointer; font-weight: 600;">
                            <input type="checkbox" @bind="formSolicitarFirmaEntrega" style="width: 18px; height: 18px;" />
                            <span>📝 Pedir firma al receptor en cada entrega</span>
                        </label>
                        <div style="font-size: 0.78rem; color: #4b5563; margin-top: 0.3rem; margin-left: 1.7rem;">
                            Las ventas para este cliente van a heredar este flag. Al entregar, el repartidor verá un modal con canvas para firma + nombre del receptor. Permite generar un recibo de entrega para administración del cliente.
                        </div>
                    </div>
                </div>

                @* ═══════════════ Sección 2: Datos fiscales (auto desde ARCA) ═══════════════ *@
                <div style="background: white; border: 1px solid #e2e8f0; border-radius: 8px; padding: 1rem 1.1rem;">
                    <div style="display: flex; align-items: center; gap: 0.6rem; margin-bottom: 0.9rem; padding-bottom: 0.6rem; border-bottom: 1px solid #e2e8f0;">
                        <span style="background: #dbeafe; color: #1e40af; font-size: 0.78rem; padding: 0.28rem 0.7rem; border-radius: 6px; font-weight: 700;">
                            📋 2 · Datos fiscales
                        </span>
                        <span style="font-size: 0.78rem; color: #6b7280;">cargá el CUIT y apretá 🔍 ARCA para autocompletar</span>
                    </div>

                    <div class="form-group">
                        <label class="form-label">CUIT / DNI</label>
                        <div style="display: flex; gap: 0.4rem; align-items: stretch;">
                            <input class="form-input" @bind="formCuit" placeholder="Ej: 30123456789"
                                   style="flex: 1 1 auto; min-width: 0;" />
                            <button type="button" class="btn btn-secondary" @onclick="BuscarPorCuit" disabled="@buscandoCuit"
                                    title="Trae automáticamente Razón Social, Dirección y Condición IVA"
                                    style="flex: 0 0 auto; white-space: nowrap; font-size: 0.85rem; padding: 0.45rem 0.9rem;">
                                @if (buscandoCuit) { <span>⏳</span> } else { <span>🔍 ARCA</span> }
                            </button>
                        </div>
                        <p style="font-size: 0.7rem; color: #6b7280; margin: 0.2rem 0 0;">
                            Cargá el CUIT (11 dígitos) y apretá <strong>🔍 ARCA</strong> — completa Razón Social, Dirección, CP, Localidad, Provincia y Condición IVA.
                        </p>
                    </div>
                    <div class="form-group">
                        <label class="form-label">Razón social (legal)</label>
                        <input class="form-input" @bind="formRazonSocial" placeholder="Ej: PEPITO Y CIA. S.A." />
                        <p style="font-size: 0.7rem; color: #6b7280; margin: 0.2rem 0 0;">Si se carga, aparece en facturas y proformas. Si está vacío, se usa el nombre fantasía.</p>
                    </div>
                    <div class="form-group">
                        <label class="form-label">Dirección fiscal</label>
                        <input class="form-input" @bind="formDireccion" placeholder="Calle, número, barrio..." />
                        <p style="font-size: 0.7rem; color: #6b7280; margin: 0.2rem 0 0;">Domicilio fiscal del cliente (la dirección legal).</p>
                    </div>
                    <div class="form-row">
                        <div class="form-group" style="flex: 1;">
                            <label class="form-label">CP</label>
                            <input class="form-input" value="@formCp"
                                   @oninput="@(e => OnFormCpInput(e.Value?.ToString()))"
                                   maxlength="4" placeholder="1900" />
                            <p style="font-size: 0.7rem; color: #6b7280; margin: 0.2rem 0 0;">4 dígitos. Auto-completa.</p>
                        </div>
                        <div class="form-group" style="flex: 2;">
                            <label class="form-label">Localidad</label>
                            <input class="form-input" list="datalist-localidades" @bind="formLocalidad" @bind:event="oninput" placeholder="Ej: La Plata" />
                            <datalist id="datalist-localidades">
                                @foreach (var loc in localidadesSugeridas)
                                {
                                    <option value="@loc"></option>
                                }
                            </datalist>
                            <p style="font-size: 0.7rem; color: #6b7280; margin: 0.2rem 0 0;">Sugerencias segun la provincia. Podes tipear libre si no esta.</p>
                        </div>
                        <div class="form-group" style="flex: 2;">
                            <label class="form-label">Provincia</label>
                            <input class="form-input" list="datalist-provincias" value="@formCiudad" @oninput="@(e => OnProvinciaInput(e.Value?.ToString()))" placeholder="Ej: Buenos Aires" />
                            <datalist id="datalist-provincias">
                                @foreach (var p in provincias)
                                {
                                    <option value="@p"></option>
                                }
                            </datalist>
                            <p style="font-size: 0.7rem; color: #6b7280; margin: 0.2rem 0 0;">Elegi de la lista para unificar nombres.</p>
                        </div>
                    </div>
                    <div class="form-group" style="margin-bottom: 0;">
                        <label class="form-label">Condición frente al IVA</label>
                        <select class="form-input" @bind="formCondicionIvaDefault">
                            <option value="">— Sin especificar —</option>
                            <option value="RI">Responsable Inscripto</option>
                            <option value="MO">Monotributo</option>
                            <option value="EX">Exento</option>
                            <option value="CF">Consumidor Final</option>
                        </select>
                        <p style="font-size: 0.7rem; color: #6b7280; margin: 0.2rem 0 0;">Default que se sugiere al emitir comprobantes para este cliente. Define si la factura es A o B.</p>
                    </div>
                </div>
            </div>
            <div class="modal-footer">
                <button class="btn btn-secondary" @onclick="CloseForm" disabled="@saving">Cancelar</button>
                <button class="btn btn-primary" @onclick="Save" disabled="@saving">@(saving ? "Guardando..." : (isEditing ? "Guardar" : "Crear"))</button>
            </div>
        </div>
    </div>
}

