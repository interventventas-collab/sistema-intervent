    private List<MeliClienteDto>? meliResults;
    private bool meliBuscando;
    private System.Threading.CancellationTokenSource? _meliSearchCts;

    /// <summary>Se dispara con cada tecla del buscador de MercadoLibre. Espera ~300ms a que el
    /// usuario termine de tipear y busca en la base propia de clientes MeLi (hasta 20 resultados).</summary>
    private async Task OnMeliSearchInput(ChangeEventArgs e)
    {
        meliSearch = e.Value?.ToString() ?? "";
        _meliSearchCts?.Cancel();
        var cts = new System.Threading.CancellationTokenSource();
        _meliSearchCts = cts;
        var term = meliSearch.Trim();
        if (term.Length < 2) { meliResults = null; meliBuscando = false; return; }
        meliBuscando = true;
        try { await Task.Delay(300, cts.Token); }
        catch (TaskCanceledException) { return; }
        if (cts.IsCancellationRequested) return;
        try
        {
            var res = await Api.GetMeliClientesAsync(term, false, 1, 20);
            if (cts.IsCancellationRequested) return;
            meliResults = res?.Items ?? new();
        }
        catch { meliResults = new(); }
        finally { if (_meliSearchCts == cts) { meliBuscando = false; StateHasChanged(); } }
    }

    /// <summary>Vincula el cliente al comprador de ML elegido y trae sus datos al formulario
    /// (sin pisar lo que el usuario ya escribió). Avisa si ese usuario ya está cargado como otro cliente.</summary>
    private async Task VincularMeli(MeliClienteDto m)
    {
        try
        {
            var yaExiste = await Api.GetCafeClientePorMeliBuyerAsync(m.BuyerId);
            if (yaExiste is not null && (!editingId.HasValue || yaExiste.Id != editingId.Value))
            {
                var seguir = await JS.InvokeAsync<bool>("confirm",
                    $"El usuario de MercadoLibre \"{m.Nickname}\" ya está vinculado al cliente \"{yaExiste.Nombre}\" (código {yaExiste.Codigo}). ¿Vincularlo igual a este cliente?");
                if (!seguir) return;
            }
        }
        catch { /* si la verificación falla, seguimos igual */ }

        formMeliBuyerId = m.BuyerId;
        formMeliNickname = m.Nickname;
        // Traer datos, respetando lo que el usuario ya haya cargado (solo completa lo vacío).
        if (string.IsNullOrWhiteSpace(formNombre))
            formNombre = !string.IsNullOrWhiteSpace(m.ReceiverName) ? m.ReceiverName!.Trim() : (m.Nickname ?? "").Trim();
        if (string.IsNullOrWhiteSpace(formTelefono) && !string.IsNullOrWhiteSpace(m.Phone)) formTelefono = m.Phone!.Trim();
        if (string.IsNullOrWhiteSpace(formDomicilioEntrega) && !string.IsNullOrWhiteSpace(m.AddressLine)) formDomicilioEntrega = m.AddressLine!.Trim();
        if (string.IsNullOrWhiteSpace(formLocalidad) && !string.IsNullOrWhiteSpace(m.City)) formLocalidad = m.City!.Trim();
        if (string.IsNullOrWhiteSpace(formCiudad) && !string.IsNullOrWhiteSpace(m.State)) formCiudad = m.State!.Trim();
        if (string.IsNullOrWhiteSpace(formCp) && !string.IsNullOrWhiteSpace(m.ZipCode)) formCp = m.ZipCode!.Trim();
        meliSearch = ""; meliResults = null;
        if (!string.IsNullOrWhiteSpace(formCiudad))
            localidadesSugeridas = await CpService.GetLocalidadesAsync(formCiudad);
        ToastService.Success($"Datos de MercadoLibre traídos: {(string.IsNullOrWhiteSpace(m.Nickname) ? "usuario" : m.Nickname)}");
    }

