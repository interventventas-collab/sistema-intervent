@page "/cafe/proveedores-ctacte"
@attribute [Authorize]
@inject ApiClient Api
@inject ToastService ToastService
@inject NavigationManager Nav
@inject IJSRuntime JS

<style>
    .cc-lista { width: 100%; border-collapse: collapse; font-size: 0.92rem; }
    .cc-lista th { text-align: left; font-size: 0.72rem; font-weight: 700; color: #6b7280; text-transform: uppercase;
                   letter-spacing: 0.04em; padding: 0.55rem 1rem; border-bottom: 1px solid #e5e7eb; white-space: nowrap; }
    .cc-lista td { padding: 0.65rem 1rem; border-bottom: 1px solid #f3f4f6; vertical-align: middle; }
    .cc-lista tbody tr { cursor: pointer; }
    .cc-lista tbody tr:hover { background: #f9fafb; }
    .cc-lista .num { text-align: right; white-space: nowrap; font-variant-numeric: tabular-nums; }
    .cc-lista .sub { font-size: 0.75rem; color: #6b7280; margin-top: 0.1rem; }
    .cc-lista .fecha { font-size: 0.85rem; color: #6b7280; white-space: nowrap; }
    .cc-lista .gris { color: #6b7280; }
    .cc-lista .total { font-weight: 700; color: #6b7280; }
    .cc-lista .total.debe { color: #b91c1c; }
    .cc-lista .flecha { color: #9ca3af; font-size: 1.3rem; width: 1.5rem; text-align: right; padding-left: 0; }
    .cc-lista .prog { font-size: 0.75rem; color: #6b7280; margin-top: 0.1rem; }
    .cc-btn-prog { border: 1px solid #e5e7eb; background: #fff; border-radius: 6px; padding: 0.2rem 0.5rem; font-size: 0.8rem; cursor: pointer; white-space: nowrap; }
    .cc-btn-prog:hover { border-color: #9ca3af; }
    /* 17/11/2026: pagos programados arriba de la lista */
    .pg { width: 100%; border-collapse: collapse; font-size: 0.9rem; }
    .pg td { padding: 0.45rem 1rem; border-bottom: 1px solid #f3f4f6; vertical-align: middle; }
    .pg .grupo td { font-size: 0.7rem; font-weight: 700; color: #6b7280; text-transform: uppercase; letter-spacing: 0.04em;
                    padding-top: 0.7rem; border-bottom: 1px solid #e5e7eb; }
    .pg .grupo.atr td { color: #b91c1c; }
    .pg .num { text-align: right; white-space: nowrap; font-variant-numeric: tabular-nums; }
    .pg .gris { color: #6b7280; font-size: 0.82rem; }
    .pg .rojo { color: #b91c1c; font-weight: 600; }
    .pg .hoy { background: #fef3c7; border-radius: 4px; padding: 0.05rem 0.35rem; }
    .pg .acc { text-align: right; white-space: nowrap; width: 1%; }
    .pg .acc button { margin-left: 0.25rem; }
    .pg-pie { padding: 0.55rem 1rem; font-size: 0.85rem; color: #6b7280; }
    /* 17/11/2026: todos los meses + transferir + banco */
    .pg .banco { background: #fef3c7; border-radius: 4px; padding: 0.2rem 0.45rem; margin-top: 0.25rem; font-size: 0.82rem; display: inline-block; }
    .pg .ok { color: #15803d; font-weight: 600; }
    .tr-dato { display: flex; justify-content: space-between; align-items: center; gap: 0.5rem; padding: 0.5rem 0; border-bottom: 1px solid #f3f4f6; }
    .tr-dato .k { color: #6b7280; font-size: 0.85rem; }
    .tr-dato .v { text-align: right; word-break: break-all; }
    .tr-nota { margin: 0.6rem 0 0; color: #6b7280; font-size: 0.82rem; text-align: left; line-height: 1.45; word-spacing: normal; letter-spacing: normal; }
    .tr-link { color: #6b7280; font-size: 0.8rem; text-decoration: underline; }
    .tr-copy { border: 1px solid #d1d5db; background: #fff; border-radius: 5px; padding: 0.05rem 0.45rem; font-size: 0.75rem; margin-left: 0.4rem; cursor: pointer; }
</style>

@* 17/09/2026 — Cuenta corriente de proveedores: a quién le debemos y cuánto.
   OFICIAL = facturas de AFIP (entran solas). NO OFICIAL = cotizaciones cargadas a mano.
   Solo los proveedores con cuenta corriente, desde el día en que se les prendió. *@

@* 17/11/2026: pagos PROGRAMADOS (cuándo le pago a quién). Pedido del dueño: que esté acá y no en una pantalla
   nueva ("así no llenamos todo de pantallas"). Maqueta: scratchpad/Pagos_programados_proveedores_PROPUESTA.png *@
<div class="card" style="margin-bottom:1rem;">
    <div class="card-header" style="display:flex; justify-content:space-between; align-items:center; flex-wrap:wrap; gap:0.5rem;">
        <h3 style="margin:0;">📅 Pagos programados</h3>
        <button class="btn btn-primary" @onclick="() => AbrirProgramar(null)">📅 Programar pago</button>
    </div>
    <div class="card-body" style="padding:0;">
        @if (programados is null)
        {
            <p class="text-muted" style="padding:1rem;">Cargando...</p>
        }
        else if (programados.Count == 0 && pagadosRecien.Count == 0)
        {
            <p class="text-muted" style="padding:0.8rem 1rem; margin:0;">No hay pagos programados. Tocá <b>📅 Programar pago</b> para anotar cuándo le pagás a un proveedor.</p>
        }
        else
        {
            var hoy = FechaPalabras.HoyAr;
            var finSemana = hoy.AddDays(6 - (((int)hoy.DayOfWeek + 6) % 7));
            var grupos = new (string Tit, string Css, List<ApiClient.PagoProgramadoDto> L)[]
            {
                ("Atrasado", "atr", programados.Where(p => p.Fecha.Date < hoy).ToList()),
                ("Hoy", "", programados.Where(p => p.Fecha.Date == hoy).ToList()),
                ("Esta semana", "", programados.Where(p => p.Fecha.Date > hoy && p.Fecha.Date <= finSemana).ToList()),
                ("Más adelante", "", programados.Where(p => p.Fecha.Date > finSemana).ToList()),
            };
            <div class="table-responsive">
                <table class="pg">
                    @foreach (var g in grupos.Where(x => x.L.Count > 0))
                    {
                        <tr class="grupo @g.Css"><td colspan="5">@g.Tit</td></tr>
                        @foreach (var p0 in g.L)
                        {
                            var p = p0;
                            <tr>
                                <td style="white-space:nowrap;">
                                    <span class="@(p.Fecha.Date == hoy ? "hoy" : "") @(p.Fecha.Date < hoy ? "rojo" : "")">@FechaPalabras.Corta(p.Fecha)</span>
                                </td>
                                <td>
                                    <b>@p.ProveedorNombre</b>
                                    @if (p.Partes > 1) { <span class="gris"> · @p.Parte de @p.Partes</span> }
                                    @if (p.Claves.Count > 0) { <span class="gris"> · @p.Claves.Count comprobante@(p.Claves.Count == 1 ? "" : "s")</span> }
                                    @if (p.DiaMes is int dm) { <span class="gris"> · 🔁 todos los @dm</span> }
                                    @if (!string.IsNullOrWhiteSpace(p.FacturaTexto)) { <span class="gris"> · paga @p.FacturaTexto</span> }
                                    @if (!string.IsNullOrWhiteSpace(p.Nota)) { <div class="gris">@p.Nota</div> }
                                    @if (p.TransferidoAt.HasValue) { <div class="gris">⏳ transferida, esperando que aparezca en el banco</div> }
                                    @if (p.BancoMovId is int mid && p.BancoImporte is decimal bi)
                                    {
                                        <div class="banco">🏦 El banco muestra @Plata0(bi) el @p.BancoFecha?.ToString("dd/MM") a este CUIT
                                            <button class="btn btn-secondary" style="font-size:0.75rem; padding:0.1rem 0.5rem; margin-left:0.3rem;" @onclick="() => TomarBanco(p, mid, bi)">Tomarlo</button>
                                        </div>
                                    }
                                </td>
                                <td class="gris">@MedioTexto(p.Medio)</td>
                                <td class="num @(p.Fecha.Date < hoy ? "rojo" : "")">@Plata0(p.Importe)</td>
                                <td class="acc">
                                    @if (p.Medio == "TRANSFERENCIA")
                                    {
                                        <button class="btn btn-secondary" style="font-size:0.8rem; padding:0.2rem 0.6rem;" @onclick="() => AbrirTransferir(p)">💸 Transferir</button>
                                    }
                                    else
                                    {
                                        <button class="btn btn-secondary" style="font-size:0.8rem; padding:0.2rem 0.6rem;" @onclick="() => Pagar(p)">Pagar</button>
                                    }
                                    <button class="btn-icon" title="Cambiar fecha o importe" @onclick="() => AbrirEditar(p)">✏</button>
                                    <button class="btn-icon" title="Sacarlo de la lista (no se paga así)" @onclick="() => Quitar(p)">✕</button>
                                </td>
                            </tr>
                        }
                    }
                    @if (pagadosRecien.Count > 0)
                    {
                        <tr class="grupo"><td colspan="5">Pagados estos días</td></tr>
                        @foreach (var p in pagadosRecien)
                        {
                            <tr>
                                <td class="gris" style="white-space:nowrap;">@FechaPalabras.Corta(p.Fecha)</td>
                                <td><b>@p.ProveedorNombre</b>@if (p.DiaMes is int dm2) { <span class="gris"> · 🔁 todos los @dm2</span> }</td>
                                <td class="gris">@MedioTexto(p.Medio)</td>
                                <td class="num">@Plata0(p.Importe)</td>
                                <td class="acc ok">✓ pagado@(p.PagadoPorBanco ? " (vino en el banco)" : "")</td>
                            </tr>
                        }
                    }
                </table>
            </div>
            <div class="pg-pie">
                Esta semana salen <b style="color:#111827;">@Plata0(programados.Where(p => p.Fecha.Date >= hoy && p.Fecha.Date <= finSemana).Sum(p => p.Importe))</b>
                @{ var atr = programados.Where(p => p.Fecha.Date < hoy).Sum(p => p.Importe); }
                @if (atr > 0) { <span> · atrasado <b style="color:#b91c1c;">@Plata0(atr)</b></span> }
            </div>
        }
    </div>
</div>

<div class="card">
    <div class="card-header" style="display:flex; justify-content:space-between; align-items:center; flex-wrap:wrap; gap:0.5rem;">
        <h3 style="margin:0;">📒 Cuenta corriente proveedores</h3>
        <div style="display:flex; gap:0.4rem; align-items:center; flex-wrap:wrap;">
            @if (lista is { Count: > 0 })
            {
                <input class="form-input" style="min-width:200px; font-size:0.85rem;" @bind="filtro" @bind:event="oninput" placeholder="🔍 Buscar proveedor..." />
            }
            <button class="btn btn-primary" @onclick="AbrirAgregar">+ Agregar proveedor</button>
        </div>
    </div>
    <div class="card-body" style="padding:0;">
        @if (lista is null)
        {
            <p class="text-muted" style="padding:1rem;">Cargando...</p>
        }
        else if (lista.Count == 0)
        {
            <div style="padding:1rem; font-size:0.9rem; line-height:1.5;">
                Todavía no hay proveedores con cuenta corriente.<br />
                Tocá <b>+ Agregar proveedor</b>: elegís desde qué día se cuenta y cuánto le debías ese día.
                Desde ahí sus facturas de AFIP entran solas y las cotizaciones las cargás en su cuenta.
            </div>
        }
        else
        {
            <div style="padding:0.7rem 1rem; font-size:0.95rem; border-bottom:1px solid #e5e7eb;">
                Le debo en total <b style="color:@(lista.Sum(x => x.Total) > 0.01m ? "#b91c1c" : "inherit");">@Plata(lista.Sum(x => x.Total))</b>
                <span style="color:#6b7280;"> · oficial @Plata(lista.Sum(x => x.Oficial)) · no oficial @Plata(lista.Sum(x => x.NoOficial))@(lista.Sum(x => x.ACuenta) > 0.01m ? $" · a cuenta −{Plata(lista.Sum(x => x.ACuenta))}" : "")</span>
            </div>
            @* 17/09/2026: columnas con aire (antes "No oficial" y "A cuenta" se pisaban) y una flechita
               para que se note que el renglón se toca y entra a la cuenta del proveedor. *@
            <div class="table-responsive">
                <table class="cc-lista">
                    <thead>
                        <tr>
                            <th>Proveedor</th>
                            <th>Desde</th>
                            <th class="num">Oficial</th>
                            <th class="num">No oficial</th>
                            <th class="num">A cuenta</th>
                            <th class="num">Le debo</th>
                            <th></th>
                            <th></th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var c in Visibles)
                        {
                            var id = c.ProveedorId;
                            <tr @onclick='() => Nav.NavigateTo($"/cafe/proveedores/{id}/estado-cuenta")' title="Ver la cuenta de @c.Nombre">
                                <td>
                                    <b>@c.Nombre</b>
                                    <div class="sub">@(c.Cuit ?? "sin CUIT: no le llegan las facturas de AFIP")@(c.Pendientes > 0 ? $" · {c.Pendientes} pendiente{(c.Pendientes == 1 ? "" : "s")}" : "")</div>
                                    @{ var prox = programados?.Where(p => p.ProveedorId == id).OrderBy(p => p.Fecha).ToList(); }
                                    @if (prox is { Count: > 0 })
                                    {
                                        <div class="prog">📅 programado @FechaPalabras.Corta(prox[0].Fecha) · @Plata0(prox[0].Importe)@(prox.Count > 1 ? $" (+{prox.Count - 1} más)" : "")</div>
                                    }
                                </td>
                                <td class="fecha">@c.Desde?.ToString("dd/MM/yyyy")</td>
                                <td class="num">@Plata(c.Oficial)</td>
                                <td class="num">@Plata(c.NoOficial)</td>
                                <td class="num gris">@(c.ACuenta > 0.01m ? "−" + Plata(c.ACuenta) : "")</td>
                                <td class="num total @(c.Total > 0.01m ? "debe" : "")">@Plata(c.Total)</td>
                                <td style="width:1%;"><button class="cc-btn-prog" title="Programar un pago a @c.Nombre" @onclick:stopPropagation="true" @onclick="() => AbrirProgramar(id)">📅 Programar</button></td>
                                <td class="flecha">›</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </div>
</div>

@if (agregando)
{
    <div class="modal-overlay" @onclick="CerrarAgregar">
        <div class="modal-card" @onclick:stopPropagation="true" style="max-width:600px; width:95vw; max-height:90vh; overflow-y:auto;">
            <div class="modal-header">
                <h4 style="margin:0;">+ Agregar proveedor a la cuenta corriente</h4>
                <button class="btn-close" @onclick="CerrarAgregar">&times;</button>
            </div>
            <div class="modal-body">
                @if (elegido is null)
                {
                    <div class="form-group">
                        <label class="form-label">Proveedor</label>
                        <input class="form-input" @bind="busqueda" @bind:event="oninput" @bind:after="Buscar"
                               placeholder="Nombre o CUIT (busca también en las facturas de AFIP)" autofocus />
                    </div>
                    @if (buscando)
                    {
                        <p class="text-muted">Buscando...</p>
                    }
                    else if (busqueda.Trim().Length >= 2 && candidatos.Count == 0)
                    {
                        <p class="text-muted">No encontré ningún proveedor ni factura de AFIP con eso.</p>
                    }
                    @foreach (var c in candidatos)
                    {
                        var cand = c;
                        <div @onclick="() => Elegir(cand)" style="padding:0.5rem 0.6rem; border-bottom:1px solid #f3f4f6; cursor:pointer;">
                            <b>@c.Nombre</b>
                            <div style="font-size:0.78rem; color:#6b7280;">
                                @(c.Cuit ?? "sin CUIT")
                                @(c.FacturasAfip > 0 ? $" · {c.FacturasAfip} factura{(c.FacturasAfip == 1 ? "" : "s")} en AFIP, la última del {c.UltimaFactura:dd/MM/yyyy}" : " · sin facturas en AFIP")
                                @if (c.YaLleva) { <span> · ya lleva cuenta corriente</span> }
                                else if (c.ProveedorId is null) { <span> · no está cargado como proveedor: se crea</span> }
                            </div>
                        </div>
                    }
                }
                else
                {
                    <div style="margin-bottom:0.8rem;">
                        <b>@elegido.Nombre</b>
                        <span style="font-size:0.8rem; color:#6b7280;"> · @(elegido.Cuit ?? "sin CUIT")</span>
                        <button class="btn btn-secondary" style="font-size:0.75rem; margin-left:0.5rem;" @onclick="() => elegido = null">cambiar</button>
                        @if (string.IsNullOrEmpty(elegido.Cuit))
                        {
                            <div style="font-size:0.8rem; color:#b45309; margin-top:0.3rem;">Sin CUIT no le van a llegar sus facturas de AFIP: cargáselo en su ficha.</div>
                        }
                    </div>
                    <ArranqueCtaCte @bind-Desde="desde" @bind-Oficial="saldoOficial" @bind-NoOficial="saldoNoOficial" />
                }
            </div>
            <div class="modal-footer">
                <button class="btn btn-secondary" @onclick="CerrarAgregar" disabled="@guardando">Cancelar</button>
                @if (elegido is not null)
                {
                    <button class="btn btn-primary" @onclick="Guardar" disabled="@guardando">@(guardando ? "Guardando..." : "Llevar cuenta corriente")</button>
                }
            </div>
        </div>
    </div>
}

@if (programando)
{
    <ProgramarPagoProveedor ProveedorId="programarProveedorId" OnCerrar="() => programando = false" OnGuardado="Programado" />
}

@if (transfiriendo is not null)
{
    var t = transfiriendo;
    <div class="modal-overlay" @onclick="() => transfiriendo = null">
        <div class="modal-card" @onclick:stopPropagation="true" style="max-width:440px; width:95vw;">
            <div class="modal-header">
                <h4 style="margin:0;">💸 Transferir a @t.ProveedorNombre</h4>
                <button class="btn-close" @onclick="() => transfiriendo = null">&times;</button>
            </div>
            <div class="modal-body">
                @if (editandoBanco || (string.IsNullOrWhiteSpace(t.Alias) && string.IsNullOrWhiteSpace(t.Cbu)))
                {
                    <div class="pp-sub" style="margin-bottom:0.4rem; color:#6b7280; font-size:0.82rem;">Cargá el alias o el CBU (queda guardado en su ficha):</div>
                    <div style="display:grid; grid-template-columns:1fr 1fr; gap:0.5rem;">
                        <input class="form-input" @bind="trAlias" placeholder="Alias" maxlength="100" />
                        <input class="form-input" @bind="trCbu" placeholder="CBU / CVU" inputmode="numeric" maxlength="30" />
                    </div>
                    <div style="text-align:right; margin-top:0.4rem;"><button class="btn btn-secondary" style="font-size:0.8rem;" @onclick="GuardarBanco">Guardar</button></div>
                }
                else
                {
                    @if (!string.IsNullOrWhiteSpace(t.Alias))
                    {
                        <div class="tr-dato"><span class="k">Alias</span><span class="v"><b>@t.Alias</b><button class="tr-copy" @onclick="() => Copiar(t.Alias!)">copiar</button></span></div>
                    }
                    @if (!string.IsNullOrWhiteSpace(t.Cbu))
                    {
                        <div class="tr-dato"><span class="k">CBU</span><span class="v">@t.Cbu<button class="tr-copy" @onclick="() => Copiar(t.Cbu!)">copiar</button></span></div>
                    }
                }
                @if (!string.IsNullOrWhiteSpace(t.Cuit))
                {
                    <div class="tr-dato"><span class="k">CUIT</span><span class="v">@CuitLindo(t.Cuit)<button class="tr-copy" @onclick="() => Copiar(t.Cuit!)">copiar</button></span></div>
                }
                <div class="tr-dato"><span class="k">Importe</span><span class="v"><b>@Plata0(t.Importe)</b><button class="tr-copy" @onclick="() => Copiar(ImporteParaCopiar(t.Importe))">copiar</button></span></div>
                @if (!string.IsNullOrWhiteSpace(t.FacturaTexto))
                {
                    <div class="tr-dato"><span class="k">Paga</span><span class="v">@t.FacturaTexto</span></div>
                }
                @if (!editandoBanco && !(string.IsNullOrWhiteSpace(t.Alias) && string.IsNullOrWhiteSpace(t.Cbu)))
                {
                    <div style="text-align:right; margin-top:0.3rem;"><a href="" class="tr-link" @onclick="() => { editandoBanco = true; trAlias = t.Alias; trCbu = t.Cbu; }" @onclick:preventDefault="true">✏ cambiar alias/CBU</a></div>
                }
                <p class="tr-nota">"Ya la hice" la deja <b>esperando el banco</b>: cuando la transferencia aparezca en el extracto del Galicia, el pago se carga solo.</p>
                <p class="tr-nota"><a href="" class="tr-link" @onclick="() => Pagar(t)" @onclick:preventDefault="true">O cargar el pago a mano</a></p>
            </div>
            <div class="modal-footer" style="justify-content:space-between;">
                <a class="btn btn-secondary" href="https://empresas.bancogalicia.com.ar/login" target="_blank" rel="noopener">Abrir Galicia Office ↗</a>
                @if (t.TransferidoAt.HasValue)
                {
                    <button class="btn btn-secondary" @onclick="() => YaLaHice(t, true)">No, todavía no la hice</button>
                }
                else
                {
                    <button class="btn btn-primary" style="white-space:nowrap;" @onclick="() => YaLaHice(t, false)">✓ Ya la hice</button>
                }
            </div>
        </div>
    </div>
}

@if (quitando is not null)
{
    <div class="modal-overlay" @onclick="() => quitando = null">
        <div class="modal-card" @onclick:stopPropagation="true" style="max-width:420px; width:95vw;">
            <div class="modal-header">
                <h4 style="margin:0;">✕ @quitando.ProveedorNombre · todos los @quitando.DiaMes</h4>
                <button class="btn-close" @onclick="() => quitando = null">&times;</button>
            </div>
            <div class="modal-body">No toca ningún pago hecho. ¿Qué querés sacar?</div>
            <div class="modal-footer">
                <button class="btn btn-secondary" @onclick="() => QuitarMensual(false)">Solo este mes</button>
                <button class="btn btn-danger" @onclick="() => QuitarMensual(true)">Dejar de pagarle todos los meses</button>
            </div>
        </div>
    </div>
}

@if (editando is not null)
{
    <div class="modal-overlay" @onclick="() => editando = null">
        <div class="modal-card" @onclick:stopPropagation="true" style="max-width:420px; width:95vw;">
            <div class="modal-header">
                <h4 style="margin:0;">✏ @editando.ProveedorNombre@(editando.Partes > 1 ? $" · {editando.Parte} de {editando.Partes}" : "")</h4>
                <button class="btn-close" @onclick="() => editando = null">&times;</button>
            </div>
            <div class="modal-body">
                <div style="display:grid; grid-template-columns:1fr 1fr; gap:0.6rem;">
                    <div class="form-group" style="margin:0;"><label class="form-label">Fecha</label><input class="form-input" type="date" @bind="edFecha" /></div>
                    <div class="form-group" style="margin:0;"><label class="form-label">Importe</label><input class="form-input" type="text" inputmode="decimal" @bind="EdImporteTexto" /></div>
                </div>
                <div class="form-group" style="margin-top:0.8rem;">
                    <label class="form-label">¿Cómo?</label>
                    <select class="form-input" @bind="edMedio">
                        <option value="TRANSFERENCIA">Transferencia</option>
                        <option value="ECHEQ">E-cheq</option>
                        <option value="EFECTIVO">Efectivo</option>
                    </select>
                </div>
                <div class="form-group"><label class="form-label">Nota</label><input class="form-input" @bind="edNota" maxlength="500" /></div>
            </div>
            <div class="modal-footer">
                <button class="btn btn-secondary" @onclick="() => editando = null">Cancelar</button>
                <button class="btn btn-primary" @onclick="GuardarEdicion" disabled="@(edImporte <= 0)">Guardar</button>
            </div>
        </div>
    </div>
}

@code {
    private List<CtaCteResumenDto>? lista;
    private List<ApiClient.PagoProgramadoDto>? programados;
    private bool programando;
    private int? programarProveedorId;
    private ApiClient.PagoProgramadoDto? editando;
    private DateTime edFecha;
    private decimal edImporte;
    private string edMedio = "TRANSFERENCIA";
    private string? edNota;
    private string EdImporteTexto
    {
        get => MontoInput.Formato(edImporte);
        set { MontoInput.TryParse(value, out edImporte); }
    }
    private string filtro = "";

    private bool agregando, buscando, guardando;
    private string busqueda = "";
    private int busquedaNro;
    private List<CtaCteCandidatoDto> candidatos = new();
    private CtaCteCandidatoDto? elegido;
    private DateTime desde = DateTimeExt.AhoraAr().Date;
    private decimal saldoOficial, saldoNoOficial;

    private IEnumerable<CtaCteResumenDto> Visibles => string.IsNullOrWhiteSpace(filtro) || lista is null
        ? lista ?? new()
        : lista.Where(c => c.Nombre.Contains(filtro.Trim(), StringComparison.OrdinalIgnoreCase) || (c.Cuit ?? "").Contains(filtro.Trim()));

    [Parameter, SupplyParameterFromQuery(Name = "programar")] public int? PreProgramar { get; set; }
    /// <summary>17/11/2026: ?transferir=ID (desde la campanita) abre la ventana "Transferir a ...".</summary>
    [Parameter, SupplyParameterFromQuery(Name = "transferir")] public int? PreTransferir { get; set; }

    private List<ApiClient.PagoProgramadoDto> pagadosRecien = new();
    private ApiClient.PagoProgramadoDto? transfiriendo, quitando;
    private bool editandoBanco;
    private string? trAlias, trCbu;
    private int? ultimoTransferirAbierto;

    protected override async Task OnInitializedAsync()
    {
        await Task.WhenAll(Cargar(), CargarProgramados());
        // ?programar=0 abre la ventana vacía; ?programar=ID la abre con ese proveedor (desde su cuenta).
        if (PreProgramar.HasValue) AbrirProgramar(PreProgramar > 0 ? PreProgramar : null);
    }

    protected override async Task OnParametersSetAsync()
    {
        // La campanita navega a esta misma página con otro ?transferir=: abrir esa ventana cada vez.
        if (PreTransferir is int tid && tid != ultimoTransferirAbierto)
        {
            ultimoTransferirAbierto = tid;
            var p = programados?.FirstOrDefault(x => x.Id == tid) ?? await Api.GetPagoProgramadoAsync(tid);
            if (p is not null && p.Estado == "PENDIENTE")
            {
                if (p.Medio == "TRANSFERENCIA") AbrirTransferir(p);
                else Pagar(p);
            }
        }
    }

    private void AbrirTransferir(ApiClient.PagoProgramadoDto p) { transfiriendo = p; editandoBanco = false; trAlias = p.Alias; trCbu = p.Cbu; }

    private async Task Copiar(string texto)
    {
        try { await JS.InvokeVoidAsync("copyToClipboard", texto); ToastService.Success("Copiado: " + texto); }
        catch { ToastService.Error("No se pudo copiar"); }
    }

    private static string ImporteParaCopiar(decimal v) => v.ToString("0.##", CultureInfo.GetCultureInfo("es-AR"));
    private static string CuitLindo(string c) => c.Length == 11 ? $"{c[..2]}-{c[2..10]}-{c[10]}" : c;

    private async Task GuardarBanco()
    {
        if (transfiriendo is null) return;
        if (!await Api.GuardarProveedorBancoAsync(transfiriendo.ProveedorId, trAlias, trCbu)) { ToastService.Error("No se pudo guardar"); return; }
        var cbuLimpio = string.IsNullOrWhiteSpace(trCbu) ? null : new string(trCbu.Where(char.IsDigit).ToArray());
        transfiriendo = transfiriendo with { Alias = string.IsNullOrWhiteSpace(trAlias) ? null : trAlias.Trim(), Cbu = string.IsNullOrEmpty(cbuLimpio) ? null : cbuLimpio };
        editandoBanco = false;
        await CargarProgramados();
    }

    private async Task YaLaHice(ApiClient.PagoProgramadoDto p, bool deshacer)
    {
        if (!await Api.MarcarPagoProgramadoTransferidoAsync(p.Id, deshacer)) { ToastService.Error("No se pudo"); return; }
        ToastService.Success(deshacer ? "Vuelve a quedar pendiente" : "Listo: cuando aparezca en el banco se carga el pago solo");
        transfiriendo = null;
        await CargarProgramados();
    }

    private async Task TomarBanco(ApiClient.PagoProgramadoDto p, int movId, decimal importeBanco)
    {
        var falta = p.Importe - importeBanco;
        var msg = $"¿Lo tomo como pago a {p.ProveedorNombre} por {Plata0(importeBanco)} (lo que salió del banco el {p.BancoFecha:dd/MM})?"
            + (falta > 0.005m ? $"\n\nQueda pendiente {Plata0(falta)} para hoy." : "");
        if (!await JS.InvokeAsync<bool>("confirm", msg)) return;
        var (ok, error) = await Api.TomarPagoProgramadoDelBancoAsync(p.Id, movId);
        if (!ok) { ToastService.Error(error ?? "No se pudo"); return; }
        ToastService.Success("Pago cargado con la transferencia del banco");
        await CargarProgramados();
    }

    private async Task QuitarMensual(bool todos)
    {
        if (quitando is null) return;
        var ok = todos ? await Api.AnularPagoProgramadoTodosAsync(quitando.Id) : await Api.AnularPagoProgramadoAsync(quitando.Id);
        quitando = null;
        if (ok) await CargarProgramados(); else ToastService.Error("No se pudo sacar");
    }

    private async Task Cargar()
    {
        try { lista = await Api.GetCtaCteProveedoresAsync(); }
        catch (Exception ex) { lista = new(); ToastService.Error("No se pudo cargar: " + ex.Message); }
    }

    private async Task CargarProgramados()
    {
        try { programados = await Api.GetPagosProgramadosAsync(); }
        catch { programados = new(); }
        try { pagadosRecien = await Api.GetPagosProgramadosRecienPagadosAsync(7); }
        catch { pagadosRecien = new(); }
    }

    private void AbrirProgramar(int? proveedorId) { programarProveedorId = proveedorId; programando = true; }

    private async Task Programado() { programando = false; await CargarProgramados(); }

    /// <summary>Abre el Nuevo pago de siempre ya completo; al guardarlo, el programado queda pagado.</summary>
    private void Pagar(ApiClient.PagoProgramadoDto p) => Nav.NavigateTo($"/cafe/tesoreria/pagos?programado={p.Id}");

    private void AbrirEditar(ApiClient.PagoProgramadoDto p)
    {
        editando = p; edFecha = p.Fecha.Date; edImporte = p.Importe; edMedio = p.Medio; edNota = p.Nota;
    }

    private async Task GuardarEdicion()
    {
        if (editando is null) return;
        try
        {
            if (!await Api.EditarPagoProgramadoAsync(editando.Id, edFecha, edImporte, edMedio, edNota)) { ToastService.Error("No se pudo guardar"); return; }
            editando = null;
            await CargarProgramados();
        }
        catch (Exception ex) { ToastService.Error(ex.Message); }
    }

    private async Task Quitar(ApiClient.PagoProgramadoDto p)
    {
        if (p.DiaMes.HasValue) { quitando = p; return; }
        if (!await JS.InvokeAsync<bool>("confirm", $"¿Sacar de la lista el pago a {p.ProveedorNombre} del {FechaPalabras.Corta(p.Fecha)} por {Plata0(p.Importe)}? No toca ningún pago hecho."))
            return;
        if (await Api.AnularPagoProgramadoAsync(p.Id)) await CargarProgramados();
        else ToastService.Error("No se pudo sacar");
    }

    private static string MedioTexto(string m) => m switch { "ECHEQ" => "e-cheq", "EFECTIVO" => "efectivo", _ => "transferencia" };
    private static string Plata0(decimal v) => "$" + v.ToString("N0", CultureInfo.GetCultureInfo("es-AR"));

    private void AbrirAgregar()
    {
        busqueda = ""; candidatos = new(); elegido = null;
        desde = DateTimeExt.AhoraAr().Date; saldoOficial = 0; saldoNoOficial = 0;
        agregando = true;
    }

    private void CerrarAgregar() { if (!guardando) agregando = false; }

    private async Task Buscar()
    {
        var q = busqueda.Trim();
        var nro = ++busquedaNro;
        if (q.Length < 2) { candidatos = new(); buscando = false; return; }
        buscando = true;
        try
        {
            var r = await Api.BuscarCtaCteCandidatosAsync(q);
            if (nro == busquedaNro) candidatos = r;   // si tipeó más mientras tanto, gana la última búsqueda
        }
        catch { if (nro == busquedaNro) candidatos = new(); }
        finally { if (nro == busquedaNro) buscando = false; }
    }

    private void Elegir(CtaCteCandidatoDto c)
    {
        if (c.YaLleva && c.ProveedorId.HasValue)
        {
            Nav.NavigateTo($"/cafe/proveedores/{c.ProveedorId}/estado-cuenta");
            return;
        }
        elegido = c;
    }

    private async Task Guardar()
    {
        if (elegido is null) return;
        guardando = true;
        try
        {
            var id = await Api.ActivarCtaCteProveedorAsync(elegido.ProveedorId, elegido.Cuit, elegido.Nombre, desde, saldoOficial, saldoNoOficial);
            if (id <= 0) { ToastService.Error("No se pudo guardar"); return; }
            ToastService.Success($"{elegido.Nombre} ya lleva cuenta corriente");
            agregando = false;
            Nav.NavigateTo($"/cafe/proveedores/{id}/estado-cuenta");
        }
        catch (Exception ex) { ToastService.Error(ex.Message); }
        finally { guardando = false; }
    }

    private static string Plata(decimal v) => "$" + v.ToString("N2", CultureInfo.GetCultureInfo("es-AR"));
}
