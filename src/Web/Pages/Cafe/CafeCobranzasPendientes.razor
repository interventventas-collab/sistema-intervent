    // ─── 2026-09-26: redirigidas por WhatsApp ───
    private async Task IrACobrarRedi(RediPendienteDto r)
    {
        if (r.ClienteId is int cli)
        {
            Navigation.NavigateTo($"/cafe/tesoreria/cobranzas?cliente={cli}&rediPendienteId={r.Id}");
            return;
        }
        // El cliente vino escrito con palabras: primero se elige el de verdad.
        rediEligiendo = rediEligiendo == r.Id ? null : r.Id;
        rediBusq = r.ClienteTexto ?? "";   // en la versión simple viene vacío: se busca leyendo el mensaje
        clientesRedi ??= await Api.GetCafeClientesAsync() ?? new();
    }

    private void ElegirClienteRedi(RediPendienteDto r, int clienteId)
        => Navigation.NavigateTo($"/cafe/tesoreria/cobranzas?cliente={clienteId}&rediPendienteId={r.Id}");

    private List<CafeClienteDto> OpcionesClienteRedi
    {
        get
        {
            var q = (rediBusq ?? "").Trim();
            if (q.Length < 2 || clientesRedi is null) return new();
            return clientesRedi.Where(c => c.Nombre.Contains(q, StringComparison.OrdinalIgnoreCase))
                .OrderBy(c => c.Nombre.StartsWith(q, StringComparison.OrdinalIgnoreCase) ? 0 : 1).ThenBy(c => c.Nombre)
                .Take(8).ToList();
        }
    }

    private void PedirRechazarRedi(RediPendienteDto r)
    {
        rechazarTarget = new RechazoTarget(false, r.Id, r.Importe, r.ClienteNombre ?? $"«{r.ClienteTexto}»", $"redirigida de {r.EnviadoPor}", EsRedi: true);
        rechazarMotivo = "";
    }

    private async Task RestaurarRedi(RediPendienteDto r)
    {
        procesando = true;
        try
        {
            if (await Api.RestaurarRediPendienteAsync(r.Id)) { ToastService.Success("Restaurada — volvió a Pendientes"); await Recargar(); }
            else ToastService.Error("No se pudo restaurar");
        }
        finally { procesando = false; }
    }

    private async Task RestaurarAlq(AlqCobranzaPendienteDto a)
    {
        procesando = true;
        try
        {
            var ok = await Api.RestaurarAlqCobranzaAsync(a.Id, Operator.Current);
            if (ok) { ToastService.Success("Restaurada — volvió a Pendientes"); await Recargar(); }
            else ToastService.Error("No se pudo restaurar");
        }
        catch (Exception ex) { ToastService.Error("Error: " + ex.Message); }
        finally { procesando = false; }
    }

    private void PedirAnularAlq(AlqCobranzaPendienteDto a) { anularAlqTarget = a; anularPassword = ""; anularError = null; }

    private async Task ConfirmarAnularAlq()
    {
        if (anularAlqTarget is null || string.IsNullOrWhiteSpace(anularPassword)) return;
        procesando = true; anularError = null;
        try
        {
            var (ok, error) = await Api.AnularAlqCobranzaAsync(anularAlqTarget.Id, anularPassword, Operator.Current);
            if (ok)
            {
                ToastService.Success($"Cobro anulado — volvió el saldo a {anularAlqTarget.ReservaNumero}");
                anularAlqTarget = null; anularPassword = "";
                await Recargar();
            }
            else anularError = error ?? "No se pudo anular";
        }
        finally { procesando = false; }
    }

    private async Task ConfirmarRechazar()
    {
        if (rechazarTarget is null) return;
        procesando = true;
        try
        {
            var ok = rechazarTarget.EsRedi
                ? await Api.RechazarRediPendienteAsync(rechazarTarget.Id, rechazarMotivo, Operator.Current)
                : rechazarTarget.EsAlquiler
                ? await Api.RechazarAlqCobranzaAsync(rechazarTarget.Id, rechazarMotivo, Operator.Current)
                : await Api.RechazarCobranzaPendienteAsync(rechazarTarget.Id,
                    new RechazarCobranzaPendienteRequest { Motivo = rechazarMotivo, Operador = Operator.Current });
            if (ok) { ToastService.Info("Rechazada"); rechazarTarget = null; await Recargar(); }
            else ToastService.Error("No se pudo rechazar");
        }
        catch (Exception ex) { ToastService.Error("Error: " + ex.Message); }
        finally { procesando = false; }
    }

    private async Task Restaurar(CobranzaPendienteDto c)
    {
        procesando = true;
        try
        {
            var ok = await Api.RestaurarCobranzaPendienteAsync(c.Id, Operator.Current);
            if (ok) { ToastService.Success("Restaurada — volvió a Pendientes"); await Recargar(); }
            else ToastService.Error("No se pudo restaurar");
        }
        catch (Exception ex) { ToastService.Error("Error: " + ex.Message); }
        finally { procesando = false; }
    }
