        finally { descargando = false; }
    }

    [Inject] private IJSRuntime JS { get; set; } = null!;

    /// <summary>Te lleva al modal de Nueva Cobranza con cliente + efectivo + importe precargados.
    /// Vos elegís a qué venta(s) imputar. Al guardar, se vincula la pendiente automáticamente.</summary>
    private void IrACobrar(CobranzaPendienteDto c)
    {
        if (c.ClienteId is null)
        {
            ToastService.Error("La venta no tiene cliente asociado, no se puede cobrar");
            return;
        }
        Navigation.NavigateTo($"/cafe/tesoreria/cobranzas?cliente={c.ClienteId.Value}&pendienteId={c.Id}");
    }

    private void PedirRechazar(CobranzaPendienteDto c)
    {
        rechazarTarget = new RechazoTarget(false, c.Id, c.Importe, c.VentaNumero, c.RepartidorNombre);
        rechazarMotivo = "";
    }

    private void PedirRechazarAlq(AlqCobranzaPendienteDto a)
    {
        rechazarTarget = new RechazoTarget(true, a.Id, a.Importe, a.ReservaNumero, a.RepartidorNombre);
        rechazarMotivo = "";
    }

    /// <summary>2026-09-14: igual que el de ventas, pero con la reserva tildada. Al guardar la cobranza
    /// este cobro queda aprobado y atado al recibo.</summary>
    private void IrACobrarAlq(AlqCobranzaPendienteDto a)
    {
        if (a.ClienteId is null)
        {
            ToastService.Error("La reserva no tiene cliente asociado, no se puede cobrar");
            return;
        }
        Navigation.NavigateTo($"/cafe/tesoreria/cobranzas?cliente={a.ClienteId.Value}&alqPendienteId={a.Id}");
