@page "/subir-foto-producto/{token}"
@attribute [AllowAnonymous]
@layout Web.Layout.EmptyLayout
@inject HttpClient Http
@using System.Net.Http.Headers
@using Microsoft.AspNetCore.Components.Forms

@* 2026-08-05 (Paso 3): el celu del depósito abre esto escaneando el QR (sin login). Saca una foto
   o elige una de la galería y la sube como FOTO PROPIA del producto (no toca la de MercadoLibre). *@

<style>
    body { background: #0f172a; }
    .sf-wrap { max-width: 560px; margin: 0 auto; padding: 1rem 0.9rem 3rem; color: #e2e8f0; font-family: system-ui, sans-serif; }
    .sf-title { font-size: 1.35rem; font-weight: 800; color: #fff; text-align:center; margin-top:0.5rem; }
    .sf-prod { background:#1e293b; border-radius:14px; padding:0.9rem 1rem; margin:1rem 0; text-align:center; }
    .sf-prod-nombre { font-size:1.1rem; font-weight:700; color:#fff; }
    .sf-prod-sku { font-size:0.8rem; color:#94a3b8; font-family:monospace; margin-top:0.2rem; }
    .sf-btn {
        display:flex; align-items:center; justify-content:center; gap:0.5rem; width:100%;
        padding:1rem; margin:0.6rem 0; border:none; border-radius:14px; font-size:1.1rem;
        font-weight:700; cursor:pointer; color:#fff;
    }
    .sf-btn.cam { background:#22c55e; }
    .sf-btn.gal { background:#3b82f6; }
    .sf-btn:disabled { opacity:0.5; }
    .sf-hint { font-size:0.85rem; color:#94a3b8; text-align:center; margin-top:0.4rem; }
    .sf-preview { width:100%; border-radius:14px; margin:0.8rem 0; border:2px solid #334155; }
    .sf-ok { background:#14321f; border:2px solid #22c55e; border-radius:14px; padding:1.4rem; text-align:center; margin-top:1rem; }
    .sf-ok-emoji { font-size:3rem; }
    .sf-ok-txt { font-size:1.15rem; font-weight:700; color:#bbf7d0; margin-top:0.5rem; }
    .sf-err { background:#3f1d1d; border:2px solid #ef4444; border-radius:14px; padding:1.2rem; text-align:center; color:#fecaca; }
</style>

<div class="sf-wrap">
    <div class="sf-title">📷 Foto del producto</div>

    @if (cargando)
    {
        <p class="sf-hint">Cargando…</p>
    }
    else if (!ok)
    {
        <div class="sf-err">
            @(motivo switch {
                "vencido" => "⏳ Este link venció. Pedí uno nuevo desde la computadora.",
                "no_existe" => "❌ Link inválido.",
                _ => "❌ No se pudo abrir. Pedí un link nuevo desde la computadora."
            })
        </div>
    }
    else if (subida)
    {
        <div class="sf-ok">
            <div class="sf-ok-emoji">✅</div>
            <div class="sf-ok-txt">¡Foto subida!</div>
            <div class="sf-hint">Ya podés volver a la computadora. La foto aparece sola en el tablero.</div>
        </div>
    }
    else
    {
        <div class="sf-prod">
            <div class="sf-prod-nombre">@productoNombre</div>
            @if (!string.IsNullOrEmpty(sku))
            {
                <div class="sf-prod-sku">@sku</div>
            }
            @if (yaTiene)
            {
                <div class="sf-hint" style="margin-top:0.5rem;">Este producto ya tiene una foto propia. Si subís otra, la reemplaza.</div>
            }
        </div>

        @if (!string.IsNullOrEmpty(previewUrl))
        {
            <img class="sf-preview" src="@previewUrl" alt="Vista previa" />
        }

        @if (subiendo)
        {
            <p class="sf-hint">⏳ Subiendo la foto…</p>
        }
        else
        {
            <label class="sf-btn cam">
                📷 Sacar una foto
                <InputFile OnChange="OnFoto" accept="image/*" capture="environment" style="display:none" />
            </label>
            <label class="sf-btn gal">
                🖼️ Elegir de la galería
                <InputFile OnChange="OnFoto" accept="image/*" style="display:none" />
            </label>
            <div class="sf-hint">Sacá la foto del producto (o elegí una que ya tengas). Se sube al instante.</div>
        }

        @if (!string.IsNullOrEmpty(errorMsg))
        {
            <div class="sf-err" style="margin-top:0.8rem;">@errorMsg</div>
        }
    }
</div>

@code {
    [Parameter] public string Token { get; set; } = "";

    private bool cargando = true;
    private bool ok;
    private string? motivo;
    private string? productoNombre;
    private string? sku;
    private bool yaTiene;

    private bool subiendo;
    private bool subida;
    private string? previewUrl;
    private string? errorMsg;

    private record InfoResp(bool Ok, string? ProductoNombre, string? Sku, bool YaSubida, string? FotoUrl, string? Motivo);

    protected override async Task OnInitializedAsync()
    {
        try
        {
            var info = await Http.GetFromJsonAsync<InfoResp>($"api/public/producto-foto/{Uri.EscapeDataString(Token)}");
            if (info is not null && info.Ok)
            {
                ok = true;
                productoNombre = info.ProductoNombre;
                sku = info.Sku;
                yaTiene = info.YaSubida;
            }
            else { ok = false; motivo = info?.Motivo; }
        }
        catch { ok = false; motivo = "error"; }
        finally { cargando = false; }
    }

    private async Task OnFoto(InputFileChangeEventArgs e)
    {
        var file = e.File;
        if (file is null || subiendo) return;
        const long max = 10L * 1024 * 1024;
        if (file.Size > max) { errorMsg = "La foto es muy grande (máx 10 MB)."; return; }

        errorMsg = null;
        subiendo = true;
        StateHasChanged();
        try
        {
            using var stream = file.OpenReadStream(maxAllowedSize: max);
            var ms = new MemoryStream();
            await stream.CopyToAsync(ms);
            ms.Position = 0;

            // Vista previa local
            var bytes = ms.ToArray();
            previewUrl = $"data:{file.ContentType};base64,{Convert.ToBase64String(bytes)}";
            ms.Position = 0;

            using var content = new MultipartFormDataContent();
            var sc = new StreamContent(ms);
            sc.Headers.ContentType = new MediaTypeHeaderValue(string.IsNullOrEmpty(file.ContentType) ? "image/jpeg" : file.ContentType);
            content.Add(sc, "file", file.Name);

            var resp = await Http.PostAsync($"api/public/producto-foto/{Uri.EscapeDataString(Token)}", content);
            if (resp.IsSuccessStatusCode)
            {
                subida = true;
            }
            else
            {
                errorMsg = "No se pudo subir. Probá de nuevo o pedí un link nuevo desde la compu.";
            }
        }
        catch (Exception ex)
        {
            errorMsg = "No se pudo subir la foto: " + ex.Message;
        }
        finally
        {
            subiendo = false;
            StateHasChanged();
        }
    }
}
