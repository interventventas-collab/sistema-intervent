    private static string Titulo(PlanoElementoDto e)
        => !string.IsNullOrWhiteSpace(e.Nombre) ? e.Nombre!
         : e.Tipo == "rack" ? $"Rack {e.Codigo}"
         : NombreTipo(e.Tipo);

    public async ValueTask DisposeAsync()
    {
        ctsBusca?.Cancel();
        if (jsListo) { try { await JS.InvokeVoidAsync("planoDeposito.dispose", svgRef); } catch { } }
        refJs?.Dispose();
    }
