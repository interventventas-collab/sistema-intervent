@inject ApiClient Api
@inject NavigationManager Nav

@* 2026-11-26: planito emergente con dónde está un estante (ej. "B1-1-2"). Se abre al tocar la
   ubicación de un producto (LugarProducto). Arriba el pedazo del plano donde está el rack, con el
   rack pintado en naranja; abajo la vista de frente del rack con el estante marcado.
   Solo mira: para editar está "Abrir el plano completo". *@

<style>
    .pe-fondo { position: fixed; inset: 0; background: rgba(15,23,42,0.45); z-index: 3000; display: flex; align-items: center; justify-content: center; padding: 1rem; }
    .pe-caja { background: #fff; border-radius: 14px; width: min(720px, 100%); max-height: 92vh; overflow: auto; box-shadow: 0 20px 50px rgba(0,0,0,0.3); padding: 1rem 1.1rem 1.1rem; cursor: default; text-align: left; }
    .pe-arriba { display: flex; align-items: flex-start; gap: 0.6rem; }
    .pe-cod { font-family: monospace; font-size: 1.9rem; font-weight: 900; color: #78350f; line-height: 1.05; }
    .pe-sub { color: #4b5563; font-size: 0.92rem; }
    .pe-x { margin-left: auto; border: 1px solid #e5e7eb; background: #fff; border-radius: 10px; width: 38px; height: 38px; font-size: 1rem; color: #6b7280; cursor: pointer; flex-shrink: 0; }
    .pe-lbl { font-size: 0.72rem; font-weight: 700; color: #6b7280; text-transform: uppercase; letter-spacing: 0.04em; margin: 0.9rem 0 0.35rem; }
    .pe-svg { width: 100%; display: block; border: 1px solid #e5e7eb; border-radius: 10px; background: #fafafa; }
    .pe-frente { display: flex; gap: 1rem; align-items: flex-end; flex-wrap: wrap; }
    .pe-frente svg { max-width: 100%; }
    .pe-prods { font-size: 0.85rem; color: #374151; flex: 1; min-width: 180px; }
    .pe-prods div { padding: 2px 0; }
    .pe-link { display: inline-block; margin-top: 0.9rem; font-weight: 700; color: #1d4ed8; text-decoration: none; font-size: 0.9rem; }
    .pe-gris { color: #6b7280; font-size: 0.9rem; padding: 1rem 0; }
    @@keyframes pe-tit { 0%,100% { opacity: 1; } 50% { opacity: 0.45; } }
    .pe-tit { animation: pe-tit 1.2s ease-in-out infinite; }
</style>

<div class="pe-fondo" @onclick="Cerrar" @onclick:stopPropagation="true">
    <div class="pe-caja" @onclick:stopPropagation="true">
        <div class="pe-arriba">
            <div>
                <div class="pe-cod">@Codigo</div>
                @if (est is not null)
                {
                    <div class="pe-sub">Rack @est.Rack · posición @est.Posicion · nivel @est.Nivel @(est.Nivel == 1 ? "(el piso)" : "desde el piso")@(est.Planta == "P1" ? " · planta alta" : " · planta baja")</div>
                }
            </div>
            <button type="button" class="pe-x" @onclick="Cerrar" title="Cerrar">✕</button>
        </div>

        @if (cargando)
        {
            <div class="pe-gris">Cargando el plano…</div>
        }
        else if (est is null || rack is null)
        {
            <div class="pe-gris">No encontré este estante en el plano. Puede que el rack se haya borrado o cambiado de código.</div>
        }
        else
        {
            var (vx, vy, vw, vh, zonaNom) = Encuadre();
            <div class="pe-lbl">Dónde está@(zonaNom is null ? "" : " · " + zonaNom) <span style="text-transform:none; font-weight:400;">(la calle queda a la izquierda)</span></div>
            <PlanoDibujo Elementos="elementos" Vista="(vx, vy, vw, vh)" RackMarcado="est.RackId" Clase="pe-svg"
                         Estilo="@($"aspect-ratio:{F(vw)} / {F(vh)}; max-height:46vh;")" />

            var pos = Math.Max(1, rack.Posiciones ?? 1);
            var niv = Math.Max(1, rack.Niveles ?? 1);
            const int CW = 74, CH = 34, M = 26;
            var w = M + pos * CW + 6; var h = niv * CH + 26;
            <div class="pe-lbl">Rack @rack.Codigo de frente</div>
            <div class="pe-frente">
                <svg width="@w" height="@h" viewBox="0 0 @w @h" xmlns="http://www.w3.org/2000/svg">
                    @for (var n = 1; n <= niv; n++)
                    {
                        var y = (niv - n) * CH + 4;
                        <g><text x="@(M - 6)" y="@(y + CH / 2 + 4)" font-size="11" text-anchor="end" fill="#6b7280">@n</text></g>
                        @for (var p = 1; p <= pos; p++)
                        {
                            var x = M + (p - 1) * CW;
                            var marcado = p == est.Posicion && n == est.Nivel;
                            <rect class="@(marcado ? "pe-tit" : null)" x="@x" y="@y" width="@(CW - 4)" height="@(CH - 4)" rx="4"
                                  fill="@(marcado ? "#f97316" : "#fef3c7")" stroke="@(marcado ? "#9a3412" : "#d6b35a")" stroke-width="1.2" />
                            <g><text x="@(x + (CW - 4) / 2)" y="@(y + (CH - 4) / 2 + 4)" font-size="11" font-weight="@(marcado ? "800" : "400")" text-anchor="middle"
                                  fill="@(marcado ? "#fff" : "#92400e")" font-family="monospace">@($"{rack.Codigo}-{p}-{n}")</text></g>
                        }
                    }
                    <line x1="@(M - 2)" y1="@(niv * CH + 2)" x2="@(w - 4)" y2="@(niv * CH + 2)" stroke="#374151" stroke-width="2" />
                    <text x="@M" y="@(h - 4)" font-size="10" fill="#6b7280">piso · posición 1 = punta de la calle</text>
                </svg>
                @if (est.Productos.Count > 0)
                {
                    <div class="pe-prods">
                        <div style="font-weight:700; color:#6b7280; font-size:0.72rem; text-transform:uppercase;">En este estante</div>
                        @foreach (var a in est.Productos)
                        {
                            <div><span style="font-family:monospace; color:#6b7280;">@a.Sku</span> @a.Nombre@(string.IsNullOrWhiteSpace(a.Cantidad) ? "" : " · " + a.Cantidad)</div>
                        }
                    </div>
                }
            </div>
            <a class="pe-link" href="/deposito/plano?estante=@Uri.EscapeDataString(Codigo)" @onclick="Cerrar">🗺 Abrir el plano completo</a>
        }
    </div>
</div>

@code {
    [Parameter, EditorRequired] public string Codigo { get; set; } = "";
    [Parameter] public EventCallback OnCerrar { get; set; }

    private bool cargando = true;
    private PlanoEstanteDetalleDto? est;
    private PlanoElementoDto? rack;
    private List<PlanoElementoDto> elementos = new();

    // el plano casi no cambia: se guarda un rato para que abrir varios sea instantáneo
    private static readonly Dictionary<string, (DateTime At, List<PlanoElementoDto> Els)> cache = new();

    protected override async Task OnInitializedAsync()
    {
        try
        {
            est = await Api.GetEstantePlanoAsync(Codigo);
            if (est is not null)
            {
                var planta = est.Planta ?? "PB";
                if (cache.TryGetValue(planta, out var c) && (DateTime.UtcNow - c.At).TotalMinutes < 5) elementos = c.Els;
                else
                {
                    elementos = (await Api.GetPlanoDepositoAsync(planta))?.Elementos ?? new();
                    cache[planta] = (DateTime.UtcNow, elementos);
                }
                rack = elementos.FirstOrDefault(x => x.Id == est.RackId);
            }
        }
        catch { est = null; }
        cargando = false;
    }

    private Task Cerrar() => OnCerrar.InvokeAsync();

    /// <summary>Pedazo del plano a mostrar: el ambiente (zona) donde está el rack, con un margen.</summary>
    private (double, double, double, double, string?) Encuadre()
    {
        var zona = PlanoDibujo.ZonaDe(rack!, elementos);
        const double m = 0.8;
        if (zona is null) { var (x, y, w, h) = PlanoDibujo.Todo(elementos, m); return (x, y, w, h, null); }
        var b = PlanoDibujo.RectDe(zona, PlanoDibujo.AnchoTerreno(elementos));
        return (b.X - m, b.Y - m, b.W + 2 * m, b.H + 2 * m, zona.Nombre);
    }

    private static string F(double v) => v.ToString("0.###", System.Globalization.CultureInfo.InvariantCulture);
}
