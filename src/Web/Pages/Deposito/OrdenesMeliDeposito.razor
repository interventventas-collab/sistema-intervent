@page "/deposito/ordenes-meli"
@attribute [Authorize]
@implements IDisposable
@inject ApiClient Api
@inject ToastService ToastService
@inject NavigationManager Nav
@inject IJSRuntime JS

@* 2026-09-21: página aparte para el depósito (antes el escaneo vivía adentro del armado de pedidos).
   SIN PLATA a propósito.
   2026-09-24: pedido del dueño: la lista ocupa TODO el ancho y cada renglón trae TODO lo que antes
   estaba en la ficha de la derecha (producto con SKU y contenido del combo, mensajes, preguntas,
   compras anteriores), más las NOTAS de la venta en MeLi y nuestros POST-ITS. Ya no hay panel a la
   derecha ni Anterior/Siguiente. El detalle de cada renglón se trae de a poco (4 a la vez) porque
   mensajes y notas se le piden a MeLi en vivo. Tocar una foto la muestra en grande. *@

<style>
    .om-top { display: flex; align-items: center; gap: 0.75rem; flex-wrap: wrap; margin-bottom: 0.9rem; }
    .om-top h2 { margin: 0; font-size: 1.3rem; }
    .om-scan { display: flex; gap: 0.5rem; margin-bottom: 0.35rem; }
    .om-scan input { flex: 1; min-width: 0; font-size: 1.05rem; padding: 0.6rem 0.8rem; border: 2px solid #3b82f6; border-radius: 10px; }
    .om-scan input:focus { outline: none; box-shadow: 0 0 0 3px rgba(59,130,246,0.2); }
    .om-hint { font-size: 0.78rem; color: #64748b; margin-bottom: 1rem; }

    .om-filtros { display: flex; flex-direction: column; gap: 0.35rem; margin-bottom: 0.8rem; font-size: 0.85rem; }
    .om-filtro { display: flex; align-items: center; gap: 0.3rem; flex-wrap: wrap; }
    .om-filtro .lbl { color: #64748b; min-width: 58px; }
    .om-chip { border: 1px solid #e2e8f0; background: white; border-radius: 999px; padding: 0.2rem 0.7rem; cursor: pointer; font-size: 0.84rem; color: #334155; }
    .om-chip.on { background: #1e293b; border-color: #1e293b; color: white; font-weight: 600; }
    .om-buscar { width: 100%; max-width: 360px; padding: 0.35rem 0.6rem; border: 1px solid #e2e8f0; border-radius: 8px; font-size: 0.88rem; }
    .om-etiq { display: flex; align-items: center; gap: 0.3rem; flex-wrap: wrap; margin-bottom: 0.6rem; font-size: 0.85rem; }
    .om-etiq .lbl { color: #64748b; min-width: 58px; }
    .om-vacio { color: #64748b; font-size: 0.9rem; }
    .om-cancel { color: #b91c1c; }

    /* Un renglón = un envío con todo su detalle, a lo ancho. */
    .om-lista { border-top: 1px solid #e2e8f0; }
    .om-fila { display: grid; gap: 14px; padding: 0.8rem 0.4rem; border-bottom: 1px solid #e2e8f0; align-items: start; font-size: 0.86rem;
               grid-template-columns: 22px 52px minmax(280px, 1.4fr) repeat(4, minmax(170px, 1fr)) 124px;
               grid-template-areas: "tilde cuando prod msj preg comp notas impr"; }
    .om-fila.resaltada { background: #eff6ff; box-shadow: inset 3px 0 0 #3b82f6; }
    .om-fila .tilde { grid-area: tilde; padding-top: 0.1rem; }
    .om-fila .tilde input { width: 18px; height: 18px; cursor: pointer; }
    .om-fila .cuando { grid-area: cuando; font-size: 0.8rem; color: #64748b; line-height: 1.3; }
    .om-fila .c-prod { grid-area: prod; min-width: 0; }
    .om-fila .c-msj { grid-area: msj; }
    .om-fila .c-preg { grid-area: preg; }
    .om-fila .c-comp { grid-area: comp; }
    .om-fila .c-notas { grid-area: notas; }
    .om-fila .impr { grid-area: impr; display: flex; justify-content: center; }
    /* Pantallas más angostas: producto arriba, y abajo las 4 columnas de info. */
    @@media (max-width: 1350px) {
        .om-fila { grid-template-columns: 22px 52px repeat(2, minmax(0, 1fr)) 124px;
                   grid-template-areas: "tilde cuando prod prod impr" ". . msj preg ." ". . comp notas ."; }
    }
    @@media (max-width: 760px) {
        .om-fila { grid-template-columns: 22px minmax(0, 1fr) 110px;
                   grid-template-areas: "tilde cuando impr" "prod prod prod" "msj msj msj" "preg preg preg" "comp comp comp" "notas notas notas"; }
        .om-fila .cuando br { display: none; }
    }

    .om-quien { font-size: 0.84rem; color: #334155; margin-bottom: 0.3rem; }
    .om-quien b { color: #0f172a; }
    .om-prod { display: flex; gap: 0.7rem; align-items: flex-start; padding: 0.2rem 0; }
    .om-prod img, .om-prod .sinfoto { width: 110px; height: 110px; object-fit: contain; border-radius: 8px; border: 1px solid #e2e8f0; background: white; flex: 0 0 auto; }
    .om-prod img { cursor: zoom-in; }
    .om-prod .cant { font-size: 1.7rem; font-weight: 800; line-height: 1; }
    .om-prod .tit { font-size: 1rem; font-weight: 600; margin-top: 0.15rem; line-height: 1.3; }
    .om-prod .sku { font-family: monospace; font-size: 0.82rem; color: #475569; margin-top: 0.15rem; }
    .om-prod .combo { margin-top: 0.35rem; font-size: 0.85rem; }

    .om-zoom { position: fixed; inset: 0; background: rgba(15,23,42,0.85); display: flex; align-items: center; justify-content: center; z-index: 2000; cursor: zoom-out; padding: 16px; }
    .om-zoom img { max-width: 100%; max-height: 100%; object-fit: contain; background: white; border-radius: 10px; }
</style>

<div class="om-top">
    <a class="btn btn-secondary" href="/cafe/preparacion">← Volver al armado</a>
    <h2>🏷️ Órdenes MeLi</h2>
</div>

<div class="om-scan">
    <input @ref="scanRef" @bind="scanInput" @bind:event="oninput" @onkeydown="OnScanKey" disabled="@escaneando"
           placeholder="Apoyá el cursor acá y disparás el lector (Flex o Correo)…" autocomplete="off" />
    <button class="btn btn-secondary" @onclick="Escanear" disabled="@escaneando">@(escaneando ? "Buscando…" : "🔍 Buscar")</button>
</div>
<div class="om-hint">Con el lector: apoyá el cursor en la casilla y disparás la etiqueta. También podés tipear el nº de envío o de venta y apretar Enter. El envío escaneado queda marcado en azul.</div>

<div class="om-filtros">
    <div class="om-filtro">
        <span class="lbl">Fecha</span>
        @foreach (var (d, l) in OpcionesDias)
        {
            <button class="om-chip @(dias == d ? "on" : "")" @onclick="() => CambiarDias(d)">@l</button>
        }
    </div>
    @if (cuentas.Count > 1)
    {
        <div class="om-filtro">
            <span class="lbl">Cuenta</span>
            <button class="om-chip @(cuenta is null ? "on" : "")" @onclick="() => CambiarCuenta(null)">Todas</button>
            @foreach (var c in cuentas)
            {
                <button class="om-chip @(cuenta == c.Id ? "on" : "")" @onclick="() => CambiarCuenta(c.Id)">@c.Nombre</button>
            }
        </div>
    }
    <div class="om-filtro">
        <span class="lbl">Envío</span>
        @foreach (var (k, l) in OpcionesEnvio)
        {
            <button class="om-chip @(envio == k ? "on" : "")" @onclick="() => envio = k">@l</button>
        }
    </div>
    <div class="om-filtro">
        <span class="lbl">Estado</span>
        @foreach (var (k, l) in OpcionesEstado)
        {
            <button class="om-chip @(estado == k ? "on" : "")" @onclick="() => estado = k">@l</button>
        }
    </div>
    <div class="om-filtro">
        <span class="lbl">Buscar</span>
        <input class="om-buscar" @bind="buscar" @bind:event="oninput" placeholder="comprador, producto o nº de venta" />
    </div>
</div>

@* 2026-09-24: imprimir etiquetas MeLi desde el deposito (mismo endpoint que Ordenes). *@
<div class="om-etiq">
    <span class="lbl">Etiqueta</span>
    @foreach (var (k, l, t) in FormatosEtiqueta)
    {
        <button class="om-chip @(etiquetaFormato == k ? "on" : "")" title="@t" @onclick="() => ElegirFormato(k)">@l</button>
    }
    @if (tildadas.Count > 0)
    {
        <button class="btn btn-primary btn-sm" @onclick="ImprimirTildadas">🖨️ Imprimir @tildadas.Count</button>
        <button class="btn btn-secondary btn-sm" @onclick="() => tildadas.Clear()">Destildar</button>
    }
    else if (ParaImprimir.Count > 0)
    {
        <button class="btn btn-secondary btn-sm" @onclick="TildarSinImprimir">Tildar las @ParaImprimir.Count sin imprimir</button>
    }
</div>

@if (escaneadaFuera is not null)
{
    <div class="om-vacio" style="margin-bottom:0.3rem;">Escaneado (no está en la lista con estos filtros):</div>
    <div class="om-lista" style="margin-bottom:1rem;">
        @Fila(OrdenDeFicha(escaneadaFuera))
    </div>
}

@if (cargando && ordenes.Count == 0)
{
    <div class="om-vacio">Cargando órdenes…</div>
}
else if (Filtradas.Count == 0)
{
    <div class="om-vacio">No hay órdenes con esos filtros.</div>
}
else
{
    <div class="om-vacio" style="margin-bottom:0.3rem;">
        @Filtradas.Count @(Filtradas.Count == 1 ? "envío" : "envíos") · tocá una foto para verla en grande
        @if (cargandoDetalles) { <span> · trayendo mensajes y notas de MeLi…</span> }
    </div>
    <div class="om-lista">
        @foreach (var o in Filtradas)
        {
            @Fila(o)
        }
    </div>
}

@if (!string.IsNullOrEmpty(zoomFoto))
{
    <div class="om-zoom" @onclick="() => zoomFoto = null"><img src="@zoomFoto" alt="" /></div>
}

@code {
    /// <summary>Un renglón: datos del listado (siempre) + detalle de la ficha (cuando llega).</summary>
    private RenderFragment Fila(MeliDepoOrden o) => __builder =>
    {
        fichas.TryGetValue(o.Numero, out var f);
        var puedeImprimir = o.NumeroEnvio.HasValue && o.EstadoClave != "cancelada";
        <div class="om-fila @(resaltada == o.Numero ? "resaltada" : "")" id="@($"fila-{o.Numero}")">
            <div class="tilde">
                @if (puedeImprimir)
                {
                    <input type="checkbox" checked="@tildadas.Contains(o.NumeroEnvio!.Value)"
                           @onchange="() => Tildar(o.NumeroEnvio!.Value)" title="Tildar para imprimir varias juntas" />
                }
            </div>
            @* la fecha de la venta YA viene en hora argentina: no convertir *@
            <div class="cuando">@o.Fecha.ToString("dd/MM")<br />@o.Fecha.ToString("HH:mm")</div>

            <div class="c-prod">
                <div class="om-quien">
                    <b>@o.Comprador</b> · @o.Tipo
                    @if (!string.IsNullOrEmpty(o.Cuenta)) { <text> · @o.Cuenta</text> }
                    · <span class="@(o.EstadoClave == "cancelada" ? "om-cancel" : "")">@o.Estado</span>
                    @if (o.NumeroVenta > 0) { <text> · venta @o.NumeroVenta</text> }
                </div>
                @if (f is not null && f.Productos.Count > 0)
                {
                    @foreach (var p in f.Productos)
                    {
                        <div class="om-prod">
                            @if (!string.IsNullOrEmpty(p.Foto)) { <img src="@p.Foto" alt="" loading="lazy" title="Ver la foto en grande" @onclick="() => zoomFoto = p.Foto" /> }
                            else { <span class="sinfoto"></span> }
                            <div>
                                <div class="cant">×@p.Cantidad</div>
                                <div class="tit">@p.Titulo</div>
                                @if (!string.IsNullOrEmpty(p.Sku)) { <div class="sku">@p.Sku</div> }
                                @* 2026-09-24: dónde está en el depósito. Producto suelto: su lugar (editable);
                                   combo: el lugar va en cada pieza de abajo. *@
                                @if (!p.EsCombo && p.Componentes.Count == 1)
                                {
                                    var c1 = p.Componentes[0];
                                    <div><LugarProducto ProductoId="c1.ProductoId" Lugar="@c1.Lugar" Dudoso="c1.LugarDudoso" Editable="true" PermitirCambiar="true"
                                                        OnCambio="() => TraerDetalleYRedibujar(o.Numero)" /></div>
                                }
                                else if (!p.EsCombo && !string.IsNullOrEmpty(p.Lugar))
                                {
                                    <div><LugarProducto Lugar="@p.Lugar" Dudoso="p.LugarDudoso" /></div>
                                }
                                @if (p.EsCombo && p.Componentes.Count > 0)
                                {
                                    <div class="combo">
                                        <div class="om-h">Contiene</div>
                                        @foreach (var c in p.Componentes)
                                        {
                                            <div>
                                                <b>×@FmtCant(c.Cantidad)</b> @c.Nombre
                                                @if (!string.IsNullOrEmpty(c.Formato) && c.Formato != "UNIT") { <text> · @c.Formato</text> }
                                                @if (!string.IsNullOrEmpty(c.Sku)) { <span class="sku"> (@c.Sku)</span> }
                                                <text> </text><LugarProducto ProductoId="c.ProductoId" Lugar="@c.Lugar" Dudoso="c.LugarDudoso" Editable="true" PermitirCambiar="true"
                                                                             OnCambio="() => TraerDetalleYRedibujar(o.Numero)" />
                                            </div>
                                        }
                                    </div>
                                }
                            </div>
                        </div>
                    }
                }
                else
                {
                    @foreach (var p in o.Productos)
                    {
                        <div class="om-prod">
                            @if (!string.IsNullOrEmpty(p.Foto)) { <img src="@p.Foto" alt="" loading="lazy" title="Ver la foto en grande" @onclick="() => zoomFoto = p.Foto" /> }
                            else { <span class="sinfoto"></span> }
                            <div>
                                <div class="cant">×@p.Cantidad</div><div class="tit">@p.Titulo</div>
                                @if (!string.IsNullOrEmpty(p.Lugar)) { <div><LugarProducto Lugar="@p.Lugar" Dudoso="p.LugarDudoso" /></div> }
                            </div>
                        </div>
                    }
                }
            </div>

            @if (f is null)
            {
                <div class="c-msj om-gris">
                    @if (fallidas.Contains(o.Numero))
                    {
                        <span class="om-alerta">No pude traer el detalle.</span>
                        <button class="om-mas" @onclick="() => Reintentar(o.Numero)">Probar de nuevo</button>
                    }
                    else
                    {
                        <span>Trayendo mensajes, preguntas y notas…</span>
                    }
                </div>
            }
            else
            {
                <DetalleEnvioMeli Ficha="f" Numero="o.Numero" />
            }

            <div class="impr">
                @if (puedeImprimir)
                {
                    <BotonEtiquetaMeli Impresa="@o.EtiquetaImpresa" ImpresaAt="@o.EtiquetaImpresaAt"
                                       Pendiente="@(o.EstadoClave == "despachar")" OnImprimir="() => Imprimir(o.NumeroEnvio!.Value)" />
                }
            </div>
        </div>
    };

    private static readonly (int, string)[] OpcionesDias = { (1, "Hoy"), (2, "Hoy y ayer"), (7, "7 días"), (30, "30 días") };
    private static readonly (string?, string)[] OpcionesEnvio = { (null, "Todos"), ("flex", "Flex"), ("correo", "Correo"), ("full", "Full") };
    private static readonly (string?, string)[] OpcionesEstado = { (null, "Todos"), ("despachar", "Para despachar"), ("camino", "En camino"), ("entregada", "Entregadas"), ("cancelada", "Canceladas") };

    // ── Etiquetas ── el formato elegido queda recordado en este navegador (cada depósito tiene su impresora).
    private static readonly (string, string, string)[] FormatosEtiqueta =
    {
        ("termica", "Térmica directa", "Imprime directo en la térmica (Zebra o HPRT), como MercadoLibre. Si esta compu no tiene el programa de la impresora, baja el archivo .txt"),
        ("termica-pdf", "Térmica PDF", "PDF con una etiqueta por página, para térmicas que no son Zebra"),
        ("a4-1", "A4 ×1", "Una etiqueta por hoja A4"),
        ("a4-3", "A4 ×3", "Tres etiquetas por hoja A4 acostada, como MercadoLibre"),
    };
    private const string ClaveFormato = "om-etiqueta-formato";
    private string etiquetaFormato = "a4-3";
    private readonly HashSet<long> tildadas = new();

    private List<long> ParaImprimir => Filtradas
        .Where(o => o.NumeroEnvio.HasValue && !o.EtiquetaImpresa && o.EstadoClave == "despachar")
        .Select(o => o.NumeroEnvio!.Value).Distinct().ToList();

    private async Task ElegirFormato(string f)
    {
        etiquetaFormato = f;
        try { await JS.InvokeVoidAsync("localStorage.setItem", ClaveFormato, f); } catch { }
    }

    private void Tildar(long envio) { if (!tildadas.Add(envio)) tildadas.Remove(envio); }
    private void TildarSinImprimir() { foreach (var e in ParaImprimir) tildadas.Add(e); }

    private async Task Imprimir(long envio)
    {
        await AbrirEtiqueta(Api.BuildEtiquetaMeliUrl(new[] { envio }, etiquetaFormato));
        _ = RefrescarLuego();
    }

    /// <summary>
    /// 2026-09-24: con "Térmica directa" se manda DIRECTO a la impresora: por Zebra Browser Print (como
    /// hace MeLi en la PC de la Zebra) o por QZ Tray (PC de la HPRT). js/zebra-print.js. Si esa compu
    /// no tiene ninguno de los dos programas, baja el .txt.
    /// El resto de los formatos abre el PDF en otra pestaña.
    /// </summary>
    private async Task AbrirEtiqueta(string url)
    {
        if (etiquetaFormato == "termica")
        {
            string r;
            try { r = await JS.InvokeAsync<string>("zebraImprimir", url); } catch { r = "sin-zebra"; }
            if (r == "ok") { ToastService.Success("Etiqueta enviada a la impresora"); return; }
            if (r.StartsWith("error:")) { ToastService.Error(r[6..]); return; }
            ToastService.Warning("No encontré el programa de la impresora (Zebra Browser Print o QZ Tray) en esta compu: te bajo el archivo .txt");
            await JS.InvokeVoidAsync("zebraBajar", url);
            return;
        }
        await JS.InvokeVoidAsync("window.open", url, "_blank");
    }

    /// <summary>A los pocos segundos vuelve a traer la lista para que la impresorita pase a verde con la hora.</summary>
    private async Task RefrescarLuego()
    {
        await Task.Delay(6000);
        try { await Cargar(); await InvokeAsync(StateHasChanged); } catch { }
    }

    private async Task ImprimirTildadas()
    {
        if (tildadas.Count == 0) return;
        ToastService.Success($"Generando {tildadas.Count} etiqueta(s)…");
        await AbrirEtiqueta(Api.BuildEtiquetaMeliUrl(tildadas.OrderBy(x => x), etiquetaFormato));
        tildadas.Clear();
        _ = RefrescarLuego();
    }

    private ElementReference scanRef;
    private string scanInput = "";
    private bool escaneando;

    private List<MeliDepoOrden> ordenes = new();
    private List<MeliDepoCuenta> cuentas = new();
    private bool cargando;
    private int dias = 2;
    private int? cuenta;
    private string? envio;
    private string? estado;
    private string buscar = "";
    private string? zoomFoto;

    // ── Detalle por renglón (la antigua ficha), se trae de a poco y queda guardado mientras la página está abierta.
    private readonly Dictionary<long, MeliDepoFicha> fichas = new();
    private readonly HashSet<long> pedidas = new();
    private readonly HashSet<long> fallidas = new();
    private bool cargandoDetalles;
    private bool cerrada;
    private const int MaxDetallesAuto = 150;   // con "30 días" pueden ser cientos: los primeros se traen solos

    private long? resaltada;                    // envío escaneado (o llegado por ?orden=)
    private MeliDepoFicha? escaneadaFuera;      // escaneado que no está en la lista con los filtros actuales

    /// <summary>Envío, estado y buscar se filtran acá (sin volver a pedir): la lista de "Hoy y ayer"
    /// ya viene entera. Fecha y cuenta sí vuelven a pedir.</summary>
    private List<MeliDepoOrden> Filtradas => ordenes
        .Where(o => envio is null || o.TipoClave == envio)
        .Where(o => estado is null || o.EstadoClave == estado)
        .Where(o => string.IsNullOrWhiteSpace(buscar) || Coincide(o, buscar.Trim()))
        .ToList();

    private static bool Coincide(MeliDepoOrden o, string t)
        => o.Comprador.Contains(t, StringComparison.OrdinalIgnoreCase)
           || o.Numero.ToString().Contains(t) || o.NumeroVenta.ToString().Contains(t)
           || o.Productos.Any(p => p.Titulo.Contains(t, StringComparison.OrdinalIgnoreCase));

    protected override async Task OnInitializedAsync() => await Cargar();

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            try
            {
                var f = await JS.InvokeAsync<string?>("localStorage.getItem", ClaveFormato);
                if (FormatosEtiqueta.Any(x => x.Item1 == f)) { etiquetaFormato = f!; StateHasChanged(); }
            }
            catch { }
            try { await scanRef.FocusAsync(); } catch { }
        }
        // Cada vez que cambia lo que se ve (filtros, lista nueva), completar los detalles que falten.
        if (!cargandoDetalles && Filtradas.Take(MaxDetallesAuto).Any(o => !pedidas.Contains(o.Numero)))
            _ = CargarDetalles();
    }

    /// <summary>Trae el detalle de los renglones que faltan, de a 4, redibujando a medida que llegan.</summary>
    private async Task CargarDetalles()
    {
        if (cargandoDetalles) return;
        cargandoDetalles = true;
        try
        {
            while (!cerrada)
            {
                var faltan = Filtradas.Take(MaxDetallesAuto).Select(o => o.Numero)
                    .Where(n => !pedidas.Contains(n)).Distinct().Take(4).ToList();
                if (faltan.Count == 0) break;
                foreach (var n in faltan) pedidas.Add(n);
                await Task.WhenAll(faltan.Select(TraerDetalle));
                await InvokeAsync(StateHasChanged);
            }
        }
        finally
        {
            cargandoDetalles = false;
            if (!cerrada) await InvokeAsync(StateHasChanged);
        }
    }

    private async Task TraerDetalle(long numero)
    {
        try
        {
            var f = await Api.GetMeliDepoFichaAsync(numero);
            if (f is not null && f.Ok) { fichas[numero] = f; fallidas.Remove(numero); }
            else fallidas.Add(numero);
        }
        catch { fallidas.Add(numero); }
    }

    /// <summary>2026-09-24: después de cargar un lugar o avisar "no está acá", vuelve a traer ese renglón.</summary>
    private async Task TraerDetalleYRedibujar(long numero)
    {
        await TraerDetalle(numero);
        if (escaneadaFuera?.Numero == numero && fichas.TryGetValue(numero, out var f)) escaneadaFuera = f;
        await InvokeAsync(StateHasChanged);
    }

    private async Task Reintentar(long numero)
    {
        fallidas.Remove(numero);
        await TraerDetalle(numero);
    }

    private async Task Cargar()
    {
        cargando = true;
        try
        {
            var r = await Api.GetMeliDepoOrdenesAsync(dias, cuenta, null, null, null);
            if (r is not null)
            {
                ordenes = r.Ordenes;
                cuentas = r.Cuentas;
            }
        }
        catch (Exception ex) { ToastService.Error("No pude traer las órdenes: " + ex.Message); }
        finally { cargando = false; }
    }

    private async Task CambiarDias(int d) { dias = d; await Cargar(); }
    private async Task CambiarCuenta(int? c) { cuenta = c; await Cargar(); }

    private async Task OnScanKey(KeyboardEventArgs e)
    {
        // El lector USB "tipea" el código y termina con Enter.
        if (e.Key == "Enter") await Escanear();
    }

    private async Task Escanear()
    {
        var code = scanInput?.Trim() ?? "";
        if (string.IsNullOrEmpty(code)) return;
        escaneando = true;
        StateHasChanged();
        try
        {
            var r = await Api.EscanearMeliDepoAsync(code);
            if (r is not null && r.Ok) await Marcar(r);
            else ToastService.Error(r?.Mensaje ?? "No pude leer esa etiqueta");
        }
        catch (Exception ex) { ToastService.Error("Error: " + ex.Message); }
        finally
        {
            escaneando = false;
            scanInput = "";
            StateHasChanged();
            try { await scanRef.FocusAsync(); } catch { }
        }
    }

    /// <summary>Marca en azul el envío escaneado y lo lleva a la vista. Si no está en la lista
    /// (otro día, otro filtro), se muestra arriba de todo.</summary>
    private async Task Marcar(MeliDepoFicha f)
    {
        fichas[f.Numero] = f;
        pedidas.Add(f.Numero);
        resaltada = f.Numero;
        escaneadaFuera = Filtradas.Any(o => o.Numero == f.Numero) ? null : f;
        StateHasChanged();
        await Task.Delay(50);
        try { await JS.InvokeVoidAsync("eval", $"document.getElementById('fila-{f.Numero}')?.scrollIntoView({{block:'center', behavior:'smooth'}})"); } catch { }
    }

    // Links viejos con ?orden=N (antes abrían la ficha): ahora marcan ese renglón.
    [SupplyParameterFromQuery(Name = "orden")] public long? Orden { get; set; }

    protected override async Task OnParametersSetAsync()
    {
        if (Orden is null || resaltada == Orden) return;
        try
        {
            var f = await Api.GetMeliDepoFichaAsync(Orden.Value);
            if (f is not null && f.Ok) await Marcar(f);
        }
        catch { }
    }

    /// <summary>Renglón armado solo con la ficha (para el escaneado que no está en la lista).</summary>
    private static MeliDepoOrden OrdenDeFicha(MeliDepoFicha f) => new()
    {
        Numero = f.Numero,
        NumeroVenta = f.NumeroVenta ?? 0,
        NumeroEnvio = f.Tipo == "Full" ? null : f.NumeroEnvio,
        Fecha = f.Fecha ?? DateTime.MinValue,
        Cuenta = f.Cuenta ?? "",
        Comprador = f.Comprador ?? "",
        Tipo = f.Tipo ?? "",
        Estado = f.Estado ?? "",
        EstadoClave = f.Estado == "Cancelada" ? "cancelada" : f.Estado == "Para despachar" ? "despachar" : "",
        Unidades = f.Unidades,
        Productos = f.Productos.Select(p => new MeliDepoOrdenProducto { Titulo = p.Titulo, Cantidad = p.Cantidad, Foto = p.Foto, Lugar = p.Lugar, LugarDudoso = p.LugarDudoso }).ToList()
    };

    private static string FmtCant(decimal c) => c == Math.Floor(c) ? ((long)c).ToString() : c.ToString("0.##");

    public void Dispose() => cerrada = true;
}
