@page "/combustible"
@attribute [Authorize(Roles = "admin")]
@inject ApiClient Api
@inject ToastService ToastService
@implements IDisposable

@* 18/11/2026 — Combustible (Shell Flota). Cada vez que el robot entra a Shell a ver el saldo se trae
   también las cargas del "Reporte transaccional" (últimos 30 días). Acá: total del período, cada
   vehículo con su rinde, y las cargas una abajo de la otra con ⚠ en rojo si algo no cierra
   (km que no avanzan, dos cargas el mismo día, fuera de horario, rinde mucho peor que lo normal).
   Solo admin. Maqueta aprobada: scratchpad/Combustible_Shell_PROPUESTA.png
   19/11/2026: pantalla ÚNICA de Shell (pedido del dueño: "centralizar"). Arriba el saldo con "Leer ahora";
   abajo, plegado, "Cuenta Shell" (usuario, clave y lectura automática) que antes estaba en
   /integraciones/shell. La pastilla de la barra de arriba trae acá. *@

<style>
    .cb-top { display:flex; justify-content:space-between; align-items:flex-end; gap:0.8rem; flex-wrap:wrap; }
    .cb-sub { color:#6b7280; font-size:0.88rem; margin-top:0.15rem; }
    .cb-per { display:flex; gap:0.35rem; flex-wrap:wrap; }
    .cb-btn { border:1px solid #d1d5db; background:#fff; border-radius:7px; padding:0.3rem 0.7rem; font-size:0.85rem; cursor:pointer; color:#374151; }
    .cb-btn.on { background:#111827; color:#fff; border-color:#111827; }
    .cb-card { background:#fff; border:1px solid #e5e7eb; border-radius:10px; padding:0.7rem 0.9rem; }
    .cb-tot { font-size:0.98rem; margin-top:0.7rem; }
    .cb-mut { color:#6b7280; }
    .cb-red { color:#b91c1c; font-weight:600; }
    .cb-sec { font-size:0.72rem; font-weight:700; color:#6b7280; letter-spacing:0.05em; text-transform:uppercase; margin:1.2rem 0 0.4rem; }
    .cb-tab { width:100%; border-collapse:collapse; font-size:0.9rem; }
    .cb-tab th { font-size:0.72rem; color:#6b7280; font-weight:500; text-align:left; padding:0.35rem 0.4rem; border-bottom:1px solid #e5e7eb; }
    .cb-tab td { padding:0.45rem 0.4rem; border-bottom:1px solid #f0f1f3; vertical-align:top; }
    .cb-tab tr:last-child td { border-bottom:0; }
    .cb-tab .n { text-align:right; white-space:nowrap; font-variant-numeric:tabular-nums; }
    .cb-flota td { font-size:0.95rem; vertical-align:middle; }
    .cb-chico { font-size:0.75rem; padding:0.15rem 0.5rem; }
    .cb-pat { display:inline-block; border:1.5px solid #111827; border-top:3px solid #1d4ed8; border-radius:4px; padding:0 0.3rem; font-family:ui-monospace,Menlo,monospace; font-weight:700; font-size:0.78rem; letter-spacing:0.04em; margin-left:0.3rem; }
    .cb-propio { display:flex; gap:0.6rem; flex-wrap:wrap; margin-top:0.6rem; padding-top:0.6rem; border-top:1px solid #f0f1f3; }
    .cb-propio label { display:block; font-size:0.78rem; color:#374151; margin-bottom:0.15rem; }
    .cb-propio input, .cb-propio select { padding:0.35rem 0.5rem; border:1px solid #d1d5db; border-radius:6px; font-size:0.9rem; }
    .cb-veh { cursor:pointer; }
    .cb-veh:hover td { background:#f9fafb; }
    .cb-veh.sel td { background:#f3f4f6; }
    .cb-veh b { font-weight:600; }
    .cb-al { font-size:0.8rem; }
    .cb-nota { font-size:0.78rem; color:#6b7280; margin-top:0.4rem; }
    .cb-scroll { overflow-x:auto; }
    @@media (max-width: 700px) { .cb-ocultar { display:none; } }
    .cb-saldo { text-align:right; }
    .cb-saldo-v { font-size:1.5rem; font-weight:700; color:#111827; font-variant-numeric:tabular-nums; }
    .cb-leer { border:1px solid #d1d5db; background:#fff; border-radius:7px; padding:0.3rem 0.75rem; font-size:0.85rem; cursor:pointer; margin-left:0.5rem; }
    .cb-leer:disabled { opacity:0.6; cursor:default; }
    .cb-prog { display:flex; align-items:center; gap:0.7rem; margin-top:0.8rem; padding:0.6rem 0.8rem; background:#eff6ff; border:1px solid #bfdbfe; border-radius:8px; font-size:0.85rem; }
    .cb-spin { width:18px; height:18px; border:3px solid #bfdbfe; border-top-color:#1d4ed8; border-radius:50%; animation:spin 1s linear infinite; flex-shrink:0; }
    .cb-cuenta-h { cursor:pointer; user-select:none; margin-top:1.6rem; padding-top:0.8rem; border-top:1px solid #e5e7eb; font-size:0.95rem; }
    .cb-cuenta-h .cb-mut { font-size:0.82rem; }
    .cb-cuenta { margin-top:0.6rem; display:grid; grid-template-columns:repeat(auto-fit, minmax(280px, 1fr)); gap:0.9rem; }
    .cb-cuenta label { font-size:0.82rem; color:#374151; display:block; margin:0.4rem 0 0.15rem; }
    .cb-cuenta input[type=text], .cb-cuenta input[type=password] { width:100%; box-sizing:border-box; padding:0.4rem 0.55rem; border:1px solid #d1d5db; border-radius:6px; font-size:0.9rem; }
    .cb-hora { display:flex; align-items:center; gap:0.4rem; margin-bottom:0.35rem; }
    .cb-hora input { padding:0.25rem 0.45rem; border:1px solid #d1d5db; border-radius:6px; }
</style>

<div class="cb-top">
    <div>
        <h2 style="margin:0">⛽ Combustible · Shell Flota</h2>
        <div class="cb-sub">Saldo y cargas de Shell · los trae el robot cada vez que entra a Shell</div>
    </div>
    <div class="cb-saldo">
        <span class="cb-mut">saldo</span>
        <span class="cb-saldo-v">@(string.IsNullOrEmpty(cuenta?.LastSaldo) ? "—" : "$" + cuenta!.LastSaldo)</span>
        <button class="cb-leer" disabled="@(leyendo || cuenta?.HasPassword != true)" @onclick="LeerAhora"
                title="El robot entra a Shell, lee el código del mail y trae el saldo y las cargas (1 a 3 minutos)">
            @(leyendo ? "Leyendo…" : "⟳ Leer ahora")
        </button>
        <div class="cb-mut" style="font-size:0.78rem">
            @(cuenta?.LastSaldoAt is DateTime la ? $"leído {la.ToArTime():dd/MM HH:mm}" : "")
            @(cuenta?.AutoSyncEnabled == true && !string.IsNullOrEmpty(cuenta.AutoSyncTimes) ? $" · solo a las {cuenta.AutoSyncTimes.Replace(",", ", ")}" : " · automático apagado")
        </div>
    </div>
</div>

@if (leyendo)
{
    <div class="cb-prog"><div class="cb-spin"></div><div><b>@leerStep</b> <span class="cb-mut">· podés seguir usando el sistema</span></div></div>
}
else if (leerResult is { Ok: false })
{
    <div class="cb-prog" style="background:#fef2f2;border-color:#fecaca;color:#991b1b">❌ No se pudo leer Shell: @leerResult.Error</div>
}

@* 19/11/2026: vehículos con los km de su última carga, siempre arriba y sin depender del período
   (pedido del dueño: "los coches que tenemos y el km siempre al día"). Shell no tiene GPS: el km se
   sabe solo cuando cargan, por eso va al lado cuándo cargó; en rojo si hace más de 5 días. *@
@* 20/11/2026: + foto de cada vehículo (la ven los repartidores al elegir con cuál salen) y los autos
   propios de los repartidores (Siena de Nacho), que no están en Shell. *@
@if (flotaAdm is not null && (flotaAdm.Coches.Count > 0 || datos?.Flota is { Count: > 0 }))
{
    <div class="cb-sec">Vehículos · km de la última carga</div>
    <div class="cb-card">
        <table class="cb-tab cb-flota">
            @foreach (var f in flotaAdm.Coches)
            {
                var placa = f.Placa;
                var dias = f.UltimaCarga is DateTime uc ? (hoyAr - uc.Date).Days : 0;
                <tr>
                    <td style="width:76px; padding-right:0">
                        @if (f.FotoVer is long fv)
                        {
                            <img src="@ApiClient.FotoFlotaUrl(placa, fv)" alt="@f.Nombre" style="width:68px; height:44px; object-fit:cover; border-radius:6px; display:block;" />
                        }
                        else
                        {
                            <div style="width:68px; height:44px; border-radius:6px; background:#f3f4f6; display:flex; align-items:center; justify-content:center; font-size:1.4rem;">@(EsMoto(f.Nombre) ? "🛵" : "🚗")</div>
                        }
                    </td>
                    <td>
                        <b>@f.Nombre</b> <span class="cb-pat">@placa</span>
                        @if (f.Propio) { <div class="cb-mut" style="font-size:0.8rem">propio de @(f.Repartidor ?? "?") · solo le aparece a él</div> }
                        <div style="margin-top:0.25rem; display:flex; gap:0.35rem; flex-wrap:wrap;">
                            <label class="cb-btn cb-chico" style="@(subiendo == placa ? "opacity:0.6" : "")">
                                @(subiendo == placa ? "Subiendo…" : f.FotoVer is null ? "📷 Poner foto" : "📷 Cambiar foto")
                                <InputFile OnChange="e => SubirFoto(placa, e)" accept="image/*" style="display:none" disabled="@(subiendo != null)" />
                            </label>
                            @if (f.FotoVer is not null)
                            {
                                <button class="cb-btn cb-chico" @onclick="() => QuitarFoto(placa)">Quitar foto</button>
                            }
                            @if (f.Propio)
                            {
                                <button class="cb-btn cb-chico" @onclick="() => BorrarPropio(f)">Borrar</button>
                            }
                        </div>
                    </td>
                    <td class="n"><b>@(f.Km is int k ? k.ToString("#,0", Ar) + " km" : "—")</b></td>
                    <td class="n @(f.UltimaCarga is not null && dias > DiasSinCargarRojo ? "cb-red" : "cb-mut")" style="width:7.5rem">
                        @(f.UltimaCarga is DateTime u ? CuandoCargo(u, dias) : "no usa Shell")
                    </td>
                </tr>
            }
        </table>
        <div class="cb-nota">Se actualiza solo cada vez que el robot lee Shell. En rojo: más de @DiasSinCargarRojo días sin cargar. Los repartidores ven estos vehículos (con su foto) cuando eligen con cuál salen.</div>
        @if (!agregandoPropio)
        {
            <button class="cb-btn" style="margin-top:0.6rem" @onclick="() => { agregandoPropio = true; propioError = null; }">＋ Vehículo propio de un repartidor</button>
        }
        else
        {
            <div class="cb-propio">
                <div><label>Qué vehículo es</label><input type="text" placeholder="Siena" @bind="propioNombre" maxlength="60" /></div>
                <div><label>Patente</label><input type="text" placeholder="AB123CD" @bind="propioPlaca" maxlength="20" style="text-transform:uppercase" /></div>
                <div>
                    <label>De quién</label>
                    <select @bind="propioRep">
                        <option value="">Elegí…</option>
                        @foreach (var r in flotaAdm.Repartidores) { <option value="@r.Id">@r.Nombre</option> }
                    </select>
                </div>
                <div style="align-self:flex-end; display:flex; gap:0.35rem;">
                    <button class="cb-btn on" disabled="@guardandoPropio" @onclick="GuardarPropio">Guardar</button>
                    <button class="cb-btn" @onclick="() => agregandoPropio = false">Cancelar</button>
                </div>
            </div>
            @if (propioError is not null) { <div class="cb-red" style="font-size:0.85rem; margin-top:0.3rem">⚠ @propioError</div> }
        }
    </div>
}

<div class="cb-top" style="margin-top:0.9rem">
    <div></div>
    <div class="cb-per">
        <button class="cb-btn @(periodo == "semana" ? "on" : "")" @onclick='() => Elegir("semana")'>Esta semana</button>
        <button class="cb-btn @(periodo == "30" ? "on" : "")" @onclick='() => Elegir("30")'>Últimos 30 días</button>
        <button class="cb-btn @(periodo == "mespasado" ? "on" : "")" @onclick='() => Elegir("mespasado")'>Mes pasado</button>
    </div>
</div>

@if (cargando && datos == null)
{
    <p class="cb-mut" style="margin-top:1rem">Cargando…</p>
}
else if (error != null)
{
    <p class="cb-red" style="margin-top:1rem">@error</p>
}
else if (datos != null)
{
    <div class="cb-card cb-tot">
        <b>@datos.Cargas carga@(datos.Cargas == 1 ? "" : "s")</b> · @datos.Litros.ToString("#,0", Ar) litros · <b>@Plata(datos.Importe)</b>
        @if (!string.IsNullOrEmpty(datos.Saldo))
        {
            <span> · saldo Shell $@datos.Saldo</span>
        }
        <span class="cb-mut"> · @datos.Desde.ToString("dd/MM") al @datos.Hasta.ToString("dd/MM")@(datos.SaldoAt is DateTime sa ? $" · leído {sa.ToArTime():dd/MM HH:mm}" : "")</span>
    </div>

    @if (datos.Cargas == 0)
    {
        <p class="cb-mut" style="margin-top:1rem">No hay cargas en este período. Si el robot recién empezó a traerlas, aparecen después de la próxima lectura del saldo.</p>
    }
    else
    {
        <div class="cb-sec">Por vehículo</div>
        <div class="cb-card cb-scroll">
            <table class="cb-tab">
                <tr><th>Vehículo</th><th class="n">Cargas</th><th class="n">Litros</th><th class="n">Plata</th><th class="n">Rinde</th><th class="n cb-ocultar">Último km</th></tr>
                @foreach (var v in datos.Vehiculos)
                {
                    <tr class="cb-veh @(filtro == v.Placa ? "sel" : "")" @onclick="() => Filtrar(v.Placa)" title="Ver solo sus cargas">
                        <td>
                            <b>@v.Nombre</b> <span class="cb-mut">· @v.Placa</span>
                            @if (v.Alarma != null) { <div class="cb-red cb-al">⚠ @v.Alarma</div> }
                        </td>
                        <td class="n">@v.Cargas</td>
                        <td class="n">@v.Litros.ToString("#,0", Ar)</td>
                        <td class="n">@Plata(v.Importe)</td>
                        <td class="n">@(v.Rinde is decimal r ? $"{r.ToString("0.0", Ar)} km/l" : "")@if (v.Rinde == null) { <span class="cb-mut">no se puede saber</span> }</td>
                        <td class="n cb-ocultar">@(v.UltimoKm?.ToString("#,0", Ar))</td>
                    </tr>
                }
            </table>
            <div class="cb-nota">@(filtro == null ? "Tocando un vehículo se ven solo sus cargas." : "Tocalo de nuevo para ver todas.")</div>
        </div>

        <div class="cb-sec">@(filtro == null ? "Cargas" : $"Cargas de {datos.Vehiculos.FirstOrDefault(v => v.Placa == filtro)?.Nombre} · {filtro}")</div>
        <div class="cb-card cb-scroll">
            <table class="cb-tab">
                <tr><th>Cuándo</th><th>Vehículo · estación</th><th class="n">Litros</th><th class="n">Plata</th><th class="n">Km (anduvo)</th><th class="n">Rinde</th></tr>
                @foreach (var c in datos.Lista.Where(c => filtro == null || c.Placa == filtro))
                {
                    <tr>
                        <td style="white-space:nowrap">@c.FechaHoraAr.ToString("dd/MM HH:mm")</td>
                        <td>
                            @c.Nombre <span class="cb-mut">· @c.Estacion</span>
                            @if (c.Alarmas.Count > 0) { <div class="cb-red cb-al">⚠ @string.Join(" · ", c.Alarmas)</div> }
                        </td>
                        <td class="n">@c.Litros.ToString("0.0", Ar)</td>
                        <td class="n">@Plata(c.Importe)</td>
                        <td class="n">
                            @(c.Odometro?.ToString("#,0", Ar))
                            @if (c.Anduvo is int a)
                            {
                                <span class="@(a < 20 ? "cb-red" : "cb-mut")"> (@(a >= 0 ? "+" : "")@a.ToString("#,0", Ar))</span>
                            }
                        </td>
                        <td class="n">@(c.Rinde?.ToString("0.0", Ar))@if (c.Rinde == null && c.Alarmas.Any(x => x.StartsWith("km") || x.StartsWith("los km"))) { <span class="cb-red">⚠</span> }</td>
                    </tr>
                }
            </table>
            <div class="cb-nota">"Rinde" = km que anduvo desde la carga anterior ÷ litros de esta carga. En rojo ⚠: km que no avanzan (menos de 20), dos cargas el mismo día, carga antes de las 7 o después de las 21, o rinde mucho peor que lo normal de ese vehículo.</div>
        </div>
    }
}

@* ─── Cuenta Shell (antes en Integraciones → Shell Flota) ─── *@
<div class="cb-cuenta-h" @onclick="() => verCuenta = !verCuenta">
    @(verCuenta ? "▾" : "▸") <b>Cuenta Shell</b>
    <span class="cb-mut">· usuario y clave · lectura automática @(cuenta?.AutoSyncEnabled == true ? "prendida" : "apagada")</span>
</div>
@if (verCuenta)
{
    <div class="cb-cuenta">
        <div class="cb-card">
            <b>Datos de acceso</b>
            <div class="cb-nota">El login de Shell pide un código por mail: el robot lo lee solo de la casilla de Gmail conectada en Integraciones → Email.</div>
            <label>Usuario de Shell Flota</label>
            <input type="text" @bind="usuario" placeholder="ej: gppalanica001" />
            <label>Clave @(cuenta?.HasPassword == true ? "(dejá vacío para no cambiarla)" : "")</label>
            <input type="password" @bind="password" placeholder="@(cuenta?.HasPassword == true ? "•••••••• (ya guardada)" : "Escribí la clave")" />
            <label>Alias (opcional)</label>
            <input type="text" @bind="alias" placeholder="ej: PALANICA HERMANOS SRL" />
        </div>
        <div class="cb-card">
            <b>Leer automático (sin apretar nada)</b>
            <label style="display:flex;align-items:center;gap:0.5rem;font-weight:600;cursor:pointer;margin-top:0.6rem">
                <input type="checkbox" @bind="autoEnabled" /> Prendido
            </label>
            <div class="cb-nota" style="margin-bottom:0.4rem">Horarios de Argentina. Cada lectura trae el saldo y las cargas.</div>
            @for (int i = 0; i < horarios.Count; i++)
            {
                var idx = i;
                <div class="cb-hora">
                    <input type="time" @bind="horarios[idx]" />
                    <button class="cb-btn" @onclick="() => horarios.RemoveAt(idx)" title="Sacar este horario">✕</button>
                </div>
            }
            <button class="cb-btn" @onclick="() => horarios.Add(new TimeOnly(8, 0))">+ Agregar horario</button>
        </div>
    </div>
    <div style="margin-top:0.7rem">
        <button class="cb-btn on" disabled="@guardando" @onclick="GuardarCuenta">@(guardando ? "Guardando…" : "Guardar cuenta y horarios")</button>
    </div>
}

@code {
    // 19/11: cuenta Shell + leer ahora (traído de ShellFlota.razor).
    private Web.Models.ShellAccountDto? cuenta;
    private bool verCuenta;
    private string usuario = "", password = "", alias = "";
    private bool guardando, autoEnabled, leyendo;
    private List<TimeOnly> horarios = new();
    private string leerStep = "";
    private Web.Models.ShellSincronizarResultDto? leerResult;
    private CancellationTokenSource? pollCts;

    private async Task CargarCuenta()
    {
        try
        {
            cuenta = await Api.GetShellAccountAsync();
            if (cuenta is not null)
            {
                usuario = cuenta.Usuario;
                alias = cuenta.Alias ?? "";
                autoEnabled = cuenta.AutoSyncEnabled;
                horarios = new List<TimeOnly>();
                if (!string.IsNullOrWhiteSpace(cuenta.AutoSyncTimes))
                    foreach (var x in cuenta.AutoSyncTimes.Split(',', StringSplitOptions.RemoveEmptyEntries))
                        if (TimeOnly.TryParseExact(x.Trim(), "HH:mm", null, System.Globalization.DateTimeStyles.None, out var t))
                            horarios.Add(t);
            }
            else verCuenta = true;   // sin cuenta cargada: abrir directo para cargarla
        }
        catch (Exception ex) { ToastService.Error("No se pudo leer la cuenta de Shell: " + ex.Message); }
    }

    private async Task GuardarCuenta()
    {
        if (string.IsNullOrWhiteSpace(usuario)) { ToastService.Error("Poné el usuario"); return; }
        guardando = true;
        try
        {
            var hs = horarios.Distinct().OrderBy(t => t).Select(t => t.ToString("HH\\:mm")).ToList();
            cuenta = await Api.SaveShellAccountAsync(new Web.Models.SaveShellAccountRequest
            {
                Usuario = usuario.Trim(),
                Password = string.IsNullOrWhiteSpace(password) ? null : password,
                Alias = string.IsNullOrWhiteSpace(alias) ? null : alias.Trim(),
                IsActive = true,
                AutoSyncEnabled = autoEnabled,
                AutoSyncTimes = hs.Count > 0 ? string.Join(",", hs) : null
            });
            password = "";
            ToastService.Success("Cuenta de Shell guardada");
        }
        catch (Exception ex) { ToastService.Error("No se pudo guardar: " + ex.Message); }
        finally { guardando = false; }
    }

    private async Task LeerAhora()
    {
        leerResult = null;
        leerStep = "Iniciando…";
        leyendo = true;
        pollCts?.Cancel();
        pollCts = new CancellationTokenSource();
        var token = pollCts.Token;
        _ = Task.Run(async () =>
        {
            while (!token.IsCancellationRequested)
            {
                try
                {
                    await Task.Delay(1500, token);
                    var st = await Api.GetShellTestStatusAsync();
                    if (st is not null) leerStep = st.Step;
                    await InvokeAsync(StateHasChanged);
                }
                catch (TaskCanceledException) { break; }
                catch { }
            }
        }, token);
        try
        {
            leerResult = await Api.SincronizarShellAsync();
            if (leerResult is { Ok: true })
            {
                ToastService.Success("Shell leído: $" + leerResult.Saldo);
                await CargarCuenta();
                await Cargar();
            }
        }
        catch (Exception ex) { leerResult = new Web.Models.ShellSincronizarResultDto { Ok = false, Error = ex.Message }; }
        finally { pollCts?.Cancel(); leyendo = false; StateHasChanged(); }
    }

    public void Dispose() => pollCts?.Cancel();

    private static readonly System.Globalization.CultureInfo Ar = System.Globalization.CultureInfo.GetCultureInfo("es-AR");
    private CombustibleDto? datos;
    private bool cargando;
    private string? error;
    private string periodo = "30";
    private string? filtro;

    protected override Task OnInitializedAsync() => Task.WhenAll(Cargar(), CargarCuenta(), CargarFlota());

    // ─── 20/11/2026: fotos de los vehículos + autos propios de repartidores ───
    private ApiClient.FlotaAdminDto? flotaAdm;
    private string? subiendo;
    private bool agregandoPropio, guardandoPropio;
    private string propioNombre = "", propioPlaca = "", propioRep = "";   // select con string (int no anda en Blazor)
    private string? propioError;

    private async Task CargarFlota()
    {
        try { flotaAdm = await Api.GetFlotaAsync(); } catch { flotaAdm = null; }
    }

    private static bool EsMoto(string n) => n.Contains("moto", StringComparison.OrdinalIgnoreCase);

    private async Task SubirFoto(string placa, InputFileChangeEventArgs e)
    {
        if (subiendo != null) return;
        subiendo = placa;
        try
        {
            using var st = e.File.OpenReadStream(20_000_000);
            using var ms = new MemoryStream();
            await st.CopyToAsync(ms); ms.Position = 0;
            await Api.SubirFotoFlotaAsync(placa, ms, e.File.Name, e.File.ContentType);
            ToastService.Success("Foto guardada");
            await CargarFlota();
        }
        catch (Exception ex) { ToastService.Error(ex.Message.Contains("exceeds") ? "La foto es muy pesada (máximo 20 MB)." : ex.Message); }
        finally { subiendo = null; }
    }

    private async Task QuitarFoto(string placa)
    {
        try { await Api.QuitarFotoFlotaAsync(placa); await CargarFlota(); }
        catch (Exception ex) { ToastService.Error(ex.Message); }
    }

    private async Task GuardarPropio()
    {
        propioError = null;
        if (!int.TryParse(propioRep, out var repId)) { propioError = "Elegí de qué repartidor es."; return; }
        guardandoPropio = true;
        try
        {
            await Api.GuardarCochePropioAsync(propioPlaca, propioNombre, repId);
            agregandoPropio = false; propioNombre = propioPlaca = propioRep = "";
            ToastService.Success("Vehículo agregado");
            await CargarFlota();
        }
        catch (Exception ex) { propioError = ex.Message; }
        finally { guardandoPropio = false; }
    }

    private async Task BorrarPropio(ApiClient.FlotaCocheDto f)
    {
        try { await Api.BorrarCochePropioAsync(f.Placa); await CargarFlota(); }
        catch (Exception ex) { ToastService.Error(ex.Message); }
    }

    private static string Plata(decimal v) => v.ToString("$#,0", Ar);

    private const int DiasSinCargarRojo = 5;
    private static DateTime hoyAr => DateTime.UtcNow.ToArTime().Date;
    private static string CuandoCargo(DateTime f, int dias) => dias switch
    {
        <= 0 => $"hoy {f:dd/MM}",
        1 => $"ayer {f:dd/MM}",
        _ => $"hace {dias} días"
    };

    private async Task Elegir(string p) { periodo = p; filtro = null; await Cargar(); }
    private void Filtrar(string placa) => filtro = filtro == placa ? null : placa;

    private async Task Cargar()
    {
        cargando = true; error = null;
        var hoy = DateTime.UtcNow.ToArTime().Date;
        DateTime desde, hasta = hoy;
        switch (periodo)
        {
            case "semana":
                desde = hoy.AddDays(-(((int)hoy.DayOfWeek + 6) % 7)); // lunes
                break;
            case "mespasado":
                desde = new DateTime(hoy.Year, hoy.Month, 1).AddMonths(-1);
                hasta = new DateTime(hoy.Year, hoy.Month, 1).AddDays(-1);
                break;
            default:
                desde = hoy.AddDays(-29);
                break;
        }
        try { datos = await Api.GetCombustibleAsync(desde, hasta); }
        catch (Exception ex) { error = "No pude traer las cargas: " + ex.Message; }
        cargando = false;
    }
