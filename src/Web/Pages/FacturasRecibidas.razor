    };

    // ── Pagada ──
    private static readonly (string Medio, string? Regla)[] Medios =
        { ("Mercado Pago", "MP"), ("Transferencia", null), ("Débito automático", "DEBITO"), ("Tarjeta", "TARJETA"), ("Efectivo", "EFECTIVO") };

    private async Task MarcarPagada(ApiClient.FacturaRecibidaDto f, string medio, string? regla)
    {
        menuPago = null;
        if (reglaSiempre && regla is not null && f.Cuit is not null)
        {
            if (!await Api.PonerReglaPagoProveedorAsync(f.Cuit, regla)) { ToastService.Error("No se pudo guardar"); return; }
            ToastService.Success($"{f.Proveedor}: todas sus facturas salen pagadas ({medio.ToLowerInvariant()})");
            reglaSiempre = false;
            await Cargar();
            return;
        }
        if (!await Api.MarcarFacturaPagadaAsync(f.Id, medio)) { ToastService.Error("No se pudo marcar"); return; }
        Reemplazar(f.Id, x => x with { Pago = "pagada", PagoVia = medio + " · " + FechaPalabras.HoyAr.ToString("dd/MM"), PagoManual = true, Sugerencia = null });
    }

    private async Task Confirmar(ApiClient.FacturaRecibidaDto f, ApiClient.FacturaSugerenciaDto s)
    {
        var medio = s.Origen == "MP" ? "Mercado Pago" : "Galicia";
        // 19/11/2026: si es del banco, queda como pago de Tesorería de verdad (como las cobranzas). Si no se
        // puede (p. ej. el movimiento ya pagó otra cosa), se marca pagada como antes.
        if (s.Origen == "BCO" && s.MovId <= int.MaxValue)
        {
            var r = await Api.RegistrarPagoBancoFacturasAsync((int)s.MovId, new() { f.Id }, f.Cuit);
            if (r is { Ok: true }) { ToastService.Success("Pago registrado en Tesorería"); await Cargar(); return; }
        }
        if (!await Api.MarcarFacturaPagadaAsync(f.Id, medio, s.Origen, s.MovId)) { ToastService.Error("No se pudo marcar"); return; }
        Reemplazar(f.Id, x => x with { Pago = "pagada", PagoVia = $"{medio} · {s.Fecha:dd/MM}", PagoManual = true, Sugerencia = null });
    }

    private async Task Rechazar(ApiClient.FacturaRecibidaDto f, ApiClient.FacturaSugerenciaDto s)
    {
        if (!await Api.RechazarSugerenciaFacturaAsync(f.Id, s.Origen, s.MovId)) { ToastService.Error("No se pudo guardar"); return; }
        Reemplazar(f.Id, x => x with { Sugerencia = null });
        ToastService.Success("Listo, no te lo vuelvo a sugerir");
    }

    private async Task Deshacer(ApiClient.FacturaRecibidaDto f)
    {
        if (f.PagoAuto is { } pa && pa.Split(':') is [var org, var num] && long.TryParse(num, out var mid))
        {
            if (!await Api.RechazarSugerenciaFacturaAsync(f.Id, org, mid)) { ToastService.Error("No se pudo deshacer"); return; }
            ToastService.Success("Listo, ese pago no es de esta factura");
        }
        else if (f.PagoManual)
        {
            if (!await Api.DesmarcarFacturaPagadaAsync(f.Id)) { ToastService.Error("No se pudo deshacer"); return; }
        }
        else if (f.ReglaPago is not null && f.Cuit is not null)
        {
            if (!await Api.PonerReglaPagoProveedorAsync(f.Cuit, null)) { ToastService.Error("No se pudo quitar la regla"); return; }
        }
        await Cargar();
    }

    private RenderFragment CeldaPago(ApiClient.FacturaRecibidaDto f) => __builder =>
    {
        if (f.EsNotaCredito) { <span class="gris">—</span> return; }
        if (f.Pago == "pagada")
        {
            <span class="ok">pagada</span>
            if (f.PagoManual || f.ReglaPago is not null || f.PagoAuto is not null)
            {
                <button type="button" class="fr-x" title="@(f.PagoAuto is not null ? "No es este pago: sacarlo" : f.PagoManual ? "Deshacer: volver a «no sé»" : "Quitar la regla de este proveedor")" @onclick="() => Deshacer(f)">✕</button>
            }
            if (f.PagoAuto is not null) { <span class="fr-auto" title="Lo encontró el sistema solo">auto</span> }
            if (f.PagoAuto?.StartsWith("BCO:") == true)
            {
                <button type="button" class="fr-reg" disabled="@(ocupado == f.PagoAuto)" title="Lo carga como pago en Tesorería: sale del banco y la factura queda pagada con su N° de pago" @onclick="() => RegistrarBanco(f)">🏦 Registrar el pago</button>
            }
            if (!string.IsNullOrWhiteSpace(f.PagoVia)) { <div class="fr-via">@f.PagoVia</div> }
            return;
        }
        if (f.Pago is not null && !f.Pago.StartsWith("anterior"))
        {
            <span class="@(EsSinPagar(f) ? "debe" : "gris")">@f.Pago</span>
            @BotonPagar(f)
            if (!string.IsNullOrWhiteSpace(f.PagoVia)) { <div class="fr-via">@f.PagoVia</div> }
            return;
        }
        <span class="gris">@(f.Pago ?? "no sé")</span>
        @BotonPagar(f)
        if (!f.CuentaCorriente)
        {
            <span class="gris"> · </span><button type="button" class="fr-lnk" @onclick='() => { menuPago = menuPago == f.Id ? null : f.Id; reglaSiempre = false; }'>marcar pagada ▾</button>
            if (menuPago == f.Id)
            {
                <div class="fr-menu">
                    @foreach (var (medio, regla) in Medios)
                    {
                        var m = medio; var r = regla;
                        <button type="button" class="op" @onclick="() => MarcarPagada(f, m, r)">@m</button>
                    }
                    @if (f.Cuit is not null)
                    {
                        <label><input type="checkbox" @bind="reglaSiempre" /> Siempre se paga así: marcar pagadas todas las de @f.Proveedor (no aplica a Transferencia)</label>
                    }
                </div>
            }
        }
        if (f.Sugerencia is { } s)
        {
            <div class="fr-sug" title="Mismo importe (o casi) y fecha cerca. Confirmá si es el pago de esta factura.">
                ¿Es este? @s.Texto
                <button type="button" @onclick="() => Confirmar(f, s)">Sí</button>
                <button type="button" @onclick="() => Rechazar(f, s)">No</button>
            </div>
        }
    };

    // ═══════ 19/11/2026: 💸 Pagar y 🏦 Registrar el pago ═══════
    private string? ocupado;

    private RenderFragment BotonPagar(ApiClient.FacturaRecibidaDto f) => __builder =>
    {
        if (f.EsNotaCredito || f.Total <= 0 || f.Cuit is null) return;
        <button type="button" class="fr-pagar" disabled="@(ocupado == f.Id)" title="Abre el Nuevo pago ya completo: proveedor, esta factura tildada y el importe" @onclick="() => Pagar(f)">💸 Pagar</button>
    };

    /// <summary>Abre Tesorería → Nuevo pago con el proveedor (si no estaba cargado se crea) y la factura tildada.</summary>
    private async Task Pagar(ApiClient.FacturaRecibidaDto f)
    {
        ocupado = f.Id;
        var pid = f.ProveedorId ?? 0;
        if (pid <= 0) pid = await Api.ProveedorDeFacturaAsync(f.Id);
        ocupado = null;
        if (pid <= 0) { ToastService.Error("No pude encontrar ni crear el proveedor de esta factura"); return; }
        Nav.NavigateTo($"/cafe/tesoreria/pagos?proveedor={pid}&factura={Uri.EscapeDataString(f.Id)}");
    }

    /// <summary>La transferencia (o débito) del Galicia que el sistema encontró pasa a ser un pago de Tesorería.
    /// Si la misma transferencia pagó varias facturas del proveedor, las registra todas juntas.</summary>
    private async Task RegistrarBanco(ApiClient.FacturaRecibidaDto f)
    {
        if (f.PagoAuto is not { } clave || !int.TryParse(clave[4..], out var movId)) return;
        var juntas = (lista ?? new()).Where(x => x.PagoAuto == clave).Select(x => x.Id).ToList();
        ocupado = clave;
        var r = await Api.RegistrarPagoBancoFacturasAsync(movId, juntas, f.Cuit);
        ocupado = null;
        if (r is null || !r.Ok) { ToastService.Error(r?.Error ?? "No se pudo registrar el pago"); return; }
        ToastService.Success(juntas.Count > 1 ? $"Pago registrado: {juntas.Count} facturas con la misma transferencia" : "Pago registrado en Tesorería");
        await Cargar();
    }

    public void Dispose() { timer?.Dispose(); pausa?.Cancel(); }
