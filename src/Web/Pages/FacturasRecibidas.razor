@page "/compras/facturas-recibidas"
@attribute [Authorize(Roles = "admin")]
@inject ApiClient Api
@inject ToastService ToastService
@inject IJSRuntime JS
@inject NavigationManager Nav
@implements IDisposable

@* 18/11/2026 — Facturas recibidas: lo que nos facturan los proveedores. Las trae de ARCA un robot
   todos los días a las 7 (ARCA las muestra recién al día siguiente) y con "↻ Traer ahora".
   Las que llegaron desde la última vez que abriste esta lista llevan el punto azul ("nuevas");
   al abrirla dejan de ser nuevas en la tarjeta Compras y en la campanita.
   Maqueta aprobada: scratchpad/Compras_e_Impuestos_inicio_PROPUESTA.png *@

<style>
    .fr-top { display:flex; justify-content:space-between; align-items:flex-start; gap:0.8rem; flex-wrap:wrap; }
    .fr-sub { color:#6b7280; font-size:0.85rem; margin-top:0.2rem; }
    .fr-btn { border:1px solid #d1d5db; background:#fff; border-radius:6px; padding:0.35rem 0.7rem; font-size:0.85rem; cursor:pointer; white-space:nowrap; color:#374151; }
    .fr-btn:disabled { opacity:0.55; cursor:default; }
    .fr-fil { display:flex; gap:0.5rem; flex-wrap:wrap; margin:0.9rem 0 0.4rem; }
    .fr-fil .form-input { max-width:260px; }
    .fr-rango { display:flex; align-items:center; gap:0.35rem; font-size:0.85rem; color:#6b7280; }
    .fr-rango .form-input { width:auto; }
    .fr-pag { display:flex; align-items:center; gap:0.3rem; flex-wrap:wrap; justify-content:center; margin:0.8rem 0 0.2rem; font-size:0.85rem; color:#6b7280; }
    .fr-pag > span:first-child { margin-right:0.5rem; }
    .fr-pag button:disabled { opacity:0.4; cursor:default; }
    .fr { width:100%; border-collapse:collapse; font-size:0.9rem; }
    .fr th { font-size:0.7rem; color:#6b7280; text-transform:uppercase; letter-spacing:0.04em; font-weight:600; text-align:left; padding:0.4rem 0.4rem; border-bottom:1px solid #e5e7eb; }
    .fr td { padding:0.45rem 0.4rem; border-bottom:1px solid #f3f4f6; vertical-align:middle; }
    .fr .num { text-align:right; white-space:nowrap; font-variant-numeric:tabular-nums; }
    .fr .gris { color:#6b7280; font-size:0.84rem; }
    .fr .ok { color:#15803d; font-size:0.84rem; }
    .fr .debe { color:#b45309; font-size:0.84rem; }
    .fr .punto { display:inline-block; width:8px; height:8px; border-radius:50%; background:#2563eb; margin-right:0.35rem; }
    .fr-dia td { font-size:0.7rem; font-weight:700; color:#6b7280; text-transform:uppercase; letter-spacing:0.04em; padding-top:0.8rem; border-bottom:1px solid #e5e7eb; }
    .fr a { color:inherit; }
    .fr-pdf { text-decoration:none; }
    /* 18/11/2026 (3ª): tablero "¿en qué se fue la plata?" + pines por grupo */
    .fr-barra { display:flex; height:24px; border-radius:7px; overflow:hidden; margin:0.6rem 0 0.25rem; }
    .fr-barra div { display:flex; align-items:center; justify-content:center; font-size:0.7rem; font-weight:700; color:#fff; white-space:nowrap; overflow:hidden; min-width:2px; cursor:pointer; }
    .fr-ley { display:flex; gap:0.7rem; flex-wrap:wrap; font-size:0.72rem; color:#6b7280; margin-bottom:0.6rem; }
    .fr-ley i { display:inline-block; width:9px; height:9px; border-radius:2px; margin-right:0.25rem; vertical-align:-1px; }
    .fr-tiles { display:grid; grid-template-columns:repeat(auto-fill, minmax(135px, 1fr)); gap:0.55rem; }
    .fr-tile { border-radius:13px; padding:0.6rem 0.5rem; text-align:center; border:2px solid transparent; position:relative; cursor:pointer; }
    .fr-tile:hover { filter:brightness(0.97); }
    .fr-tile .ic { font-size:1.8rem; line-height:1; }
    .fr-tile .t { font-weight:700; font-size:0.8rem; margin-top:0.3rem; }
    .fr-tile .m { font-size:1rem; font-weight:800; margin-top:0.1rem; }
    .fr-tile .n { font-size:0.7rem; opacity:0.75; }
    .fr-tile .pct { position:absolute; top:0.35rem; right:0.5rem; font-size:0.66rem; font-weight:700; opacity:0.7; }
    .fr-tile.on { border-color:#111827; box-shadow:0 4px 14px rgba(0,0,0,.12); }
    .fr-tile.sin { background:#fff; border:2px dashed #f59e0b; color:#92400e; }
    .fr-tile.sin.on { border-style:solid; border-color:#111827; }
    .fr-det { margin-top:0.7rem; border-radius:12px; padding:0.6rem 0.8rem; }
    .fr-det h4 { margin:0 0 0.4rem; font-size:0.85rem; }
    .fr-br { display:grid; grid-template-columns:minmax(150px, 220px) 1fr 110px; gap:0.6rem; align-items:center; margin:0.25rem 0; cursor:pointer; border-radius:6px; padding:0 0.2rem; }
    .fr-br:hover, .fr-br.on { background:rgba(0,0,0,.05); }
    .fr-br .lab { font-weight:600; font-size:0.82rem; }
    .fr-br .track { border-radius:6px; height:14px; background:rgba(255,255,255,.7); }
    .fr-br .fill { border-radius:6px; height:14px; }
    .fr-br .v { text-align:right; font-weight:700; font-size:0.82rem; }
    .fr-av { width:30px; height:30px; flex:0 0 30px; border-radius:50%; display:inline-flex; align-items:center; justify-content:center; font-size:1rem; box-sizing:border-box; }
    .fr-pin { border:0; border-radius:999px; padding:0.2rem 0.65rem; font-size:0.76rem; font-weight:700; white-space:nowrap; cursor:pointer; }
    .fr-pin.vacio { border:2px dashed #f59e0b; color:#92400e; background:#fffbeb; }
    .fr-pick { position:absolute; z-index:30; background:#fff; border:1px solid #e5e7eb; border-radius:12px; box-shadow:0 10px 30px rgba(0,0,0,.18); padding:0.7rem; width:400px; margin-top:0.3rem; }
    .fr-pick .lbl { font-size:0.72rem; color:#6b7280; margin-bottom:0.35rem; }
    .fr-pick .grid { display:grid; grid-template-columns:1fr 1fr; gap:0.35rem; }
    .fr-pick .gb { border:2px solid transparent; border-radius:9px; padding:0.4rem 0.6rem; font-weight:700; font-size:0.8rem; text-align:left; cursor:pointer; }
    .fr-pick .gb.on { border-color:#111827; }
    .fr-pick .dets { display:flex; gap:0.3rem; flex-wrap:wrap; }
    .fr-pick .dp { border:0; border-radius:999px; padding:0.2rem 0.6rem; font-size:0.76rem; font-weight:700; cursor:pointer; }
    .fr-pick .dp.solo { background:#fff; border:1px dashed #9ca3af; color:#6b7280; font-weight:500; }
    .fr-pick .pie { display:flex; justify-content:space-between; margin-top:0.55rem; font-size:0.72rem; color:#6b7280; }
    .fr-pick .pie button { border:0; background:none; color:#6b7280; text-decoration:underline; cursor:pointer; font-size:0.72rem; }
    .fr td { position:relative; }
    /* 18/11/2026 (2ª): categoría, comentario, pagada, sugerencias */
    .fr-chips { display:flex; gap:0.3rem; flex-wrap:wrap; align-items:center; }
    .fr-chip { border:1px solid #d1d5db; background:#fff; border-radius:14px; padding:0.15rem 0.65rem; font-size:0.8rem; color:#374151; cursor:pointer; }
    .fr-chip.on { background:#111827; color:#fff; border-color:#111827; }
    .fr-tot { display:flex; gap:1rem; flex-wrap:wrap; color:#6b7280; font-size:0.84rem; margin-bottom:0.35rem; }
    .fr-tot b { color:#111827; font-weight:600; }
    .fr-cat { border:0; border-bottom:1px dashed #9ca3af; background:none; padding:0; font-size:0.84rem; color:#374151; cursor:pointer; white-space:nowrap; }
    .fr-cat.vacia { color:#9ca3af; }
    .fr-catsel { font-size:0.82rem; padding:0.1rem 0.25rem; border:1px solid #9ca3af; border-radius:5px; max-width:170px; }
    .fr-com { color:#6b7280; font-size:0.78rem; margin-top:0.1rem; cursor:pointer; }
    .fr-com.vacio { color:#c0c4cc; }
    .fr tr:hover .fr-com.vacio { color:#9ca3af; }
    .fr-cominp { width:100%; font-size:0.8rem; padding:0.15rem 0.35rem; border:1px solid #9ca3af; border-radius:5px; margin-top:0.15rem; }
    .fr-via { color:#6b7280; font-size:0.74rem; }
    .fr-lnk { border:0; background:none; padding:0; color:#374151; text-decoration:underline; cursor:pointer; font-size:0.8rem; }
    .fr-auto { font-size:0.62rem; color:#047857; background:#ecfdf5; border-radius:4px; padding:0 0.25rem; margin-left:0.2rem; vertical-align:1px; }
    .fr-pagar { border:0; background:#111827; color:#fff; border-radius:6px; padding:0.1rem 0.5rem; font-size:0.72rem; font-weight:700; cursor:pointer; margin-left:0.35rem; white-space:nowrap; }
    .fr-reg { border:1px solid #059669; background:#fff; color:#047857; border-radius:6px; padding:0 0.45rem; font-size:0.7rem; font-weight:700; cursor:pointer; margin-left:0.35rem; white-space:nowrap; }
    .fr-pagar:disabled, .fr-reg:disabled { opacity:0.5; cursor:wait; }
    .fr-x { border:0; background:none; padding:0 0.2rem; color:#9ca3af; cursor:pointer; font-size:0.78rem; }
    .fr-sug { background:#fffbeb; border:1px solid #fcd34d; border-radius:6px; padding:0.15rem 0.4rem; font-size:0.76rem; color:#92400e; margin-top:0.2rem; display:flex; width:fit-content; max-width:420px; gap:0.3rem; align-items:center; flex-wrap:wrap; }
    .fr-sug button { border:1px solid #d97706; background:#fff; color:#92400e; border-radius:5px; font-size:0.72rem; padding:0 0.4rem; cursor:pointer; }
    .fr-menu { border:1px solid #e5e7eb; border-radius:8px; background:#fff; box-shadow:0 6px 18px rgba(0,0,0,.12); padding:0.4rem; margin-top:0.25rem; font-size:0.8rem; min-width:190px; }
    .fr-menu button.op { display:block; width:100%; text-align:left; border:0; background:none; padding:0.2rem 0.3rem; cursor:pointer; border-radius:4px; }
    .fr-menu button.op:hover { background:#f3f4f6; }
    .fr-menu label { display:flex; gap:0.3rem; align-items:flex-start; color:#6b7280; font-size:0.74rem; margin-top:0.3rem; border-top:1px solid #f1f5f9; padding-top:0.3rem; }
</style>

<div class="card">
    <div class="card-body">
        <div class="fr-top">
            <div>
                <h3 style="margin:0;">🧾 Facturas recibidas</h3>
                <div class="fr-sub">
                    Lo que te facturan los proveedores. Se trae de ARCA todos los días a las 7 (ARCA las muestra al día siguiente de hechas).
                </div>
                <div class="fr-sub">@EstadoTexto()</div>
            </div>
            <button class="fr-btn" disabled="@(estado?.Corriendo == true || iniciando)" @onclick="TraerAhora">
                @(estado?.Corriendo == true || iniciando ? "⏳ Trayendo de ARCA…" : "↻ Traer ahora")
            </button>
        </div>

        <div class="fr-fil">
            <select class="form-input" @bind="mes" @bind:after="Cargar">
                <option value="">Últimos 60 días</option>
                @foreach (var m in Meses())
                {
                    <option value="@m.ToString("yyyy-MM")">@m.ToString("MMMM yyyy", Ar)</option>
                }
                <option value="rango">📅 Elegir fechas…</option>
            </select>
            @if (mes == "rango")
            {
                <span class="fr-rango">desde <input type="date" class="form-input" @bind="desde" @bind:after="Cargar" />
                    hasta <input type="date" class="form-input" @bind="hasta" @bind:after="Cargar" /></span>
            }
            <input class="form-input" placeholder="🔍 Proveedor, CUIT o comentario" @bind="busca" @bind:event="oninput" />
            <div class="fr-chips">
                @foreach (var (k, t) in new[] { ("", "Todas"), ("sin", "Sin pagar"), ("pag", "Pagadas"), ("nose", "No sé") })
                {
                    var kk = k;
                    <button type="button" class="fr-chip @(filtroPago == kk ? "on" : "")" @onclick="() => filtroPago = kk">@t</button>
                }
            </div>
        </div>

        @if (lista is null)
        {
            <p class="text-muted">Cargando...</p>
        }
        else if (lista.Count == 0)
        {
            <p class="text-muted">No hay facturas para mostrar.</p>
        }
        else
        {
            var vis = Visibles();
            // 18/11/2026: de a 50 por página (los totales y el tablero son de todo lo filtrado).
            var firma = $"{mes}|{desde}|{hasta}|{busca}|{filtroPago}|{filtroGrupo}|{filtroDet}";
            if (firma != firmaPag) { firmaPag = firma; pagina = 1; }
            var paginas = Math.Max(1, (vis.Count + PorPagina - 1) / PorPagina);
            if (pagina > paginas) pagina = paginas;
            var pag = vis.Skip((pagina - 1) * PorPagina).Take(PorPagina).ToList();
            <div class="fr-tot">
                <span>@vis.Count comprobante@(vis.Count == 1 ? "" : "s") · <b>@Plata(vis.Sum(f => f.Total))</b>
                    @if (vis.Any(f => f.Nueva)) { <span> · <span class="punto"></span>@vis.Count(f => f.Nueva) nueva@(vis.Count(f => f.Nueva) == 1 ? "" : "s")</span> }</span>
                <span>Sin pagar <b style="color:#b45309;">@Plata(vis.Where(EsSinPagar).Sum(SaldoDe))</b></span>
                <span>No sé <b>@Plata(vis.Where(EsNoSe).Sum(f => f.Total))</b></span>
            </div>
            @Tablero()
            <div class="table-responsive" id="fr-lista">
                <table class="fr">
                    <tr><th>Llegó</th><th>Proveedor</th><th>Categoría</th><th>Comprobante</th><th>Fecha</th><th class="num">Importe</th><th>¿Pagada?</th><th></th></tr>
                    @foreach (var f in pag)
                    {
                        var (gr, de) = Cat(f.Categoria);
                        <tr>
                            <td style="white-space:nowrap; box-shadow: inset 5px 0 0 @(gr?.Fuerte ?? "#f59e0b");">@if (f.Nueva) { <span class="punto" title="Nueva"></span> }@f.Llego.ToArTime().ToString("dd/MM")</td>
                            <td>
                                <div style="display:flex; gap:0.5rem; align-items:flex-start;">
                                <span class="fr-av" style="background:@(gr?.Suave ?? "#fffbeb"); @(gr is null ? "border:2px dashed #f59e0b;" : "")">@(de?.Icono ?? gr?.Icono ?? "❔")</span>
                                <div style="min-width:0;">
                                @if (f.ProveedorId is int pid)
                                {
                                    <a href="/cafe/proveedores/@pid/estado-cuenta"><b>@f.Proveedor</b></a>
                                }
                                else { <b>@f.Proveedor</b> }
                                @if (editCom == f.Id)
                                {
                                    <input class="fr-cominp" @bind="textoCom" @bind:event="oninput" @onkeydown="e => TeclaComentario(e, f)" @onblur="() => GuardarComentario(f)"
                                           placeholder="Nota de esta factura (Enter guarda, Esc cancela)" maxlength="500" autofocus />
                                }
                                else if (!string.IsNullOrWhiteSpace(f.Comentario))
                                {
                                    <div class="fr-com" title="Tocá para cambiar la nota" @onclick="() => EditarComentario(f)">✎ @f.Comentario</div>
                                }
                                else
                                {
                                    <div class="fr-com vacio" title="Agregar una nota a esta factura" @onclick="() => EditarComentario(f)">✎ agregar comentario</div>
                                }
                                </div></div>
                            </td>
                            <td>
                                @if (f.Cuit is null) { <span class="gris">—</span> }
                                else
                                {
                                    <button type="button" class="fr-pin @(gr is null ? "vacio" : "")" style="@(gr is null ? "" : $"background:{gr.Suave}; color:{gr.Texto};")"
                                            title="Es del proveedor: vale para todas sus facturas" @onclick="() => AbrirPicker(f)">
                                        @if (gr is null) { <span>＋ ponerle categoría</span> }
                                        else { <span>@gr.Icono @gr.Nombre@(de is null ? "" : " › " + de.Nombre)</span> }
                                    </button>
                                    @if (editCat == f.Id) { @Picker(f) }
                                }
                            </td>
                            <td class="gris">@(f.EsNotaCredito ? "Nota de crédito" : f.Tipo) @f.Numero</td>
                            <td class="gris">@f.Fecha?.ToString("dd/MM/yy")</td>
                            <td class="num">@Plata(f.Total)</td>
                            <td>@CeldaPago(f)</td>
                            <td style="text-align:right;">
                                @if (f.TienePdf)
                                {
                                    <a class="fr-pdf" href="/api/contadora/factura-pdf?id=@Uri.EscapeDataString(f.Id)" target="_blank" title="Ver el PDF">📎</a>
                                }
                            </td>
                        </tr>
                    }
                </table>
            </div>
            @if (paginas > 1)
            {
                <div class="fr-pag">
                    <span>Mostrando @((pagina - 1) * PorPagina + 1)–@Math.Min(pagina * PorPagina, vis.Count) de @vis.Count</span>
                    <button type="button" class="fr-chip" disabled="@(pagina == 1)" @onclick="() => IrA(pagina - 1)">‹ Anterior</button>
                    @for (var n = 1; n <= paginas; n++)
                    {
                        var nn = n;
                        if (paginas > 9 && nn != 1 && nn != paginas && Math.Abs(nn - pagina) > 2) { if (nn == 2 || nn == paginas - 1) { <span>…</span> } continue; }
                        <button type="button" class="fr-chip @(nn == pagina ? "on" : "")" @onclick="() => IrA(nn)">@nn</button>
                    }
                    <button type="button" class="fr-chip" disabled="@(pagina == paginas)" @onclick="() => IrA(pagina + 1)">Siguiente ›</button>
                </div>
            }
            <div class="fr-sub" style="margin-top:0.6rem;">"¿Pagada?" sale de la cuenta corriente (proveedores que la llevan), de lo que marcaste a mano, o de la regla del proveedor ("se paga por débito / tarjeta / MP"). En amarillo: un pago de Mercado Pago o del Galicia por casi el mismo importe — confirmalo con Sí o No (si es del Galicia, con Sí queda cargado el pago en Tesorería). 💸 Pagar abre el Nuevo pago ya completo; 🏦 Registrar el pago carga como pago la transferencia que el sistema encontró.</div>
        }
    </div>
</div>

@code {
    private static readonly System.Globalization.CultureInfo Ar = System.Globalization.CultureInfo.GetCultureInfo("es-AR");
    private List<ApiClient.FacturaRecibidaDto>? lista;
    private ApiClient.FacturasEstadoDto? estado;
    private string mes = "", busca = "";
    // 18/11/2026: "Elegir fechas" (mes == "rango") y páginas de 50.
    private DateTime? desde = FechaPalabras.HoyAr.AddDays(-30), hasta = FechaPalabras.HoyAr;
    private const int PorPagina = 50;
    private int pagina = 1;
    private string? firmaPag;
    private async Task IrA(int n)
    {
        pagina = n;
        StateHasChanged();
        try { await JS.InvokeVoidAsync("eval", "document.getElementById('fr-lista')?.scrollIntoView({block:'start'})"); } catch { }
    }
    private bool iniciando;
    private System.Threading.Timer? timer;
    private CancellationTokenSource? pausa;

    protected override async Task OnInitializedAsync()
    {
        await Cargar();
        // 19/11/2026: todos los que nos facturan pasan a ser proveedores (se crean solos los que faltan).
        try
        {
            var n = await Api.CrearProveedoresFaltantesAsync();
            if (n > 0) { ToastService.Success($"Se agregaron {n} proveedores nuevos desde ARCA"); await Cargar(); }
        }
        catch { }
        // Al abrirla, lo que hay deja de ser "nuevo" (los puntos azules se ven esta vez).
        try { await Api.MarcarFacturasRecibidasVistasAsync(); } catch { }
    }

    private async Task Cargar()
    {
        try
        {
            lista = await Api.GetFacturasRecibidasAsync(mes == "rango" ? null : mes, null, mes == "rango" ? desde : null, mes == "rango" ? hasta : null);
            estado = await Api.GetFacturasRecibidasEstadoAsync();
        }
        catch (Exception ex) { lista ??= new(); ToastService.Error(ex.Message); }
    }

    private async Task BuscarConPausa()
    {
        pausa?.Cancel();
        pausa = new CancellationTokenSource();
        var t = pausa.Token;
        try { await Task.Delay(350, t); } catch { return; }
        await Cargar();
    }

    private static IEnumerable<DateTime> Meses()
    {
        var h = FechaPalabras.HoyAr;
        var m = new DateTime(h.Year, h.Month, 1);
        for (var i = 0; i < 12; i++) yield return m.AddMonths(-i);
    }

    private string EstadoTexto()
    {
        if (estado is null) return "";
        if (estado.Corriendo || iniciando) return "Entrando a ARCA… tarda 1 a 3 minutos.";
        var u = estado.Ultima is DateTime d ? "Última vez que se trajo: " + Cuando(d) : "Todavía no se trajo con el robot nuevo.";
        var r = estado.Resultado;
        return string.IsNullOrWhiteSpace(r) ? u : (r.StartsWith("⚠") ? $"{u} · {r}" : u);
    }

    public static string Cuando(DateTime utc)
    {
        var d = utc.ToArTime();
        var hoy = FechaPalabras.HoyAr;
        var dia = d.Date == hoy ? "hoy" : d.Date == hoy.AddDays(-1) ? "ayer" : d.ToString("dd/MM");
        return $"{dia} {d:HH:mm}";
    }

    private async Task TraerAhora()
    {
        iniciando = true;
        try
        {
            if (!await Api.TraerFacturasRecibidasAhoraAsync()) { ToastService.Error("No se pudo arrancar"); iniciando = false; return; }
            ToastService.Success("Entrando a ARCA… cuando termine se actualiza la lista sola");
            timer?.Dispose();
            timer = new System.Threading.Timer(async _ => await InvokeAsync(Revisar), null, 5000, 5000);
        }
        catch (Exception ex) { ToastService.Error(ex.Message); iniciando = false; }
    }

    private async Task Revisar()
    {
        try
        {
            estado = await Api.GetFacturasRecibidasEstadoAsync();
            if (estado is { Corriendo: false })
            {
                timer?.Dispose(); timer = null; iniciando = false;
                lista = await Api.GetFacturasRecibidasAsync(mes == "rango" ? null : mes, null, mes == "rango" ? desde : null, mes == "rango" ? hasta : null);
                if (estado.Resultado?.StartsWith("⚠") == true) ToastService.Error(estado.Resultado);
                else ToastService.Success("Listo: facturas actualizadas");
                try { await Api.MarcarFacturasRecibidasVistasAsync(); } catch { }
            }
            StateHasChanged();
        }
        catch { }
    }

    private static string Plata(decimal v) => "$" + v.ToString("N0", Ar);

    // ═══════════ 18/11/2026 (2ª): categorías, comentarios, pagada ═══════════
    private string filtroPago = "", filtroGrupo = "", filtroDet = "";
    private string? pickGrupo;
    private string? editCat, editCom, menuPago;
    private string textoCom = "";
    private bool reglaSiempre;

    private static bool EsSinPagar(ApiClient.FacturaRecibidaDto f) => f.Pago == "a pagar" || f.Pago?.StartsWith("debe") == true;
    private static bool EsNoSe(ApiClient.FacturaRecibidaDto f) => !f.EsNotaCredito && (f.Pago is null || f.Pago.StartsWith("anterior"));
    private static decimal SaldoDe(ApiClient.FacturaRecibidaDto f)
    {
        if (f.Pago?.StartsWith("debe ") == true && decimal.TryParse(f.Pago[5..].Replace("$", "").Replace(".", ""), out var d)) return d;
        return f.Total;
    }

    private List<ApiClient.FacturaRecibidaDto> Visibles()
    {
        var l = FiltroPagoYBusca();
        if (filtroGrupo == "-") l = l.Where(f => !f.EsNotaCredito && Cat(f.Categoria).Grupo is null).ToList();
        else if (filtroGrupo != "")
        {
            l = l.Where(f => Cat(f.Categoria).Grupo?.Nombre == filtroGrupo).ToList();
            if (filtroDet != "") l = l.Where(f => Cat(f.Categoria).Detalle?.Nombre == filtroDet).ToList();
        }
        return l;
    }

    /// <summary>Búsqueda + Todas/Sin pagar/Pagadas/No sé, SIN el filtro de grupo (las tarjetas muestran todos los grupos).</summary>
    private List<ApiClient.FacturaRecibidaDto> FiltroPagoYBusca()
    {
        IEnumerable<ApiClient.FacturaRecibidaDto> l = lista ?? new();
        var b = (busca ?? "").Trim();
        if (b != "")
            l = l.Where(f => f.Proveedor.Contains(b, StringComparison.OrdinalIgnoreCase) || (f.Cuit ?? "").Contains(b)
                          || (f.Comentario ?? "").Contains(b, StringComparison.OrdinalIgnoreCase) || f.Numero.Contains(b)
                          || (f.Categoria ?? "").Contains(b, StringComparison.OrdinalIgnoreCase));
        l = filtroPago switch
        {
            "sin" => l.Where(EsSinPagar),
            "pag" => l.Where(f => f.Pago == "pagada"),
            "nose" => l.Where(EsNoSe),
            _ => l,
        };
        return l.ToList();
    }

    private void Reemplazar(string id, Func<ApiClient.FacturaRecibidaDto, ApiClient.FacturaRecibidaDto> cambio)
    {
        if (lista is null) return;
        lista = lista.Select(x => x.Id == id ? cambio(x) : x).ToList();
    }

    // ── Comentario ──
    private void EditarComentario(ApiClient.FacturaRecibidaDto f) { editCom = f.Id; textoCom = f.Comentario ?? ""; }
    private async Task TeclaComentario(KeyboardEventArgs e, ApiClient.FacturaRecibidaDto f)
    {
        if (e.Key == "Escape") editCom = null;
        else if (e.Key == "Enter") await GuardarComentario(f);
    }
    private async Task GuardarComentario(ApiClient.FacturaRecibidaDto f)
    {
        if (editCom != f.Id) return;
        editCom = null;
        var t = textoCom.Trim();
        if (t == (f.Comentario ?? "")) return;
        if (await Api.GuardarComentarioFacturaAsync(f.Id, t)) Reemplazar(f.Id, x => x with { Comentario = t == "" ? null : t });
        else ToastService.Error("No se pudo guardar la nota");
    }

    // ── Categoría (del proveedor) ──
    // 18/11/2026 (3ª): categorías en DOS niveles, como el plan de cuentas de Tango: el GRUPO (en qué se fue
    // la plata) y adentro el DETALLE. Se guarda en Compras_ProveedorConfig.Categoria como "Grupo" o
    // "Grupo › Detalle" (sin cambiar la base). Lo viejo que no está en la lista cae en "Otros".
    private sealed record Det(string Nombre, string Icono);
    private sealed record Grupo(string Nombre, string Icono, string Suave, string Fuerte, string Texto, Det[] Detalles);
    private const string Sep = " › ";
    private static readonly Grupo[] Grupos =
    {
        new("Mercadería", "📦", "#e0f2fe", "#0284c7", "#075985", Array.Empty<Det>()),
        new("Mercado Libre", "🛒", "#fef9c3", "#ca8a04", "#854d0e", new Det[] { new("Comisiones", "💸"), new("Envíos", "🚚") }),
        new("Vehículos", "🚗", "#fef3c7", "#d97706", "#92400e", new Det[] { new("Combustible", "⛽"), new("Peajes", "🛣"), new("Reparaciones y repuestos", "🔧"), new("Seguro", "🛡"), new("VTV y patentes", "📋") }),
        new("Local y oficina", "🏪", "#ede9fe", "#7c3aed", "#5b21b6", new Det[] { new("Alarma", "🚨"), new("Mantenimiento", "🛠"), new("Limpieza", "🧽"), new("Imprenta y librería", "🖨"), new("Equipos y herramientas", "🧰"), new("Seguro", "🛡") }),
        new("Teléfono e internet", "📱", "#dcfce7", "#16a34a", "#166534", Array.Empty<Det>()),
        new("Bancos e impuestos", "🏦", "#f1f5f9", "#64748b", "#334155", Array.Empty<Det>()),
        // 18/11/2026: honorarios y gastos de administrar el negocio (en Tango: "Gastos de administración").
        new("Administración", "🗂", "#cffafe", "#0891b2", "#155e75", new Det[] { new("Contadora", "🧮"), new("Abogado y escribano", "⚖"), new("Sistemas y suscripciones", "💻") }),
        new("Otros", "📎", "#fce7f3", "#db2777", "#9d174d", Array.Empty<Det>()),
    };

    private static (Grupo? Grupo, Det? Detalle) Cat(string? c)
    {
        if (string.IsNullOrWhiteSpace(c)) return (null, null);
        var p = c.Split(Sep, 2);
        var g = Grupos.FirstOrDefault(x => x.Nombre == p[0]);
        if (g is null) return (Grupos[^1], null);   // categoría vieja suelta → Otros
        var d = p.Length > 1 ? g.Detalles.FirstOrDefault(x => x.Nombre == p[1]) : null;
        return (g, d);
    }

    private void AbrirPicker(ApiClient.FacturaRecibidaDto f)
    {
        if (editCat == f.Id) { editCat = null; return; }
        editCat = f.Id;
        pickGrupo = Cat(f.Categoria).Grupo?.Nombre;
    }

    private async Task ElegirGrupo(ApiClient.FacturaRecibidaDto f, Grupo g)
    {
        pickGrupo = g.Nombre;
        if (g.Detalles.Length == 0) await Guardar(f, g.Nombre);
    }

    private async Task Guardar(ApiClient.FacturaRecibidaDto f, string? cat)
    {
        editCat = null;
        if (f.Cuit is null) return;
        if (!await Api.PonerCategoriaProveedorAsync(f.Cuit, cat)) { ToastService.Error("No se pudo guardar la categoría"); return; }
        if (lista is not null) lista = lista.Select(x => x.Cuit == f.Cuit ? x with { Categoria = cat } : x).ToList();
        var n = lista?.Count(x => x.Cuit == f.Cuit) ?? 1;
        ToastService.Success(cat is null ? "Categoría sacada" : $"{f.Proveedor}: {cat}" + (n > 1 ? $" (sus {n} facturas)" : ""));
    }

    private void FiltrarGrupo(string g)
    {
        if (filtroGrupo == g) { filtroGrupo = ""; filtroDet = ""; }
        else { filtroGrupo = g; filtroDet = ""; }
    }

    private static string Corto(decimal v)
    {
        var a = Math.Abs(v);
        if (a >= 1_000_000m) return "$" + (v / 1_000_000m).ToString(a >= 100_000_000m ? "N0" : "N1", Ar) + " M";
        return "$" + v.ToString("N0", Ar);
    }

    private static string Pct(decimal parte, decimal total)
    {
        if (total <= 0) return "";
        var p = parte / total * 100m;
        return p >= 10 ? p.ToString("N0", Ar) + "%" : p >= 0.1m ? p.ToString("N1", Ar) + "%" : "";
    }

    /// <summary>Arriba: "¿en qué se fue la plata?" — barra de proporción, una tarjeta por grupo y el detalle del elegido.</summary>
    private RenderFragment Tablero() => __builder =>
    {
        var basel = FiltroPagoYBusca().Where(f => !f.EsNotaCredito).ToList();
        var total = basel.Sum(f => f.Total);
        var porGrupo = Grupos.Select(g => (G: g, L: basel.Where(f => Cat(f.Categoria).Grupo == g).ToList()))
                             .Where(x => x.L.Count > 0).OrderByDescending(x => x.L.Sum(f => f.Total)).ToList();
        var sin = basel.Where(f => Cat(f.Categoria).Grupo is null).ToList();
        if (total <= 0) return;
        <div class="fr-barra">
            @foreach (var (g, l) in porGrupo)
            {
                var gn = g.Nombre; var t = l.Sum(f => f.Total);
                <div style="flex:@(((double)t).ToString(System.Globalization.CultureInfo.InvariantCulture)); background:@g.Fuerte;" title="@g.Nombre @Corto(t) · @Pct(t, total)" @onclick="() => FiltrarGrupo(gn)">
                    @(t / total >= 0.12m ? $"{g.Icono} {g.Nombre} {Pct(t, total)}" : t / total >= 0.025m ? g.Icono : "")
                </div>
            }
            @if (sin.Count > 0)
            {
                var t = sin.Sum(f => f.Total);
                <div style="flex:@(((double)t).ToString(System.Globalization.CultureInfo.InvariantCulture)); background:#d1d5db; color:#374151;" title="Sin categoría @Corto(t)" @onclick='() => FiltrarGrupo("-")'>@(t / total >= 0.04m ? "❔ " + Pct(t, total) : "")</div>
            }
        </div>
        <div class="fr-ley">
            @foreach (var (g, l) in porGrupo) { <span><i style="background:@g.Fuerte;"></i>@g.Nombre @Pct(l.Sum(f => f.Total), total)</span> }
            @if (sin.Count > 0) { <span><i style="background:#d1d5db;"></i>Sin categoría</span> }
        </div>
        <div class="fr-tiles">
            @foreach (var (g, l) in porGrupo)
            {
                var gn = g.Nombre; var t = l.Sum(f => f.Total);
                <div class="fr-tile @(filtroGrupo == gn ? "on" : "")" style="background:@g.Suave; color:@g.Texto;" @onclick="() => FiltrarGrupo(gn)" title="Tocá para ver solo @g.Nombre">
                    <span class="pct">@Pct(t, total)</span>
                    <div class="ic">@g.Icono</div>
                    <div class="t">@g.Nombre</div>
                    <div class="m">@Corto(t)</div>
                    <div class="n">@l.Count factura@(l.Count == 1 ? "" : "s")</div>
                </div>
            }
            @if (sin.Count > 0)
            {
                <div class="fr-tile sin @(filtroGrupo == "-" ? "on" : "")" @onclick='() => FiltrarGrupo("-")' title="Las que falta clasificar">
                    <div class="ic">❔</div>
                    <div class="t">Sin categoría</div>
                    <div class="m">@sin.Count</div>
                    <div class="n">tocá para completarlas</div>
                </div>
            }
        </div>
        var sel = Grupos.FirstOrDefault(g => g.Nombre == filtroGrupo);
        if (sel is not null && sel.Detalles.Length > 0)
        {
            var lg = basel.Where(f => Cat(f.Categoria).Grupo == sel).ToList();
            var tg = lg.Sum(f => f.Total);
            var filas = sel.Detalles.Select(d => (D: d, T: lg.Where(f => Cat(f.Categoria).Detalle == d).Sum(f => f.Total))).Where(x => x.T != 0).OrderByDescending(x => x.T).ToList();
            var suelto = lg.Where(f => Cat(f.Categoria).Detalle is null).Sum(f => f.Total);
            var max = Math.Max(1m, filas.Select(x => x.T).DefaultIfEmpty(0).Max());
            max = Math.Max(max, suelto);
            <div class="fr-det" style="background:@sel.Suave; color:@sel.Texto;">
                <h4>@sel.Icono @sel.Nombre por dentro · @Corto(tg) <span style="font-weight:400; opacity:.75;">· tocá un renglón para ver solo esas</span></h4>
                @foreach (var (d, t) in filas)
                {
                    var dn = d.Nombre;
                    <div class="fr-br @(filtroDet == dn ? "on" : "")" @onclick='() => filtroDet = filtroDet == dn ? "" : dn'>
                        <span class="lab">@d.Icono @d.Nombre</span>
                        <div class="track"><div class="fill" style="width:@(((double)(t / max * 100m)).ToString("0.#", System.Globalization.CultureInfo.InvariantCulture))%; background:@sel.Fuerte;"></div></div>
                        <span class="v">@Plata(t)</span>
                    </div>
                }
                @if (suelto != 0)
                {
                    <div class="fr-br" style="cursor:default;">
                        <span class="lab" style="opacity:.75;">sin detalle</span>
                        <div class="track"><div class="fill" style="width:@(((double)(suelto / max * 100m)).ToString("0.#", System.Globalization.CultureInfo.InvariantCulture))%; background:@sel.Fuerte; opacity:.5;"></div></div>
                        <span class="v">@Plata(suelto)</span>
                    </div>
                }
            </div>
        }
    };

    /// <summary>Selector: 1) el grupo (con su color) 2) el detalle, opcional.</summary>
    private RenderFragment Picker(ApiClient.FacturaRecibidaDto f) => __builder =>
    {
        var g = Grupos.FirstOrDefault(x => x.Nombre == pickGrupo);
        <div class="fr-pick" @onclick:stopPropagation="true">
            <div class="lbl">1) ¿En qué se fue la plata?</div>
            <div class="grid">
                @foreach (var gg in Grupos)
                {
                    var g2 = gg;
                    <button type="button" class="gb @(pickGrupo == gg.Nombre ? "on" : "")" style="background:@gg.Suave; color:@gg.Texto;" @onclick="() => ElegirGrupo(f, g2)">@gg.Icono @gg.Nombre</button>
                }
            </div>
            @if (g is not null && g.Detalles.Length > 0)
            {
                <div class="lbl" style="margin-top:0.6rem;">2) Detalle (opcional)</div>
                <div class="dets">
                    @foreach (var d in g.Detalles)
                    {
                        var cat = g.Nombre + Sep + d.Nombre;
                        <button type="button" class="dp" style="background:@g.Suave; color:@g.Texto;" @onclick="() => Guardar(f, cat)">@d.Icono @d.Nombre</button>
                    }
