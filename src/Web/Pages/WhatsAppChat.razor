    async Task OnSubirSonido(InputFileChangeEventArgs e)
    {
        var file = e.File;
        if (file == null) return;
        if (file.Size > 300_000)
        {
            Toast.Warning("El sonido es muy pesado. Tiene que pesar menos de 300 KB — un aviso de uno o dos segundos entra de sobra.");
            return;
        }
        subiendoSonido = true;
        StateHasChanged();
        try
        {
            using var stream = file.OpenReadStream(maxAllowedSize: 400_000);
            var mime = string.IsNullOrEmpty(file.ContentType) ? "audio/mpeg" : file.ContentType;
            var (ok, err, dto) = await Api.SubirTwSonidoAsync(stream, file.Name, mime, nuevoSonidoNombre ?? "");
            if (!ok) { Toast.Error(err ?? "No se pudo subir el sonido"); return; }
            nuevoSonidoNombre = "";
            await CargarSonidosSubidos();
            // Lo dejamos elegido y lo hacemos sonar, para que se escuche cómo quedó.
            if (dto != null)
            {
                editLineaSonido = dto.Clave;
                await ProbarSonido(dto.Clave);
                Toast.Success($"Sonido \"{dto.Nombre}\" agregado ✓");
            }
        }
        catch (Exception ex) { Toast.Error("No se pudo leer el archivo: " + ex.Message); }
        finally { subiendoSonido = false; StateHasChanged(); }
    }

    async Task BorrarSonidoSubido(ApiClient.TwSonidoDto s)
    {
        subiendoSonido = true;
        StateHasChanged();
        try
        {
            var (ok, err) = await Api.BorrarTwSonidoAsync(s.Id);
            if (!ok) { Toast.Error(err ?? "No se pudo borrar"); return; }
            await CargarSonidosSubidos();
            // Si era el que estaba elegido acá, volvemos a la campanita.
            if (editLineaSonido == s.Clave) editLineaSonido = "chime";
            Toast.Info($"Sonido \"{s.Nombre}\" borrado");
        }
        finally { subiendoSonido = false; StateHasChanged(); }
    }

