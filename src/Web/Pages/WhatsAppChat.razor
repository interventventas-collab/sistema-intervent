    /// <summary>Nombre lindo de un sonido, sea de los del sistema o uno subido.</summary>
    string NombreSonido(string? clave)
    {
        if (string.IsNullOrEmpty(clave)) return "campanita";
        var sub = sonidosSubidos.FirstOrDefault(x => x.Clave == clave);
        if (sub != null) return sub.Nombre;
        foreach (var s in SonidosDisponibles)
            if (s.Key == clave)
            {
                // El Label del desplegable trae emoji y el "(default)"; acá va adentro de un
                // paréntesis, así que lo dejamos en el nombre pelado: "El de la línea (Moneda)".
                var t = s.Label;
                var esp = t.IndexOf(' ');
                if (esp > 0 && esp <= 3) t = t.Substring(esp + 1);
                return t.Replace(" (default)", "").Trim();
            }
        return clave!;
    }

