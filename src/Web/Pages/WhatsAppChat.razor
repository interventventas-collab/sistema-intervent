    .wa-ficha-saldo.aldia .wa-ficha-saldo-monto { color: #16a34a; }
    .wa-ficha-facs-titulo { font-size: 0.78rem; text-transform: uppercase; letter-spacing: 0.03em; color: #9ca3af; font-weight: 700; margin-bottom: 0.35rem; }
    .wa-ficha-vacio { font-size: 0.84rem; color: #9ca3af; padding: 0.3rem 0; }
    .wa-ficha-facs { display: flex; flex-direction: column; gap: 0.3rem; max-height: 220px; overflow-y: auto; }
    .wa-ficha-fac { display: flex; align-items: center; gap: 0.5rem; padding: 0.4rem 0.55rem; background: #f9fafb; border: 1px solid #eef1f5; border-radius: 8px; text-decoration: none; color: #374151; font-size: 0.82rem; transition: all .12s; }
