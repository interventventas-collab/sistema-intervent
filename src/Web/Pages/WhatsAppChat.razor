    .wa-ficha-fac-tipo { background: #e5e7eb; color: #374151; font-size: 0.68rem; font-weight: 700; padding: 0.05rem 0.35rem; border-radius: 4px; min-width: 2rem; text-align: center; }
    .wa-ficha-fac-num { font-weight: 600; }
    .wa-ficha-fac-fecha { color: #9ca3af; font-size: 0.76rem; }
    .wa-ficha-fac-total { margin-left: auto; font-weight: 700; }
    .wa-ficha-fac-estado { font-size: 0.7rem; font-weight: 700; padding: 0.08rem 0.4rem; border-radius: 5px; white-space: nowrap; }
    .wa-ficha-fac-estado.pagada { background: #dcfce7; color: #15803d; }
    .wa-ficha-fac-estado.debe { background: #fee2e2; color: #b91c1c; }
    .wa-ficha-fac-estado.nc { background: #ede9fe; color: #6d28d9; }
    .wa-ficha-fac.hover { background: #eef2ff; border-color: #c7d2fe; }
    /* 2026-08-05: mini vista previa del PDF de la factura al pasar el mouse */
    .wa-ficha-facswrap { position: relative; }
    .wa-ficha-preview { margin-top: 0.5rem; border: 1px solid #e5e7eb; border-radius: 10px; overflow: hidden; background: #f9fafb; box-shadow: 0 4px 14px rgba(0,0,0,0.08); animation: waFichaIn .14s ease; }
    .wa-ficha-preview-head { font-size: 0.72rem; color: #6b7280; padding: 0.3rem 0.55rem; background: #f3f4f6; border-bottom: 1px solid #e5e7eb; }
    .wa-ficha-preview-frame { width: 100%; height: 340px; border: none; display: block; background: #fff; }
    /* 2026-08-03: opciones del buscador de "Vincular cliente" */
    .wa-vincular-opt { display: block; width: 100%; text-align: left; background: #f9fafb; border: 1px solid #e5e7eb; border-radius: 8px; padding: 0.55rem 0.65rem; margin-bottom: 0.35rem; font-size: 0.9rem; cursor: pointer; transition: all .12s; }
    .wa-vincular-opt:hover:not(:disabled) { background: #ecfdf5; border-color: #16a34a; }
    .wa-vincular-opt:disabled { opacity: 0.6; cursor: wait; }
    .wa-vincular-nuevo { margin-top: 0.7rem; padding-top: 0.7rem; border-top: 1px dashed #e5e7eb; }
    /* 2026-08-05: columna izquierda del composer = miniatura Menú rol (arriba) + redondeles (abajo) */
    .wa-composer-left { display: flex; flex-direction: column; gap: 0.4rem; align-items: flex-start; flex-shrink: 0; }
    .wa-composer-tools { display: flex; flex-wrap: wrap; gap: 0.5rem; align-items: center; max-width: 156px; }
    /* MENÚ ROL — miniatura (MEDIA de grande) de lo que le llega al cliente */
    .wa-menurol-mini { display: block; margin: 0; padding: 0; background: transparent; border: none; cursor: pointer; text-align: left; width: max-content; }
    .wa-menurol-mini:disabled { opacity: 0.6; cursor: wait; }
    .wa-menurol-cap { font-size: 0.6rem; color: #6b7280; font-weight: 600; margin-bottom: 0.18rem; max-width: 140px; }
    .wa-menurol-bubble { width: 132px; background: #fff; border: 1px solid #e5e7eb; border-radius: 9px; overflow: hidden; box-shadow: 0 2px 7px rgba(0,0,0,0.09); transition: all .15s; }
    .wa-menurol-mini:hover:not(:disabled) .wa-menurol-bubble { border-color: #25d366; box-shadow: 0 5px 14px rgba(37,211,102,0.30); transform: translateY(-2px); }
    .wa-menurol-txt { padding: 0.32rem 0.4rem; font-size: 0.58rem; color: #111b21; line-height: 1.22; }
    .wa-menurol-opt { border-top: 1px solid #eef1f5; padding: 0.28rem 0.3rem; text-align: center; font-size: 0.62rem; color: #027eb5; font-weight: 600; }
    .wa-attach-btn { display: inline-flex; align-items: center; justify-content: center; width: 42px; height: 42px; border-radius: 50%; background: #fff; border: 1px solid #e0e0e0; cursor: pointer; font-size: 1.3rem; transition: all .15s; user-select: none; }
    .wa-attach-btn:hover { background: #e9f5ff; border-color: #25d366; transform: translateY(-1px); }
    .wa-attach-btn.uploading { background: #fff8e1; border-color: #ffc107; cursor: wait; animation: wa-attach-pulse 1s ease-in-out infinite; }
    @@keyframes wa-attach-pulse { 0%,100% { opacity: 1; } 50% { opacity: 0.6; } }
    .wa-mic-btn:hover { background: #ffe9ec; border-color: #ef4444; }
    .wa-mic-rec { background: #fee2e2; border-color: #ef4444; animation: wa-attach-pulse 1s ease-in-out infinite; }
    .wa-mic-rec-label { display: inline-flex; align-items: center; font-size: 0.8rem; color: #dc2626; font-weight: 600; white-space: nowrap; }
    .wa-quick-replies { padding: 0.6rem 1rem 0.2rem; background: #fbfcfe; display: flex; gap: 0.45rem; flex-wrap: wrap; border-top: 1px solid #eef1f5; }
    /* 2026-08-05: contador de la ventana de 24hs (reloj de arena + estado) */
    /* 2026-08-05: columna derecha del composer = desplegable de respuestas rápidas (arriba) + Enviar (abajo) */
    .wa-composer-right { display: flex; flex-direction: column; gap: 0.4rem; align-items: stretch; justify-content: flex-end; flex-shrink: 0; }
    .wa-alta-cliente-btn { width: 100%; background: #ecfdf5; border: 1px solid #a7f3d0; color: #047857; border-radius: 12px; padding: 0.5rem 0.8rem; font-size: 0.82rem; font-weight: 700; cursor: pointer; white-space: nowrap; transition: all .12s; }
