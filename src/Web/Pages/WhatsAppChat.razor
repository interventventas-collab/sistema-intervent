    // ===== Adjuntar archivo de la PC =====
    const long MaxUploadBytes = 16L * 1024 * 1024; // 16 MB (limite WhatsApp)

    async Task OnArchivoSeleccionado(InputFileChangeEventArgs e)
    {
        if (selectedNumero == null) { Toast.Warning("Seleccioná primero un chat"); return; }
        var file = e.File;
        if (file == null) return;
        if (file.Size > MaxUploadBytes) { Toast.Error($"El archivo {file.Name} supera los 16 MB"); return; }

        using var stream = file.OpenReadStream(MaxUploadBytes);
        await SubirYStagear(stream, file.Name, file.ContentType);
    }

    // 2026-08-05: BANDEJA DE PENDIENTES. Antes cada adjunto salía SOLO al instante. Ahora el clip 📎,
    // el pegado (Ctrl/Win+V) y "Adjuntar del servidor" DEJAN el archivo esperando arriba del cajón;
    // el operador escribe un texto tranquilo y con Enter/Enviar sale TODO junto (el texto va de pie
    // de foto del primer adjunto), como en WhatsApp de verdad. Un archivo se saca con la ✖.
    async Task SubirYStagear(System.IO.Stream stream, string fileName, string contentType)
    {
        if (selectedNumero == null) { Toast.Warning("Seleccioná primero un chat"); return; }
        uploading = true;
        StateHasChanged();
        try
        {
            // Subir al servidor (devuelve URL pública con token). Todavía NO se envía: queda pendiente.
            var (resp, err) = await Api.UploadTwArchivoAsync(stream, fileName, contentType);
            if (resp == null) { Toast.Error($"Error subiendo: {err}"); return; }

            var esImg = (contentType ?? "").StartsWith("image/") || IsImage(fileName) || IsImage(resp.Url);
            pendientes.Add(new PendingAdjunto
            {
                Kind = "UPLOAD",
                Url = resp.Url,
                FileName = fileName,
                Label = fileName,
                EsImagen = esImg,
                PreviewUrl = esImg ? resp.Url : null,
                Icono = esImg ? "🖼️" : "📎"
            });
        }
        catch (Exception ex) { Toast.Error($"Error: {ex.Message}"); }
        finally { uploading = false; StateHasChanged(); }
    }

    // 2026-07-29: recibe desde JS (wa-paste.js) una captura pegada con Ctrl+V / Win+V y la envía.
    [Microsoft.JSInterop.JSInvokable]
    public async Task RecibirImagenPegada(string base64, string fileName, string contentType)
    {
        if (selectedNumero == null) { Toast.Warning("Seleccioná primero un chat para pegar la captura"); return; }
        byte[] bytes;
        try { bytes = Convert.FromBase64String(base64); }
        catch { Toast.Error("No se pudo leer la imagen pegada"); return; }
        if (bytes.Length == 0) return;
        if (bytes.Length > MaxUploadBytes) { Toast.Error("La captura supera los 16 MB"); return; }
        using var stream = new System.IO.MemoryStream(bytes);
        await SubirYStagear(stream, fileName, string.IsNullOrWhiteSpace(contentType) ? "image/png" : contentType);
    }

    // ===== 2026-08-05: BANDEJA DE PENDIENTES (adjuntar + texto y sale todo junto) =====
    class PendingAdjunto
    {
        public string Kind = "UPLOAD";      // UPLOAD (archivo subido) | SERVER (archivo del servidor)
        // UPLOAD
        public string Url = "";
        public string FileName = "";
        public bool EsImagen;
        // SERVER
        public string ServerTipo = "";
        public int ServerId;
        // común
        public string Label = "";
        public string? PreviewUrl;          // miniatura si es imagen
        public string Icono = "📎";
    }
    List<PendingAdjunto> pendientes = new();

    // "Adjuntar del servidor": ahora SUMA a la bandeja (no envía directo).
    void StagearServerFile(ApiClient.TwServerFileDto f)
    {
        pendientes.Add(new PendingAdjunto
        {
            Kind = "SERVER",
            ServerTipo = f.Tipo,
            ServerId = f.Id,
            Label = f.Label,
            PreviewUrl = f.PreviewUrl,
            Icono = string.IsNullOrWhiteSpace(f.Icon) ? "📄" : f.Icon
        });
        CerrarAdjuntarServidor();
    }

    void QuitarPendiente(PendingAdjunto p) => pendientes.Remove(p);

    // ===== 2026-08-26: PROGRAMAR UN MENSAJE PARA MÁS TARDE =====
    // La cuenta de los minutos la lleva el SERVIDOR (tabla WhatsApp_MensajesProgramados + un robot
    // que mira cada minuto). Acá solo se anota qué mandar y a qué hora: si esto lo contara el
    // navegador, se moriría al cerrar la pestaña y el mensaje no saldría nunca.
    bool showProgramarPanel = false;
    string progModo = "MENSAJE";          // MENSAJE (lo que escribió abajo) | PLANTILLA
    // 2026-08-26: el "cuándo" se guarda en DOS pedazos (día y hora) en vez de un solo casillero.
    // El de antes era un <input type="datetime-local">: cinco casilleros, y el del año se rompía
    // solo — el navegador avisa el año a medio escribir, así que tipear 2026 pasa por 0002, 0020
    // y 0202 (el mismo bug que Alquileres el 19/08). Ahora el día no se tipea nunca.
    DateTime progDia = PrimeraHoraSugerida().Date;             // SIEMPRE hora argentina
    TimeSpan progHora = PrimeraHoraSugerida().TimeOfDay;
    bool progDiaAMano = false;          // ¿el día lo elegiste vos, o lo estamos poniendo nosotros?
    bool progMostrarAlmanaque = false;  // el almanaque aparece recién cuando tocás "otro día"
    bool progAbrirPicker = false;       // pedirle al navegador que despliegue el calendario

    /// <summary>La hora elegida, entera. El resto de la pantalla la sigue usando igual que antes.</summary>
    DateTime progCuando
    {
        get => progDia.Date + progHora;
        set
        {
            progDia = value.Date;
            progHora = value.TimeOfDay;
            // Un atajo de "Mañana 9:00" SÍ decide el día; uno de "Hoy 15:00" lo deja en automático.
            progDiaAMano = value.Date != DateTimeExt.AhoraAr().Date;
        }
    }

    /// <summary>La hora del casillero (HH:mm). Es lo único que se escribe a mano.</summary>
    string ProgHoraTexto
    {
        get => $"{progHora.Hours:00}:{progHora.Minutes:00}";
        set
        {
            if (!TimeSpan.TryParse(value, CultureInfo.InvariantCulture, out var t)) return;  // vacío o a medio escribir
            progHora = new TimeSpan(t.Hours, t.Minutes, 0);
            // Si el día está en automático, manda la hora: si esa hora ya pasó, es para mañana.
            // Antes esto te rebotaba con "esa hora ya pasó" y tenías que corregir la fecha a mano.
            if (progDiaAMano) return;
            var ahora = DateTimeExt.AhoraAr();
            progDia = ahora.Date;
            if (progDia + progHora <= ahora.AddMinutes(1)) progDia = ahora.Date.AddDays(1);
        }
    }

    /// <summary>El día del almanaque. Solo se toca desde ahí, nunca tipeando.</summary>
    string ProgDiaTexto
    {
        get => progDia.ToString("yyyy-MM-dd", CultureInfo.InvariantCulture);
        set
        {
            if (!DateTime.TryParse(value, CultureInfo.InvariantCulture, DateTimeStyles.None, out var d)) return;
            // Candado del "año raro": mientras el año esté a medio escribir (0002, 0020, 0202…)
            // no se toca nada. Con el almanaque no debería pasar nunca, pero el candado queda.
            if (d.Year < 2000 || d.Year > 2100) return;
            progDia = d.Date;
            progDiaAMano = true;
        }
    }

