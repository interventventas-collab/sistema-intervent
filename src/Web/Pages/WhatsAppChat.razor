    /// <summary>Texto corto del mensaje citado, para la barra "respondiendo a…" y el mensaje temporal.</summary>
    string PreviewMensajeParaResponder(ApiClient.TwMsgDto m)
    {
        var t = (m.Cuerpo ?? "").Trim();
        if (string.IsNullOrEmpty(t) && !string.IsNullOrEmpty(m.MediaUrl))
            t = string.IsNullOrWhiteSpace(m.MediaFilename) ? "📎 Archivo" : $"📎 {m.MediaFilename}";
        else if (!string.IsNullOrEmpty(m.MediaUrl) && !string.IsNullOrEmpty(m.MediaFilename))
            t = $"📎 {t}";
        if (t.Length > 90) t = t.Substring(0, 90) + "…";
        return t;
    }

    // 2026-07-23: notas de voz. Los audios de WhatsApp llegan como .ogg (opus); los que grabamos
    // nosotros desde el navegador pueden ser .webm o .m4a segun el dispositivo.
    bool IsAudio(string? url)
    {
        if (string.IsNullOrEmpty(url)) return false;
        var lower = url.ToLowerInvariant();
        return lower.EndsWith(".ogg") || lower.EndsWith(".opus") || lower.EndsWith(".mp3")
            || lower.EndsWith(".m4a") || lower.EndsWith(".amr") || lower.EndsWith(".wav")
            || lower.EndsWith(".webm");
    }

    // ===== Filtros / detección de pedido =====
    string filtroRol = "";
    // 2026-08-05: menú desplegable de filtros (un solo botón "Todos ▾" en vez de la fila de botones)
    bool showFiltroMenu = false;
    void PickFiltro(string r) { filtroRol = r; showFiltroMenu = false; }
    string FiltroRolLabel() => filtroRol switch
    {
        "pedido" => "📋 Pedidos",
        "hermano" => "👨‍👦 Hermanos",
        "empleado" => "👷 Empleados",
        "cliente" => "🛍️ Clientes",
        "sin" => "❓ Sin asignar",
        "mios" => "🙋 Míos",
        "en_curso" => "🟡 En curso",
        "finalizada" => "🟢 Finalizadas",
        _ => "📥 Todos"
    };
    List<ApiClient.TwConvDto> conversacionesFiltradas => conversaciones.Where(MatchFiltro).ToList();

    // 2026-07-23 (multi-línea): cuando haya 2+ números nuestros conectados, aparece el filtro por
    // línea y la etiqueta en cada chat. Con una sola línea no se muestra nada (queda invisible).
    string filtroLinea = "";
    List<(string Id, string Numero)> LineasDetectadas() => conversaciones
        .Where(c => !string.IsNullOrEmpty(c.Linea))
        .GroupBy(c => c.Linea!)
        .Select(g => (g.Key, g.First().LineaNumero ?? g.Key))
        .OrderBy(x => x.Item2).ToList();

    // 2026-07-29: texto del selector "Línea" de la barra superior. Muestra el número que ve la gente.
    // Con una sola línea = ese número; con varias y filtro puesto = ese número; con varias sin filtro =
    // "Todas las líneas"; sin ninguna detectada todavía = etiqueta genérica hasta que entre el 1er mensaje.
    bool showLineaMenu = false;
    void SeleccionarLinea(string id)
    {
        showLineaMenu = false;
        if (filtroLinea == id) return;   // es la misma línea: no tocar el chat abierto
        filtroLinea = id;
        // 2026-08-05: que "Nueva conversación" mande SIEMPRE desde la misma línea que elegiste arriba
        // (antes quedaba en FRIKAF por defecto aunque eligieras FIJO TRANSRADIO → confundía).
        if (!string.IsNullOrEmpty(id) && nvLineas.Any(l => l.PhoneId == id)) nvLineaPhoneId = id;
        else if (string.IsNullOrEmpty(id)) nvLineaPhoneId = LineaDefaultPhoneId();
        // 2026-08-03 (pedido del usuario): al cambiar de línea remitente, cerrar el chat abierto
        // así no queda a la vista una conversación de la línea anterior. Queda sin chat seleccionado.
        VolverALista();
    }

    // 2026-08-05: ¿la línea elegida arriba es una cuenta de Instagram? Se reconoce por el prefijo "IG "
    // de su etiqueta/número. Sirve para NO mostrar el formulario de "escribir primero con plantilla"
    // (eso es solo de WhatsApp; en Instagram solo se puede RESPONDER a quien te escribió).
    bool LineaEsInstagram(string? id)
    {
        if (string.IsNullOrEmpty(id)) return false;
        var det = LineasDetectadas().FirstOrDefault(x => x.Id == id);
        if ((det.Numero ?? "").StartsWith("IG ", StringComparison.Ordinal)) return true;
        var nv = nvLineas.FirstOrDefault(x => x.PhoneId == id);
        return (nv?.Numero ?? "").StartsWith("IG ", StringComparison.Ordinal);
    }

    // 2026-08-03: al abrir la pantalla, arrancar viendo la línea "FRIKAF by INTERVENT" (no "Todas").
    // Si hay una sola línea no hace falta filtrar. Corre una sola vez (OnInitializedAsync), así que si
    // después el usuario elige otra línea o "Todas", queda como la dejó (el timer no lo pisa).
    void AplicarLineaPorDefecto()
    {
        var ls = LineasDetectadas();
        if (ls.Count <= 1) return;
        var frikaf = ls.FirstOrDefault(l =>
            string.Equals(LineaNombre(l.Id, l.Numero), "FRIKAF by INTERVENT", StringComparison.OrdinalIgnoreCase));
        if (frikaf.Id != null) filtroLinea = frikaf.Id;
    }

    // 2026-08-04: línea que viene elegida por defecto en "Nueva conversación": FRIKAF by INTERVENT
    // si está conectada (es la principal), sino la primera que haya.
    string? LineaDefaultPhoneId()
    {
        var frikaf = nvLineas.FirstOrDefault(l =>
            string.Equals(LineaNombre(l.PhoneId, l.Numero), "FRIKAF by INTERVENT", StringComparison.OrdinalIgnoreCase));
        return (frikaf ?? nvLineas.FirstOrDefault())?.PhoneId;
    }

    // === 2026-08-01: nombre + imagen personalizados por línea (WhatsApp e Instagram) ===
    Dictionary<string, ApiClient.TwLineaConfigDto> lineaCfg = new();
    async Task LoadLineasConfig()
    {
        try { lineaCfg = (await Api.GetTwLineasConfigAsync()).ToDictionary(x => x.LineaId, x => x); }
        catch { }
    }
    // Nombre a mostrar: el personalizado si existe, sino el número/usuario prolijo.
    string LineaNombre(string? id, string? numeroFallback)
    {
        if (id != null && lineaCfg.TryGetValue(id, out var c) && !string.IsNullOrWhiteSpace(c.Nombre)) return c.Nombre!;
        var t = numeroFallback ?? id ?? "";
        if (t.StartsWith("IG ", StringComparison.Ordinal)) return t.Substring(3).Trim();
        return PrettyNumero(t);
    }
    string? LineaImg(string? id) => id != null && lineaCfg.TryGetValue(id, out var c) ? c.ImagenDataUrl : null;

    // 2026-08-01: sonidos de aviso disponibles (mismas claves que window.waSounds en index.html)
    static readonly (string Key, string Label)[] SonidosDisponibles = new[]
    {
        ("chime", "🔔 Campanita (default)"),
        ("msn", "🟢 Messenger (ding-dong)"),
        ("coin", "🪙 Moneda"),
        ("powerup", "⭐ Power-up"),
        ("laser", "👾 Láser"),
        ("levelup", "🎺 Level up")
    };
    async Task ProbarSonido(string key) { try { await JS.InvokeVoidAsync("waTestSound", key); } catch { } }

    // Interruptor MAESTRO de sonido (mismo localStorage "wa.sonido" que lee el panel flotante al sonar)
    bool sonidoMasterOn = true;
    async Task CargarSonidoMaster()
    {
        try { var v = await JS.InvokeAsync<string>("localStorage.getItem", "wa.sonido"); sonidoMasterOn = v != "0"; }
        catch { }
    }
    async Task ToggleSonidoMaster()
    {
        sonidoMasterOn = !sonidoMasterOn;
        try { await JS.InvokeVoidAsync("localStorage.setItem", "wa.sonido", sonidoMasterOn ? "1" : "0"); } catch { }
