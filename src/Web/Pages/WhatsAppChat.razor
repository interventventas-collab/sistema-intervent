    // Arma el texto lindo que se le pasa al cliente. soloAlias = solo banco + alias (para el que no quiere el CBU largo).
    string FormatearCbu(ApiClient.TwCbuDto cb, bool soloAlias)
    {
        var sb = new System.Text.StringBuilder();
        var banco = string.IsNullOrWhiteSpace(cb.Banco) ? cb.Nombre : cb.Banco;
        var tipo = string.IsNullOrWhiteSpace(cb.TipoCuenta) ? "" : $" ({cb.TipoCuenta})";
        sb.Append($"🏦 Datos bancarios – {banco}{tipo}");
        if (!string.IsNullOrWhiteSpace(cb.Titular)) sb.Append($"\nTitular: {cb.Titular}");
        if (!string.IsNullOrWhiteSpace(cb.Cuit)) sb.Append($"\nCUIT: {cb.Cuit}");
        if (!soloAlias && !string.IsNullOrWhiteSpace(cb.Cbu)) sb.Append($"\nCBU: {cb.Cbu}");
        if (!string.IsNullOrWhiteSpace(cb.Alias)) sb.Append($"\nAlias: {cb.Alias}");
        if (!string.IsNullOrWhiteSpace(cb.Mail)) sb.Append($"\n📧 Comprobante a: {cb.Mail}");
        return sb.ToString();
    }

