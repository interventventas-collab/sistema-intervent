    .wa-drawer-w.active { background: #25d366; color: white; border-color: #25d366; }
    .wa-drawer-btn { background: transparent; border: 1px solid #d1d5db; color: #374151; width: 26px; height: 26px; border-radius: 4px; cursor: pointer; display: inline-flex; align-items: center; justify-content: center; font-size: 0.9rem; text-decoration: none; }
