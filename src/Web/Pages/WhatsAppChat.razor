    /// <summary>La hora que viene redonda: dentro de una hora, sin minutos sueltos.</summary>
    static DateTime PrimeraHoraSugerida()
    {
        var t = DateTimeExt.AhoraAr().AddHours(1);
        return new DateTime(t.Year, t.Month, t.Day, t.Hour, 0, 0);
    }

    /// <summary>Los atajos de horario. Solo se ofrecen los que todavía no pasaron: un botón
    /// "Hoy 15:00" a las 17 hs no sirve para nada.</summary>
    List<(string Label, DateTime Cuando)> OpcionesHorario()
    {
        var ahora = DateTimeExt.AhoraAr();
        var hoy = ahora.Date;
        var lista = new List<(string, DateTime)>
        {
            ("En 1 hora", PrimeraHoraSugerida()),
            ("Hoy 15:00", hoy.AddHours(15)),
            ("Hoy 18:00", hoy.AddHours(18)),
            ("Mañana 9:00", hoy.AddDays(1).AddHours(9)),
            ("Mañana 15:00", hoy.AddDays(1).AddHours(15)),
        };
        return lista.Where(x => x.Item2 > ahora.AddMinutes(1)).Select(x => (x.Item1, x.Item2)).ToList();
    }

    /// <summary>"hoy 15:00" / "mañana 09:00" / "vie 29/08 15:00" — hora local, como la lee una persona.</summary>
    string CuandoLindo(DateTime ar)
    {
        var hoy = DateTimeExt.AhoraAr().Date;   // "hoy" es hoy en Argentina, no donde esté el navegador
        var dia = ar.Date;
        if (dia == hoy) return $"hoy {ar:HH:mm}";
        if (dia == hoy.AddDays(1)) return $"mañana {ar:HH:mm}";
        return $"{ar:ddd dd/MM HH:mm}";
    }

