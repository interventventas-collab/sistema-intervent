    .wa-nv-search { font-size: 1.02rem; }
    .wa-nv-results { border: 1px solid #e5e7eb; border-radius: 14px; margin-top: 0.5rem; max-height: 300px; overflow-y: auto; box-shadow: 0 8px 24px rgba(0,0,0,0.08); }
    .wa-nv-chip { display: flex; align-items: center; gap: 0.7rem; background: #f0fdf4; border: 1px solid #bbf7d0; border-radius: 16px; padding: 0.7rem 0.85rem; margin-bottom: 1rem; }
    .wa-nv-preview { background: #dcf8c6; border-radius: 14px; padding: 0.8rem 1rem; font-size: 0.92rem; white-space: pre-wrap; color: #111; }
    .wa-nv-actions { display: flex; gap: 0.7rem; align-items: center; margin-top: 1.2rem; }
    .wa-nv-send { flex: 1; border: none; border-radius: 16px; padding: 0.9rem 1.4rem; font-size: 1.05rem; font-weight: 700; color: #fff; background: #25d366; cursor: pointer; box-shadow: 0 6px 16px rgba(37,211,102,0.35); transition: filter .15s, transform .05s; }
