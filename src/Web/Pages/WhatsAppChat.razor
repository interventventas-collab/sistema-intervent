        if (string.IsNullOrWhiteSpace(nvNumero)) { Toast.Warning("Poné el número de destino"); return; }
        for (int i = 0; i < p.VariableCount; i++)
            if (i >= nvVariables.Count || string.IsNullOrWhiteSpace(nvVariables[i]))
            { Toast.Warning("Completá todos los datos de la plantilla"); return; }

        nvEnviando = true;
        StateHasChanged();
        var (ok, err, numero) = await Api.IniciarTwConversacionAsync(
            nvNumero.Trim(), p.Name, p.Language, nvLineaPhoneId, nvVariables, p.BodyText);
        nvEnviando = false;
        if (!ok) { Toast.Error(err ?? "No se pudo enviar"); return; }
        Toast.Success("Mensaje enviado ✓");
        // limpiar el panel para el próximo, y abrir el chat recién creado abajo
        nvNumero = ""; nvPlantillaName = ""; nvVariables = new();
        nvClienteSeleccionado = null; nvClienteQuery = "";
        await LoadConversaciones(silent: true);
        if (!string.IsNullOrEmpty(numero))
            await SelectConv(numero, conversaciones.FirstOrDefault(c => c.Numero == numero)?.Linea);
        StateHasChanged();
    }

    async Task SelectConv(string numero, string? linea)
    {
        selectedNumero = numero;
        selectedLinea = linea;
        chatPlantillaName = ""; chatVariables = new();   // 2026-08-05: resetear el selector de plantilla al cambiar de chat
        sugerenciaCliente = null;   // limpiar la del chat anterior mientras carga este
        mostrarFichaCliente = false; fichaCliente = null; previewFacturaId = null;   // 2026-08-05: cerrar la ficha del cliente al cambiar de chat
        showQuickReplies = false;   // 2026-08-05: cerrar el desplegable de respuestas rápidas al cambiar de chat
        modoElegirVenta = false; mensajesSeleccionadosIds.Clear();   // 2026-08-05: salir del modo "elegir mensajes para venta"
        asignarNota = SelectedConv()?.AsignadoNota ?? "";   // 2026-08-06: precargar la nota guardada de este chat (editable)
        await LoadMensajes();
        // 2026-08-06: presencia — salgo del chat anterior y entro al nuevo (para que se vea quién mira qué).
