    async Task SelectConv(string numero, string? linea)
    {
        // 2026-08-26: lo que venías escribiendo (y los archivos cargados) quedan guardados en SU
        // chat, y acá abajo se levanta el borrador del chat al que entrás. Ver GuardarBorradorDelChat.
        GuardarBorradorDelChat();
        selectedNumero = numero;
        selectedLinea = linea;
        RestaurarBorradorDelChat();
        chatPlantillaName = ""; chatVariables = new();   // 2026-08-05: resetear el selector de plantilla al cambiar de chat
        sugerenciaCliente = null;   // limpiar la del chat anterior mientras carga este
        mostrarFichaCliente = false; fichaCliente = null; facturaAbierta = null;   // 2026-08-05: cerrar la ficha del cliente al cambiar de chat
        LimpiarModoMeli();          // 2026-08-21: la ficha de MercadoLibre era del comprador del chat anterior
        LimpiarModoVenta();         // 2026-08-21: el carrito y las ventas para repetir eran del cliente anterior
        // 2026-08-31: la cotización de alquiler era para el cliente ANTERIOR. Se apaga el modo y se
        // vacía todo: si quedara prendido, el próximo "mandar" le tira el presupuesto de otro.
        LimpiarModoAlquiler();
        showQuickReplies = false;   // 2026-08-05: cerrar el desplegable de respuestas rápidas al cambiar de chat
        // 2026-08-26: los mensajes programados son de CADA chat: se limpian y se piden de nuevo.
        showProgramarPanel = false; progModo = "MENSAJE"; progPendientes = new(); progResueltos = new();
        modoElegirVenta = false; mensajesSeleccionadosIds.Clear();   // 2026-08-05: salir del modo "elegir mensajes para venta"
        // 2026-08-20: cerrar el buscador y olvidar los "Leer más" abiertos: son de la charla anterior.
        // Acá la pantalla NO se recrea al cambiar de chat (a diferencia del celular), así que si no
        // se limpia a mano queda el buscador con los resultados del chat de antes.
        CerrarBuscador(); textoAbierto.Clear(); modoSeleccion = false;
        asignarNota = SelectedConv()?.AsignadoNota ?? "";   // 2026-08-06: precargar la nota guardada de este chat (editable)
        notaGuardada = asignarNota;                        // 2026-08-27: lo que vino del servidor ya está guardado
        showEstadoMenu = false; showPasarMenu = false; showMasMenu = false;   // 2026-08-27: si quedó una listita abierta, se cierra al cambiar de chat
        _ = CargarAvisoMeli();   // 2026-08-21: en paralelo, que el chat no espere por esto
        // 2026-08-24: la ficha del cliente se carga sola (en paralelo, sin abrir la ventanita) para
        // que la barra de arriba pueda mostrar la dirección y si debe plata. De paso, cuando tocás
        // el ojito 👁️ ya está lista y abre al instante.
        _ = CargarFichaCliente();
        await LoadMensajes();
        // 2026-08-06: presencia — salgo del chat anterior y entro al nuevo (para que se vea quién mira qué).
        await CambiarPresenciaConv(ConvIdActual());
        // 2026-08-06: poner el cursor solo en el cuadro de escribir (como WhatsApp Web). Solo en compu.
        // 2026-08-26: y que recalcule el alto, porque el borrador de este chat puede ser de varios renglones.
        try { await JS.InvokeVoidAsync("waComposer.resetSize"); } catch { }
        try { await JS.InvokeVoidAsync("waComposer.focus"); } catch { }
        await BuscarSugerenciaCliente();
        // 2026-08-04: si esta charla me la pasaron a mí y no la había abierto, apago el aviso.
        var conv = SelectedConv();
        if (conv != null && EsPasadaAMi(conv))
        {
            await Api.MarcarConvVistoAsync(numero, linea);
            await LoadConversaciones(silent: true);
        }
    }

