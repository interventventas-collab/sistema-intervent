    bool subiendoSonido;

    /// <summary>El sonido subido que está elegido ahora (null si está elegido uno de los del sistema).</summary>
    ApiClient.TwSonidoDto? SonidoSubidoElegido()
        => sonidosSubidos.FirstOrDefault(x => x.Clave == editLineaSonido);

    async Task CargarSonidosSubidos()
    {
