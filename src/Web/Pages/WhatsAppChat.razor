    string? miUsuario;   // username del logueado (para NO mostrarme a mí mismo)
    Dictionary<string, List<Web.Services.PresenceService.Viewer>> presenceByConv = new();
    Dictionary<string, (string userName, DateTime atUtc)> ultimoEnvioOtro = new();  // cierre de carrera
    System.Threading.Timer? heartbeatTimer;
    System.Threading.Timer? typingOffTimer;
    bool yoTipeando = false;
    string? _convUnida;   // conv que tengo "join"eada ahora (para hacer leave al cambiar)

    string? ConvIdActual() => selectedNumero == null ? null : ConvIdDe(selectedNumero, selectedLinea);
    static string ConvIdDe(string numero, string? linea) => $"{numero}|{linea}";

    async Task IniciarPresencia()
    {
        Presence.OnPresence += PresenciaCambio;
        Presence.OnMessageSent += OtroEnvioMensaje;
        await Presence.EnsureStartedAsync();
        // Latido cada 15 s para no expirar (el server saca a los 30 s sin latido).
        heartbeatTimer = new System.Threading.Timer(async _ =>
        {
            var cid = ConvIdActual();
            if (cid != null) await Presence.HeartbeatAsync(cid);
        }, null, 15_000, 15_000);
    }

    void PresenciaCambio(string convId, List<Web.Services.PresenceService.Viewer> viewers)
    {
        presenceByConv[convId] = viewers;
        InvokeAsync(StateHasChanged);
    }

    void OtroEnvioMensaje(string convId, int userId, string userName, DateTime atUtc)
    {
        if (userName == miUsuario) return;
        ultimoEnvioOtro[convId] = (userName, atUtc);
        InvokeAsync(StateHasChanged);
    }

    // Viewers de una conv que NO soy yo (nunca me muestro a mí mismo).
    List<Web.Services.PresenceService.Viewer> OtrosViewers(string? convId)
        => convId != null && presenceByConv.TryGetValue(convId, out var vs)
            ? vs.Where(v => v.UserName != miUsuario).ToList()
            : new();

    // Cambiar de conversación: salir de la anterior, entrar a la nueva.
    async Task CambiarPresenciaConv(string? nuevoConvId)
    {
        ApagarTyping();
        if (_convUnida != null && _convUnida != nuevoConvId)
            await Presence.LeaveAsync(_convUnida);
        _convUnida = nuevoConvId;
        if (nuevoConvId != null) await Presence.JoinAsync(nuevoConvId);
    }

    // Lo llama wa-composer.js en cada tecla dentro del cuadro. Prende "escribiendo…" y programa el
    // apagado a los 4 s sin actividad (como pide el spec).
    [Microsoft.JSInterop.JSInvokable]
    public async Task NotifyTyping()
    {
        var cid = ConvIdActual();
        if (cid == null) return;
        if (!yoTipeando)
        {
            yoTipeando = true;
            await Presence.TypingAsync(cid, true);
            StateHasChanged();   // por si hay que mostrar el aviso ámbar
        }
        typingOffTimer?.Dispose();
        typingOffTimer = new System.Threading.Timer(async _ => await InvokeAsync(async () =>
        {
            yoTipeando = false;
            var c = ConvIdActual();
            if (c != null) await Presence.TypingAsync(c, false);
            StateHasChanged();
        }), null, 4000, System.Threading.Timeout.Infinite);
    }

    void ApagarTyping()
    {
        typingOffTimer?.Dispose();
        typingOffTimer = null;
        if (yoTipeando)
        {
            yoTipeando = false;
            if (_convUnida != null) _ = Presence.TypingAsync(_convUnida, false);
        }
    }

    // CIERRE DE CARRERA: true = seguir enviando; false = el usuario canceló.
    async Task<bool> ChequearCarreraAsync()
    {
        var cid = ConvIdActual();
        if (cid != null && ultimoEnvioOtro.TryGetValue(cid, out var ult))
        {
            var seg = (DateTime.UtcNow - ult.atUtc).TotalSeconds;
            if (seg >= 0 && seg <= 10)
                return await JS.InvokeAsync<bool>("confirm",
                    $"{ult.userName} respondió hace {Math.Round(seg)} s. ¿Enviás igual?");
        }
        return true;
    }

    // Avisar a los demás que mandé (para SU cierre de carrera). Best-effort, NO toca el envío.
    async Task AvisarEnvie(string convId) => await Presence.NotifyMessageSentAsync(convId);


