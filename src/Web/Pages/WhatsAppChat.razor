    /// <summary>Espera a que deje de tipear antes de ir al servidor.</summary>
    async Task BuscarMeliConEspera()
    {
        _mmCts?.Cancel();
        var cts = _mmCts = new CancellationTokenSource();
        if ((mmBusqueda ?? "").Trim().Length < 3)
        {
            mmResultados = new(); mmBuscado = false; mmBuscando = false;
            StateHasChanged();
            return;
        }
        try
        {
            await Task.Delay(350, cts.Token);
            if (cts.Token.IsCancellationRequested) return;
            await BuscarMeliAhora();
        }
        catch (TaskCanceledException) { }
    }

    async Task OnEnterBuscarMeli(KeyboardEventArgs e)
    {
        if (e.Key != "Enter") return;
        _mmCts?.Cancel();
        await BuscarMeliAhora();
    }

    async Task BuscarMeliAhora(bool auto = false)
    {
        var q = (mmBusqueda ?? "").Trim();
        if (q.Length < 3) return;
        mmBuscando = true; mmFicha = null;
        StateHasChanged();
        // Si pegaron el código de una publicación, además de los compradores mostramos la
        // publicación misma: precio y stock de hoy.
        if (q.StartsWith("ML", StringComparison.OrdinalIgnoreCase) && q.Length >= 6)
            await VerPublicacionMeli(q.Replace(" ", ""));

        var res = await Api.BuscarMeliFichaAsync(q);
        mmBuscando = false;
        mmResultados = res;
        mmBuscado = !auto;
        // La búsqueda automática por teléfono no molesta si no encontró nada: deja el buscador limpio.
        if (res.Count == 0 && auto) mmBusqueda = "";
        else if (res.Count == 1) await AbrirFichaMeli(res[0].BuyerId);
        StateHasChanged();
    }

