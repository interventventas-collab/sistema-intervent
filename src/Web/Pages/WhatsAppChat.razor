    /// <summary>2026-08-20: recargar la ficha para la razón social que está tildada AHORA. La usa
    /// el cambio de razón social (que no pasa por el ojito 👁️) para que el saldo y las últimas
    /// facturas que ves sean las de la empresa correcta.</summary>
    async Task CargarFichaCliente()
    {
        if (SelectedConv()?.ClienteId is not int cid) { fichaCliente = null; mostrarFichaCliente = false; facturaAbierta = null; return; }
        if (fichaCliente is not null && fichaCliente.ClienteId == cid) return;
        facturaAbierta = null;   // cambió la razón social: la factura que estabas viendo ya no aplica
        cargandoFicha = true;
        fichaCliente = null;
        StateHasChanged();
        try
        {
            var f = await Api.GetFichaChatAsync(cid);
            // 2026-08-24: si mientras el server contestaba saltaste a otro chat (o cambiaste de
            // razón social), esta ficha ya es de otro cliente: la tiramos. Si no, la barra de
            // arriba te mostraría la dirección y la deuda del cliente anterior.
            if (SelectedConv()?.ClienteId == cid) fichaCliente = f;
        }
        finally
        {
            // El "cargando" lo apaga solo el pedido que sigue siendo el actual: si lo apagara uno
            // viejo, la ficha recién abierta quedaría mostrando "no se pudo cargar".
            if (SelectedConv()?.ClienteId == cid) cargandoFicha = false;
            StateHasChanged();
        }
    }

