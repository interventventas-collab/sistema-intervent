    .wa-srv-send-btn { background: #25d366; color: white; border: none; padding: 0.35rem 0.8rem; border-radius: 6px; cursor: pointer; font-size: 0.8rem; white-space: nowrap; }
    .wa-srv-send-btn:hover { background: #1ea953; }
    .wa-srv-send-btn:disabled { background: #9ca3af; cursor: wait; }
    .wa-srv-del-btn { background: transparent; border: none; cursor: pointer; font-size: 1rem; padding: 0.2rem 0.3rem; border-radius: 6px; }
    .wa-srv-del-btn:hover { background: #fee2e2; }
    .wa-srv-empty { padding: 2rem; text-align: center; color: #9ca3af; font-size: 0.85rem; }
    /* 2026-08-04: subir catálogo permanente */
    .wa-srv-upload { margin: 0 0 0.6rem; padding: 0.6rem 0.8rem; background: #f0fdf4; border: 1px dashed #86efac; border-radius: 8px; text-align: center; }
