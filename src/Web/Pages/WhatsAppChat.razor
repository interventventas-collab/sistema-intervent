    void AgregarDestinoDirecto(string digitos)
    {
        if (!reenviarDestinos.Any(x => x.Numero == digitos))
            reenviarDestinos.Add(new ApiClient.TwDestinatarioDto("Número nuevo", digitos, "Directo"));
        reenviarQuery = ""; reenviarResultados = new();
    }

    async Task ConfirmarReenviar()
    {
        if (reenviarDestinos.Count == 0 || reenviando) return;
        var msgs = mensajes.Where(m => mensajesSeleccionadosIds.Contains(m.Id))
                           .OrderBy(m => m.CreatedAt).ToList();
        if (msgs.Count == 0) { Toast.Warning("No hay mensajes seleccionados"); return; }

        reenviando = true; StateHasChanged();
        int ok = 0, fail = 0;
        // Línea = null: el sistema resuelve solo la línea del destinatario (donde tiene la ventana de 24hs abierta).
        foreach (var d in reenviarDestinos)
        {
            foreach (var m in msgs)
            {
                try
                {
                    bool enviado;
                    if (EsMensajeContacto(m.Cuerpo))
                    {
                        enviado = true;
                        foreach (var ct in ParseContactos(m.Cuerpo))
                        {
                            var (cok, _) = await Api.EnviarTwContactoAsync(d.Numero, ct.Nombre, ct.Numero, null);
                            if (!cok) enviado = false;
                        }
                    }
                    else if (!string.IsNullOrEmpty(m.MediaUrl))
                    {
                        var (mok, _) = await Api.SendTwMediaAsync(d.Numero, m.MediaUrl!, m.Cuerpo, m.MediaFilename, null);
                        enviado = mok;
                    }
                    else if (!string.IsNullOrWhiteSpace(m.Cuerpo))
                    {
                        var (tok, _) = await Api.SendTwMensajeAsync(d.Numero, m.Cuerpo!, null);
                        enviado = tok;
                    }
                    else { continue; } // nada reenviable en este mensaje (ej. solo una reacción)

                    if (enviado) ok++; else fail++;
                }
                catch { fail++; }
            }
        }
        reenviando = false;

        // Por si le reenviaste al chat que está abierto, refrescamos para verlo.
        await LoadMensajes(silent: true);

        if (fail == 0) Toast.Success($"Reenviado ✓ ({ok} envío(s))");
        else if (ok == 0) Toast.Error("No se pudo reenviar. Puede ser que esos contactos no te escribieron en las últimas 24 hs (WhatsApp no deja mandarles algo libre hasta que respondan).");
        else Toast.Warning($"Reenviado a algunos: {ok} sí, {fail} no (los que fallaron seguro están fuera de las 24 hs).");

        CerrarReenviar();
        mensajesSeleccionadosIds.Clear();
    }

    // ¿El cuerpo es una tarjeta de contacto? (marcador puesto por el webhook / el envío)
    static bool EsMensajeContacto(string? cuerpo)
        => !string.IsNullOrEmpty(cuerpo) && cuerpo.StartsWith("CONTACTO_WA:", StringComparison.Ordinal);

    // Devuelve los contactos guardados en el cuerpo "CONTACTO_WA:[{n,t}]"
    List<(string Nombre, string Numero)> ParseContactos(string? cuerpo)
    {
        var res = new List<(string, string)>();
        if (!EsMensajeContacto(cuerpo)) return res;
        try
        {
            var json = cuerpo!.Substring("CONTACTO_WA:".Length);
            using var doc = System.Text.Json.JsonDocument.Parse(json);
            foreach (var el in doc.RootElement.EnumerateArray())
            {
                var n = el.TryGetProperty("n", out var nn) ? nn.GetString() ?? "" : "";
                var t = el.TryGetProperty("t", out var tt) ? tt.GetString() ?? "" : "";
                if (string.IsNullOrWhiteSpace(n)) n = t;
                res.Add((n, t));
            }
        }
        catch { }
        return res;
    }

    // 2026-08-03: "Escribir" a un contacto compartido. Si ya existe un chat con ese número, lo abre.
    // Si es nuevo, abre el panel de "Nueva conversación" ya cargado (porque a un número nuevo hay que
    // escribirle con plantilla — regla de las 24h de WhatsApp).
    async Task EscribirAContactoCompartido(string? nombre, string? numero)
    {
        var digs = new string((numero ?? "").Where(char.IsDigit).ToArray());
        if (string.IsNullOrWhiteSpace(digs)) { Toast.Warning("Ese contacto no trae un número válido"); return; }
        var existente = conversaciones.FirstOrDefault(c =>
            new string((c.Numero ?? "").Where(char.IsDigit).ToArray()) == digs);
        if (existente != null)
        {
            await SelectConv(existente.Numero, existente.Linea);   // ya hablaste con él: abrí ese chat
            return;
        }
        await AbrirNuevaConv();   // contacto nuevo: dejá el panel de nueva conversación listo
        nvNumero = digs;
        nvClienteSeleccionado = string.IsNullOrWhiteSpace(nombre) ? "este contacto" : nombre;
        StateHasChanged();
    }

