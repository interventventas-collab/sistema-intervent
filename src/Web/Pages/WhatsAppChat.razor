    async Task EnviarPlantillaEnChat()
    {
        var p = ChatPlantillaSel();
        if (p == null) { Toast.Warning("Elegí una plantilla"); return; }
        if (selectedNumero == null) return;
        for (int i = 0; i < p.VariableCount; i++)
            if (i >= chatVariables.Count || string.IsNullOrWhiteSpace(chatVariables[i]))
            { Toast.Warning("Completá todos los datos de la plantilla"); return; }
        var digits = new string(selectedNumero.Where(char.IsDigit).ToArray());
        chatPlantillaEnviando = true;
        StateHasChanged();
        var (ok, err, _) = await Api.IniciarTwConversacionAsync(digits, p.Name, p.Language, selectedLinea, chatVariables, p.BodyText);
        chatPlantillaEnviando = false;
        if (!ok) { Toast.Error(err ?? "No se pudo enviar la plantilla"); return; }
        Toast.Success("Plantilla enviada ✓");
        chatPlantillaName = ""; chatVariables = new();
        await LoadMensajes(silent: true);
        await LoadConversaciones(silent: true);
    }

    async Task EnviarNuevaConv()
    {
        var p = PlantillaSel();
        if (p == null) { Toast.Warning("Elegí una plantilla"); return; }
        if (string.IsNullOrWhiteSpace(nvNumero)) { Toast.Warning("Poné el número de destino"); return; }
        for (int i = 0; i < p.VariableCount; i++)
            if (i >= nvVariables.Count || string.IsNullOrWhiteSpace(nvVariables[i]))
            { Toast.Warning("Completá todos los datos de la plantilla"); return; }

        nvEnviando = true;
        StateHasChanged();
        var (ok, err, numero) = await Api.IniciarTwConversacionAsync(
            nvNumero.Trim(), p.Name, p.Language, nvLineaPhoneId, nvVariables, p.BodyText);
        nvEnviando = false;
        if (!ok) { Toast.Error(err ?? "No se pudo enviar"); return; }
        Toast.Success("Mensaje enviado ✓");
        // limpiar el panel para el próximo, y abrir el chat recién creado abajo
        nvNumero = ""; nvPlantillaName = ""; nvVariables = new();
        nvClienteSeleccionado = null; nvClienteQuery = "";
        await LoadConversaciones(silent: true);
        if (!string.IsNullOrEmpty(numero))
            await SelectConv(numero, conversaciones.FirstOrDefault(c => c.Numero == numero)?.Linea);
        StateHasChanged();
