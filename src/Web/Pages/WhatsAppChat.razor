    /// <summary>Con qué formato entra un producto a la venta. Misma regla que la pantalla de
    /// ventas (café siempre 1 kg; el resto, el formato por defecto de la ficha si sigue siendo
    /// válido). Ver FormatoInicialProducto en CafeVentas.razor.</summary>
    static string FormatoInicial(CafeProductoDto? p)
    {
        if (p is null) return "UNIT";
        if (p.Categoria == "CAFE") return "1KG";
        var f = p.FormatoPorDefecto;
        if (string.IsNullOrWhiteSpace(f) || f == "UNIT") return "UNIT";
        if (f == "BULTO")
            return (p.UxB.HasValue && p.UxB.Value > 0 && (p.PrecioBulto.HasValue || p.PrecioBultoOtro.HasValue)) ? "BULTO" : "UNIT";
        if (f.StartsWith("PACK_") && int.TryParse(f.AsSpan("PACK_".Length), out var n) && n > 0)
            return (p.Packs?.Any(pk => pk.IsActive && pk.Cantidad == n) ?? false) ? f : "UNIT";
        return "UNIT";
    }

    /// <summary>Etiqueta corta del formato para el renglón. Vacía cuando va suelto o es café por
    /// kilo, que es lo normal y no hace falta aclarar.</summary>
    static string? FormatoLabelCorto(string? formato)
    {
        if (string.IsNullOrWhiteSpace(formato) || formato == "UNIT" || formato == "1KG") return null;
        if (formato == "BULTO") return "Bulto";
        if (formato.StartsWith("PACK_") && int.TryParse(formato.AsSpan("PACK_".Length), out var n)) return $"Pack x{n}";
        return formato;
    }

    /// <summary>Suma un producto al carrito. Si ya estaba (mismo producto y mismo formato), en vez
    /// de repetir el renglón le suma uno a la cantidad.</summary>
    async Task SumarProducto(int productoId, string? formatoForzado = null)
    {
        var prod = mvProductos.FirstOrDefault(x => x.Id == productoId);
        var formato = formatoForzado ?? FormatoInicial(prod);
        var ya = mvItems.FirstOrDefault(l => l.Req.ProductoId == productoId && l.Req.Formato == formato);
        if (ya != null)
        {
            ya.Req.Cantidad += 1;
            ya.CantidadTxt = ya.Req.Cantidad.ToString();
        }
        else
        {
            mvItems.Add(new MvLinea
            {
                Req = new CafeCotizarItemRequest { ProductoId = productoId, Formato = formato, Cantidad = 1 },
                Nombre = prod?.Nombre ?? $"Producto #{productoId}",
                CantidadTxt = "1",
                FormatoLabel = FormatoLabelCorto(formato)
            });
        }
        LimpiarBusquedaProducto();
        await CotizarModoVenta();
    }

    /// <summary>Uno de "lo que más compra": entra con el MISMO formato que suele llevar.</summary>
    Task SumarTop(CafeTopProductoClienteDto t) => SumarProducto(t.ProductoId, t.Formato);

