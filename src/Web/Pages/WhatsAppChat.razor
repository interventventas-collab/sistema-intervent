    // ── El renglón: molienda, envase, formato, precio a mano y descuento ──
    void ToggleDetalleLinea(int idx) => mvLineaAbierta = (mvLineaAbierta == idx) ? -1 : idx;

    CafeProductoDto? ProductoDe(MvLinea l) => mvProductos.FirstOrDefault(p => p.Id == l.Req.ProductoId);

    bool EsCafe(MvLinea l) => !l.Req.EsConceptoLibre && ProductoDe(l)?.Categoria == "CAFE";

    /// <summary>Los formatos que se pueden elegir en ese renglón. Café: kilo, medio y cuarto.
    /// El resto: suelto + bulto y packs, pero solo los que ese producto tiene de verdad.</summary>
    List<(string, string)> FormatoOpciones(CafeProductoDto? p, string? actual = null)
    {
        List<(string, string)> ops;
        if (p?.Categoria == "CAFE")
            ops = new() { ("1KG", "1 kg"), ("MEDIO", "1/2 kg"), ("CUARTO", "1/4 kg") };
        else
        {
            ops = new() { ("UNIT", "Suelto") };
            if (p is not null)
            {
                if (p.UxB.HasValue && p.UxB.Value > 0 && (p.PrecioBulto.HasValue || p.PrecioBultoOtro.HasValue))
                    ops.Add(("BULTO", $"Bulto x{p.UxB.Value}"));
                foreach (var pk in (p.Packs ?? new()).Where(x => x.IsActive).OrderBy(x => x.Cantidad))
                    ops.Add(($"PACK_{pk.Cantidad}", $"Pack x{pk.Cantidad}"));
            }
        }
        // Si el renglón viene de repetir un comprobante viejo con un formato que ya no está en la
        // lista, lo agregamos igual: si no, el desplegable mostraría OTRA cosa que la que se va a
        // facturar de verdad.
        if (!string.IsNullOrWhiteSpace(actual) && !ops.Any(o => o.Item1 == actual))
            ops.Insert(0, (actual!, FormatoLabelCorto(actual) ?? actual!));
        return ops;
    }

    /// <summary>"MOLIDO PRENSA FRANCESA" no entra en el renglón: lo dejamos en "PRENSA FRANCESA".</summary>
    static string MoliendaCorta(string? m)
    {
        var s = (m ?? "").Trim();
        if (s.Length == 0) return "";
        if (s == "EN GRANOS") return "GRANOS";
        return s.StartsWith("MOLIDO ") ? s.Substring(7) : s;
    }

    static string EnvaseDe(MvLinea l) => l.Req.EsDoyPack ? "DOY_PACK" : (l.Req.EsEnvasePlateado ? "PLATEADO" : "NEGRO");

    /// <summary>Solo se muestra si NO es el envase negro, que es el normal.</summary>
    static string? EnvaseLabelCorto(MvLinea l)
        => l.Req.EsDoyPack ? "doy pack" : (l.Req.EsEnvasePlateado ? "plateado" : null);

    async Task CambiarFormatoLinea(int idx, string? formato)
    {
        if (idx < 0 || idx >= mvItems.Count || string.IsNullOrWhiteSpace(formato)) return;
        mvItems[idx].Req.Formato = formato!;
        mvItems[idx].FormatoLabel = FormatoLabelCorto(formato);
        // Mismo default que la pantalla de ventas: 1/4 y 1/2 kg van en doy pack.
        if (EsCafe(mvItems[idx]))
        {
            if (formato is "MEDIO" or "CUARTO") { mvItems[idx].Req.EsDoyPack = true; mvItems[idx].Req.EsEnvasePlateado = false; }
            else if (formato == "1KG") { mvItems[idx].Req.EsDoyPack = false; mvItems[idx].Req.EsEnvasePlateado = false; }
        }
        // El formato cambia el precio del catálogo: si había uno a mano, ya no vale.
        mvItems[idx].Req.PrecioUnitarioOverride = null;
