    string? editLineaImg = null, editLineaNumero = null;
    void AbrirEditLinea(string id, string? numero)
    {
        editLineaId = id;
        editLineaNumero = numero;
        lineaCfg.TryGetValue(id, out var c);
        editLineaNombre = c?.Nombre ?? "";
        editLineaImg = c?.ImagenDataUrl;
        editLineaSonido = string.IsNullOrEmpty(c?.Sonido) ? "chime" : c!.Sonido!;
        showLineaMenu = false;
        showEditLinea = true;
    }
    async Task OnEditLineaImg(InputFileChangeEventArgs e)
    {
        var file = e.File;
        if (file == null) return;
        if (file.Size > 600_000) { Toast.Warning("La imagen es muy grande. Usá una menor a 500 KB."); return; }
        try
        {
            using var ms = new MemoryStream();
            await file.OpenReadStream(maxAllowedSize: 700_000).CopyToAsync(ms);
            var mime = string.IsNullOrEmpty(file.ContentType) ? "image/png" : file.ContentType;
            editLineaImg = $"data:{mime};base64,{Convert.ToBase64String(ms.ToArray())}";
        }
        catch { Toast.Error("No se pudo leer la imagen"); }
        StateHasChanged();
    }
    async Task GuardarEditLinea()
    {
        editLineaGuardando = true;
        StateHasChanged();
        var (ok, err) = await Api.GuardarTwLineaConfigAsync(editLineaId, editLineaNombre, editLineaImg ?? "", editLineaSonido);
        editLineaGuardando = false;
        if (!ok) { Toast.Error(err ?? "No se pudo guardar"); return; }
        Toast.Success("Línea actualizada ✓");
        await LoadLineasConfig();
        showEditLinea = false;
        StateHasChanged();
    }

    // 2026-07-31: etiqueta corta para el chip de cada cuenta. Instagram viene como "IG @usuario"
    // (lo registra el webhook) → 📸 @usuario; WhatsApp es un número → 📱 número.
    string EtiquetaLineaChip(string? lineaNumero, string id)
    {
        var t = lineaNumero ?? id;
        var emoji = t.StartsWith("IG ", StringComparison.Ordinal) ? "📸" : "📱";
        return $"{emoji} {LineaNombre(id, lineaNumero)}";
    }
    bool LineaActivaTieneNumero =>
        LineasDetectadas().Count == 1
        || (!string.IsNullOrEmpty(filtroLinea) && LineasDetectadas().Any(x => x.Id == filtroLinea));
    string LineaActivaTexto()
    {
        var ls = LineasDetectadas();
        if (ls.Count == 0) return "WhatsApp de la empresa";
        if (!string.IsNullOrEmpty(filtroLinea))
        {
            var sel = ls.FirstOrDefault(x => x.Id == filtroLinea);
            if (sel.Numero != null) return LineaNombre(sel.Id, sel.Numero);
        }
        if (ls.Count == 1) return LineaNombre(ls[0].Id, ls[0].Numero);
        return "Todas las líneas";
    }

    string filtroTexto = "";
    bool MatchFiltro(ApiClient.TwConvDto c)
    {
        if (!string.IsNullOrEmpty(filtroLinea) && c.Linea != filtroLinea) return false;
        // 2026-07-24: buscador por nombre de perfil, número o cliente vinculado
        if (!string.IsNullOrWhiteSpace(filtroTexto))
        {
            var q = filtroTexto.Trim();
            var hit = (c.NombrePerfil ?? "").Contains(q, StringComparison.OrdinalIgnoreCase)
                   || (c.Numero ?? "").Contains(q, StringComparison.OrdinalIgnoreCase)
                   || (c.ClienteNombre ?? "").Contains(q, StringComparison.OrdinalIgnoreCase);
            if (!hit) return false;
        }
        if (string.IsNullOrEmpty(filtroRol)) return true;
        if (filtroRol == "pedido") return EsPedido(c.UltimoMensaje);
        if (filtroRol == "sin") return string.IsNullOrEmpty(c.Rol);
        return c.Rol == filtroRol;
    }

    // Heuristica simple: si el mensaje contiene palabras tipicas de pedido.
    bool EsPedido(string? msg)
    {
        if (string.IsNullOrWhiteSpace(msg)) return false;
        var m = msg.ToLowerInvariant();
        return m.StartsWith("#ped") || m.StartsWith("pedido")
            || m.Contains("necesito") || m.Contains("pasame") || m.Contains("mandame")
            || m.Contains("traeme") || m.Contains("llevame") || m.Contains("encarg");
    }

    string RolEmoji(string? rol) => rol switch
    {
        "hermano" => "👨‍👦",
        "empleado" => "👷",
        "cliente" => "🛍️",
        "proveedor" => "🚚",
        _ => ""
    };

    string AvatarColor(ApiClient.TwConvDto c)
    {
        var bg = c.Rol switch
        {
            "hermano" => "#3b82f6",
            "empleado" => "#f59e0b",
            "cliente" => "#10b981",
            "proveedor" => "#8b5cf6",
            _ => "#25d366"
        };
        return $"background:{bg};";
    }

    public void Dispose()
    {
        refreshTimer?.Dispose();
        // Sacar el listener de pegado al salir de la pantalla (evita que Ctrl+V dispare avisos en otras páginas).
        try { _ = JS.InvokeVoidAsync("waPaste.unregister"); } catch { }
        _pasteRef?.Dispose();
    }
}
