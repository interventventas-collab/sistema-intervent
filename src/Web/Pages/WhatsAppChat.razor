        if (file.Size > MaxUploadBytes) { Toast.Error($"El archivo {file.Name} supera los 16 MB"); return; }
        catSubiendo = true;
        StateHasChanged();
        try
        {
            using var stream = file.OpenReadStream(MaxUploadBytes);
            var (resp, err) = await Api.UploadTwCatalogoAsync(stream, file.Name, file.ContentType);
            if (resp != null)
            {
                Toast.Success($"📚 Catálogo \"{resp.OriginalFilename}\" guardado");
                await CargarServerFiles();
            }
            else Toast.Error($"Error: {err}");
