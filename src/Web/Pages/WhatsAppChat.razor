@page "/whatsapp"
@page "/whatsapp/chat"
@attribute [Microsoft.AspNetCore.Authorization.Authorize]
@inject Web.Services.ApiClient Api
@inject Web.Services.OperatorService Op
@inject Web.Services.ToastService Toast
@inject Microsoft.AspNetCore.Components.NavigationManager Nav
@inject Microsoft.JSInterop.IJSRuntime JS
@inject Web.Services.AuthService AuthSvc
@inject Web.Services.PresenceService Presence
@inject Web.Services.WaAparienciaService Apariencia
@implements IDisposable

<PageTitle>WhatsApp — Chat</PageTitle>

@* 2026-07-23: solapas del sector WhatsApp unificado (pedido Osmar) — chats + pedidos, todo junto *@
@* 2026-07-29: barra superior rediseñada + cartelito "Línea activa" (para saber SIEMPRE con qué WhatsApp trabajás, ya que va a haber un 2° número) *@
@* 2026-08-05: en modo "una sola conversación" (solo=1) escondemos la barra superior entera:
   no hace falta el selector de líneas ni las solapas, porque se ve un único chat fijado. *@
@* 2026-08-17: PANTALLA COMPLETA (igual que el Mapeo). Esta caja tapa el menú de la izquierda y la
   barra de arriba del sistema, así el chat usa TODO el alto del navegador en vez de una franja.
   Para volver al sistema está el botón "← Volver" de acá abajo.
   z-index BAJO a propósito (200): alcanza para tapar el menú (100) pero deja que los carteles que
   saltan encima (visor de fotos 3000, adjuntar del servidor 1100, reenviar 1100, ficha 2100) sigan
   quedando por arriba, porque se dibujan FUERA de esta caja. *@
<div class="wa-fs">
<div class="wa-topbar" style="@(soloMode ? "display:none;" : "")">
    <div class="wa-tabs-top">
        <button class="wa-volver-sistema" @onclick="VolverAlSistema" title="Volver al sistema (cierra esta pantalla de WhatsApp)">← Volver</button>
        <span class="wa-tab-top active">💬 Chats</span>
        <a href="/whatsapp/pedidos" class="wa-tab-top">📥 Pedidos y configuración</a>
    </div>
    @* 2026-08-01: interruptor maestro del sonido de avisos (mismo que la campanita del panel flotante) *@
    <button class="wa-sonido-toggle" @onclick="ToggleSonidoMaster"
            title="@(sonidoMasterOn ? "Sonido de avisos ACTIVADO — tocá para silenciar" : "Sonido de avisos SILENCIADO — tocá para activar")">
        @(sonidoMasterOn ? "🔔" : "🔕") <span class="wa-sonido-txt">@(sonidoMasterOn ? "Con sonido" : "Silenciado")</span>
    </button>
    @* 2026-07-29 (Paso 2): el cartelito ahora es un SELECTOR. Tocándolo cambiás de línea o ves todas.
       Con una sola línea conectada muestra ese número y avisa que el 2° aparecerá acá. *@
    <div class="wa-linea-wrap">
        <button class="wa-linea-badge @(LineaActivaTieneNumero ? "on" : "")" @onclick="@(() => showLineaMenu = !showLineaMenu)"
                title="Número de WhatsApp que estás viendo. Tocá para cambiar de línea o ver todas.">
            <i class="wa-linea-icon">📱</i>
            <div class="wa-linea-txt">
                <span class="wa-linea-label">Línea</span>
                <span class="wa-linea-num">@LineaActivaTexto()</span>
            </div>
            <span class="wa-linea-dot @(LineaActivaTieneNumero ? "on" : "")"></span>
            <i class="wa-linea-caret">▾</i>
        </button>
        @if (showLineaMenu)
        {
            <div class="wa-linea-backdrop" @onclick="@(() => showLineaMenu = false)"></div>
            <div class="wa-linea-menu">
                @{ var _lineas = LineasDetectadas(); }
                @if (_lineas.Count > 1)
                {
                    <button class="wa-linea-opt @(filtroLinea=="" ? "sel" : "")" @onclick="@(() => SeleccionarLinea(""))">
                        <span>📞 Todas las líneas</span>
                        @if (filtroLinea=="") { <span class="wa-linea-check">✓</span> }
                    </button>
                }
                @foreach (var l in _lineas)
                {
                    <div class="wa-linea-row">
                        <button class="wa-linea-opt @(filtroLinea==l.Id ? "sel" : "")" @onclick="@(() => SeleccionarLinea(l.Id))">
                            @if (LineaImg(l.Id) is string _img) { <img src="@_img" class="wa-linea-av" alt="" /> } else { <span class="wa-linea-av-emoji">📱</span> }
                            <span>@LineaNombre(l.Id, l.Numero)</span>
                            @if (filtroLinea==l.Id) { <span class="wa-linea-check">✓</span> }
                        </button>
                        <button class="wa-linea-edit" title="Ponerle nombre e imagen a esta línea" @onclick="@(() => AbrirEditLinea(l.Id, l.Numero))">✏️</button>
                    </div>
                }
                @if (_lineas.Count <= 1)
                {
                    <div class="wa-linea-hint">💡 Cuando conectes el 2° número de WhatsApp va a aparecer acá para elegir con cuál trabajar. Ya está todo listo para ese momento.</div>
                }
                @* 2026-08-15: colores (claro/oscuro por línea) y letra de la pantalla *@
                <button class="wa-linea-opt" style="border-top:1px solid #eef1f5; border-radius:0 0 10px 10px; margin-top:0.25rem;"
                        @onclick="AbrirApariencia" title="Elegir si cada línea se ve clara u oscura, y con qué letra">
                    <span>🎨 Colores y letra</span>
                </button>
            </div>
        }
    </div>
</div>

@* 2026-08-15: la caja del WhatsApp se pinta según la LÍNEA con la que estás trabajando
   (FIJO TRANSRADIO oscuro, FRIKAF claro, etc.) + la letra elegida. Solo esta caja:
   el menú de la izquierda y la barra de arriba del sistema no se tocan. *@
<div class="wa-outer @Apariencia.ClasesPara(LineaParaTema())">
<div class="wa-root @(selectedNumero is null ? "" : "wa-chat-abierto") @(soloMode ? "wa-solo" : "")">
    @if (!soloMode)
    {
    <div class="wa-sidebar">
        @* 2026-08-05: encabezado rediseñado — buscador tipo píldora + botón moderno *@
        <div class="wa-side-header">
            <div class="wa-side-title-row">
                <span class="wa-side-title">💬 Conversaciones</span>
                <span class="wa-side-count" title="Conversaciones que estás viendo / total">@conversacionesFiltradas.Count / @conversaciones.Count</span>
            </div>
            <div class="wa-search-box">
                <span class="wa-search-ico">🔍</span>
                <input class="wa-search-input" placeholder="Buscar contacto…"
                       value="@filtroTexto" @oninput="e => filtroTexto = e.Value?.ToString() ?? string.Empty" />
                @if (!string.IsNullOrEmpty(filtroTexto))
                {
                    <button class="wa-search-clear" @onclick="() => filtroTexto = string.Empty" title="Limpiar búsqueda">×</button>
                }
            </div>
            <button class="wa-nueva-btn" @onclick="AbrirNuevaConv" title="Escribirle primero a alguien usando una plantilla aprobada">
                <span class="wa-nueva-ico">✍️</span> Nueva conversación
            </button>
        </div>
        @* 2026-08-05: un solo botón "Todos ▾" que despliega la lista de filtros (antes era una fila
           llena de botones que mareaba). Arranca siempre en "Todos". *@
        <div class="wa-filtro-wrap">
            <button class="wa-filtro-toggle @(filtroRol!="" ? "activo" : "")" @onclick="() => showFiltroMenu = !showFiltroMenu" title="Filtrar las conversaciones">
                <span>@FiltroRolLabel()</span>
                @if (filtroRol=="mios" && MisPendientes() > 0)
                {
                    <span class="wa-mios-badge">@MisPendientes()</span>
                }
                <span class="wa-filtro-caret">▾</span>
            </button>
            @if (filtroRol != "")
            {
                <button class="wa-filtro-clear" title="Ver todas otra vez" @onclick='() => PickFiltro("")'>×</button>
            }
            @if (showFiltroMenu)
            {
                <div class="wa-filtro-backdrop" @onclick="() => showFiltroMenu = false"></div>
                <div class="wa-filtro-menu">
                    <button class="wa-filtro-op @(filtroRol=="" ? "sel" : "")" @onclick='() => PickFiltro("")'>📥 Todos</button>

                    <div class="wa-filtro-grup">Estado de la charla</div>
                    <button class="wa-filtro-op @(filtroRol=="en_curso" ? "sel" : "")" @onclick='() => PickFiltro("en_curso")'>🟡 En curso</button>
                    <button class="wa-filtro-op @(filtroRol=="finalizada" ? "sel" : "")" @onclick='() => PickFiltro("finalizada")'>🟢 Finalizadas</button>
                    @if (!string.IsNullOrEmpty(OperadorActual))
                    {
                        <button class="wa-filtro-op @(filtroRol=="mios" ? "sel" : "")" @onclick='() => PickFiltro("mios")'>
                            🙋 Míos
                            @if (MisPendientes() > 0)
                            {
                                <span class="wa-mios-badge">@MisPendientes()</span>
                            }
                        </button>
                    }

                    <div class="wa-filtro-grup">Tipo de contacto</div>
                    <button class="wa-filtro-op @(filtroRol=="cliente" ? "sel" : "")" @onclick='() => PickFiltro("cliente")'>🛍️ Clientes</button>
                    <button class="wa-filtro-op @(filtroRol=="empleado" ? "sel" : "")" @onclick='() => PickFiltro("empleado")'>👷 Empleados</button>
                    <button class="wa-filtro-op @(filtroRol=="hermano" ? "sel" : "")" @onclick='() => PickFiltro("hermano")'>👨‍👦 Hermanos</button>
                    <button class="wa-filtro-op @(filtroRol=="alquiler" ? "sel" : "")" @onclick='() => PickFiltro("alquiler")'>🎪 Alquiler</button>
                    <button class="wa-filtro-op @(filtroRol=="cafe" ? "sel" : "")" @onclick='() => PickFiltro("cafe")'>☕ Café</button>
                    <button class="wa-filtro-op @(filtroRol=="sin" ? "sel" : "")" @onclick='() => PickFiltro("sin")' title="Charlas de gente sin tipo asignado">❓ Sin asignar</button>
                    <button class="wa-filtro-op @(filtroRol=="pedido" ? "sel" : "")" @onclick='() => PickFiltro("pedido")' title="Charlas donde el último mensaje parece un pedido">📋 Pedidos</button>

                    <div class="wa-filtro-grup">Guardadas</div>
                    <button class="wa-filtro-op @(filtroRol=="archivado" ? "sel" : "")" @onclick='() => PickFiltro("archivado")' title="Charlas que archivaste. Vuelven solas al listado si el cliente escribe de nuevo.">🗂️ Archivados</button>
                </div>
            }
        </div>
        @* 2026-08-05: los chips de línea/cuenta que estaban acá se sacaron — hacían lo MISMO que el
           selector "LÍNEA" de la barra superior (ambos usan filtroLinea). Estaba duplicado al pedo.
           Queda solo el cartelito "Viendo solo: X" de abajo como aviso + atajo para volver a todas. *@
        @if (!string.IsNullOrEmpty(filtroLinea) && LineasDetectadas().FirstOrDefault(x => x.Id == filtroLinea) is var lf && lf.Numero != null)
        {
            <div class="wa-linea-activa-chip">
                @if (LineaImg(lf.Id) is string _imv) { <img src="@_imv" class="wa-linea-av-xs" alt="" /> } else { <span>📱</span> }
                Viendo solo: <b>@LineaNombre(lf.Id, lf.Numero)</b>
                <button class="wa-linea-activa-x" @onclick='() => SeleccionarLinea("")' title="Ver todas las líneas">×</button>
            </div>
        }
        <div class="wa-conv-list">
            @if (loadingConv)
            {
                <div style="padding:1rem; color:#9ca3af;">Cargando…</div>
            }
            else if (conversaciones.Count == 0)
            {
                <div style="padding:1rem; color:#9ca3af; text-align:center;">
                    <p>📭 Sin conversaciones todavía.</p>
                    <p style="font-size:0.8rem;">Cuando alguien le escriba al WhatsApp de la empresa, la conversación aparece acá solita.</p>
                </div>
            }
            else if (conversacionesFiltradas.Count == 0)
            {
                <div style="padding:1rem; color:#9ca3af; text-align:center; font-size:0.85rem;">Sin resultados con este filtro.</div>
            }
            else
            {
                @foreach (var c in conversacionesFiltradas)
                {
                    <div class="wa-conv-item @(selectedNumero == c.Numero && selectedLinea == c.Linea ? "active" : "") @(EsPasadaAMi(c) ? "wa-conv-pasada" : "") @(c.Fijado ? "wa-conv-fijado" : "")" @onclick="() => SelectConv(c.Numero, c.Linea)">
                        @* 2026-08-06: PRESENCIA — avatarcito(s) del otro agente que tiene abierta esta fila. *@
                        @if (OtrosViewers(ConvIdDe(c.Numero, c.Linea)) is { Count: > 0 } _cvOtros)
                        {
                            <div class="wa-conv-presence" title="@(string.Join(", ", _cvOtros.Select(v => v.UserName)) + " está viendo este chat")">
                                @foreach (var v in _cvOtros.Take(3))
                                {
                                    <span class="wa-conv-presence-av @(v.IsTyping ? "typing" : "")">@(v.UserName.Length > 0 ? v.UserName.Substring(0, 1).ToUpper() : "?")</span>
                                }
                            </div>
                        }
                        <div class="wa-avatar-col">
                            <div class="wa-avatar-circle">
                                <div class="wa-avatar" style="@(AvatarColor(c))">@AvatarLetra(c)</div>
                                @if (!string.IsNullOrEmpty(c.Rol))
                                {
                                    <span class="wa-avatar-rol">@(RolEmoji(c.Rol) is string _re && _re != "" ? _re : "🏷️")</span>
                                }
                            </div>
                            @if (!string.IsNullOrEmpty(c.Rol))
                            {
                                <span class="wa-avatar-rol-label">@RolLabel(c.Rol)</span>
                            }
                        </div>
                        <div class="wa-conv-body">
                            <div class="wa-conv-row1">
                                <span class="wa-conv-name">
                                    @* 2026-08-19: chinche de los chats fijados (arriba de todo) *@
                                    @if (c.Fijado)
                                    {
                                        <span class="wa-fijado-pin" title="Chat fijado arriba de todo">📌</span>
                                    }
                                    @if (c.Canal == "INSTAGRAM")
                                    {
                                        @* 2026-07-31: Instagram → chip "IG" chico + el @usuario grande como nombre *@
                                        <span class="wa-ig-tag" title="Mensaje directo de Instagram">IG</span>
                                        <span>@MostrarNombreIg(c)</span>
                                    }
                                    else
                                    {
                                        @(c.NombrePerfil ?? PrettyNumero(c.Numero))
                                    }
                                    @* 2026-08-05: la categoría ahora se ve como emojito pisando el avatar (más copado) *@
                                    @* etiqueta de la CUENTA a la que escribió (con 2+ cuentas). Para IG el nombre grande
                                       es el remitente, así que acá va la cuenta (@frikaf_cafe) para saber por dónde entró. *@
                                    @if (LineasDetectadas().Count > 1 && !string.IsNullOrEmpty(c.LineaNumero))
                                    {
                                        <span class="wa-cuenta-tag" title="Cuenta a la que te escribió">@if (LineaImg(c.Linea) is string _imc) { <img src="@_imc" class="wa-linea-av-xs" alt="" /> }@LineaNombre(c.Linea, c.LineaNumero)</span>
                                    }
                                </span>
                                <span class="wa-conv-hora">@FormatHora(c.UltimoAt)</span>
                            </div>
                            <div class="wa-conv-row2">
                                <span class="wa-conv-last">
                                    @if (EsPedido(c.UltimoMensaje))
                                    {
                                        <span class="wa-pedido-chip">📋 PEDIDO</span>
                                    }
                                    @(c.UltimoDireccion == "OUTGOING" ? "✓ " : "")@TruncateText(c.UltimoMensaje, 45)
                                </span>
                                @* 2026-07-24: el badge verde se enciende SOLO si hay algo sin responder
                                   (último mensaje del cliente). Si ya respondimos, muestra "✓ leído" apagado. *@
                                @if (c.UltimoDireccion == "INCOMING")
                                {
                                    <span class="wa-conv-count" title="Sin responder">nuevo</span>
                                }
                                else
                                {
                                    <span class="wa-conv-leido" title="Ya le respondiste">✓ respondido</span>
                                }
                            </div>
                            @* 2026-08-04: estado + a quién se la pasaron *@
                            @if (c.Estado != "nueva" || !string.IsNullOrEmpty(c.AsignadoOperador))
                            {
                                <div class="wa-conv-row3">
                                    @if (c.Estado != "nueva")
                                    {
                                        <span class="wa-estado-chip" style="background:@EstadoColor(c.Estado);">@EstadoLabel(c.Estado)</span>
                                    }
                                    @if (!string.IsNullOrEmpty(c.AsignadoOperador))
                                    {
                                        @if (EsPasadaAMi(c))
                                        {
                                            <span class="wa-pasada-chip" title="@($"Te la pasó {c.AsignadoPor}")">🔔 Te la pasó @c.AsignadoPor</span>
                                        }
                                        else
                                        {
                                            <span class="wa-asignado-chip" title="@($"Responsable: {c.AsignadoOperador}")"><span class="wa-asignado-ini" style="background:@OperadorColor(c.AsignadoOperador);">@OperadorIni(c.AsignadoOperador)</span> @c.AsignadoOperador</span>
                                        }
                                    }
                                </div>
                            }
                        </div>
                        @* 2026-08-05: poner la categoría directo desde la lista, sin abrir el chat *@
                        <button class="wa-conv-rolbtn" title="Poner categoría (Cliente / Empleado / …)" @onclick:stopPropagation="true" @onclick="() => rolMenuConv = c">🏷️</button>
                        @* 2026-08-19: fijar / sacar de fijados (hasta 5), como el chinche de WhatsApp *@
                        <button class="wa-conv-pinbtn @(c.Fijado ? "on" : "")"
                                title="@(c.Fijado ? "Sacar de los fijados" : $"Fijar arriba de todo (hasta {MaxFijados})")"
                                @onclick:stopPropagation="true" @onclick="() => FijarConv(c)">📌</button>
                    </div>
                }
            }
        </div>
        @* menú de categoría rápida (se abre con el 🏷️ de cada conversación) *@
        @if (rolMenuConv is not null)
        {
            <div class="wa-rolmenu-backdrop" @onclick="() => rolMenuConv = null"></div>
            <div class="wa-rolmenu">
                <div class="wa-rolmenu-title">🏷️ Categoría de <b>@MostrarNombre(rolMenuConv)</b></div>
                <button class="wa-rolmenu-op" @onclick='() => AsignarRolRapido("cliente")'>🛍️ Cliente</button>
                <button class="wa-rolmenu-op" @onclick='() => AsignarRolRapido("empleado")'>👷 Empleado</button>
                <button class="wa-rolmenu-op" @onclick='() => AsignarRolRapido("hermano")'>👨‍👦 Hermano</button>
                <button class="wa-rolmenu-op" @onclick='() => AsignarRolRapido("proveedor")'>🚚 Proveedor</button>
                <button class="wa-rolmenu-op" @onclick='() => AsignarRolRapido("alquiler")'>🎪 Alquiler</button>
                <button class="wa-rolmenu-op" @onclick='() => AsignarRolRapido("cafe")'>☕ Café</button>
                <button class="wa-rolmenu-op" @onclick='() => AsignarRolRapido("otro")'>🏷️ Otro</button>
                <button class="wa-rolmenu-cancel" @onclick="() => rolMenuConv = null">Cancelar</button>
            </div>
        }
    </div>
    } @* fin @if (!soloMode) — lista lateral de conversaciones *@

@* 2026-08-17: el chat + el PANEL DERECHO viven juntos en esta caja. El panel es el patrón de
   todas las bandejas que trabajan con la API de WhatsApp (Chatwoot, respond.io, Zendesk):
   los datos y las acciones del contacto van a la derecha, no en filas arriba que le roban
   alto a la conversación. La tira de iconos del borde lo pliega y lo vuelve a abrir. *@
<div class="wa-thread-wrap">
    <div class="wa-thread">
        @if (selectedNumero is null)
        {
            @* 2026-08-03: el formulario de NUEVA CONVERSACIÓN vive acá, siempre a mano (ya no es una ventanita) *@
            <div class="wa-nv-panel">
                <div class="wa-nv-card">
                    <div class="wa-nv-head">
                        <span class="wa-nv-head-ico">@(LineaEsInstagram(filtroLinea) ? "📷" : "✍️")</span>
                        <div>
                            <div class="wa-nv-title">@(LineaEsInstagram(filtroLinea) ? "Instagram" : "Nueva conversación")</div>
                            <div class="wa-nv-sub">@(LineaEsInstagram(filtroLinea) ? "En Instagram solo respondés a quien te escribió" : "Escribile primero a alguien con una plantilla aprobada")</div>
                        </div>
                    </div>

                    @* 2026-08-05: en Instagram NO se puede escribir primero (no hay plantillas). Solo se responde. *@
                    @if (LineaEsInstagram(filtroLinea))
                    {
                        <div class="wa-nv-info" style="background:#fdf2f8; border-color:#f9a8d4; color:#9d174d;">
                            📷 Estás parado en <b>Instagram (@LineaNombre(filtroLinea, null))</b>. Acá <b>no se puede escribir primero</b>: en Instagram solo podés <b>responder</b> a quien te haya mandado un mensaje directo (y dentro de las 24hs). Elegí una charla de la izquierda para responderle.
                        </div>
                    }
                    else
                    {
                    <div class="wa-nv-info">💡 Para escribirle <b>primero</b> a alguien (que no te escribió en las últimas 24h) WhatsApp pide una <b>plantilla aprobada</b>. Cuando te responde, ya le escribís libre.</div>

                    @if (nvCargando)
                    {
                        <div class="wa-nv-muted" style="text-align:center; padding:1rem;">Cargando plantillas…</div>
                    }
                    else if (nvPlantillas.Count == 0)
                    {
                        <div style="text-align:center; padding:1rem; color:#b91c1c; font-size:0.9rem;">No hay plantillas aprobadas disponibles. Revisá que la cuenta de WhatsApp esté configurada.</div>
                    }
                    else
                    {
                        @if (nvLineas.Count > 1)
                        {
                            <div class="wa-nv-field">
                                <label class="wa-nv-label">Enviar desde la línea</label>
                                <select class="wa-nv-input" @bind="nvLineaPhoneId">
                                    @* La línea elegida queda primera. Cada opción muestra el nombre (ej "FRIKAF by INTERVENT") + el número *@
                                    @foreach (var l in nvLineas.OrderByDescending(x => x.PhoneId == nvLineaPhoneId))
                                    {
                                        var esIg = (l.Numero ?? "").StartsWith("IG ", StringComparison.Ordinal);
                                        var nom = LineaNombre(l.PhoneId, l.Numero);
                                        var pretty = PrettyNumero(l.Numero);
                                        var extra = (!esIg && nom != pretty) ? $" · {pretty}" : "";
                                        <option value="@l.PhoneId" @key="l.PhoneId">@(esIg ? "📷 " : "📱 ")@nom@extra</option>
                                    }
                                </select>
                            </div>
                        }

                        @* buscador estilo WhatsApp: una sola casilla (nombre o número) *@
                        @if (nvClienteSeleccionado != null)
                        {
                            <div class="wa-nv-chip">
                                <div class="wa-nv-avatar" style="background:#25d366;">@InicialDe(nvClienteSeleccionado)</div>
                                <div style="flex:1; min-width:0; line-height:1.25;">
                                    <div style="font-weight:700; color:#111; overflow:hidden; text-overflow:ellipsis; white-space:nowrap;">Le vas a escribir a @nvClienteSeleccionado</div>
                                    <div style="font-size:0.85rem; color:#16a34a;">@BonitoNumero(nvNumero)</div>
                                </div>
                                <button type="button" class="wa-nv-btn-ghost" @onclick="LimpiarNvCliente" title="Elegir otro contacto o número">✏️ Cambiar</button>
                            </div>
                        }
                        else
                        {
                            <div class="wa-nv-field" style="position:relative;">
                                <label class="wa-nv-label">¿A quién le escribís? <span style="color:#dc2626;">*</span></label>
                                <input class="wa-nv-input wa-nv-search" placeholder="🔍 Escribí un nombre o un número…"
                                       @bind="nvClienteQuery" @bind:event="oninput" @onkeyup="BuscarNvClientes" />
                                <span class="wa-nv-hint">Buscá por nombre (clientes, WhatsApp, MercadoLibre) o pegá un número con el código de país (54).</span>

                                @if (nvBuscandoCliente)
                                {
                                    <div class="wa-nv-muted">Buscando…</div>
                                }
                                @{ var directo = NvNumeroDirecto(); }
                                @if (directo != null || nvClienteResultados.Count > 0)
                                {
                                    <div class="wa-nv-results">
                                        @if (directo != null)
                                        {
                                            <button type="button" class="wa-nv-item" @onclick="() => UsarNumeroDirecto(directo)">
                                                <div class="wa-nv-avatar" style="background:#2563eb;">📱</div>
                                                <div style="flex:1; min-width:0;">
                                                    <div style="font-weight:700; color:#111;">Enviar a este número nuevo</div>
                                                    <div style="font-size:0.85rem; color:#2563eb;">@BonitoNumero(directo)</div>
                                                </div>
                                            </button>
                                        }
                                        @foreach (var cli in nvClienteResultados)
                                        {
                                            <button type="button" class="wa-nv-item" @onclick="() => SeleccionarNvCliente(cli)">
                                                <div class="wa-nv-avatar">@InicialDe(cli.Nombre)</div>
                                                <div style="flex:1; min-width:0;">
                                                    <div style="font-weight:600; color:#111; overflow:hidden; text-overflow:ellipsis; white-space:nowrap;">@cli.Nombre</div>
                                                    <div style="font-size:0.85rem; color:#6b7280;">@BonitoNumero(cli.Numero)</div>
                                                </div>
                                                <span class="wa-nv-origen">@OrigenLindo(cli.Origen)</span>
                                            </button>
                                        }
                                    </div>
                                }
                                else if (!string.IsNullOrWhiteSpace(nvClienteQuery) && nvClienteQuery.Length >= 2 && !nvBuscandoCliente)
                                {
                                    <div class="wa-nv-muted">Sin contactos para esa búsqueda. Si es un número nuevo, escribilo completo con el código de país (54) y el 9 de celular.</div>
                                }
                            </div>
                        }

                        <div class="wa-nv-field">
                            <label class="wa-nv-label">Plantilla <span style="color:#dc2626;">*</span></label>
                            <select class="wa-nv-input" value="@nvPlantillaName" @onchange="OnPlantillaChange">
                                <option value="">— Elegí una plantilla —</option>
                                @foreach (var p in nvPlantillas)
                                {
                                    <option value="@p.Name">@NombrePlantillaLindo(p.Name) (@p.Category.ToLower())</option>
                                }
                            </select>
                        </div>

                        @if (PlantillaSel() is {} pSel)
                        {
                            @if (pSel.VariableCount > 0)
                            {
                                <div class="wa-nv-field">
                                    <label class="wa-nv-label">Completá los datos de la plantilla</label>
                                    @for (int i = 0; i < pSel.VariableCount; i++)
                                    {
                                        var idx = i;
                                        <input class="wa-nv-input" style="margin-bottom:0.4rem;"
                                               placeholder="@PlaceholderVariable(idx)"
                                               value="@(idx < nvVariables.Count ? nvVariables[idx] : "")"
                                               @oninput="e => SetVariable(idx, e.Value?.ToString() ?? string.Empty)" />
                                    }
                                </div>
                            }

                            <div class="wa-nv-field">
                                <label class="wa-nv-label">Vista previa del mensaje</label>
                                <div class="wa-nv-preview">@PreviewTexto()</div>
                            </div>
                        }

                        <div class="wa-nv-actions">
                            <button class="wa-nv-btn-ghost" @onclick="AbrirNuevaConv" title="Limpiar y empezar de nuevo">🧹 Limpiar</button>
                            <button class="wa-nv-send" disabled="@(nvEnviando || PlantillaSel() == null || string.IsNullOrWhiteSpace(nvNumero))" @onclick="EnviarNuevaConv">
                                @(nvEnviando ? "Enviando…" : "📨 Enviar mensaje")
                            </button>
                        </div>
                    }
                    }
                </div>
            </div>
        }
        else
        {
            <div class="wa-thread-header">
                @* 2026-08-02: flecha para volver a la lista (solo celular) *@
                <button class="wa-volver-btn" @onclick="VolverALista" title="Volver a la lista de chats">←</button>
                @* 2026-08-05: avatar con la categoría encima; se toca para cambiarla al toque *@
                <button class="wa-avatar-col wa-avatar-btn" @onclick="() => rolMenuConv = SelectedConv()" title="Categoría del contacto — tocá para cambiarla">
                    <div class="wa-avatar-circle">
                        <div class="wa-avatar" style="@(AvatarColor(SelectedConv()))">@AvatarLetra(SelectedConv())</div>
                        <span class="wa-avatar-rol wa-avatar-rol-lg">@(RolEmoji(SelectedConv()?.Rol) is string _hre && _hre != "" ? _hre : "🏷️")</span>
                    </div>
                    <span class="wa-avatar-rol-label">@RolLabel(SelectedConv()?.Rol)</span>
                </button>
                <div style="flex:1;">
                    <div style="font-weight:600; display:flex; align-items:center; gap:0.45rem; flex-wrap:wrap;">
                        <span>@(MostrarNombre(SelectedConv()))</span>
                        @* 2026-08-05: ojito para ver la ficha del cliente, al lado del nombre (reemplaza el botón de la barra) *@
                        @if (SelectedConv()?.ClienteId is int)
                        {
                            <button class="wa-ver-cliente-ojo @(mostrarFichaCliente ? "activo" : "")" @onclick="ToggleFichaCliente" title="Ver la ficha del cliente (saldo, últimas facturas, ubicación) — tocá para abrir/cerrar">👁️</button>
                        }
                        @if (SelectedConv()?.Linea is string _lh)
                        {
                            <span class="wa-header-linea" title="Esta conversación es de tu línea: @LineaNombre(_lh, SelectedConv()?.LineaNumero)">
                                @if (LineaImg(_lh) is string _imh) { <img src="@_imh" class="wa-linea-av-xs" alt="" /> } else { <span>📱</span> }
                                @LineaNombre(_lh, SelectedConv()?.LineaNumero)
                            </span>
                        }
                    </div>
                    <div style="font-size:0.75rem; color:#6b7280; display:flex; gap:0.5rem; align-items:center;">
                        <span>@PrettyNumero(selectedNumero)</span>
                        <button class="wa-num-edit" @onclick="AbrirCorregirNumero" title="Corregir el número de este chat (si quedó mal cargado)">✏️</button>
                        @if (SelectedConv()?.ClienteId is int cid)
                        {
                            <a href="/cafe/clientes?edit=@cid" target="_blank" class="wa-cliente-badge" title="Ver ficha del cliente">
                                🛍️ Cliente: @SelectedConv()?.ClienteNombre
                            </a>
                        }
                    </div>
                </div>
                @* 2026-08-17: los botones (Vincular cliente, Editar contacto, Crear venta, ⚙, 🗑) y la
                   barra de Estado / Pasar a / Nota se fueron al PANEL DERECHO. Acá arriba queda una
                   sola fila fina: quién es. Eso solo le devolvió 125 px de alto a la conversación. *@
            </div>

            @* 2026-08-05: FICHA DEL CLIENTE — ventana flotante ARRASTRABLE con datos, saldo, ubicación y últimas facturas *@
            @if (mostrarFichaCliente && SelectedConv()?.ClienteId is int fichaCid)
            {
                <div class="wa-ficha wa-ficha-float" id="wa-ficha-float">
                    @if (cargandoFicha)
                    {
                        <div class="wa-ficha-top" id="wa-ficha-float-head" title="Arrastrá de acá para mover la ventana">
                            <div class="wa-ficha-nombre">✥ 🛍️ <b>Cargando…</b></div>
                            <button class="wa-ficha-x" @onclick="@(() => mostrarFichaCliente = false)" title="Cerrar">×</button>
                        </div>
                        <div class="wa-ficha-load">⏳ Cargando ficha del cliente…</div>
                    }
                    else if (fichaCliente is null)
                    {
                        <div class="wa-ficha-top" id="wa-ficha-float-head" title="Arrastrá de acá para mover la ventana">
                            <div class="wa-ficha-nombre">✥ 🛍️ <b>Cliente</b></div>
                            <button class="wa-ficha-x" @onclick="@(() => mostrarFichaCliente = false)" title="Cerrar">×</button>
                        </div>
                        <div class="wa-ficha-load">No se pudo cargar la ficha del cliente.</div>
                    }
                    else
                    {
                        <div class="wa-ficha-top" id="wa-ficha-float-head" title="Arrastrá de acá para mover la ventana a donde quieras">
                            <div class="wa-ficha-nombre">
                                <span class="wa-ficha-mover" title="Arrastrá para mover">✥</span>
                                🛍️ <b>@fichaCliente.Nombre</b>
                                @if (fichaCliente.CodigoInterno is int codi) { <span class="wa-ficha-cod">#@codi</span> }
                                @if (!string.IsNullOrWhiteSpace(fichaCliente.CondicionIva)) { <span class="wa-ficha-chip">@fichaCliente.CondicionIva</span> }
                            </div>
                            <button class="wa-ficha-x" @onclick="@(() => mostrarFichaCliente = false)" title="Cerrar">×</button>
                        </div>

                        <div class="wa-ficha-cols">
                            @* Columna 1: datos de contacto + ubicación *@
                            <div class="wa-ficha-datos">
                                @if (!string.IsNullOrWhiteSpace(fichaCliente.RazonSocial)) { <div><span class="wa-ficha-lbl">Razón social:</span> @fichaCliente.RazonSocial</div> }
                                @if (!string.IsNullOrWhiteSpace(fichaCliente.Cuit)) { <div><span class="wa-ficha-lbl">CUIT:</span> @fichaCliente.Cuit</div> }
                                @if (!string.IsNullOrWhiteSpace(fichaCliente.Telefono)) { <div><span class="wa-ficha-lbl">Tel:</span> @fichaCliente.Telefono @(string.IsNullOrWhiteSpace(fichaCliente.Telefono2) ? "" : $" / {fichaCliente.Telefono2}")</div> }
                                @if (!string.IsNullOrWhiteSpace(fichaCliente.Email)) { <div><span class="wa-ficha-lbl">Mail:</span> @fichaCliente.Email</div> }
                                @if (!string.IsNullOrWhiteSpace(fichaCliente.Direccion) || !string.IsNullOrWhiteSpace(fichaCliente.Localidad))
                                {
                                    <div><span class="wa-ficha-lbl">Dirección:</span> @fichaCliente.Direccion@(string.IsNullOrWhiteSpace(fichaCliente.Localidad) ? "" : $", {fichaCliente.Localidad}")</div>
                                }
                                @if (!string.IsNullOrWhiteSpace(fichaCliente.Notas)) { <div class="wa-ficha-notas">📝 @fichaCliente.Notas</div> }
                                <div class="wa-ficha-acc">
                                    @if (!string.IsNullOrWhiteSpace(fichaCliente.MapeoLink))
                                    {
                                        <a href="@fichaCliente.MapeoLink" target="_blank" class="wa-ficha-btn maps" title="Abrir la ubicación del cliente en Google Maps">📍 Ver en el mapa</a>
                                    }
                                    <a href="/cafe/clientes?edit=@fichaCid" target="_blank" class="wa-ficha-btn" title="Abrir la ficha completa del cliente (datos, CUIT, dirección…) en otra pestaña">📂 Ficha completa</a>
                                </div>
                            </div>

                            @* Columna 2: saldo + facturas *@
                            <div class="wa-ficha-plata">
                                <div class="wa-ficha-saldo @(fichaCliente.Saldo > 0.01m ? "debe" : "aldia")">
                                    <span class="wa-ficha-saldo-lbl">@(fichaCliente.Saldo > 0.01m ? "Debe" : "Cuenta al día")</span>
                                    <span class="wa-ficha-saldo-monto">$@fichaCliente.Saldo.ToString("N2")</span>
                                </div>
                                <div class="wa-ficha-facs-titulo">Últimas facturas</div>
                                @if (fichaCliente.Ventas.Count == 0)
                                {
                                    <div class="wa-ficha-vacio">Este cliente todavía no tiene facturas.</div>
                                }
                                else
                                {
                                    <div class="wa-ficha-facswrap" @onmouseleave="@(() => previewFacturaId = null)">
                                        <div class="wa-ficha-facs">
                                            @foreach (var v in fichaCliente.Ventas)
                                            {
                                                <a href="/api/cafe/ventas/@v.Id/pdf" target="_blank"
                                                   class="wa-ficha-fac @(previewFacturaId == v.Id ? "hover" : "")"
                                                   @onmouseenter="@(() => previewFacturaId = v.Id)"
                                                   title="Pasá el mouse para ver la factura · tocá para abrirla grande">
                                                    <span class="wa-ficha-fac-tipo">@(string.IsNullOrWhiteSpace(v.Tipo) ? "—" : v.Tipo)</span>
                                                    <span class="wa-ficha-fac-num">@v.Numero</span>
                                                    <span class="wa-ficha-fac-fecha">@v.Fecha.ToString("dd/MM/yy")</span>
                                                    <span class="wa-ficha-fac-total">$@v.Total.ToString("N2")</span>
                                                    @if (v.Tipo is not null && v.Tipo.StartsWith("NC"))
                                                    {
                                                        <span class="wa-ficha-fac-estado nc">N. Crédito</span>
                                                    }
                                                    else if (v.Saldo > 0.01m)
                                                    {
                                                        <span class="wa-ficha-fac-estado debe">Debe $@v.Saldo.ToString("N0")</span>
                                                    }
                                                    else
                                                    {
                                                        <span class="wa-ficha-fac-estado pagada">✓ Pagada</span>
                                                    }
                                                </a>
                                            }
                                        </div>
                                        @* 2026-08-05: mini vista previa del PDF al pasar el mouse por una factura *@
                                        @if (previewFacturaId is int pvid)
                                        {
                                            <div class="wa-ficha-preview">
                                                <div class="wa-ficha-preview-head">👁️ Vista previa — tocá la factura para abrirla grande</div>
                                                <iframe class="wa-ficha-preview-frame" src="/api/cafe/ventas/@pvid/pdf?inline=true#toolbar=0&navpanes=0&scrollbar=0&view=FitH" title="Vista previa de la factura"></iframe>
                                            </div>
                                        }
                                    </div>
                                }
                            </div>
                        </div>
                    }
                </div>
            }

            @* 2026-08-03: cartelito que ADIVINA el cliente por el teléfono y ofrece vincularlo de un toque *@
            @if (SelectedConv()?.ClienteId is null && sugerenciaCliente is not null)
            {
                <div class="wa-sug-cliente">
                    <span style="font-size:1.1rem;">💡</span>
                    <div style="flex:1; line-height:1.3;">
                        ¿Este chat es de <b>@sugerenciaCliente.Nombre</b>@(string.IsNullOrWhiteSpace(sugerenciaCliente.CodigoInterno) ? "" : $" (#{sugerenciaCliente.CodigoInterno})")?
                    </div>
                    <button class="btn btn-sm btn-success" @onclick="VincularSugerido" disabled="@vinculando" style="font-weight:600; white-space:nowrap;">
                        @(vinculando ? "⏳" : "✓ Sí, vincular")
                    </button>
                    <button class="btn btn-sm btn-outline-secondary" @onclick="DescartarSugerencia" disabled="@vinculando" style="white-space:nowrap;">No</button>
                </div>
            }

            @* 2026-07-23: id para poder bajar el scroll al ultimo mensaje (como WhatsApp de verdad) *@
            <div class="wa-messages" id="wa-messages-scroll" @ref="messagesScroll">
                @if (loadingMsg)
                {
                    <div style="padding:1rem; color:#9ca3af; text-align:center;">Cargando…</div>
                }
                else
                {
                    @* 2026-08-20: cartelitos "Hoy" / "Ayer" para partir la charla por dia, como
                       WhatsApp. Acá los mensajes van del mas viejo al mas nuevo y en orden normal,
                       asi que el cartelito va ANTES del primer mensaje de cada dia. (En el celular
                       la lista se dibuja al reves, ahi va en el otro extremo — ver PinnedWaChat.) *@
                    @for (int _i = 0; _i < mensajes.Count; _i++)
                    {
                        var m = mensajes[_i];
                        if (_i == 0 || !DateTimeExt.MismoDiaAr(mensajes[_i - 1].CreatedAt, m.CreatedAt))
                        {
                            <div class="wa-fecha-sep"><span>@DateTimeExt.EtiquetaDiaAr(m.CreatedAt)</span></div>
                        }
                        <div class="wa-msg-row @(m.Direccion == "OUTGOING" ? "out" : "in") @(mensajesSeleccionadosIds.Contains(m.Id) ? "selected" : "")" @onclick="() => ToggleSeleccionMensaje(m.Id)">
                            @if (mensajesSeleccionadosIds.Contains(m.Id))
                            {
                                <div class="wa-msg-check">✓</div>
                            }
                            <div class="wa-bubble-wrap">
                                <div class="wa-bubble @(m.Anulado ? "wa-anulado" : "")" id="@($"wamsg-{m.Id}")">
                                    @* 2026-08-05: "responder citando" — burbujita del mensaje al que responde este *@
                                    @if (!string.IsNullOrEmpty(m.ReplyPreview))
                                    {
                                        @* 2026-08-18: al hacer clic lleva al mensaje original y lo resalta (antes no hacía nada) *@
                                        <div class="wa-reply-quote wa-reply-clic" title="Ir al mensaje original"
                                             @onclick="() => IrAlCitado(m)" @onclick:stopPropagation="true">
                                            <span class="wa-reply-quote-who">@(m.ReplyFromMe ? "Vos" : MostrarNombre(SelectedConv()))</span>
                                            <span class="wa-reply-quote-text">@m.ReplyPreview</span>
                                        </div>
                                    }
                                    @if (!string.IsNullOrEmpty(m.MediaUrl))
                                    {
                                        @if (IsImage(m.MediaUrl))
                                        {
                                            @* 2026-08-07: los STICKERS (.webp) salían enormes (300px). Ahora chicos (~150px)
                                               como en WhatsApp; las fotos normales, un poco más contenidas (230px). *@
                                            @* al tocar la foto se abre un visor emergente (ventanita sobre el chat) *@
                                            <img src="@m.MediaUrl" class="wa-chat-img" @onclick="@(() => AbrirVisorImagen(m.MediaUrl, NombreDescarga(m)))"
                                                 style="max-width:@(EsSticker(m.MediaUrl) ? "150px" : "100%"); max-height:@(EsSticker(m.MediaUrl) ? "150px" : "230px"); border-radius:6px; display:block; cursor:zoom-in;" alt="adjunto" />
                                            @if (!EsSticker(m.MediaUrl))
                                            {
                                                @* botón para descargar la imagen (los stickers no hace falta) *@
                                                <a href="@m.MediaUrl" download="@NombreDescarga(m)" class="wa-descargar-btn">⬇ Descargar</a>
                                            }
                                        }
                                        else if (IsAudio(m.MediaUrl))
                                        {
                                            @* 2026-07-23: nota de voz — se escucha aca mismo, como en WhatsApp *@
                                            <audio controls preload="none" src="@m.MediaUrl" style="max-width:250px; height:40px; display:block; margin-bottom:0.2rem;"></audio>
                                            <a href="@m.MediaUrl" download="@NombreDescarga(m)" class="wa-descargar-btn">⬇ Descargar</a>
                                        }
                                        else
                                        {
                                            <a href="@m.MediaUrl" download="@NombreDescarga(m)" style="display:flex; align-items:center; gap:0.4rem; padding:0.5rem; background:#f3f4f6; border-radius:6px; text-decoration:none; color:#374151; margin-bottom:0.3rem;">
                                                <span style="font-size:1.5rem;">📎</span>
                                                @* 2026-07-23 pedido Osmar: mostrar nombre y tipo del archivo (antes decía "Archivo adjunto" pelado) *@
                                                <span style="font-size:0.85rem; flex:1;">@(string.IsNullOrWhiteSpace(m.MediaFilename) ? "Archivo adjunto" : m.MediaFilename)<br/><span style="font-size:0.7rem; color:#6b7280;">@WaTipoArchivo(m.MediaUrl, m.MediaFilename) · Tocá para descargar</span></span>
                                                <span style="font-size:1.1rem;">⬇</span>
                                            </a>
                                        }
                                    }
                                    @if (EsMensajeContacto(m.Cuerpo))
                                    {
                                        @* 2026-08-02: tarjeta de contacto compartido (recibido o enviado) *@
                                        @foreach (var ct in ParseContactos(m.Cuerpo))
                                        {
                                            <div class="wa-contacto-card">
                                                <span class="wa-contacto-ava">👤</span>
                                                <div style="flex:1; min-width:0;">
                                                    <div style="font-weight:600;">@ct.Nombre</div>
                                                    <div style="font-size:0.78rem; color:#6b7280;">+@ct.Numero</div>
                                                </div>
                                                <div style="display:flex; flex-direction:column; gap:0.3rem; flex-shrink:0;">
                                                    <button class="wa-contacto-btn" title="Escribirle a este contacto" @onclick="() => EscribirAContactoCompartido(ct.Nombre, ct.Numero)" @onclick:stopPropagation="true">💬 Escribir</button>
                                                    <button class="wa-contacto-btn" title="Guardar este contacto en tu agenda" @onclick="() => AgendarContactoCompartido(ct.Nombre, ct.Numero)" @onclick:stopPropagation="true">➕ Agendar</button>
                                                </div>
                                            </div>
                                        }
                                    }
                                    else if (!string.IsNullOrEmpty(m.Cuerpo))
                                    {
                                        @* 2026-08-20: mensajes largos recortados con "Leer más", como
                                           WhatsApp. OJO: se recorta el texto CRUDO y recién después se
                                           escapa, nunca al revés — cortar el HTML ya escapado puede
                                           partir un "&amp;" al medio y ensuciar la pantalla. *@
                                        <div class="wa-bubble-body">@((MarkupString)EscapeMsg(TextoMensaje.EsLargo(m.Cuerpo) && !textoAbierto.Contains(m.Id) ? TextoMensaje.Recortado(m.Cuerpo) : m.Cuerpo))</div>
                                        @if (TextoMensaje.EsLargo(m.Cuerpo))
                                        {
                                            <button type="button" class="wa-leermas"
                                                    @onclick="() => ToggleTexto(m.Id)" @onclick:stopPropagation="true">
                                                @(textoAbierto.Contains(m.Id) ? "Ver menos" : "Leer más")
                                            </button>
                                        }
                                    }
                                    <div class="wa-bubble-meta">
                                        @FormatHoraMsg(m.CreatedAt)
                                        @* 2026-07-24: tilditos de estado, solo en los mensajes que MANDAMOS *@
                                        @if (m.Direccion == "OUTGOING")
                                        {
                                            <span class="@TildeCss(m.EstadoEntrega)" title="@TildeTitulo(m.EstadoEntrega)">@TildeTexto(m.EstadoEntrega)</span>
                                        }
                                        @* 2026-08-07: aviso de que este mensaje está oculto para Depósito *@
                                        @if (m.OcultoDeposito && !esDeposito)
                                        {
                                            <span class="wa-oculto-badge" title="Este mensaje NO lo ve Depósito">🚫 oculto a Depósito</span>
                                        }
                                        @* 2026-08-19: cartelito de anulado. Tocándolo se deshace (por si te equivocaste). *@
                                        @if (m.Anulado)
                                        {
                                            <button class="wa-anulado-badge" @onclick="() => DesanularMensaje(m)" @onclick:stopPropagation="true"
                                                    title="Se mandó una corrección de este mensaje. El cliente lo sigue viendo normal en su celular. Tocá para deshacer.">
                                                ⚠️ anulado@(string.IsNullOrEmpty(m.AnuladoPor) ? "" : $" por {m.AnuladoPor}") · deshacer
                                            </button>
                                        }
                                    </div>
                                    @* 2026-08-19: los botoncitos y el selector de emojis pasaron ADENTRO del globito.
                                       Antes colgaban del contenedor de afuera, que se estira al 75% del ancho, asi que
                                       en los mensajes largos quedaban flotando hasta 144 px a un costado y nadie los
                                       encontraba. Colgando del globito quedan siempre pegados a el, mida lo que mida. *@
                                    @* Botón reaccionar — visible al hover *@
                                    <button class="wa-react-btn" @onclick="() => TogglePicker(m.Id)" title="Reaccionar">😊</button>
                                    @* 2026-08-05: botón responder citando — visible al hover *@
                                    <button class="wa-reply-btn" @onclick="() => IniciarResponder(m)" @onclick:stopPropagation="true" title="Responder citando este mensaje">↩️</button>
                                    @* 2026-08-19: CORREGIR — solo en los mensajes que mandamos nosotros. Un enviado no se
                                       puede borrar, así que deja el equivocado citado + el texto de aviso ya escrito. *@
                                    @if (m.Direccion == "OUTGOING" && !m.Anulado)
                                    {
                                        <button class="wa-corregir-btn" @onclick="() => IniciarCorregir(m)" @onclick:stopPropagation="true"
                                                title="Corregir: manda un aviso citando este mensaje y lo deja tachado para el equipo">⚠️</button>
                                    }
                                    @* 2026-08-07: ocultar/mostrar este mensaje a Depósito — solo admin/oficina.
                                       2026-08-12: y SOLO en los chats que ve Depósito (en el resto no tiene sentido). *@
                                    @if (!esDeposito && EsChatVisibleDeposito)
                                    {
                                        <button class="wa-hide-btn" @onclick="() => ToggleOcultarDeposito(m)" @onclick:stopPropagation="true"
                                                title="@(m.OcultoDeposito ? "Mostrar este mensaje a Depósito" : "Ocultar este mensaje a Depósito")">@(m.OcultoDeposito ? "👁" : "🚫")</button>
                                    }
                                    @if (pickerOpenMsgId == m.Id)
                                    {
                                        <div class="wa-emoji-picker">
                                            @foreach (var em in QuickEmojis)
                                            {
                                                <button class="wa-emoji-pick" @onclick="() => ReaccionarA(m.Id, em)">@em</button>
                                            }
                                        </div>
                                    }
                                </div>
                                @if (m.Reacciones != null && m.Reacciones.Count > 0)
                                {
                                    <div class="wa-reacciones">
                                        @foreach (var r in m.Reacciones)
                                        {
                                            @if (r.EsCliente)
                                            {
                                                @* Reacción del cliente: solo se muestra, no se toca (no podemos quitar la reacción de otro) *@
                                                <span class="wa-reaccion-chip cliente" title="Reacción del cliente">
                                                    @r.Emoji @if (r.Count > 1) { <span>@r.Count</span> }
                                                </span>
                                            }
                                            else
                                            {
                                                <button class="wa-reaccion-chip" @onclick="() => ReaccionarA(m.Id, r.Emoji)" title="Click para quitar">
                                                    @r.Emoji @if (r.Count > 1) { <span>@r.Count</span> }
                                                </button>
                                            }
                                        }
                                    </div>
                                }
                            </div>
                        </div>
                    }
                }
            </div>

            @if (modoElegirVenta || mensajesSeleccionadosIds.Count > 0)
            {
                <div class="wa-selection-bar">
                    @if (modoElegirVenta && mensajesSeleccionadosIds.Count == 0)
                    {
                        <span style="font-size:0.85rem; font-weight:600;">🧾 Tildá los mensajes del pedido y tocá "Abrir venta"</span>
                    }
                    else
                    {
                        <span style="font-size:0.85rem; font-weight:600;">✓ @mensajesSeleccionadosIds.Count seleccionado(s)</span>
                    }
                    <button class="btn btn-success btn-sm" @onclick="AbrirVentaDesdeChat" title="Abre Nueva Venta en una pestaña nueva con estos mensajes y el cliente (si el chat tiene uno asignado)">🧾 Abrir venta</button>
                    <button class="btn btn-primary btn-sm" @onclick="AbrirReenviar">↪ Reenviar</button>
                    <button class="btn btn-outline-secondary btn-sm" @onclick="CancelarSeleccionVenta">× Cancelar</button>
                </div>
            }
            @* 2026-08-04: Reenviar los mensajes tildados a uno o varios contactos (como WhatsApp) *@
            @if (showReenviar)
            {
                <div class="wa-fwd-overlay" @onclick="CerrarReenviar"></div>
                <div class="wa-fwd-modal" @onclick:stopPropagation="true">
                    <div class="wa-fwd-head">
                        <strong>↪ Reenviar @mensajesSeleccionadosIds.Count mensaje(s)</strong>
                        <button class="wa-fwd-x" @onclick="CerrarReenviar">×</button>
                    </div>
                    <div class="wa-fwd-sub">Elegí uno o varios contactos. A todos les llega lo mismo.</div>

                    @if (reenviarDestinos.Count > 0)
                    {
                        <div class="wa-fwd-chips">
                            @foreach (var d in reenviarDestinos)
                            {
                                <span class="wa-fwd-chip">@d.Nombre <button @onclick="() => QuitarDestino(d)" title="Quitar">×</button></span>
                            }
                        </div>
                    }

                    <input class="wa-nv-input wa-nv-search" placeholder="🔍 Buscá un nombre o un número…"
                           @bind="reenviarQuery" @bind:event="oninput" @onkeyup="BuscarReenviarDestinos" />

                    @if (reenviarBuscando)
                    {
                        <div class="wa-nv-muted">Buscando…</div>
                    }
                    @{ var fwdDirecto = ReenviarNumeroDirecto(); }
                    @if (fwdDirecto != null || reenviarResultados.Count > 0)
                    {
                        <div class="wa-fwd-list">
                            @if (fwdDirecto != null)
                            {
                                <button type="button" class="wa-nv-item" @onclick="() => AgregarDestinoDirecto(fwdDirecto)">
                                    <div class="wa-nv-avatar" style="background:#2563eb;">📱</div>
                                    <div style="flex:1; min-width:0;">
                                        <div style="font-weight:700; color:#111;">Reenviar a este número</div>
                                        <div style="font-size:0.85rem; color:#2563eb;">@BonitoNumero(fwdDirecto)</div>
                                    </div>
                                </button>
                            }
                            @foreach (var cli in reenviarResultados)
                            {
                                var ya = reenviarDestinos.Any(x => x.Numero == cli.Numero);
                                <button type="button" class="wa-nv-item @(ya ? "wa-fwd-sel" : "")" @onclick="() => ToggleDestino(cli)">
                                    <div class="wa-nv-avatar">@InicialDe(cli.Nombre)</div>
                                    <div style="flex:1; min-width:0;">
                                        <div style="font-weight:600; color:#111; overflow:hidden; text-overflow:ellipsis; white-space:nowrap;">@cli.Nombre</div>
                                        <div style="font-size:0.85rem; color:#6b7280;">@BonitoNumero(cli.Numero)</div>
                                        @if (cli.Disponible)
                                        {
                                            <span class="wa-fwd-badge ok">🟢 le podés escribir</span>
                                        }
                                        else
                                        {
                                            <span class="wa-fwd-badge no">🔒 fuera de 24 hs · necesita plantilla</span>
                                        }
                                    </div>
                                    <span style="color:#16a34a; font-weight:700;">@(ya ? "✓" : "")</span>
                                </button>
                            }
                        </div>
                    }
                    else if (!string.IsNullOrWhiteSpace(reenviarQuery) && reenviarQuery.Length >= 2 && !reenviarBuscando)
                    {
                        <div class="wa-nv-muted">Sin contactos para esa búsqueda. Si es un número nuevo, escribilo completo con el 54.</div>
                    }

                    <div class="wa-fwd-actions">
                        <button class="btn btn-outline-secondary btn-sm" @onclick="CerrarReenviar">Cancelar</button>
                        <button class="btn btn-success btn-sm" disabled="@(reenviarDestinos.Count == 0 || reenviando)" @onclick="ConfirmarReenviar">
                            @(reenviando ? "Enviando…" : $"↪ Reenviar a {reenviarDestinos.Count}")
                        </button>
                    </div>
                </div>
            }
            @* 2026-08-05: las respuestas rápidas se movieron a un desplegable arriba del botón Enviar (más abajo) *@
            @* 2026-07-29: Panel "Enviar saldo" — pone la deuda del cliente en el cuadro de mensaje (revisás y mandás con Enter) *@
            @if (showSaldoPanel)
            {
                <div class="wa-saldo-panel">
                    <div class="wa-saldo-head">
                        <strong>💰 Poner saldo en el mensaje</strong>
                        <button class="wa-saldo-x" @onclick="@(() => showSaldoPanel = false)">×</button>
                    </div>
                    @if (SelectedConv()?.ClienteId is int cidChat)
                    {
                        <button class="wa-saldo-cli destacado" @onclick="() => PonerSaldo(cidChat)" disabled="@saldoCargando">
                            🛍️ Cliente de este chat: <b>@SelectedConv()?.ClienteNombre</b>
                        </button>
                    }
                    <input class="form-control wa-saldo-buscar" placeholder="Buscar otro cliente por nombre…"
                           @bind="saldoQuery" @bind:event="oninput" @onkeyup="BuscarSaldoClientes" />
                    @if (saldoBuscando)
                    {
                        <div class="wa-saldo-info">Buscando…</div>
                    }
                    else if (!string.IsNullOrWhiteSpace(saldoQuery) && saldoResultados.Count == 0)
                    {
                        <div class="wa-saldo-info">Sin resultados</div>
                    }
                    @foreach (var cli in saldoResultados.Take(10))
                    {
                        <button class="wa-saldo-cli" @onclick="() => PonerSaldo(cli.Id)" disabled="@saldoCargando">
                            @cli.Nombre @(string.IsNullOrWhiteSpace(cli.CodigoInterno) ? "" : $"(#{cli.CodigoInterno})")
                        </button>
                    }
                    @if (saldoCargando)
                    {
                        <div class="wa-saldo-info">Trayendo saldo…</div>
                    }
                </div>
            }
            @* 2026-07-29: Panel "Pasar CBU" — tocás una cuenta y te arma los datos bancarios en el mensaje (revisás y mandás) *@
            @if (showCbuPanel)
            {
                <div class="wa-saldo-panel">
                    <div class="wa-saldo-head">
                        <strong>🏦 Pasar datos bancarios / CBU</strong>
                        <button class="wa-saldo-x" @onclick="@(() => showCbuPanel = false)">×</button>
                    </div>
                    @if (datosBancarios.Count(x => x.Activo) == 0)
                    {
                        <div class="wa-saldo-info">Todavía no cargaste ninguna cuenta. Entrá a ⚙️ Configuración → "Datos bancarios / CBUs" para agregar.</div>
                    }
                    @foreach (var cb in datosBancarios.Where(x => x.Activo).OrderBy(x => x.Orden))
                    {
                        <button class="wa-saldo-cli" @onclick="() => InsertarCbu(cb, false)" title="Insertar CBU completo">
                            🏦 <b>@cb.Nombre</b>@(string.IsNullOrWhiteSpace(cb.Banco) ? "" : $" · {cb.Banco}")
                        </button>
                        @if (!string.IsNullOrWhiteSpace(cb.Alias))
                        {
                            <button class="wa-saldo-cli wa-cbu-solo-alias" @onclick="() => InsertarCbu(cb, true)" title="Insertar solo el alias">
                                ↳ Solo alias: <b>@cb.Alias</b>
                            </button>
                        }
                    }
                </div>
            }
            @* 2026-08-02: Panel "Compartir contacto" — buscás un contacto y se lo mandás como tarjeta al chat *@
            @if (showContactoPanel)
            {
                <div class="wa-saldo-panel">
                    <div class="wa-saldo-head">
                        <strong>👤 Compartir un contacto</strong>
                        <button class="wa-saldo-x" @onclick="@(() => showContactoPanel = false)">×</button>
                    </div>
                    <input class="form-control wa-saldo-buscar" placeholder="Buscar contacto por nombre o número…"
                           @bind="contactoQuery" @bind:event="oninput" @onkeyup="BuscarContactosCompartir" />
                    @if (contactoBuscando)
                    {
                        <div class="wa-saldo-info">Buscando…</div>
                    }
                    else if (!string.IsNullOrWhiteSpace(contactoQuery) && contactoQuery.Length >= 2 && contactoResultados.Count == 0)
                    {
                        <div class="wa-saldo-info">Sin contactos con teléfono para esa búsqueda.</div>
                    }
                    @foreach (var cli in contactoResultados)
                    {
                        <button class="wa-saldo-cli" @onclick="() => CompartirContacto(cli)" disabled="@enviandoContacto">
                            👤 <b>@cli.Nombre</b> <span style="color:#6b7280;">— @cli.Numero</span>
                            <span style="font-size:0.65rem; color:#2563eb;">@cli.Origen</span>
                        </button>
                    }
                    @if (enviandoContacto) { <div class="wa-saldo-info">Enviando contacto…</div> }
                </div>
            }
            @* 2026-08-05: los dos carteles verdes ("Le respondés desde…" y "Te quedan…") se movieron
               abajo del cuadro de escribir, uno al lado del otro, para ocupar menos alto. *@
            @if (Ventana24Abierta() || EsChatInstagram())
            {
                @* 2026-08-05: FIRMA de Depósito — quién responde. Lo que escriban sale firmado
                   "OK (alex)". Obligatorio: si no eligieron, no deja enviar. Solo para Depósito. *@
                @if (esDeposito)
                {
                    <div class="wa-firma-bar">
                        <span class="wa-firma-lbl">✍️ Responde:</span>
                        @foreach (var f in FirmantesDeposito)
                        {
                            <button class="wa-firma-op @(firmante == f ? "sel" : "")" @onclick="() => ElegirFirmante(f)">@f</button>
                        }
                        @if (!string.IsNullOrEmpty(firmante))
                        {
                            <span class="wa-firma-hint">sale como <b>… (@firmante)</b></span>
                        }
                        else
                        {
                            <span class="wa-firma-hint wa-firma-falta">👈 elegí quién responde</span>
                        }
                    </div>
                }
                @* 2026-08-06: PRESENCIA — franja discreta: quién más está viendo/escribiendo este chat. *@
                @if (OtrosViewers(ConvIdActual()) is { Count: > 0 } _otros)
                {
                    <div class="wa-presencia">
                        <span class="wa-presencia-dot"></span>
                        @if (_otros.Where(v => v.IsTyping).ToList() is { Count: > 0 } _tip)
                        {
                            <span><b>@string.Join(", ", _tip.Select(v => v.UserName))</b> está@(_tip.Count > 1 ? "n" : "") escribiendo…</span>
                        }
                        else
                        {
                            <span><b>@string.Join(", ", _otros.Select(v => v.UserName))</b> está@(_otros.Count > 1 ? "n" : "") viendo esta conversación</span>
                        }
                    </div>
                }
                @* Aviso ÁMBAR: el otro está escribiendo Y yo también → alerta (solo visual, no bloquea). *@
                @if (yoTipeando && OtrosViewers(ConvIdActual()).Where(v => v.IsTyping).ToList() is { Count: > 0 } _tipA)
                {
                    <div class="wa-presencia-alerta">
                        ⚠️ <b>@string.Join(", ", _tipA.Select(v => v.UserName))</b> también está@(_tipA.Count > 1 ? "n" : "") escribiendo
                    </div>
                }
                @* 2026-08-05: BANDEJA DE PENDIENTES — adjuntos esperando salir. Se envían todos juntos
                   (con el texto del cajón de pie del primero) al tocar Enviar o Enter. *@
                @if (pendientes.Count > 0)
                {
                    <div class="wa-pending-tray">
                        <div class="wa-pending-head">📎 Para enviar (@pendientes.Count) — escribí un texto si querés y tocá <b>Enviar</b></div>
                        <div class="wa-pending-items">
                            @foreach (var p in pendientes)
                            {
                                <div class="wa-pending-item">
                                    @if (!string.IsNullOrEmpty(p.PreviewUrl))
                                    {
                                        @* 2026-08-19: la miniatura medía 34 px — no alcanzaba para darse cuenta
                                           de que era la foto equivocada. Ahora es más grande y al tocarla se abre
                                           en grande con el mismo visor de las fotos del chat. *@
                                        <img class="wa-pending-thumb" src="@p.PreviewUrl" alt="" loading="lazy"
                                             title="Tocá para verla en grande antes de mandarla"
                                             @onclick="@(() => AbrirVisorImagen(p.PreviewUrl!, p.FileName))" />
                                    }
                                    else
                                    {
                                        <span class="wa-pending-ico">@p.Icono</span>
                                    }
                                    <span class="wa-pending-name" title="@p.Label">@p.Label</span>
                                    <button class="wa-pending-x" @onclick="() => QuitarPendiente(p)" title="Sacar de la lista">×</button>
                                </div>
                            }
                        </div>
                    </div>
                }
                @* 2026-08-05: barra "respondiendo a…" (responder citando). Aparece arriba del cajón. *@
                @if (replyingTo != null)
                {
                    <div class="wa-reply-bar">
                        <div class="wa-reply-bar-icon">↩️</div>
                        <div class="wa-reply-bar-body">
                            <div class="wa-reply-bar-who">Respondiendo a @(replyingTo.Direccion == "OUTGOING" ? "vos mismo" : MostrarNombre(SelectedConv()))</div>
                            <div class="wa-reply-bar-text">@PreviewMensajeParaResponder(replyingTo)</div>
                        </div>
                        <button class="wa-reply-bar-x" @onclick="CancelarResponder" title="Cancelar respuesta">×</button>
                    </div>
                }
                @* 2026-08-17: el cajón pasó a DOS renglones: arriba la tira de herramientas (antes
                   era una columna al costado que medía 230 px de alto) y abajo el cuadro con Enviar. *@
                <div class="wa-composer">
                    @* 2026-08-18: confirmación antes de mandarle el menú de opciones al cliente. *@
                    @if (confirmarMenuRol)
                    {
                        <div class="wa-confirmar-menurol">
                            <span class="wa-confirmar-txt">
                                ¿Le mando el menú de opciones ("¿con quién te querés contactar?") a
                                <strong>@(SelectedConv()?.ClienteNombre ?? SelectedConv()?.NombrePerfil ?? selectedNumero)</strong>?
                            </span>
                            <button class="wa-confirmar-no" @onclick="@(() => confirmarMenuRol = false)">No</button>
                            <button class="wa-confirmar-si" @onclick="ConfirmarYEnviarMenuRol" disabled="@enviandoMenuRol">
                                @(enviandoMenuRol ? "Enviando…" : "Sí, mandalo")
                            </button>
                        </div>
                    }
                    <div class="wa-composer-tools-row">
                        @* MENÚ ROL — antes era una miniatura de 110 px del cartel que le llega al cliente.
                           Ahora es un botón de la tira; la miniatura aparece al pasarle el mouse por encima. *@
                        @if (SelectedConv()?.Canal != "INSTAGRAM")
                        {
                            @* 2026-08-18: antes salía de un toque. Ahora pregunta primero (mismo criterio que el celu). *@
                            <button class="wa-menurol-mini" @onclick="@(() => confirmarMenuRol = true)" disabled="@enviandoMenuRol"
                                    title="Tocá para enviarle al cliente este menú y que se identifique (Frikaf / Intervent / Intereventos)">
                                <span class="wa-menurol-cap">@(enviandoMenuRol ? "⏳ Enviando…" : "👆 Menú rol")</span>
                                <span class="wa-menurol-bubble">
                                    <span class="wa-menurol-txt">¡Hola! 👋 Gracias por escribirnos.<br />¿Con quién te querés contactar?</span>
                                    <span class="wa-menurol-opt">☕ Cafés Frikaf</span>
                                    <span class="wa-menurol-opt">🏢 Intervent</span>
                                    <span class="wa-menurol-opt">🪑 Intereventos</span>
                                </span>
                            </button>
                        }
                        <div class="wa-composer-tools">
                            @* Botón adjuntar archivo de la PC *@
                            <label class="wa-attach-btn @(uploading ? "uploading" : "")" title="Adjuntar archivo de tu PC (máx 16 MB)">
                                <InputFile OnChange="OnArchivoSeleccionado" disabled="@(uploading || sending)" style="display:none;" />
                                @(uploading ? "⏳" : "📎")
                            </label>
                            @* Botón adjuntar desde el servidor *@
                            <button class="wa-attach-btn" title="Adjuntar del servidor (cobranzas, uploads previos)" @onclick="AbrirAdjuntarServidor" disabled="@(uploading || sending)">🗂️</button>
                            @* 2026-07-29: Enviar saldo de un cliente *@
                            <button class="wa-attach-btn wa-saldo-btn" title="Enviar saldo (deuda) de un cliente" @onclick="ToggleSaldoPanel" disabled="@(uploading || sending)">💰</button>
                            @* 2026-07-29: Pasar CBU / datos bancarios *@
                            <button class="wa-attach-btn wa-cbu-btn" title="Pasar un CBU / datos bancarios al cliente" @onclick="ToggleCbuPanel" disabled="@(uploading || sending)">🏦</button>
                            @* 2026-08-02: compartir una tarjeta de contacto *@
                            <button class="wa-attach-btn" title="Compartir un contacto (tarjeta con nombre y número)" @onclick="ToggleContactoPanel" disabled="@(uploading || sending)">👤</button>
                            @* 2026-08-01: nota de voz (micrófono) *@
                            @if (!grabandoAudio)
                            {
                                <button class="wa-attach-btn wa-mic-btn" title="Grabar nota de voz" @onclick="ToggleGrabarAudio" disabled="@(uploading || sending || enviandoAudio)">@(enviandoAudio ? "⏳" : "🎤")</button>
                            }
                            else
                            {
                                <button class="wa-attach-btn wa-mic-rec" title="Parar y enviar" @onclick="ToggleGrabarAudio">⏹️</button>
                                <button class="wa-attach-btn" title="Cancelar" @onclick="CancelarAudio">✖️</button>
                                <span class="wa-mic-rec-label">● grabando…</span>
                            }
                        </div>
                        @* 2026-08-17: "Alta de clientes" y "Respuestas" subieron acá desde la columna
                           de la derecha. Así no quedan dos columnas pegadas contra el borde derecho
                           (la del cajón y la del panel) y el cuadro de escribir gana ese lugar. *@
                        <button class="wa-alta-cliente-btn" @onclick="InsertarLinkAltaCliente" title="Insertar el link de alta de clientes en el mensaje">
                            🔗 Alta de clientes
                        </button>
                        @if (respuestas.Any(r => r.Activo) && (Ventana24Abierta() || EsChatInstagram()))
                        {
                            <div class="wa-qr">
                                <button class="wa-qr-toggle @(showQuickReplies ? "abierto" : "")" @onclick="@(() => showQuickReplies = !showQuickReplies)" title="Respuestas rápidas guardadas — insertan el texto en el mensaje">
                                    ⚡ Respuestas @(showQuickReplies ? "▾" : "▴")
                                </button>
                                @if (showQuickReplies)
                                {
                                    <div class="wa-qr-dropdown">
                                        @foreach (var r in respuestas.Where(x => x.Activo).OrderBy(x => x.Orden))
                                        {
                                            <button class="wa-chip" @onclick="@(() => { InsertarRespuesta(r); showQuickReplies = false; })" title="@r.Texto">
                                                @r.Nombre
                                            </button>
                                        }
                                    </div>
                                }
                            </div>
                        }
                    </div>
                    @* 2026-07-23: @bind:event="oninput" es CLAVE — sin esto el texto solo se guarda al salir del
   campo, y al apretar Enter el sistema veia el mensaje vacio (no enviaba nada). *@
                    @* 2026-08-17: rows="1" + el crecimiento automático de wa-composer.js. Antes tenía
                       145 px de alto fijo aunque escribieras una palabra. La LETRA sigue grande. *@
                    <div class="wa-composer-main">
                        <textarea class="form-control wa-composer-input" placeholder="Escribir mensaje… (Enter para enviar, Shift+Enter para renglón nuevo)" @bind="composerText" @bind:event="oninput" rows="1"></textarea>
                        <button class="btn btn-success wa-enviar-btn @(sending ? "enviando" : "")" @onclick="EnviarMensaje" disabled="@((string.IsNullOrWhiteSpace(composerText) && pendientes.Count == 0) || sending)">
                            @(sending ? "⏳ Enviando…" : (pendientes.Count > 0 ? $"📤 Enviar ({pendientes.Count} 📎)" : "📤 Enviar"))
                        </button>
                    </div>
                </div>
            }
            else if (EsChatInstagram())
            {
                <div class="wa-plantilla-chat wa-plantilla-chat-ig">
                    <div class="wa-plantilla-chat-head">
                        <span class="wa-plantilla-chat-ico">📷</span>
                        <div>
                            <div class="wa-plantilla-chat-title">Pasaron más de 24 hs</div>
                            <div class="wa-plantilla-chat-sub">En Instagram no se puede escribir fuera de las 24 hs (no hay plantillas). Hay que esperar a que te vuelva a escribir.</div>
                        </div>
                    </div>
                </div>
            }
            else
            {
                @* Ventana cerrada en WhatsApp → elegí una plantilla acá mismo, sin salir del chat *@
                <div class="wa-plantilla-chat">
                    <div class="wa-plantilla-chat-head">
                        <span class="wa-plantilla-chat-ico">✍️</span>
                        <div>
                            <div class="wa-plantilla-chat-title">Escribile con una plantilla</div>
                            <div class="wa-plantilla-chat-sub">Como pasaron más de 24 hs, WhatsApp pide una plantilla aprobada para volver a escribirle. Cuando te responda, ya le escribís libre otra vez.</div>
                        </div>
                    </div>
                    @if (nvPlantillas.Count == 0)
                    {
                        <div class="wa-plantilla-chat-empty">No hay plantillas aprobadas disponibles. Revisá la configuración de WhatsApp.</div>
                    }
                    else
                    {
                        <select class="wa-nv-input" value="@chatPlantillaName" @onchange="OnChatPlantillaChange">
                            <option value="">— Elegí una plantilla —</option>
                            @foreach (var p in nvPlantillas)
                            {
                                <option value="@p.Name">@NombrePlantillaLindo(p.Name) (@p.Category.ToLower())</option>
                            }
                        </select>
                        @if (ChatPlantillaSel() is {} cpSel)
                        {
                            @if (cpSel.VariableCount > 0)
                            {
                                <div style="margin-top:0.5rem;">
                                    @for (int i = 0; i < cpSel.VariableCount; i++)
                                    {
                                        var idx = i;
                                        <input class="wa-nv-input" style="margin-bottom:0.4rem;"
                                               placeholder="@PlaceholderVar(cpSel, idx)"
                                               value="@(idx < chatVariables.Count ? chatVariables[idx] : "")"
                                               @oninput="e => SetChatVariable(idx, e.Value?.ToString() ?? string.Empty)" />
                                    }
                                </div>
                            }
                            <div class="wa-nv-preview" style="margin-top:0.5rem;">@ChatPreviewTexto()</div>
                            <button class="wa-nueva-btn" style="margin-top:0.6rem;" disabled="@chatPlantillaEnviando" @onclick="EnviarPlantillaEnChat">
                                <span class="wa-nueva-ico">📨</span> @(chatPlantillaEnviando ? "Enviando…" : "Enviar plantilla")
                            </button>
                        }
                    }
                </div>
            }
            @* 2026-08-17: los avisos van TODOS en un solo renglón fino (antes eran tres renglones:
               dos carteles verdes + la explicación larga de la regla de las 24 hs, que ahora es el
               globito del 💡 — el texto completo sigue estando, al pasar el mouse). *@
            <div class="wa-avisos-row">
                <span class="wa-avisos-regla" title="Regla de WhatsApp: podés responder gratis a quien te haya escrito en las últimas 24 hs. Para escribir primero hacen falta plantillas aprobadas por Meta.">💡</span>
                @if (LineasDetectadas().Count > 1 && SelectedConv()?.LineaNumero is string _lnResp)
                {
                    <div class="wa-composer-linea" title="La respuesta le llega desde este número tuyo, el mismo por el que el cliente te escribió.">
                        📱 Le respondés desde <b>@LineaNombre(SelectedConv()?.Linea, _lnResp)</b>
                    </div>
                }
                @if (Restante24hs() is TimeSpan _tv && _tv > TimeSpan.Zero)
                {
                    <div class="wa-vent24 @(_tv.TotalHours < 1 ? "urgente" : "ok")" title="Tiempo que te queda para escribirle sin plantilla. Se reinicia cada vez que el cliente te escribe.">
                        <span class="wa-vent24-reloj">⏳</span>
                        <span>Te quedan <b>@FormatoRestante(_tv)</b> para escribirle libre</span>
                    </div>
                }
                else
                {
                    <div class="wa-vent24 cerrada" title="Se cerró la ventana de 24 hs">
                        <span class="wa-vent24-dot"></span>
                        <span>@(UltimoEntranteAt() == null ? "Todavía no te escribió — arrancá con una plantilla" : "Se cerró la ventana de 24 hs")</span>
                    </div>
                }
            </div>
        }
    </div>

    @* ══════════ PANEL DERECHO (contacto + conversación) ══════════
       Vive al lado del chat, no arriba, así no le come alto a los mensajes.
       Se pliega con la tira de iconos del borde y queda guardado para la próxima vez. *@
    @if (selectedNumero is not null)
    {
        @if (ctxAbierto)
        {
            <aside class="wa-ctx">
                <div class="wa-ctx-sec">
                    <div class="wa-ctx-sec-t">👤 Contacto</div>
                    @if (SelectedConv()?.ClienteId is null)
                    {
                        <button class="wa-ctx-btn wa-ctx-btn-ok" @onclick="AbrirVincularCliente" title="Asociar este chat a un cliente del sistema en un paso">
                            🔗 Vincular cliente
                        </button>
                    }
                    @if (!EstaEnContactos(selectedNumero))
                    {
                        <button class="wa-ctx-btn" @onclick="AbrirAsignarContacto" title="Agregar este número como contacto">
                            ➕ Asignar contacto
                        </button>
                    }
                    else
                    {
                        <button class="wa-ctx-btn" @onclick="AbrirEditarContacto" title="Editar este contacto">
                            ✏️ Editar contacto
                        </button>
                    }
                    <button class="wa-ctx-btn @(modoElegirVenta ? "wa-ctx-btn-on" : "")" @onclick="IniciarCrearVenta" title="Crear una venta: elegí uno o varios mensajes del pedido y se abre Nueva Venta en una pestaña nueva">
                        🧾 Crear venta
                    </button>
                    @* La ficha (saldo, últimas facturas, ubicación) es la MISMA ventana del ojito
                       que está al lado del nombre: un solo lugar donde se arma, dos formas de abrirla. *@
                    @if (SelectedConv()?.ClienteId is int)
                    {
                        <button class="wa-ctx-btn @(mostrarFichaCliente ? "wa-ctx-btn-on" : "")" @onclick="ToggleFichaCliente" title="Ver la ficha del cliente: saldo, últimas facturas y ubicación">
                            🛍️ Ficha del cliente
                        </button>
                    }
                </div>

                <div class="wa-ctx-sec">
                    <div class="wa-ctx-sec-t">💬 Conversación</div>
                    <label class="wa-ctx-lbl">Estado</label>
                    @{ var _estSel = SelectedConv()?.Archivado == true ? "archivado" : (SelectedConv()?.Estado ?? "nueva"); }
                    <select class="wa-ctx-select" value="@_estSel" @onchange="OnEstadoChange"
                            style="border-color:@EstadoColor(_estSel); color:@EstadoColor(_estSel); font-weight:700;"
                            title="Estado de esta conversación">
                        @foreach (var e in EstadosLista)
                        {
                            <option value="@e.Key">@e.Label</option>
                        }
                        @* 2026-08-09: archivar la charla desde el mismo desplegable de estado *@
                        <option value="archivado">🗂️ Archivado</option>
                    </select>

                    <label class="wa-ctx-lbl">Pasar a</label>
                    <select class="wa-ctx-select" value="@(SelectedConv()?.AsignadoOperador ?? "")" @onchange="OnPasarChange"
                            style="@(string.IsNullOrEmpty(SelectedConv()?.AsignadoOperador) ? "" : $"border-color:{OperadorColor(SelectedConv()?.AsignadoOperador)};color:{OperadorColor(SelectedConv()?.AsignadoOperador)};font-weight:700;")"
                            title="Responsable de esta conversación">
                        <option value="">— Sin asignar —</option>
                        @foreach (var op in OperadoresPasar)
                        {
                            <option value="@op">@op</option>
                        }
                    </select>

                    <label class="wa-ctx-lbl">📝 Nota</label>
                    <input class="wa-ctx-input" placeholder="ej. falta coordinar entrega…"
                           @bind="asignarNota" @bind:event="oninput" maxlength="300" />
                    <button class="wa-ctx-btn wa-ctx-btn-guardar" @onclick="GuardarNotaConv" disabled="@guardandoNota" title="Guardar la nota de esta conversación">
                        @(guardandoNota ? "⏳ Guardando…" : "💾 Guardar")
                    </button>

                    @* 2026-08-19: sonido de aviso PROPIO de esta charla. Le gana al de la línea, para que
                       un cliente importante suene distinto al resto. *@
                    <label class="wa-ctx-lbl">🔔 Sonido de aviso</label>
                    <div style="display:flex; gap:0.3rem; align-items:center;">
                        <select class="wa-ctx-select" style="flex:1;" value="@(SelectedConv()?.Sonido ?? "")" @onchange="OnSonidoConvChange"
                                title="Cuando te escriba este contacto va a sonar así, aunque la línea tenga otro">
                            <option value="">🔔 El de la línea (@NombreSonido(SonidoDeLineaActual()))</option>
                            @foreach (var so in SonidosDisponibles) { <option value="@so.Key">@so.Label</option> }
                            @if (sonidosSubidos.Count > 0)
                            {
                                <optgroup label="Sonidos que subiste">
                                    @foreach (var so in sonidosSubidos) { <option value="@so.Clave">🎵 @so.Nombre</option> }
                                </optgroup>
                            }
                        </select>
                        <button class="wa-ctx-btn" style="width:auto; padding:0.25rem 0.5rem;" title="Escuchar cómo suena"
                                @onclick="@(() => ProbarSonido(string.IsNullOrEmpty(SelectedConv()?.Sonido) ? SonidoDeLineaActual() : SelectedConv()!.Sonido!))">▶</button>
                    </div>
                    <div class="wa-ctx-info" style="margin-top:0.2rem;">
                        Solo para este contacto. Dejalo en "el de la línea" para que suene como el resto.
                    </div>

                    @if (!string.IsNullOrEmpty(SelectedConv()?.AsignadoOperador))
                    {
                        <div class="wa-ctx-info">
                            Ahora la tiene <b>@SelectedConv()?.AsignadoOperador</b>@if (!string.IsNullOrEmpty(SelectedConv()?.AsignadoPor) && !string.Equals(SelectedConv()?.AsignadoPor, SelectedConv()?.AsignadoOperador, StringComparison.OrdinalIgnoreCase)) { <text> · se la pasó @SelectedConv()?.AsignadoPor</text> }@if (!string.IsNullOrEmpty(SelectedConv()?.AsignadoNota)) { <text> — “@SelectedConv()?.AsignadoNota”</text> }
                        </div>
                    }
                </div>

                <div class="wa-ctx-sec">
                    <button class="wa-ctx-btn" @onclick="@(() => showConfig = true)" title="Configurar respuestas rápidas y contactos">
                        ⚙️ Respuestas rápidas y contactos
                    </button>
                </div>

                @* Borrar va ABAJO DE TODO y separado del Guardar, para no tocarlo sin querer. *@
                <div class="wa-ctx-sec wa-ctx-sec-peligro">
                    <button class="wa-ctx-btn wa-ctx-btn-borrar" @onclick="BorrarConversacion" disabled="@borrandoConv"
                            title="Borrar esta conversación del sistema (el celular del cliente no se toca)">
                        @(borrandoConv ? "⏳ Borrando…" : "🗑 Borrar conversación")
                    </button>
                </div>
            </aside>
        }

        @* Tira de iconos del borde: siempre visible, así el panel nunca "desaparece". *@
        <div class="wa-ctx-rail">
            <button class="wa-ctx-rail-btn wa-ctx-rail-toggle" @onclick="ToggleCtx"
                    title="@(ctxAbierto ? "Cerrar el panel (el chat se lleva todo el ancho)" : "Abrir el panel de contacto y conversación")">
                @(ctxAbierto ? "›" : "‹")
            </button>
            <button class="wa-ctx-rail-btn" @onclick="AbrirCtx" title="Contacto: vincular cliente, editar contacto, crear venta">👤</button>
            <button class="wa-ctx-rail-btn" @onclick="AbrirCtx" title="Conversación: estado, pasar a, nota">💬</button>
            @if (SelectedConv()?.ClienteId is int)
            {
                <button class="wa-ctx-rail-btn @(mostrarFichaCliente ? "on" : "")" @onclick="ToggleFichaCliente" title="Ficha del cliente: saldo, últimas facturas y ubicación">🛍️</button>
            }
        </div>
    }
</div> @* fin .wa-thread-wrap *@
</div>
</div>
</div> @* fin .wa-fs — pantalla completa *@

@* 2026-08-03: ventana FLOTANTE (se puede mover) con el texto completo del pedido antes de crear la venta.
   No lleva fondo oscuro a propósito: querés seguir viendo el chat mientras la movés y comparás. *@
@if (showPedidoFloat)
{
    <div class="wa-float" id="wa-pedido-float">
        <div class="wa-float-head" id="wa-pedido-float-head">
            <span style="flex:1;">📋 Revisá el pedido (podés mover esta ventana y editar el texto)</span>
            <button class="btn btn-sm btn-outline-secondary" @onclick="@(() => showPedidoFloat = false)" title="Cerrar">×</button>
        </div>
        <div class="wa-float-body">
            <label style="font-size:0.8rem; color:#6b7280; font-weight:600;">Texto que va a "Comentario para armado":</label>
            <textarea class="form-control" @bind="pedidoFloatTexto" rows="10"
                      style="font-size:0.95rem; line-height:1.35; resize:vertical;"
                      placeholder="El texto del pedido…"></textarea>
        </div>
        <div class="wa-float-foot">
            <button class="btn btn-outline-secondary btn-sm" @onclick="@(() => showPedidoFloat = false)">Cancelar</button>
            <button class="btn btn-success btn-sm" @onclick="ConfirmarPedidoFloat" disabled="@creandoPedidoFloat">
                @(creandoPedidoFloat ? "⏳ Creando…" : "✅ Crear venta")
            </button>
        </div>
    </div>
}

@if (showQuickContact)
{
    <div class="wa-modal-backdrop" @onclick="@(() => showQuickContact = false)"></div>
    <div class="wa-modal" style="max-width:520px;">
        <div class="wa-modal-header">
            <h3 style="margin:0; flex:1; font-size:1.05rem;">@(quickContactEditId is null ? "➕ Asignar contacto" : "✏️ Editar contacto")</h3>
            <button class="btn btn-sm btn-outline-secondary" @onclick="@(() => showQuickContact = false)">×</button>
        </div>
        <div class="wa-modal-body">
            <div style="margin-bottom:0.7rem;">
                <label style="font-size:0.78rem; color:#6b7280; display:block;">Número (WhatsApp)</label>
                <input class="form-control form-control-sm" value="@quickContactNumero" readonly style="background:#f9fafb;" />
            </div>
            <div style="margin-bottom:0.7rem;">
                <label style="font-size:0.78rem; color:#6b7280; display:block;">Nombre <span style="color:#dc2626;">*</span></label>
                <input class="form-control form-control-sm" @bind="quickContactNombre" placeholder="Ej. Juan Pérez" />
            </div>
            <div style="margin-bottom:0.7rem;">
                <label style="font-size:0.78rem; color:#6b7280; display:block;">Rol</label>
                <select class="form-control form-control-sm" @bind="quickContactRol">
                    <option value="hermano">👨‍👦 Hermano</option>
                    <option value="empleado">👷 Empleado</option>
                    <option value="cliente">🛍️ Cliente</option>
                    <option value="proveedor">🚚 Proveedor</option>
                    <option value="alquiler">🎪 Alquiler</option>
                    <option value="cafe">☕ Café</option>
                    <option value="otro">Otro</option>
                </select>
            </div>
            <div style="margin-bottom:0.7rem; position:relative;">
                <label style="font-size:0.78rem; color:#6b7280; display:block;">Cliente del sistema <span style="font-size:0.7rem; color:#9ca3af;">(opcional)</span></label>
                @if (quickContactClienteId.HasValue)
                {
                    <div style="display:flex; align-items:center; gap:0.4rem; padding:0.3rem 0.5rem; background:#ecfdf5; border:1px solid #a7f3d0; border-radius:6px; font-size:0.85rem;">
                        <span>🛍️ @quickContactClienteNombre</span>
                        <button class="btn btn-sm btn-link" style="padding:0; margin-left:auto; font-size:0.85rem;" @onclick="@(() => { quickContactClienteId = null; quickContactClienteNombre = null; })">×</button>
                    </div>
                }
                else
                {
                    <input class="form-control form-control-sm" placeholder="Escribí nombre, teléfono, CUIT, dirección…" @bind="quickContactClienteQuery" @bind:event="oninput" @onkeyup="BuscarClientesQuick" @onfocus="BuscarClientesQuick" autocomplete="off" />
                    @if (clienteBuscandoQuick)
                    {
                        <div style="padding:0.35rem 0.2rem; color:#9ca3af; font-size:0.8rem;">Buscando…</div>
                    }
                    else if (!string.IsNullOrWhiteSpace(quickContactClienteQuery) && clienteResultadosQuick.Count == 0)
                    {
                        <div style="padding:0.35rem 0.2rem; color:#9ca3af; font-size:0.8rem;">Sin resultados. Probá con otro dato.</div>
                    }
                    @if (clienteResultadosQuick.Count > 0)
                    {
                        <div class="wa-cliente-dropdown" style="position:absolute; top:100%; left:0; right:0; max-height:240px; overflow-y:auto; z-index:20;">
                            @foreach (var cli in clienteResultadosQuick.Take(12))
                            {
                                <div class="wa-cliente-opt" @onclick="() => SeleccionarClienteQuick(cli)">
                                    <strong>@cli.Nombre</strong>
                                    @if (!string.IsNullOrEmpty(cli.CodigoInterno)) { <span style="color:#6b7280; font-size:0.7rem;"> · #@cli.CodigoInterno</span> }
                                    @if (!string.IsNullOrEmpty(cli.Telefono)) { <span style="color:#9ca3af; font-size:0.7rem;"> · 📞 @cli.Telefono</span> }
                                    @if (!string.IsNullOrEmpty(cli.Localidad)) { <div style="color:#9ca3af; font-size:0.7rem;">📍 @cli.Localidad</div> }
                                </div>
                            }
                        </div>
                    }
                }
            </div>
            <div style="margin-bottom:0.7rem;">
                <label style="font-size:0.78rem; color:#6b7280; display:block;">Notas <span style="font-size:0.7rem; color:#9ca3af;">(opcional)</span></label>
                <input class="form-control form-control-sm" @bind="quickContactNotas" placeholder="Ej. Hermano mayor, vive en San Isidro" />
            </div>
            <div style="display:flex; gap:0.5rem; justify-content:flex-end; margin-top:1rem;">
                <button class="btn btn-secondary btn-sm" @onclick="@(() => showQuickContact = false)">Cancelar</button>
                <button class="btn btn-success btn-sm" @onclick="GuardarQuickContact">@(quickContactEditId is null ? "✓ Guardar contacto" : "✓ Guardar cambios")</button>
            </div>
        </div>
    </div>
}

@* 2026-08-04: CORREGIR NÚMERO de un chat (ej quedó mal cargado con 549 pegado a un extranjero) *@
@if (showCorregirNum)
{
    <div class="wa-modal-backdrop" @onclick="@(() => showCorregirNum = false)"></div>
    <div class="wa-modal" style="max-width:460px;">
        <div class="wa-modal-header">
            <h3 style="margin:0; flex:1; font-size:1.05rem;">✏️ Corregir número</h3>
            <button class="btn btn-sm btn-outline-secondary" @onclick="@(() => showCorregirNum = false)">×</button>
        </div>
        <div class="wa-modal-body">
            <p style="font-size:0.82rem; color:#6b7280; margin:0 0 0.7rem;">
                Escribí el número correcto <strong>con el "+" y el código de país</strong> (ej. España: <code>+34 642265173</code>, Argentina: <code>+54 9 11 2252-5458</code>).
                Se mueven todos los mensajes de este chat al número correcto. El celular del cliente no se toca.
            </p>
            <div style="margin-bottom:0.5rem;">
                <label style="font-size:0.78rem; color:#6b7280; display:block;">Número actual (mal)</label>
                <input class="form-control form-control-sm" value="@PrettyNumero(selectedNumero)" readonly style="background:#f9fafb;" />
            </div>
            <div style="margin-bottom:0.7rem;">
                <label style="font-size:0.78rem; color:#6b7280; display:block;">Número correcto <span style="color:#dc2626;">*</span></label>
                <input class="form-control form-control-sm" @bind="corregirNumValor" placeholder="+34 642265173" />
            </div>
            <div style="display:flex; gap:0.5rem; justify-content:flex-end; margin-top:1rem;">
                <button class="btn btn-secondary btn-sm" @onclick="@(() => showCorregirNum = false)">Cancelar</button>
                <button class="btn btn-success btn-sm" @onclick="GuardarCorregirNumero" disabled="@corregirNumGuardando">
                    @(corregirNumGuardando ? "⏳ Guardando..." : "✓ Corregir")
                </button>
            </div>
        </div>
    </div>
}

@* 2026-08-03: VINCULAR CLIENTE (idea "asociar fácil") — un solo buscador, sin pedir nombre ni rol *@
@if (showVincular)
{
    <div class="wa-modal-backdrop" @onclick="@(() => showVincular = false)"></div>
    <div class="wa-modal" style="max-width:460px;" @onclick:stopPropagation="true">
        <div class="wa-modal-header">
            <h3 style="margin:0; flex:1; font-size:1.05rem;">🔗 Vincular cliente</h3>
            <button class="btn btn-sm btn-outline-secondary" @onclick="@(() => showVincular = false)">×</button>
        </div>
        <div class="wa-modal-body">
            <p style="font-size:0.82rem; color:#6b7280; margin:0 0 0.6rem;">
                Buscá el cliente por <b>nombre</b>, <b>código</b>, <b>teléfono</b>, <b>CUIT/DNI</b>, <b>dirección</b>, <b>localidad</b> o <b>email</b> y tocalo. Listo, queda asociado a este chat.
            </p>
            <input class="form-control" placeholder="Buscar por nombre, teléfono, CUIT, dirección…" @bind="vincularQuery" @bind:event="oninput" @onkeyup="BuscarClientesVincular" autofocus />
            @if (vincularBuscando)
            {
                <div style="padding:0.5rem; color:#9ca3af; font-size:0.85rem;">Buscando…</div>
            }
            else if (!string.IsNullOrWhiteSpace(vincularQuery) && vincularResultados.Count == 0)
            {
                <div style="padding:0.5rem; color:#9ca3af; font-size:0.85rem;">Sin resultados. Probá con otro dato.</div>
            }
            <div style="margin-top:0.4rem; max-height:220px; overflow-y:auto;">
                @foreach (var cli in vincularResultados.Take(12))
                {
                    <button class="wa-vincular-opt" @onclick="() => VincularAhora(cli)" disabled="@vinculando">
                        <div>
                            🛍️ <b>@cli.Nombre</b>
                            @if (!string.IsNullOrEmpty(cli.CodigoInterno)) { <span style="color:#6b7280; font-size:0.75rem;"> · #@cli.CodigoInterno</span> }
                            @if (!string.IsNullOrEmpty(cli.Telefono)) { <span style="color:#9ca3af; font-size:0.72rem;"> · 📞 @cli.Telefono</span> }
                        </div>
                        @if (!string.IsNullOrEmpty(cli.Direccion) || !string.IsNullOrEmpty(cli.Localidad))
                        {
                            <div style="color:#9ca3af; font-size:0.72rem; margin-top:0.1rem;">📍 @($"{cli.Direccion} {cli.Localidad}".Trim())</div>
                        }
                    </button>
                }
            </div>

            @* 2026-08-03 (idea 3): crear un cliente nuevo con este número, sin salir del chat *@
            <div class="wa-vincular-nuevo">
                <div style="font-size:0.78rem; color:#6b7280; margin-bottom:0.35rem;">
                    ¿No está en la lista? Creá un cliente nuevo
                    @if (!selectedNumero.StartsWith("ig:")) { <span>con el número <b>@PrettyNumero(selectedNumero)</b></span> }:
                </div>
                <div style="display:flex; gap:0.4rem;">
                    <input class="form-control form-control-sm" placeholder="Nombre del cliente nuevo" @bind="nuevoCliNombre" @bind:event="oninput" style="flex:1;" />
                    <button class="btn btn-sm btn-success" @onclick="CrearYVincular" disabled="@(creandoCli || vinculando)" style="white-space:nowrap; font-weight:600;">
                        @(creandoCli ? "⏳ Creando…" : "➕ Crear y vincular")
                    </button>
                </div>
            </div>
        </div>
    </div>
}

@* 2026-08-01: ponerle nombre + imagen a una línea (WhatsApp o Instagram) *@
@if (showEditLinea)
{
    <div class="wa-modal-backdrop" @onclick="@(() => showEditLinea = false)"></div>
    <div class="wa-modal" style="max-width:420px;">
        <div class="wa-modal-header">
            <h3 style="margin:0; flex:1; font-size:1.05rem;">🏷️ Nombre e imagen de la línea</h3>
            <button class="btn btn-sm btn-outline-secondary" @onclick="@(() => showEditLinea = false)">×</button>
        </div>
        <div class="wa-modal-body">
            <div style="font-size:0.78rem; color:#6b7280; margin-bottom:0.7rem;">Línea real: <b>@(editLineaNumero ?? editLineaId)</b></div>
            <div style="display:flex; align-items:center; gap:0.9rem; margin-bottom:0.9rem;">
                <div class="wa-linea-av-big">
                    @if (!string.IsNullOrEmpty(editLineaImg)) { <img src="@editLineaImg" alt="" /> } else { <span>📱</span> }
                </div>
                <div style="font-size:0.82rem;">
                    <InputFile OnChange="OnEditLineaImg" accept="image/*" />
                    @if (!string.IsNullOrEmpty(editLineaImg))
                    {
                        <div><button class="btn btn-sm btn-link" style="padding:0; font-size:0.8rem; color:#b91c1c;" @onclick="@(() => editLineaImg = null)">Quitar imagen</button></div>
                    }
                </div>
            </div>
            <label style="font-size:0.78rem; color:#6b7280; display:block;">Nombre</label>
            <input class="form-control form-control-sm" @bind="editLineaNombre" placeholder="Ej: Ventas Café" maxlength="120" />

            <label style="font-size:0.78rem; color:#6b7280; display:block; margin-top:0.7rem;">🔔 Sonido de aviso de esta línea</label>
            <div style="display:flex; gap:0.4rem; align-items:center;">
                <select class="form-control form-control-sm" @bind="editLineaSonido">
                    @foreach (var s in SonidosDisponibles) { <option value="@s.Key">@s.Label</option> }
                    @* 2026-08-19: abajo de los seis del sistema, los que subió el usuario *@
                    @if (sonidosSubidos.Count > 0)
                    {
                        <optgroup label="Sonidos que subiste">
                            @foreach (var s in sonidosSubidos) { <option value="@s.Clave">🎵 @s.Nombre</option> }
                        </optgroup>
                    }
                </select>
                <button class="btn btn-outline-secondary btn-sm" title="Escuchar este sonido" @onclick="@(() => ProbarSonido(editLineaSonido))">▶</button>
                @if (SonidoSubidoElegido() is ApiClient.TwSonidoDto _sel)
                {
                    <button class="btn btn-outline-danger btn-sm" title="Borrar este sonido del sistema"
                            disabled="@subiendoSonido" @onclick="@(() => BorrarSonidoSubido(_sel))">🗑</button>
                }
            </div>
            <div style="font-size:0.7rem; color:#9ca3af; margin-top:0.2rem;">Cuando te escriban a esta línea, va a sonar así. Probalo con ▶.</div>

            @* 2026-08-19: subir un sonido propio (mp3/wav corto). Queda en el servidor: lo sube uno y lo usan todos. *@
            <div style="margin-top:0.6rem; padding:0.5rem 0.6rem; background:#f8fafc; border:1px solid #e6eaf0; border-radius:8px;">
                <div style="font-size:0.78rem; font-weight:700; color:#334155; margin-bottom:0.35rem;">➕ Subir un sonido mío</div>
                <input class="form-control form-control-sm" @bind="nuevoSonidoNombre" maxlength="80"
                       placeholder="Nombre, ej: Campana iglesia (si lo dejás vacío usa el del archivo)" style="margin-bottom:0.35rem;" />
                <InputFile OnChange="OnSubirSonido" accept="audio/*" disabled="@subiendoSonido" />
                <div style="font-size:0.7rem; color:#9ca3af; margin-top:0.3rem;">
                    @if (subiendoSonido) { <span>Subiendo…</span> }
                    else { <span>Un mp3 o wav cortito, de menos de 300 KB. Queda disponible para todo el equipo.</span> }
                </div>
            </div>

            <div style="display:flex; gap:0.5rem; justify-content:flex-end; margin-top:1.1rem;">
                <button class="btn btn-secondary btn-sm" @onclick="@(() => showEditLinea = false)">Cancelar</button>
                <button class="btn btn-success btn-sm" disabled="@editLineaGuardando" @onclick="GuardarEditLinea">@(editLineaGuardando ? "Guardando…" : "✓ Guardar")</button>
            </div>
        </div>
    </div>
}

@* 2026-08-15: cómo se ve el WhatsApp — color por línea (claro/oscuro) + letra de la pantalla *@
@if (showApariencia)
{
    <div class="wa-modal-backdrop" @onclick="@(() => showApariencia = false)"></div>
    <div class="wa-modal" style="max-width:560px;">
        <div class="wa-modal-header">
            <h3 style="margin:0; flex:1; font-size:1.05rem;">🎨 Colores y letra del WhatsApp</h3>
            <button class="btn btn-sm btn-outline-secondary" @onclick="@(() => showApariencia = false)">×</button>
        </div>
        <div class="wa-modal-body">
            <div style="font-size:0.82rem; color:#6b7280; margin-bottom:0.9rem; line-height:1.45;">
                Los cambios se ven al toque y quedan guardados para todos: en la computadora, en el celular y en el chat flotante.
                Solo se pinta el WhatsApp — el menú y la barra de arriba quedan como están.
            </div>

            <div style="font-weight:700; font-size:0.9rem; margin-bottom:0.15rem;">🌗 Color de cada línea</div>
            <div style="font-size:0.76rem; color:#6b7280; margin-bottom:0.6rem;">
                Poné una línea en oscuro y así, de un vistazo, sabés desde qué número estás escribiendo.
            </div>
            @foreach (var l in LineasDetectadas())
            {
                var esOscura = Apariencia.EsOscura(l.Id);
                <div style="display:flex; align-items:center; gap:0.6rem; padding:0.5rem 0; border-bottom:1px solid #f3f4f6;">
                    @if (LineaImg(l.Id) is string _limg) { <img src="@_limg" class="wa-linea-av" alt="" /> } else { <span>📱</span> }
                    <span style="flex:1; min-width:0; font-size:0.88rem; font-weight:600; overflow:hidden; text-overflow:ellipsis; white-space:nowrap;">@LineaNombre(l.Id, l.Numero)</span>
                    <button class="btn btn-sm @(esOscura ? "btn-outline-secondary" : "btn-success")" disabled="@aparienciaGuardando"
                            @onclick="@(() => CambiarTemaLinea(l.Id, "claro"))">☀️ Claro</button>
                    <button class="btn btn-sm @(esOscura ? "btn-dark" : "btn-outline-secondary")" disabled="@aparienciaGuardando"
                            @onclick="@(() => CambiarTemaLinea(l.Id, "oscuro"))">🌙 Oscuro</button>
                </div>
            }
            @if (LineasDetectadas().Count == 0)
            {
                <div style="font-size:0.85rem; color:#9ca3af;">Todavía no hay líneas conectadas.</div>
            }

            <div style="font-weight:700; font-size:0.9rem; margin:1.2rem 0 0.15rem;">🔤 Letra</div>
            <div style="font-size:0.76rem; color:#6b7280; margin-bottom:0.6rem;">
                Es una sola para todo el WhatsApp. Probá las que quieras: se cambia al instante y podés volver cuando quieras.
            </div>
            <div style="display:flex; flex-direction:column; gap:0.4rem;">
                @foreach (var f in Web.Services.WaAparienciaService.FuentesDisponibles)
                {
                    <button class="wa-vincular-opt" disabled="@aparienciaGuardando"
                            style="@(aparienciaFuente == f.Key ? "border-color:#16a34a; background:#ecfdf5;" : "")"
                            @onclick="@(() => CambiarFuente(f.Key))">
                        <span class="wa-font-@f.Key" style="font-weight:700;">@f.Label</span>
                        @if (aparienciaFuente == f.Key) { <span style="color:#16a34a; font-weight:800; float:right;">✓</span> }
                        <span class="wa-font-@f.Key" style="display:block; font-size:0.85rem; color:#6b7280; margin-top:0.15rem;">@f.Ejemplo</span>
                    </button>
                }
            </div>

            <div style="display:flex; justify-content:flex-end; margin-top:1.1rem;">
                <button class="btn btn-secondary btn-sm" @onclick="@(() => showApariencia = false)">Cerrar</button>
            </div>
        </div>
    </div>
}

@if (showConfig)
{
    <div class="wa-modal-backdrop" @onclick="@(() => showConfig = false)"></div>
    <div class="wa-modal">
        <div class="wa-modal-header">
            <h3 style="margin:0; flex:1;">⚙️ Configuración WhatsApp</h3>
            <button class="btn btn-sm btn-outline-secondary" @onclick="@(() => showConfig = false)">×</button>
        </div>
        <div class="wa-modal-tabs">
            <button class="wa-tab @(configTab=="resp" ? "active" : "")" @onclick="@(() => configTab="resp")">💬 Respuestas rápidas (@respuestas.Count)</button>
            <button class="wa-tab @(configTab=="cbu" ? "active" : "")" @onclick="@(() => configTab="cbu")">🏦 Datos bancarios / CBUs (@datosBancarios.Count)</button>
            <button class="wa-tab @(configTab=="cont" ? "active" : "")" @onclick="@(() => configTab="cont")">👥 Contactos (@contactos.Count)</button>
            <button class="wa-tab @(configTab=="bot" ? "active" : "")" @onclick="AbrirTabBot">🤖 Mensajes del bot</button>
        </div>
        <div class="wa-modal-body">
            @if (configTab == "resp")
            {
                <p style="color:#6b7280; font-size:0.85rem;">Plantillas que aparecen como botones arriba del mensaje. Click → inserta el texto en el composer.</p>
                <div style="background:#eff6ff; border:1px solid #bfdbfe; padding:0.5rem 0.75rem; border-radius:6px; font-size:0.8rem; color:#1e40af; margin-bottom:0.6rem;">
                    💡 <strong>Variables disponibles</strong>: usá <code>{nombre}</code> o <code>{numero}</code> en el texto y se reemplazan solos al insertar. Ej: <em>"Hola {nombre}! Recibimos tu pedido."</em>
                </div>
                <table class="table table-sm">
                    <thead><tr><th style="width:120px;">Nombre</th><th>Texto</th><th style="width:60px;">Orden</th><th style="width:50px;">Act.</th><th style="width:90px;"></th></tr></thead>
                    <tbody>
                        @foreach (var r in respuestas.OrderBy(x => x.Orden))
                        {
                            <tr>
                                <td><input class="form-control form-control-sm" @bind="editRespNombre[r.Id]" /></td>
                                <td><textarea class="form-control form-control-sm" rows="2" @bind="editRespTexto[r.Id]"></textarea></td>
                                <td><input type="number" class="form-control form-control-sm" @bind="editRespOrden[r.Id]" /></td>
                                <td style="text-align:center;"><input type="checkbox" @bind="editRespActivo[r.Id]" /></td>
                                <td>
                                    <button class="btn btn-sm btn-success" @onclick="() => GuardarResp(r)" title="Guardar">✓</button>
                                    <button class="btn btn-sm btn-outline-danger" @onclick="() => BorrarResp(r)" title="Borrar">×</button>
                                </td>
                            </tr>
                        }
                        <tr style="background:#f0fdf4;">
                            <td><input class="form-control form-control-sm" placeholder="Nombre" @bind="nuevaRespNombre" /></td>
                            <td><textarea class="form-control form-control-sm" rows="2" placeholder="Texto del mensaje" @bind="nuevaRespTexto"></textarea></td>
                            <td><input type="number" class="form-control form-control-sm" @bind="nuevaRespOrden" /></td>
                            <td></td>
                            <td><button class="btn btn-sm btn-success" @onclick="AgregarResp">+ Agregar</button></td>
                        </tr>
                    </tbody>
                </table>
            }
            else if (configTab == "cbu")
            {
                <p style="color:#6b7280; font-size:0.85rem;">Cargá acá tus cuentas bancarias. Después, con el botón 🏦 del chat, se las pasás al cliente en un toque (CBU completo o solo el alias).</p>
                <div style="background:#eff6ff; border:1px solid #bfdbfe; padding:0.5rem 0.75rem; border-radius:6px; font-size:0.8rem; color:#1e40af; margin-bottom:0.6rem;">
                    💡 El <strong>Nombre</strong> es una etiqueta interna para vos (ej. "Galicia PALANICA"). Los demás datos son los que ve el cliente. Los campos que dejes vacíos no se muestran.
                </div>
                <table class="table table-sm">
                    <thead><tr>
                        <th style="width:130px;">Nombre</th><th>Banco</th><th>Tipo cuenta</th><th>Titular</th>
                        <th>CUIT</th><th>CBU</th><th>Alias</th><th>Mail comprob.</th>
                        <th style="width:50px;">Orden</th><th style="width:40px;">Act.</th><th style="width:80px;"></th>
                    </tr></thead>
                    <tbody>
                        @foreach (var cb in datosBancarios.OrderBy(x => x.Orden))
                        {
                            <tr>
                                <td><input class="form-control form-control-sm" @bind="editCbuNombre[cb.Id]" /></td>
                                <td><input class="form-control form-control-sm" @bind="editCbuBanco[cb.Id]" /></td>
                                <td><input class="form-control form-control-sm" @bind="editCbuTipo[cb.Id]" /></td>
                                <td><input class="form-control form-control-sm" @bind="editCbuTitular[cb.Id]" /></td>
                                <td><input class="form-control form-control-sm" @bind="editCbuCuit[cb.Id]" /></td>
                                <td><input class="form-control form-control-sm" @bind="editCbuCbu[cb.Id]" /></td>
                                <td><input class="form-control form-control-sm" @bind="editCbuAlias[cb.Id]" /></td>
                                <td><input class="form-control form-control-sm" @bind="editCbuMail[cb.Id]" /></td>
                                <td><input type="number" class="form-control form-control-sm" @bind="editCbuOrden[cb.Id]" /></td>
                                <td style="text-align:center;"><input type="checkbox" @bind="editCbuActivo[cb.Id]" /></td>
                                <td>
                                    <button class="btn btn-sm btn-success" @onclick="() => GuardarCbu(cb)" title="Guardar">✓</button>
                                    <button class="btn btn-sm btn-outline-danger" @onclick="() => BorrarCbu(cb)" title="Borrar">×</button>
                                </td>
                            </tr>
                        }
                        <tr style="background:#f0fdf4;">
                            <td><input class="form-control form-control-sm" placeholder="Etiqueta" @bind="nuevoCbuNombre" /></td>
                            <td><input class="form-control form-control-sm" placeholder="Banco Galicia" @bind="nuevoCbuBanco" /></td>
                            <td><input class="form-control form-control-sm" placeholder="cuenta corriente" @bind="nuevoCbuTipo" /></td>
                            <td><input class="form-control form-control-sm" placeholder="Titular" @bind="nuevoCbuTitular" /></td>
                            <td><input class="form-control form-control-sm" placeholder="30-..." @bind="nuevoCbuCuit" /></td>
                            <td><input class="form-control form-control-sm" placeholder="0070..." @bind="nuevoCbuCbu" /></td>
                            <td><input class="form-control form-control-sm" placeholder="alias" @bind="nuevoCbuAlias" /></td>
                            <td><input class="form-control form-control-sm" placeholder="mail" @bind="nuevoCbuMail" /></td>
                            <td><input type="number" class="form-control form-control-sm" @bind="nuevoCbuOrden" /></td>
                            <td></td>
                            <td><button class="btn btn-sm btn-success" @onclick="AgregarCbu">+ Agregar</button></td>
                        </tr>
                    </tbody>
                </table>
                @if (datosBancarios.Any())
                {
                    <div style="background:#f9fafb; border:1px solid #e5e7eb; padding:0.6rem 0.8rem; border-radius:6px; margin-top:0.6rem;">
                        <div style="font-size:0.75rem; color:#6b7280; margin-bottom:0.3rem;">Vista previa de cómo le llega al cliente:</div>
                        <pre style="white-space:pre-wrap; font-family:inherit; font-size:0.85rem; margin:0; color:#111827;">@FormatearCbu(datosBancarios.OrderBy(x => x.Orden).First(), false)</pre>
                    </div>
                }
            }
            else if (configTab == "cont")
            {
                <p style="color:#6b7280; font-size:0.85rem;">Asignale un nombre y un rol a los números que te escriben. El nombre que pongas acá prevalece sobre el de WhatsApp.</p>
                @* 2026-07-23: con la importación masiva de clientes son miles — sin buscador era inusable *@
                <input class="form-control" style="margin-bottom:0.6rem; max-width:420px;"
                       placeholder="🔍 Buscar por nombre o número… (mínimo 2 letras)"
                       value="@contactosBusqueda" @oninput="@(e => contactosBusqueda = e.Value?.ToString() ?? "")" />
                @if (ContactosFiltrados().Count > 200)
                {
                    <p style="color:#9ca3af; font-size:0.8rem;">Mostrando los primeros 200 de @ContactosFiltrados().Count — afiná la búsqueda para encontrar el que querés.</p>
                }
                <table class="table table-sm">
                    <thead><tr><th style="width:160px;">Número</th><th>Nombre</th><th style="width:110px;">Rol</th><th style="width:200px;">Cliente vinculado</th><th>Notas</th><th style="width:40px;">Act.</th><th style="width:80px;"></th></tr></thead>
                    <tbody>
                        @foreach (var c in ContactosFiltrados().Take(200))
                        {
                            <tr>
                                <td style="font-family:monospace; font-size:0.78rem;">@c.Numero.Replace("whatsapp:", "")</td>
                                <td><input class="form-control form-control-sm" @bind="editContNombre[c.Id]" /></td>
                                <td>
                                    <select class="form-control form-control-sm" @bind="editContRol[c.Id]">
                                        <option value="hermano">Hermano</option>
                                        <option value="empleado">Empleado</option>
                                        <option value="cliente">Cliente</option>
                                        <option value="proveedor">Proveedor</option>
                                        <option value="alquiler">Alquiler</option>
                                        <option value="cafe">Café</option>
                                        <option value="otro">Otro</option>
                                    </select>
                                </td>
                                <td>
                                    @if (editContClienteId.GetValueOrDefault(c.Id) is int cliId && cliId > 0)
                                    {
                                        <div style="display:flex; align-items:center; gap:0.3rem;">
                                            <span style="font-size:0.78rem; color:#16a34a;">🛍️ @editContClienteNombre.GetValueOrDefault(c.Id, "Cliente #" + cliId)</span>
                                            <button class="btn btn-sm btn-link" style="padding:0; font-size:0.7rem;" @onclick="() => { editContClienteId[c.Id] = null; editContClienteNombre[c.Id] = null; }">×</button>
                                        </div>
                                    }
                                    else
                                    {
                                        <input class="form-control form-control-sm" placeholder="Buscar cliente..." @bind="editContClienteQuery[c.Id]" @bind:event="oninput"
                                               @onfocus="() => BuscarClientes(c.Id)" />
                                        @if (clienteBusquedaActivaId == c.Id && clienteResultados.Count > 0)
                                        {
                                            <div class="wa-cliente-dropdown">
                                                @foreach (var cli in clienteResultados.Take(8))
                                                {
                                                    <div class="wa-cliente-opt" @onclick="() => SeleccionarCliente(c.Id, cli)">
                                                        <strong>@cli.Nombre</strong>
                                                        @if (!string.IsNullOrEmpty(cli.CodigoInterno)) { <span style="color:#6b7280; font-size:0.7rem;"> · #@cli.CodigoInterno</span> }
                                                    </div>
                                                }
                                            </div>
                                        }
                                    }
                                </td>
                                <td><input class="form-control form-control-sm" @bind="editContNotas[c.Id]" /></td>
                                <td style="text-align:center;"><input type="checkbox" @bind="editContActivo[c.Id]" /></td>
                                <td>
                                    <button class="btn btn-sm btn-success" @onclick="() => GuardarCont(c)">✓</button>
                                    <button class="btn btn-sm btn-outline-danger" @onclick="() => BorrarCont(c)">×</button>
                                </td>
                            </tr>
                        }
                        <tr style="background:#f0fdf4;">
                            <td><input class="form-control form-control-sm" placeholder="+5491111111111" @bind="nuevoContNumero" /></td>
                            <td><input class="form-control form-control-sm" placeholder="Nombre" @bind="nuevoContNombre" /></td>
                            <td>
                                <select class="form-control form-control-sm" @bind="nuevoContRol">
                                    <option value="hermano">Hermano</option>
                                    <option value="empleado">Empleado</option>
                                    <option value="cliente">Cliente</option>
                                    <option value="proveedor">Proveedor</option>
                                    <option value="alquiler">Alquiler</option>
                                    <option value="cafe">Café</option>
                                    <option value="otro">Otro</option>
                                </select>
                            </td>
                            <td style="font-size:0.75rem; color:#9ca3af;">(asignás después del alta)</td>
                            <td><input class="form-control form-control-sm" placeholder="Notas" @bind="nuevoContNotas" /></td>
                            <td></td>
                            <td><button class="btn btn-sm btn-success" @onclick="AgregarCont">+ Agregar</button></td>
                        </tr>
                    </tbody>
                </table>
                <p style="color:#9ca3af; font-size:0.75rem;">💡 Tip: anteponé "whatsapp:" si querés, sino se agrega solo.</p>
            }
            else if (configTab == "bot")
            {
                <p style="color:#6b7280; font-size:0.85rem; margin-bottom:0.5rem;">
                    Estos son los mensajes automáticos que le manda el bot a un número <strong>nuevo</strong> que escribe por primera vez.
                    Editá lo que quieras y tocá <strong>Guardar</strong>. Si dejás un campo vacío, vuelve al texto original.
                </p>
                <div style="background:#eff6ff; border:1px solid #bfdbfe; padding:0.5rem 0.75rem; border-radius:6px; font-size:0.8rem; color:#1e40af; margin-bottom:0.8rem;">
                    💡 WhatsApp limita el largo de los <strong>botones</strong> y <strong>títulos de opciones</strong>. Si un texto es muy largo no te va a dejar escribir más (el máximo está indicado en cada campo).
                </div>

                @* 2026-08-06: interruptor del aviso de venta a los internos *@
                <div style="background:@(ventaAvisoOn ? "#ecfdf5" : "#f9fafb"); border:1px solid @(ventaAvisoOn ? "#6ee7b7" : "#e5e7eb"); border-radius:8px; padding:0.7rem 0.9rem; margin-bottom:1rem;">
                    <label style="display:flex; align-items:flex-start; gap:0.6rem; cursor:pointer; margin:0;">
                        <input type="checkbox" checked="@ventaAvisoOn" @onchange="e => ToggleVentaAviso((bool)e.Value!)" style="margin-top:0.2rem; width:1.1rem; height:1.1rem;" />
                        <span>
                            <span style="font-weight:600; color:#111827;">🧾 Aviso de venta con botones a los internos</span><br />
                            <span style="font-size:0.8rem; color:#6b7280;">
                                Prendido: al emitir una venta con la copia por WhatsApp tildada, al interno le llega un
                                <strong>resumen con botones</strong> (comprobante / cuenta corriente / detalle) en vez del PDF entero.
                                Apagado: le llega el <strong>PDF entero</strong> como antes. Los textos y botones del aviso los editás abajo, en
                                <em>«🧾 Aviso de venta a los internos»</em>.
                            </span>
                        </span>
                    </label>
                </div>

                @if (botCargando)
                {
                    <p style="color:#9ca3af;">Cargando…</p>
                }
                else
                {
                    @foreach (var grupo in botCampos.GroupBy(c => c.Grupo))
                    {
                        <div style="margin-bottom:1.1rem;">
                            <h4 style="margin:0 0 0.5rem; font-size:0.95rem; color:#111827; border-bottom:2px solid #25d366; padding-bottom:0.25rem;">@grupo.Key</h4>
                            @foreach (var campo in grupo)
                            {
                                <div style="margin-bottom:0.7rem;">
                                    <label style="display:block; font-size:0.82rem; font-weight:600; color:#374151; margin-bottom:0.2rem;">
                                        @campo.Etiqueta
                                        <span style="font-weight:400; color:#9ca3af; font-size:0.72rem;"> · máx @campo.Max</span>
                                        @if (!EsValorDefault(campo))
                                        {
                                            <button class="btn btn-link btn-sm" style="padding:0; font-size:0.72rem; margin-left:0.4rem;"
                                                    @onclick="() => RestaurarCampo(campo)" title="Volver al texto original">↺ restaurar original</button>
                                        }
                                    </label>
                                    @if (campo.Multilinea)
                                    {
                                        <textarea class="form-control form-control-sm" rows="2" maxlength="@campo.Max"
                                                  @bind="botValores[campo.Clave]" @bind:event="oninput"></textarea>
                                    }
                                    else
                                    {
                                        <input class="form-control form-control-sm" maxlength="@campo.Max"
                                               @bind="botValores[campo.Clave]" @bind:event="oninput" />
                                    }
                                    @if (!string.IsNullOrEmpty(campo.Ayuda))
                                    {
                                        <div style="font-size:0.72rem; color:#9ca3af; margin-top:0.15rem;">@campo.Ayuda</div>
                                    }
                                </div>
                            }
                        </div>
                    }
                    <div style="position:sticky; bottom:0; background:#fff; padding-top:0.6rem; border-top:1px solid #e5e7eb; display:flex; gap:0.5rem; align-items:center;">
                        <button class="btn btn-success" disabled="@botGuardando" @onclick="GuardarBotMensajes">
                            @(botGuardando ? "Guardando…" : "💾 Guardar cambios")
                        </button>
                        <span style="font-size:0.78rem; color:#9ca3af;">Los cambios se aplican al toque para los próximos mensajes del bot.</span>
                    </div>
                }
            }
        </div>
    </div>
}

<style>
    /* 2026-07-29: rediseño — más ancho y moderno. Sidebar + thread como dos tarjetas redondeadas
       separadas por un gap, con sombra suave (estilo del resto del sistema). */
