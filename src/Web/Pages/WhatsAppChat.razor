    /// <summary>Hace cuánto es la factura, en palabras. No tenemos fecha de vencimiento guardada,
    /// así que lo más útil que le podemos decir al operador es la antigüedad.</summary>
    static string Antiguedad(DateTime fecha)
    {
        // 2026-08-26: contra el día de ARGENTINA, no el del navegador (operando desde España,
        // de madrugada una factura de hoy se leía como "ayer").
        var dias = (int)(DateTimeExt.AhoraAr().Date - fecha.Date).TotalDays;
        if (dias <= 0) return "hoy";
        if (dias == 1) return "ayer";
        if (dias < 30) return $"hace {dias} días";
        var meses = dias / 30;
        return meses == 1 ? "hace 1 mes" : $"hace {meses} meses";
    }

    /// <summary>Le manda ESTA factura al cliente por este mismo chat, sin salir de la conversación.
    /// Sale ya (no pasa por la cola de espera: la estás mirando, ya la revisaste).</summary>
    async Task MandarFacturaPorWa(ApiClient.FichaChatVentaDto fac)
    {
        if (selectedNumero == null || enviandoFacturaId != null) return;
        if (selectedNumero.StartsWith("ig:"))
        {
            Toast.Warning("Este chat es de Instagram: el comprobante se manda por WhatsApp, no por acá.");
            return;
        }
        if (!await JS.InvokeAsync<bool>("confirm",
                $"¿Mandarle la factura {fac.Numero} al cliente por este chat?"))
            return;
        enviandoFacturaId = fac.Id;
        try
        {
            var destino = selectedNumero.Replace("whatsapp:", "");
            var (ok, err, _) = await Api.ProgramarEnvioVentaAsync(
                fac.Id, "WHATSAPP", destino, selectedLinea, automatico: false, inmediato: true);
            if (ok)
            {
                Toast.Success($"🟢 Le mandé la factura {fac.Numero}");
                await LoadMensajes(silent: true);   // que aparezca en la charla al toque
            }
            else Toast.Error($"No se pudo mandar: {err}");
        }
        catch (Exception ex) { Toast.Error($"No se pudo mandar: {ex.Message}"); }
        finally { enviandoFacturaId = null; }
    }
