    .wa-vent24-dot { width: 9px; height: 9px; border-radius: 50%; background: #ef4444; box-shadow: 0 0 0 0 rgba(239,68,68,0.5); animation: waPulse 1.6s infinite; }
    @@keyframes waPulse { 0% { box-shadow: 0 0 0 0 rgba(239,68,68,0.5); } 70% { box-shadow: 0 0 0 7px rgba(239,68,68,0); } 100% { box-shadow: 0 0 0 0 rgba(239,68,68,0); } }
    /* 2026-08-05: selector de plantilla dentro del chat (ventana cerrada) */
    .wa-plantilla-chat { margin: 0.55rem 1rem 0.8rem; padding: 0.9rem; background: #fff7ed; border: 1px solid #fed7aa; border-radius: 14px; }
