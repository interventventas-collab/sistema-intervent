    // Reemplaza {{1}}, {{2}}… con lo cargado (los vacíos quedan como {{n}} para que se vea qué falta).
    static string RenderPreview(string body, List<string> vars)
    {
        if (string.IsNullOrEmpty(body)) return "";
        return System.Text.RegularExpressions.Regex.Replace(body, @"\{\{\s*(\d+)\s*\}\}", m =>
        {
            if (int.TryParse(m.Groups[1].Value, out var idx) && idx >= 1 && idx <= vars.Count && !string.IsNullOrEmpty(vars[idx - 1]))
                return vars[idx - 1];
            return m.Value;
        });
    }

