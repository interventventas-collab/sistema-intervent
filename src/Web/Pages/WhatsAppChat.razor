@if (showAdjuntarServidor)
{
    <div class="wa-modal-backdrop" @onclick="CerrarAdjuntarServidor" style="z-index:1099;"></div>
    <div class="wa-srv-modal" @onclick:stopPropagation="true">
        <div style="display:flex; justify-content:space-between; align-items:center;">
            <h5 style="margin:0;">🗂️ Adjuntar del servidor</h5>
            <button class="btn btn-sm btn-outline-secondary" @onclick="CerrarAdjuntarServidor">×</button>
        </div>
        <div style="font-size:0.75rem; color:#6b7280; margin-top:0.25rem;">
            Enviar a <strong>@(MostrarNombre(SelectedConv()))</strong>
        </div>
        <div class="wa-srv-tabs">
            <button class="wa-srv-tab @(srvTab == "VENTA" ? "active" : "")" @onclick='() => CambiarTabServidor("VENTA")'>🧾 Facturas/Ventas</button>
            <button class="wa-srv-tab @(srvTab == "COBRANZA" ? "active" : "")" @onclick='() => CambiarTabServidor("COBRANZA")'>💰 Recibos cobranza</button>
            <button class="wa-srv-tab @(srvTab == "LISTA" ? "active" : "")" @onclick='() => CambiarTabServidor("LISTA")'>💲 Listas de precios</button>
            <button class="wa-srv-tab @(srvTab == "CATALOGO" ? "active" : "")" @onclick='() => CambiarTabServidor("CATALOGO")'>📚 Catálogos</button>
            <button class="wa-srv-tab @(srvTab == "ALQUILER" ? "active" : "")" @onclick='() => CambiarTabServidor("ALQUILER")'>🎪 Alquileres</button>
            <button class="wa-srv-tab @(srvTab == "VISITA" ? "active" : "")" @onclick='() => CambiarTabServidor("VISITA")'>📋 Recibos de visita</button>
            <button class="wa-srv-tab @(srvTab == "UPLOAD" ? "active" : "")" @onclick='() => CambiarTabServidor("UPLOAD")'>📁 Mis subidos</button>
        </div>
        @if (srvTab == "CATALOGO")
        {
            <div class="wa-srv-upload">
                <label class="wa-srv-upload-btn @(catSubiendo ? "cargando" : "")">
                    @(catSubiendo ? "⏳ Subiendo…" : "⬆️ Subir catálogo (PDF, documento o imagen)")
                    <InputFile OnChange="OnCatalogoSeleccionado" disabled="@catSubiendo"
                               accept=".pdf,.doc,.docx,.xls,.xlsx,image/*" style="display:none;" />
                </label>
                <div class="wa-srv-upload-hint">Estos archivos quedan guardados para siempre (no se borran a las 24 hs).</div>
            </div>
        }
        <input class="wa-srv-search" placeholder="@SrvSearchPlaceholder()"
               value="@srvSearch" @oninput="OnSrvSearchInput" />
        <div class="wa-srv-list">
            @if (srvLoading)
            {
                <div class="wa-srv-empty">Cargando…</div>
            }
            else if (srvResultados.Count == 0)
            {
                <div class="wa-srv-empty">@(string.IsNullOrWhiteSpace(srvSearch) ? "Sin resultados. Probá buscando." : "Sin resultados con ese filtro.")</div>
            }
            else
            {
                @foreach (var f in srvResultados)
                {
                    <div class="wa-srv-item">
                        @if (!string.IsNullOrWhiteSpace(f.PreviewUrl))
                        {
                            <img class="wa-srv-thumb" src="@f.PreviewUrl" alt="" loading="lazy" />
                        }
                        else
                        {
                            <div class="wa-srv-thumb wa-srv-thumb-icon">@(string.IsNullOrWhiteSpace(f.Icon) ? "📎" : f.Icon)</div>
                        }
                        <div class="wa-srv-item-main">
                            <div class="wa-srv-item-label">@f.Label</div>
                            @if (!string.IsNullOrWhiteSpace(f.SubLabel))
                            {
                                <div class="wa-srv-item-sub">@f.SubLabel</div>
                            }
                            @if (!string.IsNullOrWhiteSpace(f.Info))
                            {
                                <div class="wa-srv-item-info">@f.Info · @f.Fecha.ToArTime().ToString("dd/MM/yyyy")</div>
                            }
                        </div>
                        @* 2026-08-05: ahora SUMA a la bandeja de pendientes (no envía directo) *@
                        <button class="wa-srv-send-btn" @onclick="() => StagearServerFile(f)">
                            ➕ Agregar
                        </button>
                        @if (f.Tipo == "CATALOGO")
                        {
                            <button class="wa-srv-del-btn" title="Borrar catálogo" @onclick="() => BorrarCatalogo(f)">🗑️</button>
                        }
                    </div>
                }
            }
        </div>
    </div>
}

@code {
    List<ApiClient.TwConvDto> conversaciones = new();
    List<ApiClient.TwMsgDto> mensajes = new();
    string? selectedNumero;
    // 2026-08-01: la línea del chat abierto (junto con selectedNumero identifica la conversación).
    // Así el mismo contacto en 2 líneas nuestras son 2 chats distintos y no se cruzan.
    string? selectedLinea;
    string composerText = "";

    // === 2026-08-01: nota de voz (grabar con micrófono y enviar como audio nativo) ===
    bool grabandoAudio = false, enviandoAudio = false;
    class WaUploadRes { public string? Url { get; set; } public string? OriginalFilename { get; set; } }

    async Task ToggleGrabarAudio()
    {
        if (selectedNumero == null) { Toast.Warning("Elegí un chat primero"); return; }
        if (!grabandoAudio)
        {
            bool ok;
            try { ok = await JS.InvokeAsync<bool>("waAudio.start"); }
            catch { ok = false; }
            if (!ok) { Toast.Error("No pude acceder al micrófono. Revisá los permisos del navegador (y que estés en HTTPS)."); return; }
            grabandoAudio = true;
        }
        else
        {
            grabandoAudio = false;
            enviandoAudio = true;
            StateHasChanged();
            WaUploadRes? res = null;
            try { res = await JS.InvokeAsync<WaUploadRes?>("waAudio.stopAndUpload"); }
            catch { }
            if (res == null || string.IsNullOrEmpty(res.Url))
            {
                enviandoAudio = false;
                Toast.Error("No se pudo grabar o subir el audio");
                return;
            }
            var (ok, err) = await Api.SendTwMediaAsync(selectedNumero, res.Url, null, res.OriginalFilename, selectedLinea);
            enviandoAudio = false;
            if (!ok) Toast.Error(err ?? "No se pudo enviar la nota de voz");
            else await LoadMensajes();
            StateHasChanged();
        }
    }

    async Task CancelarAudio()
    {
        grabandoAudio = false;
        try { await JS.InvokeVoidAsync("waAudio.cancel"); } catch { }
    }
    bool loadingConv = true, loadingMsg = false, sending = false, uploading = false, enviandoMenuRol = false;
    System.Threading.Timer? refreshTimer;
    Microsoft.AspNetCore.Components.ElementReference messagesScroll;

    // Respuestas rapidas + contactos
    List<ApiClient.TwRespRapidaDto> respuestas = new();
    List<ApiClient.TwContactoDto> contactos = new();
    bool showConfig = false;
    bool showQuickReplies = false;   // 2026-08-05: desplegable de respuestas rápidas arriba del botón Enviar
    string configTab = "resp";
    // 2026-07-29: Datos bancarios / CBUs
    List<ApiClient.TwCbuDto> datosBancarios = new();
    bool showCbuPanel = false;
    Dictionary<int, string> editCbuNombre = new(), editCbuBanco = new(), editCbuTipo = new(), editCbuTitular = new(),
                            editCbuCuit = new(), editCbuCbu = new(), editCbuAlias = new(), editCbuMail = new();
    Dictionary<int, int> editCbuOrden = new();
    Dictionary<int, bool> editCbuActivo = new();
    string nuevoCbuNombre = "", nuevoCbuBanco = "", nuevoCbuTipo = "cuenta corriente", nuevoCbuTitular = "",
           nuevoCbuCuit = "", nuevoCbuCbu = "", nuevoCbuAlias = "", nuevoCbuMail = "";
    int nuevoCbuOrden = 99;
    // dict para edicion inline
    Dictionary<int, string> editRespNombre = new(), editRespTexto = new();
    Dictionary<int, int> editRespOrden = new();
    Dictionary<int, bool> editRespActivo = new();
    Dictionary<int, string> editContNombre = new(), editContRol = new(), editContNotas = new();
    Dictionary<int, bool> editContActivo = new();
    Dictionary<int, int?> editContClienteId = new();
    Dictionary<int, string?> editContClienteNombre = new();
    Dictionary<int, string> editContClienteQuery = new();
    int? clienteBusquedaActivaId = null;
    List<ApiClient.TwClienteBuscarDto> clienteResultados = new();
    // Reacciones
    int? pickerOpenMsgId = null;
    // 2026-07-23: ☕ y 🫘 primeros (pedido Osmar — "grano de café" no existe como emoji, esto es lo más parecido)
    static readonly string[] QuickEmojis = new[] { "☕", "🫘", "👍", "❤️", "😂", "😮", "😢", "🙏", "✅", "⏳", "❗" };
    // === Selección de mensajes + Nueva Venta en ventana popup ===
    HashSet<int> mensajesSeleccionadosIds = new();
    // 2026-08-05: modo "elegir mensajes para la venta" (se activa con el botón "Crear venta" del encabezado)
    bool modoElegirVenta = false;

    // 2026-08-03: ventana flotante de preview del pedido (se ve el texto completo, se puede mover y editar)
    bool showPedidoFloat = false;
    string pedidoFloatTexto = "";
    bool creandoPedidoFloat = false;
    bool _pedidoFloatAttachPending = false;

    /// <summary>Arma el texto del pedido: si hay mensajes tildados usa esos (en orden), y si no hay
    /// ninguno tildado cae al último mensaje que entró del cliente.</summary>
    string TextoPedidoDesdeChat()
    {
        if (mensajesSeleccionadosIds.Count > 0)
            return string.Join("\n", mensajes.Where(m => mensajesSeleccionadosIds.Contains(m.Id))
                .OrderBy(m => m.CreatedAt)
                .Where(m => !string.IsNullOrWhiteSpace(m.Cuerpo))
                .Select(m => m.Cuerpo!));
        return mensajes.LastOrDefault(m => m.Direccion == "INCOMING")?.Cuerpo ?? "";
    }

    /// <summary>Abre la ventana flotante con el texto para revisar antes de crear la venta.</summary>
    void AbrirPreviewPedido()
    {
        var texto = TextoPedidoDesdeChat();
        if (string.IsNullOrWhiteSpace(texto)) { Toast.Warning("No hay texto para el pedido. Tildá un mensaje."); return; }
        pedidoFloatTexto = texto;
        showPedidoFloat = true;
        _pedidoFloatAttachPending = true;
        StateHasChanged();
    }

    // 2026-08-05: NUEVO flujo de "Crear venta" desde el chat.
    // Paso 1: el botón del encabezado entra en modo "elegir mensajes" (aparece la barra de abajo).
    void IniciarCrearVenta()
    {
        if (selectedNumero == null) { Toast.Warning("Elegí un chat primero"); return; }
        // Si ya estaba en modo, lo apagamos (toggle).
        if (modoElegirVenta) { modoElegirVenta = false; return; }
        modoElegirVenta = true;
        mensajesSeleccionadosIds.Clear();   // empezar la selección de cero
    }

    void CancelarSeleccionVenta()
    {
        modoElegirVenta = false;
        mensajesSeleccionadosIds.Clear();
    }

    // Paso 2: abre Nueva Venta en una PESTAÑA NUEVA con el cliente (si el chat tiene uno asignado) y
    // los mensajes tildados en "Comentario para armado". NO crea ningún pedido en la cola —
    // usa el circuito ?fromTwilio=1&notas=...&clienteIdPre=... que ya existe en /cafe/ventas.
    async Task AbrirVentaDesdeChat()
    {
        var texto = TextoPedidoDesdeChat();   // mensajes tildados, o el último entrante si no tildaste ninguno
        if (string.IsNullOrWhiteSpace(texto)) { Toast.Warning("Tildá los mensajes del pedido y tocá 'Abrir venta'."); return; }
        var conv = SelectedConv();
        var url = $"/cafe/ventas?fromTwilio=1&notas={Uri.EscapeDataString(texto.Trim())}";
        if (conv?.ClienteId is int cid) url += $"&clienteIdPre={cid}";
        // pestaña nueva (no ventanita chica): el operador suele tener dos pantallas
        await JS.InvokeVoidAsync("open", url, "_blank");
        modoElegirVenta = false;
        mensajesSeleccionadosIds.Clear();
    }

    /// <summary>Confirma desde la ventana flotante: crea el pedido con el texto (ya editado si lo tocaron)
    /// y abre Nueva Venta en una ventana nueva, dejando el chat abierto.</summary>
    async Task ConfirmarPedidoFloat()
    {
        creandoPedidoFloat = true;
        var pedidoId = await CrearPedidoRealAsync(pedidoFloatTexto);
        creandoPedidoFloat = false;
        if (pedidoId is null) return;
        showPedidoFloat = false;
        mensajesSeleccionadosIds.Clear();
        var features = "width=1300,height=850,left=200,top=50,resizable=yes,scrollbars=yes,toolbar=no,menubar=no,location=no";
        await JS.InvokeVoidAsync("open", $"/cafe/ventas?pedidoId={pedidoId}", "nueva-venta-wa", features);
    }

    /// <summary>2026-07-23 (unificación): los botones del chat ya no van por un camino propio —
    /// crean un pedido REAL en la cola (la IA lo lee si está prendida) y abren Nueva Venta por el
    /// mismo circuito que todos (?pedidoId=). Devuelve el id del pedido creado, o null si falló.</summary>
    async Task<int?> CrearPedidoRealAsync(string texto)
    {
        if (string.IsNullOrWhiteSpace(texto)) { Toast.Warning("No hay texto para el pedido"); return null; }
        var conv = SelectedConv();
        Toast.Info("Creando el pedido… si la IA está prendida tarda unos segundos en leerlo.");
        var r = await Api.RecibirWhatsAppPedidoAsync(
            PrettyNumero(selectedNumero ?? ""), texto.Trim(),
            clienteId: conv?.ClienteId, source: "whatsapp_chat");
        if (r is null) { Toast.Error("No se pudo crear el pedido"); return null; }
        return r.Id;
    }

    void ToggleSeleccionMensaje(int id)
    {
        if (mensajesSeleccionadosIds.Contains(id)) mensajesSeleccionadosIds.Remove(id);
        else mensajesSeleccionadosIds.Add(id);
    }

    // Quick contact modal
    bool showQuickContact = false;
    int? quickContactEditId = null;   // 2026-08-05: si tiene valor, el panel está EDITANDO ese contacto (si es null, es alta)
    string quickContactNumero = "", quickContactNombre = "", quickContactRol = "hermano", quickContactNotas = "";
    int? quickContactClienteId = null;
