    static string? DireccionCorta(ApiClient.FichaChatDto f)
    {
        var dir = (f.Direccion ?? "").Trim();
        var loc = (f.Localidad ?? "").Trim();
        if (dir.Length == 0 && loc.Length == 0) return null;
        if (dir.Length == 0) return loc;
        if (loc.Length == 0) return dir;
        return $"{dir}, {loc}";
    }

