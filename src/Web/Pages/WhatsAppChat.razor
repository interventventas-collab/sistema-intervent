    TimeSpan? Restante24hs()
    {
        var ult = UltimoEntranteAt();
        return ult == null ? null : ult.Value.AddHours(24) - DateTime.UtcNow;
    }
    bool Ventana24Abierta() => Restante24hs() is TimeSpan t && t > TimeSpan.Zero;
    bool EsChatInstagram()
        => (selectedNumero?.StartsWith("ig:") ?? false) || SelectedConv()?.Canal == "INSTAGRAM";
    string FormatoRestante(TimeSpan t)
    {
        if (t <= TimeSpan.Zero) return "0 min";
        int h = (int)t.TotalHours, m = t.Minutes;
        if (h >= 1) return $"{h} h {m} min";
        if (m >= 1) return $"{m} min";
        return "menos de 1 min";
    }

    // Selector de plantilla DENTRO del chat (estado propio, no pisa el de "Nueva conversación")
    string chatPlantillaName = "";
    List<string> chatVariables = new();
    bool chatPlantillaEnviando = false;
    ApiClient.TwPlantillaDto? ChatPlantillaSel() => nvPlantillas.FirstOrDefault(p => p.Name == chatPlantillaName);
    void OnChatPlantillaChange(ChangeEventArgs e)
    {
        chatPlantillaName = e.Value?.ToString() ?? "";
        var count = ChatPlantillaSel()?.VariableCount ?? 0;
        chatVariables = Enumerable.Range(0, count).Select(_ => "").ToList();
    }
    void SetChatVariable(int idx, string val)
    {
        while (chatVariables.Count <= idx) chatVariables.Add("");
        chatVariables[idx] = val;
