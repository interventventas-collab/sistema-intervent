                <input class="form-control form-control-sm" @bind="corregirNumValor" placeholder="+34 642265173" />
            </div>
            <div style="display:flex; gap:0.5rem; justify-content:flex-end; margin-top:1rem;">
                <button class="btn btn-secondary btn-sm" @onclick="@(() => showCorregirNum = false)">Cancelar</button>
                <button class="btn btn-success btn-sm" @onclick="GuardarCorregirNumero" disabled="@corregirNumGuardando">
                    @(corregirNumGuardando ? "⏳ Guardando..." : "✓ Corregir")
                </button>
            </div>
        </div>
    </div>
}

@* 2026-08-03: VINCULAR CLIENTE (idea "asociar fácil") — un solo buscador, sin pedir nombre ni rol *@
@* 2026-08-24: ¿a nombre de quién va la venta? Lo usan "Abrir venta" y el Modo venta.
   Arriba el cliente del chat (un toque y listo, como siempre), abajo el buscador para mandarla
   a otro, y al final el alta rápida si todavía no existe. *@
@if (showElegirCli)
{
    <div class="wa-modal-backdrop" @onclick="@(() => showElegirCli = false)"></div>
    <div class="wa-modal" style="max-width:460px;" @onclick:stopPropagation="true">
        <div class="wa-modal-header">
            <h3 style="margin:0; flex:1; font-size:1.05rem;">@elegirCliTitulo</h3>
            <button class="btn btn-sm btn-outline-secondary" @onclick="@(() => showElegirCli = false)">×</button>
        </div>
        <div class="wa-modal-body">
            @if (elegirCliDefaultId is int _defId)
            {
                <div style="font-size:0.78rem; color:#6b7280; margin:0 0 0.35rem;">El cliente de este chat:</div>
                <button class="wa-elegircli-def" @onclick="() => ElegirClienteYSeguir(_defId, elegirCliDefaultNombre)">
                    <span class="wa-elegircli-def-nom">🛍️ @elegirCliDefaultNombre</span>
                    <span class="wa-elegircli-def-cta">Usar este →</span>
                </button>
                <div class="wa-elegircli-o">o buscá otro cliente</div>
            }
            else
            {
                <p style="font-size:0.82rem; color:#6b7280; margin:0 0 0.6rem;">
                    Este chat no está vinculado a ningún cliente. Buscá a quién le va esta venta.
                </p>
            }

            <input class="form-control" placeholder="Buscar por nombre, teléfono, CUIT, dirección…"
                   @bind="elegirCliQuery" @bind:event="oninput" @onkeyup="BuscarClientesElegir" autofocus />
            @if (elegirCliBuscando)
            {
                <div style="padding:0.5rem; color:#9ca3af; font-size:0.85rem;">Buscando…</div>
            }
            else if (!string.IsNullOrWhiteSpace(elegirCliQuery) && elegirCliResultados.Count == 0)
            {
                <div style="padding:0.5rem; color:#9ca3af; font-size:0.85rem;">Sin resultados. Probá con otro dato.</div>
            }
            <div style="margin-top:0.4rem; max-height:220px; overflow-y:auto;">
                @foreach (var cli in elegirCliResultados)
                {
                    <button class="wa-vincular-opt" @onclick="() => ElegirClienteYSeguir(cli.Id, cli.Nombre)">
                        <div>
                            🛍️ <b>@cli.Nombre</b>
                            @if (!string.IsNullOrEmpty(cli.CodigoInterno)) { <span style="color:#6b7280; font-size:0.75rem;"> · #@cli.CodigoInterno</span> }
                            @if (!string.IsNullOrEmpty(cli.Telefono)) { <span style="color:#9ca3af; font-size:0.72rem;"> · 📞 @cli.Telefono</span> }
                        </div>
                        @if (!string.IsNullOrEmpty(cli.Direccion) || !string.IsNullOrEmpty(cli.Localidad))
                        {
                            <div style="color:#9ca3af; font-size:0.72rem; margin-top:0.1rem;">📍 @($"{cli.Direccion} {cli.Localidad}".Trim())</div>
                        }
                        @* 2026-08-25: si apareció porque coincidió una dirección de ENTREGA (el cliente puede
                           tener varias), la mostramos para que se entienda por qué está en la lista. *@
                        @if (!string.IsNullOrEmpty(cli.DireccionEntrega))
                        {
                            <div style="color:#10b981; font-size:0.72rem; margin-top:0.1rem;">🚚 @cli.DireccionEntrega</div>
                        }
                    </button>
                }
            </div>

            <div class="wa-vincular-nuevo">
                <div style="font-size:0.78rem; color:#6b7280; margin-bottom:0.35rem;">¿No está en la lista? Creá uno nuevo:</div>
                <div style="display:flex; gap:0.4rem;">
                    <input class="form-control form-control-sm" placeholder="Nombre del cliente nuevo" @bind="elegirCliNuevoNombre" @bind:event="oninput" style="flex:1;" />
                    <button class="btn btn-sm btn-success" @onclick="CrearClienteYSeguir" disabled="@elegirCliCreando" style="white-space:nowrap; font-weight:600;">
                        @(elegirCliCreando ? "⏳ Creando…" : "➕ Crear y usar")
                    </button>
                </div>
            </div>
        </div>
    </div>
}

@if (showVincular)
{
    <div class="wa-modal-backdrop" @onclick="@(() => showVincular = false)"></div>
    <div class="wa-modal" style="max-width:460px;" @onclick:stopPropagation="true">
        <div class="wa-modal-header">
