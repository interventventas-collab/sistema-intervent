    .wa-fwd-chips { display: flex; flex-wrap: wrap; gap: 0.35rem; margin-bottom: 0.5rem; }
    .wa-fwd-chip { background: #dcfce7; color: #166534; border-radius: 999px; padding: 0.2rem 0.55rem; font-size: 0.8rem; display: inline-flex; align-items: center; gap: 0.3rem; }
    .wa-fwd-chip button { background: transparent; border: none; color: #166534; cursor: pointer; font-size: 0.95rem; line-height: 1; padding: 0; }
    .wa-fwd-list { overflow-y: auto; flex: 1; min-height: 60px; max-height: 40vh; margin-top: 0.4rem; border: 1px solid #f3f4f6; border-radius: 8px; }
