    }

    /// <summary>Carga en el carrito lo mismo que tenía ese comprobante, con LOS PRECIOS DE ESA
    /// FACTURA (no los de hoy) — igual que el "Duplicar comprobante" de la pantalla de ventas.</summary>
    async Task RepetirVenta(ApiClient.FichaChatVentaDto ant)
    {
        if (mvRepitiendo != null) return;
        mvRepitiendo = ant.Id;
        try
        {
            var pay = await Api.DuplicarCafeVentaAsync(ant.Id);
            if (pay is null || pay.Items.Count == 0) { Toast.Error("No pude copiar ese comprobante."); return; }
            mvTipoComprobante = pay.TipoComprobante;
            mvCondicionPago = pay.CondicionPago;
            mvCondicionIva = pay.CondicionIva;
            mvRetira = pay.Retira;
            mvObservaciones = pay.Observaciones;
            mvOrigenNumero = pay.OrigenNumero;
            mvItems = pay.Items.Select(it => new MvLinea
            {
                Req = it,
                Nombre = string.IsNullOrWhiteSpace(it.DescripcionLibre) ? $"Producto #{it.ProductoId}" : it.DescripcionLibre!,
                CantidadTxt = it.Cantidad.ToString(),
                FormatoLabel = FormatoLabelCorto(it.Formato)
            }).ToList();
            await CotizarModoVenta();   // trae los nombres de verdad y los subtotales
        }
        catch (Exception ex) { Toast.Error("No pude copiar ese comprobante: " + ex.Message); }
        finally { mvRepitiendo = null; }
    }

    /// <summary>Le pide al servidor los precios y el total. Es la MISMA cotización que usa la
    /// pantalla de ventas, así que respeta la lista de precios del cliente y avisa si falta stock.</summary>
    async Task CotizarModoVenta()
    {
        if (mvItems.Count == 0) { mvTotal = 0m; return; }
        if (mvClienteId is not int cid) return;
        mvCotizando = true;
        StateHasChanged();
        try
        {
            var req = new CafeCotizarRequest
            {
                ClienteId = cid,
                Items = mvItems.Select(l => l.Req).ToList(),
                TipoComprobante = mvTipoComprobante
            };
            var cot = await Api.CotizarCafeAsync(req);
            if (cot is null) { Toast.Error("No pude calcular los precios."); return; }
            mvTotal = cot.Total;
            for (int i = 0; i < mvItems.Count && i < cot.Items.Count; i++)
            {
                mvItems[i].Nombre = string.IsNullOrWhiteSpace(cot.Items[i].ProductoNombre)
                    ? mvItems[i].Nombre : cot.Items[i].ProductoNombre;
                mvItems[i].Subtotal = cot.Items[i].Subtotal;
                mvItems[i].FormatoLabel = FormatoLabelCorto(cot.Items[i].Formato);
                mvItems[i].Aviso = cot.Items[i].StockOk ? null : cot.Items[i].Aviso;
            }
        }
        catch (Exception ex) { Toast.Error("No pude calcular los precios: " + ex.Message); }
        finally { mvCotizando = false; StateHasChanged(); }
    }

    async Task CambiarCantidad(int idx, int delta)
    {
        if (idx < 0 || idx >= mvItems.Count) return;
        var nueva = mvItems[idx].Req.Cantidad + delta;
        if (nueva < 1) return;
        mvItems[idx].Req.Cantidad = nueva;
        mvItems[idx].CantidadTxt = nueva.ToString();
        await CotizarModoVenta();
    }

    async Task EscribirCantidad(int idx, string? txt)
    {
        if (idx < 0 || idx >= mvItems.Count) return;
        var limpio = new string((txt ?? "").Where(char.IsDigit).ToArray());
        if (!int.TryParse(limpio, out var n) || n < 1) n = 1;
        mvItems[idx].Req.Cantidad = n;
        mvItems[idx].CantidadTxt = n.ToString();
        await CotizarModoVenta();
    }

    async Task QuitarLinea(int idx)
    {
        if (idx < 0 || idx >= mvItems.Count) return;
        mvItems.RemoveAt(idx);
        // El detalle abierto se identifica por POSICIÓN: si no lo cerramos, después de borrar un
        // renglón quedaría abierto sobre otro y se editaría el producto equivocado.
        mvLineaAbierta = -1;
        if (mvItems.Count == 0) { mvTotal = 0m; mvOrigenNumero = null; StateHasChanged(); return; }
        await CotizarModoVenta();
    }

    /// <summary>Crea la venta de verdad, igual que la pantalla de ventas. OJO: si el comprobante
    /// es Factura A/B/C, el sistema le pide el CAE a ARCA al crearla — no es un borrador. Por eso
    /// antes va un cartel con el tipo, la razón social y el total.</summary>
    async Task CrearVentaModoVenta()
    {
        if (mvCreando || mvItems.Count == 0) return;
        if (mvClienteId is not int cid) { Toast.Warning("Elegí primero a quién le vendés."); return; }
        var nombreCli = mvClienteNombre ?? "este cliente";
        var esFactura = mvTipoComprobante is "FA" or "FB" or "FC";
        var aviso = esFactura
            ? $"⚠️ Se va a EMITIR {TipoLabel(mvTipoComprobante)} en ARCA (con CAE). No es un borrador.\n\n"
            : "";
        if (!await JS.InvokeAsync<bool>("confirm",
                $"{aviso}A nombre de: {nombreCli}\nTotal: {Plata(mvTotal)}\n\n¿Creo la venta?"))
            return;

        mvCreando = true;
        try
        {
            var req = new CreateCafeVentaRequest
            {
                ClienteId = cid,
                ClienteDireccionId = mvDireccionId,
                Items = mvItems.Select(l => l.Req).ToList(),
                TipoComprobante = mvTipoComprobante,
                CondicionIva = mvCondicionIva,
                CondicionPago = mvCondicionPago,
                Retira = mvRetira,
                Observaciones = mvObservaciones,
                ComentarioArmado = string.IsNullOrWhiteSpace(mvComentarioArmado) ? null : mvComentarioArmado!.Trim(),
                WeekDays = mvDias.Count > 0 ? string.Join(",", DiasOrdenados()) : null
            };
            var venta = await Api.CreateCafeVentaAsync(req);
            if (venta is null) { Toast.Error("No se pudo crear la venta."); return; }
            Toast.Success($"✅ Venta creada: {venta.Numero ?? ("#" + venta.Id)} · {Plata(mvTotal)}");
            // Queda a mano para poder mandarle el comprobante sin salir del chat.
            mvVentaCreadaId = venta.Id;
            mvVentaCreadaNumero = venta.Numero ?? ("#" + venta.Id);
            mvPaso = 3;
            LimpiarCarrito();
            await CargarAnterioresModoVenta(cid);   // que la nueva aparezca para repetir
            fichaCliente = null;                     // el saldo cambió: que la ficha se recargue
            await CargarFichaCliente();   // el saldo/los datos cambiaron: refrescar también la barra de arriba
        }
        catch (Exception ex) { Toast.Error("No se pudo crear la venta: " + ex.Message); }
        finally { mvCreando = false; }
    }

    // ===== 2026-08-20: VARIAS RAZONES SOCIALES en un mismo teléfono =====
    // Hay clientas que manejan 3 empresas (ej. ACOYTE 500 S.R.L., AVENIDA LA PLATA 502 SRL y MOLLYS)
    // y facturan a las tres desde el MISMO WhatsApp. Antes el chat mostraba una sola y la venta
    // salía siempre a esa. Ahora se ven todas arriba del chat y tildás con cuál estás trabajando.
    // El tilde es de CADA OPERADOR (lo guarda el servidor por firma del PIN): Osmar puede estar en
    // ACOYTE y Germán en AVENIDA LA PLATA en la misma charla, al mismo tiempo, sin pisarse.
    bool cambiandoRazon = false;

    List<ApiClient.TwClienteVinculadoDto> RazonesSociales => SelectedConv()?.Clientes ?? new();

    /// <summary>Solo mostramos los botoncitos si de verdad hay MÁS DE UNA. Con una sola, el chat
    /// se ve igual que siempre (cartelito 🛍️ Cliente: ...).</summary>
    bool VariasRazones => RazonesSociales.Count > 1;

    bool EsRazonActiva(int clienteId) => SelectedConv()?.ClienteId == clienteId;

    /// <summary>Tildar con cuál de las razones sociales estoy trabajando ahora. Lo que cambia:
    /// la ficha 👁️ (saldo y facturas), la venta que se cree desde el chat y el comprobante.</summary>
    async Task ElegirRazon(int clienteId)
    {
        if (selectedNumero == null || cambiandoRazon) return;
        if (EsRazonActiva(clienteId)) return;   // ya está tildada, no hago nada
        cambiandoRazon = true;
        try
        {
            var nombre = RazonesSociales.FirstOrDefault(r => r.Id == clienteId)?.Nombre ?? "ese cliente";
            if (await Api.ElegirClienteChatAsync(selectedNumero, clienteId))
            {
                await LoadConversaciones(silent: true);
                // Si la ficha del cliente estaba abierta, que muestre la de la razón social nueva.
                await CargarFichaCliente();   // el saldo/los datos cambiaron: refrescar también la barra de arriba
                Toast.Success($"🛍️ Ahora estás trabajando con {nombre}");
            }
            else Toast.Error("No pude cambiar de razón social. Probá de nuevo.");
        }
        catch { Toast.Error("No pude cambiar de razón social. Probá de nuevo."); }
        finally { cambiandoRazon = false; }
    }

    /// <summary>Sacar UNA razón social de este teléfono. NO borra el cliente del sistema: solo lo
    /// despega del chat.</summary>
    async Task QuitarRazon(int clienteId, string nombre)
    {
        if (selectedNumero == null) return;
        if (!await JS.InvokeAsync<bool>("confirm",
                $"¿Sacar \"{nombre}\" de este chat?\n\nEl cliente NO se borra: solo deja de estar colgado de este teléfono."))
            return;
        if (await Api.DesvincularClienteChatAsync(selectedNumero, clienteId))
        {
            await LoadContactos();
            await LoadConversaciones(silent: true);
            await CargarFichaCliente();   // el saldo/los datos cambiaron: refrescar también la barra de arriba
            Toast.Success($"🔗 {nombre} ya no está en este chat");
        }
        else Toast.Error("No pude sacarlo. Probá de nuevo.");
    }

