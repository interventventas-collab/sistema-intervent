    // 2026-07-23: buscador de la pestaña Contactos (miles tras la importación de clientes)
        // 2026-07-23: etiqueta legible del tipo de archivo, por la extensión de la URL o del nombre
    static string WaTipoArchivo(string? url, string? filename)
    {
        var ext = System.IO.Path.GetExtension(filename ?? "").TrimStart('.').ToLowerInvariant();
        if (string.IsNullOrEmpty(ext))
            ext = System.IO.Path.GetExtension((url ?? "").Split('?')[0]).TrimStart('.').ToLowerInvariant();
        return ext switch
        {
            "pdf" => "📄 PDF",
            "xls" or "xlsx" or "csv" => "📊 Excel",
            "doc" or "docx" => "📝 Word",
            "zip" or "rar" => "🗜 Comprimido",
            "mp4" or "mov" => "🎬 Video",
            "" => "Archivo",
            _ => $"Archivo .{ext}"
        };
    }

    // 2026-07-24: tilditos de estado tipo WhatsApp (✓ enviado · ✓✓ entregado · ✓✓ azul leído · ⚠ falló)
    static string TildeTexto(string? e) => e switch { "read" => "✓✓", "delivered" => "✓✓", "sent" => "✓", "failed" => "⚠", _ => "✓" };
    static string TildeCss(string? e) => e == "read" ? "wa-tilde wa-tilde-read" : e == "failed" ? "wa-tilde wa-tilde-fail" : "wa-tilde";
    static string TildeTitulo(string? e, string? motivo = null) => e switch
    {
        "read" => "Leído",
        "delivered" => "Entregado",
        "sent" => "Enviado",
        "failed" => string.IsNullOrWhiteSpace(motivo) ? "No se pudo entregar" : "No se pudo entregar: " + motivo,
        _ => "Enviando…"
    };

    string FormatHora(DateTime utc)
    {
        var local = utc.ToArTime();
        // 2026-08-26: la hora de AHORA tiene que ser la de ARGENTINA, no la del reloj del navegador.
        // El dueño opera desde España (UTC+2): entre las 00:00 y las 05:00 de Argentina el navegador
        // ya está en el día siguiente y los mensajes salían etiquetados con el día equivocado.
        var ahora = DateTimeExt.AhoraAr();
        if (local.Date == ahora.Date) return local.ToString("HH:mm");
        if (local.Date == ahora.Date.AddDays(-1)) return "Ayer";
        return local.ToString("dd/MM");
    }

    // 2026-08-03: para cada mensaje del chat SIEMPRE mostramos la hora, y sumamos la fecha
    // cuando no es de hoy. Así nunca se pierde a qué hora/día escribieron. (La lista de la
    // izquierda sigue usando FormatHora, que es más compacto.)
    string FormatHoraMsg(DateTime utc)
    {
        var local = utc.ToArTime();
        // 2026-08-26: hora argentina, no la del navegador (ver FormatHora).
        var ahora = DateTimeExt.AhoraAr();
        if (local.Date == ahora.Date) return local.ToString("HH:mm");
        if (local.Date == ahora.Date.AddDays(-1)) return "Ayer " + local.ToString("HH:mm");
        return local.ToString("dd/MM HH:mm");
    }

    string TruncateText(string? s, int max)
    {
        if (string.IsNullOrEmpty(s)) return "";
        return s.Length <= max ? s : s.Substring(0, max) + "…";
    }

    string EscapeMsg(string? s)
    {
        if (string.IsNullOrEmpty(s)) return "";
        var enc = System.Net.WebUtility.HtmlEncode(s);
        // 2026-08-05: links clickeables (ej: la ubicación con su link de Google Maps). Se hace
        // DESPUÉS de encodear, así el texto ya está saneado (no hay < > " sueltos que rompan el HTML).
        enc = System.Text.RegularExpressions.Regex.Replace(
            enc, @"https?://[^\s<]+",
            mm => $"<a href=\"{mm.Value}\" target=\"_blank\" rel=\"noopener noreferrer\">{mm.Value}</a>");
        return enc.Replace("\n", "<br/>");
    }

    // 2026-08-02: nombre lindo para el archivo al descargarlo. Usa el nombre original si lo hay,
    // si no arma uno con la fecha. El atributo download fuerza la descarga (la media es del mismo sitio).
    string NombreDescarga(ApiClient.TwMsgDto m)
    {
        if (!string.IsNullOrWhiteSpace(m.MediaFilename)) return m.MediaFilename!;
        var ext = System.IO.Path.GetExtension((m.MediaUrl ?? "").Split('?')[0]);
        if (string.IsNullOrEmpty(ext))
        {
            if (IsImage(m.MediaUrl)) ext = ".jpg";
            else if (IsAudio(m.MediaUrl)) ext = ".ogg";
        }
        return $"whatsapp-{m.CreatedAt:yyyyMMdd-HHmmss}{ext}";
    }

    bool IsImage(string? url)
    {
        if (string.IsNullOrEmpty(url)) return false;
        var lower = url.ToLowerInvariant();
        return lower.Contains(".jpg") || lower.Contains(".jpeg") || lower.Contains(".png")
            || lower.Contains(".gif") || lower.Contains(".webp") || lower.Contains("image");
    }

