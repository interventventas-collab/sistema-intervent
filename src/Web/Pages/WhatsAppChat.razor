    .wa-fwd-badge { display: inline-block; margin-top: 0.15rem; font-size: 0.68rem; padding: 0.05rem 0.4rem; border-radius: 999px; }
    .wa-fwd-badge.ok { background: #dcfce7; color: #166534; }
    .wa-fwd-badge.no { background: #f3f4f6; color: #9ca3af; }

    /* 2026-08-02: flecha "volver" (oculta en escritorio, se ve solo en el celular) */
    .wa-volver-btn { display: none; background: transparent; border: 0; font-size: 1.6rem; line-height: 1; color: #128c7e; cursor: pointer; padding: 0 0.4rem 0 0; }

    /* 2026-08-02: botón para descargar un archivo/imagen/audio recibido */
    .wa-descargar-btn { display: inline-block; margin-top: 0.25rem; font-size: 0.72rem; color: #128c7e; text-decoration: none; background: #e7f7f1; border: 1px solid #b9e6d7; border-radius: 6px; padding: 0.15rem 0.5rem; }
    .wa-descargar-btn:hover { background: #d5f0e6; }

    /* 2026-08-02: en la pantalla de WhatsApp no tiene sentido el panel flotante de WhatsApp (ya estás adentro) */
    .waf-panel, .waf-fab { display: none !important; }

    /* ===== 2026-08-02: MODO CELULAR estilo WhatsApp =====
       En pantallas chicas se ve O la lista O el chat, a pantalla completa (no las dos apretadas).
       Tocás un chat -> se abre el chat entero. Flecha "volver" -> volvés a la lista. */
    @@media (max-width: 820px) {
        /* Punto 1: en el celular, dentro de WhatsApp mostramos SOLO el WhatsApp.
           Ocultamos la botonera del menú del sistema (BÓVEDA, CALCUPRECIOS, Stock, Venta, etc.)
           y dejamos la barra chica de arriba (☰ menú + Volver) para poder navegar. */
        .main-wrapper .topbar-actions { display: none !important; }

        .wa-topbar { padding: 0.4rem 0.6rem 0; gap: 0.5rem; }
        .wa-tab-top { font-size: 0.85rem; }
        /* En el celular también va a pantalla completa: la caja .wa-fs ya ocupa todo,
           así que acá el chat solo tiene que estirarse con lo que sobra (sin restar barras). */
        .wa-outer { padding: 0; background: #fff; }
        .wa-root { grid-template-columns: 1fr; gap: 0; max-width: 100%; }
        .wa-sidebar, .wa-thread { border-radius: 0; border-left: 0; border-right: 0; box-shadow: none; }

        /* Sin chat abierto: se ve la lista, se esconde el chat */
        .wa-root .wa-thread-wrap { display: none; }
        .wa-root .wa-sidebar { display: flex; }
        /* Con un chat abierto: se ve el chat completo, se esconde la lista */
        .wa-root.wa-chat-abierto .wa-sidebar { display: none; }
        .wa-root.wa-chat-abierto .wa-thread-wrap { display: flex; }

        /* 2026-08-17: en el celular una columna fija de 260 px se comería media pantalla.
           Queda SOLO la tira de iconos, y el panel se abre POR ENCIMA del chat (como una
           gaveta) al tocar 👤 o 💬. Arranca cerrado — lo decide el código al entrar. */
        .wa-thread-wrap { position: relative; gap: 0; }
        .wa-ctx { position: absolute; top: 0; right: 44px; bottom: 0; z-index: 30; width: min(280px, calc(100% - 52px));
            flex: none; border-radius: 0; box-shadow: -8px 0 24px rgba(15,23,42,0.18); }
        .wa-ctx-rail { border-radius: 0; flex: 0 0 40px; width: 40px; }

        .wa-volver-btn { display: inline-flex; align-items: center; }

        /* Encabezado del chat compacto: botones de acción chiquitos para que no tapen todo */
        .wa-thread-header { padding: 0.5rem 0.6rem; gap: 0.3rem; }
        .wa-thread-header .btn { font-size: 0.66rem !important; padding: 0.2rem 0.4rem !important; }

        /* Caja para escribir cómoda (no gigante) y botones grandes para el pulgar.
           2026-08-03: en el celu la casilla de texto va ARRIBA a todo el ancho (order:-1),
           y los botoncitos + Enviar quedan en una fila DEBAJO. Antes todo iba en una sola
           línea y el textarea quedaba un huequito finito (las letras se apilaban). */
        .wa-composer { padding: 0.5rem 0.6rem calc(0.5rem + env(safe-area-inset-bottom)); gap: 0.4rem; flex-wrap: wrap; align-items: center; }
        .wa-composer textarea { flex: 1 1 100% !important; order: -1; min-height: 90px !important; height: auto !important; max-height: 180px !important; }
        .wa-composer .wa-enviar-btn { margin-left: auto; }
        .wa-attach-btn { width: 40px; height: 40px; font-size: 1.2rem; }
        .wa-messages { padding: 0.7rem; }
    }

    /* 2026-08-05: visor de fotos emergente (lightbox) — al tocar una foto del chat se abre acá, sin ir a otra pestaña */
    .wa-chat-img { transition: filter .12s ease; }
    .wa-chat-img:hover { filter: brightness(1.04); }
    .wa-visor-backdrop { position: fixed; inset: 0; background: rgba(0,0,0,0.85); z-index: 3000; display: flex; flex-direction: column; align-items: center; justify-content: center; padding: 2.5rem 1rem 1rem; animation: waVisorIn .14s ease; }
    @@keyframes waVisorIn { from { opacity: 0; } to { opacity: 1; } }
    .wa-visor-img { max-width: 92vw; max-height: 78vh; border-radius: 8px; box-shadow: 0 12px 48px rgba(0,0,0,0.6); object-fit: contain; }
    .wa-visor-x { position: absolute; top: 1rem; right: 1.2rem; background: rgba(255,255,255,0.15); border: none; color: #fff; font-size: 1.8rem; line-height: 1; width: 44px; height: 44px; border-radius: 50%; cursor: pointer; display: flex; align-items: center; justify-content: center; }
    .wa-visor-x:hover { background: rgba(255,255,255,0.3); }
    .wa-visor-dl { margin-top: 1rem; background: linear-gradient(135deg, #25d366 0%, #12b859 100%); color: #fff; text-decoration: none; font-weight: 700; padding: 0.6rem 1.4rem; border-radius: 12px; box-shadow: 0 4px 14px rgba(18,184,89,0.45); }
    .wa-visor-dl:hover { filter: brightness(1.06); color: #fff; }
</style>

@* 2026-08-05: visor de fotos emergente (se cierra tocando el fondo, la ✖ o Escape) *@
