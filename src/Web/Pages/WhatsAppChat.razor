    // 2026-08-22: MISMAS reglas que el servidor (MetaWhatsAppService.ToInboxWhatsApp), para que la
    // pantalla muestre EXACTAMENTE el número al que se va a enviar. Si no, el operador ve un número
    // raro ("+1165387009"), no lo reconoce y no sabe si mandarlo.
    static string NumeroWaFinal(string? tipeado)
    {
        var raw = (tipeado ?? "").Trim();
        var d = new string(raw.Where(char.IsDigit).ToArray());
        if (d.Length == 0) return "";
        bool internacional = raw.Contains('+');          // trae su propio código de país
        if (d.StartsWith("549")) return d;
        if (d.StartsWith("54")) return "549" + d.Substring(2);
        if (internacional) return "+" + d;                // ej España +34…: el "+" se CONSERVA, si no el
                                                          // servidor lo toma por argentino y le pega el 549
        d = d.TrimStart('0');                             // 011… → 11…
        if (d.StartsWith("9") && d.Length == 11) return "54" + d;   // ya trae el 9 de celular
        return "549" + d;
    }

    /// <summary>Avisa los dos errores que el sistema NO puede adivinar: el 15 del celular y un largo
    /// que no cierra. El 0 de la característica sí lo sacamos solos.</summary>
    static string? AvisoNumero(string? tipeado, string numeroFinal)
    {
        var raw = (tipeado ?? "").Trim();
        if (raw.Contains('+')) return null;                       // número del exterior: no opinamos
        if (!numeroFinal.StartsWith("549")) return null;
        var local = numeroFinal.Substring(3);                     // característica + abonado
        if (local.Length >= 12 && local.Substring(2, 2) == "15")
            return "⚠️ Parece que le pusiste el 15. Sacalo: va característica + número (ej 11 6538-7009).";
        if (local.Length != 10)
            return $"⚠️ Ojo: los celulares argentinos tienen 10 dígitos (característica sin 0 + número sin 15) y este tiene {local.Length}. Revisalo antes de mandar.";
        return null;
    }

