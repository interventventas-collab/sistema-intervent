    .wa-mm-busc-x { background: none; border: none; color: #d6d3d1; cursor: pointer; font-size: 0.8rem; padding: 0 0.15rem; }
    .wa-mm-busc-x:hover { color: #ef4444; }
    /* Cada comprador que coincidió con la búsqueda */
    .wa-mm-match { display: block; width: calc(100% - 1.4rem); text-align: left; font-family: inherit; background: #fff; border: 1px solid #e7e5e4; border-radius: 9px; padding: 0.4rem 0.55rem; margin: 0 0.7rem 0.35rem; cursor: pointer; transition: all .12s; }
    .wa-mm-match:hover { border-color: #eab308; background: #fefce8; }
    .wa-mm-match-l1 { display: flex; align-items: baseline; gap: 0.4rem; font-size: 0.85rem; }
    .wa-mm-match-nick { font-weight: 700; color: #292524; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
    .wa-mm-match-cnt { margin-left: auto; font-size: 0.72rem; font-weight: 700; color: #a16207; background: #fef9c3; border-radius: 999px; padding: 0.05rem 0.4rem; white-space: nowrap; }
    .wa-mm-match-l2 { display: flex; align-items: baseline; gap: 0.4rem; font-size: 0.76rem; color: #78716c; margin-top: 0.1rem; }
    .wa-mm-match-fec { margin-left: auto; color: #a8a29e; white-space: nowrap; }
    .wa-mm-match-por { display: block; font-size: 0.7rem; color: #a8a29e; margin-top: 0.15rem; }
    /* Cabecera de la ficha */
    .wa-mm-cab { margin: 0.6rem 0.7rem 0; background: #fff; border: 1px solid #e7e5e4; border-radius: 10px; padding: 0.55rem 0.6rem; }
    .wa-mm-nick { font-size: 1rem; font-weight: 800; color: #1c1917; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
    .wa-mm-dato { font-size: 0.8rem; color: #57534e; margin-top: 0.12rem; }
    .wa-mm-nums { display: flex; flex-wrap: wrap; gap: 0.5rem; font-size: 0.76rem; color: #78716c; margin-top: 0.35rem; padding-top: 0.35rem; border-top: 1px solid #f5f5f4; }
    .wa-mm-vinc { display: block; width: 100%; text-align: center; font-family: inherit; font-size: 0.78rem; border-radius: 8px; padding: 0.3rem 0.45rem; margin-top: 0.4rem; }
    .wa-mm-vinc.ok { background: #f0fdf4; border: 1px solid #bbf7d0; color: #15803d; }
    .wa-mm-vinc.btn { background: #eff6ff; border: 1px solid #bfdbfe; color: #1d4ed8; font-weight: 700; cursor: pointer; }
    .wa-mm-vinc.btn:hover:not(:disabled) { background: #dbeafe; }
    .wa-mm-vinc.btn:disabled { opacity: 0.6; cursor: wait; }
    .wa-mm-aviso { font-size: 0.72rem; color: #92400e; background: #fffbeb; border: 1px solid #fde68a; border-radius: 7px; padding: 0.25rem 0.4rem; margin-top: 0.4rem; line-height: 1.35; }
    /* Cada compra */
    .wa-mm-compra { background: #fff; border: 1px solid #e7e5e4; border-radius: 10px; padding: 0.45rem 0.5rem; margin: 0 0.7rem 0.4rem; }
    .wa-mm-compra-l1 { display: flex; align-items: center; gap: 0.4rem; }
    .wa-mm-compra-foto { width: 34px; height: 34px; object-fit: cover; border-radius: 6px; border: 1px solid #f5f5f4; flex-shrink: 0; }
    .wa-mm-compra-tit { flex: 1; min-width: 0; font-size: 0.8rem; font-weight: 600; color: #292524; line-height: 1.25; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden; }
    .wa-mm-compra-l2 { display: flex; align-items: baseline; gap: 0.4rem; font-size: 0.75rem; color: #a8a29e; margin-top: 0.25rem; }
    .wa-mm-compra-tot { font-weight: 700; color: #44403c; }
    .wa-mm-compra-cta { margin-left: auto; background: #f5f5f4; border-radius: 999px; padding: 0.02rem 0.35rem; font-size: 0.68rem; }
    .wa-mm-estado { font-size: 0.82rem; font-weight: 700; color: #1c1917; margin-top: 0.3rem; }
    .wa-mm-envio { font-size: 0.72rem; color: #78716c; }
    .wa-mm-acc { display: flex; flex-wrap: wrap; gap: 0.25rem; margin-top: 0.35rem; }
    .wa-mm-btn { display: inline-flex; align-items: center; gap: 0.2rem; font-family: inherit; font-size: 0.72rem; font-weight: 600; color: #44403c; background: #f5f5f4; border: 1px solid #e7e5e4; border-radius: 7px; padding: 0.2rem 0.42rem; cursor: pointer; text-decoration: none; }
    .wa-mm-btn:hover { background: #ecebe9; }
    .wa-mm-btn.ok { background: #ecfdf5; border-color: #a7f3d0; color: #047857; }
    .wa-mm-btn.ok:hover { background: #d1fae5; }
    /* ===== 2026-08-21: BUSCADOR GLOBAL (una palabra en TODOS los chats) ===== */
    .wa-bg-btn { display: block; width: 100%; margin-top: 0.4rem; padding: 0.4rem 0.6rem; font-family: inherit; font-size: 0.8rem; font-weight: 600;
        color: #1d4ed8; background: #eff6ff; border: 1px solid #bfdbfe; border-radius: 9px; cursor: pointer; text-align: left;
        overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
    .wa-bg-btn:hover:not(:disabled) { background: #dbeafe; }
    .wa-bg-btn:disabled { opacity: 0.7; cursor: wait; }
    .wa-bg-head { display: flex; align-items: center; justify-content: space-between; gap: 0.4rem; padding: 0.5rem 0.6rem 0.3rem; }
    .wa-bg-volver { background: none; border: none; color: #1d4ed8; font-family: inherit; font-size: 0.8rem; font-weight: 700; cursor: pointer; padding: 0; }
    .wa-bg-volver:hover { text-decoration: underline; }
    .wa-bg-cuenta { font-size: 0.75rem; color: #94a3b8; white-space: nowrap; }
    .wa-bg-que { font-size: 0.78rem; color: #64748b; padding: 0 0.6rem 0.35rem; }
    .wa-bg-aviso { font-size: 0.72rem; color: #92400e; background: #fffbeb; border: 1px solid #fde68a; border-radius: 8px; margin: 0 0.6rem 0.4rem; padding: 0.3rem 0.45rem; line-height: 1.35; }
    .wa-bg-vacio { font-size: 0.83rem; color: #94a3b8; text-align: center; padding: 1rem 0.6rem; }
    .wa-bg-hit { display: block; width: calc(100% - 1.2rem); margin: 0 0.6rem 0.35rem; text-align: left; font-family: inherit;
        background: #fff; border: 1px solid #e6eaf0; border-radius: 10px; padding: 0.45rem 0.55rem; cursor: pointer; transition: all .12s; }
    .wa-bg-hit:hover { border-color: #25d366; background: #f0fff6; }
    .wa-bg-hit-l1 { display: flex; align-items: baseline; gap: 0.4rem; }
    .wa-bg-hit-nom { font-size: 0.85rem; font-weight: 700; color: #1f2937; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
    .wa-bg-hit-fec { margin-left: auto; font-size: 0.72rem; color: #9ca3af; white-space: nowrap; }
    .wa-bg-hit-txt { display: block; font-size: 0.79rem; color: #4b5563; line-height: 1.35; margin-top: 0.15rem;
        display: -webkit-box; -webkit-line-clamp: 3; -webkit-box-orient: vertical; overflow: hidden; }
    .wa-bg-hit-dir { color: #9ca3af; margin-right: 0.2rem; }
    .wa-bg-hit-linea { display: inline-block; margin-top: 0.25rem; font-size: 0.68rem; font-weight: 600; color: #475569;
        background: #f1f5f9; border-radius: 999px; padding: 0.05rem 0.45rem; }
    /* 2026-08-21 (parte 3): el cartelito de MercadoLibre arriba de la charla */
    .wa-mm-aviso-chat { display: flex; align-items: center; gap: 0.5rem; margin: 0 0 0.4rem; padding: 0.4rem 0.6rem;
        background: #fefce8; border: 1px solid #fde68a; border-radius: 10px; font-size: 0.85rem; color: #713f12; }
    .wa-mm-aviso-punto { font-size: 1rem; }
    .wa-mm-aviso-txt { flex: 1; min-width: 0; line-height: 1.3; }
    .wa-mm-aviso-pin { margin-left: 0.25rem; }
    .wa-mm-aviso-ver { background: #eab308; border: none; color: #422006; font-family: inherit; font-size: 0.8rem; font-weight: 700;
        border-radius: 8px; padding: 0.25rem 0.7rem; cursor: pointer; white-space: nowrap; }
    .wa-mm-aviso-ver:hover { background: #ca8a04; color: #fff; }
    .wa-mm-aviso-x { background: none; border: none; color: #a8a29e; font-size: 0.9rem; cursor: pointer; padding: 0 0.15rem; }
    .wa-mm-aviso-x:hover { color: #ef4444; }
    .wa-mm-codigos { display: flex; align-items: center; flex-wrap: wrap; gap: 0.3rem; margin: 0 0 0.4rem; }
    .wa-mm-codigos-lbl { font-size: 0.75rem; color: #94a3b8; }
    .wa-mm-cod { font-family: inherit; font-size: 0.76rem; font-weight: 600; color: #713f12; background: #fefce8;
        border: 1px solid #fde68a; border-radius: 999px; padding: 0.15rem 0.6rem; cursor: pointer; }
    .wa-mm-cod:hover { background: #fef9c3; border-color: #eab308; }
    /* 2026-08-21 (parte 2): entrega, preguntas y publicación */
    .wa-mm-rep { font-size: 0.75rem; color: #1d4ed8; font-weight: 600; margin-top: 0.1rem; }
    .wa-mm-dir { font-size: 0.74rem; color: #57534e; line-height: 1.3; margin-top: 0.1rem; }
    .wa-mm-perfil { display: block; text-align: center; font-size: 0.74rem; color: #a16207; text-decoration: none; margin-top: 0.35rem; }
    .wa-mm-perfil:hover { text-decoration: underline; }
    .wa-mm-soltar { background: none; border: none; color: #a8a29e; font-size: 0.7rem; text-decoration: underline; cursor: pointer; margin-left: 0.3rem; padding: 0; }
    .wa-mm-soltar:hover:not(:disabled) { color: #ef4444; }
    .wa-mm-vinc.btn.amarillo { background: #fefce8; border-color: #fde68a; color: #a16207; }
    .wa-mm-vinc.btn.amarillo:hover:not(:disabled) { background: #fef9c3; }
    .wa-mm-preg { background: #fff; border: 1px solid #e7e5e4; border-radius: 10px; padding: 0.45rem 0.5rem; margin: 0 0.7rem 0.4rem; }
    .wa-mm-preg-txt { font-size: 0.8rem; color: #292524; font-style: italic; margin-top: 0.3rem; line-height: 1.35; }
    .wa-mm-preg-resp { font-size: 0.75rem; color: #57534e; background: #f5f5f4; border-radius: 7px; padding: 0.25rem 0.4rem; margin-top: 0.25rem; line-height: 1.35; }
    .wa-mm-preg-ok { margin-left: auto; color: #15803d; font-weight: 700; }
    .wa-mm-preg-pend { margin-left: auto; color: #b45309; font-weight: 700; }
    .wa-mm-chips { display: flex; flex-wrap: wrap; gap: 0.25rem; margin-top: 0.3rem; }
    .wa-mm-chip { font-size: 0.7rem; font-weight: 600; color: #44403c; background: #f5f5f4; border: 1px solid #e7e5e4; border-radius: 999px; padding: 0.05rem 0.45rem; }
    .wa-mm-chip.rojo { background: #fef2f2; border-color: #fecaca; color: #b91c1c; }
    .wa-mm-publi { background: #fff; border: 1px solid #fde68a; border-radius: 10px; padding: 0.5rem; margin: 0.4rem 0.7rem 0.2rem; box-shadow: 0 2px 8px rgba(234,179,8,0.12); }
    .wa-mm-publi-precio { font-size: 1.15rem; font-weight: 800; color: #1c1917; margin-top: 0.3rem; }
    .wa-mm-otro { display: block; width: calc(100% - 1.4rem); margin: 0.3rem 0.7rem 0.7rem; background: none; border: none; color: #a8a29e; font-size: 0.76rem; cursor: pointer; padding: 0.3rem; }
    .wa-mm-otro:hover { color: #a16207; }
    .wa-ctx-btn-venta { background: #ecfdf5; border-color: #a7f3d0; color: #047857; font-weight: 700; }
    .wa-ctx-btn-venta:hover { background: #d1fae5; }
    /* 2026-08-03: opciones del buscador de "Vincular cliente" */
    .wa-vincular-opt { display: block; width: 100%; text-align: left; background: #f9fafb; border: 1px solid #e5e7eb; border-radius: 8px; padding: 0.55rem 0.65rem; margin-bottom: 0.35rem; font-size: 0.9rem; cursor: pointer; transition: all .12s; }
    .wa-vincular-opt:hover:not(:disabled) { background: #ecfdf5; border-color: #16a34a; }
    .wa-vincular-opt:disabled { opacity: 0.6; cursor: wait; }
    .wa-vincular-nuevo { margin-top: 0.7rem; padding-top: 0.7rem; border-top: 1px dashed #e5e7eb; }
    /* 2026-08-24: cartel "¿a nombre de quién va la venta?" — el cliente del chat va destacado
       arriba para que el caso normal siga siendo UN toque. */
    .wa-elegircli-def { display: flex; align-items: center; gap: 0.6rem; width: 100%; text-align: left; cursor: pointer;
        background: #ecfdf5; border: 2px solid #16a34a; border-radius: 10px; padding: 0.6rem 0.7rem; transition: all .12s; }
    .wa-elegircli-def:hover { background: #d1fae5; }
    .wa-elegircli-def-nom { flex: 1; font-size: 0.92rem; font-weight: 700; color: #065f46; }
    .wa-elegircli-def-cta { font-size: 0.78rem; font-weight: 700; color: #16a34a; white-space: nowrap; }
    .wa-elegircli-o { text-align: center; font-size: 0.75rem; color: #9ca3af; margin: 0.6rem 0 0.4rem; }
    /* 2026-08-17: los redondeles ya no son una columna al costado: van en la tira de arriba. */
    .wa-composer-tools { display: flex; flex-wrap: wrap; gap: 0.4rem; align-items: center; }
    /* MENÚ ROL — botón de la tira. La miniatura de lo que le llega al cliente se muestra
       SOLO al pasar el mouse por encima (antes ocupaba 110 px fijos ahí abajo). */
    .wa-menurol-mini { position: relative; display: inline-flex; align-items: center; margin: 0; cursor: pointer;
        background: #fff; border: 1px solid #e2e8f0; border-radius: 999px; padding: 0.42rem 0.75rem; }
    .wa-menurol-mini:hover:not(:disabled) { border-color: #25d366; background: #f0fff6; }
    .wa-menurol-mini:disabled { opacity: 0.6; cursor: wait; }
    .wa-menurol-cap { font-size: 0.8rem; color: #334155; font-weight: 700; white-space: nowrap; }
    .wa-menurol-bubble { display: none; position: absolute; bottom: calc(100% + 8px); left: 0; z-index: 60; width: 168px;
        background: #fff; border: 1px solid #e5e7eb; border-radius: 9px; overflow: hidden; box-shadow: 0 8px 20px rgba(0,0,0,0.16); }
    .wa-menurol-mini:hover:not(:disabled) .wa-menurol-bubble { display: block; }
    .wa-menurol-txt { display: block; padding: 0.4rem 0.5rem; font-size: 0.68rem; color: #111b21; line-height: 1.25; }
    .wa-menurol-opt { display: block; border-top: 1px solid #eef1f5; padding: 0.3rem; text-align: center; font-size: 0.7rem; color: #027eb5; font-weight: 600; }
    .wa-attach-btn { display: inline-flex; align-items: center; justify-content: center; width: 42px; height: 42px; border-radius: 50%; background: #fff; border: 1px solid #e0e0e0; cursor: pointer; font-size: 1.3rem; transition: all .15s; user-select: none; }
    .wa-attach-btn:hover { background: #e9f5ff; border-color: #25d366; transform: translateY(-1px); }
    .wa-attach-btn.uploading { background: #fff8e1; border-color: #ffc107; cursor: wait; animation: wa-attach-pulse 1s ease-in-out infinite; }
    @@keyframes wa-attach-pulse { 0%,100% { opacity: 1; } 50% { opacity: 0.6; } }
    .wa-mic-btn:hover { background: #ffe9ec; border-color: #ef4444; }
    .wa-mic-rec { background: #fee2e2; border-color: #ef4444; animation: wa-attach-pulse 1s ease-in-out infinite; }
    .wa-mic-rec-label { display: inline-flex; align-items: center; font-size: 0.8rem; color: #dc2626; font-weight: 600; white-space: nowrap; }
    .wa-quick-replies { padding: 0.6rem 1rem 0.2rem; background: #fbfcfe; display: flex; gap: 0.45rem; flex-wrap: wrap; border-top: 1px solid #eef1f5; }
    /* 2026-08-05: contador de la ventana de 24hs (reloj de arena + estado) */
    /* 2026-08-17: "Alta de clientes" y "Respuestas" viven en la tira de arriba, no en una
       columna a la derecha (quedaban dos columnas pegadas al borde junto con el panel). */
    .wa-alta-cliente-btn { background: #ecfdf5; border: 1px solid #a7f3d0; color: #047857; border-radius: 999px; padding: 0.42rem 0.8rem; font-size: 0.8rem; font-weight: 700; cursor: pointer; white-space: nowrap; transition: all .12s; }
    .wa-alta-cliente-btn:hover { background: #d1fae5; border-color: #6ee7b7; }
    .wa-qr { position: relative; }
    .wa-qr-toggle { background: #f0f9ff; border: 1px solid #bae6fd; color: #0369a1; border-radius: 999px; padding: 0.42rem 0.8rem; font-size: 0.8rem; font-weight: 700; cursor: pointer; white-space: nowrap; transition: all .12s; }
    .wa-qr-toggle:hover { background: #e0f2fe; border-color: #7dd3fc; }
    .wa-qr-toggle.abierto { background: #0284c7; border-color: #0284c7; color: #fff; }
    .wa-qr-dropdown { position: absolute; bottom: calc(100% + 6px); left: 0; background: #fff; border: 1px solid #e5e7eb; border-radius: 12px; box-shadow: 0 10px 28px rgba(0,0,0,0.18); padding: 0.5rem; display: flex; flex-direction: column; gap: 0.32rem; min-width: 190px; max-height: 340px; overflow-y: auto; z-index: 60; }
    .wa-qr-dropdown .wa-chip { width: 100%; text-align: center; }
    /* 2026-08-17: los avisos en UN renglón fino (antes: dos carteles + la explicación larga). */
    .wa-avisos-row { display: flex; flex-wrap: wrap; gap: 0.4rem; align-items: center; padding: 0.15rem 1rem 0.4rem; font-size: 0.78rem; }
    .wa-avisos-regla { cursor: help; font-size: 0.9rem; }
    .wa-avisos-row .wa-composer-linea { margin: 0; border-radius: 999px; padding: 0.2rem 0.65rem; font-size: 0.76rem; flex: 0 1 auto; }
    .wa-avisos-row .wa-vent24 { margin: 0; padding: 0.2rem 0.65rem; font-size: 0.76rem; }
    .wa-vent24 { display: inline-flex; align-items: center; gap: 0.5rem; margin: 0.55rem 1rem 0; padding: 0.42rem 0.85rem; border-radius: 999px; font-size: 0.8rem; font-weight: 600; }
    .wa-vent24.ok { background: #ecfdf5; color: #15803d; border: 1px solid #a7f3d0; }
    .wa-vent24.urgente { background: #fffbeb; color: #b45309; border: 1px solid #fcd34d; }
