    static string TildeCss(string? e) => e == "read" ? "wa-tilde wa-tilde-read" : e == "failed" ? "wa-tilde wa-tilde-fail" : "wa-tilde";
    static string TildeTitulo(string? e) => e switch { "read" => "Leído", "delivered" => "Entregado", "sent" => "Enviado", "failed" => "No se pudo entregar", _ => "Enviando…" };

    string FormatHora(DateTime utc)
    {
        var local = utc.ToArTime();
        var ahora = DateTime.Now;
        if (local.Date == ahora.Date) return local.ToString("HH:mm");
        if (local.Date == ahora.Date.AddDays(-1)) return "Ayer";
        return local.ToString("dd/MM");
    }

    // 2026-08-03: para cada mensaje del chat SIEMPRE mostramos la hora, y sumamos la fecha
    // cuando no es de hoy. Así nunca se pierde a qué hora/día escribieron. (La lista de la
    // izquierda sigue usando FormatHora, que es más compacto.)
    string FormatHoraMsg(DateTime utc)
    {
        var local = utc.ToArTime();
        var ahora = DateTime.Now;
        if (local.Date == ahora.Date) return local.ToString("HH:mm");
        if (local.Date == ahora.Date.AddDays(-1)) return "Ayer " + local.ToString("HH:mm");
        return local.ToString("dd/MM HH:mm");
    }

    string TruncateText(string? s, int max)
    {
        if (string.IsNullOrEmpty(s)) return "";
        return s.Length <= max ? s : s.Substring(0, max) + "…";
    }

    string EscapeMsg(string? s)
    {
        if (string.IsNullOrEmpty(s)) return "";
        return System.Net.WebUtility.HtmlEncode(s).Replace("\n", "<br/>");
    }

    // 2026-08-02: nombre lindo para el archivo al descargarlo. Usa el nombre original si lo hay,
    // si no arma uno con la fecha. El atributo download fuerza la descarga (la media es del mismo sitio).
    string NombreDescarga(ApiClient.TwMsgDto m)
    {
        if (!string.IsNullOrWhiteSpace(m.MediaFilename)) return m.MediaFilename!;
        var ext = System.IO.Path.GetExtension((m.MediaUrl ?? "").Split('?')[0]);
        if (string.IsNullOrEmpty(ext))
        {
            if (IsImage(m.MediaUrl)) ext = ".jpg";
            else if (IsAudio(m.MediaUrl)) ext = ".ogg";
        }
        return $"whatsapp-{m.CreatedAt:yyyyMMdd-HHmmss}{ext}";
    }

    bool IsImage(string? url)
    {
        if (string.IsNullOrEmpty(url)) return false;
        var lower = url.ToLowerInvariant();
        return lower.Contains(".jpg") || lower.Contains(".jpeg") || lower.Contains(".png")
            || lower.Contains(".gif") || lower.Contains(".webp") || lower.Contains("image");
    }

    // 2026-07-23: notas de voz. Los audios de WhatsApp llegan como .ogg (opus); los que grabamos
    // nosotros desde el navegador pueden ser .webm o .m4a segun el dispositivo.
    bool IsAudio(string? url)
    {
        if (string.IsNullOrEmpty(url)) return false;
        var lower = url.ToLowerInvariant();
        return lower.EndsWith(".ogg") || lower.EndsWith(".opus") || lower.EndsWith(".mp3")
            || lower.EndsWith(".m4a") || lower.EndsWith(".amr") || lower.EndsWith(".wav")
            || lower.EndsWith(".webm");
    }

