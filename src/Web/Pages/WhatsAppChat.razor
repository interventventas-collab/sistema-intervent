    async Task CargarProgramados()
    {
        if (selectedNumero == null) { progPendientes = new(); progResueltos = new(); return; }
        var numeroPedido = selectedNumero;
        var resp = await Api.GetTwProgramadosAsync(numeroPedido);
        // 2026-08-24 (mismo tropiezo que la ficha del cliente): si mientras tanto cambiaron de chat,
        // esta respuesta es del chat ANTERIOR. Se tira, no se pinta.
        if (resp == null || numeroPedido != selectedNumero) return;
        progPendientes = resp.Pendientes ?? new();
        progResueltos = resp.Resueltos ?? new();
        StateHasChanged();
    }

    /// <summary>Anota el mensaje para que salga a la hora elegida. No manda nada ahora.</summary>
    async Task ProgramarAhora()
    {
        if (selectedNumero == null || !SePuedeProgramar()) return;
        if (progCuando <= DateTimeExt.AhoraAr()) { Toast.Warning("Esa hora ya pasó: elegí un horario que venga."); return; }

        var numero = selectedNumero;
        var linea = selectedLinea;
        var cuandoUtc = progCuando.ArToUtc();   // la pantalla habla en hora argentina; el servidor, en UTC
        progGuardando = true;
        StateHasChanged();
        try
        {
            var avisos = new List<string>();
            if (progModo == "PLANTILLA")
            {
                var sel = ChatPlantillaSel();
                if (sel == null) { Toast.Warning("Elegí la plantilla"); return; }
                var (ok, err, aviso) = await Api.ProgramarTwMensajeAsync(new
                {
                    Numero = numero, LineaPhoneId = linea, Tipo = "PLANTILLA",
                    Plantilla = sel.Name, Idioma = sel.Language, Variables = chatVariables,
                    CuerpoPreview = sel.BodyText, ProgramadoPara = cuandoUtc
                });
                if (!ok) { Toast.Error(err ?? "No se pudo programar"); return; }
                if (!string.IsNullOrWhiteSpace(aviso)) avisos.Add(aviso!);
            }
            else
            {
                var adjuntos = AdjuntosProgramables();
                var texto = composerText?.Trim();
                if (adjuntos.Count == 0)
                {
                    var (ok, err, aviso) = await Api.ProgramarTwMensajeAsync(new
                    {
                        Numero = numero, LineaPhoneId = linea, Tipo = "TEXTO",
                        Texto = texto, ProgramadoPara = cuandoUtc
                    });
                    if (!ok) { Toast.Error(err ?? "No se pudo programar"); return; }
                    if (!string.IsNullOrWhiteSpace(aviso)) avisos.Add(aviso!);
                }
                else
                {
                    // Igual que al enviar a mano: el texto va como pie de foto del PRIMER adjunto.
                    for (int i = 0; i < adjuntos.Count; i++)
                    {
                        var ad = adjuntos[i];
                        var url = ad.Url;
                        var nombre = ad.FileName;
                        // 2026-08-26: los del servidor (🗂️) no tienen archivo todavía: son un tipo + un
                        // número (ej. COBRANZA 412). Se arma AHORA el PDF y se guarda su dirección, así
                        // el cliente recibe el comprobante tal cual lo estás viendo al agendarlo.
                        if (ad.Kind == "SERVER")
                        {
                            var prep = await Api.PrepararTwServerFileAsync(numero, ad.ServerTipo, ad.ServerId, linea);
                            if (!prep.ok) { Toast.Error($"No se pudo preparar {ad.Label}: {prep.error}"); return; }
                            url = prep.mediaUrl!;
                            nombre = prep.filename ?? ad.Label;
                        }
                        var (ok, err, aviso) = await Api.ProgramarTwMensajeAsync(new
                        {
                            Numero = numero, LineaPhoneId = linea, Tipo = "ADJUNTO",
                            Texto = i == 0 ? texto : null, MediaUrl = url, MediaFilename = nombre,
                            ProgramadoPara = cuandoUtc
                        });
                        if (!ok) { Toast.Error($"No se pudo programar {ad.Label}: {err}"); return; }
                        if (i == 0 && !string.IsNullOrWhiteSpace(aviso)) avisos.Add(aviso!);
                        pendientes.Remove(ad);
                    }
                }
                composerText = "";
                try { await JS.InvokeVoidAsync("waComposer.resetSize"); } catch { }
            }

            Toast.Success($"Listo: se manda {CuandoLindo(progCuando)}. Podés cerrar la pantalla, sale igual.");
            foreach (var av in avisos) Toast.Warning(av);
            showProgramarPanel = false;
            await CargarProgramados();
        }
        catch (Exception ex) { Toast.Error($"Error: {ex.Message}"); }
        finally { progGuardando = false; StateHasChanged(); }
    }

