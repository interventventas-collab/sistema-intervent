    /* 2026-08-03: buscador estilo WhatsApp en "Nueva conversación" */
    .wa-nv-avatar { width: 40px; height: 40px; border-radius: 50%; background: #64748b; color: #fff; display: flex; align-items: center; justify-content: center; font-weight: 700; font-size: 1.05rem; flex-shrink: 0; }
