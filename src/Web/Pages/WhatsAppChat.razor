    /* Tilditos de estado en los mensajes que mandamos */
    .wa-reply-clic { cursor: pointer; }
    .wa-reply-clic:hover { filter: brightness(0.96); }

    /* 2026-08-18: confirmación del menú de opciones */
    .wa-confirmar-menurol { background: #fef3c7; border: 1px solid #fcd34d; border-radius: 8px;
        padding: 0.5rem 0.7rem; margin-bottom: 0.4rem; display: flex; align-items: center; gap: 0.5rem; flex-wrap: wrap; }
    .wa-confirmar-txt { flex: 1; min-width: 200px; font-size: 0.85rem; color: #92400e; }
    .wa-confirmar-no { background: #fff; border: 1px solid #d1d5db; color: #374151; border-radius: 6px;
        padding: 0.35rem 0.8rem; font-weight: 700; cursor: pointer; }
    .wa-confirmar-si { background: #25d366; border: none; color: #fff; border-radius: 6px;
        padding: 0.35rem 0.8rem; font-weight: 700; cursor: pointer; }
    .wa-confirmar-si:disabled { opacity: 0.6; cursor: wait; }

    .wa-tilde { color: #8a8a8a; font-size: 0.72rem; margin-left: 3px; letter-spacing: -1px; }
    .wa-tilde-read { color: #34b7f1; }
    .wa-tilde-fail { color: #dc2626; letter-spacing: 0; }
    /* 2026-08-17: el chat y el panel derecho, uno al lado del otro. min-width:0 es CLAVE:
       sin eso el chat no se deja achicar y el panel empuja todo fuera de la pantalla. */
    /* min-height:0 + overflow:hidden NO son decorativos: sin eso esta caja se estira hasta
       el alto de TODOS los mensajes (medido: 1897 px en una ventana de 860) y empuja las
       tres columnas fuera de la pantalla — se pierde el encabezado del chat, la lista de
       conversaciones y las secciones de arriba del panel. El .wa-thread de adentro ya se
       achicaba solo porque tiene overflow:hidden; esta caja no lo tenía. */
    .wa-thread-wrap { display: flex; gap: 0.6rem; min-width: 0; min-height: 0; overflow: hidden; }
    .wa-thread { flex: 1; min-width: 0; display: flex; flex-direction: column; background: #efeae2; border: 1px solid #e6eaf0; border-radius: 16px; overflow: hidden; box-shadow: 0 6px 20px rgba(15,23,42,0.06); }

    /* ══════════ PANEL DERECHO ══════════
       260 px: Zendesk usa 200 como mínimo y 320 fijo; con 180 "— Sin asignar —" quedaba apretado. */
    .wa-ctx { width: 260px; flex: 0 0 260px; display: flex; flex-direction: column; gap: 0.5rem; overflow-y: auto;
        background: #fff; border: 1px solid #e6eaf0; border-radius: 16px; padding: 0.6rem; box-shadow: 0 6px 20px rgba(15,23,42,0.06); }
    .wa-ctx-sec { background: #fbfcfe; border: 1px solid #eef1f5; border-radius: 12px; padding: 0.55rem 0.6rem; display: flex; flex-direction: column; gap: 0.35rem; }
    .wa-ctx-sec-t { font-size: 0.72rem; font-weight: 700; color: #64748b; letter-spacing: 0.03em; text-transform: uppercase; }
    /* La sección de Borrar se va al fondo del panel, lejos del Guardar. */
    .wa-ctx-sec-peligro { margin-top: auto; background: #fff; border-color: #fee2e2; }
    .wa-ctx-lbl { font-size: 0.72rem; color: #64748b; font-weight: 600; margin-top: 0.15rem; }
    .wa-ctx-btn { display: flex; align-items: center; gap: 0.4rem; width: 100%; text-align: left; background: #fff; border: 1px solid #e2e8f0;
        border-radius: 9px; padding: 0.5rem 0.6rem; font-size: 0.84rem; font-weight: 600; color: #334155; cursor: pointer; transition: all .12s; }
    .wa-ctx-btn:hover:not(:disabled) { border-color: #25d366; background: #f0fff6; color: #128c4a; }
    .wa-ctx-btn:disabled { opacity: 0.6; cursor: wait; }
    .wa-ctx-btn-ok { border-color: #a7f3d0; background: #ecfdf5; color: #15803d; }
    .wa-ctx-btn-on { border-color: #25d366; background: #dcfce7; color: #14532d; }
    .wa-ctx-btn-guardar { justify-content: center; background: #2563eb; border-color: #2563eb; color: #fff; }
    .wa-ctx-btn-guardar:hover:not(:disabled) { background: #1d4ed8; border-color: #1d4ed8; color: #fff; }
    .wa-ctx-btn-borrar { justify-content: center; border-color: #fecaca; color: #b91c1c; }
    .wa-ctx-btn-borrar:hover:not(:disabled) { background: #fef2f2; border-color: #ef4444; color: #b91c1c; }
    .wa-ctx-select, .wa-ctx-input { width: 100%; border: 1px solid #dfe4ea; border-radius: 9px; padding: 0.45rem 0.55rem; font-size: 0.84rem; background: #fff; color: #111827; }
    .wa-ctx-select:focus, .wa-ctx-input:focus { outline: none; border-color: #25d366; box-shadow: 0 0 0 3px rgba(37,211,102,0.15); }
    .wa-ctx-info { font-size: 0.74rem; color: #475569; background: #f1f5f9; border-radius: 8px; padding: 0.4rem 0.5rem; }

    /* Tira de iconos del borde (estilo Zendesk): el panel se pliega pero nunca desaparece. */
    .wa-ctx-rail { flex: 0 0 44px; width: 44px; display: flex; flex-direction: column; align-items: center; gap: 0.4rem;
        background: #fff; border: 1px solid #e6eaf0; border-radius: 16px; padding: 0.5rem 0; box-shadow: 0 6px 20px rgba(15,23,42,0.06); }
    .wa-ctx-rail-btn { width: 32px; height: 32px; display: flex; align-items: center; justify-content: center; border: 1px solid transparent;
        background: transparent; border-radius: 9px; font-size: 1rem; color: #475569; cursor: pointer; transition: all .12s; }
    .wa-ctx-rail-btn:hover { background: #f0fff6; border-color: #25d366; }
    .wa-ctx-rail-btn.on { background: #dcfce7; border-color: #25d366; }
    .wa-ctx-rail-toggle { font-size: 1.15rem; font-weight: 800; color: #1d4ed8; background: #eff6ff; border-color: #dbeafe; }
    .wa-ctx-rail-toggle:hover { background: #dbeafe; border-color: #93c5fd; }
    /* 2026-07-24: flex-wrap para que en el celular los botones del header (incluido 🗑 Borrar,
       que es el ultimo) bajen a otro renglon en vez de quedar cortados por el overflow:hidden
       del .wa-thread. En pantalla ancha entran todos en una linea = no cambia nada. */
    .wa-thread-header { padding: 0.75rem 1.1rem; background: #fbfcfe; border-bottom: 1px solid #eef1f5; display: flex; align-items: center; gap: 0.6rem; flex-wrap: wrap; }
    /* 2026-07-29: botones del encabezado prolijos y parejos (pastilla redondeada), sin tocar la clase global .btn */
    .wa-thread-header .btn { border-radius: 999px; font-size: 0.8rem; padding: 0.4rem 0.9rem; font-weight: 600; border-width: 1px; transition: transform .12s ease, box-shadow .12s ease, background-color .12s ease; }
    /* 2026-08-01: efecto "teclado" — el botón se levanta con sombra al pasar por encima y se hunde al tocar */
    .wa-thread-header .btn:hover { transform: translateY(-2px); box-shadow: 0 5px 14px rgba(15,23,42,0.16); }
    .wa-thread-header .btn:active { transform: translateY(0); box-shadow: 0 2px 5px rgba(15,23,42,0.14); }
    /* Los botones de solo-ícono (⚙ y 🗑) quedan redondos perfectos */
    .wa-thread-header .btn.wa-icon-round { width: 38px; height: 38px; padding: 0; display: inline-flex; align-items: center; justify-content: center; font-size: 1rem; }
    .wa-num-edit { background: none; border: none; padding: 0 2px; cursor: pointer; font-size: 0.8rem; line-height: 1; opacity: 0.55; }
    .wa-num-edit:hover { opacity: 1; }
    .wa-messages { flex: 1; overflow-y: auto; padding: 1rem; display: flex; flex-direction: column; gap: 0.5rem; }
    .wa-empty { flex: 1; display: flex; flex-direction: column; align-items: center; justify-content: center; padding: 2rem; text-align: center; }
    /* 2026-08-20: cartelito que parte la charla por dia. Va como fila propia y centrado, para que
       funcione igual este el contenedor en bloque o en columna flex. */
    .wa-fecha-sep { display: flex; justify-content: center; margin: 0.6rem 0 0.3rem; }
    .wa-fecha-sep span { background: #e7f1e8; color: #4b5563; font-size: 0.78rem; font-weight: 700;
        padding: 3px 14px; border-radius: 999px; box-shadow: 0 1px 0.5px rgba(0,0,0,0.1); white-space: nowrap; }
    .wa-msg-row { display: flex; }
    .wa-msg-row.in { justify-content: flex-start; }
    .wa-msg-row.out { justify-content: flex-end; }
    .wa-bubble { max-width: 75%; padding: 0.45rem 0.65rem; border-radius: 8px; box-shadow: 0 1px 0.5px rgba(0,0,0,0.13); position: relative; }
    /* Cola estilo WhatsApp Web para distinguir mejor entrante/saliente */
    .wa-msg-row.in .wa-bubble::before { content: ''; position: absolute; left: -6px; top: 0; border: 6px solid transparent; border-top-color: white; border-left: 0; }
    .wa-msg-row.out .wa-bubble::before { content: ''; position: absolute; right: -6px; top: 0; border: 6px solid transparent; border-top-color: #d9fdd3; border-right: 0; }
    .wa-msg-row.in .wa-bubble { background: white; }
    .wa-msg-row.out .wa-bubble { background: #d9fdd3; }
    /* 2026-08-02: letra de los chats un poco más grande y en negrita (pedido Osmar) */
    .wa-bubble-body { font-size: 1.02rem; font-weight: 600; color: #111827; word-wrap: break-word; white-space: pre-wrap; }
    /* 2026-08-20: "Leer más" de los mensajes largos. */
    .wa-leermas { display: block; margin-top: 2px; background: none; border: none; padding: 0;
        color: #0b7a4b; font-weight: 800; font-size: 0.9rem; cursor: pointer; font-family: inherit; }

    /* 2026-08-02: tarjeta de contacto compartido (recibido o enviado) */
    .wa-contacto-card { display: flex; align-items: center; gap: 0.6rem; padding: 0.5rem 0.6rem; background: rgba(0,0,0,0.04); border-radius: 8px; margin-bottom: 0.3rem; min-width: 200px; }
    .wa-contacto-ava { width: 34px; height: 34px; border-radius: 50%; background: #25d366; color: #fff; display: inline-flex; align-items: center; justify-content: center; font-size: 1.1rem; flex-shrink: 0; }
    .wa-contacto-btn { background: #fff; border: 1px solid #cbd5e1; border-radius: 6px; padding: 0.25rem 0.5rem; font-size: 0.75rem; color: #128c7e; cursor: pointer; white-space: nowrap; }
    .wa-contacto-btn:hover { background: #f0fdf4; }
    .wa-bubble-meta { font-size: 0.65rem; color: #6b7280; text-align: right; margin-top: 0.2rem; }
    /* 2026-08-05: barra de FIRMA de Depósito (quién responde) arriba del cajón de escribir. */
    .wa-firma-bar { display: flex; align-items: center; flex-wrap: wrap; gap: 6px;
        padding: 0.5rem 1rem 0; background: #fbfcfe; }
    .wa-firma-lbl { font-size: 0.8rem; font-weight: 800; color: #374151; margin-right: 2px; }
    .wa-firma-op { border: 1px solid #d1d5db; background: #fff; color: #374151; font-weight: 700;
        font-size: 0.82rem; padding: 4px 12px; border-radius: 999px; cursor: pointer; text-transform: capitalize; }
    .wa-firma-op:hover { background: #f3f4f6; }
    .wa-firma-op.sel { background: #16a34a; border-color: #16a34a; color: #fff; box-shadow: 0 2px 6px rgba(22,163,74,0.35); }
    .wa-firma-hint { font-size: 0.74rem; color: #6b7280; margin-left: 4px; }
    .wa-firma-hint.wa-firma-falta { color: #dc2626; font-weight: 700; }

    /* 2026-08-17: el cajón pasó a dos renglones — herramientas arriba, cuadro + Enviar abajo. */
    .wa-composer { padding: 0.5rem 1rem 0.4rem; background: #fbfcfe; display: flex; flex-direction: column; gap: 0.4rem; }
    .wa-composer-tools-row { display: flex; align-items: center; gap: 0.45rem; flex-wrap: wrap; }
    .wa-composer-main { display: flex; align-items: flex-end; gap: 0.55rem; }
    /* 2026-08-03: letra al doble y en negrita (pedido Osmar) — ESO NO SE TOCA.
       2026-08-17: lo que se sacó es el alto FIJO de 145 px: ahora arranca en un renglón y
       crece solo al escribir (wa-composer.js), hasta 240 px y de ahí scrollea adentro. */
    /* 2026-08-20: arranca en DOS renglones (antes 56 px, que ni siquiera llegaba a uno con esta
       letra grande). La cuenta va en `em` para que siga la letra de 1.9rem sin numeros magicos.
       La LETRA no se toca. Sigue creciendo solo hasta 240 px y de ahi scrollea adentro. */
    .wa-composer textarea { resize: vertical; border-radius: 14px; flex: 1; min-height: calc(2.6em + 1.2rem + 2px); max-height: 240px; overflow-y: hidden;
        border: 1px solid #dfe4ea; padding: 0.6rem 0.9rem; font-size: 1.9rem; font-weight: 700; line-height: 1.3; }
    /* La ayudita gris (placeholder) NO va grande ni en negrita: chiquita y clarita para que se note que el cuadro está vacío. */
    .wa-composer textarea::placeholder { font-size: 1rem; font-weight: 400; color: #9ca3af; }
    .wa-composer textarea:focus { border-color: #25d366; box-shadow: 0 0 0 3px rgba(37,211,102,0.15); }
    .wa-composer button { white-space: nowrap; }
    /* 2026-07-29: botón Enviar más grande y prolijo */
    /* 2026-08-05: verde fuerte tipo WhatsApp (antes se veía apagado/muerto). El gris queda SOLO cuando está deshabilitado (cajón vacío). */
    .wa-composer .btn-success { border-radius: 14px; padding: 0.75rem 1.5rem; font-weight: 800; font-size: 1.05rem; color: #fff !important; background: linear-gradient(135deg, #25d366 0%, #12b859 100%) !important; border: none !important; box-shadow: 0 4px 14px rgba(18,184,89,0.45); transition: transform .12s ease, box-shadow .12s ease, filter .12s ease; }
    .wa-composer .btn-success:hover:not(:disabled) { transform: translateY(-2px); box-shadow: 0 8px 22px rgba(18,184,89,0.6); filter: brightness(1.06); }
    .wa-composer .btn-success:active:not(:disabled) { transform: translateY(0); box-shadow: 0 2px 6px rgba(18,184,89,0.5); }
    .wa-composer .btn-success:disabled { background: #cfd8dc !important; color: #eceff1 !important; box-shadow: none; }
    /* 2026-08-01: el botón Enviar parpadea (verde) mientras se manda el mensaje */
    .wa-enviar-btn.enviando { opacity: 1 !important; animation: wa-enviar-blink 0.55s ease-in-out infinite; }
    @@keyframes wa-enviar-blink { 0%, 100% { box-shadow: 0 3px 10px rgba(37,211,102,0.4); filter: brightness(1); } 50% { box-shadow: 0 0 20px rgba(37,211,102,0.95); filter: brightness(1.25); } }
    /* 2026-07-29: panel Enviar saldo */
    .wa-saldo-btn { font-size: 1.2rem; }
    .wa-saldo-panel { margin: 0 1rem 0.3rem; padding: 0.6rem 0.7rem; background: #fff; border: 1px solid #d1d5db; border-radius: 10px; box-shadow: 0 4px 14px rgba(0,0,0,0.08); max-height: 46vh; overflow-y: auto; }
    .wa-saldo-head { display: flex; align-items: center; justify-content: space-between; margin-bottom: 0.45rem; font-size: 0.9rem; }
    .wa-saldo-x { background: none; border: none; font-size: 1.2rem; cursor: pointer; color: #6b7280; line-height: 1; }
    .wa-saldo-buscar { margin: 0.35rem 0; font-size: 0.85rem; }
    .wa-saldo-cli { display: block; width: 100%; text-align: left; background: #f9fafb; border: 1px solid #e5e7eb; border-radius: 8px; padding: 0.5rem 0.6rem; margin-bottom: 0.3rem; font-size: 0.85rem; cursor: pointer; }
    .wa-saldo-cli:hover:not(:disabled) { background: #25d366; color: #fff; border-color: #25d366; }
    .wa-saldo-cli.destacado { background: #e9f5ff; border-color: #25d366; }
    .wa-cbu-btn { font-size: 1.2rem; }
    .wa-cbu-solo-alias { margin-left: 1rem; width: calc(100% - 1rem); background: #fbfbfd; font-size: 0.8rem; color: #6b7280; }
    .wa-saldo-cli:disabled { opacity: 0.6; cursor: wait; }
    .wa-saldo-info { font-size: 0.8rem; color: #6b7280; padding: 0.2rem 0.1rem; }
    /* 2026-08-03: cartelito que adivina el cliente por teléfono */
    .wa-sug-cliente { display: flex; align-items: center; gap: 0.55rem; margin: 0.5rem 1rem 0; padding: 0.55rem 0.75rem; background: #fffbeb; border: 1px solid #fde68a; border-radius: 10px; font-size: 0.88rem; color: #374151; box-shadow: 0 2px 8px rgba(0,0,0,0.05); }
    /* 2026-08-05: ficha del cliente desplegable dentro del chat */
    .wa-ficha { margin: 0.55rem 1rem 0; background: #ffffff; border: 1px solid #e5e7eb; border-radius: 12px; box-shadow: 0 4px 14px rgba(0,0,0,0.07); overflow: hidden; animation: waFichaIn .16s ease; }
    /* 2026-08-05: variante VENTANA FLOTANTE arrastrable (aparece a la izquierda por defecto, se puede mover) */
    .wa-ficha-float { position: fixed; left: 1.2rem; top: 92px; margin: 0; width: 560px; max-width: 94vw; max-height: 84vh; display: flex; flex-direction: column; z-index: 2100; box-shadow: 0 16px 46px rgba(0,0,0,0.34); }
    .wa-ficha-float .wa-ficha-top { cursor: move; touch-action: none; flex-shrink: 0; }
    .wa-ficha-float .wa-ficha-cols { overflow-y: auto; }
    .wa-ficha-mover { opacity: 0.65; margin-right: 0.15rem; cursor: move; }
    @@keyframes waFichaIn { from { opacity: 0; transform: translateY(-6px); } to { opacity: 1; transform: none; } }
    .wa-ficha-load { padding: 1rem; text-align: center; color: #6b7280; font-size: 0.9rem; }
    .wa-ficha-top { display: flex; align-items: center; justify-content: space-between; padding: 0.6rem 0.85rem; background: #f0fdf4; border-bottom: 1px solid #dcfce7; }
    .wa-ficha-nombre { font-size: 0.98rem; color: #14532d; display: flex; align-items: center; gap: 0.4rem; flex-wrap: wrap; }
    .wa-ficha-cod { background: #d1fae5; color: #047857; font-size: 0.72rem; padding: 0.05rem 0.4rem; border-radius: 5px; font-weight: 600; }
    .wa-ficha-chip { background: #e0e7ff; color: #3730a3; font-size: 0.7rem; padding: 0.05rem 0.4rem; border-radius: 5px; font-weight: 600; }
    .wa-ficha-x { background: none; border: none; font-size: 1.4rem; line-height: 1; color: #9ca3af; cursor: pointer; padding: 0 0.2rem; }
    .wa-ficha-x:hover { color: #ef4444; }
    .wa-ficha-cols { display: flex; flex-wrap: wrap; gap: 0.5rem; padding: 0.75rem 0.85rem; }
    .wa-ficha-datos { flex: 1 1 240px; min-width: 220px; font-size: 0.84rem; color: #374151; line-height: 1.7; }
    .wa-ficha-lbl { color: #9ca3af; font-size: 0.78rem; }
    .wa-ficha-notas { margin-top: 0.35rem; background: #fffbeb; border: 1px solid #fde68a; border-radius: 7px; padding: 0.35rem 0.5rem; font-size: 0.8rem; line-height: 1.4; }
    .wa-ficha-acc { display: flex; flex-wrap: wrap; gap: 0.4rem; margin-top: 0.6rem; }
    .wa-ficha-btn { display: inline-flex; align-items: center; gap: 0.25rem; background: #f3f4f6; border: 1px solid #e5e7eb; color: #374151; border-radius: 8px; padding: 0.35rem 0.6rem; font-size: 0.8rem; font-weight: 600; text-decoration: none; transition: all .12s; }
    .wa-ficha-btn:hover { background: #e5e7eb; }
    .wa-ficha-btn.maps { background: #eff6ff; border-color: #bfdbfe; color: #1d4ed8; }
    .wa-ficha-btn.maps:hover { background: #dbeafe; }
    .wa-ficha-plata { flex: 1 1 300px; min-width: 260px; }
    .wa-ficha-saldo { display: flex; align-items: center; justify-content: space-between; padding: 0.55rem 0.75rem; border-radius: 10px; margin-bottom: 0.6rem; }
    .wa-ficha-saldo.debe { background: #fef2f2; border: 1px solid #fecaca; }
    .wa-ficha-saldo.aldia { background: #f0fdf4; border: 1px solid #bbf7d0; }
    .wa-ficha-saldo-lbl { font-size: 0.82rem; font-weight: 600; color: #6b7280; }
    .wa-ficha-saldo-monto { font-size: 1.25rem; font-weight: 800; }
    .wa-ficha-saldo.debe .wa-ficha-saldo-monto { color: #dc2626; }
    .wa-ficha-saldo.aldia .wa-ficha-saldo-monto { color: #16a34a; }
    .wa-ficha-facs-titulo { font-size: 0.78rem; text-transform: uppercase; letter-spacing: 0.03em; color: #9ca3af; font-weight: 700; margin-bottom: 0.35rem; }
    .wa-ficha-vacio { font-size: 0.84rem; color: #9ca3af; padding: 0.3rem 0; }
    .wa-ficha-facs { display: flex; flex-direction: column; gap: 0.3rem; max-height: 220px; overflow-y: auto; }
    .wa-ficha-fac { display: flex; align-items: center; gap: 0.5rem; padding: 0.4rem 0.55rem; background: #f9fafb; border: 1px solid #eef1f5; border-radius: 8px; text-decoration: none; color: #374151; font-size: 0.82rem; transition: all .12s; }
    .wa-ficha-fac:hover { background: #f1f5f9; border-color: #e2e8f0; }
    .wa-ficha-fac-tipo { background: #e5e7eb; color: #374151; font-size: 0.68rem; font-weight: 700; padding: 0.05rem 0.35rem; border-radius: 4px; min-width: 2rem; text-align: center; }
    .wa-ficha-fac-num { font-weight: 600; }
    .wa-ficha-fac-fecha { color: #9ca3af; font-size: 0.76rem; }
    .wa-ficha-fac-total { margin-left: auto; font-weight: 700; }
    .wa-ficha-fac-estado { font-size: 0.7rem; font-weight: 700; padding: 0.08rem 0.4rem; border-radius: 5px; white-space: nowrap; }
    .wa-ficha-fac-estado.pagada { background: #dcfce7; color: #15803d; }
    .wa-ficha-fac-estado.debe { background: #fee2e2; color: #b91c1c; }
    .wa-ficha-fac-estado.nc { background: #ede9fe; color: #6d28d9; }
    .wa-ficha-fac.hover { background: #eef2ff; border-color: #c7d2fe; }
    /* 2026-08-05: mini vista previa del PDF de la factura al pasar el mouse */
    .wa-ficha-facswrap { position: relative; }
