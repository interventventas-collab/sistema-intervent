@page "/whatsapp"
@page "/whatsapp/chat"
@attribute [Microsoft.AspNetCore.Authorization.Authorize]
@inject Web.Services.ApiClient Api
@inject Web.Services.OperatorService Op
@inject Web.Services.ToastService Toast
@inject Microsoft.AspNetCore.Components.NavigationManager Nav
@inject Microsoft.JSInterop.IJSRuntime JS
@inject Web.Services.AuthService AuthSvc
@inject Web.Services.PresenceService Presence
@inject Web.Services.WaAparienciaService Apariencia
@implements IDisposable

<PageTitle>WhatsApp — Chat</PageTitle>

@* 2026-07-23: solapas del sector WhatsApp unificado (pedido Osmar) — chats + pedidos, todo junto *@
@* 2026-07-29: barra superior rediseñada + cartelito "Línea activa" (para saber SIEMPRE con qué WhatsApp trabajás, ya que va a haber un 2° número) *@
@* 2026-08-05: en modo "una sola conversación" (solo=1) escondemos la barra superior entera:
   no hace falta el selector de líneas ni las solapas, porque se ve un único chat fijado. *@
@* 2026-08-17: PANTALLA COMPLETA (igual que el Mapeo). Esta caja tapa el menú de la izquierda y la
   barra de arriba del sistema, así el chat usa TODO el alto del navegador en vez de una franja.
   Para volver al sistema está el botón "← Volver" de acá abajo.
   z-index BAJO a propósito (200): alcanza para tapar el menú (100) pero deja que los carteles que
   saltan encima (visor de fotos 3000, adjuntar del servidor 1100, reenviar 1100, ficha 2100) sigan
   quedando por arriba, porque se dibujan FUERA de esta caja. *@
<div class="wa-fs">
<div class="wa-topbar" style="@(soloMode ? "display:none;" : "")">
    <div class="wa-tabs-top">
        <button class="wa-volver-sistema" @onclick="VolverAlSistema" title="Volver al sistema (cierra esta pantalla de WhatsApp)">← Volver</button>
        <span class="wa-tab-top active">💬 Chats</span>
        @* 2026-08-27: "Pedidos y configuración" se fue de acá al engranaje ⚙️ de la tira de iconos
           del borde derecho. Osmar casi no lo usa y esta fila le comía alto a la conversación. *@
    </div>
    @* 2026-08-01: interruptor maestro del sonido de avisos (mismo que la campanita del panel flotante) *@
    <button class="wa-sonido-toggle" @onclick="ToggleSonidoMaster"
            title="@(sonidoMasterOn ? "Sonido de avisos ACTIVADO — tocá para silenciar" : "Sonido de avisos SILENCIADO — tocá para activar")">
        @(sonidoMasterOn ? "🔔" : "🔕") <span class="wa-sonido-txt">@(sonidoMasterOn ? "Con sonido" : "Silenciado")</span>
    </button>
    @* 2026-07-29 (Paso 2): el cartelito ahora es un SELECTOR. Tocándolo cambiás de línea o ves todas.
       Con una sola línea conectada muestra ese número y avisa que el 2° aparecerá acá. *@
    <div class="wa-linea-wrap">
        <button class="wa-linea-badge @(LineaActivaTieneNumero ? "on" : "")" @onclick="@(() => showLineaMenu = !showLineaMenu)"
                title="Número de WhatsApp que estás viendo. Tocá para cambiar de línea o ver todas.">
            <i class="wa-linea-icon">📱</i>
            <div class="wa-linea-txt">
                <span class="wa-linea-num">@LineaActivaTexto()</span>
            </div>
            <span class="wa-linea-dot @(LineaActivaTieneNumero ? "on" : "")"></span>
            <i class="wa-linea-caret">▾</i>
        </button>
        @if (showLineaMenu)
        {
            <div class="wa-linea-backdrop" @onclick="@(() => showLineaMenu = false)"></div>
            <div class="wa-linea-menu">
                @{ var _lineas = LineasDetectadas(); }
                @if (_lineas.Count > 1)
                {
                    <button class="wa-linea-opt @(filtroLinea=="" ? "sel" : "")" @onclick="@(() => SeleccionarLinea(""))">
                        <span>📞 Todas las líneas</span>
                        @if (filtroLinea=="") { <span class="wa-linea-check">✓</span> }
                    </button>
                }
                @foreach (var l in _lineas)
                {
                    <div class="wa-linea-row">
                        <button class="wa-linea-opt @(filtroLinea==l.Id ? "sel" : "")" @onclick="@(() => SeleccionarLinea(l.Id))">
                            @if (LineaImg(l.Id) is string _img) { <img src="@_img" class="wa-linea-av" alt="" /> } else { <span class="wa-linea-av-emoji">📱</span> }
                            <span>@LineaNombre(l.Id, l.Numero)</span>
                            @if (filtroLinea==l.Id) { <span class="wa-linea-check">✓</span> }
                        </button>
                        <button class="wa-linea-edit" title="Ponerle nombre e imagen a esta línea" @onclick="@(() => AbrirEditLinea(l.Id, l.Numero))">✏️</button>
                    </div>
                }
                @if (_lineas.Count <= 1)
                {
                    <div class="wa-linea-hint">💡 Cuando conectes el 2° número de WhatsApp va a aparecer acá para elegir con cuál trabajar. Ya está todo listo para ese momento.</div>
                }
                @* 2026-08-31: la LÍNEA POR QR (un celular escaneado, no la API oficial de Meta).
                   Va al final y SEPARADA a propósito. Metida entre las oficiales, en dos semanas
                   nadie se acuerda de que es distinta — y ahí aparece el cruce que hay que evitar:
                   creer que estás escribiendo por una línea cuando estás en la otra.
                   Va en ámbar y con el ícono del QR para que se note sin leer.
                   Es una PANTALLA aparte (/whatsapp-web) porque atrás tiene otro motor: sus
                   mensajes no están en nuestra base, los lee un robot de la pantalla de WhatsApp. *@
                <div style="border-top:1px solid #eef1f5; margin-top:0.25rem; padding-top:0.35rem;">
                    <div style="font-size:0.72rem; color:#94a3b8; padding:0.15rem 0.7rem 0.25rem;">Otra forma de conectarse</div>
                    <button class="wa-linea-opt" style="background:#fef3c7; color:#78350f;"
                            @onclick="@(() => Nav.NavigateTo("/whatsapp-web"))"
                            title="Un teléfono común escaneado por QR. Es otra pantalla: no tiene buscador global, estados, ficha del cliente ni modo Venta.">
                        <span>🔳 @(waQrHayCuenta ? "Línea por QR" : "Conectar un teléfono")</span>
                    </button>
                </div>

                @* 2026-08-15: colores (claro/oscuro por línea) y letra de la pantalla *@
                <button class="wa-linea-opt" style="border-top:1px solid #eef1f5; border-radius:0 0 10px 10px; margin-top:0.25rem;"
                        @onclick="AbrirApariencia" title="Elegir si cada línea se ve clara u oscura, y con qué letra">
                    <span>🎨 Colores y letra</span>
                </button>
            </div>
        }
    </div>
</div>

@* 2026-08-15: la caja del WhatsApp se pinta según la LÍNEA con la que estás trabajando
   (FIJO TRANSRADIO oscuro, FRIKAF claro, etc.) + la letra elegida. Solo esta caja:
   el menú de la izquierda y la barra de arriba del sistema no se tocan. *@
<div class="wa-outer @Apariencia.ClasesPara(LineaParaTema())">
<div class="wa-root @(selectedNumero is null ? "" : "wa-chat-abierto") @(soloMode ? "wa-solo" : "")">
    @if (!soloMode)
    {
    <div class="wa-sidebar">
        @* 2026-08-05: encabezado rediseñado — buscador tipo píldora + botón moderno *@
        <div class="wa-side-header">
            <div class="wa-side-title-row">
                <span class="wa-side-title">💬 Conversaciones</span>
                <span class="wa-side-count" title="Conversaciones que estás viendo / total">@conversacionesFiltradas.Count / @conversaciones.Count</span>
            </div>
            <div class="wa-search-box">
                <span class="wa-search-ico">🔍</span>
                <input class="wa-search-input" placeholder="Buscar contacto…"
                       value="@filtroTexto" @oninput="e => filtroTexto = e.Value?.ToString() ?? string.Empty" />
                @if (!string.IsNullOrEmpty(filtroTexto))
                {
                    <button class="wa-search-clear" @onclick="() => filtroTexto = string.Empty" title="Limpiar búsqueda">×</button>
                }
            </div>
            @* 2026-08-21: BUSCADOR GLOBAL — la misma palabra, pero adentro de los mensajes de
               TODAS las charlas. El buscador de arriba solo mira nombres y números. *@
            @if (filtroTexto.Trim().Length >= 2)
            {
                <button class="wa-bg-btn" @onclick="BuscarEnTodosLosMensajes" disabled="@bgBuscando"
                        title="Buscar esa palabra dentro de los mensajes de todas las conversaciones">
                    @(bgBuscando ? "⏳ Buscando en todos los chats…" : $"🔎 Buscar «{filtroTexto.Trim()}» en los mensajes")
                </button>
            }
            <button class="wa-nueva-btn" @onclick="AbrirNuevaConv" title="Escribirle primero a alguien usando una plantilla aprobada">
                <span class="wa-nueva-ico">✍️</span> Nueva conversación
            </button>
        </div>
        @* 2026-08-05: un solo botón "Todos ▾" que despliega la lista de filtros (antes era una fila
           llena de botones que mareaba). Arranca siempre en "Todos". *@
        <div class="wa-filtro-wrap">
            <button class="wa-filtro-toggle @(filtroRol!="" ? "activo" : "")" @onclick="() => showFiltroMenu = !showFiltroMenu" title="Filtrar las conversaciones">
                <span>@FiltroRolLabel()</span>
                @if (filtroRol=="mios" && MisPendientes() > 0)
                {
                    <span class="wa-mios-badge">@MisPendientes()</span>
                }
                <span class="wa-filtro-caret">▾</span>
            </button>
            @if (filtroRol != "")
            {
                <button class="wa-filtro-clear" title="Ver todas otra vez" @onclick='() => PickFiltro("")'>×</button>
            }
            @if (showFiltroMenu)
            {
                <div class="wa-filtro-backdrop" @onclick="() => showFiltroMenu = false"></div>
                <div class="wa-filtro-menu">
                    <button class="wa-filtro-op @(filtroRol=="" ? "sel" : "")" @onclick='() => PickFiltro("")'>📥 Todos</button>

                    <div class="wa-filtro-grup">Estado de la charla</div>
                    <button class="wa-filtro-op @(filtroRol=="en_curso" ? "sel" : "")" @onclick='() => PickFiltro("en_curso")'>🟡 En curso</button>
                    <button class="wa-filtro-op @(filtroRol=="finalizada" ? "sel" : "")" @onclick='() => PickFiltro("finalizada")'>🟢 Finalizadas</button>
                    @if (!string.IsNullOrEmpty(OperadorActual))
                    {
                        <button class="wa-filtro-op @(filtroRol=="mios" ? "sel" : "")" @onclick='() => PickFiltro("mios")'>
                            🙋 Míos
                            @if (MisPendientes() > 0)
                            {
                                <span class="wa-mios-badge">@MisPendientes()</span>
                            }
                        </button>
                    }

                    <div class="wa-filtro-grup">Tipo de contacto</div>
                    <button class="wa-filtro-op @(filtroRol=="cliente" ? "sel" : "")" @onclick='() => PickFiltro("cliente")'>🛍️ Clientes</button>
                    <button class="wa-filtro-op @(filtroRol=="empleado" ? "sel" : "")" @onclick='() => PickFiltro("empleado")'>👷 Empleados</button>
                    <button class="wa-filtro-op @(filtroRol=="hermano" ? "sel" : "")" @onclick='() => PickFiltro("hermano")'>👨‍👦 Hermanos</button>
                    <button class="wa-filtro-op @(filtroRol=="alquiler" ? "sel" : "")" @onclick='() => PickFiltro("alquiler")'>🎪 Alquiler</button>
                    <button class="wa-filtro-op @(filtroRol=="cafe" ? "sel" : "")" @onclick='() => PickFiltro("cafe")'>☕ Café</button>
                    <button class="wa-filtro-op @(filtroRol=="meli" ? "sel" : "")" @onclick='() => PickFiltro("meli")'>🛒 MELI</button>
                    <button class="wa-filtro-op @(filtroRol=="sin" ? "sel" : "")" @onclick='() => PickFiltro("sin")' title="Charlas de gente sin tipo asignado">❓ Sin asignar</button>
                    <button class="wa-filtro-op @(filtroRol=="pedido" ? "sel" : "")" @onclick='() => PickFiltro("pedido")' title="Charlas donde el último mensaje parece un pedido">📋 Pedidos</button>

                    <div class="wa-filtro-grup">Guardadas</div>
                    <button class="wa-filtro-op @(filtroRol=="archivado" ? "sel" : "")" @onclick='() => PickFiltro("archivado")' title="Charlas que archivaste. Vuelven solas al listado si el cliente escribe de nuevo.">🗂️ Archivados</button>
                </div>
            }
        </div>
        @* 2026-08-05: los chips de línea/cuenta que estaban acá se sacaron — hacían lo MISMO que el
           selector "LÍNEA" de la barra superior (ambos usan filtroLinea). Estaba duplicado al pedo.
           Queda solo el cartelito "Viendo solo: X" de abajo como aviso + atajo para volver a todas. *@
        @if (!string.IsNullOrEmpty(filtroLinea) && LineasDetectadas().FirstOrDefault(x => x.Id == filtroLinea) is var lf && lf.Numero != null)
        {
            <div class="wa-linea-activa-chip">
                @if (LineaImg(lf.Id) is string _imv) { <img src="@_imv" class="wa-linea-av-xs" alt="" /> } else { <span>📱</span> }
                Viendo solo: <b>@LineaNombre(lf.Id, lf.Numero)</b>
                <button class="wa-linea-activa-x" @onclick='() => SeleccionarLinea("")' title="Ver todas las líneas">×</button>
            </div>
        }
        <div class="wa-conv-list">
            @if (bgAbierto)
            {
                <div class="wa-bg-head">
                    <button class="wa-bg-volver" @onclick="CerrarBusquedaGlobal" title="Volver al listado de conversaciones">← Conversaciones</button>
                    <span class="wa-bg-cuenta">
                        @if (bgResultado is null) { <span>Buscando…</span> }
                        else if (bgResultado.Total == 0) { <span>Sin resultados</span> }
                        else { <span>@bgResultado.Total mensaje@(bgResultado.Total == 1 ? "" : "s")</span> }
                    </span>
                </div>
                <div class="wa-bg-que">Buscaste: <b>@bgTexto</b></div>
                @if (bgResultado is not null && bgResultado.Tope)
                {
                    <div class="wa-bg-aviso">Son muchos: te muestro los @bgResultado.Hits.Count más nuevos. Si no está, agregá otra palabra.</div>
                }
                @if (bgResultado is not null && bgResultado.Total == 0)
                {
                    <div class="wa-bg-vacio">No encontré esa palabra en ningún mensaje.</div>
                }
                else if (bgResultado is not null)
                {
                    @foreach (var h in bgResultado.Hits)
                    {
                        <button class="wa-bg-hit" @onclick="() => AbrirHitGlobal(h)" title="Abrir esa charla en ese mensaje">
                            <span class="wa-bg-hit-l1">
                                <span class="wa-bg-hit-nom">@h.Nombre</span>
                                <span class="wa-bg-hit-fec">@h.Fecha.ToArTime().ToString("dd/MM/yy HH:mm")</span>
                            </span>
                            <span class="wa-bg-hit-txt">
                                <span class="wa-bg-hit-dir" title="@(h.Direccion == "INCOMING" ? "Lo escribió el cliente" : "Lo escribimos nosotros")">@(h.Direccion == "INCOMING" ? "⬅" : "➡")</span>
                                @h.Extracto
                            </span>
                            @if (!string.IsNullOrWhiteSpace(h.LineaNombre))
                            {
                                <span class="wa-bg-hit-linea">@h.LineaNombre</span>
                            }
                        </button>
                    }
                }
            }
            else if (loadingConv)
            {
                <div style="padding:1rem; color:#9ca3af;">Cargando…</div>
            }
            else if (conversaciones.Count == 0)
            {
                <div style="padding:1rem; color:#9ca3af; text-align:center;">
                    <p>📭 Sin conversaciones todavía.</p>
                    <p style="font-size:0.8rem;">Cuando alguien le escriba al WhatsApp de la empresa, la conversación aparece acá solita.</p>
                </div>
            }
            else if (conversacionesFiltradas.Count == 0)
            {
                <div style="padding:1rem; color:#9ca3af; text-align:center; font-size:0.85rem;">Sin resultados con este filtro.</div>
            }
            else
            {
                @foreach (var c in conversacionesFiltradas)
                {
                    <div class="wa-conv-item @(selectedNumero == c.Numero && selectedLinea == c.Linea ? "active" : "") @(EsPasadaAMi(c) ? "wa-conv-pasada" : "") @(c.Fijado ? "wa-conv-fijado" : "") @(c.UltimoDireccion == "INCOMING" ? "sin-responder" : "")" @onclick="() => SelectConv(c.Numero, c.Linea)">
                        @* 2026-08-06: PRESENCIA — avatarcito(s) del otro agente que tiene abierta esta fila. *@
                        @if (OtrosViewers(ConvIdDe(c.Numero, c.Linea)) is { Count: > 0 } _cvOtros)
                        {
                            <div class="wa-conv-presence" title="@(string.Join(", ", _cvOtros.Select(v => v.UserName)) + " está viendo este chat")">
                                @foreach (var v in _cvOtros.Take(3))
                                {
                                    <span class="wa-conv-presence-av @(v.IsTyping ? "typing" : "")">@(v.UserName.Length > 0 ? v.UserName.Substring(0, 1).ToUpper() : "?")</span>
                                }
                            </div>
                        }
                        @* 2026-08-27: el redondel del avatar era de un color distinto por cada nombre, al azar.
                           Veinte filas = veinte colores que no querían decir nada. Ahora es gris con la inicial,
                           y la CATEGORÍA (que sí significa algo) baja al renglón de abajo como etiqueta. *@
                        <div class="wa-avatar-col">
                            <div class="wa-avatar-circle">
                                <div class="wa-avatar">@AvatarLetra(c)</div>
                            </div>
                            @if (!string.IsNullOrEmpty(c.Rol))
                            {
                                <span class="wa-rol-tag @RolClase(c.Rol)" title="Categoría del contacto">@RolLabel(c.Rol)</span>
                            }
                        </div>
                        <div class="wa-conv-body">
                            <div class="wa-conv-row1">
                                <span class="wa-conv-name">
                                    @if (c.Canal == "INSTAGRAM")
                                    {
                                        @* 2026-07-31: Instagram → chip "IG" chico + el @usuario grande como nombre *@
                                        <span class="wa-ig-tag" title="Mensaje directo de Instagram">IG</span>
                                        <span>@MostrarNombreIg(c)</span>
                                    }
                                    else
                                    {
                                        @(c.NombrePerfil ?? PrettyNumero(c.Numero))
                                    }
                                    @* 2026-08-05: la categoría ahora se ve como emojito pisando el avatar (más copado) *@
                                    @* etiqueta de la CUENTA a la que escribió (con 2+ cuentas). Para IG el nombre grande
                                       es el remitente, así que acá va la cuenta (@frikaf_cafe) para saber por dónde entró. *@
                                    @if (LineasDetectadas().Count > 1 && !string.IsNullOrEmpty(c.LineaNumero))
                                    {
                                        <span class="wa-cuenta-tag" title="Cuenta a la que te escribió">@if (LineaImg(c.Linea) is string _imc) { <img src="@_imc" class="wa-linea-av-xs" alt="" /> }@LineaNombre(c.Linea, c.LineaNumero)</span>
                                    }
                                </span>
                                <span class="wa-conv-hora">@FormatHora(c.UltimoAt)</span>
                            </div>
                            <div class="wa-conv-row2">
                                <span class="wa-conv-last">
                                    @if (EsPedido(c.UltimoMensaje))
                                    {
                                        <span class="wa-pedido-chip">📋 PEDIDO</span>
                                    }
                                    @(c.UltimoDireccion == "OUTGOING" ? "✓ " : "")@TruncateText(c.UltimoMensaje, 45)
                                </span>
                                @* 2026-07-24: el badge verde se enciende SOLO si hay algo sin responder
                                   (último mensaje del cliente). Si ya respondimos, muestra "✓ leído" apagado. *@
                                @* 2026-08-27: antes acá había un cartel verde "nuevo" y, en las leídas, un
                                   "✓ respondido" gris en TODAS las filas. Ahora se hace como WhatsApp: sin
                                   responder = nombre y texto en negro + puntito verde; ya respondida = todo
                                   apagado y nada más. El "✓" del principio del texto ya dice que contestaste. *@
                                @if (c.UltimoDireccion == "INCOMING")
                                {
                                    <span class="wa-conv-punto" title="Sin responder"></span>
                                }
                            </div>
                            @* 2026-08-27: RENGLÓN 3 — categoría, estado y responsable, todo en una línea chiquita.
                               Antes eran tres cartelitos de colores (naranja el estado, verde el operador y la
                               categoría abajo del avatar). Ahora la ÚNICA con color es la categoría, porque es
                               una clasificación de verdad y te sirve para barrer la lista con el ojo. El estado
                               queda como un puntito y el responsable como texto gris. *@
                            @if (c.Estado != "nueva" || !string.IsNullOrEmpty(c.AsignadoOperador))
                            {
                                <div class="wa-conv-row3">
                                    @if (c.Estado != "nueva")
                                    {
                                        <span class="wa-conv-meta"><span class="wa-conv-meta-dot" style="background:@EstadoColor(c.Estado);"></span>@EstadoLabel(c.Estado)</span>
                                    }
                                    @if (!string.IsNullOrEmpty(c.AsignadoOperador))
                                    {
                                        @if (EsPasadaAMi(c))
                                        {
                                            <span class="wa-pasada-chip" title="@($"Te la pasó {c.AsignadoPor}")">🔔 Te la pasó @c.AsignadoPor</span>
                                        }
                                        else
                                        {
                                            <span class="wa-conv-meta" title="@($"Responsable: {c.AsignadoOperador}")">@c.AsignadoOperador</span>
                                        }
                                    }
                                </div>
                            }
                        </div>
                        @* 2026-08-05: poner la categoría directo desde la lista, sin abrir el chat *@
                        <button class="wa-conv-rolbtn" title="Poner categoría (Cliente / Empleado / …)" @onclick:stopPropagation="true" @onclick="() => rolMenuConv = c">🏷️</button>
                        @* 2026-08-19: fijar / sacar de fijados (hasta 5), como el chinche de WhatsApp *@
                        <button class="wa-conv-pinbtn @(c.Fijado ? "on" : "")"
                                title="@(c.Fijado ? "Sacar de los fijados" : $"Fijar arriba de todo (hasta {MaxFijados})")"
                                @onclick:stopPropagation="true" @onclick="() => FijarConv(c)">📌</button>
                    </div>
                }
            }
        </div>
        @* menú de categoría rápida (se abre con el 🏷️ de cada conversación) *@
        @if (rolMenuConv is not null)
        {
            <div class="wa-rolmenu-backdrop" @onclick="() => rolMenuConv = null"></div>
            <div class="wa-rolmenu">
                <div class="wa-rolmenu-title">🏷️ Categoría de <b>@MostrarNombre(rolMenuConv)</b></div>
                <button class="wa-rolmenu-op" @onclick='() => AsignarRolRapido("cliente")'>🛍️ Cliente</button>
                <button class="wa-rolmenu-op" @onclick='() => AsignarRolRapido("empleado")'>👷 Empleado</button>
                <button class="wa-rolmenu-op" @onclick='() => AsignarRolRapido("hermano")'>👨‍👦 Hermano</button>
                <button class="wa-rolmenu-op" @onclick='() => AsignarRolRapido("proveedor")'>🚚 Proveedor</button>
                <button class="wa-rolmenu-op" @onclick='() => AsignarRolRapido("alquiler")'>🎪 Alquiler</button>
                <button class="wa-rolmenu-op" @onclick='() => AsignarRolRapido("cafe")'>☕ Café</button>
                <button class="wa-rolmenu-op" @onclick='() => AsignarRolRapido("meli")'>🛒 MELI</button>
                <button class="wa-rolmenu-op" @onclick='() => AsignarRolRapido("otro")'>🏷️ Otro</button>
                <button class="wa-rolmenu-cancel" @onclick="() => rolMenuConv = null">Cancelar</button>
            </div>
        }
    </div>
    } @* fin @if (!soloMode) — lista lateral de conversaciones *@

@* 2026-08-17: el chat + el PANEL DERECHO viven juntos en esta caja. El panel es el patrón de
   todas las bandejas que trabajan con la API de WhatsApp (Chatwoot, respond.io, Zendesk):
   los datos y las acciones del contacto van a la derecha, no en filas arriba que le roban
   alto a la conversación. La tira de iconos del borde lo pliega y lo vuelve a abrir. *@
<div class="wa-thread-wrap">
    <div class="wa-thread">
        @if (selectedNumero is null)
        {
            @* 2026-08-03: el formulario de NUEVA CONVERSACIÓN vive acá, siempre a mano (ya no es una ventanita) *@
            <div class="wa-nv-panel">
                <div class="wa-nv-card">
                    <div class="wa-nv-head">
                        <span class="wa-nv-head-ico">@(LineaEsInstagram(filtroLinea) ? "📷" : "✍️")</span>
                        <div>
                            <div class="wa-nv-title">@(LineaEsInstagram(filtroLinea) ? "Instagram" : "Nueva conversación")</div>
                            <div class="wa-nv-sub">@(LineaEsInstagram(filtroLinea) ? "En Instagram solo respondés a quien te escribió" : "Escribile primero a alguien con una plantilla aprobada")</div>
                        </div>
                    </div>

                    @* 2026-08-05: en Instagram NO se puede escribir primero (no hay plantillas). Solo se responde. *@
                    @if (LineaEsInstagram(filtroLinea))
                    {
                        <div class="wa-nv-info" style="background:#fdf2f8; border-color:#f9a8d4; color:#9d174d;">
                            📷 Estás parado en <b>Instagram (@LineaNombre(filtroLinea, null))</b>. Acá <b>no se puede escribir primero</b>: en Instagram solo podés <b>responder</b> a quien te haya mandado un mensaje directo (y dentro de las 24hs). Elegí una charla de la izquierda para responderle.
                        </div>
                    }
                    else
                    {
                    <div class="wa-nv-info">💡 Para escribirle <b>primero</b> a alguien (que no te escribió en las últimas 24h) WhatsApp pide una <b>plantilla aprobada</b>. Cuando te responde, ya le escribís libre.</div>

                    @if (nvCargando)
                    {
                        <div class="wa-nv-muted" style="text-align:center; padding:1rem;">Cargando plantillas…</div>
                    }
                    else if (nvPlantillas.Count == 0)
                    {
                        <div style="text-align:center; padding:1rem; color:#b91c1c; font-size:0.9rem;">No hay plantillas aprobadas disponibles. Revisá que la cuenta de WhatsApp esté configurada.</div>
                    }
                    else
                    {
                        @if (nvLineas.Count > 1)
                        {
                            <div class="wa-nv-field">
                                <label class="wa-nv-label">Enviar desde la línea</label>
                                <select class="wa-nv-input" @bind="nvLineaPhoneId">
                                    @* La línea elegida queda primera. Cada opción muestra el nombre (ej "FRIKAF by INTERVENT") + el número *@
                                    @foreach (var l in nvLineas.OrderByDescending(x => x.PhoneId == nvLineaPhoneId))
                                    {
                                        var esIg = (l.Numero ?? "").StartsWith("IG ", StringComparison.Ordinal);
                                        var nom = LineaNombre(l.PhoneId, l.Numero);
                                        var pretty = PrettyNumero(l.Numero);
                                        var extra = (!esIg && nom != pretty) ? $" · {pretty}" : "";
                                        <option value="@l.PhoneId" @key="l.PhoneId">@(esIg ? "📷 " : "📱 ")@nom@extra</option>
                                    }
                                </select>
                            </div>
                        }

                        @* buscador estilo WhatsApp: una sola casilla (nombre o número) *@
                        @if (nvClienteSeleccionado != null)
                        {
                            <div class="wa-nv-chip">
                                <div class="wa-nv-avatar" style="background:#25d366;">@InicialDe(nvClienteSeleccionado)</div>
                                <div style="flex:1; min-width:0; line-height:1.25;">
                                    <div style="font-weight:700; color:#111; overflow:hidden; text-overflow:ellipsis; white-space:nowrap;">Le vas a escribir a @nvClienteSeleccionado</div>
                                    <div style="font-size:0.85rem; color:#16a34a;">@BonitoNumero(nvNumero)</div>
                                </div>
                                <button type="button" class="wa-nv-btn-ghost" @onclick="LimpiarNvCliente" title="Elegir otro contacto o número">✏️ Cambiar</button>
                            </div>
                        }
                        else
                        {
                            <div class="wa-nv-field" style="position:relative;">
                                <label class="wa-nv-label">¿A quién le escribís? <span style="color:#dc2626;">*</span></label>
                                <input class="wa-nv-input wa-nv-search" placeholder="🔍 Escribí un nombre o un número…"
                                       @bind="nvClienteQuery" @bind:event="oninput" @onkeyup="BuscarNvClientes" />
                                <span class="wa-nv-hint">Buscá por nombre (clientes, WhatsApp, MercadoLibre) o escribí el número: característica SIN el 0 y número SIN el 15 (ej 1165387009). El 54 y el 9 los pone el sistema. Del exterior, con + y su país (ej +34643013190).</span>

                                @if (nvBuscandoCliente)
                                {
                                    <div class="wa-nv-muted">Buscando…</div>
                                }
                                @{ var directo = NvNumeroDirecto(); }
                                @if (directo != null || nvClienteResultados.Count > 0)
                                {
                                    <div class="wa-nv-results">
                                        @if (directo != null)
                                        {
                                            @* 2026-08-22: mostramos el número YA CORREGIDO (el que se va a usar de verdad),
                                               no lo tipeado en crudo: antes escribir "1165387009" mostraba "+1165387009" y
                                               parecía un número de otro país. *@
                                            var directoFinal = NumeroWaFinal(nvClienteQuery);
                                            var avisoNum = AvisoNumero(nvClienteQuery, directoFinal);
                                            <button type="button" class="wa-nv-item" @onclick="() => UsarNumeroDirecto(directoFinal)">
                                                <div class="wa-nv-avatar" style="background:#2563eb;">📱</div>
                                                <div style="flex:1; min-width:0;">
                                                    <div style="font-weight:700; color:#111;">Enviar a este número nuevo</div>
                                                    <div style="font-size:0.85rem; color:#2563eb;">@BonitoNumero(directoFinal)</div>
                                                    @if (avisoNum != null)
                                                    {
                                                        <div class="wa-nv-aviso">@avisoNum</div>
                                                    }
                                                </div>
                                            </button>
                                        }
                                        @foreach (var cli in nvClienteResultados)
                                        {
                                            <button type="button" class="wa-nv-item" @onclick="() => SeleccionarNvCliente(cli)">
                                                <div class="wa-nv-avatar">@InicialDe(cli.Nombre)</div>
                                                <div style="flex:1; min-width:0;">
                                                    <div style="font-weight:600; color:#111; overflow:hidden; text-overflow:ellipsis; white-space:nowrap;">@cli.Nombre</div>
                                                    <div style="font-size:0.85rem; color:#6b7280;">@BonitoNumero(cli.Numero)</div>
                                                </div>
                                                <span class="wa-nv-origen">@OrigenLindo(cli.Origen)</span>
                                            </button>
                                        }
                                    </div>
                                }
                                else if (!string.IsNullOrWhiteSpace(nvClienteQuery) && nvClienteQuery.Length >= 2 && !nvBuscandoCliente)
                                {
                                    <div class="wa-nv-muted">Sin contactos para esa búsqueda. Si es un número nuevo, escribilo completo con el código de país (54) y el 9 de celular.</div>
                                }
                            </div>
                        }

                        <div class="wa-nv-field">
                            <label class="wa-nv-label">Plantilla <span style="color:#dc2626;">*</span></label>
                            <select class="wa-nv-input" value="@nvPlantillaName" @onchange="OnPlantillaChange">
                                <option value="">— Elegí una plantilla —</option>
                                @foreach (var p in nvPlantillas)
                                {
                                    <option value="@p.Name">@NombrePlantillaLindo(p.Name) (@p.Category.ToLower())</option>
                                }
                            </select>
                        </div>

                        @if (PlantillaSel() is {} pSel)
                        {
                            @if (pSel.VariableCount > 0)
                            {
                                <div class="wa-nv-field">
                                    <label class="wa-nv-label">Completá los datos de la plantilla</label>
                                    @for (int i = 0; i < pSel.VariableCount; i++)
                                    {
                                        var idx = i;
                                        <input class="wa-nv-input" style="margin-bottom:0.4rem;"
                                               placeholder="@PlaceholderVariable(idx)"
                                               value="@(idx < nvVariables.Count ? nvVariables[idx] : "")"
                                               @oninput="e => SetVariable(idx, e.Value?.ToString() ?? string.Empty)" />
                                    }
                                </div>
                            }

                            <div class="wa-nv-field">
                                <label class="wa-nv-label">Vista previa del mensaje</label>
                                <div class="wa-nv-preview">@PreviewTexto()</div>
                            </div>
                        }

                        <div class="wa-nv-actions">
                            <button class="wa-nv-btn-ghost" @onclick="AbrirNuevaConv" title="Limpiar y empezar de nuevo">🧹 Limpiar</button>
                            <button class="wa-nv-send" disabled="@(nvEnviando || PlantillaSel() == null || string.IsNullOrWhiteSpace(nvNumero))" @onclick="EnviarNuevaConv">
                                @(nvEnviando ? "Enviando…" : "📨 Enviar mensaje")
                            </button>
                        </div>
                    }
                    }
                </div>
            </div>
        }
        else
        {
            <div class="wa-thread-header">
                @* 2026-08-02: flecha para volver a la lista (solo celular) *@
                <button class="wa-volver-btn" @onclick="VolverALista" title="Volver a la lista de chats">←</button>
                @* 2026-08-05: avatar con la categoría encima; se toca para cambiarla al toque *@
                <button class="wa-avatar-col wa-avatar-btn" @onclick="() => rolMenuConv = SelectedConv()" title="Categoría del contacto — tocá para cambiarla">
                    <div class="wa-avatar-circle">
                        <div class="wa-avatar" style="@(AvatarColor(SelectedConv()))">@AvatarLetra(SelectedConv())</div>
                        <span class="wa-avatar-rol wa-avatar-rol-lg">@(RolEmoji(SelectedConv()?.Rol) is string _hre && _hre != "" ? _hre : "🏷️")</span>
                    </div>
                    <span class="wa-avatar-rol-label">@RolLabel(SelectedConv()?.Rol)</span>
                </button>
                @* 2026-08-31: el 👁️ estaba enterrado en el ⋮ y es de lo que más se usa. Va acá,
                   pegado al circulito, a un toque. Solo si el chat tiene cliente vinculado. *@
                @if (SelectedConv()?.ClienteId is int)
                {
                    <button class="wa-hdr-ojo @(mostrarFichaCliente ? "on" : "")" @onclick="ToggleFichaCliente"
                            title="Ficha del cliente: saldo, últimas facturas y ubicación">👁️</button>
                }
                <div style="flex:1; min-width:0;">
                    @* 2026-08-27: RENGLÓN 1 del encabezado. El nombre tiene un ancho FIJO y se corta con
                       puntitos: así los iconitos caen SIEMPRE en el mismo lugar, no importa si el contacto
                       se llama "Ana" o "Distribuidora San Martín de los Andes S.R.L.". Nada baila al
                       cambiar de chat. El nombre completo sale en el globito de ayuda. *@
                    <div class="wa-hdr-l1">
                        <span class="wa-hdr-nombre" title="@(MostrarNombre(SelectedConv()))">@(MostrarNombre(SelectedConv()))</span>
                        @* 2026-08-27: la razón social y la categoría van como TEXTO gris al lado del nombre.
                           Antes eran dos cartelitos de colores más (verde el cliente, y la categoría abajo del
                           avatar). Osmar: "tanto color marea". Se leen igual y no gritan.
                           Con VARIAS razones sociales esto se convierte en los cartelitos con tilde: ahí el
                           color SÍ hace falta, porque tenés que elegir con cuál facturás. *@
                        @if (VariasRazones)
                        {
                            <span class="wa-hdr-sep">·</span>
                            <span class="wa-razones" title="Este teléfono factura a varias razones sociales. Tocá la que estés usando ahora: la ficha, la venta y el comprobante salen a nombre de ésa.">
                                <span class="wa-razones-t">Facturo a:</span>
                                @foreach (var rs in RazonesSociales)
                                {
                                    <button class="wa-razon @(EsRazonActiva(rs.Id) ? "on" : "")"
                                            @onclick="() => ElegirRazon(rs.Id)"
                                            disabled="@cambiandoRazon"
                                            title="@(EsRazonActiva(rs.Id) ? $"Estás trabajando con {rs.Nombre}" : $"Pasar a {rs.Nombre}")">
                                        <span class="wa-razon-tilde">@(EsRazonActiva(rs.Id) ? "✓" : "")</span>
                                        <span class="wa-razon-nom">@rs.Nombre</span>
                                    </button>
                                }
                            </span>
                        }
                        else if (SelectedConv()?.ClienteNombre is string _cln && !string.IsNullOrWhiteSpace(_cln))
                        {
                            <span class="wa-hdr-sep">·</span>
                            <span class="wa-hdr-sub" title="Razón social a la que le facturás">@_cln</span>
                        }
                        @if (RolLabel(SelectedConv()?.Rol) is string _rl && !string.IsNullOrWhiteSpace(_rl))
                        {
                            <span class="wa-hdr-sep">·</span>
                            <button class="wa-hdr-rol" @onclick="() => rolMenuConv = SelectedConv()" title="Categoría del contacto — tocá para cambiarla">@_rl</button>
                        }

                        @* El hueco de la derecha estaba desaprovechado: ahí van ESTADO y RESPONSABLE, que
                           es lo que Osmar toca todo el día. Cartelitos de color: el color ya te dice cómo
                           viene la charla sin leer. Se tocan y se abre la listita. *@
                        <span class="wa-hdr-espacio"></span>
                        @{ var _estHdr = SelectedConv()?.Archivado == true ? "archivado" : (SelectedConv()?.Estado ?? "nueva"); }
                        @* 2026-08-27: el estado dejó de ser un cartelito de color. Ahora es texto con un
                           puntito: el color queda en 8 píxeles en vez de en todo el borde y el texto. *@
                        <span class="wa-hdr-menu-wrap">
                            <button class="wa-hdr-pill"
                                    @onclick="@(() => { showEstadoMenu = !showEstadoMenu; showPasarMenu = false; })"
                                    title="Estado de esta conversación — tocá para cambiarlo">
                                <span class="wa-hdr-dot" style="background:@EstadoColor(_estHdr);"></span>@EstadoLabel(_estHdr)<span class="wa-hdr-pill-caret">▾</span>
                            </button>
                            @if (showEstadoMenu)
                            {
                                <div class="wa-hdr-menu-back" @onclick="@(() => showEstadoMenu = false)"></div>
                                <div class="wa-hdr-menu">
                                    @foreach (var e in EstadosLista)
                                    {
                                        <button class="wa-hdr-menu-op @(_estHdr == e.Key ? "sel" : "")" @onclick="() => ElegirEstadoHdr(e.Key)">
                                            <span class="wa-hdr-menu-dot" style="background:@EstadoColor(e.Key);"></span>@e.Label
                                            @if (_estHdr == e.Key) { <span class="wa-hdr-menu-tick">✓</span> }
                                        </button>
                                    }
                                    <button class="wa-hdr-menu-op @(_estHdr == "archivado" ? "sel" : "")" @onclick="@(() => ElegirEstadoHdr("archivado"))">
                                        <span class="wa-hdr-menu-dot" style="background:@EstadoColor("archivado");"></span>🗂️ Archivado
                                        @if (_estHdr == "archivado") { <span class="wa-hdr-menu-tick">✓</span> }
                                    </button>
                                </div>
                            }
                        </span>
                        <span class="wa-hdr-menu-wrap">
                            @{ var _opHdr = SelectedConv()?.AsignadoOperador; }
                            <button class="wa-hdr-pill @(string.IsNullOrEmpty(_opHdr) ? "vacia" : "")"
                                    @onclick="@(() => { showPasarMenu = !showPasarMenu; showEstadoMenu = false; })"
                                    title="Quién se está ocupando de esta charla — tocá para pasársela a otro">
                                @(string.IsNullOrEmpty(_opHdr) ? "Sin asignar" : _opHdr)<span class="wa-hdr-pill-caret">▾</span>
                            </button>
                            @if (showPasarMenu)
                            {
                                <div class="wa-hdr-menu-back" @onclick="@(() => showPasarMenu = false)"></div>
                                <div class="wa-hdr-menu">
                                    <button class="wa-hdr-menu-op @(string.IsNullOrEmpty(_opHdr) ? "sel" : "")" @onclick="@(() => ElegirPasarHdr(""))">
                                        <span class="wa-hdr-menu-dot" style="background:#cbd5e1;"></span>Sin asignar
                                        @if (string.IsNullOrEmpty(_opHdr)) { <span class="wa-hdr-menu-tick">✓</span> }
                                    </button>
                                    @foreach (var op in OperadoresPasar)
                                    {
                                        <button class="wa-hdr-menu-op @(string.Equals(_opHdr, op, StringComparison.OrdinalIgnoreCase) ? "sel" : "")" @onclick="() => ElegirPasarHdr(op)">
                                            <span class="wa-hdr-menu-dot" style="background:@OperadorColor(op);"></span>@op
                                            @if (string.Equals(_opHdr, op, StringComparison.OrdinalIgnoreCase)) { <span class="wa-hdr-menu-tick">✓</span> }
                                        </button>
                                    }
                                </div>
                            }
                        </span>
                        @* 2026-08-20: lupa para buscar una palabra DENTRO de esta charla. *@
                        <button class="wa-busc-lupa-btn @(buscadorAbierto ? "activo" : "")" @onclick="ToggleBuscador"
                                title="Buscar una palabra en esta charla">🔍</button>
                        @* 2026-08-27: los ⋮. Acá adentro va lo del contacto, que se usa de vez en cuando y
                           afuera eran cuatro iconitos más peleando por atención. La lupa se queda afuera
                           porque se usa en plena charla. *@
                        <span class="wa-hdr-menu-wrap">
                            <button class="wa-hdr-mas" @onclick="@(() => { showMasMenu = !showMasMenu; showEstadoMenu = false; showPasarMenu = false; })"
                                    title="Más cosas de este contacto">⋮</button>
                            @if (showMasMenu)
                            {
                                <div class="wa-hdr-menu-back" @onclick="@(() => showMasMenu = false)"></div>
                                <div class="wa-hdr-menu">
                                    @if (!EstaEnContactos(selectedNumero))
                                    {
                                        <button class="wa-hdr-menu-op" @onclick="@(() => { showMasMenu = false; AbrirAsignarContacto(); })">➕ Asignar contacto</button>
                                    }
                                    else
                                    {
                                        <button class="wa-hdr-menu-op" @onclick="@(() => { showMasMenu = false; AbrirEditarContacto(); })">✏️ Editar contacto</button>
                                    }
                                    <button class="wa-hdr-menu-op" @onclick="@(() => { showMasMenu = false; AbrirVincularCliente(); })">
                                        @(SelectedConv()?.ClienteId is null ? "🔗 Vincular cliente" : "➕ Sumar otra razón social")
                                    </button>
                                    @if (SelectedConv()?.ClienteId is int _cidm)
                                    {
                                        @* 2026-08-31: "Ver ficha del cliente" se fue de acá: ahora es el 👁️
                                           fijo al lado del avatar. Estaba muy escondido para lo que se usa. *@
                                        <a class="wa-hdr-menu-op" href="/cafe/clientes?edit=@_cidm" target="_blank" @onclick="@(() => showMasMenu = false)">📂 Abrir ficha completa ↗</a>
                                    }
                                    <button class="wa-hdr-menu-op" @onclick="@(() => { showMasMenu = false; AbrirCorregirNumero(); })">✏️ Corregir el número</button>
                                    @* 2026-08-28: sumar/sacar este chat de los que ve Depósito. Antes la lista
                                       estaba escrita en el código y había que tocar el programa para agregar uno. *@
                                    @if (!esDeposito)
                                    {
                                        <button class="wa-hdr-menu-op" disabled="@guardandoChatDep"
                                                @onclick="@(() => { showMasMenu = false; _ = ToggleChatDeposito(); })"
                                                title="Depósito solo ve los chats que le asignes acá">
                                            @(EsChatVisibleDeposito ? "👷 Sacarle este chat a Depósito" : "👷 Que Depósito vea este chat")
                                        </button>
                                    }
                                </div>
                            }
                        </span>
                    </div>
                    <div class="wa-hdr-l2">
                        <span>@PrettyNumero(selectedNumero)</span>
                        <button class="wa-num-edit" @onclick="AbrirCorregirNumero" title="Corregir el número de este chat (si quedó mal cargado)">✏️</button>
                        @* 2026-08-27: el nombre de la línea, en gris. Antes era un cartelito lila arriba. *@
                        @if (SelectedConv()?.Linea is string _lh2)
                        {
                            <span class="wa-hdr-sep">·</span>
                            <span class="wa-hdr-sub" title="Esta conversación es de tu línea @LineaNombre(_lh2, SelectedConv()?.LineaNumero)">@LineaNombre(_lh2, SelectedConv()?.LineaNumero)</span>
                        }

                        @* 2026-08-24: DIRECCIÓN y DEUDA siempre a la vista. Antes había que abrir la ficha 👁️
                           para verlas, y son las dos cosas que más se preguntan en plena charla: a dónde se le
                           lleva y si debe plata. Salen de la misma ficha del cliente (mismo cálculo de saldo que
                           "¿Quién me debe?"), que ahora se carga sola al abrir el chat. Mientras carga no se
                           muestra nada, para que la barra no salte. Solo en la compu: el celular queda igual. *@
                        @if (FichaDelChat() is ApiClient.FichaChatDto fh)
                        {
                            @if (DireccionCorta(fh) is string dirh)
                            {
                                <span class="wa-hdr-sep">·</span>
                                @if (!string.IsNullOrWhiteSpace(fh.MapeoLink))
                                {
                                    <a href="@fh.MapeoLink" target="_blank" class="wa-hdr-dir" title="Dirección de @fh.Nombre: @dirh (tocala para abrirla en el mapa)"><span class="wa-hdr-txt">@dirh</span></a>
                                }
                                else
                                {
                                    <span class="wa-hdr-sub" title="Dirección de @fh.Nombre: @dirh"><span class="wa-hdr-txt">@dirh</span></span>
                                }
                            }
                            <span class="wa-hdr-sep">·</span>
                            @* 2026-08-27: el saldo dejó de ser un cartelito. Rojo SOLO si debe: al día y a
                               favor van en gris, porque no son una alarma y el verde sumaba ruido. *@
                            <button class="wa-hdr-saldo @(fh.Saldo > 0.01m ? "debe" : "")" @onclick="ToggleFichaCliente" title="@SaldoTitulo(fh)">
                                @SaldoTextoPlano(fh.Saldo)
                            </button>
                        }
                        @* 2026-08-27: LA NOTA, siempre a la vista (pedido de Osmar). Antes había que abrir
                           el panel de la derecha, escribirla y apretar Guardar. Ahora se escribe acá y se
                           guarda sola al salir del campo — solo pega al servidor si de verdad cambió. *@
                        <span class="wa-hdr-sep">·</span>
                        <span class="wa-hdr-nota" title="Nota de esta conversación — se guarda sola al salir del campo">
                            <input class="wa-hdr-nota-inp @(string.IsNullOrWhiteSpace(asignarNota) ? "vacia" : "")"
                                   placeholder="+ nota" maxlength="300"
                                   @bind="asignarNota" @bind:event="oninput" @onblur="GuardarNotaAlSalir" />
                            @if (guardandoNota) { <span class="wa-hdr-nota-est">⏳</span> }
                            else if (NotaSinGuardar) { <span class="wa-hdr-nota-est pend" title="Todavía sin guardar — salí del campo y se guarda">•</span> }
                        </span>
                        <span class="wa-hdr-espacio"></span>
                    </div>
                </div>
                @* 2026-08-17: los botones (Vincular cliente, Editar contacto, Crear venta, ⚙, 🗑) y la
                   barra de Estado / Pasar a / Nota se fueron al PANEL DERECHO. Acá arriba queda una
                   sola fila fina: quién es. Eso solo le devolvió 125 px de alto a la conversación. *@
            </div>

            @* 2026-08-05: FICHA DEL CLIENTE — ventana flotante ARRASTRABLE con datos, saldo, ubicación y últimas facturas *@
            @if (mostrarFichaCliente && SelectedConv()?.ClienteId is int fichaCid)
            {
                <div class="wa-ficha wa-ficha-float @(facturaAbierta != null ? "wa-ficha-float-ancha" : "")" id="wa-ficha-float">
                    @if (cargandoFicha)
                    {
                        <div class="wa-ficha-top" id="wa-ficha-float-head" title="Arrastrá de acá para mover la ventana">
                            <div class="wa-ficha-nombre">✥ 🛍️ <b>Cargando…</b></div>
                            <button class="wa-ficha-x" @onclick="@(() => mostrarFichaCliente = false)" title="Cerrar">×</button>
                        </div>
                        <div class="wa-ficha-load">⏳ Cargando ficha del cliente…</div>
                    }
                    else if (fichaCliente is null)
                    {
                        <div class="wa-ficha-top" id="wa-ficha-float-head" title="Arrastrá de acá para mover la ventana">
                            <div class="wa-ficha-nombre">✥ 🛍️ <b>Cliente</b></div>
                            <button class="wa-ficha-x" @onclick="@(() => mostrarFichaCliente = false)" title="Cerrar">×</button>
                        </div>
                        <div class="wa-ficha-load">No se pudo cargar la ficha del cliente.</div>
                    }
                    else
                    {
                        <div class="wa-ficha-top" id="wa-ficha-float-head" title="Arrastrá de acá para mover la ventana a donde quieras">
                            <div class="wa-ficha-nombre">
                                <span class="wa-ficha-mover" title="Arrastrá para mover">✥</span>
                                🛍️ <b>@fichaCliente.Nombre</b>
                                @if (fichaCliente.CodigoInterno is int codi) { <span class="wa-ficha-cod">#@codi</span> }
                                @if (!string.IsNullOrWhiteSpace(fichaCliente.CondicionIva)) { <span class="wa-ficha-chip">@fichaCliente.CondicionIva</span> }
                            </div>
                            <button class="wa-ficha-x" @onclick="@(() => mostrarFichaCliente = false)" title="Cerrar">×</button>
                        </div>

                        <div class="wa-ficha-cols">
                            @* Columna 1: datos de contacto + ubicación *@
                            <div class="wa-ficha-datos">
                                @if (!string.IsNullOrWhiteSpace(fichaCliente.RazonSocial)) { <div><span class="wa-ficha-lbl">Razón social:</span> @fichaCliente.RazonSocial</div> }
                                @if (!string.IsNullOrWhiteSpace(fichaCliente.Cuit)) { <div><span class="wa-ficha-lbl">CUIT:</span> @fichaCliente.Cuit</div> }
                                @if (!string.IsNullOrWhiteSpace(fichaCliente.Telefono)) { <div><span class="wa-ficha-lbl">Tel:</span> @fichaCliente.Telefono @(string.IsNullOrWhiteSpace(fichaCliente.Telefono2) ? "" : $" / {fichaCliente.Telefono2}")</div> }
                                @if (!string.IsNullOrWhiteSpace(fichaCliente.Email)) { <div><span class="wa-ficha-lbl">Mail:</span> @fichaCliente.Email</div> }
                                @if (!string.IsNullOrWhiteSpace(fichaCliente.Direccion) || !string.IsNullOrWhiteSpace(fichaCliente.Localidad))
                                {
                                    <div><span class="wa-ficha-lbl">Dirección:</span> @fichaCliente.Direccion@(string.IsNullOrWhiteSpace(fichaCliente.Localidad) ? "" : $", {fichaCliente.Localidad}")</div>
                                }
                                @if (!string.IsNullOrWhiteSpace(fichaCliente.Notas)) { <div class="wa-ficha-notas">📝 @fichaCliente.Notas</div> }
                                <div class="wa-ficha-acc">
                                    @if (!string.IsNullOrWhiteSpace(fichaCliente.MapeoLink))
                                    {
                                        <a href="@fichaCliente.MapeoLink" target="_blank" class="wa-ficha-btn maps" title="Abrir la ubicación del cliente en Google Maps">📍 Ver en el mapa</a>
                                    }
                                    <a href="/cafe/clientes?edit=@fichaCid" target="_blank" class="wa-ficha-btn" title="Abrir la ficha completa del cliente (datos, CUIT, dirección…) en otra pestaña">📂 Ficha completa</a>
                                </div>
                            </div>

                            @* Columna 2: saldo + facturas *@
                            <div class="wa-ficha-plata">
                                <div class="wa-ficha-saldo @(fichaCliente.Saldo > 0.01m ? "debe" : "aldia")">
                                    <span class="wa-ficha-saldo-lbl">@(fichaCliente.Saldo > 0.01m ? "Debe" : "Cuenta al día")</span>
                                    <span class="wa-ficha-saldo-monto">$@fichaCliente.Saldo.ToString("N2")</span>
                                </div>
                                <div class="wa-ficha-facs-titulo">Últimas facturas</div>
                                @if (fichaCliente.Ventas.Count == 0)
                                {
                                    <div class="wa-ficha-vacio">Este cliente todavía no tiene facturas.</div>
                                }
                                else
                                {
                                    @* 2026-08-20: antes la factura se previsualizaba AL PASAR EL MOUSE, en un
                                       cuadradito de 340 px abajo de la lista. Molestaba: la vista cambiaba sola
                                       apenas movías el mouse, se apagaba al salir de la lista y ahí no se leía
                                       nada. Ahora se TOCA una factura y queda abierta, quieta, en un visor
                                       grande al costado (la ventana se ensancha sola). *@
                                    <div class="wa-ficha-facs">
                                        @foreach (var v in fichaCliente.Ventas)
                                        {
                                            <button type="button"
                                                    class="wa-ficha-fac @(facturaAbierta == v.Id ? "abierta" : "")"
                                                    @onclick="() => AbrirFactura(v.Id)"
                                                    title="@(facturaAbierta == v.Id ? "Tocá de nuevo para cerrarla" : "Tocá para verla grande acá al lado")">
                                                <div class="wa-ficha-fac-l1">
                                                    <span class="wa-ficha-fac-tipo">@(string.IsNullOrWhiteSpace(v.Tipo) ? "—" : v.Tipo)</span>
                                                    <span class="wa-ficha-fac-num">@v.Numero</span>
                                                    <span class="wa-ficha-fac-total">$@v.Total.ToString("N2")</span>
                                                </div>
                                                <div class="wa-ficha-fac-l2">
                                                    <span class="wa-ficha-fac-fecha">@v.Fecha.ToString("dd/MM/yy") · @Antiguedad(v.Fecha)</span>
                                                    @if (v.Tipo is not null && v.Tipo.StartsWith("NC"))
                                                    {
                                                        <span class="wa-ficha-fac-estado nc">N. Crédito</span>
                                                    }
                                                    else if (v.Saldo > 0.01m)
                                                    {
                                                        <span class="wa-ficha-fac-estado debe">Debe $@v.Saldo.ToString("N0")</span>
                                                    }
                                                    else
                                                    {
                                                        <span class="wa-ficha-fac-estado pagada">✓ Pagada</span>
                                                    }
                                                </div>
                                            </button>
                                        }
                                    </div>
                                }
                            </div>

                            @* 2026-08-20: VISOR GRANDE — tercera columna, aparece solo cuando tocaste una
                               factura. La ventana se ensancha sola (clase wa-ficha-float-ancha) y vuelve a
                               su tamaño al cerrarla. *@
                            @if (FacturaAbiertaDto() is ApiClient.FichaChatVentaDto fac)
                            {
                                <div class="wa-ficha-visor">
                                    <div class="wa-ficha-visor-top">
                                        <span class="wa-ficha-visor-tit">@fac.Numero · @fac.Fecha.ToString("dd/MM/yy")</span>
                                        <a class="wa-ficha-visor-btn" href="/api/cafe/ventas/@fac.Id/pdf" target="_blank"
                                           title="Abrirla a pantalla completa en otra pestaña">🔍 Grande</a>
                                        <button type="button" class="wa-ficha-visor-btn wa-verde"
                                                @onclick="() => MandarFacturaPorWa(fac)" disabled="@(enviandoFacturaId != null)"
                                                title="Mandarle esta factura al cliente por este mismo chat de WhatsApp">
                                            @(enviandoFacturaId == fac.Id ? "⏳ Mandando…" : "🟢 Mandar")
                                        </button>
                                        @* 2026-08-31: repetir este comprobante. Abre la carga de venta de
                                           siempre en otra pestaña, ya cargada con estos productos. No crea
                                           nada hasta que se aprieta "Emitir comprobante" allá. *@
                                        <button type="button" class="wa-ficha-visor-btn"
                                                @onclick="() => DuplicarComprobanteEnPestania(fac)"
                                                title="Repetir esta venta: abre la carga de venta en otra pestaña con todo cargado">📄 Duplicar</button>
                                        <button type="button" class="wa-ficha-visor-x" @onclick="CerrarFactura" title="Cerrar la factura">×</button>
                                    </div>
                                    <iframe class="wa-ficha-visor-frame" src="/api/cafe/ventas/@fac.Id/pdf?inline=true#toolbar=0&navpanes=0&view=FitH"
                                            title="Factura @fac.Numero"></iframe>
                                </div>
                            }
                        </div>
                    }
                </div>
            }

            @* 2026-08-03: cartelito que ADIVINA el cliente por el teléfono y ofrece vincularlo de un toque *@
            @if (SelectedConv()?.ClienteId is null && sugerenciaCliente is not null)
            {
                <div class="wa-sug-cliente">
                    <span style="font-size:1.1rem;">💡</span>
                    <div style="flex:1; line-height:1.3;">
                        ¿Este chat es de <b>@sugerenciaCliente.Nombre</b>@(string.IsNullOrWhiteSpace(sugerenciaCliente.CodigoInterno) ? "" : $" (#{sugerenciaCliente.CodigoInterno})")?
                    </div>
                    <button class="btn btn-sm btn-success" @onclick="VincularSugerido" disabled="@vinculando" style="font-weight:600; white-space:nowrap;">
                        @(vinculando ? "⏳" : "✓ Sí, vincular")
                    </button>
                    <button class="btn btn-sm btn-outline-secondary" @onclick="DescartarSugerencia" disabled="@vinculando" style="white-space:nowrap;">No</button>
                </div>
            }

            @* 2026-08-21 (parte 3): el chat te AVISA solo si el que escribe es un comprador de
               MercadoLibre, y si pegó el código de una publicación o un número de venta te lo
               deja a mano para abrirlo. Antes había que sospecharlo y buscarlo a mano. *@
            @if (mmAviso is not null && !mmAvisoCerrado)
            {
                <div class="wa-mm-aviso-chat">
                    <span class="wa-mm-aviso-punto">🟡</span>
                    <div class="wa-mm-aviso-txt">
                        @mmAviso.Texto
                        @if (mmAviso.Guardado) { <span class="wa-mm-aviso-pin" title="Este usuario está guardado en este teléfono">📌</span> }
                    </div>
                    <button class="wa-mm-aviso-ver" @onclick="AbrirFichaDelAviso" title="Ver sus compras, envíos y preguntas acá al lado">Ver</button>
                    <button class="wa-mm-aviso-x" @onclick="() => mmAvisoCerrado = true" title="Ocultar el aviso en este chat">✕</button>
                </div>
            }
            @if (mmCodigos.Count > 0)
            {
                <div class="wa-mm-codigos">
                    <span class="wa-mm-codigos-lbl">Pegó en el chat:</span>
                    @foreach (var cod in mmCodigos)
                    {
                        <button class="wa-mm-cod" @onclick="() => AbrirCodigoMeli(cod)"
                                title="@(cod.StartsWith("MLA") ? "Ver precio y stock de esta publicación" : "Buscar esta venta en MercadoLibre")">
                            @(cod.StartsWith("MLA") ? "🏷️ " : "🧾 ") @cod
                        </button>
                    }
                </div>
            }

            @* 2026-08-20: buscador DENTRO de la charla (la lupa), igual que en el celular. *@
            @if (buscadorAbierto)
            {
                <div class="wa-buscador">
                    <span>🔍</span>
                    <input class="wa-busc-input" placeholder="Buscar una palabra en esta charla…"
                           value="@busqTexto" @oninput="OnBuscar" @onkeydown="OnBuscarTecla" autocomplete="off" />
                    <span class="wa-busc-cont">@ContadorBusqueda</span>
                    <button type="button" class="wa-busc-btn" @onclick="() => SaltarBusqueda(-1)"
                            disabled="@(busqHits.Count == 0)" title="Anterior (más viejo)">▲</button>
                    <button type="button" class="wa-busc-btn" @onclick="() => SaltarBusqueda(1)"
                            disabled="@(busqHits.Count == 0)" title="Siguiente (más nuevo)">▼</button>
                    <button type="button" class="wa-busc-btn" @onclick="CerrarBuscador" title="Cerrar el buscador">✕</button>
                </div>
                @if (!string.IsNullOrEmpty(busqAviso))
                {
                    <div class="wa-busc-aviso">@busqAviso</div>
                }
            }
            @* 2026-07-23: id para poder bajar el scroll al ultimo mensaje (como WhatsApp de verdad) *@
            <div class="wa-messages" id="wa-messages-scroll" @ref="messagesScroll">
                @if (loadingMsg)
                {
                    <div style="padding:1rem; color:#9ca3af; text-align:center;">Cargando…</div>
                }
                else
                {
                    @* 2026-08-20: cartelitos "Hoy" / "Ayer" para partir la charla por dia, como
                       WhatsApp. Acá los mensajes van del mas viejo al mas nuevo y en orden normal,
                       asi que el cartelito va ANTES del primer mensaje de cada dia. (En el celular
                       la lista se dibuja al reves, ahi va en el otro extremo — ver PinnedWaChat.) *@
                    @for (int _i = 0; _i < mensajes.Count; _i++)
                    {
                        var m = mensajes[_i];
                        if (_i == 0 || !DateTimeExt.MismoDiaAr(mensajes[_i - 1].CreatedAt, m.CreatedAt))
                        {
                            <div class="wa-fecha-sep"><span>@DateTimeExt.EtiquetaDiaAr(m.CreatedAt)</span></div>
                        }
                        @* 2026-08-20: el clic suelto YA NO selecciona. Antes cualquier clic sobre un
                           mensaje lo tildaba y aparecía la barra de arriba sin que hubieras pedido
                           nada; y al revés, si no sabías ese truco no encontrabas nunca el reenviar.
                           Ahora se entra por el botón ↪ del mensaje (como WhatsApp) y recién ahí el
                           clic sirve para ir sumando más mensajes a la tanda. *@
                        <div class="wa-msg-row @(m.Direccion == "OUTGOING" ? "out" : "in") @(mensajesSeleccionadosIds.Contains(m.Id) ? "selected" : "")" @onclick="() => ClicEnMensaje(m.Id)">
                            @if (mensajesSeleccionadosIds.Contains(m.Id))
                            {
                                <div class="wa-msg-check">✓</div>
                            }
                            <div class="wa-bubble-wrap">
                                <div class="wa-bubble @(m.Anulado ? "wa-anulado" : "") @(busqHitSet.Contains(m.Id) ? "wa-hit" : "")" id="@($"wamsg-{m.Id}")">
                                    @* 2026-08-05: "responder citando" — burbujita del mensaje al que responde este *@
                                    @if (!string.IsNullOrEmpty(m.ReplyPreview))
                                    {
                                        @* 2026-08-18: al hacer clic lleva al mensaje original y lo resalta (antes no hacía nada) *@
                                        <div class="wa-reply-quote wa-reply-clic" title="Ir al mensaje original"
                                             @onclick="() => IrAlCitado(m)" @onclick:stopPropagation="true">
                                            <span class="wa-reply-quote-who">@(m.ReplyFromMe ? "Vos" : MostrarNombre(SelectedConv()))</span>
                                            <span class="wa-reply-quote-text">@m.ReplyPreview</span>
                                        </div>
                                    }
                                    @if (!string.IsNullOrEmpty(m.MediaUrl))
                                    {
                                        @if (IsImage(m.MediaUrl))
                                        {
                                            @* 2026-08-07: los STICKERS (.webp) salían enormes (300px). Ahora chicos (~150px)
                                               como en WhatsApp; las fotos normales, un poco más contenidas (230px). *@
                                            @* al tocar la foto se abre un visor emergente (ventanita sobre el chat) *@
                                            <img src="@m.MediaUrl" class="wa-chat-img" @onclick="@(() => AbrirVisorImagen(m.MediaUrl, NombreDescarga(m)))"
                                                 style="max-width:@(EsSticker(m.MediaUrl) ? "150px" : "100%"); max-height:@(EsSticker(m.MediaUrl) ? "150px" : "230px"); border-radius:6px; display:block; cursor:zoom-in;" alt="adjunto" />
                                            @if (!EsSticker(m.MediaUrl))
                                            {
                                                @* botón para descargar la imagen (los stickers no hace falta) *@
                                                <a href="@m.MediaUrl" download="@NombreDescarga(m)" class="wa-descargar-btn">⬇ Descargar</a>
                                            }
                                        }
                                        else if (IsAudio(m.MediaUrl))
                                        {
                                            @* 2026-07-23: nota de voz — se escucha aca mismo, como en WhatsApp *@
                                            <audio controls preload="none" src="@m.MediaUrl" style="max-width:250px; height:40px; display:block; margin-bottom:0.2rem;"></audio>
                                            <a href="@m.MediaUrl" download="@NombreDescarga(m)" class="wa-descargar-btn">⬇ Descargar</a>
                                        }
                                        else
                                        {
                                            <a href="@m.MediaUrl" download="@NombreDescarga(m)" style="display:flex; align-items:center; gap:0.4rem; padding:0.5rem; background:#f3f4f6; border-radius:6px; text-decoration:none; color:#374151; margin-bottom:0.3rem;">
                                                <span style="font-size:1.5rem;">📎</span>
                                                @* 2026-07-23 pedido Osmar: mostrar nombre y tipo del archivo (antes decía "Archivo adjunto" pelado) *@
                                                <span style="font-size:0.85rem; flex:1;">@(string.IsNullOrWhiteSpace(m.MediaFilename) ? "Archivo adjunto" : m.MediaFilename)<br/><span style="font-size:0.7rem; color:#6b7280;">@WaTipoArchivo(m.MediaUrl, m.MediaFilename) · Tocá para descargar</span></span>
                                                <span style="font-size:1.1rem;">⬇</span>
                                            </a>
                                        }
                                    }
                                    @if (EsMensajeContacto(m.Cuerpo))
                                    {
                                        @* 2026-08-02: tarjeta de contacto compartido (recibido o enviado) *@
                                        @foreach (var ct in ParseContactos(m.Cuerpo))
                                        {
                                            <div class="wa-contacto-card">
                                                <span class="wa-contacto-ava">👤</span>
                                                <div style="flex:1; min-width:0;">
                                                    <div style="font-weight:600;">@ct.Nombre</div>
                                                    <div style="font-size:0.78rem; color:#6b7280;">+@ct.Numero</div>
                                                </div>
                                                <div style="display:flex; flex-direction:column; gap:0.3rem; flex-shrink:0;">
                                                    <button class="wa-contacto-btn" title="Escribirle a este contacto" @onclick="() => EscribirAContactoCompartido(ct.Nombre, ct.Numero)" @onclick:stopPropagation="true">💬 Escribir</button>
                                                    <button class="wa-contacto-btn" title="Guardar este contacto en tu agenda" @onclick="() => AgendarContactoCompartido(ct.Nombre, ct.Numero)" @onclick:stopPropagation="true">➕ Agendar</button>
                                                </div>
                                            </div>
                                        }
                                    }
                                    else if (!string.IsNullOrEmpty(m.Cuerpo))
                                    {
                                        @* 2026-08-20: mensajes largos recortados con "Leer más", como
                                           WhatsApp. OJO: se recorta el texto CRUDO y recién después se
                                           escapa, nunca al revés — cortar el HTML ya escapado puede
                                           partir un "&amp;" al medio y ensuciar la pantalla. *@
                                        <div class="wa-bubble-body">@((MarkupString)EscapeMsg(TextoMensaje.EsLargo(m.Cuerpo) && !textoAbierto.Contains(m.Id) ? TextoMensaje.Recortado(m.Cuerpo) : m.Cuerpo))</div>
                                        @if (TextoMensaje.EsLargo(m.Cuerpo))
                                        {
                                            <button type="button" class="wa-leermas"
                                                    @onclick="() => ToggleTexto(m.Id)" @onclick:stopPropagation="true">
                                                @(textoAbierto.Contains(m.Id) ? "Ver menos" : "Leer más")
                                            </button>
                                        }
                                    }
                                    <div class="wa-bubble-meta">
                                        @FormatHoraMsg(m.CreatedAt)
                                        @* 2026-07-24: tilditos de estado, solo en los mensajes que MANDAMOS *@
                                        @if (m.Direccion == "OUTGOING")
                                        {
                                            <span class="@TildeCss(m.EstadoEntrega)" title="@TildeTitulo(m.EstadoEntrega, m.EntregaError)">@TildeTexto(m.EstadoEntrega)</span>
                                        }
                                        @* 2026-08-07: aviso de que este mensaje está oculto para Depósito *@
                                        @if (m.OcultoDeposito && !esDeposito)
                                        {
                                            <span class="wa-oculto-badge" title="Este mensaje NO lo ve Depósito">🚫 oculto a Depósito</span>
                                        }
                                        @* 2026-08-19: cartelito de anulado. Tocándolo se deshace (por si te equivocaste). *@
                                        @if (m.Anulado)
                                        {
                                            <button class="wa-anulado-badge" @onclick="() => DesanularMensaje(m)" @onclick:stopPropagation="true"
                                                    title="Se mandó una corrección de este mensaje. El cliente lo sigue viendo normal en su celular. Tocá para deshacer.">
                                                ⚠️ anulado@(string.IsNullOrEmpty(m.AnuladoPor) ? "" : $" por {m.AnuladoPor}") · deshacer
                                            </button>
                                        }
                                    </div>
                                    @* 2026-08-22: si Meta rechazó la entrega, el motivo se ve SIEMPRE (no solo al pasar
                                       el mouse: en el celular no hay "pasar el mouse" y el ⚠ quedaba mudo). *@
                                    @if (m.Direccion == "OUTGOING" && m.EstadoEntrega == "failed")
                                    {
                                        <div class="wa-fallo-motivo">⚠️ No llegó: @(string.IsNullOrWhiteSpace(m.EntregaError) ? "WhatsApp lo rechazó y no explicó el motivo." : m.EntregaError)</div>
                                    }
                                    @* 2026-08-19: los botoncitos y el selector de emojis pasaron ADENTRO del globito.
                                       Antes colgaban del contenedor de afuera, que se estira al 75% del ancho, asi que
                                       en los mensajes largos quedaban flotando hasta 144 px a un costado y nadie los
                                       encontraba. Colgando del globito quedan siempre pegados a el, mida lo que mida. *@
                                    @* 2026-08-20: los botoncitos pasan de COLUMNA a FILA. Apilados, cada
                                       uno sumaba 30 px de alto: con cinco la columna medía 146 px, y un
                                       mensaje de un renglón mide 40, así que los de abajo caían fuera del
                                       globito y quedaban TAPADOS por el mensaje siguiente. En fila el alto
                                       es siempre el de UN botón, no importa cuántos haya. *@
                                    <div class="wa-msg-acciones">
                                    @* Botón reaccionar — visible al hover *@
                                    <button class="wa-react-btn" @onclick="() => TogglePicker(m.Id)" title="Reaccionar">😊</button>
                                    @* 2026-08-05: botón responder citando — visible al hover *@
                                    <button class="wa-reply-btn" @onclick="() => IniciarResponder(m)" @onclick:stopPropagation="true" title="Responder citando este mensaje">↩️</button>
                                    @* 2026-08-19: CORREGIR — solo en los mensajes que mandamos nosotros. Un enviado no se
                                       puede borrar, así que deja el equivocado citado + el texto de aviso ya escrito. *@
                                    @if (m.Direccion == "OUTGOING" && !m.Anulado)
                                    {
                                        <button class="wa-corregir-btn" @onclick="() => IniciarCorregir(m)" @onclick:stopPropagation="true"
                                                title="Corregir: manda un aviso citando este mensaje y lo deja tachado para el equipo">⚠️</button>
                                    }
                                    @* 2026-08-20: REENVIAR este mensaje a otro contacto. Es la puerta de
                                       entrada, como el "Reenviar" del menú de WhatsApp: tilda este
                                       mensaje, prende el modo selección (para poder sumar más con un
                                       clic) y abre directo la lista de contactos. *@
                                    <button class="wa-fwd-btn" @onclick="() => ReenviarEsteMensaje(m)" @onclick:stopPropagation="true"
                                            title="Reenviar este mensaje a otro contacto">↪</button>
                                    @* 2026-08-07: ocultar/mostrar este mensaje a Depósito — solo admin/oficina.
                                       2026-08-12: y SOLO en los chats que ve Depósito (en el resto no tiene sentido). *@
                                    @if (!esDeposito && EsChatVisibleDeposito)
                                    {
                                        <button class="wa-hide-btn" @onclick="() => ToggleOcultarDeposito(m)" @onclick:stopPropagation="true"
                                                title="@(m.OcultoDeposito ? "Mostrar este mensaje a Depósito" : "Ocultar este mensaje a Depósito")">@(m.OcultoDeposito ? "👁" : "🚫")</button>
                                    }
                                    </div>
                                    @if (pickerOpenMsgId == m.Id)
                                    {
                                        @* 2026-08-28: en los chats de Depósito la tira cambia segun quien mira:
                                           oficina 💻/⛔, Depósito 📦/🚧 (ver DepositoChats.EmojisPara). *@
                                        <div class="wa-emoji-picker">
                                            @foreach (var em in EmojisPickerWa)
                                            {
                                                <button class="wa-emoji-pick @(em.Que.Length > 0 ? "conletra" : "")" title="@em.Que"
                                                        @onclick="() => ReaccionarA(m.Id, em.Emoji)">@em.Emoji@(em.Que.Length > 0 ? $" {em.Que}" : "")</button>
                                            }
                                        </div>
                                    }
                                </div>
                                @if (m.Reacciones != null && m.Reacciones.Count > 0)
                                {
                                    <div class="wa-reacciones">
                                        @foreach (var r in m.Reacciones)
                                        {
                                            @if (r.EsCliente)
                                            {
                                                @* Reacción del cliente: solo se muestra, no se toca (no podemos quitar la reacción de otro) *@
                                                <span class="wa-reaccion-chip cliente" title="Reacción del cliente">
                                                    @r.Emoji @if (r.Count > 1) { <span>@r.Count</span> }
                                                </span>
                                            }
                                            else
                                            {
                                                @* 2026-08-28: si la puso alguien con firma (chats de Depósito), el chip
                                                   muestra QUIEN fue y solo esa persona puede sacarla. *@
                                                <button class="wa-reaccion-chip" @onclick="() => QuitarReaccionChip(m.Id, r)" title="@TituloReaccionWa(r)">
                                                    @r.Emoji @if (!string.IsNullOrWhiteSpace(r.Firmas)) { <span>@r.Firmas</span> } else if (r.Count > 1) { <span>@r.Count</span> }
                                                </button>
                                            }
                                        }
                                    </div>
                                }
                            </div>
                        </div>
                    }
                }
            </div>

            @if (modoElegirVenta || mensajesSeleccionadosIds.Count > 0)
            {
                <div class="wa-selection-bar">
                    @if (modoElegirVenta && mensajesSeleccionadosIds.Count == 0)
                    {
                        <span style="font-size:0.85rem; font-weight:600;">🧾 Tildá los mensajes del pedido y tocá "Abrir venta"</span>
                    }
                    else
                    {
                        <span style="font-size:0.85rem; font-weight:600;">✓ @mensajesSeleccionadosIds.Count seleccionado(s)</span>
                    }
                    <button class="btn btn-success btn-sm" @onclick="AbrirVentaDesdeChat" title="Abre Nueva Venta en una pestaña nueva con estos mensajes y el cliente (si el chat tiene uno asignado)">🧾 Abrir venta</button>
                    <button class="btn btn-primary btn-sm" @onclick="AbrirReenviar">↪ Reenviar</button>
                    <button class="btn btn-outline-secondary btn-sm" @onclick="CancelarSeleccionVenta">× Cancelar</button>
                </div>
            }
            @* 2026-08-04: Reenviar los mensajes tildados a uno o varios contactos (como WhatsApp) *@
            @if (showReenviar)
            {
                <div class="wa-fwd-overlay" @onclick="CerrarReenviar"></div>
                <div class="wa-fwd-modal" @onclick:stopPropagation="true">
                    <div class="wa-fwd-head">
                        <strong>↪ Reenviar @mensajesSeleccionadosIds.Count mensaje(s)</strong>
                        <button class="wa-fwd-x" @onclick="CerrarReenviar">×</button>
                    </div>
                    <div class="wa-fwd-sub">Elegí uno o varios contactos. A todos les llega lo mismo.</div>

                    @if (reenviarDestinos.Count > 0)
                    {
                        <div class="wa-fwd-chips">
                            @foreach (var d in reenviarDestinos)
                            {
                                <span class="wa-fwd-chip @(d.EsOtraEmpresa ? "otra" : "")" title="Sale por @d.NombreLinea">@d.Nombre <small>· @d.NombreLinea</small> <button @onclick="() => QuitarDestino(d)" title="Quitar">×</button></span>
                            }
                        </div>
                    }

                    <input class="wa-nv-input wa-nv-search" placeholder="🔍 Buscá un nombre o un número…"
                           @bind="reenviarQuery" @bind:event="oninput" @onkeyup="BuscarReenviarDestinos" />

                    @if (reenviarBuscando)
                    {
                        <div class="wa-nv-muted">Buscando…</div>
                    }
                    @{ var fwdDirecto = ReenviarNumeroDirecto(); }
                    @if (fwdDirecto != null || reenviarResultados.Count > 0)
                    {
                        <div class="wa-fwd-list">
                            @if (fwdDirecto != null)
                            {
                                <button type="button" class="wa-nv-item" @onclick="() => AgregarDestinoDirecto(fwdDirecto!)">
                                    <div class="wa-nv-avatar" style="background:#2563eb;">📱</div>
                                    <div style="flex:1; min-width:0;">
                                        <div style="font-weight:700; color:#111;">Reenviar a este número</div>
                                        <div style="font-size:0.85rem; color:#2563eb;">@BonitoNumero(fwdDirecto)</div>
                                    </div>
                                </button>
                            }
                            @foreach (var cli in reenviarResultados)
                            {
                                @* 2026-08-20: un contacto del buscador NO tiene charla, así que no hay
                                   línea propia: sale por la que estás usando vos. Antes se mandaba sin
                                   línea y terminaba saliendo por la línea por defecto del servidor. *@
                                var dstB = new ReenvioWa.Destino(cli.Nombre, cli.Numero, selectedLinea,
                                                                 NombreDeLinea(selectedLinea), cli.Disponible, false);
                                var ya = reenviarDestinos.Any(x => x.Numero == dstB.Numero && x.Linea == dstB.Linea);
                                <button type="button" class="wa-nv-item @(ya ? "wa-fwd-sel" : "")" @onclick="() => ToggleDestino(dstB)">
                                    <div class="wa-nv-avatar">@InicialDe(cli.Nombre)</div>
                                    <div style="flex:1; min-width:0;">
                                        <div style="font-weight:600; color:#111; overflow:hidden; text-overflow:ellipsis; white-space:nowrap;">@cli.Nombre</div>
                                        <div style="font-size:0.85rem; color:#6b7280;">@BonitoNumero(cli.Numero)</div>
                                        <span class="wa-fwd-linea">📤 sale por <b>@NombreDeLinea(selectedLinea)</b></span>
                                        @if (!cli.Disponible)
                                        {
                                            <span class="wa-fwd-badge no">🔒 fuera de 24 hs · necesita plantilla</span>
                                        }
                                    </div>
                                    <span style="color:#16a34a; font-weight:700;">@(ya ? "✓" : "")</span>
                                </button>
                            }
                        </div>
                    }
                    else if (!string.IsNullOrWhiteSpace(reenviarQuery) && reenviarQuery.Length >= 2 && !reenviarBuscando)
                    {
                        <div class="wa-nv-muted">Sin contactos para esa búsqueda. Si es un número nuevo, escribilo completo con el 54.</div>
                    }
                    else
                    {
                        @* 2026-08-20: mientras no escribiste nada, las ÚLTIMAS CHARLAS a un toque.
                           Antes esto era un cuadro vacío y había que tipear el nombre sí o sí, aunque
                           quisieras reenviarle al cliente con el que acabás de hablar. El buscador de
                           arriba sigue estando para los que NO tienen charla abierta (clientes del
                           café, compradores de MercadoLibre, agenda). *@
                        <div class="wa-fwd-recientes-t">Últimas charlas</div>
                        <div class="wa-fwd-list">
                            @foreach (var dst in ReenviarRecientes())
                            {
                                var yaR = reenviarDestinos.Any(x => x.Numero == dst.Numero && x.Linea == dst.Linea);
                                <button type="button" class="wa-nv-item @(yaR ? "wa-fwd-sel" : "")"
                                        @onclick="() => ToggleDestino(dst)">
                                    <div class="wa-nv-avatar">@InicialDe(dst.Nombre)</div>
                                    <div style="flex:1; min-width:0;">
                                        <div style="font-weight:600; color:#111; overflow:hidden; text-overflow:ellipsis; white-space:nowrap;">@dst.Nombre</div>
                                        <div style="font-size:0.85rem; color:#6b7280;">@BonitoNumero(dst.Numero)</div>
                                        @* 2026-08-20: POR DÓNDE SALE. Antes esto no se veía y el sistema
                                           elegía solo: si el cliente le hablaba a las dos empresas, la
                                           línea de salida dependía de quién había escrito último. *@
                                        <span class="wa-fwd-linea @(dst.EsOtraEmpresa ? "otra" : "")">
                                            @(dst.EsOtraEmpresa ? "⚠️ sale por " : "📤 sale por ")<b>@dst.NombreLinea</b>
                                        </span>
                                        @if (!dst.Abierto)
                                        {
                                            <span class="wa-fwd-badge no">🔒 fuera de 24 hs · necesita plantilla</span>
                                        }
                                    </div>
                                    <span style="color:#16a34a; font-weight:700;">@(yaR ? "✓" : "")</span>
                                </button>
                            }
                            @if (ReenviarRecientes().Count == 0)
                            {
                                <div class="wa-nv-muted">Todavía no hay charlas. Buscá el contacto por nombre o número arriba.</div>
                            }
                        </div>
                    }

                    <div class="wa-fwd-actions">
                        <button class="btn btn-outline-secondary btn-sm" @onclick="CerrarReenviar">Cancelar</button>
                        <button class="btn btn-success btn-sm" disabled="@(reenviarDestinos.Count == 0 || reenviando)" @onclick="ConfirmarReenviar">
                            @* 2026-08-20: sin nadie elegido decia "Reenviar a 0", que se lee como un error. *@
                            @(reenviando ? "Enviando…"
                                : reenviarDestinos.Count == 0 ? "↪ Elegí a quién"
                                : $"↪ Reenviar a {reenviarDestinos.Count}")
                        </button>
                    </div>
                </div>
            }
            @* 2026-08-05: las respuestas rápidas se movieron a un desplegable arriba del botón Enviar (más abajo) *@
            @* 2026-07-29: Panel "Enviar saldo" — pone la deuda del cliente en el cuadro de mensaje (revisás y mandás con Enter) *@
            @if (showSaldoPanel)
            {
                <div class="wa-saldo-panel">
                    <div class="wa-saldo-head">
                        <strong>💰 Poner saldo en el mensaje</strong>
                        <button class="wa-saldo-x" @onclick="@(() => showSaldoPanel = false)">×</button>
                    </div>
                    @if (SelectedConv()?.ClienteId is int cidChat)
                    {
                        <button class="wa-saldo-cli destacado" @onclick="() => PonerSaldo(cidChat)" disabled="@saldoCargando">
                            🛍️ Cliente de este chat: <b>@SelectedConv()?.ClienteNombre</b>
                        </button>
                    }
                    <input class="form-control wa-saldo-buscar" placeholder="Buscar otro cliente por nombre…"
                           @bind="saldoQuery" @bind:event="oninput" @onkeyup="BuscarSaldoClientes" />
                    @if (saldoBuscando)
                    {
                        <div class="wa-saldo-info">Buscando…</div>
                    }
                    else if (!string.IsNullOrWhiteSpace(saldoQuery) && saldoResultados.Count == 0)
                    {
                        <div class="wa-saldo-info">Sin resultados</div>
                    }
                    @foreach (var cli in saldoResultados)
                    {
                        <button class="wa-saldo-cli" @onclick="() => PonerSaldo(cli.Id)" disabled="@saldoCargando">
                            @cli.Nombre @(string.IsNullOrWhiteSpace(cli.CodigoInterno) ? "" : $"(#{cli.CodigoInterno})")
                        </button>
                    }
                    @if (saldoCargando)
                    {
                        <div class="wa-saldo-info">Trayendo saldo…</div>
                    }
                </div>
            }
            @* 2026-07-29: Panel "Pasar CBU" — tocás una cuenta y te arma los datos bancarios en el mensaje (revisás y mandás) *@
            @if (showCbuPanel)
            {
                <div class="wa-saldo-panel">
                    <div class="wa-saldo-head">
                        <strong>🏦 Pasar datos bancarios / CBU</strong>
                        <button class="wa-saldo-x" @onclick="@(() => showCbuPanel = false)">×</button>
                    </div>
                    @if (datosBancarios.Count(x => x.Activo) == 0)
                    {
                        <div class="wa-saldo-info">Todavía no cargaste ninguna cuenta. Entrá a ⚙️ Configuración → "Datos bancarios / CBUs" para agregar.</div>
                    }
                    @foreach (var cb in datosBancarios.Where(x => x.Activo).OrderBy(x => x.Orden))
                    {
                        <button class="wa-saldo-cli" @onclick="() => InsertarCbu(cb, false)" title="Insertar CBU completo">
                            🏦 <b>@cb.Nombre</b>@(string.IsNullOrWhiteSpace(cb.Banco) ? "" : $" · {cb.Banco}")
                        </button>
                        @if (!string.IsNullOrWhiteSpace(cb.Alias))
                        {
                            <button class="wa-saldo-cli wa-cbu-solo-alias" @onclick="() => EnviarSoloAlias(cb)" disabled="@enviandoAlias"
                                    title="Manda DOS mensajes: primero los datos de la cuenta en un renglón y atrás el alias solito, para que el cliente lo copie de un toque.">
                                ↳ Solo alias: <b>@cb.Alias</b> <span style="color:#6b7280; font-weight:600;">@(enviandoAlias ? "· enviando…" : "· se manda solo (2 mensajes)")</span>
                            </button>
                        }
                    }
                </div>
            }
            @* 2026-08-02: Panel "Compartir contacto" — buscás un contacto y se lo mandás como tarjeta al chat *@
            @if (showContactoPanel)
            {
                <div class="wa-saldo-panel">
                    <div class="wa-saldo-head">
                        <strong>👤 Compartir un contacto</strong>
                        <button class="wa-saldo-x" @onclick="@(() => showContactoPanel = false)">×</button>
                    </div>
                    <input class="form-control wa-saldo-buscar" placeholder="Buscar contacto por nombre o número…"
                           @bind="contactoQuery" @bind:event="oninput" @onkeyup="BuscarContactosCompartir" />
                    @if (contactoBuscando)
                    {
                        <div class="wa-saldo-info">Buscando…</div>
                    }
                    else if (!string.IsNullOrWhiteSpace(contactoQuery) && contactoQuery.Length >= 2 && contactoResultados.Count == 0)
                    {
                        <div class="wa-saldo-info">Sin contactos con teléfono para esa búsqueda.</div>
                    }
                    @foreach (var cli in contactoResultados)
                    {
                        <button class="wa-saldo-cli" @onclick="() => CompartirContacto(cli)" disabled="@enviandoContacto">
                            👤 <b>@cli.Nombre</b> <span style="color:#6b7280;">— @cli.Numero</span>
                            <span style="font-size:0.65rem; color:#2563eb;">@cli.Origen</span>
                        </button>
                    }
                    @if (enviandoContacto) { <div class="wa-saldo-info">Enviando contacto…</div> }
                </div>
            }
            @* 2026-08-26: PROGRAMAR PARA MÁS TARDE. Va acá afuera (y no dentro del cajón de escribir)
               a propósito: así también se puede programar una plantilla cuando la ventana de 24 hs
               ya está cerrada y el cuadro de escribir ni aparece. *@
            @if (showProgramarPanel)
            {
                <div class="wa-saldo-panel">
                    <div class="wa-saldo-head">
                        <strong>🕒 Programar para más tarde</strong>
                        <button class="wa-saldo-x" @onclick="CerrarProgramar">×</button>
                    </div>

                    <div class="wa-prog-modos">
                        <button class="wa-prog-modo @(progModo == "MENSAJE" ? "sel" : "")" @onclick='@(() => SetProgModo("MENSAJE"))'>
                            ✍️ Lo que escribiste abajo
                        </button>
                        <button class="wa-prog-modo @(progModo == "PLANTILLA" ? "sel" : "")" @onclick='@(() => SetProgModo("PLANTILLA"))'>
                            📋 Una plantilla
                        </button>
                    </div>

                    @if (progModo == "MENSAJE")
                    {
                        @if (string.IsNullOrWhiteSpace(composerText) && AdjuntosProgramables().Count == 0)
                        {
                            <div class="wa-saldo-info">
                                Escribí el mensaje en el cuadro de abajo y va a aparecer acá para programarlo. También se
                                programan los adjuntos: 📎 archivos de tu PC, 🗂️ comprobantes del sistema y 🎤 notas de voz.
                            </div>
                        }
                        else
                        {
                            <div class="wa-prog-resumen">
                                @foreach (var ad in AdjuntosProgramables())
                                {
                                    <div class="wa-prog-resumen-adj">@ad.Icono @ad.Label</div>
                                }
                                @if (!string.IsNullOrWhiteSpace(composerText))
                                {
                                    <div class="wa-prog-resumen-txt">@composerText</div>
                                }
                            </div>
                        }
                        @if (!Ventana24Abierta())
                        {
                            <div class="wa-prog-aviso">
                                ⚠️ Pasaron más de 24 hs desde su último mensaje: WhatsApp no deja mandarle texto libre.
                                Si no te escribe antes de la hora que elijas, no va a salir. Para asegurarlo, usá <b>📋 Una plantilla</b>.
                            </div>
                        }
                    }
                    else
                    {
                        @if (nvPlantillas.Count == 0)
                        {
                            <div class="wa-saldo-info">No hay plantillas aprobadas disponibles. Revisá la configuración de WhatsApp.</div>
                        }
                        else
                        {
                            <div class="wa-saldo-info">
                                La plantilla es la única que sale aunque hayan pasado las 24 hs. Sirve para agendar a varios días.
                            </div>
                            <select class="wa-nv-input" value="@chatPlantillaName" @onchange="OnChatPlantillaChange">
                                <option value="">— Elegí una plantilla —</option>
                                @foreach (var pl in nvPlantillas)
                                {
                                    <option value="@pl.Name">@NombrePlantillaLindo(pl.Name) (@pl.Category.ToLower())</option>
                                }
                            </select>
                            @if (ChatPlantillaSel() is {} progSel)
                            {
                                @if (progSel.VariableCount > 0)
                                {
                                    <div style="margin-top:0.5rem;">
                                        @for (int i = 0; i < progSel.VariableCount; i++)
                                        {
                                            var idx = i;
                                            <input class="wa-nv-input" style="margin-bottom:0.4rem;"
                                                   placeholder="@PlaceholderVar(progSel, idx)"
                                                   value="@(idx < chatVariables.Count ? chatVariables[idx] : "")"
                                                   @oninput="e => SetChatVariable(idx, e.Value?.ToString() ?? string.Empty)" />
                                        }
                                    </div>
                                }
                                <div class="wa-nv-preview" style="margin-top:0.5rem;">@ChatPreviewTexto()</div>
                            }
                        }
                    }

                    <div class="wa-prog-cuando-tit">¿Cuándo se lo mando?</div>
                    <div class="wa-prog-chips">
                        @foreach (var op in OpcionesHorario())
                        {
                            <button class="wa-prog-chip @(progCuando == op.Cuando ? "sel" : "")" @onclick="@(() => progCuando = op.Cuando)">
                                @op.Label
                            </button>
                        }
                    </div>
                    @* 2026-08-26: el "cuándo" en DOS pedazos. Antes era un solo casillero con día,
                       mes, año, hora y minutos: demasiado, y el año se rompía solo. Ahora se escribe
                       la HORA (que es lo que se cambia siempre) y el día queda en hoy salvo que lo
                       cambies desde el almanaque. *@
                    <div class="wa-prog-fecha">
                        <span>o elegí la hora:</span>
                        <input type="time" class="wa-nv-input wa-prog-hora" value="@ProgHoraTexto" @onchange="OnProgHoraChange" />
                        <span class="wa-prog-dia-tag @(ProgEsHoy() ? "hoy" : "")">@ProgDiaLindo()</span>
                        @if (progMostrarAlmanaque)
                        {
                            <input type="date" id="wa-prog-dia" class="wa-nv-input wa-prog-diainput"
                                   min="@DateTimeExt.AhoraAr().ToString("yyyy-MM-dd")" value="@ProgDiaTexto" @onchange="OnProgDiaChange" />
                        }
                        else
                        {
                            <button class="wa-prog-otrodia" @onclick="AbrirAlmanaque" title="Elegir otro día en el almanaque">📅 otro día</button>
                        }
                    </div>

                    <button class="wa-nueva-btn wa-prog-guardar" disabled="@(progGuardando || !SePuedeProgramar())" @onclick="ProgramarAhora">
                        <span class="wa-nueva-ico">🕒</span>
                        @(progGuardando ? "Programando…" : $"Dejarlo programado para {CuandoLindo(progCuando)}")
                    </button>
                </div>
            }
            @* 2026-08-26: lo que quedó agendado en este chat. Un mensaje programado que no se ve ni se
               puede frenar es una bomba, así que siempre está a la vista con su ✖ para cancelarlo. *@
            @if (progPendientes.Count > 0 || ProgramadosFallados().Count > 0)
            {
                <div class="wa-prog-tray">
                    @foreach (var pr in progPendientes)
                    {
                        <div class="wa-prog-item">
                            <span class="wa-prog-ico">🕒</span>
                            <div class="wa-prog-item-body">
                                <div class="wa-prog-item-cuando">
                                    @CuandoLindo(pr.ProgramadoPara.ToArTime())
                                    @if (pr.Tipo == "PLANTILLA") { <span class="wa-prog-tag">plantilla</span> }
                                    else if (pr.Tipo == "ADJUNTO") { <span class="wa-prog-tag">📎 @pr.MediaFilename</span> }
                                    @if (!string.IsNullOrWhiteSpace(pr.CreadoPorNombre)) { <span class="wa-prog-quien">· lo dejó @pr.CreadoPorNombre</span> }
                                </div>
                                <div class="wa-prog-item-txt" title="@ProgTextoDe(pr)">@ProgTextoDe(pr)</div>
                            </div>
                            <button class="wa-prog-ya" @onclick="@(() => EnviarProgramadoYa(pr))" disabled="@progTrabajando"
                                    title="Mandarlo ahora mismo, sin esperar a la hora">Mandar ya</button>
                            <button class="wa-prog-x" @onclick="@(() => CancelarProgramado(pr))" disabled="@progTrabajando"
                                    title="Cancelar: no se manda">✖</button>
                        </div>
                    }
                    @foreach (var pr in ProgramadosFallados())
                    {
                        <div class="wa-prog-item fallado">
                            <span class="wa-prog-ico">⚠️</span>
                            <div class="wa-prog-item-body">
                                <div class="wa-prog-item-cuando">No salió el mensaje de @CuandoLindo(pr.ProgramadoPara.ToArTime())</div>
                                <div class="wa-prog-item-txt">@pr.Error</div>
                            </div>
                        </div>
                    }
                </div>
            }
            @* 2026-08-05: los dos carteles verdes ("Le respondés desde…" y "Te quedan…") se movieron
               abajo del cuadro de escribir, uno al lado del otro, para ocupar menos alto. *@
            @if (Ventana24Abierta() || EsChatInstagram())
            {
                @* 2026-08-05: FIRMA de Depósito — quién responde. Lo que escriban sale firmado
                   "OK (alex)". Obligatorio: si no eligieron, no deja enviar. Solo para Depósito. *@
                @if (esDeposito)
                {
                    <div class="wa-firma-bar">
                        <span class="wa-firma-lbl">✍️ Responde:</span>
                        @foreach (var f in FirmantesDeposito)
                        {
                            <button class="wa-firma-op @(firmante == f ? "sel" : "")" @onclick="() => ElegirFirmante(f)">@f</button>
                        }
                        @if (!string.IsNullOrEmpty(firmante))
                        {
                            <span class="wa-firma-hint">sale como <b>… (@firmante)</b></span>
                        }
                        else
                        {
                            <span class="wa-firma-hint wa-firma-falta">👈 elegí quién responde</span>
                        }
                    </div>
                }
                @* 2026-08-06: PRESENCIA — franja discreta: quién más está viendo/escribiendo este chat. *@
                @if (OtrosViewers(ConvIdActual()) is { Count: > 0 } _otros)
                {
                    <div class="wa-presencia">
                        <span class="wa-presencia-dot"></span>
                        @if (_otros.Where(v => v.IsTyping).ToList() is { Count: > 0 } _tip)
                        {
                            <span><b>@string.Join(", ", _tip.Select(v => v.UserName))</b> está@(_tip.Count > 1 ? "n" : "") escribiendo…</span>
                        }
                        else
                        {
                            <span><b>@string.Join(", ", _otros.Select(v => v.UserName))</b> está@(_otros.Count > 1 ? "n" : "") viendo esta conversación</span>
                        }
                    </div>
                }
                @* Aviso ÁMBAR: el otro está escribiendo Y yo también → alerta (solo visual, no bloquea). *@
                @if (yoTipeando && OtrosViewers(ConvIdActual()).Where(v => v.IsTyping).ToList() is { Count: > 0 } _tipA)
                {
                    <div class="wa-presencia-alerta">
                        ⚠️ <b>@string.Join(", ", _tipA.Select(v => v.UserName))</b> también está@(_tipA.Count > 1 ? "n" : "") escribiendo
                    </div>
                }
                @* 2026-08-05: BANDEJA DE PENDIENTES — adjuntos esperando salir. Se envían todos juntos
                   (con el texto del cajón de pie del primero) al tocar Enviar o Enter. *@
                @if (pendientes.Count > 0)
                {
                    <div class="wa-pending-tray">
                        <div class="wa-pending-head">📎 Para enviar (@pendientes.Count) — escribí un texto si querés y tocá <b>Enviar</b></div>
                        <div class="wa-pending-items">
                            @foreach (var p in pendientes)
                            {
                                <div class="wa-pending-item">
                                    @if (!string.IsNullOrEmpty(p.PreviewUrl))
                                    {
                                        @* 2026-08-19: la miniatura medía 34 px — no alcanzaba para darse cuenta
                                           de que era la foto equivocada. Ahora es más grande y al tocarla se abre
                                           en grande con el mismo visor de las fotos del chat. *@
                                        <img class="wa-pending-thumb" src="@p.PreviewUrl" alt="" loading="lazy"
                                             title="Tocá para verla en grande antes de mandarla"
                                             @onclick="@(() => AbrirVisorImagen(p.PreviewUrl!, p.FileName))" />
                                    }
                                    else
                                    {
                                        <span class="wa-pending-ico">@p.Icono</span>
                                    }
                                    <span class="wa-pending-name" title="@p.Label">@p.Label</span>
                                    <button class="wa-pending-x" @onclick="() => QuitarPendiente(p)" title="Sacar de la lista">×</button>
                                </div>
                            }
                        </div>
                    </div>
                }
                @* 2026-08-05: barra "respondiendo a…" (responder citando). Aparece arriba del cajón. *@
                @if (replyingTo != null)
                {
                    <div class="wa-reply-bar">
                        <div class="wa-reply-bar-icon">↩️</div>
                        <div class="wa-reply-bar-body">
                            <div class="wa-reply-bar-who">Respondiendo a @(replyingTo.Direccion == "OUTGOING" ? "vos mismo" : MostrarNombre(SelectedConv()))</div>
                            <div class="wa-reply-bar-text">@PreviewMensajeParaResponder(replyingTo)</div>
                        </div>
                        <button class="wa-reply-bar-x" @onclick="CancelarResponder" title="Cancelar respuesta">×</button>
                    </div>
                }
                @* 2026-08-17: el cajón pasó a DOS renglones: arriba la tira de herramientas (antes
                   era una columna al costado que medía 230 px de alto) y abajo el cuadro con Enviar. *@
                <div class="wa-composer">
                    @* 2026-08-18: confirmación antes de mandarle el menú de opciones al cliente. *@
                    @if (confirmarMenuRol)
                    {
                        <div class="wa-confirmar-menurol">
                            <span class="wa-confirmar-txt">
                                ¿Le mando el menú de opciones ("¿con quién te querés contactar?") a
                                <strong>@(SelectedConv()?.ClienteNombre ?? SelectedConv()?.NombrePerfil ?? selectedNumero)</strong>?
                            </span>
                            <button class="wa-confirmar-no" @onclick="@(() => confirmarMenuRol = false)">No</button>
                            <button class="wa-confirmar-si" @onclick="ConfirmarYEnviarMenuRol" disabled="@enviandoMenuRol">
                                @(enviandoMenuRol ? "Enviando…" : "Sí, mandalo")
                            </button>
                        </div>
                    }
                    <div class="wa-composer-tools-row">
                        @* MENÚ ROL — antes era una miniatura de 110 px del cartel que le llega al cliente.
                           Ahora es un botón de la tira; la miniatura aparece al pasarle el mouse por encima. *@
                        @if (SelectedConv()?.Canal != "INSTAGRAM")
                        {
                            @* 2026-08-18: antes salía de un toque. Ahora pregunta primero (mismo criterio que el celu). *@
                            <button class="wa-menurol-mini" @onclick="@(() => confirmarMenuRol = true)" disabled="@enviandoMenuRol"
                                    title="Tocá para enviarle al cliente este menú y que se identifique (Frikaf / Intervent / Intereventos)">
                                <span class="wa-menurol-cap">@(enviandoMenuRol ? "⏳ Enviando…" : "👆 Menú rol")</span>
                                <span class="wa-menurol-bubble">
                                    <span class="wa-menurol-txt">¡Hola! 👋 Gracias por escribirnos.<br />¿Con quién te querés contactar?</span>
                                    <span class="wa-menurol-opt">☕ Cafés Frikaf</span>
                                    <span class="wa-menurol-opt">🏢 Intervent</span>
                                    <span class="wa-menurol-opt">🪑 Intereventos</span>
                                </span>
                            </button>
                        }
                        <div class="wa-composer-tools">
                            @* Botón adjuntar archivo de la PC *@
                            <label class="wa-attach-btn @(uploading ? "uploading" : "")" title="Adjuntar archivo de tu PC (máx 16 MB)">
                                <InputFile OnChange="OnArchivoSeleccionado" disabled="@(uploading || sending)" style="display:none;" />
                                @(uploading ? "⏳" : "📎")
                            </label>
                            @* Botón adjuntar desde el servidor *@
                            <button class="wa-attach-btn" title="Adjuntar del servidor (cobranzas, uploads previos)" @onclick="AbrirAdjuntarServidor" disabled="@(uploading || sending)">🗂️</button>
                            @* 2026-07-29: Enviar saldo de un cliente *@
                            <button class="wa-attach-btn wa-saldo-btn" title="Enviar saldo (deuda) de un cliente" @onclick="ToggleSaldoPanel" disabled="@(uploading || sending)">💰</button>
                            @* 2026-07-29: Pasar CBU / datos bancarios *@
                            <button class="wa-attach-btn wa-cbu-btn" title="Pasar un CBU / datos bancarios al cliente" @onclick="ToggleCbuPanel" disabled="@(uploading || sending)">🏦</button>
                            @* 2026-08-02: compartir una tarjeta de contacto *@
                            <button class="wa-attach-btn" title="Compartir un contacto (tarjeta con nombre y número)" @onclick="ToggleContactoPanel" disabled="@(uploading || sending)">👤</button>
                            @* 2026-08-26: programar el mensaje para más tarde ("escribile a la tarde") *@
                            <button class="wa-attach-btn wa-prog-btn @(progPendientes.Count > 0 ? "tiene" : "")"
                                    title="Programar este mensaje para más tarde. La espera la cuenta el servidor: podés cerrar la pestaña que sale igual."
                                    @onclick="ToggleProgramarPanel" disabled="@(uploading || sending)">
                                🕒@(progPendientes.Count > 0 ? $" {progPendientes.Count}" : "")
                            </button>
                            @* 2026-08-01: nota de voz (micrófono) *@
                            @if (!grabandoAudio)
                            {
                                <button class="wa-attach-btn wa-mic-btn" title="Grabar nota de voz" @onclick="ToggleGrabarAudio" disabled="@(uploading || sending || enviandoAudio)">@(enviandoAudio ? "⏳" : "🎤")</button>
                            }
                            else
                            {
                                <button class="wa-attach-btn wa-mic-rec" title="Parar y enviar" @onclick="ToggleGrabarAudio">⏹️</button>
                                <button class="wa-attach-btn" title="Cancelar" @onclick="CancelarAudio">✖️</button>
                                <span class="wa-mic-rec-label">● grabando…</span>
                            }
                        </div>
                        @* 2026-08-17: "Alta de clientes" y "Respuestas" subieron acá desde la columna
                           de la derecha. Así no quedan dos columnas pegadas contra el borde derecho
                           (la del cajón y la del panel) y el cuadro de escribir gana ese lugar. *@
                        <button class="wa-alta-cliente-btn" @onclick="InsertarLinkAltaCliente" title="Insertar el link de alta de clientes en el mensaje">
                            🔗 Alta de clientes
                        </button>
                        @if (respuestas.Any(r => r.Activo) && (Ventana24Abierta() || EsChatInstagram()))
                        {
                            <div class="wa-qr">
                                <button class="wa-qr-toggle @(showQuickReplies ? "abierto" : "")" @onclick="@(() => showQuickReplies = !showQuickReplies)" title="Respuestas rápidas guardadas — insertan el texto en el mensaje">
                                    ⚡ Respuestas @(showQuickReplies ? "▾" : "▴")
                                </button>
                                @if (showQuickReplies)
                                {
                                    <div class="wa-qr-dropdown">
                                        @foreach (var r in respuestas.Where(x => x.Activo).OrderBy(x => x.Orden))
                                        {
                                            <button class="wa-chip" @onclick="@(() => { InsertarRespuesta(r); showQuickReplies = false; })" title="@r.Texto">
                                                @r.Nombre
                                            </button>
                                        }
                                    </div>
                                }
                            </div>
                        }
                    </div>
                    @* 2026-07-23: @bind:event="oninput" es CLAVE — sin esto el texto solo se guarda al salir del
   campo, y al apretar Enter el sistema veia el mensaje vacio (no enviaba nada). *@
                    @* 2026-08-17: rows="1" + el crecimiento automático de wa-composer.js. Antes tenía
                       145 px de alto fijo aunque escribieras una palabra. La LETRA sigue grande. *@
                    @* 2026-08-26: mientras el panel del reloj está abierto, ESTE cuadro pasa a "modo
                       programar": se pinta de ámbar y el botón verde deja de mandar ya. Antes había dos
                       botones vivos a la vez (Enviar acá abajo, "Dejarlo programado" arriba) y el dedo
                       iba por inercia al de siempre: el mensaje salía en el momento. *@
                    @if (ProgramandoDesdeComposer())
                    {
                        <div class="wa-composer-prog-aviso">
                            <span>🕒 Estás <b>programando</b>: esto sale @CuandoLindo(progCuando), no ahora.</span>
                            <button class="wa-composer-prog-salir" @onclick="CerrarProgramar">Cancelar y mandar normal</button>
                        </div>
                    }
                    <div class="wa-composer-main @(ProgramandoDesdeComposer() ? "programando" : "")">
                        <textarea class="form-control wa-composer-input" placeholder="@(ProgramandoDesdeComposer() ? $"Escribí lo que se manda {CuandoLindo(progCuando)}… (Enter para dejarlo programado)" : "Escribir mensaje… (Enter para enviar, Shift+Enter para renglón nuevo)")" @bind="composerText" @bind:event="oninput" rows="1"></textarea>
                        @if (ProgramandoDesdeComposer())
                        {
                            <button class="btn wa-enviar-btn wa-programar-btn" @onclick="ProgramarAhora" disabled="@(progGuardando || !SePuedeProgramar())">
                                @(progGuardando ? "⏳ Programando…" : (pendientes.Count > 0 ? $"🕒 Programar ({pendientes.Count} 📎)" : "🕒 Programar"))
                            </button>
                        }
                        else
                        {
                            <button class="btn btn-success wa-enviar-btn @(sending ? "enviando" : "")" @onclick="EnviarMensaje" disabled="@((string.IsNullOrWhiteSpace(composerText) && pendientes.Count == 0) || sending)">
                                @(sending ? "⏳ Enviando…" : (pendientes.Count > 0 ? $"📤 Enviar ({pendientes.Count} 📎)" : "📤 Enviar"))
                            </button>
                        }
                    </div>
                </div>
            }
            else if (EsChatInstagram())
            {
                <div class="wa-plantilla-chat wa-plantilla-chat-ig">
                    <div class="wa-plantilla-chat-head">
                        <span class="wa-plantilla-chat-ico">📷</span>
                        <div>
                            <div class="wa-plantilla-chat-title">Pasaron más de 24 hs</div>
                            <div class="wa-plantilla-chat-sub">En Instagram no se puede escribir fuera de las 24 hs (no hay plantillas). Hay que esperar a que te vuelva a escribir.</div>
                        </div>
                    </div>
                </div>
            }
            else
            {
                @* Ventana cerrada en WhatsApp → elegí una plantilla acá mismo, sin salir del chat *@
                <div class="wa-plantilla-chat">
                    <div class="wa-plantilla-chat-head">
                        <span class="wa-plantilla-chat-ico">✍️</span>
                        <div>
                            <div class="wa-plantilla-chat-title">Escribile con una plantilla</div>
                            <div class="wa-plantilla-chat-sub">Como pasaron más de 24 hs, WhatsApp pide una plantilla aprobada para volver a escribirle. Cuando te responda, ya le escribís libre otra vez.</div>
                        </div>
                    </div>
                    @if (nvPlantillas.Count == 0)
                    {
                        <div class="wa-plantilla-chat-empty">No hay plantillas aprobadas disponibles. Revisá la configuración de WhatsApp.</div>
                    }
                    else
                    {
                        <select class="wa-nv-input" value="@chatPlantillaName" @onchange="OnChatPlantillaChange">
                            <option value="">— Elegí una plantilla —</option>
                            @foreach (var p in nvPlantillas)
                            {
                                <option value="@p.Name">@NombrePlantillaLindo(p.Name) (@p.Category.ToLower())</option>
                            }
                        </select>
                        @if (ChatPlantillaSel() is {} cpSel)
                        {
                            @if (cpSel.VariableCount > 0)
                            {
                                <div style="margin-top:0.5rem;">
                                    @for (int i = 0; i < cpSel.VariableCount; i++)
                                    {
                                        var idx = i;
                                        <input class="wa-nv-input" style="margin-bottom:0.4rem;"
                                               placeholder="@PlaceholderVar(cpSel, idx)"
                                               value="@(idx < chatVariables.Count ? chatVariables[idx] : "")"
                                               @oninput="e => SetChatVariable(idx, e.Value?.ToString() ?? string.Empty)" />
                                    }
                                </div>
                            }
                            <div class="wa-nv-preview" style="margin-top:0.5rem;">@ChatPreviewTexto()</div>
                            <button class="wa-nueva-btn" style="margin-top:0.6rem;" disabled="@chatPlantillaEnviando" @onclick="EnviarPlantillaEnChat">
                                <span class="wa-nueva-ico">📨</span> @(chatPlantillaEnviando ? "Enviando…" : "Enviar plantilla")
                            </button>
                        }
                    }
                </div>
            }
            @* 2026-08-17: los avisos van TODOS en un solo renglón fino (antes eran tres renglones:
               dos carteles verdes + la explicación larga de la regla de las 24 hs, que ahora es el
               globito del 💡 — el texto completo sigue estando, al pasar el mouse). *@
            <div class="wa-avisos-row">
                <span class="wa-avisos-regla" title="Regla de WhatsApp: podés responder gratis a quien te haya escrito en las últimas 24 hs. Para escribir primero hacen falta plantillas aprobadas por Meta.">💡</span>
                @if (LineasDetectadas().Count > 1 && SelectedConv()?.LineaNumero is string _lnResp)
                {
                    <div class="wa-composer-linea" title="La respuesta le llega desde este número tuyo, el mismo por el que el cliente te escribió.">
                        📱 Le respondés desde <b>@LineaNombre(SelectedConv()?.Linea, _lnResp)</b>
                    </div>
                }
                @if (Restante24hs() is TimeSpan _tv && _tv > TimeSpan.Zero)
                {
                    <div class="wa-vent24 @(_tv.TotalHours < 1 ? "urgente" : "ok")" title="Tiempo que te queda para escribirle sin plantilla. Se reinicia cada vez que el cliente te escribe.">
                        <span class="wa-vent24-reloj">⏳</span>
                        <span>Te quedan <b>@FormatoRestante(_tv)</b> para escribirle libre</span>
                    </div>
                }
                else
                {
                    <div class="wa-vent24 cerrada" title="Se cerró la ventana de 24 hs">
                        <span class="wa-vent24-dot"></span>
                        <span>@(UltimoEntranteAt() == null ? "Todavía no te escribió — arrancá con una plantilla" : "Se cerró la ventana de 24 hs")</span>
                    </div>
                }
            </div>
        }
    </div>

    @* ══════════ PANEL DERECHO (contacto + conversación) ══════════
       Vive al lado del chat, no arriba, así no le come alto a los mensajes.
       Se pliega con la tira de iconos del borde y queda guardado para la próxima vez. *@
    @if (selectedNumero is not null)
    {
        @* 2026-08-27: este espacio ya no es un panel que se abre y se cierra a mano. Aparece SOLO
           cuando entrás al Modo venta 🛒 o al Modo MercadoLibre 🤝, y se va cuando los cerrás con su ×. *@
        @if (modoVenta || modoMeli || modoAlquiler)
        {
            @* 2026-08-20: MODO VENTA — el panel de la derecha se transforma en el armado de la
               venta, SIN salir del chat ni abrir otra pestaña. Pedido del dueño: "que el chat se
               transforme y me aparezcan las opciones para cargar la venta mientras chateo".
               La charla se sigue leyendo y contestando normal al lado. *@
            @if (modoVenta)
            {
                @* 2026-08-24: el modo venta pasó a 3 BLOQUES con el título tocable. Antes era una
                   sola lista larguísima y en 340 px de ancho no entraba nada. Los bloques NO son un
                   asistente obligatorio: se puede saltar del ① al ③ sin pasar por el ②, así la venta
                   de siempre ("repetir la anterior → crear") sigue siendo dos toques. *@
                <aside class="wa-ctx wa-mv">
                    <div class="wa-mv-top">
                        <span class="wa-mv-tit">🛒 Modo venta</span>
                        <button class="wa-ficha-x" @onclick="CerrarModoVenta" title="Salir del modo venta">×</button>
                    </div>

                    @* ═══════════ ① QUÉ LLEVA ═══════════ *@
                    <button class="wa-mv-paso @(mvPaso == 1 ? "abierto" : "")" @onclick="() => IrAPaso(1)">
                        <span class="wa-mv-paso-n">①</span>
                        <span class="wa-mv-paso-t">Qué lleva</span>
                        <span class="wa-mv-paso-r">@ResumenPaso1()</span>
                        <span class="wa-mv-paso-f">@(mvPaso == 1 ? "▲" : "▼")</span>
                    </button>
                    @if (mvPaso == 1)
                    {
                        <div class="wa-mv-cuerpo">
                            @* A nombre de quién va. Se toca y se cambia: en el chat del hermano vienen
                               pedidos de otros clientes. *@
                            <button class="wa-mv-cli" @onclick="CambiarClienteModoVenta"
                                    title="Tocá para mandar esta venta a otro cliente (o crear uno nuevo)">
                                <span class="wa-mv-cli-nom">@(mvClienteNombre ?? "Elegí a quién le vendés")</span>
                                <span class="wa-mv-cli-cta">cambiar</span>
                            </button>

                            @if (mvClienteId is null)
                            {
                                <div class="wa-mv-vacio">Tocá el recuadro de arriba y elegí el cliente.</div>
                            }
                            else
                            {
                                @* ── Repetir una venta anterior ── *@
                                <div class="wa-mv-sec-t">Repetir una anterior</div>
                                @if (mvCargandoAnteriores)
                                {
                                    <div class="wa-mv-vacio">⏳ Buscando las últimas…</div>
                                }
                                else if (mvAnteriores.Count == 0)
                                {
                                    <div class="wa-mv-vacio">Este cliente todavía no tiene comprobantes para repetir.</div>
                                }
                                else
                                {
                                    @foreach (var ant in mvAnteriores.Take(mvVerTodasAnteriores ? 20 : 2))
                                    {
                                        <button class="wa-mv-ant" @onclick="() => RepetirVenta(ant)" disabled="@(mvRepitiendo != null)"
                                                title="Cargar acá abajo lo mismo que tenía @ant.Numero, con los precios de esa factura">
                                            <span class="wa-mv-ant-l1">
                                                <span class="wa-mv-ant-num">@ant.Numero</span>
                                                <span class="wa-mv-ant-tot">@Plata(ant.Total)</span>
                                            </span>
                                            <span class="wa-mv-ant-l2">
                                                <span>@ant.Fecha.ToString("dd/MM/yy") · @Antiguedad(ant.Fecha)</span>
                                                <span class="wa-mv-ant-cta">@(mvRepitiendo == ant.Id ? "⏳ cargando…" : "📋 Repetir")</span>
                                            </span>
                                        </button>
                                    }
                                    @if (mvAnteriores.Count > 2)
                                    {
                                        <button class="wa-mv-mas" @onclick="() => mvVerTodasAnteriores = !mvVerTodasAnteriores">
                                            @(mvVerTodasAnteriores ? "▲ Ver menos" : $"▼ Ver anteriores ({mvAnteriores.Count - 2} más)")
                                        </button>
                                    }
                                }

                                @* ── Sumar productos ── *@
                                <div class="wa-mv-sec-t">Sumar productos</div>
                                <div class="wa-mv-busc">
                                    <span>🔍</span>
                                    <input class="wa-mv-busc-inp" placeholder="Buscar producto por nombre o código…"
                                           value="@mvBusqueda" @oninput="OnBuscarProducto" autocomplete="off" />
                                    @if (!string.IsNullOrWhiteSpace(mvBusqueda))
                                    {
                                        <button class="wa-mv-busc-x" @onclick="LimpiarBusquedaProducto" title="Borrar la búsqueda">✕</button>
                                    }
                                </div>
                                @if (mvCargandoProductos)
                                {
                                    <div class="wa-mv-vacio">⏳ Cargando el catálogo…</div>
                                }
                                else if (!string.IsNullOrWhiteSpace(mvBusqueda))
                                {
                                    @if (mvResultados.Count == 0)
                                    {
                                        <div class="wa-mv-vacio">No encontré ningún producto con eso.</div>
                                    }
                                    else
                                    {
                                        <div class="wa-mv-res">
                                            @foreach (var pr in mvResultados)
                                            {
                                                <button class="wa-mv-res-item" @onclick="() => SumarProducto(pr.Id)" disabled="@mvCotizando"
                                                        title="Sumar @pr.Nombre a la venta">
                                                    <span class="wa-mv-res-nom">@pr.Nombre</span>
                                                    @if (!string.IsNullOrWhiteSpace(pr.Sku)) { <span class="wa-mv-res-sku">@pr.Sku</span> }
                                                </button>
                                            }
                                        </div>
                                    }
                                }
                                else if (mvTop.Count > 0)
                                {
                                    <div class="wa-mv-top-lbl">Lo que más compra:</div>
                                    <div class="wa-mv-tops">
                                        @foreach (var t in mvTop)
                                        {
                                            <button class="wa-mv-top-chip" @onclick="() => SumarTop(t)" disabled="@mvCotizando"
                                                    title="@($"Lo compró {t.TimesOrdered} veces — la última el {t.LastPurchase:dd/MM/yy}")">
                                                + @t.Nombre
                                                @if (FormatoLabelCorto(t.Formato) is string _tf) { <span class="wa-mv-linea-fmt">@_tf</span> }
                                            </button>
                                        }
                                    </div>
                                }

                                @* ── Renglón escrito a mano (algo que no está en el catálogo) ── *@
                                @if (!mvMostrarLibre)
                                {
                                    <button class="wa-mv-mas" @onclick="() => mvMostrarLibre = true"
                                            title="Para algo que no está en el catálogo: lo escribís y le ponés el precio">✏️ Escribir un renglón a mano</button>
                                }
                                else
                                {
                                    <div class="wa-mv-libre">
                                        <input class="wa-mv-inp" placeholder="Qué es (ej. Flete hasta Escobar)" @bind="mvLibreDesc" @bind:event="oninput" />
                                        <div class="wa-mv-libre-l2">
                                            <input class="wa-mv-inp wa-mv-inp-plata" placeholder="Precio" inputmode="decimal"
                                                   @bind="mvLibrePrecio" @bind:event="oninput" onfocus="this.select()" />
                                            <button class="wa-mv-libre-ok" @onclick="SumarRenglonLibre" disabled="@mvCotizando">Sumar</button>
                                            <button class="wa-mv-libre-x" @onclick="() => mvMostrarLibre = false">✕</button>
                                        </div>
                                    </div>
                                }

                                @* ── El carrito ── *@
                                @if (mvItems.Count > 0)
                                {
                                    <div class="wa-mv-sec-t">
                                        La venta
                                        @if (!string.IsNullOrWhiteSpace(mvOrigenNumero)) { <span class="wa-mv-origen">copia de @mvOrigenNumero</span> }
                                    </div>
                                    <div class="wa-mv-lineas">
                                        @for (int i = 0; i < mvItems.Count; i++)
                                        {
                                            var idx = i;
                                            var li = mvItems[idx];
                                            <div class="wa-mv-linea">
                                                <div class="wa-mv-linea-nom" title="@li.Nombre">
                                                    @li.Nombre
                                                    @if (!string.IsNullOrWhiteSpace(li.FormatoLabel)) { <span class="wa-mv-linea-fmt">@li.FormatoLabel</span> }
                                                    @if (!string.IsNullOrWhiteSpace(li.Req.Molienda)) { <span class="wa-mv-linea-fmt wa-mv-linea-mol">@MoliendaCorta(li.Req.Molienda)</span> }
                                                    @if (EnvaseLabelCorto(li) is string _el) { <span class="wa-mv-linea-fmt">@_el</span> }
                                                    @if (li.Req.DescuentoPct > 0) { <span class="wa-mv-linea-fmt wa-mv-linea-desc">−@li.Req.DescuentoPct%</span> }
                                                    @if (li.Req.PrecioUnitarioOverride is not null && !li.Req.EsConceptoLibre) { <span class="wa-mv-linea-fmt wa-mv-linea-desc">precio a mano</span> }
                                                </div>
                                                <div class="wa-mv-linea-ctrl">
                                                    <button class="wa-mv-qbtn" @onclick="() => CambiarCantidad(idx, -1)" disabled="@mvCotizando" title="Uno menos">−</button>
                                                    <input class="wa-mv-qinp" type="text" inputmode="numeric" value="@li.CantidadTxt"
                                                           @onchange="(e) => EscribirCantidad(idx, e.Value?.ToString())"
                                                           onfocus="this.select()" title="Cantidad" />
                                                    <button class="wa-mv-qbtn" @onclick="() => CambiarCantidad(idx, 1)" disabled="@mvCotizando" title="Uno más">+</button>
                                                    <span class="wa-mv-linea-sub">@Plata(li.Subtotal)</span>
                                                    <button class="wa-mv-qbtn @(mvLineaAbierta == idx ? "on" : "")" @onclick="() => ToggleDetalleLinea(idx)"
                                                            title="Molienda, envase, formato, precio y descuento de este renglón">✏️</button>
                                                    <button class="wa-mv-quitar" @onclick="() => QuitarLinea(idx)" disabled="@mvCotizando" title="Sacar este renglón">🗑</button>
                                                </div>

                                                @* Detalle del renglón: se abre con el ✏️ para no llenar el panel. *@
                                                @if (mvLineaAbierta == idx)
                                                {
                                                    <div class="wa-mv-det">
                                                        @if (!li.Req.EsConceptoLibre)
                                                        {
                                                            <label class="wa-mv-det-lbl">Formato</label>
                                                            <select class="wa-mv-det-sel" value="@li.Req.Formato"
                                                                    @onchange="(e) => CambiarFormatoLinea(idx, e.Value?.ToString())">
                                                                @foreach (var op in FormatoOpciones(ProductoDe(li), li.Req.Formato))
                                                                {
                                                                    <option value="@op.Item1">@op.Item2</option>
                                                                }
                                                            </select>

                                                            @if (EsCafe(li))
                                                            {
                                                                <label class="wa-mv-det-lbl">Molienda</label>
                                                                <select class="wa-mv-det-sel wa-mv-det-mol" value="@(li.Req.Molienda ?? "EN GRANOS")"
                                                                        @onchange="(e) => CambiarMoliendaLinea(idx, e.Value?.ToString())">
                                                                    <option value="EN GRANOS">🫘 EN GRANOS</option>
                                                                    <option value="MOLIDO FILTRO">☕ MOLIDO FILTRO</option>
                                                                    <option value="MOLIDO EXPRESS">⚡ MOLIDO EXPRESS</option>
                                                                    <option value="MOLIDO MOKA">☕ MOLIDO MOKA</option>
                                                                    <option value="MOLIDO BODUM">☕ MOLIDO BODUM</option>
                                                                    <option value="MOLIDO PRENSA FRANCESA">☕ MOLIDO PRENSA FRANCESA</option>
                                                                    <option value="MOLIDO CAFETERA ITALIANA">☕ MOLIDO CAFETERA ITALIANA</option>
                                                                    <option value="MOLIDO A LA TURCA">☕ MOLIDO A LA TURCA</option>
                                                                    <option value="MINI EXPRESS">🔸 MINI EXPRESS</option>
                                                                </select>

                                                                <label class="wa-mv-det-lbl">Envase</label>
                                                                <select class="wa-mv-det-sel" value="@EnvaseDe(li)"
                                                                        @onchange="(e) => CambiarEnvaseLinea(idx, e.Value?.ToString())">
                                                                    <option value="NEGRO">⚫ Envase negro</option>
                                                                    <option value="PLATEADO">⚪ Envase plateado</option>
                                                                    <option value="DOY_PACK">📦 Doy pack</option>
                                                                </select>
                                                            }
                                                        }

                                                        <div class="wa-mv-det-2col">
                                                            <div>
                                                                <label class="wa-mv-det-lbl">Precio unitario</label>
                                                                <input class="wa-mv-inp wa-mv-inp-plata" inputmode="decimal" placeholder="del catálogo"
                                                                       value="@li.PrecioTxt" onfocus="this.select()"
                                                                       @onchange="(e) => CambiarPrecioLinea(idx, e.Value?.ToString())" />
                                                            </div>
                                                            <div>
                                                                <label class="wa-mv-det-lbl">Descuento %</label>
                                                                <input class="wa-mv-inp" inputmode="decimal" placeholder="0"
                                                                       value="@li.DescuentoTxt" onfocus="this.select()"
                                                                       @onchange="(e) => CambiarDescuentoLinea(idx, e.Value?.ToString())" />
                                                            </div>
                                                        </div>
                                                        @if (li.Req.PrecioUnitarioOverride is not null && !li.Req.EsConceptoLibre)
                                                        {
                                                            <button class="wa-mv-det-volver" @onclick="() => VolverAlPrecioDeLista(idx)">↩ Volver al precio de lista</button>
                                                        }
                                                    </div>
                                                }

                                                @if (!string.IsNullOrWhiteSpace(li.Aviso))
                                                {
                                                    <div class="wa-mv-aviso">⚠️ @li.Aviso</div>
                                                }
                                            </div>
                                        }
                                    </div>
                                    <button class="wa-mv-limpiar" @onclick="LimpiarCarrito" disabled="@mvCreando">Vaciar y empezar de nuevo</button>
                                }
                            }
                        </div>
                    }

                    @* ═══════════ ② CÓMO VA ═══════════ *@
                    <button class="wa-mv-paso @(mvPaso == 2 ? "abierto" : "")" @onclick="() => IrAPaso(2)">
                        <span class="wa-mv-paso-n">②</span>
                        <span class="wa-mv-paso-t">Cómo va</span>
                        <span class="wa-mv-paso-r">@ResumenPaso2()</span>
                        <span class="wa-mv-paso-f">@(mvPaso == 2 ? "▲" : "▼")</span>
                    </button>
                    @if (mvPaso == 2)
                    {
                        <div class="wa-mv-cuerpo">
                            <div class="wa-mv-nota">Ya viene completo con lo de siempre. Si no tocás nada, sale así.</div>

                            <div class="wa-mv-sec-t">Comprobante</div>
                            <div class="wa-mv-ops">
                                @foreach (var tc in new[] { "X", "PRO", "FA", "FB", "FC" })
                                {
                                    <button class="wa-mv-op @(mvTipoComprobante == tc ? "on" : "") @(tc is "FA" or "FB" or "FC" ? "wa-mv-op-arca" : "")"
                                            @onclick="() => CambiarTipoComprobante(tc)" disabled="@mvCotizando">@TipoLabel(tc)</button>
                                }
                            </div>
                            @if (mvTipoComprobante is "FA" or "FB" or "FC")
                            {
                                <div class="wa-mv-arca-aviso">⚠️ Al crearla se emite en ARCA con CAE de verdad.</div>
                            }

                            <div class="wa-mv-sec-t">Cómo paga</div>
                            <div class="wa-mv-ops">
                                @foreach (var cp in PagosPosibles)
                                {
                                    <button class="wa-mv-op @(mvCondicionPago == cp ? "on" : "")" @onclick="() => mvCondicionPago = cp">@PagoLabel(cp)</button>
                                }
                            </div>

                            <div class="wa-mv-sec-t">Cómo la recibe</div>
                            <div class="wa-mv-ops">
                                <button class="wa-mv-op @(!mvRetira ? "on" : "")" @onclick="() => mvRetira = false">🚚 Se lo llevamos</button>
                                <button class="wa-mv-op @(mvRetira ? "on" : "")" @onclick="() => mvRetira = true">🏠 Lo retira</button>
                            </div>

                            @if (!mvRetira && mvDirecciones.Count > 0)
                            {
                                <div class="wa-mv-sec-t">A qué dirección</div>
                                <div class="wa-mv-ops">
                                    <button class="wa-mv-op @(mvDireccionId is null ? "on" : "")" @onclick="() => mvDireccionId = null">La de siempre</button>
                                    @foreach (var d in mvDirecciones)
                                    {
                                        var did = d.Id;
                                        <button class="wa-mv-op @(mvDireccionId == did ? "on" : "")" @onclick="() => mvDireccionId = did"
                                                title="@($"{d.Direccion} {d.Localidad}".Trim())">
                                            📍 @(string.IsNullOrWhiteSpace(d.Etiqueta) ? d.Direccion : d.Etiqueta)
                                        </button>
                                    }
                                </div>
                            }

                            <div class="wa-mv-sec-t">Qué día se entrega</div>
                            <div class="wa-mv-ops">
                                @foreach (var d in DiasSemana)
                                {
                                    <button class="wa-mv-op @(mvDias.Contains(d) ? "on" : "")" @onclick="() => ToggleDiaEntrega(d)">@d</button>
                                }
                            </div>

                            <div class="wa-mv-sec-t">Comentario para armado</div>
                            <textarea class="wa-mv-obs" rows="3" placeholder="Ej: bolsita atada, carga martes…"
                                      @bind="mvComentarioArmado" @bind:event="oninput"></textarea>
                            @if (mensajesSeleccionadosIds.Count > 0 || UltimoEntranteAt() != null)
                            {
                                <button class="wa-mv-mas" @onclick="PegarMensajesEnComentario"
                                        title="Copia acá lo que escribió el cliente en el chat">💬 Pegar los mensajes del chat</button>
                            }
                        </div>
                    }

                    @* ═══════════ ③ CERRAR ═══════════ *@
                    <button class="wa-mv-paso @(mvPaso == 3 ? "abierto" : "")" @onclick="() => IrAPaso(3)">
                        <span class="wa-mv-paso-n">③</span>
                        <span class="wa-mv-paso-t">Cerrar</span>
                        <span class="wa-mv-paso-r">@ResumenPaso3()</span>
                        <span class="wa-mv-paso-f">@(mvPaso == 3 ? "▲" : "▼")</span>
                    </button>
                    @if (mvPaso == 3)
                    {
                        <div class="wa-mv-cuerpo">
                            @if (mvVentaCreadaId is int _vid)
                            {
                                @* Ya está creada: lo único que queda es mandársela. *@
                                <div class="wa-mv-hecho">✅ Venta @mvVentaCreadaNumero creada</div>
                                <a class="wa-mv-op wa-mv-op-ancho" href="/api/cafe/ventas/@_vid/pdf" target="_blank">📄 Ver el comprobante</a>
                                <button class="wa-mv-crear" @onclick="() => MandarComprobanteCreado(_vid)" disabled="@mvEnviandoComprobante">
                                    @(mvEnviandoComprobante ? "⏳ Mandando…" : "🟢 Mandarle el comprobante")
                                </button>
                                <button class="wa-mv-limpiar" @onclick="EmpezarOtraVenta">Empezar otra venta</button>
                            }
                            else if (mvItems.Count == 0)
                            {
                                <div class="wa-mv-vacio">Todavía no cargaste nada. Volvé al bloque ① y sumá productos.</div>
                            }
                            else
                            {
                                <div class="wa-mv-resu">
                                    <div class="wa-mv-resu-l"><span>Cliente</span><b>@mvClienteNombre</b></div>
                                    <div class="wa-mv-resu-l"><span>Comprobante</span><b>@TipoLabel(mvTipoComprobante)</b></div>
                                    <div class="wa-mv-resu-l"><span>Paga</span><b>@PagoLabel(mvCondicionPago)</b></div>
                                    <div class="wa-mv-resu-l"><span>Entrega</span><b>@(mvRetira ? "Lo retira" : "Se lo llevamos")</b></div>
                                    @if (mvDias.Count > 0)
                                    {
                                        <div class="wa-mv-resu-l"><span>Días</span><b>@string.Join(" ", DiasOrdenados())</b></div>
                                    }
                                    <div class="wa-mv-resu-l"><span>Renglones</span><b>@mvItems.Count</b></div>
                                </div>
                                @if (mvTipoComprobante is "FA" or "FB" or "FC")
                                {
                                    <div class="wa-mv-arca-aviso">⚠️ Al tocar el botón se emite @TipoLabel(mvTipoComprobante) en ARCA, con CAE. No es un borrador.</div>
                                }
                                @if (mvItems.Any(l => !string.IsNullOrWhiteSpace(l.Aviso)))
                                {
                                    <div class="wa-mv-arca-aviso">⚠️ Hay renglones sin stock suficiente — miralos en el bloque ①.</div>
                                }
                                <button class="wa-mv-crear" @onclick="CrearVentaModoVenta" disabled="@(mvCreando || mvCotizando || mvTotal <= 0)">
                                    @(mvCreando ? "⏳ Creando la venta…" : $"✅ Crear la venta · {Plata(mvTotal)}")
                                </button>
                            }
                        </div>
                    }

                    @* Total SIEMPRE a la vista, estés en el bloque que estés. *@
                    @if (mvItems.Count > 0 && mvVentaCreadaId is null)
                    {
                        <div class="wa-mv-pie">
                            <span>Total</span>
                            <span class="wa-mv-total-monto">@(mvCotizando ? "⏳" : Plata(mvTotal))</span>
                        </div>
                    }
                </aside>
            }
            @* ══════════ 2026-08-21: MODO MELI — la ficha del comprador de MercadoLibre acá al lado.
               Pedido del dueño: "si me escribe alguien por una publicación o porque compró, pongo
               su usuario y me aparece toda su información para resolver". ══════════ *@
            else if (modoMeli)
            {
                <aside class="wa-ctx wa-mm">
                    <div class="wa-mm-top">
                        <span class="wa-mm-tit">🟡 Modo MercadoLibre</span>
                        <button class="wa-ficha-x" @onclick="CerrarModoMeli" title="Salir del modo MercadoLibre">×</button>
                    </div>

                    <div class="wa-mm-busc">
                        <span>🔍</span>
                        <input class="wa-mm-busc-inp" placeholder="Usuario de MeLi, nombre, teléfono, N° de venta o MLA…"
                               value="@mmBusqueda" @oninput="OnBuscarMeli" @onkeydown="OnEnterBuscarMeli" autocomplete="off" />
                        @if (!string.IsNullOrWhiteSpace(mmBusqueda))
                        {
                            <button class="wa-mm-busc-x" @onclick="LimpiarBusquedaMeli" title="Borrar la búsqueda">✕</button>
                        }
                    </div>

                    @* 2026-08-21: la publicación por la que están preguntando: precio y stock de HOY. *@
                    @if (mmPubli is not null)
                    {
                        <div class="wa-mm-publi">
                            <div class="wa-mm-compra-l1">
                                @if (!string.IsNullOrWhiteSpace(mmPubli.Thumbnail))
                                {
                                    <img class="wa-mm-compra-foto" src="@mmPubli.Thumbnail" alt="" />
                                }
                                <div class="wa-mm-compra-tit" title="@mmPubli.Titulo">@mmPubli.Titulo</div>
                                <button class="wa-ficha-x" @onclick="CerrarPublicacionMeli" title="Cerrar la publicación">×</button>
                            </div>
                            <div class="wa-mm-publi-precio">@Plata(mmPubli.Precio)</div>
                            <div class="wa-mm-chips">
                                <span class="wa-mm-chip @(mmPubli.Stock > 0 ? "" : "rojo")">@(mmPubli.Stock > 0 ? $"{mmPubli.Stock} en stock" : "sin stock")</span>
                                <span class="wa-mm-chip">@mmPubli.EstadoTexto</span>
                                @if (!string.IsNullOrWhiteSpace(mmPubli.Sku)) { <span class="wa-mm-chip">@mmPubli.Sku</span> }
                                @if (!string.IsNullOrWhiteSpace(mmPubli.Cuenta)) { <span class="wa-mm-chip">@mmPubli.Cuenta</span> }
                                @if (mmPubli.Vendidos > 0) { <span class="wa-mm-chip">@mmPubli.Vendidos vendidos</span> }
                            </div>
                            @if (!string.IsNullOrWhiteSpace(mmPubli.TipoEnvio)) { <div class="wa-mm-envio">@mmPubli.TipoEnvio</div> }
                            <div class="wa-mm-acc">
                                @if (!string.IsNullOrWhiteSpace(mmPubli.RespuestaSugerida))
                                {
                                    <button class="wa-mm-btn ok" @onclick="() => PegarRespuestaMeli(mmPubli.RespuestaSugerida!)" title="Poner esta respuesta en el cuadro de escribir">💬 Pegar respuesta</button>
                                }
                                @if (!string.IsNullOrWhiteSpace(mmPubli.Permalink))
                                {
                                    <a class="wa-mm-btn" href="@mmPubli.Permalink" target="_blank" title="Abrir la publicación en MercadoLibre">🔗 Abrir</a>
                                }
                            </div>
                        </div>
                    }

                    @if (mmBuscando)
                    {
                        <div class="wa-mm-vacio">⏳ Buscando…</div>
                    }
                    else if (mmFicha is null)
                    {
                        @if (mmResultados.Count > 0)
                        {
                            <div class="wa-mm-sec-t">@(mmResultados.Count == 1 ? "1 comprador" : $"{mmResultados.Count} compradores")</div>
                            @foreach (var m in mmResultados)
                            {
                                <button class="wa-mm-match" @onclick="() => AbrirFichaMeli(m.BuyerId)" title="Ver toda la información de este comprador">
                                    <span class="wa-mm-match-l1">
                                        <span class="wa-mm-match-nick">@(string.IsNullOrWhiteSpace(m.Nickname) ? $"Comprador {m.BuyerId}" : m.Nickname)</span>
                                        @if (m.Compras > 0) { <span class="wa-mm-match-cnt">@m.Compras compra@(m.Compras == 1 ? "" : "s")</span> }
                                    </span>
                                    <span class="wa-mm-match-l2">
                                        @(string.IsNullOrWhiteSpace(m.Nombre) ? (m.Ciudad ?? "") : m.Nombre)
                                        @if (m.UltimaCompra is DateTime uc) { <span class="wa-mm-match-fec">última: @uc.ToString("dd/MM/yy")</span> }
                                    </span>
                                    <span class="wa-mm-match-por">@m.PorQue</span>
                                </button>
                            }
                        }
                        else if (mmBuscado)
                        {
                            <div class="wa-mm-vacio">
                                No encontré a nadie con eso.<br />
                                Probá con el usuario de MercadoLibre tal cual figura en la pregunta o en la venta.
                            </div>
                        }
                        else
                        {
                            <div class="wa-mm-vacio">
                                Escribí el <b>usuario de MercadoLibre</b> del que te está escribiendo.<br />
                                También sirve el nombre, el teléfono, el número de venta o el código de la publicación (MLA…).
                            </div>
                        }
                    }
                    else
                    {
                        @* ── La ficha del comprador ── *@
                        <div class="wa-mm-cab">
                            <div class="wa-mm-nick">@(string.IsNullOrWhiteSpace(mmFicha.Nickname) ? $"Comprador {mmFicha.BuyerId}" : mmFicha.Nickname)</div>
                            @if (!string.IsNullOrWhiteSpace(mmFicha.Nombre)) { <div class="wa-mm-dato">@mmFicha.Nombre</div> }
                            @if (!string.IsNullOrWhiteSpace(mmFicha.Telefono)) { <div class="wa-mm-dato">📞 @mmFicha.Telefono</div> }
                            @if (!string.IsNullOrWhiteSpace(mmFicha.Direccion) || !string.IsNullOrWhiteSpace(mmFicha.Ciudad))
                            {
                                <div class="wa-mm-dato">📍 @($"{mmFicha.Direccion} {mmFicha.Ciudad} {mmFicha.Provincia}".Trim())</div>
                            }
                            <div class="wa-mm-nums">
                                <span><b>@mmFicha.Compras</b> compra@(mmFicha.Compras == 1 ? "" : "s")</span>
                                @if (mmFicha.TotalGastado > 0) { <span><b>@Plata(mmFicha.TotalGastado)</b> en total</span> }
                                @if (mmFicha.PrimeraCompra is DateTime pc) { <span>cliente desde @pc.ToString("MM/yy")</span> }
                            </div>
                            @if (mmFicha.ClienteVinculadoId is not null)
                            {
                                <div class="wa-mm-vinc ok" title="Este comprador ya está atado a un cliente del sistema">
                                    🔗 Es el cliente <b>@mmFicha.ClienteVinculadoNombre</b>
                                </div>
                            }
                            else if (SelectedConv()?.ClienteId is not null)
                            {
                                <button class="wa-mm-vinc btn" @onclick="VincularCompradorAlChat" disabled="@mmVinculando"
                                        title="Dejarlo atado al cliente de este chat: la próxima vez que escriba lo reconocemos solo">
                                    @(mmVinculando ? "⏳ Vinculando…" : $"🔗 Es {SelectedConv()?.ClienteNombre}")
                                </button>
                            }
                            @* 2026-08-21: dejar el usuario de MeLi pegado a ESTE teléfono. Va aparte
                               del vínculo con el cliente: el que pregunta muchas veces todavía no es
                               cliente nuestro y igual queremos reconocerlo la próxima vez. *@
                            @if (mmAtados.Any(a => a.BuyerId == mmFicha.BuyerId))
                            {
                                <div class="wa-mm-vinc ok" title="Cada vez que escriba este teléfono, la ficha se abre sola">
                                    📌 Guardado en este teléfono
                                    <button class="wa-mm-soltar" @onclick="SoltarUsuarioDelTelefono" disabled="@mmAtando" title="Sacar este usuario del teléfono">quitar</button>
                                </div>
                            }
                            else
                            {
                                <button class="wa-mm-vinc btn amarillo" @onclick="AtarUsuarioAlTelefono" disabled="@mmAtando"
                                        title="Dejar este usuario de MercadoLibre pegado al teléfono: la próxima vez que escriba, la ficha se abre sola">
                                    @(mmAtando ? "⏳ Guardando…" : "📌 Es el usuario de este teléfono")
                                </button>
                            }
                            @if (!string.IsNullOrWhiteSpace(mmFicha.PerfilUrl))
                            {
                                <a class="wa-mm-perfil" href="@mmFicha.PerfilUrl" target="_blank" title="Abrir el perfil del comprador en MercadoLibre">👤 Ver perfil en MercadoLibre</a>
                            }
                            @if (!string.IsNullOrWhiteSpace(mmFicha.Aviso))
                            {
                                <div class="wa-mm-aviso">ℹ️ @mmFicha.Aviso</div>
                            }
                        </div>

                        <div class="wa-mm-sec-t">Sus últimas compras</div>
                        @if (mmFicha.UltimasCompras.Count == 0)
                        {
                            <div class="wa-mm-vacio">Todavía no tiene compras nuestras.</div>
                        }
                        else
                        {
                            @foreach (var c in mmFicha.UltimasCompras)
                            {
                                <div class="wa-mm-compra">
                                    <div class="wa-mm-compra-l1">
                                        @if (!string.IsNullOrWhiteSpace(c.Thumbnail))
                                        {
                                            <img class="wa-mm-compra-foto" src="@c.Thumbnail" alt="" />
                                        }
                                        <div class="wa-mm-compra-tit" title="@c.Items">@c.Items</div>
                                    </div>
                                    <div class="wa-mm-compra-l2">
                                        <span>@(c.Fecha?.ToString("dd/MM/yy") ?? "—")</span>
                                        <span class="wa-mm-compra-tot">@Plata(c.Total)</span>
                                        @if (!string.IsNullOrWhiteSpace(c.Cuenta)) { <span class="wa-mm-compra-cta">@c.Cuenta</span> }
                                    </div>
                                    <div class="wa-mm-estado">@c.EstadoTexto</div>
                                    @if (!string.IsNullOrWhiteSpace(c.TipoEnvio)) { <div class="wa-mm-envio">@c.TipoEnvio</div> }
                                    @if (c.EstimadaHasta is DateTime ee && c.Entregado is null)
                                    {
                                        <div class="wa-mm-envio">Llega estimado el @ee.ToString("dd/MM")</div>
                                    }
                                    @* 2026-08-21: dónde se entrega y quién lo llevó (Flex). *@
                                    @if (!string.IsNullOrWhiteSpace(c.EntregadoPor))
                                    {
                                        <div class="wa-mm-rep">🛵 Lo entregó @c.EntregadoPor</div>
                                    }
                                    else if (!string.IsNullOrWhiteSpace(c.RepartidorAsignado))
                                    {
                                        <div class="wa-mm-rep">🛵 Lo lleva @c.RepartidorAsignado</div>
                                    }
                                    @if (!string.IsNullOrWhiteSpace(c.DomicilioEntrega))
                                    {
                                        <div class="wa-mm-dir" title="Domicilio de entrega">📍 @c.DomicilioEntrega</div>
                                    }
                                    @if (!string.IsNullOrWhiteSpace(c.ComentarioEntrega))
                                    {
                                        <div class="wa-mm-envio">🗒️ @c.ComentarioEntrega</div>
                                    }
                                    <div class="wa-mm-acc">
                                        <button class="wa-mm-btn ok" @onclick="() => PegarRespuestaMeli(c.RespuestaSugerida)"
                                                title="Poner esta respuesta en el cuadro de escribir (podés retocarla antes de mandarla)">💬 Pegar respuesta</button>
                                        @if (!string.IsNullOrWhiteSpace(c.Seguimiento))
                                        {
                                            <button class="wa-mm-btn" @onclick="() => CopiarSeguimientoMeli(c.Seguimiento!)"
                                                    title="Copiar el número de seguimiento @c.Seguimiento">📋 @c.Seguimiento</button>
                                        }
                                        @if (!string.IsNullOrWhiteSpace(c.MapsLink))
                                        {
                                            <a class="wa-mm-btn" href="@c.MapsLink" target="_blank" title="Ver en el mapa el punto exacto donde se entrega">🗺️ Mapa</a>
                                        }
                                        @if (!string.IsNullOrWhiteSpace(c.DomicilioEntrega))
                                        {
                                            <button class="wa-mm-btn" @onclick="() => CopiarDireccionMeli(c.DomicilioEntrega!)" title="Copiar el domicilio de entrega">📋 Dirección</button>
                                        }
                                        @if (!string.IsNullOrWhiteSpace(c.ItemId))
                                        {
                                            <button class="wa-mm-btn" @onclick="() => VerPublicacionMeli(c.ItemId!)" title="Ver precio y stock de hoy de esta publicación">🏷️ Precio y stock</button>
                                        }
                                        @if (!string.IsNullOrWhiteSpace(c.Permalink))
                                        {
                                            <a class="wa-mm-btn" href="@c.Permalink" target="_blank" title="Abrir la publicación en MercadoLibre">🔗 Publicación</a>
                                        }
                                        <button class="wa-mm-btn" @onclick="() => CopiarVentaMeli(c.OrderId)"
                                                title="Copiar el número de venta @c.OrderId">#@c.OrderId</button>
                                    </div>
                                </div>
                            }
                        }

                        @* ── 2026-08-21 (parte 2): sus preguntas en nuestras publicaciones ── *@
                        @if (mmFicha.Preguntas.Count > 0)
                        {
                            <div class="wa-mm-sec-t">Sus preguntas</div>
                            @foreach (var pg in mmFicha.Preguntas)
                            {
                                <div class="wa-mm-preg">
                                    <div class="wa-mm-compra-l1">
                                        @if (!string.IsNullOrWhiteSpace(pg.Thumbnail))
                                        {
                                            <img class="wa-mm-compra-foto" src="@pg.Thumbnail" alt="" />
                                        }
                                        <div class="wa-mm-compra-tit" title="@pg.ItemTitulo">@pg.ItemTitulo</div>
                                    </div>
                                    <div class="wa-mm-preg-txt">“@pg.Texto”</div>
                                    <div class="wa-mm-compra-l2">
                                        <span>@pg.Fecha.ToString("dd/MM/yy")</span>
                                        <span class="@(pg.Contestada ? "wa-mm-preg-ok" : "wa-mm-preg-pend")">
                                            @(pg.Contestada ? "✔ Contestada" : "⏳ Sin contestar")
                                        </span>
                                    </div>
                                    @if (pg.Contestada && !string.IsNullOrWhiteSpace(pg.Respuesta))
                                    {
                                        <div class="wa-mm-preg-resp">Le contestamos: @pg.Respuesta</div>
                                    }
                                    <div class="wa-mm-chips">
                                        @if (pg.Precio is decimal pp) { <span class="wa-mm-chip">@Plata(pp)</span> }
                                        @if (pg.Stock is int st) { <span class="wa-mm-chip @(st > 0 ? "" : "rojo")">@(st > 0 ? $"{st} en stock" : "sin stock")</span> }
                                        @if (!string.IsNullOrWhiteSpace(pg.EstadoPubli)) { <span class="wa-mm-chip">@pg.EstadoPubli</span> }
                                    </div>
                                    <div class="wa-mm-acc">
                                        <button class="wa-mm-btn ok" @onclick="() => VerPublicacionMeli(pg.ItemId)" title="Ver precio y stock de hoy, con la respuesta ya escrita">🏷️ Precio y stock</button>
                                        @if (!string.IsNullOrWhiteSpace(pg.Permalink))
                                        {
                                            <a class="wa-mm-btn" href="@pg.Permalink" target="_blank" title="Abrir la publicación en MercadoLibre">🔗 Publicación</a>
                                        }
                                    </div>
                                </div>
                            }
                        }

                        <button class="wa-mm-otro" @onclick="VolverBuscadorMeli">← Buscar otro comprador</button>
                    }
                </aside>
            }
            @* ══════════ 2026-08-31: MODO ALQUILER — cotizar y MANDAR, nada más.
               Pedido del dueño: "cargo lo que me pide en un pedo, visualizo el total y mando".
               Al cliente le llega el detalle, el flete, el total y la fecha. NO crea reserva:
               eso se sigue haciendo en Alquileres como siempre. ══════════ *@
            else if (modoAlquiler)
            {
                @* 2026-08-31: el cotizador vive en Shared/CotizadorAlquiler.razor — la MISMA pieza
                   que usa la calculadora flotante y la bandeja de preguntas. Acá solo decimos qué
                   hacer con el texto: dejarlo escrito abajo para que lo revise y lo mande él. *@
                <aside class="wa-ctx wa-alq">
                    <div class="wa-mv-top">
                        <span class="wa-mv-tit">🎪 Cotizar alquiler</span>
                        <button class="wa-ficha-x" @onclick="CerrarModoAlquiler" title="Salir">×</button>
                    </div>
                    <div class="wa-alq-body">
                        <CotizadorAlquiler @ref="cotizadorRef" OnListo="EscribirCotizacionAlq" />
                    </div>
                </aside>
            }
            @* 2026-08-27: acá vivía el panel de CONTACTO / CONVERSACIÓN. Se borró entero: después de
               subir estado, responsable, nota, editar contacto y vincular al encabezado del chat, no le
               quedaba nada propio — era una lista de botones repetidos. Lo poco que sí era suyo (sumar y
               sacar razón social, el sonido de aviso del contacto y borrar la conversación) se mudó adentro
               de "Editar contacto". Este espacio de la derecha ahora SOLO aparece con el Modo venta o el
               Modo MercadoLibre; el resto del tiempo el chat se lleva todo el ancho. *@
        }

    }

    @* Tira de iconos del borde: siempre visible, así el panel nunca "desaparece".
       2026-08-27: ahora se dibuja SIEMPRE (antes solo con un chat abierto) porque abajo de todo vive
       el engranaje ⚙️ de Pedidos y configuración, que se tiene que poder abrir igual. *@
    <div class="wa-ctx-rail">
        @if (selectedNumero is not null)
        {
            @* 2026-08-27: acá estaban el ‹ › de plegar, la 👤 y el 💬. Los tres se fueron con el panel:
               los dos últimos llamaban a la MISMA función (abrir el panel), o sea que eran el mismo botón
               repetido, y sin panel no tenían nada que abrir. *@
            <button class="wa-ctx-rail-btn @(modoVenta ? "on" : "")" @onclick="AbrirModoVenta" title="Modo venta: armar la venta acá al lado sin salir del chat">🛒</button>
            @if (SelectedConv()?.ClienteId is int)
            {
                <button class="wa-ctx-rail-btn @(mostrarFichaCliente ? "on" : "")" @onclick="ToggleFichaCliente" title="Ficha del cliente: saldo, últimas facturas y ubicación">🛍️</button>
            }
            @* 2026-08-21: MODO MELI — está siempre, aunque el chat no esté vinculado a un cliente:
               el que pregunta por una publicación muchas veces todavía no es cliente nuestro.
               2026-08-24: el 🟡 pasó a ser el logo real de MercadoLibre — el circulito amarillo no
               se entendía que era MeLi. *@
            <button class="wa-ctx-rail-btn @(modoMeli ? "on" : "")" @onclick="AbrirModoMeli" title="Modo MercadoLibre: poné su usuario y mirá sus compras, envíos y seguimientos">
                <img class="wa-ctx-rail-img" src="img/meli-icon.svg" alt="MercadoLibre" />
            </button>
            @* 2026-08-24: "Crear venta" estaba enterrado adentro del panel de Contacto — hay que
               abrir el panel para encontrarlo. Acá tiene su propio botón: tildás los mensajes del
               pedido y se abre Nueva Venta en una pestaña nueva (mismo circuito de siempre). *@
            <button class="wa-ctx-rail-btn @(modoElegirVenta ? "on" : "")" @onclick="IniciarCrearVenta"
                    title="Crear venta: tildá los mensajes del pedido y se abre Nueva Venta en una pestaña nueva">🧾</button>
            @* 2026-08-31: COTIZAR ALQUILER — sillas, mesas y flete acá al lado, y el presupuesto
               sale como mensaje sin copiar ni pegar. *@
            <button class="wa-ctx-rail-btn @(modoAlquiler ? "on" : "")" @onclick="AbrirModoAlquiler"
                    title="Cotizar alquiler: cargá sillas, mesas y flete, y mandale el presupuesto">🎪</button>
        }
        @* 2026-08-27: PEDIDOS Y CONFIGURACIÓN. Estaba arriba como solapa y le comía alto a la charla.
           Va separado por una rayita y en azul porque es lo único de esta tira que te SACA del chat:
           se abre en otra pestaña, así lo que estabas escribiendo te queda como estaba. *@
        <span class="wa-ctx-rail-sep"></span>
        <a class="wa-ctx-rail-btn wa-ctx-rail-cfg" href="/whatsapp/pedidos" target="_blank"
           title="Pedidos y configuración — se abre en otra pestaña y el chat te queda como está">⚙️</a>
    </div>
</div> @* fin .wa-thread-wrap *@
</div>
</div>
</div> @* fin .wa-fs — pantalla completa *@

@* 2026-08-03: ventana FLOTANTE (se puede mover) con el texto completo del pedido antes de crear la venta.
   No lleva fondo oscuro a propósito: querés seguir viendo el chat mientras la movés y comparás. *@
@if (showPedidoFloat)
{
    <div class="wa-float" id="wa-pedido-float">
        <div class="wa-float-head" id="wa-pedido-float-head">
            <span style="flex:1;">📋 Revisá el pedido (podés mover esta ventana y editar el texto)</span>
            <button class="btn btn-sm btn-outline-secondary" @onclick="@(() => showPedidoFloat = false)" title="Cerrar">×</button>
        </div>
        <div class="wa-float-body">
            <label style="font-size:0.8rem; color:#6b7280; font-weight:600;">Texto que va a "Comentario para armado":</label>
            <textarea class="form-control" @bind="pedidoFloatTexto" rows="10"
                      style="font-size:0.95rem; line-height:1.35; resize:vertical;"
                      placeholder="El texto del pedido…"></textarea>
        </div>
        <div class="wa-float-foot">
            <button class="btn btn-outline-secondary btn-sm" @onclick="@(() => showPedidoFloat = false)">Cancelar</button>
            <button class="btn btn-success btn-sm" @onclick="ConfirmarPedidoFloat" disabled="@creandoPedidoFloat">
                @(creandoPedidoFloat ? "⏳ Creando…" : "✅ Crear venta")
            </button>
        </div>
    </div>
}

@if (showQuickContact)
{
    <div class="wa-modal-backdrop" @onclick="@(() => showQuickContact = false)"></div>
    <div class="wa-modal" style="max-width:520px;">
        <div class="wa-modal-header">
            <h3 style="margin:0; flex:1; font-size:1.05rem;">@(quickContactEditId is null ? "➕ Asignar contacto" : "✏️ Editar contacto")</h3>
            <button class="btn btn-sm btn-outline-secondary" @onclick="@(() => showQuickContact = false)">×</button>
        </div>
        <div class="wa-modal-body">
            <div style="margin-bottom:0.7rem;">
                <label style="font-size:0.78rem; color:#6b7280; display:block;">Número (WhatsApp)</label>
                <input class="form-control form-control-sm" value="@quickContactNumero" readonly style="background:#f9fafb;" />
            </div>
            <div style="margin-bottom:0.7rem;">
                <label style="font-size:0.78rem; color:#6b7280; display:block;">Nombre <span style="color:#dc2626;">*</span></label>
                <input class="form-control form-control-sm" @bind="quickContactNombre" placeholder="Ej. Juan Pérez" />
            </div>
            <div style="margin-bottom:0.7rem;">
                <label style="font-size:0.78rem; color:#6b7280; display:block;">Rol</label>
                <select class="form-control form-control-sm" @bind="quickContactRol">
                    <option value="hermano">👨‍👦 Hermano</option>
                    <option value="empleado">👷 Empleado</option>
                    <option value="cliente">🛍️ Cliente</option>
                    <option value="proveedor">🚚 Proveedor</option>
                    <option value="alquiler">🎪 Alquiler</option>
                    <option value="cafe">☕ Café</option>
                    <option value="meli">🛒 MELI</option>
                    <option value="otro">Otro</option>
                </select>
            </div>
            <div style="margin-bottom:0.7rem; position:relative;">
                <label style="font-size:0.78rem; color:#6b7280; display:block;">Cliente del sistema <span style="font-size:0.7rem; color:#9ca3af;">(opcional)</span></label>
                @if (quickContactClienteId.HasValue)
                {
                    <div style="display:flex; align-items:center; gap:0.4rem; padding:0.3rem 0.5rem; background:#ecfdf5; border:1px solid #a7f3d0; border-radius:6px; font-size:0.85rem;">
                        <span>🛍️ @quickContactClienteNombre</span>
                        <button class="btn btn-sm btn-link" style="padding:0; margin-left:auto; font-size:0.85rem;" @onclick="@(() => { quickContactClienteId = null; quickContactClienteNombre = null; })">×</button>
                    </div>
                }
                else
                {
                    <input class="form-control form-control-sm" placeholder="Escribí nombre, teléfono, CUIT, dirección…" @bind="quickContactClienteQuery" @bind:event="oninput" @onkeyup="BuscarClientesQuick" @onfocus="BuscarClientesQuick" autocomplete="off" />
                    @if (clienteBuscandoQuick)
                    {
                        <div style="padding:0.35rem 0.2rem; color:#9ca3af; font-size:0.8rem;">Buscando…</div>
                    }
                    else if (!string.IsNullOrWhiteSpace(quickContactClienteQuery) && clienteResultadosQuick.Count == 0)
                    {
                        <div style="padding:0.35rem 0.2rem; color:#9ca3af; font-size:0.8rem;">Sin resultados. Probá con otro dato.</div>
                    }
                    @if (clienteResultadosQuick.Count > 0)
                    {
                        <div class="wa-cliente-dropdown" style="position:absolute; top:100%; left:0; right:0; max-height:240px; overflow-y:auto; z-index:20;">
                            @foreach (var cli in clienteResultadosQuick)
                            {
                                <div class="wa-cliente-opt" @onclick="() => SeleccionarClienteQuick(cli)">
                                    <strong>@cli.Nombre</strong>
                                    @if (!string.IsNullOrEmpty(cli.CodigoInterno)) { <span style="color:#6b7280; font-size:0.7rem;"> · #@cli.CodigoInterno</span> }
                                    @if (!string.IsNullOrEmpty(cli.Telefono)) { <span style="color:#9ca3af; font-size:0.7rem;"> · 📞 @cli.Telefono</span> }
                                    @if (!string.IsNullOrEmpty(cli.Localidad)) { <div style="color:#9ca3af; font-size:0.7rem;">📍 @cli.Localidad</div> }
                                </div>
                            }
                        </div>
                    }
                }
            </div>
            <div style="margin-bottom:0.7rem;">
                <label style="font-size:0.78rem; color:#6b7280; display:block;">Notas <span style="font-size:0.7rem; color:#9ca3af;">(opcional)</span></label>
                <input class="form-control form-control-sm" @bind="quickContactNotas" placeholder="Ej. Hermano mayor, vive en San Isidro" />
            </div>
            @* ═══ 2026-08-27: lo que sobrevivió del panel derecho ═══
               Estas tres cosas eran lo único del panel que no estaba en ningún otro lado. Viven acá
               porque son de ESTE contacto. Solo aparecen si estás editando el contacto del chat que
               tenés abierto (desde la pantalla de configuración se edita cualquier contacto, y ahí
               no habría chat al que aplicarle el sonido ni conversación que borrar). *@
            @if (selectedNumero is not null && quickContactNumero == selectedNumero)
            {
                <div class="wa-qc-extra">
                    <div class="wa-qc-extra-t">🛍️ Razones sociales de este teléfono</div>
                    <div class="wa-qc-hint">Un mismo teléfono puede facturar a varias empresas. Sumá las que hagan falta y después elegís con cuál trabajás desde arriba del chat.</div>
                    @foreach (var rs in RazonesSociales)
                    {
                        <button class="wa-qc-quitar" @onclick="() => QuitarRazonDesdeContacto(rs.Id, rs.Nombre)"
                                title="Sacar @rs.Nombre de este chat (no borra el cliente, solo lo despega del teléfono)">
                            🗑 @rs.Nombre
                        </button>
                    }
                    <button class="wa-qc-btn" @onclick="VincularDesdeContacto"
                            title="Buscar un cliente del sistema y pegarlo a este teléfono">
                        ➕ Sumar otra razón social
                    </button>
                </div>

                <div class="wa-qc-extra">
                    <div class="wa-qc-extra-t">🔔 Sonido de aviso</div>
                    <div class="wa-qc-hint">Solo para este contacto, para que un cliente importante suene distinto al resto. Dejalo en "el de la línea" para que suene como todos.</div>
                    <div style="display:flex; gap:0.3rem; align-items:center;">
                        <select class="form-control form-control-sm" style="flex:1;" value="@(SelectedConv()?.Sonido ?? "")" @onchange="OnSonidoConvChange">
                            <option value="">🔔 El de la línea (@NombreSonido(SonidoDeLineaActual()))</option>
                            @foreach (var so in SonidosDisponibles) { <option value="@so.Key">@so.Label</option> }
                            @if (sonidosSubidos.Count > 0)
                            {
                                <optgroup label="Sonidos que subiste">
                                    @foreach (var so in sonidosSubidos) { <option value="@so.Clave">🎵 @so.Nombre</option> }
                                </optgroup>
                            }
                        </select>
                        <button class="btn btn-sm btn-outline-secondary" title="Escuchar cómo suena"
                                @onclick="@(() => ProbarSonido(string.IsNullOrEmpty(SelectedConv()?.Sonido) ? SonidoDeLineaActual() : SelectedConv()!.Sonido!))">▶</button>
                    </div>
                </div>

            }

            @* 2026-08-27: el Guardar va DESPUÉS de todo lo editable. Ya nos pasó en Liquidaciones que
               lo que quedaba debajo del botón de guardar no se veía y se perdía. *@
            <div style="display:flex; gap:0.5rem; justify-content:flex-end; margin-top:1rem;">
                <button class="btn btn-secondary btn-sm" @onclick="@(() => showQuickContact = false)">Cancelar</button>
                <button class="btn btn-success btn-sm" @onclick="GuardarQuickContact">@(quickContactEditId is null ? "✓ Guardar contacto" : "✓ Guardar cambios")</button>
            </div>

            @if (selectedNumero is not null && quickContactNumero == selectedNumero)
            {
                @* Borrar va ABAJO DE TODO y separado del Guardar, para no tocarlo sin querer. *@
                <div class="wa-qc-extra peligro">
                    <button class="wa-qc-borrar" @onclick="BorrarConversacion" disabled="@borrandoConv"
                            title="Borrar esta conversación del sistema (el celular del cliente no se toca)">
                        @(borrandoConv ? "⏳ Borrando…" : "🗑 Borrar conversación")
                    </button>
                </div>
            }
        </div>
    </div>
}

@* 2026-08-04: CORREGIR NÚMERO de un chat (ej quedó mal cargado con 549 pegado a un extranjero) *@
@if (showCorregirNum)
{
    <div class="wa-modal-backdrop" @onclick="@(() => showCorregirNum = false)"></div>
    <div class="wa-modal" style="max-width:460px;">
        <div class="wa-modal-header">
            <h3 style="margin:0; flex:1; font-size:1.05rem;">✏️ Corregir número</h3>
