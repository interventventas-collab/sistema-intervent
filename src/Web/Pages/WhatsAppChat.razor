    /// <summary>Los últimos comprobantes del cliente, para poder repetirlos. Reusa la misma
    /// llamada que la ficha 👁️ (ficha-chat), así no agregamos otro endpoint.</summary>
    async Task CargarAnterioresModoVenta(int clienteId)
    {
        mvCargandoAnteriores = true;
        mvAnteriores = new();
        try
        {
            var ficha = await Api.GetFichaChatAsync(clienteId);
            // Las notas de crédito no se repiten (son devoluciones).
            mvAnteriores = ficha?.Ventas
                .Where(v => v.Tipo == null || !v.Tipo.StartsWith("NC", StringComparison.OrdinalIgnoreCase))
                .ToList() ?? new();
        }
