    /// <summary>Códigos de MercadoLibre que el cliente pegó en la charla: el código de una
    /// publicación (MLA…) o el número de una venta. Se miran los últimos mensajes nomás.</summary>
    void DetectarCodigosMeli()
    {
        var encontrados = new List<string>();
        foreach (var m in mensajes.Skip(Math.Max(0, mensajes.Count - 25)))
        {
            var txt = m.Cuerpo;
            if (string.IsNullOrWhiteSpace(txt)) continue;
            foreach (System.Text.RegularExpressions.Match mt in
                     System.Text.RegularExpressions.Regex.Matches(txt, @"MLA-?\d{6,}", System.Text.RegularExpressions.RegexOptions.IgnoreCase))
            {
                var cod = mt.Value.ToUpperInvariant().Replace("-", "");
                if (!encontrados.Contains(cod)) encontrados.Add(cod);
            }
            // Números de venta / pack: son largos (12 dígitos o más). Los teléfonos no llegan.
            foreach (System.Text.RegularExpressions.Match mt in
                     System.Text.RegularExpressions.Regex.Matches(txt, @"(?<!\d)\d{12,17}(?!\d)"))
            {
                if (!encontrados.Contains(mt.Value)) encontrados.Add(mt.Value);
            }
        }
        // Los últimos primero y unos pocos: es un atajo, no un listado.
        encontrados.Reverse();
        mmCodigos = encontrados.Take(4).ToList();
    }

    /// <summary>Toca un código pegado en el chat: si es una publicación, muestra precio y stock;
