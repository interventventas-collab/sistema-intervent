    // 2026-08-05: "Editar contacto" ahora abre la ficha de ESTE contacto ya cargada para modificar
    // (antes abría la lista completa de contactos en la configuración, lo cual no servía para editarlo).
    void AbrirEditarContacto()
    {
        if (selectedNumero == null) return;
        var cont = GetContactoByNumero(selectedNumero);
        if (cont == null)
        {
            // No estaba guardado como contacto: caemos a "asignar" (alta) con los datos del chat.
