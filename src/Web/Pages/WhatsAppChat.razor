    public void Dispose()
    {
        Apariencia.OnChange -= AparienciaCambio;
        refreshTimer?.Dispose();
        // Sacar el listener de pegado al salir de la pantalla (evita que Ctrl+V dispare avisos en otras páginas).
        try { _ = JS.InvokeVoidAsync("waPaste.unregister"); } catch { }
        try { _ = JS.InvokeVoidAsync("waComposer.unregister"); } catch { }
        _pasteRef?.Dispose();
        // 2026-08-06: cerrar la presencia — salir del chat, frenar timers, desuscribir y cerrar el hub.
        heartbeatTimer?.Dispose();
        typingOffTimer?.Dispose();
        Presence.OnPresence -= PresenciaCambio;
        Presence.OnMessageSent -= OtroEnvioMensaje;
        if (_convUnida != null) { _ = Presence.LeaveAsync(_convUnida); }
        _ = Presence.DisposeAsync();
    }
}
