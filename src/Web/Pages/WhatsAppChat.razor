    // 2026-08-03: "Escribir" a un contacto compartido. Si ya existe un chat con ese número, lo abre.
    // Si es nuevo, abre el panel de "Nueva conversación" ya cargado (porque a un número nuevo hay que
    // escribirle con plantilla — regla de las 24h de WhatsApp).
    async Task EscribirAContactoCompartido(string? nombre, string? numero)
    {
        var digs = new string((numero ?? "").Where(char.IsDigit).ToArray());
        if (string.IsNullOrWhiteSpace(digs)) { Toast.Warning("Ese contacto no trae un número válido"); return; }
        var existente = conversaciones.FirstOrDefault(c =>
            new string((c.Numero ?? "").Where(char.IsDigit).ToArray()) == digs);
        if (existente != null)
        {
            await SelectConv(existente.Numero, existente.Linea);   // ya hablaste con él: abrí ese chat
            return;
        }
        await AbrirNuevaConv();   // contacto nuevo: dejá el panel de nueva conversación listo
        nvNumero = digs;
        nvClienteSeleccionado = string.IsNullOrWhiteSpace(nombre) ? "este contacto" : nombre;
        StateHasChanged();
    }

