    .wa-srv-send-btn { background: #25d366; color: white; border: none; padding: 0.35rem 0.8rem; border-radius: 6px; cursor: pointer; font-size: 0.8rem; white-space: nowrap; }
    .wa-srv-send-btn:hover { background: #1ea953; }
    .wa-srv-send-btn:disabled { background: #9ca3af; cursor: wait; }
    .wa-srv-empty { padding: 2rem; text-align: center; color: #9ca3af; font-size: 0.85rem; }

    /* 2026-08-02: flecha "volver" (oculta en escritorio, se ve solo en el celular) */
    .wa-volver-btn { display: none; background: transparent; border: 0; font-size: 1.6rem; line-height: 1; color: #128c7e; cursor: pointer; padding: 0 0.4rem 0 0; }

    /* 2026-08-02: botón para descargar un archivo/imagen/audio recibido */
    .wa-descargar-btn { display: inline-block; margin-top: 0.25rem; font-size: 0.72rem; color: #128c7e; text-decoration: none; background: #e7f7f1; border: 1px solid #b9e6d7; border-radius: 6px; padding: 0.15rem 0.5rem; }
    .wa-descargar-btn:hover { background: #d5f0e6; }

    /* 2026-08-02: en la pantalla de WhatsApp no tiene sentido el panel flotante de WhatsApp (ya estás adentro) */
    .waf-panel, .waf-fab { display: none !important; }

    /* ===== 2026-08-02: MODO CELULAR estilo WhatsApp =====
       En pantallas chicas se ve O la lista O el chat, a pantalla completa (no las dos apretadas).
       Tocás un chat -> se abre el chat entero. Flecha "volver" -> volvés a la lista. */
    @@media (max-width: 820px) {
        /* Punto 1: en el celular, dentro de WhatsApp mostramos SOLO el WhatsApp.
           Ocultamos la botonera del menú del sistema (BÓVEDA, CALCUPRECIOS, Stock, Venta, etc.)
           y dejamos la barra chica de arriba (☰ menú + Volver) para poder navegar. */
        .main-wrapper .topbar-actions { display: none !important; }

        .wa-topbar { padding: 0.4rem 0.6rem 0; gap: 0.5rem; }
        .wa-tab-top { font-size: 0.85rem; }
        .wa-outer { height: calc(100dvh - 112px); padding: 0; background: #fff; }
        .wa-root { grid-template-columns: 1fr; gap: 0; max-width: 100%; }
        .wa-sidebar, .wa-thread { border-radius: 0; border-left: 0; border-right: 0; box-shadow: none; }

        /* Sin chat abierto: se ve la lista, se esconde el chat */
        .wa-root .wa-thread { display: none; }
        .wa-root .wa-sidebar { display: flex; }
        /* Con un chat abierto: se ve el chat completo, se esconde la lista */
        .wa-root.wa-chat-abierto .wa-sidebar { display: none; }
        .wa-root.wa-chat-abierto .wa-thread { display: flex; }

        .wa-volver-btn { display: inline-flex; align-items: center; }

        /* Encabezado del chat compacto: botones de acción chiquitos para que no tapen todo */
        .wa-thread-header { padding: 0.5rem 0.6rem; gap: 0.3rem; }
        .wa-thread-header .btn { font-size: 0.66rem !important; padding: 0.2rem 0.4rem !important; }

        /* Caja para escribir cómoda (no gigante) y botones grandes para el pulgar.
           2026-08-03: en el celu la casilla de texto va ARRIBA a todo el ancho (order:-1),
           y los botoncitos + Enviar quedan en una fila DEBAJO. Antes todo iba en una sola
           línea y el textarea quedaba un huequito finito (las letras se apilaban). */
        .wa-composer { padding: 0.5rem 0.6rem calc(0.5rem + env(safe-area-inset-bottom)); gap: 0.4rem; flex-wrap: wrap; align-items: center; }
        .wa-composer textarea { flex: 1 1 100% !important; order: -1; min-height: 90px !important; height: auto !important; max-height: 180px !important; }
        .wa-composer .wa-enviar-btn { margin-left: auto; }
        .wa-attach-btn { width: 40px; height: 40px; font-size: 1.2rem; }
        .wa-messages { padding: 0.7rem; }
    }
</style>

@if (showAdjuntarServidor)
{
    <div class="wa-modal-backdrop" @onclick="CerrarAdjuntarServidor" style="z-index:1099;"></div>
    <div class="wa-srv-modal" @onclick:stopPropagation="true">
        <div style="display:flex; justify-content:space-between; align-items:center;">
            <h5 style="margin:0;">🗂️ Adjuntar del servidor</h5>
            <button class="btn btn-sm btn-outline-secondary" @onclick="CerrarAdjuntarServidor">×</button>
        </div>
        <div style="font-size:0.75rem; color:#6b7280; margin-top:0.25rem;">
            Enviar a <strong>@(MostrarNombre(SelectedConv()))</strong>
        </div>
        <div class="wa-srv-tabs">
            <button class="wa-srv-tab @(srvTab == "VENTA" ? "active" : "")" @onclick='() => CambiarTabServidor("VENTA")'>🧾 Facturas/Ventas</button>
            <button class="wa-srv-tab @(srvTab == "COBRANZA" ? "active" : "")" @onclick='() => CambiarTabServidor("COBRANZA")'>💰 Recibos cobranza</button>
            <button class="wa-srv-tab @(srvTab == "LISTA" ? "active" : "")" @onclick='() => CambiarTabServidor("LISTA")'>💲 Listas de precios</button>
            <button class="wa-srv-tab @(srvTab == "UPLOAD" ? "active" : "")" @onclick='() => CambiarTabServidor("UPLOAD")'>📁 Mis subidos</button>
        </div>
        <input class="wa-srv-search" placeholder="@SrvSearchPlaceholder()"
               value="@srvSearch" @oninput="OnSrvSearchInput" />
        <div class="wa-srv-list">
            @if (srvLoading)
            {
                <div class="wa-srv-empty">Cargando…</div>
            }
            else if (srvResultados.Count == 0)
            {
                <div class="wa-srv-empty">@(string.IsNullOrWhiteSpace(srvSearch) ? "Sin resultados. Probá buscando." : "Sin resultados con ese filtro.")</div>
            }
            else
            {
                @foreach (var f in srvResultados)
                {
                    <div class="wa-srv-item">
                        <div class="wa-srv-item-main">
                            <div class="wa-srv-item-label">@f.Label</div>
                            @if (!string.IsNullOrWhiteSpace(f.SubLabel))
                            {
                                <div class="wa-srv-item-sub">@f.SubLabel</div>
                            }
                            @if (!string.IsNullOrWhiteSpace(f.Info))
                            {
                                <div class="wa-srv-item-info">@f.Info · @f.Fecha.ToArTime().ToString("dd/MM/yyyy")</div>
                            }
                        </div>
                        <button class="wa-srv-send-btn" @onclick="() => EnviarServerFile(f)" disabled="@(srvEnviandoId == f.Id)">
                            @(srvEnviandoId == f.Id ? "Enviando…" : "📤 Enviar")
                        </button>
                    </div>
                }
            }
        </div>
    </div>
}

@code {
    List<ApiClient.TwConvDto> conversaciones = new();
    List<ApiClient.TwMsgDto> mensajes = new();
    string? selectedNumero;
    // 2026-08-01: la línea del chat abierto (junto con selectedNumero identifica la conversación).
    // Así el mismo contacto en 2 líneas nuestras son 2 chats distintos y no se cruzan.
    string? selectedLinea;
    string composerText = "";

    // === 2026-08-01: nota de voz (grabar con micrófono y enviar como audio nativo) ===
    bool grabandoAudio = false, enviandoAudio = false;
    class WaUploadRes { public string? Url { get; set; } public string? OriginalFilename { get; set; } }

    async Task ToggleGrabarAudio()
    {
        if (selectedNumero == null) { Toast.Warning("Elegí un chat primero"); return; }
        if (!grabandoAudio)
        {
            bool ok;
            try { ok = await JS.InvokeAsync<bool>("waAudio.start"); }
            catch { ok = false; }
            if (!ok) { Toast.Error("No pude acceder al micrófono. Revisá los permisos del navegador (y que estés en HTTPS)."); return; }
            grabandoAudio = true;
        }
        else
        {
            grabandoAudio = false;
            enviandoAudio = true;
            StateHasChanged();
            WaUploadRes? res = null;
            try { res = await JS.InvokeAsync<WaUploadRes?>("waAudio.stopAndUpload"); }
            catch { }
            if (res == null || string.IsNullOrEmpty(res.Url))
            {
                enviandoAudio = false;
                Toast.Error("No se pudo grabar o subir el audio");
                return;
            }
            var (ok, err) = await Api.SendTwMediaAsync(selectedNumero, res.Url, null, res.OriginalFilename, selectedLinea);
            enviandoAudio = false;
            if (!ok) Toast.Error(err ?? "No se pudo enviar la nota de voz");
            else await LoadMensajes();
            StateHasChanged();
        }
    }

    async Task CancelarAudio()
    {
        grabandoAudio = false;
        try { await JS.InvokeVoidAsync("waAudio.cancel"); } catch { }
    }
    bool loadingConv = true, loadingMsg = false, sending = false, uploading = false, enviandoMenuRol = false;
    System.Threading.Timer? refreshTimer;
    Microsoft.AspNetCore.Components.ElementReference messagesScroll;

    // Respuestas rapidas + contactos
    List<ApiClient.TwRespRapidaDto> respuestas = new();
    List<ApiClient.TwContactoDto> contactos = new();
    bool showConfig = false;
    string configTab = "resp";
    // 2026-07-29: Datos bancarios / CBUs
    List<ApiClient.TwCbuDto> datosBancarios = new();
    bool showCbuPanel = false;
