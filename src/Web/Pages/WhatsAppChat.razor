        sugerenciaCliente = null;
    }

    // Llama al backend, y al volver refresca contactos + conversaciones para que el chat
    // muestre al toque el cartel "🛍️ Cliente: ..." y se esconda el botón de vincular.
    async Task VincularNumeroACliente(int clienteId, string clienteNombre)
    {
        if (selectedNumero == null) return;
        vinculando = true;
        try
        {
            var res = await Api.VincularTwClienteAsync(selectedNumero, clienteId);
            if (res?.Ok == true)
            {
                sugerenciaCliente = null;
                sugerenciasDescartadas.Remove(ClaveChat());
                await LoadContactos();
                await LoadConversaciones(silent: true);
                await CargarFichaCliente();   // 2026-08-24: que la dirección y la deuda aparezcan al toque
                Toast.Success($"🔗 Chat vinculado a {clienteNombre}");
            }
            else Toast.Error("No pude vincular. Probá de nuevo.");
        }
        catch { Toast.Error("No pude vincular. Probá de nuevo."); }
        finally { vinculando = false; }
    }

    // Se llama al abrir/cambiar de chat: si no tiene cliente y no fue descartado, le pregunta al
    // backend si hay un cliente con ese mismo teléfono y arma el cartelito.
    async Task BuscarSugerenciaCliente()
    {
        sugerenciaCliente = null;
        if (selectedNumero == null) return;
        if (SelectedConv()?.ClienteId is not null) return;      // ya está vinculado
        if (sugerenciasDescartadas.Contains(ClaveChat())) return; // dijo "No" hace un rato
        try
        {
            var sug = await Api.SugerenciaClienteAsync(selectedNumero);
            // Puede haber cambiado de chat mientras respondía el server: confirmamos que sigue siendo este.
            if (sug is not null && SelectedConv()?.ClienteId is null && !sugerenciasDescartadas.Contains(ClaveChat()))
            {
                sugerenciaCliente = sug;
                StateHasChanged();
            }
        }
        catch { }
    }

