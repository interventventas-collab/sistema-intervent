    // Si lo escrito parece un número (sin letras, 8+ dígitos), ofrecer mandarle directo
    string? ReenviarNumeroDirecto()
    {
        var q = reenviarQuery ?? "";
        if (q.Any(char.IsLetter)) return null;
        var digs = new string(q.Where(char.IsDigit).ToArray());
        return digs.Length >= 8 ? digs : null;
    }

