    .wa-qr-dropdown { position: absolute; bottom: calc(100% + 6px); right: 0; background: #fff; border: 1px solid #e5e7eb; border-radius: 12px; box-shadow: 0 10px 28px rgba(0,0,0,0.18); padding: 0.5rem; display: flex; flex-direction: column; gap: 0.32rem; min-width: 190px; max-height: 340px; overflow-y: auto; z-index: 60; }
    .wa-qr-dropdown .wa-chip { width: 100%; text-align: center; }
    /* 2026-08-05: los dos carteles verdes, uno al lado del otro, debajo del composer */
    .wa-avisos-row { display: flex; flex-wrap: wrap; gap: 0.5rem; padding: 0.35rem 1rem 0.5rem; }
    .wa-avisos-row .wa-composer-linea { margin: 0; border-radius: 999px; padding: 0.42rem 0.85rem; flex: 0 1 auto; }
    .wa-avisos-row .wa-vent24 { margin: 0; }
    .wa-vent24 { display: inline-flex; align-items: center; gap: 0.5rem; margin: 0.55rem 1rem 0; padding: 0.42rem 0.85rem; border-radius: 999px; font-size: 0.8rem; font-weight: 600; }
    .wa-vent24.ok { background: #ecfdf5; color: #15803d; border: 1px solid #a7f3d0; }
    .wa-vent24.urgente { background: #fffbeb; color: #b45309; border: 1px solid #fcd34d; }
    .wa-vent24.cerrada { background: #fef2f2; color: #b91c1c; border: 1px solid #fecaca; }
