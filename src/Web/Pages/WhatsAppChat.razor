    string PrettyNumero(string numero)
    {
        if (string.IsNullOrEmpty(numero)) return "";
        if (numero.StartsWith("ig:")) return "Instagram"; // fallback si no tenemos el @usuario
        return numero.Replace("whatsapp:", "").Trim();
    }

    // 2026-07-31: nombre a mostrar para una conversación de Instagram = el @usuario si lo tenemos;
    // si no, la @cuenta a la que escribió (de "IG @cuenta"); nunca "ig:..." ni "Usuario de Instagram".
    string MostrarNombreIg(ApiClient.TwConvDto c)
    {
        // El nombre grande es el REMITENTE (@usuario). La cuenta a la que escribió va en la etiqueta chica.
        if (!string.IsNullOrEmpty(c.NombrePerfil) && !c.NombrePerfil.StartsWith("ig:"))
            return c.NombrePerfil;
        return "Instagram"; // todavía sin el @usuario del remitente
    }

    // Etiqueta chica de la cuenta a la que te escribieron: IG "IG @frikaf_cafe" → "@frikaf_cafe"; WhatsApp → número.
    string BadgeCuenta(string? lineaNumero)
