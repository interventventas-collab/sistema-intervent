    /* Modal Adjuntar del Servidor */
    .wa-srv-modal { position: fixed; top: 50%; left: 50%; transform: translate(-50%, -50%); background: white; border-radius: 12px; padding: 1.25rem; box-shadow: 0 20px 60px rgba(0,0,0,0.25); z-index: 1100; min-width: 580px; max-width: 700px; max-height: 80vh; display: flex; flex-direction: column; }
    .wa-srv-tabs { display: flex; gap: 0.25rem; margin: 0.5rem 0 0.75rem; border-bottom: 1px solid #e5e7eb; }
