    async Task ScrollAlUltimoMensaje()
    {
        try
        {
            // Un respiro para que Blazor termine de pintar los mensajes antes de scrollear.
            await Task.Yield();
            StateHasChanged();
            await Task.Delay(60);
            // "Hard": reintenta mientras cargan imágenes/audios, así al abrir un chat
            // siempre quedás en el último mensaje (no a la mitad).
            await JS.InvokeVoidAsync("chatScrollToBottomHard", "wa-messages-scroll");
        }
        catch { /* si falla el scroll no rompemos el chat */ }
    }

    // 2026-08-03: id temporal (negativo) para los mensajes "optimistas" que muestro
    // al toque mientras viajan al servidor. Negativo para no chocar con ids reales.
    int _tempMsgId = -1;

    // 2026-08-05: elegir quién de Depósito responde (se recuerda para la próxima).
    async Task ElegirFirmante(string f)
    {
        // 2026-08-05: se elige solo para esta sesión abierta; NO se guarda para la próxima vez.
        // Al recargar/reabrir la pantalla vuelve a arrancar en blanco (obliga a re-elegir).
        firmante = f;
        await Task.CompletedTask;
    }

    // El botón verde "Enviar" usa esta vía.
    async Task EnviarMensaje()
    {
        if (selectedNumero == null || sending) return;
        // 2026-08-05: si hay adjuntos en la bandeja, sale TODO junto (el texto va de pie del primero).
        if (pendientes.Count > 0) { await EnviarPendientes(composerText); return; }
        if (string.IsNullOrWhiteSpace(composerText)) return;
        var texto = composerText;
        composerText = "";
        await EnviarTexto(texto);
    }

    // 2026-08-03: el JS (wa-composer.js) llama acá cuando apretás Enter. Ya vació el
    // cuadro en pantalla; nosotros mandamos el texto que nos pasó.
    [JSInvokable]
    public async Task EnviarDesdeComposer(string texto)
    {
        if (string.IsNullOrWhiteSpace(texto)) { composerText = ""; StateHasChanged(); return; }
        // Si estamos en medio de otro envío o no hay chat, devolvemos el texto al cuadro
        // (el JS ya lo había vaciado) para no perderlo.
        if (sending || selectedNumero == null)
        {
            composerText = texto;
            StateHasChanged();
            return;
        }
        // 2026-08-05: si hay adjuntos en la bandeja, Enter manda TODO junto (texto = pie del primero).
        if (pendientes.Count > 0) { composerText = ""; await EnviarPendientes(texto); return; }
        composerText = "";
        await EnviarTexto(texto);
    }

    // Envío real + aparición instantánea (como WhatsApp): agrego el mensaje a la lista
    // al toque, y cuando el servidor confirma recargo para traer el mensaje real (con
    // sus tilditos de estado). Si falla, lo saco y devuelvo el texto al cuadro.
    async Task EnviarTexto(string texto)
    {
        if (selectedNumero == null || sending) return;
        texto = texto?.Trim() ?? "";
        if (string.IsNullOrWhiteSpace(texto)) return;

        // 2026-08-05: Depósito SIEMPRE firma quién responde → "OK (alex)". Si no eligieron
        // el empleado, no se envía y se avisa (devolvemos el texto al cuadro para no perderlo).
        if (esDeposito)
        {
            if (string.IsNullOrWhiteSpace(firmante))
            {
                Toast.Warning("Elegí quién responde (arriba del cuadro de escribir).");
                composerText = texto;
                StateHasChanged();
                return;
            }
            texto = $"{texto} ({firmante})";
        }

        var numero = selectedNumero;
        var linea = selectedLinea;

        // 2026-08-05: si estamos respondiendo citando, agarramos el mensaje citado y limpiamos la barra.
        var replyTarget = replyingTo;
        replyingTo = null;

        var tempId = _tempMsgId--;
        var temp = new ApiClient.TwMsgDto(
            tempId, "OUTGOING", numero, null, texto, null, null, null,
            false, null, DateTime.Now, "SENDING", null,
            null, replyTarget != null ? PreviewMensajeParaResponder(replyTarget) : null, replyTarget?.Direccion == "OUTGOING");
        mensajes.Add(temp);
        sending = true;
        StateHasChanged();
        await ScrollAlUltimoMensaje();

        var (ok, err) = await Api.SendTwMensajeAsync(numero, texto, linea, replyTarget?.Id);
        sending = false;

        if (ok)
        {
            // Solo recargo si seguís en el mismo chat (por si cambiaste mientras mandaba).
            if (selectedNumero == numero && selectedLinea == linea) await LoadMensajes();
            await LoadConversaciones(silent: true);
        }
        else
        {
            mensajes.RemoveAll(m => m.Id == tempId);
            if (selectedNumero == numero) { composerText = texto; replyingTo = replyTarget; } // no se pierde lo que escribiste ni la cita
            StateHasChanged();
            Toast.Error($"Error al enviar: {err}");
        }
    }

    async Task EnviarMenuRol()
    {
        if (string.IsNullOrEmpty(selectedNumero)) return;
        enviandoMenuRol = true;
        // 2026-08-05: el menú tiene que salir por la MISMA línea del chat abierto (no por la última
        // línea que escribió el contacto ni por la línea API por defecto).
        var (ok, err) = await Api.SendTwMenuRolAsync(selectedNumero, selectedLinea);
        enviandoMenuRol = false;
        if (ok)
        {
            Toast.Success("Menú enviado");
            await LoadMensajes();
            await LoadConversaciones(silent: true);
        }
        else
        {
            Toast.Error($"Error al enviar: {err}");
        }
    }

    // ===== Adjuntar archivo de la PC =====
    const long MaxUploadBytes = 16L * 1024 * 1024; // 16 MB (limite WhatsApp)

    async Task OnArchivoSeleccionado(InputFileChangeEventArgs e)
    {
        if (selectedNumero == null) { Toast.Warning("Seleccioná primero un chat"); return; }
        var file = e.File;
        if (file == null) return;
        if (file.Size > MaxUploadBytes) { Toast.Error($"El archivo {file.Name} supera los 16 MB"); return; }

        using var stream = file.OpenReadStream(MaxUploadBytes);
        await SubirYStagear(stream, file.Name, file.ContentType);
    }

    // 2026-08-05: BANDEJA DE PENDIENTES. Antes cada adjunto salía SOLO al instante. Ahora el clip 📎,
    // el pegado (Ctrl/Win+V) y "Adjuntar del servidor" DEJAN el archivo esperando arriba del cajón;
    // el operador escribe un texto tranquilo y con Enter/Enviar sale TODO junto (el texto va de pie
    // de foto del primer adjunto), como en WhatsApp de verdad. Un archivo se saca con la ✖.
    async Task SubirYStagear(System.IO.Stream stream, string fileName, string contentType)
    {
        if (selectedNumero == null) { Toast.Warning("Seleccioná primero un chat"); return; }
        uploading = true;
        StateHasChanged();
        try
        {
            // Subir al servidor (devuelve URL pública con token). Todavía NO se envía: queda pendiente.
            var (resp, err) = await Api.UploadTwArchivoAsync(stream, fileName, contentType);
            if (resp == null) { Toast.Error($"Error subiendo: {err}"); return; }

            var esImg = (contentType ?? "").StartsWith("image/") || IsImage(fileName) || IsImage(resp.Url);
            pendientes.Add(new PendingAdjunto
            {
                Kind = "UPLOAD",
                Url = resp.Url,
                FileName = fileName,
                Label = fileName,
                EsImagen = esImg,
                PreviewUrl = esImg ? resp.Url : null,
                Icono = esImg ? "🖼️" : "📎"
            });
        }
        catch (Exception ex) { Toast.Error($"Error: {ex.Message}"); }
        finally { uploading = false; StateHasChanged(); }
    }

    // 2026-07-29: recibe desde JS (wa-paste.js) una captura pegada con Ctrl+V / Win+V y la envía.
    [Microsoft.JSInterop.JSInvokable]
    public async Task RecibirImagenPegada(string base64, string fileName, string contentType)
    {
        if (selectedNumero == null) { Toast.Warning("Seleccioná primero un chat para pegar la captura"); return; }
        byte[] bytes;
        try { bytes = Convert.FromBase64String(base64); }
        catch { Toast.Error("No se pudo leer la imagen pegada"); return; }
        if (bytes.Length == 0) return;
        if (bytes.Length > MaxUploadBytes) { Toast.Error("La captura supera los 16 MB"); return; }
        using var stream = new System.IO.MemoryStream(bytes);
        await SubirYStagear(stream, fileName, string.IsNullOrWhiteSpace(contentType) ? "image/png" : contentType);
    }

    // ===== 2026-08-05: BANDEJA DE PENDIENTES (adjuntar + texto y sale todo junto) =====
    class PendingAdjunto
    {
        public string Kind = "UPLOAD";      // UPLOAD (archivo subido) | SERVER (archivo del servidor)
        // UPLOAD
        public string Url = "";
        public string FileName = "";
        public bool EsImagen;
        // SERVER
        public string ServerTipo = "";
        public int ServerId;
        // común
        public string Label = "";
        public string? PreviewUrl;          // miniatura si es imagen
        public string Icono = "📎";
    }
    List<PendingAdjunto> pendientes = new();

    // "Adjuntar del servidor": ahora SUMA a la bandeja (no envía directo).
    void StagearServerFile(ApiClient.TwServerFileDto f)
    {
        pendientes.Add(new PendingAdjunto
        {
            Kind = "SERVER",
            ServerTipo = f.Tipo,
            ServerId = f.Id,
            Label = f.Label,
            PreviewUrl = f.PreviewUrl,
            Icono = string.IsNullOrWhiteSpace(f.Icon) ? "📄" : f.Icon
        });
        CerrarAdjuntarServidor();
    }

    void QuitarPendiente(PendingAdjunto p) => pendientes.Remove(p);

    // Envía TODOS los pendientes; el texto del cajón va como pie de foto del PRIMERO. Si uno falla,
    // corta ahí (los ya enviados se sacan de la bandeja; los que faltan quedan para reintentar).
    async Task EnviarPendientes(string? textoCaption)
    {
        if (selectedNumero == null || sending || pendientes.Count == 0) return;
        var numero = selectedNumero;
        var linea = selectedLinea;
        var lista = pendientes.ToList();
        var caption = textoCaption?.Trim();
        replyingTo = null;   // adjuntos no citan; limpiamos la barra de responder por las dudas
        sending = true;
        composerText = "";
        StateHasChanged();

        bool huboError = false;
        for (int i = 0; i < lista.Count; i++)
        {
            var p = lista[i];
            var cap = i == 0 ? caption : null;   // el texto va pegado al primero
            (bool ok, string? err) r = p.Kind == "SERVER"
                ? await Api.SendTwServerFileAsync(numero, p.ServerTipo, p.ServerId, cap, linea)
                : await Api.SendTwMediaAsync(numero, p.Url, cap, p.FileName, linea);
            if (r.ok) pendientes.Remove(p);
            else { huboError = true; Toast.Error($"Error enviando {p.Label}: {r.err}"); break; }
        }

        sending = false;
        if (huboError)
        {
            // devolvemos el texto al cuadro para no perderlo
            if (!string.IsNullOrEmpty(caption)) composerText = caption;
        }
        else
        {
            Toast.Success("Enviado 📎");
        }
        if (selectedNumero == numero && selectedLinea == linea) await LoadMensajes();
        await LoadConversaciones(silent: true);
        StateHasChanged();
    }

