    .wa-ficha-btn.maps { background: #eff6ff; border-color: #bfdbfe; color: #1d4ed8; }
    .wa-ficha-btn.maps:hover { background: #dbeafe; }
    .wa-ficha-plata { flex: 1 1 300px; min-width: 260px; }
    .wa-ficha-saldo { display: flex; align-items: center; justify-content: space-between; padding: 0.55rem 0.75rem; border-radius: 10px; margin-bottom: 0.6rem; }
    .wa-ficha-saldo.debe { background: #fef2f2; border: 1px solid #fecaca; }
    .wa-ficha-saldo.aldia { background: #f0fdf4; border: 1px solid #bbf7d0; }
    .wa-ficha-saldo-lbl { font-size: 0.82rem; font-weight: 600; color: #6b7280; }
    .wa-ficha-saldo-monto { font-size: 1.25rem; font-weight: 800; }
