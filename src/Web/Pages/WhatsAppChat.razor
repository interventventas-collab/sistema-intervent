        quickContactNotas = cont.Notas ?? "";
        quickContactClienteId = cont.ClienteId;
        quickContactClienteNombre = cont.ClienteNombre;
        quickContactClienteQuery = "";
        clienteResultadosQuick = new();
        showQuickContact = true;
    }

    // 2026-08-04: corregir el número de un chat que quedó mal cargado.
    bool showCorregirNum = false;
    string corregirNumValor = "";
    bool corregirNumGuardando = false;

    void AbrirCorregirNumero()
    {
        if (selectedNumero == null) return;
        // pre-cargo el número actual (con "+") para que solo tenga que retocarlo
        corregirNumValor = "+" + new string((selectedNumero ?? "").Where(char.IsDigit).ToArray());
        showCorregirNum = true;
    }

    async Task GuardarCorregirNumero()
    {
        if (selectedNumero == null) return;
        if (string.IsNullOrWhiteSpace(corregirNumValor)) { Toast.Warning("Poné el número correcto"); return; }
        corregirNumGuardando = true;
        StateHasChanged();
        var (ok, err, numero) = await Api.CorregirTwNumeroAsync(selectedNumero, corregirNumValor.Trim());
        corregirNumGuardando = false;
        if (!ok) { Toast.Error(err ?? "No se pudo corregir"); return; }
        Toast.Success("Número corregido ✓");
        showCorregirNum = false;
        var lineaAnterior = selectedLinea;
        await LoadContactos();
        await LoadConversaciones(silent: true);
        if (!string.IsNullOrEmpty(numero))
            await SelectConv(numero, conversaciones.FirstOrDefault(c => c.Numero == numero)?.Linea ?? lineaAnterior);
        StateHasChanged();
    }

    async Task BuscarClientesQuick()
    {
        try { clienteResultadosQuick = await Api.BuscarTwClientesAsync(quickContactClienteQuery ?? ""); }
        catch { clienteResultadosQuick = new(); }
    }

    void SeleccionarClienteQuick(ApiClient.TwClienteBuscarDto cli)
    {
        quickContactClienteId = cli.Id;
        quickContactClienteNombre = cli.Nombre;
        clienteResultadosQuick = new();
        quickContactClienteQuery = "";
    }

    // 2026-08-05: poner la categoría (rol) directo desde la lista, con el 🏷️ de cada conversación
    ApiClient.TwConvDto? rolMenuConv = null;
    async Task AsignarRolRapido(string rol)
    {
        var c = rolMenuConv;
        rolMenuConv = null;
        if (c == null) return;
        var nombre = string.IsNullOrWhiteSpace(c.NombrePerfil) ? null : c.NombrePerfil;
        var (ok, err) = await Api.SetTwContactoRolAsync(c.Numero, rol, nombre);
        if (ok)
        {
            Toast.Success("Categoría asignada ✓");
            await LoadContactos();
            await LoadConversaciones(silent: true);
        }
        else Toast.Error(err ?? "No se pudo poner la categoría");
    }

    async Task GuardarQuickContact()
    {
        if (string.IsNullOrWhiteSpace(quickContactNombre)) { Toast.Error("El nombre es obligatorio"); return; }
        var upsert = new ApiClient.TwContactoUpsert(
            quickContactNumero, quickContactNombre, quickContactRol, quickContactNotas, true, quickContactClienteId);
        bool ok; string? err = null;
        if (quickContactEditId is int editId)
