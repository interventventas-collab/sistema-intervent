    .wa-srv-upload-btn:hover { background: #1ea953; }
    .wa-srv-upload-btn.cargando { background: #9ca3af; cursor: wait; }
    .wa-srv-upload-hint { font-size: 0.72rem; color: #6b7280; margin-top: 0.4rem; }

    /* 2026-08-04: reenviar mensajes a uno o varios contactos */
    .wa-fwd-overlay { position: fixed; inset: 0; background: rgba(0,0,0,0.35); z-index: 1090; }
    .wa-fwd-modal { position: fixed; top: 50%; left: 50%; transform: translate(-50%,-50%); background: white; border-radius: 12px; padding: 1rem 1.1rem; box-shadow: 0 20px 60px rgba(0,0,0,0.25); z-index: 1100; width: 92%; max-width: 460px; max-height: 82vh; display: flex; flex-direction: column; }
    .wa-fwd-head { display: flex; justify-content: space-between; align-items: center; font-size: 1rem; }
