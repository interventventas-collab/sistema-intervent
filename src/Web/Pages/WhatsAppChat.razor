    // 2026-08-22 (pedido del dueño): "Solo alias" MANDA SOLO, y manda DOS mensajes separados:
    //   1) los datos de la cuenta en UN renglón (banco · titular · CUIT) + "te paso el alias 👇"
    //   2) el alias PELADO, último → el cliente lo copia de un toque (mantener apretado = copiar
    //      el mensaje entero). Mezclado con el resto tiene que seleccionar a mano y se equivoca.
    // El alias va ÚLTIMO a propósito: queda al fondo del chat (no lo tiene que ir a buscar) y le
    // llega DESPUÉS de saber a nombre de quién transfiere, que es cuando le sirve el dato.
    // Antes este botón pegaba en el cuadro CASI TODO (título, titular, CUIT, alias y mail): lo único
    // que sacaba era la línea del CBU, así que "solo alias" no era solo el alias.
    async Task EnviarSoloAlias(ApiClient.TwCbuDto cb)
    {
        var alias = (cb.Alias ?? "").Trim();
        if (alias.Length == 0) return;
        var chat = selectedNumero;
        if (chat == null) { Toast.Warning("Abrí primero una conversación."); return; }

        // 22/08/2026: al cliente le llegaron DOS veces los datos del titular. Dos candados:
        // 1) mientras está mandando, los clics de más se descartan (antes cada clic arrancaba su propia tanda).
        if (enviandoAlias) return;
        // 2) el mismo alias al mismo chat dos veces seguidas: casi siempre es el dedo, no la intención.
        if (_ultimoAliasChat == chat && _ultimoAliasTexto == alias
            && (DateTime.Now - _ultimoAliasCuando).TotalSeconds < 20)
        {
            showCbuPanel = false;
            Toast.Info("Ese alias se lo mandaste recién. Si de verdad lo querés repetir, esperá unos segundos.");
            return;
        }

        enviandoAlias = true;
        showCbuPanel = false;
        StateHasChanged();
        try
        {
            // Si el primero no sale (fuera de las 24 hs, error de Meta…), NO mandamos el alias:
            // quedaría un alias suelto sin decir de quién es la cuenta.
            if (!await EnviarTexto(TextoDatosCuenta(cb))) return;
            if (!await EnviarTexto(alias)) return;
            _ultimoAliasChat = chat; _ultimoAliasTexto = alias; _ultimoAliasCuando = DateTime.Now;
        }
        finally { enviandoAlias = false; StateHasChanged(); }
    }

