    // (lo registra el webhook) → 📸 @usuario; WhatsApp es un número → 📱 número.
    string EtiquetaLineaChip(string? lineaNumero, string id)
    {
        var t = lineaNumero ?? id;
        var emoji = t.StartsWith("IG ", StringComparison.Ordinal) ? "📸" : "📱";
        return $"{emoji} {LineaNombre(id, lineaNumero)}";
    }
    bool LineaActivaTieneNumero =>
        LineasDetectadas().Count == 1
        || (!string.IsNullOrEmpty(filtroLinea) && LineasDetectadas().Any(x => x.Id == filtroLinea));
    string LineaActivaTexto()
    {
        var ls = LineasDetectadas();
        if (ls.Count == 0) return "WhatsApp de la empresa";
        if (!string.IsNullOrEmpty(filtroLinea))
        {
            var sel = ls.FirstOrDefault(x => x.Id == filtroLinea);
            if (sel.Numero != null) return LineaNombre(sel.Id, sel.Numero);
        }
        if (ls.Count == 1) return LineaNombre(ls[0].Id, ls[0].Numero);
        return "Todas las líneas";
    }

    string filtroTexto = "";
    bool MatchFiltro(ApiClient.TwConvDto c)
    {
        if (!string.IsNullOrEmpty(filtroLinea) && c.Linea != filtroLinea) return false;
        // 2026-08-09: ARCHIVADOS. La vista "🗂️ Archivados" muestra solo los archivados. En cualquier
        // otra vista los archivados quedan OCULTOS, salvo que estés buscando (escribiendo en el buscador):
        // así reaparecen al buscar al cliente, y también reaparecen solos cuando el cliente vuelve a escribir
        // (ahí el servidor deja de marcarlos como archivados).
        bool buscando = !string.IsNullOrWhiteSpace(filtroTexto);
        if (filtroRol == "archivado") { if (!c.Archivado) return false; }
        else if (c.Archivado && !buscando) return false;
        // 2026-07-24: buscador por nombre de perfil, número o cliente vinculado
        if (!string.IsNullOrWhiteSpace(filtroTexto))
        {
            var q = filtroTexto.Trim();
            var hit = (c.NombrePerfil ?? "").Contains(q, StringComparison.OrdinalIgnoreCase)
                   || (c.Numero ?? "").Contains(q, StringComparison.OrdinalIgnoreCase)
                   || (c.ClienteNombre ?? "").Contains(q, StringComparison.OrdinalIgnoreCase);
            if (!hit) return false;
        }
        if (filtroRol == "archivado") return true;
        if (string.IsNullOrEmpty(filtroRol)) return true;
        if (filtroRol == "pedido") return EsPedido(c.UltimoMensaje);
        if (filtroRol == "sin") return string.IsNullOrEmpty(c.Rol);
        // 2026-08-04: filtros por responsable / estado
        if (filtroRol == "mios") return !string.IsNullOrEmpty(OperadorActual)
            && string.Equals(c.AsignadoOperador, OperadorActual, StringComparison.OrdinalIgnoreCase);
        if (filtroRol == "en_curso") return c.Estado == "en_curso";
        if (filtroRol == "esperando") return c.Estado == "esperando";
        if (filtroRol == "finalizada") return c.Estado == "finalizada";
        return c.Rol == filtroRol;
    }

    // ===== 2026-08-04: pasar la charla a otro + estados =====
    // Operadores a los que se puede pasar. DEPOSITO queda preparado pero OCULTO por ahora
    // (agregarlo acá cuando el usuario quiera que Depósito lo empiece a ver).
    static readonly string[] OperadoresPasar = { "OSMAR", "GERMAN", "GABRIEL" };
    static readonly (string Key, string Label)[] EstadosLista =
    {
        ("nueva", "Nueva"), ("en_curso", "En curso"), ("esperando", "Esperando"), ("finalizada", "Finalizada")
    };
    string asignarNota = "";
    string? OperadorActual => string.IsNullOrWhiteSpace(Op.Current) ? null : Op.Current!.Trim().ToUpperInvariant();

    // 2026-08-12: ¿el chat abierto es uno de los que ve Depósito? (define botón "Ocultar a Depósito"
    // + firma automática del operador del PIN). Ver Web.Services.DepositoChats.
    bool EsChatVisibleDeposito => Web.Services.DepositoChats.EsVisible(selectedNumero, selectedLinea);

    // Charla que ME pasaron a mí y todavía no abrí (dispara el aviso 🔔).
    bool EsPasadaAMi(ApiClient.TwConvDto c) =>
        !string.IsNullOrEmpty(OperadorActual)
        && string.Equals(c.AsignadoOperador, OperadorActual, StringComparison.OrdinalIgnoreCase)
        && !c.AsignadoVisto;
    int MisPendientes() => string.IsNullOrEmpty(OperadorActual) ? 0 : conversaciones.Count(EsPasadaAMi);

    string EstadoLabel(string? e) => e switch
    {
        "en_curso" => "En curso", "esperando" => "Esperando", "finalizada" => "Finalizada", "archivado" => "Archivado", _ => "Nueva"
    };
    string EstadoColor(string? e) => e switch
    {
        "en_curso" => "#f59e0b", "esperando" => "#f97316", "finalizada" => "#16a34a", "archivado" => "#6b7280", _ => "#3b82f6"
    };
    string OperadorColor(string? op) => Web.Services.OperatorService.ShortBgColor(op);
    string OperadorIni(string? op) => Web.Services.OperatorService.ShortLabel(op);

    async Task PasarA(string operador)
    {
        if (selectedNumero == null) return;
        var ok = await Api.AsignarConversacionAsync(selectedNumero, selectedLinea, operador, asignarNota);
        if (ok)
        {
            Toast.Success(string.Equals(operador, OperadorActual, StringComparison.OrdinalIgnoreCase)
                ? "La tomaste vos" : $"Se la pasaste a {operador}");
            // 2026-08-06: la nota NO se borra al pasar la charla (queda guardada y editable).
            await LoadConversaciones(silent: true);
        }
        else Toast.Error("No se pudo pasar la conversación");
    }
    async Task QuitarAsignacion()
    {
        if (selectedNumero == null) return;
        // 2026-08-06: al sacar el responsable NO borramos la nota — la mantenemos guardada.
        var ok = await Api.AsignarConversacionAsync(selectedNumero, selectedLinea, null, asignarNota);
        if (ok) await LoadConversaciones(silent: true);
    }
    async Task CambiarEstado(string estado)
    {
        if (selectedNumero == null) return;
        var ok = await Api.CambiarEstadoConversacionAsync(selectedNumero, selectedLinea, estado);
        if (ok) await LoadConversaciones(silent: true);
        else Toast.Error("No se pudo cambiar el estado");
    }

    // 2026-08-06: desplegables de Estado y Pasar a (reemplazan las filas de botones)
    // 2026-08-09: "Archivado" es una opción más del desplegable de estado. Elegirla saca la charla del
    // listado (sin cambiar el estado real de fondo). Elegir cualquier otro estado la desarchiva.
    async Task OnEstadoChange(ChangeEventArgs e)
    {
        var estado = e.Value?.ToString();
        if (string.IsNullOrEmpty(estado)) return;
        if (estado == "archivado") { await ArchivarConvActual(true); return; }
        // Volver a un estado normal: si estaba archivada, desarchivar primero.
        if (SelectedConv()?.Archivado == true) await ArchivarConvActual(false);
        await CambiarEstado(estado);
    }
    // ===== 2026-08-19: FIJAR CHATS (chinche 📌, como WhatsApp) =====
    // Hasta 5 fijados a la vez, compartidos para todo el equipo (igual que el estado y el archivado).
    // El tope real lo controla el servidor; acá solo mostramos el aviso que él devuelve.
    const int MaxFijados = 5;
    int CantFijados() => conversaciones.Count(x => x.Fijado);

    async Task FijarConv(ApiClient.TwConvDto c)
    {
        var fijar = !c.Fijado;
        if (fijar && CantFijados() >= MaxFijados)
        {
            Toast.Error($"Ya tenés {MaxFijados} chats fijados. Sacá uno para poder fijar este 📌");
            return;
        }
        var (ok, error) = await Api.FijarConversacionAsync(c.Numero, c.Linea, fijar);
        if (!ok)
        {
            Toast.Error(error ?? "No se pudo fijar el chat");
            return;
        }
        Toast.Success(fijar ? "Chat fijado arriba 📌" : "Chat sacado de los fijados");
        await LoadConversaciones(silent: true);
        StateHasChanged();
    }

    // 2026-08-09: archivar/desarchivar la conversación abierta. archivar=true la saca del listado general
    // (vuelve sola si el cliente escribe de nuevo, o al buscarla). Compartido para todo el equipo.
    async Task ArchivarConvActual(bool archivar)
    {
        if (selectedNumero == null) return;
        var ok = await Api.ArchivarConversacionAsync(selectedNumero, selectedLinea, archivar);
        if (ok)
        {
            Toast.Success(archivar ? "Chat archivado 🗂️" : "Chat de vuelta en el listado 📤");
            await LoadConversaciones(silent: true);
        }
        else Toast.Error("No se pudo archivar");
    }
    async Task OnPasarChange(ChangeEventArgs e)
    {
        var op = e.Value?.ToString();
        if (string.IsNullOrEmpty(op)) await QuitarAsignacion();
        else await PasarA(op);
    }

    // 2026-08-06: guardar/editar la NOTA (comentario) de la conversación de forma independiente
    // (antes solo se guardaba al pasar la charla a alguien).
    bool guardandoNota = false;
    async Task GuardarNotaConv()
    {
        if (selectedNumero == null) return;
        guardandoNota = true;
        var ok = await Api.GuardarNotaConversacionAsync(selectedNumero, selectedLinea, asignarNota);
        guardandoNota = false;
        if (ok) { Toast.Success("Nota guardada"); await LoadConversaciones(silent: true); }
        else Toast.Error("No se pudo guardar la nota");
    }

    // Heuristica simple: si el mensaje contiene palabras tipicas de pedido.
    bool EsPedido(string? msg)
    {
        if (string.IsNullOrWhiteSpace(msg)) return false;
        var m = msg.ToLowerInvariant();
        return m.StartsWith("#ped") || m.StartsWith("pedido")
            || m.Contains("necesito") || m.Contains("pasame") || m.Contains("mandame")
            || m.Contains("traeme") || m.Contains("llevame") || m.Contains("encarg");
    }

