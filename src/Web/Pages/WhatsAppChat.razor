    /// <summary>Lee un importe escrito a mano aceptando coma o punto ("12.500,50", "12500,5",
    /// "12500.5"). Con un campo numérico común, la coma deja el campo vacío.</summary>
    static decimal? PlataDesdeTexto(string? txt)
    {
        var s = (txt ?? "").Trim();
        if (s.Length == 0) return null;
        s = s.Replace("$", "").Replace(" ", "");
        var tienePunto = s.Contains('.');
        var tieneComa = s.Contains(',');
        if (tienePunto && tieneComa)
        {
            // el separador decimal es el ÚLTIMO que aparece; el otro son los miles
            if (s.LastIndexOf(',') > s.LastIndexOf('.')) s = s.Replace(".", "").Replace(',', '.');
            else s = s.Replace(",", "");
        }
        else if (tieneComa) s = s.Replace(',', '.');
        else if (tienePunto)
        {
            // un solo punto con 1 o 2 decimales = decimal; si no, son los miles (12.500)
            var i = s.IndexOf('.');
            var decimales = s.Length - i - 1;
            if (s.IndexOf('.') != s.LastIndexOf('.') || decimales == 3) s = s.Replace(".", "");
        }
        return decimal.TryParse(s, System.Globalization.NumberStyles.Any,
                                System.Globalization.CultureInfo.InvariantCulture, out var v) ? v : null;
    }

    static string Plata(decimal v) => "$" + v.ToString("N2", System.Globalization.CultureInfo.GetCultureInfo("es-AR"));

