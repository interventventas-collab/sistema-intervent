@if (showAdjuntarServidor)
{
    <div class="wa-modal-backdrop" @onclick="CerrarAdjuntarServidor" style="z-index:1099;"></div>
    <div class="wa-srv-modal" @onclick:stopPropagation="true">
        <div style="display:flex; justify-content:space-between; align-items:center;">
            <h5 style="margin:0;">🗂️ Adjuntar del servidor</h5>
            <button class="btn btn-sm btn-outline-secondary" @onclick="CerrarAdjuntarServidor">×</button>
        </div>
        <div style="font-size:0.75rem; color:#6b7280; margin-top:0.25rem;">
            Enviar a <strong>@(MostrarNombre(SelectedConv()))</strong>
        </div>
        <div class="wa-srv-tabs">
            <button class="wa-srv-tab @(srvTab == "VENTA" ? "active" : "")" @onclick='() => CambiarTabServidor("VENTA")'>🧾 Facturas/Ventas</button>
            <button class="wa-srv-tab @(srvTab == "COBRANZA" ? "active" : "")" @onclick='() => CambiarTabServidor("COBRANZA")'>💰 Recibos cobranza</button>
            <button class="wa-srv-tab @(srvTab == "LISTA" ? "active" : "")" @onclick='() => CambiarTabServidor("LISTA")'>💲 Listas de precios</button>
            <button class="wa-srv-tab @(srvTab == "CATALOGO" ? "active" : "")" @onclick='() => CambiarTabServidor("CATALOGO")'>📚 Catálogos</button>
            <button class="wa-srv-tab @(srvTab == "ALQUILER" ? "active" : "")" @onclick='() => CambiarTabServidor("ALQUILER")'>🎪 Alquileres</button>
            <button class="wa-srv-tab @(srvTab == "VISITA" ? "active" : "")" @onclick='() => CambiarTabServidor("VISITA")'>📋 Recibos de visita</button>
            <button class="wa-srv-tab @(srvTab == "UPLOAD" ? "active" : "")" @onclick='() => CambiarTabServidor("UPLOAD")'>📁 Mis subidos</button>
        </div>
        @if (srvTab == "CATALOGO")
        {
            <div class="wa-srv-upload">
                <label class="wa-srv-upload-btn @(catSubiendo ? "cargando" : "")">
                    @(catSubiendo ? "⏳ Subiendo…" : "⬆️ Subir catálogo (PDF, documento o imagen)")
                    <InputFile OnChange="OnCatalogoSeleccionado" disabled="@catSubiendo"
                               accept=".pdf,.doc,.docx,.xls,.xlsx,image/*" style="display:none;" />
                </label>
                <div class="wa-srv-upload-hint">Estos archivos quedan guardados para siempre (no se borran a las 24 hs).</div>
            </div>
        }
        <input class="wa-srv-search" placeholder="@SrvSearchPlaceholder()"
               value="@srvSearch" @oninput="OnSrvSearchInput" />
        <div class="wa-srv-list">
            @if (srvLoading)
            {
                <div class="wa-srv-empty">Cargando…</div>
            }
            else if (srvResultados.Count == 0)
            {
                <div class="wa-srv-empty">@(string.IsNullOrWhiteSpace(srvSearch) ? "Sin resultados. Probá buscando." : "Sin resultados con ese filtro.")</div>
            }
            else
            {
                @foreach (var f in srvResultados)
                {
                    <div class="wa-srv-item">
                        @if (!string.IsNullOrWhiteSpace(f.PreviewUrl))
                        {
                            <img class="wa-srv-thumb" src="@f.PreviewUrl" alt="" loading="lazy" />
                        }
                        else
                        {
                            <div class="wa-srv-thumb wa-srv-thumb-icon">@(string.IsNullOrWhiteSpace(f.Icon) ? "📎" : f.Icon)</div>
                        }
                        <div class="wa-srv-item-main">
                            <div class="wa-srv-item-label">@f.Label</div>
                            @if (!string.IsNullOrWhiteSpace(f.SubLabel))
                            {
                                <div class="wa-srv-item-sub">@f.SubLabel</div>
                            }
                            @if (!string.IsNullOrWhiteSpace(f.Info))
                            {
                                <div class="wa-srv-item-info">@f.Info · @f.Fecha.ToArTime().ToString("dd/MM/yyyy")</div>
                            }
                        </div>
                        @* 2026-08-05: ahora SUMA a la bandeja de pendientes (no envía directo) *@
                        <button class="wa-srv-send-btn" @onclick="() => StagearServerFile(f)">
                            ➕ Agregar
                        </button>
                        @if (f.Tipo == "CATALOGO")
                        {
                            <button class="wa-srv-del-btn" title="Borrar catálogo" @onclick="() => BorrarCatalogo(f)">🗑️</button>
                        }
                    </div>
                }
            }
        </div>
    </div>
}

@code {
    List<ApiClient.TwConvDto> conversaciones = new();
    List<ApiClient.TwMsgDto> mensajes = new();

    /// <summary>2026-08-20: mensajes largos que el usuario abrió con "Leer más" (por Id).</summary>
    private readonly HashSet<int> textoAbierto = new();

    // ═══════ 2026-08-20: buscador DENTRO de la charla (la lupa) — igual que en el celular ═══════
    // Busca en los mensajes que la pantalla ya trajo (los últimos 200 de cada charla). En producción
    // 189 de 193 charlas tienen menos de 200, así que para casi todas es toda la historia; en las
    // que se pasan, el cartelito amarillo dice hasta dónde se miró.
    private const int TopeCargadosBusq = 200;

    private bool buscadorAbierto;
    private string busqTexto = "";
    private readonly List<int> busqHits = new();       // Ids, del más VIEJO al más nuevo
    private readonly HashSet<int> busqHitSet = new();
    private int busqPos = -1;
    private string? busqAviso;

    // ===== 2026-08-21: BUSCADOR GLOBAL — una palabra en los mensajes de TODAS las charlas =====
    // El buscador de arriba (el de la píldora) filtra por nombre/número. Este va a la base y
    // mira el TEXTO de todos los mensajes, para cuando te acordás de lo que se dijo pero no de
    // con quién. Al tocar un resultado se abre esa charla parada en ese mensaje.
    private bool bgAbierto;
    private bool bgBuscando;
    private string bgTexto = "";
    private ApiClient.TwBusquedaGlobalDto? bgResultado;

    private async Task BuscarEnTodosLosMensajes()
    {
        var q = (filtroTexto ?? "").Trim();
        if (q.Length < 2) { Toast.Warning("Escribí al menos dos letras"); return; }
        bgTexto = q;
        bgAbierto = true;
        bgBuscando = true;
        bgResultado = null;
        StateHasChanged();
        // Si estás mirando una sola línea, la respeta; si no, busca en todas.
        bgResultado = await Api.BuscarMensajesGlobalAsync(q, string.IsNullOrEmpty(filtroLinea) ? null : filtroLinea);
        bgBuscando = false;
        if (bgResultado is null) Toast.Error("No pude buscar en los mensajes");
        StateHasChanged();
    }

    private void CerrarBusquedaGlobal()
    {
        bgAbierto = false;
        bgResultado = null;
        bgTexto = "";
    }

    /// <summary>Abre la charla del resultado y queda parado en ese mensaje, con la lupa de la
    /// charla ya cargada con la misma palabra (para saltar entre las demás veces que aparece).</summary>
    private async Task AbrirHitGlobal(ApiClient.TwHitBusquedaDto h)
    {
        var palabra = bgTexto;
        await SelectConv(h.Numero, h.Linea);
        buscadorAbierto = true;
        busqTexto = palabra;
        RecalcularBusqueda();
        // Parados justo en el mensaje que encontró (si sigue dentro de los últimos cargados).
        if (mensajes.Any(m => m.Id == h.Id))
        {
            busqPos = busqHits.IndexOf(h.Id);
            await Task.Delay(120);   // dejar que termine de pintar la charla
            try { await JS.InvokeVoidAsync("waIrAlMensaje", $"wamsg-{h.Id}"); } catch { }
        }
        else
        {
            Toast.Info("Ese mensaje es más viejo que los últimos que carga la charla. Te la abrí igual.");
        }
        StateHasChanged();
    }

    private void ToggleBuscador()
    {
        if (buscadorAbierto) CerrarBuscador();
        else buscadorAbierto = true;
    }

    private void CerrarBuscador()
    {
        buscadorAbierto = false;
        busqTexto = "";
        busqHits.Clear();
        busqHitSet.Clear();
        busqPos = -1;
        busqAviso = null;
    }

    private string ContadorBusqueda
    {
        get
        {
            if (busqTexto.Trim().Length < 2) return "";
            if (busqHits.Count == 0) return "sin resultados";
            return $"{busqPos + 1}/{busqHits.Count}";
        }
    }

    private async Task OnBuscar(ChangeEventArgs e)
    {
        busqTexto = e.Value?.ToString() ?? "";
        RecalcularBusqueda();
        if (busqHits.Count > 0) { busqPos = busqHits.Count - 1; await IrAlHit(); }
    }

    /// <summary>Enter salta al siguiente y Shift+Enter al anterior, como el buscador del navegador.</summary>
    private async Task OnBuscarTecla(KeyboardEventArgs e)
    {
        if (e.Key != "Enter") return;
        await SaltarBusqueda(e.ShiftKey ? -1 : 1);
    }

    private void RecalcularBusqueda()
    {
        busqHits.Clear();
        busqHitSet.Clear();
        busqPos = -1;
        busqAviso = null;

        var q = busqTexto.ToSearchKeySinTildes();
        if (q.Length < 2) return;

        foreach (var m in mensajes)   // del más viejo al más nuevo
        {
            if (m.Cuerpo.ToSearchKeySinTildes().Contains(q))
            {
                busqHits.Add(m.Id);
                busqHitSet.Add(m.Id);
            }
        }

        if (mensajes.Count >= TopeCargadosBusq)
            busqAviso = $"Busqué en los últimos {mensajes.Count} mensajes de esta charla, que son los que están cargados.";
        else if (busqHits.Count == 0)
            busqAviso = "No encontré esa palabra en toda esta charla.";
    }

    private async Task SaltarBusqueda(int paso)
    {
        if (busqHits.Count == 0) return;
        busqPos = (busqPos + paso + busqHits.Count) % busqHits.Count;
        await IrAlHit();
    }

    private async Task IrAlHit()
    {
        if (busqPos < 0 || busqPos >= busqHits.Count) return;
        try { await JS.InvokeVoidAsync("waIrAlMensaje", $"wamsg-{busqHits[busqPos]}"); } catch { }
    }

    private void ToggleTexto(int id)
    {
        if (!textoAbierto.Add(id)) textoAbierto.Remove(id);
    }

    string? selectedNumero;
    // 2026-08-01: la línea del chat abierto (junto con selectedNumero identifica la conversación).
    // Así el mismo contacto en 2 líneas nuestras son 2 chats distintos y no se cruzan.
    string? selectedLinea;
    string composerText = "";

    // 2026-08-26: cada chat se acuerda de lo que dejaste escrito y de los archivos que cargaste,
    // como WhatsApp. Antes el texto y los adjuntos NO se limpiaban al cambiar de conversación:
    // abrías otro chat, el cursor caía solo en el cuadro con el texto del anterior y un Enter se
    // lo mandaba al cliente equivocado. Con una factura colgada era peor todavía.
    Dictionary<string, string> borradorTexto = new();
    Dictionary<string, List<PendingAdjunto>> borradorAdjuntos = new();

    static string ClaveChat(string? numero, string? linea) => $"{linea}|{numero}";

    /// <summary>Antes de irte del chat: lo que quedó escrito y adjuntado se guarda EN ESE chat.</summary>
    void GuardarBorradorDelChat()
    {
        if (selectedNumero == null) return;
        var k = ClaveChat(selectedNumero, selectedLinea);
        if (string.IsNullOrWhiteSpace(composerText)) borradorTexto.Remove(k);
        else borradorTexto[k] = composerText;
        if (pendientes.Count == 0) borradorAdjuntos.Remove(k);
        else borradorAdjuntos[k] = new List<PendingAdjunto>(pendientes);
    }

    /// <summary>Al entrar a un chat: se recupera SU borrador (y si no tenía, el cuadro queda vacío).</summary>
    void RestaurarBorradorDelChat()
    {
        var k = ClaveChat(selectedNumero, selectedLinea);
        composerText = borradorTexto.TryGetValue(k, out var t) ? t : "";
        pendientes = borradorAdjuntos.TryGetValue(k, out var a) ? new List<PendingAdjunto>(a) : new();
    }

    // === 2026-08-01: nota de voz (grabar con micrófono y enviar como audio nativo) ===
    bool grabandoAudio = false, enviandoAudio = false;
    class WaUploadRes { public string? Url { get; set; } public string? OriginalFilename { get; set; } }

    async Task ToggleGrabarAudio()
    {
        if (selectedNumero == null) { Toast.Warning("Elegí un chat primero"); return; }
        if (!grabandoAudio)
        {
            bool ok;
            try { ok = await JS.InvokeAsync<bool>("waAudio.start"); }
            catch { ok = false; }
            if (!ok) { Toast.Error("No pude acceder al micrófono. Revisá los permisos del navegador (y que estés en HTTPS)."); return; }
            grabandoAudio = true;
        }
        else
        {
            grabandoAudio = false;
            enviandoAudio = true;
            StateHasChanged();
            WaUploadRes? res = null;
            try { res = await JS.InvokeAsync<WaUploadRes?>("waAudio.stopAndUpload"); }
            catch { }
            if (res == null || string.IsNullOrEmpty(res.Url))
            {
                enviandoAudio = false;
                Toast.Error("No se pudo grabar o subir el audio");
                return;
            }
            // 2026-08-26: si estás programando, la nota de voz NO sale ahora: se suma a la bandeja
            // de adjuntos y se agenda con el resto. (Ya viene subida al servidor, así que de acá en
            // más es un archivo igual al del clip.)
            if (ProgramandoDesdeComposer())
            {
                pendientes.Add(new PendingAdjunto
                {
                    Kind = "UPLOAD",
                    Url = res.Url,
                    FileName = res.OriginalFilename ?? "audio.ogg",
                    Label = "🎤 Nota de voz",
                    Icono = "🎤"
                });
                enviandoAudio = false;
                Toast.Info("La nota de voz quedó lista para programarse.");
                StateHasChanged();
                return;
            }
            var (ok, err) = await Api.SendTwMediaAsync(selectedNumero, res.Url, null, res.OriginalFilename, selectedLinea);
            enviandoAudio = false;
            if (!ok) Toast.Error(err ?? "No se pudo enviar la nota de voz");
            else await LoadMensajes();
            StateHasChanged();
        }
    }

    async Task CancelarAudio()
    {
        grabandoAudio = false;
        try { await JS.InvokeVoidAsync("waAudio.cancel"); } catch { }
    }
    bool loadingConv = true, loadingMsg = false, sending = false, uploading = false, enviandoMenuRol = false;
    // 2026-08-18: el menú de opciones ahora se confirma antes de salir (se mandaba de un toque).
    bool confirmarMenuRol = false;
    System.Threading.Timer? refreshTimer;
    Microsoft.AspNetCore.Components.ElementReference messagesScroll;

    // Respuestas rapidas + contactos
    List<ApiClient.TwRespRapidaDto> respuestas = new();
    List<ApiClient.TwContactoDto> contactos = new();
    bool showQuickReplies = false;   // 2026-08-05: desplegable de respuestas rápidas arriba del botón Enviar
    // 2026-07-29: Datos bancarios / CBUs
    List<ApiClient.TwCbuDto> datosBancarios = new();
    bool showCbuPanel = false;
    // 2026-08-27: los casilleros de edición de respuestas, CBUs y contactos se fueron con la
    //             configuración a Shared/WaConfig.razor. Acá solo quedan las listas para leer.
    // Reacciones
    int? pickerOpenMsgId = null;
    // 2026-07-23: ☕ y 🫘 primeros (pedido Osmar — "grano de café" no existe como emoji, esto es lo más parecido)
    static readonly string[] QuickEmojis = new[] { "☕", "🫘", "👍", "❤️", "😂", "😮", "😢", "🙏", "✅", "❌", "⏳", "❗" };
    // === Selección de mensajes + Nueva Venta en ventana popup ===
    HashSet<int> mensajesSeleccionadosIds = new();
    // 2026-08-05: modo "elegir mensajes para la venta" (se activa con el botón "Crear venta" del encabezado)
    bool modoElegirVenta = false;

    // 2026-08-03: ventana flotante de preview del pedido (se ve el texto completo, se puede mover y editar)
    bool showPedidoFloat = false;
    string pedidoFloatTexto = "";
    bool creandoPedidoFloat = false;
    bool _pedidoFloatAttachPending = false;

    /// <summary>Arma el texto del pedido: si hay mensajes tildados usa esos (en orden), y si no hay
    /// ninguno tildado cae al último mensaje que entró del cliente.</summary>
    string TextoPedidoDesdeChat()
    {
        if (mensajesSeleccionadosIds.Count > 0)
            return string.Join("\n", mensajes.Where(m => mensajesSeleccionadosIds.Contains(m.Id))
                .OrderBy(m => m.CreatedAt)
                .Where(m => !string.IsNullOrWhiteSpace(m.Cuerpo))
                .Select(m => m.Cuerpo!));
        return mensajes.LastOrDefault(m => m.Direccion == "INCOMING")?.Cuerpo ?? "";
    }

    /// <summary>Abre la ventana flotante con el texto para revisar antes de crear la venta.</summary>
    void AbrirPreviewPedido()
    {
        var texto = TextoPedidoDesdeChat();
        if (string.IsNullOrWhiteSpace(texto)) { Toast.Warning("No hay texto para el pedido. Tildá un mensaje."); return; }
        pedidoFloatTexto = texto;
        showPedidoFloat = true;
        _pedidoFloatAttachPending = true;
        StateHasChanged();
    }

    // 2026-08-05: NUEVO flujo de "Crear venta" desde el chat.
    // Paso 1: el botón del encabezado entra en modo "elegir mensajes" (aparece la barra de abajo).
    void IniciarCrearVenta()
    {
        if (selectedNumero == null) { Toast.Warning("Elegí un chat primero"); return; }
        // Si ya estaba en modo, lo apagamos (toggle).
        if (modoElegirVenta) { modoElegirVenta = false; return; }
        modoElegirVenta = true;
        mensajesSeleccionadosIds.Clear();   // empezar la selección de cero
    }

    void CancelarSeleccionVenta()
    {
        modoElegirVenta = false;
        modoSeleccion = false;
        mensajesSeleccionadosIds.Clear();
    }

    // Paso 2: abre Nueva Venta en una PESTAÑA NUEVA con el cliente (si el chat tiene uno asignado) y
    // los mensajes tildados en "Comentario para armado". NO crea ningún pedido en la cola —
    // usa el circuito ?fromTwilio=1&notas=...&clienteIdPre=... que ya existe en /cafe/ventas.
    // 2026-08-24: antes de abrir la venta preguntamos A NOMBRE DE QUIÉN va. Pedido del dueño: en el
    // chat del hermano vienen pedidos de OTROS clientes ("Facundo Ramos", "Venado Graciela"…), así
    // que el cliente del chat no siempre es el que compra. Por default sigue siendo el del chat:
    // si no tocás nada, funciona igual que antes.
    void AbrirVentaDesdeChat()
    {
        var texto = TextoPedidoDesdeChat();   // mensajes tildados, o el último entrante si no tildaste ninguno
        if (string.IsNullOrWhiteSpace(texto)) { Toast.Warning("Tildá los mensajes del pedido y tocá 'Abrir venta'."); return; }
        var conv = SelectedConv();
        AbrirElegirCliente("🧾 ¿A nombre de quién va esta venta?", conv?.ClienteId, conv?.ClienteNombre,
                           async (cid, _) => await AbrirVentaEnPestania(texto.Trim(), cid));
    }

    async Task AbrirVentaEnPestania(string texto, int? clienteId)
    {
        var url = $"/cafe/ventas?fromTwilio=1&notas={Uri.EscapeDataString(texto)}";
        if (clienteId is int cid) url += $"&clienteIdPre={cid}";
        // pestaña nueva (no ventanita chica): el operador suele tener dos pantallas
        await JS.InvokeVoidAsync("open", url, "_blank");
        modoElegirVenta = false;
        mensajesSeleccionadosIds.Clear();
    }

    // ═══════ Elegir cliente (compartido por "Abrir venta" y por el Modo venta) ═══════
    // Un solo cartel para las dos cosas: arriba el cliente del chat ya elegido, abajo el buscador
    // por si la venta va a otro, y al final el alta rápida si todavía no existe.
    private bool showElegirCli;
    private string elegirCliTitulo = "";
    private int? elegirCliDefaultId;
    private string? elegirCliDefaultNombre;
    private string elegirCliQuery = "";
    private List<ApiClient.TwClienteBuscarDto> elegirCliResultados = new();
    private bool elegirCliBuscando;
    private string elegirCliNuevoNombre = "";
    private bool elegirCliCreando;
    private Func<int?, string?, Task>? elegirCliAlElegir;

    void AbrirElegirCliente(string titulo, int? defaultId, string? defaultNombre, Func<int?, string?, Task> alElegir)
    {
        elegirCliTitulo = titulo;
        elegirCliDefaultId = defaultId;
        elegirCliDefaultNombre = defaultNombre;
        elegirCliQuery = "";
        elegirCliResultados = new();
        elegirCliBuscando = false;
        elegirCliNuevoNombre = "";
        elegirCliCreando = false;
        elegirCliAlElegir = alElegir;
        showElegirCli = true;
    }

    async Task BuscarClientesElegir()
    {
        var q = (elegirCliQuery ?? "").Trim();
        if (q.Length < 1) { elegirCliResultados = new(); return; }
        elegirCliBuscando = true;
        try { elegirCliResultados = await Api.BuscarTwClientesAsync(q); }
        catch { elegirCliResultados = new(); }
        elegirCliBuscando = false;
    }

    async Task ElegirClienteYSeguir(int? id, string? nombre)
    {
        var cb = elegirCliAlElegir;
        showElegirCli = false;
        elegirCliAlElegir = null;
        if (cb != null) await cb(id, nombre);
    }

    // Alta rápida desde el cartel: crea el cliente y sigue con él. NO lo vincula al chat a propósito
    // — el chat puede seguir siendo el del hermano aunque la venta salga a nombre de otro.
    async Task CrearClienteYSeguir()
    {
        if (elegirCliCreando) return;
        var nombre = (elegirCliNuevoNombre ?? "").Trim();
        if (nombre.Length < 2) { Toast.Warning("Escribí el nombre del cliente nuevo."); return; }
        elegirCliCreando = true;
        try
        {
            var nuevo = await Api.CreateCafeClienteAsync(new CreateCafeClienteRequest { Nombre = nombre, Tipo = "OTRO" });
            if (nuevo is null) { Toast.Error("No pude crear el cliente. Probá de nuevo."); return; }
            Toast.Success($"Cliente «{nuevo.Nombre}» creado.");
            await ElegirClienteYSeguir(nuevo.Id, nuevo.Nombre);
        }
        catch { Toast.Error("No pude crear el cliente. Probá de nuevo."); }
        finally { elegirCliCreando = false; }
    }

    /// <summary>Confirma desde la ventana flotante: crea el pedido con el texto (ya editado si lo tocaron)
    /// y abre Nueva Venta en una ventana nueva, dejando el chat abierto.</summary>
    async Task ConfirmarPedidoFloat()
    {
        creandoPedidoFloat = true;
        var pedidoId = await CrearPedidoRealAsync(pedidoFloatTexto);
        creandoPedidoFloat = false;
        if (pedidoId is null) return;
        showPedidoFloat = false;
        mensajesSeleccionadosIds.Clear();
        var features = "width=1300,height=850,left=200,top=50,resizable=yes,scrollbars=yes,toolbar=no,menubar=no,location=no";
        await JS.InvokeVoidAsync("open", $"/cafe/ventas?pedidoId={pedidoId}", "nueva-venta-wa", features);
    }

    /// <summary>2026-07-23 (unificación): los botones del chat ya no van por un camino propio —
    /// crean un pedido REAL en la cola (la IA lo lee si está prendida) y abren Nueva Venta por el
    /// mismo circuito que todos (?pedidoId=). Devuelve el id del pedido creado, o null si falló.</summary>
    async Task<int?> CrearPedidoRealAsync(string texto)
    {
        if (string.IsNullOrWhiteSpace(texto)) { Toast.Warning("No hay texto para el pedido"); return null; }
        var conv = SelectedConv();
        Toast.Info("Creando el pedido… si la IA está prendida tarda unos segundos en leerlo.");
        var r = await Api.RecibirWhatsAppPedidoAsync(
            PrettyNumero(selectedNumero ?? ""), texto.Trim(),
            clienteId: conv?.ClienteId, source: "whatsapp_chat");
        if (r is null) { Toast.Error("No se pudo crear el pedido"); return null; }
        return r.Id;
    }

