    // Número lindo para mostrar: "+54 9 11 6402-7710" cuando se puede, si no "+" y los dígitos
    static string BonitoNumero(string? numero)
    {
        var d = new string((numero ?? "").Where(char.IsDigit).ToArray());
        if (d.Length == 0) return numero ?? "";
        if (d.StartsWith("549") && d.Length >= 12)
        {
            var resto = d.Substring(3);               // área + abonado
            var area = resto.Length >= 10 ? resto.Substring(0, 2) : resto.Substring(0, Math.Max(0, resto.Length - 8));
            var abon = resto.Substring(area.Length);
            var mitad = abon.Length / 2;
            return $"+54 9 {area} {abon.Substring(0, mitad)}-{abon.Substring(mitad)}";
        }
        return "+" + d;
    }

