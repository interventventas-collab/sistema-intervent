@* 2026-08-01: NUEVA CONVERSACIÓN — escribir primero a alguien con una plantilla aprobada *@
@if (showNuevaConv)
{
    <div class="wa-modal-backdrop" @onclick="@(() => showNuevaConv = false)"></div>
    <div class="wa-modal" style="max-width:560px;">
        <div class="wa-modal-header">
            <h3 style="margin:0; flex:1; font-size:1.05rem;">✍️ Nueva conversación</h3>
            <button class="btn btn-sm btn-outline-secondary" @onclick="@(() => showNuevaConv = false)">×</button>
        </div>
        <div class="wa-modal-body">
            <div style="background:#eff6ff; border:1px solid #bfdbfe; border-radius:6px; padding:0.5rem 0.7rem; font-size:0.78rem; color:#1e40af; margin-bottom:0.8rem;">
                💡 Para escribirle <b>primero</b> a alguien (que no te escribió en las últimas 24h) WhatsApp exige usar una <b>plantilla aprobada</b>. Cuando la persona te responde, ya le podés escribir libre.
            </div>

            @if (nvCargando)
            {
                <div style="text-align:center; padding:1rem; color:#6b7280;">Cargando plantillas…</div>
            }
            else if (nvPlantillas.Count == 0)
            {
                <div style="text-align:center; padding:1rem; color:#b91c1c; font-size:0.85rem;">No hay plantillas aprobadas disponibles. Revisá que la cuenta de WhatsApp esté configurada.</div>
            }
            else
            {
                @* Línea (solo si hay más de una) *@
                @if (nvLineas.Count > 1)
                {
                    <div style="margin-bottom:0.7rem;">
                        <label style="font-size:0.78rem; color:#6b7280; display:block;">Enviar desde la línea</label>
                        <select class="form-control form-control-sm" @bind="nvLineaPhoneId">
                            @foreach (var l in nvLineas)
                            {
                                <option value="@l.PhoneId">📱 @PrettyNumero(l.Numero)</option>
                            }
                        </select>
                    </div>
                }

                @* 2026-08-02: buscar un contacto en todas las fuentes para completar el número solo *@
                <div style="margin-bottom:0.7rem; position:relative;">
                    <label style="font-size:0.78rem; color:#6b7280; display:block;">Buscar contacto (clientes, WhatsApp, MercadoLibre)</label>
                    <input class="form-control form-control-sm" placeholder="Escribí un nombre o número…"
                           @bind="nvClienteQuery" @bind:event="oninput" @onkeyup="BuscarNvClientes" />
                    @if (nvClienteSeleccionado != null)
                    {
                        <div style="font-size:0.72rem; color:#16a34a; margin-top:0.25rem;">✔️ Elegiste: <b>@nvClienteSeleccionado</b> — el número se completó abajo.</div>
                    }
                    @if (nvBuscandoCliente)
                    {
                        <div style="font-size:0.72rem; color:#9ca3af; margin-top:0.25rem;">Buscando…</div>
                    }
                    else if (!string.IsNullOrWhiteSpace(nvClienteQuery) && nvClienteQuery.Length >= 2 && nvClienteResultados.Count == 0)
                    {
                        <div style="font-size:0.72rem; color:#9ca3af; margin-top:0.25rem;">Sin contactos con teléfono para esa búsqueda.</div>
                    }
                    @if (nvClienteResultados.Count > 0)
                    {
                        <div style="border:1px solid #e5e7eb; border-radius:8px; margin-top:0.3rem; max-height:220px; overflow-y:auto;">
                            @foreach (var cli in nvClienteResultados)
                            {
                                <button type="button" class="btn btn-sm" style="display:block; width:100%; text-align:left; border:0; border-bottom:1px solid #f3f4f6; border-radius:0; font-size:0.82rem;"
                                        @onclick="() => SeleccionarNvCliente(cli)">
                                    👤 <b>@cli.Nombre</b>
                                    <span style="color:#9ca3af;">— @cli.Numero</span>
                                    <span style="font-size:0.65rem; color:#2563eb; background:#eff6ff; border-radius:6px; padding:0.05rem 0.35rem; margin-left:0.3rem;">@cli.Origen</span>
                                </button>
                            }
                        </div>
                    }
                </div>

                <div style="margin-bottom:0.7rem;">
                    <label style="font-size:0.78rem; color:#6b7280; display:block;">Número de destino <span style="color:#dc2626;">*</span></label>
                    <input class="form-control form-control-sm" @bind="nvNumero" @bind:event="oninput" placeholder="Con código de país, ej: 5491122525458" />
                    <span style="font-size:0.7rem; color:#9ca3af;">Solo números, con código de país (54) y el 9 de celular. Podés elegir un cliente arriba o escribirlo a mano.</span>
                </div>

                <div style="margin-bottom:0.7rem;">
                    <label style="font-size:0.78rem; color:#6b7280; display:block;">Plantilla <span style="color:#dc2626;">*</span></label>
                    <select class="form-control form-control-sm" value="@nvPlantillaName" @onchange="OnPlantillaChange">
                        <option value="">— Elegí una plantilla —</option>
                        @foreach (var p in nvPlantillas)
                        {
                            <option value="@p.Name">@NombrePlantillaLindo(p.Name) (@p.Category.ToLower())</option>
                        }
                    </select>
                </div>

                @if (PlantillaSel() is {} pSel)
                {
                    @if (pSel.VariableCount > 0)
                    {
                        <div style="margin-bottom:0.6rem;">
                            <label style="font-size:0.78rem; color:#6b7280; display:block; margin-bottom:0.3rem;">Completá los datos de la plantilla</label>
                            @for (int i = 0; i < pSel.VariableCount; i++)
                            {
                                var idx = i;
                                <input class="form-control form-control-sm" style="margin-bottom:0.35rem;"
                                       placeholder="@PlaceholderVariable(idx)"
                                       value="@(idx < nvVariables.Count ? nvVariables[idx] : "")"
                                       @oninput="e => SetVariable(idx, e.Value?.ToString() ?? string.Empty)" />
                            }
                        </div>
                    }

                    <div style="margin-bottom:0.5rem;">
                        <label style="font-size:0.78rem; color:#6b7280; display:block;">Vista previa del mensaje</label>
                        <div style="background:#dcf8c6; border-radius:8px; padding:0.6rem 0.8rem; font-size:0.9rem; white-space:pre-wrap; color:#111;">@PreviewTexto()</div>
                    </div>
                }

                <div style="display:flex; gap:0.5rem; justify-content:flex-end; margin-top:1rem;">
                    <button class="btn btn-secondary btn-sm" @onclick="@(() => showNuevaConv = false)">Cancelar</button>
                    <button class="btn btn-success btn-sm" disabled="@(nvEnviando || PlantillaSel() == null || string.IsNullOrWhiteSpace(nvNumero))" @onclick="EnviarNuevaConv">
                        @(nvEnviando ? "Enviando…" : "📨 Enviar")
                    </button>
                </div>
            }
        </div>
    </div>
}

@* 2026-08-01: ponerle nombre + imagen a una línea (WhatsApp o Instagram) *@
@if (showEditLinea)
{
    <div class="wa-modal-backdrop" @onclick="@(() => showEditLinea = false)"></div>
    <div class="wa-modal" style="max-width:420px;">
        <div class="wa-modal-header">
            <h3 style="margin:0; flex:1; font-size:1.05rem;">🏷️ Nombre e imagen de la línea</h3>
            <button class="btn btn-sm btn-outline-secondary" @onclick="@(() => showEditLinea = false)">×</button>
        </div>
        <div class="wa-modal-body">
            <div style="font-size:0.78rem; color:#6b7280; margin-bottom:0.7rem;">Línea real: <b>@(editLineaNumero ?? editLineaId)</b></div>
            <div style="display:flex; align-items:center; gap:0.9rem; margin-bottom:0.9rem;">
                <div class="wa-linea-av-big">
                    @if (!string.IsNullOrEmpty(editLineaImg)) { <img src="@editLineaImg" alt="" /> } else { <span>📱</span> }
                </div>
                <div style="font-size:0.82rem;">
                    <InputFile OnChange="OnEditLineaImg" accept="image/*" />
                    @if (!string.IsNullOrEmpty(editLineaImg))
                    {
                        <div><button class="btn btn-sm btn-link" style="padding:0; font-size:0.8rem; color:#b91c1c;" @onclick="@(() => editLineaImg = null)">Quitar imagen</button></div>
                    }
                </div>
            </div>
            <label style="font-size:0.78rem; color:#6b7280; display:block;">Nombre</label>
            <input class="form-control form-control-sm" @bind="editLineaNombre" placeholder="Ej: Ventas Café" maxlength="120" />

            <label style="font-size:0.78rem; color:#6b7280; display:block; margin-top:0.7rem;">🔔 Sonido de aviso de esta línea</label>
            <div style="display:flex; gap:0.4rem; align-items:center;">
                <select class="form-control form-control-sm" @bind="editLineaSonido">
                    @foreach (var s in SonidosDisponibles) { <option value="@s.Key">@s.Label</option> }
                </select>
                <button class="btn btn-outline-secondary btn-sm" title="Escuchar este sonido" @onclick="@(() => ProbarSonido(editLineaSonido))">▶</button>
            </div>
            <div style="font-size:0.7rem; color:#9ca3af; margin-top:0.2rem;">Cuando te escriban a esta línea, va a sonar así. Probalo con ▶.</div>

            <div style="display:flex; gap:0.5rem; justify-content:flex-end; margin-top:1.1rem;">
                <button class="btn btn-secondary btn-sm" @onclick="@(() => showEditLinea = false)">Cancelar</button>
                <button class="btn btn-success btn-sm" disabled="@editLineaGuardando" @onclick="GuardarEditLinea">@(editLineaGuardando ? "Guardando…" : "✓ Guardar")</button>
            </div>
        </div>
    </div>
}

@if (showConfig)
{
    <div class="wa-modal-backdrop" @onclick="@(() => showConfig = false)"></div>
    <div class="wa-modal">
        <div class="wa-modal-header">
            <h3 style="margin:0; flex:1;">⚙️ Configuración WhatsApp</h3>
            <button class="btn btn-sm btn-outline-secondary" @onclick="@(() => showConfig = false)">×</button>
        </div>
        <div class="wa-modal-tabs">
            <button class="wa-tab @(configTab=="resp" ? "active" : "")" @onclick="@(() => configTab="resp")">💬 Respuestas rápidas (@respuestas.Count)</button>
            <button class="wa-tab @(configTab=="cbu" ? "active" : "")" @onclick="@(() => configTab="cbu")">🏦 Datos bancarios / CBUs (@datosBancarios.Count)</button>
            <button class="wa-tab @(configTab=="cont" ? "active" : "")" @onclick="@(() => configTab="cont")">👥 Contactos (@contactos.Count)</button>
        </div>
        <div class="wa-modal-body">
            @if (configTab == "resp")
            {
                <p style="color:#6b7280; font-size:0.85rem;">Plantillas que aparecen como botones arriba del mensaje. Click → inserta el texto en el composer.</p>
                <div style="background:#eff6ff; border:1px solid #bfdbfe; padding:0.5rem 0.75rem; border-radius:6px; font-size:0.8rem; color:#1e40af; margin-bottom:0.6rem;">
                    💡 <strong>Variables disponibles</strong>: usá <code>{nombre}</code> o <code>{numero}</code> en el texto y se reemplazan solos al insertar. Ej: <em>"Hola {nombre}! Recibimos tu pedido."</em>
                </div>
                <table class="table table-sm">
                    <thead><tr><th style="width:120px;">Nombre</th><th>Texto</th><th style="width:60px;">Orden</th><th style="width:50px;">Act.</th><th style="width:90px;"></th></tr></thead>
                    <tbody>
                        @foreach (var r in respuestas.OrderBy(x => x.Orden))
                        {
                            <tr>
                                <td><input class="form-control form-control-sm" @bind="editRespNombre[r.Id]" /></td>
                                <td><textarea class="form-control form-control-sm" rows="2" @bind="editRespTexto[r.Id]"></textarea></td>
                                <td><input type="number" class="form-control form-control-sm" @bind="editRespOrden[r.Id]" /></td>
                                <td style="text-align:center;"><input type="checkbox" @bind="editRespActivo[r.Id]" /></td>
                                <td>
                                    <button class="btn btn-sm btn-success" @onclick="() => GuardarResp(r)" title="Guardar">✓</button>
                                    <button class="btn btn-sm btn-outline-danger" @onclick="() => BorrarResp(r)" title="Borrar">×</button>
                                </td>
                            </tr>
                        }
                        <tr style="background:#f0fdf4;">
                            <td><input class="form-control form-control-sm" placeholder="Nombre" @bind="nuevaRespNombre" /></td>
                            <td><textarea class="form-control form-control-sm" rows="2" placeholder="Texto del mensaje" @bind="nuevaRespTexto"></textarea></td>
                            <td><input type="number" class="form-control form-control-sm" @bind="nuevaRespOrden" /></td>
                            <td></td>
                            <td><button class="btn btn-sm btn-success" @onclick="AgregarResp">+ Agregar</button></td>
                        </tr>
                    </tbody>
                </table>
            }
            else if (configTab == "cbu")
            {
                <p style="color:#6b7280; font-size:0.85rem;">Cargá acá tus cuentas bancarias. Después, con el botón 🏦 del chat, se las pasás al cliente en un toque (CBU completo o solo el alias).</p>
                <div style="background:#eff6ff; border:1px solid #bfdbfe; padding:0.5rem 0.75rem; border-radius:6px; font-size:0.8rem; color:#1e40af; margin-bottom:0.6rem;">
                    💡 El <strong>Nombre</strong> es una etiqueta interna para vos (ej. "Galicia PALANICA"). Los demás datos son los que ve el cliente. Los campos que dejes vacíos no se muestran.
                </div>
                <table class="table table-sm">
                    <thead><tr>
                        <th style="width:130px;">Nombre</th><th>Banco</th><th>Tipo cuenta</th><th>Titular</th>
                        <th>CUIT</th><th>CBU</th><th>Alias</th><th>Mail comprob.</th>
                        <th style="width:50px;">Orden</th><th style="width:40px;">Act.</th><th style="width:80px;"></th>
                    </tr></thead>
                    <tbody>
                        @foreach (var cb in datosBancarios.OrderBy(x => x.Orden))
                        {
                            <tr>
                                <td><input class="form-control form-control-sm" @bind="editCbuNombre[cb.Id]" /></td>
                                <td><input class="form-control form-control-sm" @bind="editCbuBanco[cb.Id]" /></td>
                                <td><input class="form-control form-control-sm" @bind="editCbuTipo[cb.Id]" /></td>
                                <td><input class="form-control form-control-sm" @bind="editCbuTitular[cb.Id]" /></td>
                                <td><input class="form-control form-control-sm" @bind="editCbuCuit[cb.Id]" /></td>
                                <td><input class="form-control form-control-sm" @bind="editCbuCbu[cb.Id]" /></td>
                                <td><input class="form-control form-control-sm" @bind="editCbuAlias[cb.Id]" /></td>
                                <td><input class="form-control form-control-sm" @bind="editCbuMail[cb.Id]" /></td>
                                <td><input type="number" class="form-control form-control-sm" @bind="editCbuOrden[cb.Id]" /></td>
                                <td style="text-align:center;"><input type="checkbox" @bind="editCbuActivo[cb.Id]" /></td>
                                <td>
                                    <button class="btn btn-sm btn-success" @onclick="() => GuardarCbu(cb)" title="Guardar">✓</button>
                                    <button class="btn btn-sm btn-outline-danger" @onclick="() => BorrarCbu(cb)" title="Borrar">×</button>
                                </td>
                            </tr>
                        }
                        <tr style="background:#f0fdf4;">
                            <td><input class="form-control form-control-sm" placeholder="Etiqueta" @bind="nuevoCbuNombre" /></td>
                            <td><input class="form-control form-control-sm" placeholder="Banco Galicia" @bind="nuevoCbuBanco" /></td>
                            <td><input class="form-control form-control-sm" placeholder="cuenta corriente" @bind="nuevoCbuTipo" /></td>
                            <td><input class="form-control form-control-sm" placeholder="Titular" @bind="nuevoCbuTitular" /></td>
                            <td><input class="form-control form-control-sm" placeholder="30-..." @bind="nuevoCbuCuit" /></td>
                            <td><input class="form-control form-control-sm" placeholder="0070..." @bind="nuevoCbuCbu" /></td>
                            <td><input class="form-control form-control-sm" placeholder="alias" @bind="nuevoCbuAlias" /></td>
                            <td><input class="form-control form-control-sm" placeholder="mail" @bind="nuevoCbuMail" /></td>
                            <td><input type="number" class="form-control form-control-sm" @bind="nuevoCbuOrden" /></td>
                            <td></td>
                            <td><button class="btn btn-sm btn-success" @onclick="AgregarCbu">+ Agregar</button></td>
                        </tr>
                    </tbody>
                </table>
                @if (datosBancarios.Any())
                {
                    <div style="background:#f9fafb; border:1px solid #e5e7eb; padding:0.6rem 0.8rem; border-radius:6px; margin-top:0.6rem;">
                        <div style="font-size:0.75rem; color:#6b7280; margin-bottom:0.3rem;">Vista previa de cómo le llega al cliente:</div>
                        <pre style="white-space:pre-wrap; font-family:inherit; font-size:0.85rem; margin:0; color:#111827;">@FormatearCbu(datosBancarios.OrderBy(x => x.Orden).First(), false)</pre>
                    </div>
                }
            }
            else
            {
                <p style="color:#6b7280; font-size:0.85rem;">Asignale un nombre y un rol a los números que te escriben. El nombre que pongas acá prevalece sobre el de WhatsApp.</p>
                @* 2026-07-23: con la importación masiva de clientes son miles — sin buscador era inusable *@
                <input class="form-control" style="margin-bottom:0.6rem; max-width:420px;"
                       placeholder="🔍 Buscar por nombre o número… (mínimo 2 letras)"
                       value="@contactosBusqueda" @oninput="@(e => contactosBusqueda = e.Value?.ToString() ?? "")" />
                @if (ContactosFiltrados().Count > 200)
                {
                    <p style="color:#9ca3af; font-size:0.8rem;">Mostrando los primeros 200 de @ContactosFiltrados().Count — afiná la búsqueda para encontrar el que querés.</p>
                }
                <table class="table table-sm">
                    <thead><tr><th style="width:160px;">Número</th><th>Nombre</th><th style="width:110px;">Rol</th><th style="width:200px;">Cliente vinculado</th><th>Notas</th><th style="width:40px;">Act.</th><th style="width:80px;"></th></tr></thead>
                    <tbody>
                        @foreach (var c in ContactosFiltrados().Take(200))
                        {
                            <tr>
                                <td style="font-family:monospace; font-size:0.78rem;">@c.Numero.Replace("whatsapp:", "")</td>
                                <td><input class="form-control form-control-sm" @bind="editContNombre[c.Id]" /></td>
                                <td>
                                    <select class="form-control form-control-sm" @bind="editContRol[c.Id]">
                                        <option value="hermano">Hermano</option>
                                        <option value="empleado">Empleado</option>
                                        <option value="cliente">Cliente</option>
                                        <option value="proveedor">Proveedor</option>
                                        <option value="otro">Otro</option>
                                    </select>
                                </td>
                                <td>
                                    @if (editContClienteId.GetValueOrDefault(c.Id) is int cliId && cliId > 0)
                                    {
                                        <div style="display:flex; align-items:center; gap:0.3rem;">
                                            <span style="font-size:0.78rem; color:#16a34a;">🛍️ @editContClienteNombre.GetValueOrDefault(c.Id, "Cliente #" + cliId)</span>
                                            <button class="btn btn-sm btn-link" style="padding:0; font-size:0.7rem;" @onclick="() => { editContClienteId[c.Id] = null; editContClienteNombre[c.Id] = null; }">×</button>
                                        </div>
                                    }
                                    else
                                    {
                                        <input class="form-control form-control-sm" placeholder="Buscar cliente..." @bind="editContClienteQuery[c.Id]" @bind:event="oninput"
                                               @onfocus="() => BuscarClientes(c.Id)" />
                                        @if (clienteBusquedaActivaId == c.Id && clienteResultados.Count > 0)
                                        {
                                            <div class="wa-cliente-dropdown">
                                                @foreach (var cli in clienteResultados.Take(8))
                                                {
                                                    <div class="wa-cliente-opt" @onclick="() => SeleccionarCliente(c.Id, cli)">
                                                        <strong>@cli.Nombre</strong>
                                                        @if (!string.IsNullOrEmpty(cli.CodigoInterno)) { <span style="color:#6b7280; font-size:0.7rem;"> · #@cli.CodigoInterno</span> }
                                                    </div>
                                                }
                                            </div>
                                        }
                                    }
                                </td>
                                <td><input class="form-control form-control-sm" @bind="editContNotas[c.Id]" /></td>
                                <td style="text-align:center;"><input type="checkbox" @bind="editContActivo[c.Id]" /></td>
                                <td>
                                    <button class="btn btn-sm btn-success" @onclick="() => GuardarCont(c)">✓</button>
                                    <button class="btn btn-sm btn-outline-danger" @onclick="() => BorrarCont(c)">×</button>
                                </td>
                            </tr>
                        }
                        <tr style="background:#f0fdf4;">
                            <td><input class="form-control form-control-sm" placeholder="+5491111111111" @bind="nuevoContNumero" /></td>
                            <td><input class="form-control form-control-sm" placeholder="Nombre" @bind="nuevoContNombre" /></td>
                            <td>
                                <select class="form-control form-control-sm" @bind="nuevoContRol">
                                    <option value="hermano">Hermano</option>
                                    <option value="empleado">Empleado</option>
                                    <option value="cliente">Cliente</option>
                                    <option value="proveedor">Proveedor</option>
                                    <option value="otro">Otro</option>
                                </select>
                            </td>
                            <td style="font-size:0.75rem; color:#9ca3af;">(asignás después del alta)</td>
                            <td><input class="form-control form-control-sm" placeholder="Notas" @bind="nuevoContNotas" /></td>
                            <td></td>
                            <td><button class="btn btn-sm btn-success" @onclick="AgregarCont">+ Agregar</button></td>
                        </tr>
                    </tbody>
                </table>
                <p style="color:#9ca3af; font-size:0.75rem;">💡 Tip: anteponé "whatsapp:" si querés, sino se agrega solo.</p>
            }
        </div>
    </div>
}

<style>
    /* 2026-07-29: rediseño — más ancho y moderno. Sidebar + thread como dos tarjetas redondeadas
       separadas por un gap, con sombra suave (estilo del resto del sistema). */
    .wa-outer { display: flex; justify-content: center; height: calc(100vh - 104px); background: #eef1f5; padding: 0.7rem 1rem 1rem; }
    .wa-root { display: grid; grid-template-columns: 340px 1fr; width: 100%; max-width: 1500px; background: transparent; box-shadow: none; gap: 0.8rem; overflow: hidden; }
    .wa-sidebar { background: #fff; border: 1px solid #e6eaf0; border-radius: 16px; display: flex; flex-direction: column; overflow: hidden; box-shadow: 0 6px 20px rgba(15,23,42,0.06); }
    .wa-side-header { padding: 1rem 1rem 0.85rem; border-bottom: 1px solid #eef1f5; background: #fbfcfe; }

    /* Barra superior: solapas + cartelito de línea activa */
    .wa-topbar { display: flex; align-items: flex-end; justify-content: space-between; gap: 1rem; padding: 0.6rem 1rem 0; flex-wrap: wrap; }
    .wa-tabs-top { display: flex; gap: 0.4rem; }
    .wa-tab-top { padding: 0.5rem 1.1rem; border-radius: 12px 12px 0 0; background: #f3f4f6; color: #374151; text-decoration: none; font-weight: 600; font-size: 0.92rem; border: 1px solid #e5e7eb; border-bottom: none; transition: background 0.12s; }
    .wa-tab-top:hover { background: #e9edf2; }
    .wa-tab-top.active { background: #25D366; color: #fff; border-color: #25D366; }
    .wa-linea-badge { display: flex; align-items: center; gap: 0.6rem; background: #fff; border: 1px solid #e6eaf0; border-radius: 999px; padding: 0.4rem 0.9rem 0.4rem 0.75rem; box-shadow: 0 4px 14px rgba(15,23,42,0.07); margin-bottom: 0.35rem; }
    .wa-linea-badge.on { border-color: #bbf7d0; background: #f0fdf6; }
    .wa-linea-icon { font-style: normal; font-size: 1.2rem; line-height: 1; }
    .wa-linea-txt { display: flex; flex-direction: column; line-height: 1.15; }
    .wa-linea-label { font-size: 0.62rem; text-transform: uppercase; letter-spacing: 0.04em; color: #94a3b8; font-weight: 700; }
    .wa-linea-num { font-size: 0.92rem; font-weight: 700; color: #0f172a; }
    .wa-linea-dot { width: 9px; height: 9px; border-radius: 50%; background: #cbd5e1; flex-shrink: 0; }
    .wa-linea-dot.on { background: #22c55e; box-shadow: 0 0 0 3px rgba(34,197,94,0.18); }
    /* 2026-07-29 (Paso 2): selector de línea desplegable */
    .wa-linea-wrap { position: relative; }
    .wa-linea-badge { cursor: pointer; font: inherit; text-align: left; }
    .wa-linea-badge:hover { border-color: #cbd5e1; }
    .wa-linea-caret { font-style: normal; font-size: 0.75rem; color: #94a3b8; margin-left: 0.1rem; }
    .wa-linea-backdrop { position: fixed; inset: 0; z-index: 1200; }
    .wa-linea-menu { position: absolute; top: calc(100% + 6px); right: 0; z-index: 1201; background: #fff; border: 1px solid #e6eaf0; border-radius: 14px; box-shadow: 0 12px 32px rgba(15,23,42,0.16); padding: 0.4rem; min-width: 250px; }
    .wa-linea-opt { display: flex; align-items: center; justify-content: space-between; gap: 0.6rem; width: 100%; background: transparent; border: none; border-radius: 10px; padding: 0.55rem 0.7rem; font-size: 0.9rem; font-weight: 600; color: #334155; cursor: pointer; text-align: left; }
    .wa-linea-opt:hover { background: #f1f5f9; }
    .wa-linea-opt.sel { background: #eafcf1; color: #15803d; }
    .wa-linea-check { color: #22c55e; font-weight: 800; }
    .wa-linea-hint { font-size: 0.78rem; color: #64748b; padding: 0.5rem 0.7rem; line-height: 1.4; }
    /* 2026-08-01: nombre + imagen por línea */
    .wa-linea-row { display: flex; align-items: center; gap: 2px; }
    .wa-linea-row .wa-linea-opt { flex: 1; justify-content: flex-start; min-width: 0; }
    .wa-linea-opt > span { overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
    .wa-linea-check { margin-left: auto; }
    .wa-linea-edit { background: none; border: none; cursor: pointer; padding: 4px 6px; font-size: .85rem; border-radius: 8px; opacity: .55; flex: 0 0 auto; }
    .wa-linea-edit:hover { opacity: 1; background: #f1f5f9; }
    .wa-linea-av { width: 20px; height: 20px; border-radius: 50%; object-fit: cover; flex: 0 0 auto; }
    .wa-linea-av-emoji { flex: 0 0 auto; }
    .wa-linea-av-xs { width: 14px; height: 14px; border-radius: 50%; object-fit: cover; vertical-align: middle; margin-right: 3px; }
    .wa-linea-av-big { width: 56px; height: 56px; border-radius: 50%; overflow: hidden; background: #f1f5f9; display: flex; align-items: center; justify-content: center; font-size: 1.6rem; flex: 0 0 auto; }
    .wa-linea-av-big img { width: 100%; height: 100%; object-fit: cover; }
    .wa-cuenta-tag { font-size: 0.6rem; background: #e0e7ff; color: #3730a3; padding: 0.05rem 0.35rem; border-radius: 999px; white-space: nowrap; display: inline-flex; align-items: center; }
    .wa-header-linea { display: inline-flex; align-items: center; gap: 3px; font-size: 0.7rem; font-weight: 600; background: #eef2ff; color: #3730a3; padding: 2px 9px; border-radius: 999px; }
    .wa-header-linea img { width: 16px; height: 16px; }
    .wa-sonido-toggle { display: inline-flex; align-items: center; gap: 5px; background: #fff; border: 1px solid #e6eaf0; border-radius: 999px; padding: 5px 12px; font-size: 0.95rem; font-weight: 600; color: #334155; cursor: pointer; }
    .wa-sonido-toggle:hover { border-color: #25d366; background: #f0fff6; }
    .wa-sonido-txt { font-size: 0.78rem; }
    /* chip "viendo solo esta línea" en la barra lateral */
    .wa-linea-activa-chip { display: flex; align-items: center; gap: 0.4rem; margin: 0.5rem 0.7rem 0; padding: 0.4rem 0.7rem; background: #eafcf1; border: 1px solid #bbf7d0; border-radius: 10px; font-size: 0.8rem; color: #15803d; }
    .wa-linea-activa-x { margin-left: auto; background: none; border: none; font-size: 1.1rem; line-height: 1; color: #15803d; cursor: pointer; }
    /* aviso "le respondés desde X" arriba del composer */
    .wa-composer-linea { margin: 0 1rem; padding: 0.35rem 0.7rem; background: #eafcf1; border: 1px solid #bbf7d0; border-radius: 10px 10px 0 0; font-size: 0.78rem; color: #15803d; }
    .wa-conv-list { flex: 1; overflow-y: auto; }
    .wa-conv-item { display: flex; gap: 0.75rem; padding: 0.7rem 1rem; border-bottom: 1px solid #f3f4f6; cursor: pointer; transition: background 0.1s; border-left: 3px solid transparent; }
    .wa-conv-item:hover { background: #f7faf8; }
    .wa-conv-item.active { background: #eafcf1; border-left-color: #25d366; }
    .wa-avatar { width: 46px; height: 46px; border-radius: 50%; background: #25d366; color: white; display: flex; align-items: center; justify-content: center; font-weight: 700; font-size: 1.05rem; flex-shrink: 0; }
    .wa-conv-body { flex: 1; min-width: 0; }
    .wa-conv-row1 { display: flex; justify-content: space-between; gap: 0.5rem; }
    .wa-conv-name { font-weight: 600; font-size: 0.9rem; color: #111827; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
    /* 2026-07-31: chip "IG" con el degradé de Instagram, para las conversaciones de DM */
    .wa-ig-tag { display: inline-block; font-size: 0.58rem; font-weight: 800; line-height: 1; color: #fff;
        background: linear-gradient(45deg, #f09433, #e6683c, #dc2743, #cc2366, #bc1888);
        padding: 0.15rem 0.3rem; border-radius: 4px; margin-right: 0.3rem; vertical-align: middle; letter-spacing: .02em; }
    .wa-conv-hora { font-size: 0.7rem; color: #9ca3af; flex-shrink: 0; }
    .wa-conv-row2 { display: flex; justify-content: space-between; gap: 0.5rem; margin-top: 0.15rem; }
    .wa-conv-last { font-size: 0.8rem; color: #6b7280; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; flex: 1; }
    .wa-conv-count { background: #25d366; color: white; font-size: 0.68rem; font-weight: 700; padding: 0.1rem 0.45rem; border-radius: 10px; text-align: center; }
    .wa-conv-leido { color: #9ca3af; font-size: 0.66rem; white-space: nowrap; }
    /* Tilditos de estado en los mensajes que mandamos */
    .wa-tilde { color: #8a8a8a; font-size: 0.72rem; margin-left: 3px; letter-spacing: -1px; }
    .wa-tilde-read { color: #34b7f1; }
    .wa-tilde-fail { color: #dc2626; letter-spacing: 0; }
    .wa-thread { display: flex; flex-direction: column; background: #efeae2; border: 1px solid #e6eaf0; border-radius: 16px; overflow: hidden; box-shadow: 0 6px 20px rgba(15,23,42,0.06); }
    /* 2026-07-24: flex-wrap para que en el celular los botones del header (incluido 🗑 Borrar,
       que es el ultimo) bajen a otro renglon en vez de quedar cortados por el overflow:hidden
       del .wa-thread. En pantalla ancha entran todos en una linea = no cambia nada. */
    .wa-thread-header { padding: 0.75rem 1.1rem; background: #fbfcfe; border-bottom: 1px solid #eef1f5; display: flex; align-items: center; gap: 0.6rem; flex-wrap: wrap; }
    /* 2026-07-29: botones del encabezado prolijos y parejos (pastilla redondeada), sin tocar la clase global .btn */
    .wa-thread-header .btn { border-radius: 999px; font-size: 0.8rem; padding: 0.4rem 0.9rem; font-weight: 600; border-width: 1px; transition: transform .12s ease, box-shadow .12s ease, background-color .12s ease; }
    /* 2026-08-01: efecto "teclado" — el botón se levanta con sombra al pasar por encima y se hunde al tocar */
    .wa-thread-header .btn:hover { transform: translateY(-2px); box-shadow: 0 5px 14px rgba(15,23,42,0.16); }
    .wa-thread-header .btn:active { transform: translateY(0); box-shadow: 0 2px 5px rgba(15,23,42,0.14); }
    /* Los botones de solo-ícono (⚙ y 🗑) quedan redondos perfectos */
    .wa-thread-header .btn.wa-icon-round { width: 38px; height: 38px; padding: 0; display: inline-flex; align-items: center; justify-content: center; font-size: 1rem; }
    .wa-messages { flex: 1; overflow-y: auto; padding: 1rem; display: flex; flex-direction: column; gap: 0.5rem; }
    .wa-empty { flex: 1; display: flex; flex-direction: column; align-items: center; justify-content: center; padding: 2rem; text-align: center; }
    .wa-msg-row { display: flex; }
    .wa-msg-row.in { justify-content: flex-start; }
    .wa-msg-row.out { justify-content: flex-end; }
    .wa-bubble { max-width: 75%; padding: 0.45rem 0.65rem; border-radius: 8px; box-shadow: 0 1px 0.5px rgba(0,0,0,0.13); position: relative; }
    /* Cola estilo WhatsApp Web para distinguir mejor entrante/saliente */
    .wa-msg-row.in .wa-bubble::before { content: ''; position: absolute; left: -6px; top: 0; border: 6px solid transparent; border-top-color: white; border-left: 0; }
    .wa-msg-row.out .wa-bubble::before { content: ''; position: absolute; right: -6px; top: 0; border: 6px solid transparent; border-top-color: #d9fdd3; border-right: 0; }
    .wa-msg-row.in .wa-bubble { background: white; }
    .wa-msg-row.out .wa-bubble { background: #d9fdd3; }
    /* 2026-08-02: letra de los chats un poco más grande y en negrita (pedido Osmar) */
    .wa-bubble-body { font-size: 1.02rem; font-weight: 600; color: #111827; word-wrap: break-word; white-space: pre-wrap; }

    /* 2026-08-02: tarjeta de contacto compartido (recibido o enviado) */
    .wa-contacto-card { display: flex; align-items: center; gap: 0.6rem; padding: 0.5rem 0.6rem; background: rgba(0,0,0,0.04); border-radius: 8px; margin-bottom: 0.3rem; min-width: 200px; }
    .wa-contacto-ava { width: 34px; height: 34px; border-radius: 50%; background: #25d366; color: #fff; display: inline-flex; align-items: center; justify-content: center; font-size: 1.1rem; flex-shrink: 0; }
    .wa-contacto-btn { background: #fff; border: 1px solid #cbd5e1; border-radius: 6px; padding: 0.25rem 0.5rem; font-size: 0.75rem; color: #128c7e; cursor: pointer; white-space: nowrap; }
    .wa-contacto-btn:hover { background: #f0fdf4; }
    .wa-bubble-meta { font-size: 0.65rem; color: #6b7280; text-align: right; margin-top: 0.2rem; }
    .wa-composer { padding: 0.7rem 1rem 0.5rem; background: #fbfcfe; display: flex; gap: 0.55rem; align-items: flex-end; }
    /* 2026-07-29: cuadro de escribir MUCHO más alto (5x) para poder mandar textos largos. resize:vertical = lo podés estirar/achicar con la esquina. */
