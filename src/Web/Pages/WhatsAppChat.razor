    // línea y la etiqueta en cada chat. Con una sola línea no se muestra nada (queda invisible).
    string filtroLinea = "";
    List<(string Id, string Numero)> LineasDetectadas() => conversaciones
        .Where(c => !string.IsNullOrEmpty(c.Linea))
        .GroupBy(c => c.Linea!)
        .Select(g => (g.Key, g.First().LineaNumero ?? g.Key))
