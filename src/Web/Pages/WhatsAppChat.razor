    // 2026-08-05: FIRMA de Depósito. Cuando responde un usuario de Depósito, el mensaje sale
    // firmado con quién contesta → "OK (alex)". Lista fija de empleados (pedido del usuario).
    private static readonly string[] FirmantesDeposito = { "alex", "nacho", "benja", "rodri", "gon", "ger" };
    private bool esDeposito;
    private string? firmante;   // empleado elegido (se recuerda en localStorage)

    protected override async Task OnInitializedAsync()
    {
        // ¿El que entró es un usuario SOLO de Depósito? (mismo criterio que el Dashboard)
        var user = await AuthSvc.GetUserAsync();
        var perms = user?.Permissions ?? new();
        miUsuario = user?.Username;   // 2026-08-06: para la presencia (no mostrarme a mí mismo)
        esDeposito = perms.Contains("deposito") && !perms.Contains("cafe") && !perms.Contains("oficina");
        // 2026-08-05: NO recordar el último firmante. Cada vez que se abre la pantalla arranca
        // en blanco y el que responde tiene que pinchar SÍ o SÍ su nombre antes de enviar (así
        // nadie manda firmando con el nombre de otro por error). Limpiamos el valor viejo por si
        // quedó guardado de antes.
        firmante = null;
        if (esDeposito)
        {
            try { await JS.InvokeVoidAsync("localStorage.removeItem", "wa_firmante_deposito"); }
            catch { }
        }

        await LoadConversaciones();
        await LoadLineasConfig();
        AplicarLineaPorDefecto();
        // 2026-08-15: tema (claro/oscuro) de cada línea + letra elegida
        await Apariencia.EnsureLoadedAsync();
        Apariencia.OnChange += AparienciaCambio;
        await CargarSonidoMaster();
        await CargarSonidosSubidos();   // 2026-08-19: para el desplegable de sonido del contacto
        // 2026-08-03: dejar listo el panel de "Nueva conversación" (se muestra cuando no hay chat abierto)
        await EnsureNvCargado();
        nvLineaPhoneId ??= LineaDefaultPhoneId();
        // 2026-08-06: conectar la presencia en vivo ANTES de abrir el chat inicial (así el "join" pega).
        await IniciarPresencia();
        if (!string.IsNullOrWhiteSpace(NumeroInicial))
        {
            // Elegimos el hilo por número + línea. Si esa combinación exacta no está (típico en
            // DESARROLLO), caemos al hilo del mismo número por cualquier línea para no quedar vacíos.
            var conv = conversaciones.FirstOrDefault(c => c.Numero == NumeroInicial
                            && (string.IsNullOrEmpty(LineaInicial) || c.Linea == LineaInicial))
                        ?? conversaciones.FirstOrDefault(c => c.Numero == NumeroInicial);
            await SelectConv(NumeroInicial, conv?.Linea);
        }
        await LoadRespuestas();
        await LoadContactos();
        await LoadDatosBancarios();
        refreshTimer = new System.Threading.Timer(async _ => await OnTick(), null, 10_000, 10_000);
    }

    // 2026-07-29: registrar el pegado de capturas (Ctrl+V / Win+V) una sola vez, al montar la pantalla.
    DotNetObjectReference<WhatsAppChat>? _pasteRef;
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            _pasteRef = DotNetObjectReference.Create(this);
            try { await JS.InvokeVoidAsync("waPaste.register", _pasteRef); }
            catch { /* si el JS no cargó, el clip 📎 sigue funcionando igual */ }
            // 2026-08-03: Enter para enviar como WhatsApp (frena el salto de línea y manda limpio).
            try { await JS.InvokeVoidAsync("waComposer.register", _pasteRef); }
            catch { /* si el JS no cargó, igual podés enviar con el botón verde */ }
            // 2026-08-17: ¿el panel derecho arranca abierto o cerrado? (lo que eligió la última vez)
            await CargarPrefPanelAsync();
        }
        // 2026-08-03: cuando abrimos la ventana flotante del pedido, la hacemos arrastrable
        if (_pedidoFloatAttachPending && showPedidoFloat)
        {
            _pedidoFloatAttachPending = false;
            try { await JS.InvokeVoidAsync("waDraggable.attach", "wa-pedido-float-head", "wa-pedido-float"); }
            catch { /* si el JS no cargó, la ventana igual funciona, solo que no se mueve */ }
        }
        // 2026-08-05: la ventana flotante de la ficha del cliente también arrastrable (una vez que terminó de cargar).
        if (_fichaAttachPending && mostrarFichaCliente && !cargandoFicha)
        {
            _fichaAttachPending = false;
            try { await JS.InvokeVoidAsync("waDraggable.attach", "wa-ficha-float-head", "wa-ficha-float"); }
            catch { /* si el JS no cargó, la ventana igual se ve, solo que no se mueve */ }
        }
    }

