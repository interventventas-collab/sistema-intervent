    // 2026-07-23: para saber si entraron mensajes nuevos y bajar el scroll solo en ese caso
    // (si no, al refrescar solo te sacaria de donde estas leyendo).
    int ultimaCantidadMensajes = -1;

    async Task LoadMensajes(bool silent = false)
    {
        if (selectedNumero == null) return;
        if (!silent) loadingMsg = true;
        try { mensajes = await Api.GetTwMensajesAsync(selectedNumero, selectedLinea ?? "null"); }
        catch { }
        loadingMsg = false;

        // Bajar al ultimo mensaje: siempre al abrir/cambiar de chat, y en los refrescos
        // automaticos solo si llego algo nuevo.
        DetectarCodigosMeli();   // 2026-08-21: códigos de MercadoLibre pegados en la charla

        // 2026-08-26: de paso refrescamos lo agendado: si el robot ya lo mandó, el cartelito se va solo.
        _ = CargarProgramados();

        var hayNuevos = mensajes.Count != ultimaCantidadMensajes;
        ultimaCantidadMensajes = mensajes.Count;
        if (!silent || hayNuevos) await ScrollAlUltimoMensaje();
    }

    /// <summary>Baja el panel de mensajes hasta el final (reusa el helper JS del chat interno).</summary>
    async Task ScrollAlUltimoMensaje()
    {
        try
        {
            // Un respiro para que Blazor termine de pintar los mensajes antes de scrollear.
            await Task.Yield();
            StateHasChanged();
            await Task.Delay(60);
            // "Hard": reintenta mientras cargan imágenes/audios, así al abrir un chat
            // siempre quedás en el último mensaje (no a la mitad).
            await JS.InvokeVoidAsync("chatScrollToBottomHard", "wa-messages-scroll");
        }
        catch { /* si falla el scroll no rompemos el chat */ }
    }

    // 2026-08-03: id temporal (negativo) para los mensajes "optimistas" que muestro
    // al toque mientras viajan al servidor. Negativo para no chocar con ids reales.
    int _tempMsgId = -1;

    // 2026-08-05: elegir quién de Depósito responde (se recuerda para la próxima).
    async Task ElegirFirmante(string f)
    {
        // 2026-08-05: se elige solo para esta sesión abierta; NO se guarda para la próxima vez.
        // Al recargar/reabrir la pantalla vuelve a arrancar en blanco (obliga a re-elegir).
        firmante = f;
        await Task.CompletedTask;
    }

    // El botón verde "Enviar" usa esta vía.
    async Task EnviarMensaje()
    {
        if (selectedNumero == null || sending) return;
        // 2026-08-06: cierre de carrera — si otro agente respondió recién, pedir confirmación (no bloquea).
        if (!await ChequearCarreraAsync()) return;
        // 2026-08-05: si hay adjuntos en la bandeja, sale TODO junto (el texto va de pie del primero).
        if (pendientes.Count > 0) { await EnviarPendientes(composerText); return; }
        if (string.IsNullOrWhiteSpace(composerText)) return;
        var texto = composerText;
        composerText = "";
        // 2026-08-17: el cuadro crece solo al escribir; al enviar hay que devolverlo a un renglón
        // (el navegador no avisa que se vació desde .NET, así que quedaría grande y vacío).
        try { await JS.InvokeVoidAsync("waComposer.resetSize"); } catch { }
        await EnviarTexto(texto);
    }

    // 2026-08-03: el JS (wa-composer.js) llama acá cuando apretás Enter. Ya vació el
    // cuadro en pantalla; nosotros mandamos el texto que nos pasó.
    [JSInvokable]
    public async Task EnviarDesdeComposer(string texto)
    {
        if (string.IsNullOrWhiteSpace(texto)) { composerText = ""; StateHasChanged(); return; }
        // Si estamos en medio de otro envío o no hay chat, devolvemos el texto al cuadro
        // (el JS ya lo había vaciado) para no perderlo.
        if (sending || selectedNumero == null)
        {
            composerText = texto;
            StateHasChanged();
            return;
        }
        // 2026-08-26: si el panel del reloj está abierto, Enter DEJA PROGRAMADO en vez de mandar.
        // El botón de al lado hace lo mismo: mientras programás, nada sale en el momento.
        if (ProgramandoDesdeComposer())
        {
            composerText = texto;   // el JS ya vació el cuadro y ProgramarAhora lee de acá
            StateHasChanged();
            await ProgramarAhora();
            return;
        }
        // 2026-08-06: cierre de carrera. Si el usuario cancela, le devolvemos el texto al cuadro (el JS ya lo vació).
        if (!await ChequearCarreraAsync()) { composerText = texto; StateHasChanged(); return; }
        // 2026-08-05: si hay adjuntos en la bandeja, Enter manda TODO junto (texto = pie del primero).
        if (pendientes.Count > 0) { composerText = ""; await EnviarPendientes(texto); return; }
        composerText = "";
        await EnviarTexto(texto);
    }

    // Envío real + aparición instantánea (como WhatsApp): agrego el mensaje a la lista
    // al toque, y cuando el servidor confirma recargo para traer el mensaje real (con
    // sus tilditos de estado). Si falla, lo saco y devuelvo el texto al cuadro.
    /// <summary>Devuelve true si el mensaje salió. 2026-08-22: lo necesita "Solo alias", que manda
    /// dos mensajes seguidos y NO tiene que mandar el segundo si el primero no salió.</summary>
    async Task<bool> EnviarTexto(string texto)
    {
        if (selectedNumero == null || sending) return false;
        texto = texto?.Trim() ?? "";
        if (string.IsNullOrWhiteSpace(texto)) return false;

        // 2026-08-12: en los chats que ve Depósito (ver DepositoChats), el mensaje sale firmado
        // AUTOMÁTICAMENTE con la abreviatura del operador del PIN activo (os/ger/ga). Si no hay
        // operador con abreviatura, sale sin firma (opción b). Esto tiene prioridad sobre la firma
        // manual del usuario Depósito.
        var firmaAuto = EsChatVisibleDeposito ? Web.Services.OperatorService.FirmaCorta(Op.Current) : "";
        if (!string.IsNullOrEmpty(firmaAuto))
        {
            texto = $"{texto} ({firmaAuto})";
        }
        // 2026-08-05: Depósito SIEMPRE firma quién responde → "OK (alex)". Si no eligieron
        // el empleado, no se envía y se avisa (devolvemos el texto al cuadro para no perderlo).
        else if (esDeposito)
        {
            if (string.IsNullOrWhiteSpace(firmante))
            {
                Toast.Warning("Elegí quién responde (arriba del cuadro de escribir).");
                composerText = texto;
                StateHasChanged();
                return false;
            }
            texto = $"{texto} ({firmante})";
        }

        var numero = selectedNumero;
        var linea = selectedLinea;

        // 2026-08-05: si estamos respondiendo citando, agarramos el mensaje citado y limpiamos la barra.
        var replyTarget = replyingTo;
        replyingTo = null;
        // 2026-08-19: si esto es una corrección, nos guardamos a cuál mensaje corrige. Se marca como
        // anulado SOLO si la corrección sale de verdad (si falla, no queda tachado al pedo).
        var corrigeA = corrigiendoMsgId;
        corrigiendoMsgId = null;

        var tempId = _tempMsgId--;
        var temp = new ApiClient.TwMsgDto(
            tempId, "OUTGOING", numero, null, texto, null, null, null,
            false, null, DateTime.UtcNow, "SENDING", null,
            null, replyTarget != null ? PreviewMensajeParaResponder(replyTarget) : null, replyTarget?.Direccion == "OUTGOING");
        mensajes.Add(temp);
        sending = true;
        StateHasChanged();
        await ScrollAlUltimoMensaje();

        var (ok, err) = await Api.SendTwMensajeAsync(numero, texto, linea, replyTarget?.Id);
        sending = false;

        if (ok)
        {
            // 2026-08-19: la corrección salió → el mensaje equivocado queda tachado para el equipo.
            if (corrigeA is int _anu) await Api.AnularMensajeAsync(_anu, true);
            // 2026-08-06: avisar a los demás agentes que respondí (para su cierre de carrera).
            await AvisarEnvie(ConvIdDe(numero, linea));
            // Solo recargo si seguís en el mismo chat (por si cambiaste mientras mandaba).
            if (selectedNumero == numero && selectedLinea == linea) await LoadMensajes();
            await LoadConversaciones(silent: true);
        }
        else
        {
            mensajes.RemoveAll(m => m.Id == tempId);
            if (selectedNumero == numero) { composerText = texto; replyingTo = replyTarget; corrigiendoMsgId = corrigeA; } // no se pierde lo que escribiste, ni la cita, ni la corrección
            StateHasChanged();
            Toast.Error($"Error al enviar: {err}");
        }
        return ok;
    }

    /// <summary>2026-08-18: salta al mensaje citado y lo resalta. Si no está entre los cargados, avisa.</summary>
    async Task IrAlCitado(ApiClient.TwMsgDto m)
    {
        if (string.IsNullOrWhiteSpace(m.ReplyToSid) || mensajes is null) return;
        var orig = mensajes.FirstOrDefault(x => x.Sid == m.ReplyToSid);
        if (orig is null)
        {
            Toast.Info("Ese mensaje es más viejo que los que están cargados en pantalla.");
            return;
        }
        try { await JS.InvokeVoidAsync("waIrAlMensaje", $"wamsg-{orig.Id}"); } catch { }
    }

