    // ===== Reenviar mensajes a uno o varios contactos (2026-08-04) =====
    bool showReenviar = false, reenviarBuscando = false, reenviando = false;
    string reenviarQuery = "";
    List<ApiClient.TwDestinatarioDto> reenviarResultados = new();
    List<ReenvioWa.Destino> reenviarDestinos = new();

    /// <summary>
    /// 2026-08-20: las charlas que se ofrecen de una en el cuadro de reenviar. Van TODAS las líneas
    /// a propósito (no el filtro de la pantalla): si estás mirando solo FRIKAF y le querés reenviar
    /// algo a alguien de FIJO TRANSRADIO, tiene que aparecer igual. Se saca la charla en la que
    /// estás parado, que reenviarse a uno mismo no tiene sentido. Vienen ya ordenadas por el
    /// servidor (fijadas primero y después por hora), así que se respeta ese orden.
    /// </summary>
    List<ReenvioWa.Destino> ReenviarRecientes()
        => conversaciones
            .Where(c => !c.Archivado && !(c.Numero == selectedNumero && c.Linea == selectedLinea))
            // primero las de la MISMA empresa en la que estás trabajando: es lo que casi siempre querés
            .OrderByDescending(c => c.Linea == selectedLinea)
            .Take(30)
            .Select(c => DestinoDeConv(c))
            .ToList();

    /// <summary>
    /// 2026-08-20: una conversación convertida en destino de reenvío. La LÍNEA sale de la propia
    /// conversación (acá una conversación es número + línea), así que el mensaje va a salir por el
    /// mismo número por el que ese cliente ya viene hablando — nunca más por el que decida el
    /// servidor. Si esa línea no es la que estás usando, se marca para que lo veas ANTES de mandar.
    /// </summary>
    ReenvioWa.Destino DestinoDeConv(ApiClient.TwConvDto c)
        => new(MostrarNombre(c), c.Numero, c.Linea,
               NombreDeLinea(c.Linea),
               c.UltimoEntranteAt is DateTime u && u.AddHours(24) > DateTime.UtcNow,
               c.Linea != selectedLinea);

    /// <summary>Nombre lindo de una línea nuestra ("FRIKAF by INTERVENT"), reusando el de siempre.</summary>
    string NombreDeLinea(string? linea)
        => string.IsNullOrEmpty(linea)
            ? "sin línea"
            : LineaNombre(linea, conversaciones.FirstOrDefault(c => c.Linea == linea)?.LineaNumero);


    void AbrirReenviar()
    {
        if (mensajesSeleccionadosIds.Count == 0) { Toast.Warning("Tocá primero el mensaje, la foto o el archivo que querés reenviar"); return; }
        reenviarQuery = ""; reenviarResultados = new(); reenviarDestinos = new();
        showReenviar = true;
    }

    void CerrarReenviar()
    {
        showReenviar = false;
        reenviarQuery = ""; reenviarResultados = new(); reenviarDestinos = new();
    }

    async Task BuscarReenviarDestinos()
    {
        var q = (reenviarQuery ?? "").Trim();
        if (q.Length < 2) { reenviarResultados = new(); return; }
        reenviarBuscando = true; StateHasChanged();
        // la línea va para que el "🟢 le podés escribir" mire la ventana de ESTA empresa
        try { reenviarResultados = await Api.BuscarTwDestinatariosAsync(q, selectedLinea); }
        catch { reenviarResultados = new(); }
        reenviarBuscando = false; StateHasChanged();
    }

    // Si lo escrito parece un número (sin letras, 8+ dígitos), ofrecer mandarle directo
    string? ReenviarNumeroDirecto()
    {
        var q = reenviarQuery ?? "";
        if (q.Any(char.IsLetter)) return null;
        var digs = new string(q.Where(char.IsDigit).ToArray());
        return digs.Length >= 8 ? digs : null;
    }

    // 2026-08-20: se compara por número Y LÍNEA. El mismo cliente por FRIKAF y por TRANSRADIO son
    // dos destinos distintos, porque el mensaje le llega de un remitente diferente en cada caso.
    void ToggleDestino(ReenvioWa.Destino d)
    {
        var ya = reenviarDestinos.FirstOrDefault(x => x.Numero == d.Numero && x.Linea == d.Linea);
        if (ya != null) reenviarDestinos.Remove(ya);
        else reenviarDestinos.Add(d);
    }

    void QuitarDestino(ReenvioWa.Destino d)
        => reenviarDestinos.RemoveAll(x => x.Numero == d.Numero && x.Linea == d.Linea);

    void AgregarDestinoDirecto(string digitos)
    {
        // Un número escrito a mano tampoco tiene charla: sale por la línea en la que estás.
        if (!reenviarDestinos.Any(x => x.Numero == digitos && x.Linea == selectedLinea))
            reenviarDestinos.Add(new ReenvioWa.Destino("Número nuevo", digitos, selectedLinea,
                                                       NombreDeLinea(selectedLinea), false, false));
        reenviarQuery = ""; reenviarResultados = new();
    }

    async Task ConfirmarReenviar()
    {
        if (reenviarDestinos.Count == 0 || reenviando) return;
        var msgs = mensajes.Where(m => mensajesSeleccionadosIds.Contains(m.Id))
                           .OrderBy(m => m.CreatedAt).ToList();
        if (msgs.Count == 0) { Toast.Warning("No hay mensajes seleccionados"); return; }

        reenviando = true; StateHasChanged();
        int ok = 0, fail = 0;
        // 2026-08-20: el envío en sí vive en Services/ReenvioWa.cs, compartido con la pantalla del
        // celular, para que las dos manden exactamente igual y no se despeguen con el tiempo.
        foreach (var d in reenviarDestinos)
        {
            foreach (var m in msgs)
            {
                var r = await ReenvioWa.ReenviarUnoAsync(Api, m, d.Numero, d.Linea);
                if (r == ReenvioWa.Resultado.Enviado) ok++;
                else if (r == ReenvioWa.Resultado.Fallo) fail++;
                // NadaQueMandar: no cuenta ni como éxito ni como error (ej. solo una reacción)
            }
        }
        reenviando = false;

        // Por si le reenviaste al chat que está abierto, refrescamos para verlo.
        await LoadMensajes(silent: true);

        var (txt, esError, esAdv) = ReenvioWa.Resumen(ok, fail);
        if (esError) Toast.Error(txt); else if (esAdv) Toast.Warning(txt); else Toast.Success(txt);

        CerrarReenviar();
        mensajesSeleccionadosIds.Clear();
        modoSeleccion = false;
    }

    // ¿El cuerpo es una tarjeta de contacto? (marcador puesto por el webhook / el envío)
    // 2026-08-20: la definición de verdad vive en Services/ReenvioWa.cs (la comparten las dos
    // pantallas). Acá quedan como atajo para el markup, que las usa para dibujar la tarjetita.
    static bool EsMensajeContacto(string? cuerpo) => ReenvioWa.EsMensajeContacto(cuerpo);

