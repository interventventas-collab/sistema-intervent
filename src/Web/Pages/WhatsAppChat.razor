    .wa-chip { background: #eaf1fb; border: 1px solid #d5e3f7; color: #1d4ed8; padding: 0.42rem 0.95rem; border-radius: 999px; font-size: 0.82rem; font-weight: 600; cursor: pointer; transition: all 0.12s; white-space: nowrap; }
