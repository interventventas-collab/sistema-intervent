@page "/alquileres/cobranzas-pendientes"
@attribute [Authorize]
@inject NavigationManager Navigation

@* 2026-09-14: los cobros de alquiler del repartidor se juntaron con los de ventas en
   /cafe/cobranzas-pendientes ("Cobranzas a aprobar"), y se procesan igual: con recibo y caja.
   Esta dirección queda solo para que los enlaces viejos no den página en blanco. *@

@code {
    protected override void OnInitialized()
        => Navigation.NavigateTo("/cafe/cobranzas-pendientes", replace: true);
}
