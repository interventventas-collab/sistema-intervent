@page "/mercadopago/cobranzas"
@attribute [Authorize]
@inject ApiClient Api
@inject ToastService ToastService
@inject IJSRuntime JS

@* 2026-10-13: todo lo que entró a la cuenta de Mercado Pago, separado por origen (links del sistema,
   ventas de MercadoLibre, transferencias / QR / otros), con comisión, neto y liberación. Los cobros
   los trae el servidor solo cada 30 min (MpCobrosAutoService); "actualizar ahora" trae 7 días. *@

<div class="view-header" style="display:flex; align-items:center; justify-content:flex-start; gap:.6rem;">
    <span style="width:44px; height:30px; display:inline-block;">@SvgIcons.MercadoPago</span>
    <h2 style="margin:0;">Cobranzas Mercado Pago</h2>
</div>

<div class="mpb">
    <div class="mpb-filtros">
        <label>Desde <input type="date" class="mpb-in" @bind="desde" @bind:after="Cargar" /></label>
        <label>hasta <input type="date" class="mpb-in" @bind="hasta" @bind:after="Cargar" /></label>
        <input class="mpb-in mpb-buscar" placeholder="Buscar nombre, mail o monto" @bind="buscar" @bind:event="oninput"
               @onkeydown="@(async e => { if (e.Key == "Enter") await Cargar(); })" />
        <button class="btn btn-sm btn-secondary" @onclick="Cargar">Buscar</button>
        <button class="btn btn-sm btn-secondary" disabled="@bajando" @onclick="BajarExcel">@(bajando ? "Armando…" : "Descargar Excel")</button>
    </div>

    <div class="mpb-origenes">
        @foreach (var (k, t) in Origenes)
        {
            var n = k == "todo" ? data?.PorOrigen.Sum(o => o.Cantidad) : data?.PorOrigen.FirstOrDefault(o => o.Origen == k)?.Cantidad;
            <button class="mpb-chip @(origen == k ? "on" : "")" @onclick="@(() => CambiarOrigen(k))">@t @(n is int c ? $"· {c}" : "")</button>
        }
    </div>

    @if (cargando && data is null)
    {
        <p>Cargando…</p>
    }
    else if (data is not null)
    {
        @if (!data.HayCuenta)
        {
            <p class="mpb-gris">No hay una cuenta de Mercado Pago conectada. Conectala en
                <a href="/integraciones/mercadopago">Integraciones → Mercado Pago</a>.</p>
        }

        <div class="mpb-totales">
            Entró <b>$@Fmt(data.Bruto)</b> · comisión MP $@Fmt(data.Bruto - data.Neto) · te quedó <b>$@Fmt(data.Neto)</b>
            · falta liberar $@Fmt(data.PorLiberar) <span class="mpb-gris">(@data.Cantidad cobro@(data.Cantidad == 1 ? "" : "s"))</span>
        </div>
        <div class="mpb-gris mpb-sincro">
            Se actualiza solo cada 30 min@(data.UltimaSincroAt is DateTime u ? $" · última vez {u.ToArTime():dd/MM HH:mm}" : "")
            · <button class="mpb-link" disabled="@actualizando" @onclick="ActualizarAhora">@(actualizando ? "trayendo de Mercado Pago…" : "actualizar ahora")</button>
        </div>

        @if (data.Cobros.Count == 0)
        {
            <p class="mpb-gris">No hay cobros en estas fechas@(string.IsNullOrWhiteSpace(buscar) ? "" : " con esa búsqueda").</p>
        }
        else
        {
            <table class="table mpb-tabla">
                <tbody>
                @foreach (var c in data.Cobros)
                {
                    var neto = c.MontoNeto ?? c.Monto;
                    <tr class="@(c.Estado != "approved" ? "mpb-anulado" : "")">
                        <td class="mpb-gris mpb-nowrap">@c.Fecha.ToArTime().ToString("dd/MM HH:mm")</td>
                        <td>
                            <div>@(string.IsNullOrWhiteSpace(c.Quien) ? "—" : c.Quien)</div>
                            <div class="mpb-gris">@(c.Detalle ?? OrigenTexto(c.Origen))@(Medio(c) is { Length: > 0 } m ? " · " + m : "")</div>
                            @if (c.CobranzaId.HasValue)
                            {
                                <div class="mpb-asoc">✓ Cobranza @c.CobranzaNumero@(string.IsNullOrEmpty(c.CobranzaCliente) ? "" : " · " + c.CobranzaCliente)@(string.IsNullOrEmpty(c.CobranzaComprobantes) ? "" : " · " + c.CobranzaComprobantes)</div>
                            }
                        </td>
                        <td class="mpb-num">$@Fmt(c.Monto)</td>
                        <td class="mpb-num">
                            <div>$@Fmt(neto)</div>
                            @if (c.MontoNeto is decimal n && c.Monto - n != 0)
                            {
                                <div class="mpb-gris">comisión $@Fmt(c.Monto - n)</div>
                            }
                        </td>
                        <td class="mpb-num mpb-gris">
                            @if (c.Estado == "refunded") { <span class="mpb-alarma">devuelto</span> }
                            else if (c.Estado == "charged_back") { <span class="mpb-alarma">contracargo</span> }
                            else if (c.EstadoLiberacion == "released" || (c.FechaLiberacion is DateTime fl && fl <= DateTime.UtcNow)) { <span>liberado</span> }
                            else if (c.FechaLiberacion is DateTime fl2) { <span>se libera @fl2.ToArTime().ToString("dd/MM")</span> }
                            else { <span>pendiente</span> }
                            @if (c.Estado == "approved" && !c.CobranzaId.HasValue && c.Origen != "meli")
                            {
                                <div><button class="mpb-btn-asoc" @onclick="@(() => AbrirAsociar(c))">Asociar a venta</button></div>
                            }
                        </td>
                    </tr>
                }
                </tbody>
            </table>
            @if (data.Truncado)
            {
                <p class="mpb-gris">Se muestran los primeros 1.000. Los totales de arriba son de todos; el Excel también los trae todos.</p>
            }
        }
    }
</div>

@if (asoc is not null)
{
    <div class="modal-overlay" @onclick="CerrarAsociar">
        <div class="modal-card" @onclick:stopPropagation="true" style="max-width:560px; width:92vw; max-height:90vh; overflow-y:auto;">
            <div class="modal-header">
                <h4 style="margin:0;">Asociar cobro de Mercado Pago</h4>
                <button class="btn-close" @onclick="CerrarAsociar">&times;</button>
            </div>
            <div class="modal-body">
                <div class="mpb-gris" style="margin-bottom:.8rem;">$@Fmt(asoc.Monto) · @asoc.Fecha.ToArTime().ToString("dd/MM HH:mm") · @(asoc.Quien ?? "")</div>

                <label class="mpb-lbl">Cliente</label>
                @if (asocCliente is null)
                {
                    <input class="mpb-in" style="width:100%; box-sizing:border-box;" placeholder="Buscar cliente (nombre, razón social, CUIT)"
                           @bind="asocBuscar" @bind:event="oninput" />
                    @if (!string.IsNullOrWhiteSpace(asocBuscar))
                    {
                        <div class="mpb-cli-lista">
                            @foreach (var cl in ClienteSearch.Buscar(clientes, asocBuscar).Take(8))
                            {
                                <button class="mpb-cli" @onclick="@(() => ElegirCliente(cl))">@cl.Nombre@(string.IsNullOrWhiteSpace(cl.RazonSocial) || cl.RazonSocial == cl.Nombre ? "" : " · " + cl.RazonSocial)</button>
                            }
                        </div>
                    }
                }
                else
                {
                    <div style="display:flex; justify-content:space-between; align-items:center;">
                        <b>@asocCliente.Nombre</b>
                        <button class="mpb-link" @onclick="() => { asocCliente = null; asocPend = null; }">cambiar</button>
                    </div>

                    <div class="mpb-lbl" style="margin-top:.8rem;">¿Qué paga?</div>
                    @if (asocPend is null)
                    {
                        <p class="mpb-gris">Cargando comprobantes…</p>
                    }
                    else if (asocPend.Count == 0)
                    {
                        <p class="mpb-gris">No tiene comprobantes pendientes: queda todo a cuenta.</p>
                    }
                    else
                    {
                        @foreach (var pc in asocPend)
                        {
                            var key = Clave(pc);
                            <label class="mpb-op">
                                <input type="checkbox" checked="@asocTildes.Contains(key)" @onchange="@(e => Tildar(key, (bool)(e.Value ?? false)))" />
                                @pc.Numero · @pc.Fecha.ToString("dd/MM") · debe $@Fmt(pc.Saldo)
                                @if (!string.IsNullOrEmpty(pc.ClienteNombre) && pc.ClienteNombre != asocCliente.Nombre) { <span class="mpb-gris"> (@pc.ClienteNombre)</span> }
                            </label>
                        }
                    }

                    <div class="mpb-resumen">
                        @{ var (imps, aCuenta) = Imputar(); }
                        Se carga una cobranza de <b>$@Fmt(asoc.Monto)</b> en la caja <b>@(cajaMp?.Nombre ?? "Mercado Pago")</b>, fecha @FechaCobranzaTexto().
                        @if (imps.Count > 0) { <br /><span>Paga: @string.Join(", ", imps.Select(i => $"{i.numero} ${Fmt(i.importe)}"))</span> }
                        @if (aCuenta > 0.009m) { <br /><span>Quedan $@Fmt(aCuenta) a cuenta.</span> }
                        @if (asoc.MontoNeto is decimal n && asoc.Monto - n > 0)
                        {
                            <br /><span class="mpb-gris">La comisión de MP ($@Fmt(asoc.Monto - n)) no le baja la deuda al cliente: él pagó los $@Fmt(asoc.Monto) completos.</span>
                        }
                    </div>
                }
                @if (!string.IsNullOrEmpty(asocError))
                {
                    <div class="mpb-alarma" style="margin-top:.6rem;">@asocError</div>
                }
            </div>
            <div class="modal-footer" style="display:flex; justify-content:flex-end; gap:.5rem;">
                <button class="btn btn-secondary" @onclick="CerrarAsociar">Cancelar</button>
                <button class="btn btn-primary" disabled="@(asocCliente is null || asocPend is null || guardandoAsoc)" @onclick="GuardarAsociar">@(guardandoAsoc ? "Guardando…" : "Guardar cobranza")</button>
            </div>
        </div>
    </div>
}

<style>
    .mpb { max-width: 980px; }
    .mpb-asoc { font-size:.8rem; color:#065f46; margin-top:.15rem; }
    .mpb-btn-asoc { margin-top:.3rem; background:#fff; border:1px solid #d1d5db; border-radius:6px; padding:.15rem .5rem; font-size:.78rem; cursor:pointer; color:#374151; }
    .mpb-lbl { display:block; font-size:.85rem; margin-bottom:.25rem; }
    .mpb-cli-lista { border:1px solid #e5e7eb; border-radius:6px; margin-top:.25rem; max-height:240px; overflow-y:auto; }
    .mpb-cli { display:block; width:100%; text-align:left; background:#fff; border:none; border-bottom:1px solid #f3f4f6; padding:.4rem .6rem; cursor:pointer; font-size:.88rem; }
    .mpb-cli:hover { background:#f3f4f6; }
    .mpb-op { display:block; margin-bottom:.3rem; cursor:pointer; font-size:.9rem; }
    .mpb-resumen { border-top:1px solid #e5e7eb; margin-top:.8rem; padding-top:.6rem; font-size:.88rem; line-height:1.6; }
    .mpb-filtros { display:flex; flex-wrap:wrap; gap:.5rem; align-items:center; margin-bottom:.6rem; font-size:.9rem; }
    .mpb-filtros label { display:flex; align-items:center; gap:.3rem; }
    .mpb-in { border:1px solid #d1d5db; border-radius:6px; padding:.3rem .5rem; font-size:.9rem; }
    .mpb-buscar { flex:1; min-width:180px; }
    .mpb-origenes { display:flex; flex-wrap:wrap; gap:.4rem; margin-bottom:.9rem; }
    .mpb-chip { background:#fff; border:1px solid #d1d5db; border-radius:6px; padding:.25rem .7rem; font-size:.85rem; cursor:pointer; }
    .mpb-chip.on { border-color:#374151; font-weight:600; }
    .mpb-totales { font-size:1rem; margin-bottom:.2rem; }
    .mpb-sincro { margin-bottom:.8rem; }
    .mpb-gris { color:#6b7280; font-size:.82rem; }
    .mpb-link { background:none; border:none; padding:0; color:#2563eb; cursor:pointer; font-size:.82rem; text-decoration:underline; }
    .mpb-tabla td { vertical-align:top; padding:.45rem .5rem; }
    .mpb-num { text-align:right; white-space:nowrap; }
    .mpb-nowrap { white-space:nowrap; }
    .mpb-alarma { color:#b91c1c; }
    .mpb-anulado td:not(:last-child) { text-decoration: line-through; color:#9ca3af; }
</style>

@code {
    private static readonly (string, string)[] Origenes =
    {
        ("todo", "Todos"), ("link", "Links de pago"), ("meli", "Ventas MercadoLibre"), ("otro", "Transferencias, QR y otros")
    };

    private DateTime desde = DateTimeExt.AhoraAr().Date.AddDays(-(DateTimeExt.AhoraAr().Day - 1));
    private DateTime hasta = DateTimeExt.AhoraAr().Date;
    private string origen = "todo";
    private string buscar = "";
    private MpCobrosDto? data;
    private bool cargando;
    private bool actualizando;
    private bool bajando;

    private static readonly CultureInfo Ar = new("es-AR");

    protected override async Task OnInitializedAsync() => await Cargar();

    private async Task Cargar()
    {
        if (hasta < desde) hasta = desde;
        cargando = true;
        try { data = await Api.GetMpCobrosAsync(desde, hasta, origen, buscar); }
        catch (Exception ex) { ToastService.Show(ex.Message, ToastType.Error); }
        finally { cargando = false; }
    }

    private async Task CambiarOrigen(string k)
    {
        origen = k;
        await Cargar();
    }

    private async Task ActualizarAhora()
    {
        actualizando = true;
        try
        {
            var r = await Api.SincronizarMpPagosAsync(7);
            if (r is not null && !r.Ok) ToastService.Show(r.Error ?? "Mercado Pago no respondió.", ToastType.Error);
            await Cargar();
        }
        catch (Exception ex) { ToastService.Show(ex.Message, ToastType.Error); }
        finally { actualizando = false; }
    }

    private async Task BajarExcel()
    {
        bajando = true;
        try
        {
            var bytes = await Api.GetMpCobrosExcelAsync(desde, hasta, origen, buscar);
            if (bytes is null) { ToastService.Show("No se pudo armar el Excel.", ToastType.Error); return; }
            await JS.InvokeVoidAsync("downloadFile", $"Cobranzas_MercadoPago_{desde:dd-MM}_al_{hasta:dd-MM-yyyy}.xlsx",
                "application/vnd.openxmlformats-officedocument.spreadsheetml.sheet", Convert.ToBase64String(bytes));
        }
        catch (Exception ex) { ToastService.Show(ex.Message, ToastType.Error); }
        finally { bajando = false; }
    }

    // ─── Asociar un cobro a una venta (crea una cobranza común en la caja Mercado Pago) ───
    private MpCobroDto? asoc;
    private List<CafeClienteDto>? clientes;
    private List<CafeCajaDto>? cajas;
    private CafeCajaDto? cajaMp;
    private string asocBuscar = "";
    private CafeClienteDto? asocCliente;
    private List<ComprobantePendienteDto>? asocPend;
    private HashSet<string> asocTildes = new();
    private string? asocError;
    private bool guardandoAsoc;

    private static string Clave(ComprobantePendienteDto p) => p.ReservaId is > 0 ? $"R{p.ReservaId}" : $"V{p.VentaId}";

    private async Task AbrirAsociar(MpCobroDto c)
    {
        asoc = c; asocCliente = null; asocPend = null; asocTildes = new(); asocError = null;
        asocBuscar = c.ClienteSugerido ?? "";
        try
        {
            clientes ??= await Api.GetCafeClientesAsync() ?? new();
            cajas ??= await Api.GetCafeCajasAsync() ?? new();
            // La caja de MP es de tipo BILLETERA_VIRTUAL y se llama "Mercado Pago" (la "V (Billetera
            // Virtual)" es otra cosa: V_PRIVADO). Primero por nombre, después por tipo.
            cajaMp = cajas.FirstOrDefault(k => k.IsActive && k.Tipo != "V_PRIVADO"
                        && k.Nombre.Replace(" ", "").Contains("mercadopago", StringComparison.OrdinalIgnoreCase))
                     ?? cajas.FirstOrDefault(k => k.IsActive && k.Tipo.ToUpperInvariant() is "MERCADO_PAGO" or "MERCADOPAGO" or "MP");
            if (cajaMp is null) asocError = "No hay una caja de tipo Mercado Pago activa. Creala en Tesorería → Cajas.";
            // Link del sistema hecho para un cliente: si el nombre coincide justo con uno, lo elijo solo.
            if (!string.IsNullOrWhiteSpace(c.ClienteSugerido))
            {
                var exactos = clientes.Where(x => x.IsActive && (string.Equals(x.Nombre, c.ClienteSugerido.Trim(), StringComparison.OrdinalIgnoreCase)
                    || string.Equals(x.RazonSocial, c.ClienteSugerido.Trim(), StringComparison.OrdinalIgnoreCase))).ToList();
                if (exactos.Count == 1) await ElegirCliente(exactos[0]);
            }
        }
        catch (Exception ex) { asocError = ex.Message; }
    }

    private void CerrarAsociar() { if (!guardandoAsoc) asoc = null; }

    private async Task ElegirCliente(CafeClienteDto cl)
    {
        asocCliente = cl; asocPend = null; asocTildes = new();
        StateHasChanged();
        try
        {
            asocPend = (await Api.GetComprobantesPendientesAsync(cl.Id, true) ?? new())
                .Where(p => p.Saldo > 0.009m).OrderBy(p => p.Fecha).ToList();
            // Si uno debe justo lo que pagó, lo dejo tildado.
            var justo = asocPend.Where(p => Math.Abs(p.Saldo - asoc!.Monto) < 0.01m).ToList();
            if (justo.Count == 1) asocTildes.Add(Clave(justo[0]));
        }
        catch (Exception ex) { asocError = ex.Message; asocPend = new(); }
    }

    private void Tildar(string key, bool on) { if (on) asocTildes.Add(key); else asocTildes.Remove(key); }

    /// <summary>Reparte lo que pagó entre los tildados (del más viejo al más nuevo); lo que sobra va a cuenta.</summary>
    private (List<(ComprobantePendienteDto p, string numero, decimal importe)> imps, decimal aCuenta) Imputar()
    {
        var resto = asoc?.Monto ?? 0m;
        var imps = new List<(ComprobantePendienteDto, string, decimal)>();
        foreach (var p in (asocPend ?? new()).Where(p => asocTildes.Contains(Clave(p))))
        {
            if (resto <= 0.009m) break;
            var imp = Math.Min(p.Saldo, resto);
            imps.Add((p, p.Numero, imp));
            resto -= imp;
        }
        return (imps, Math.Round(resto, 2));
    }

    /// <summary>Fecha del cobro de MP; si la caja ya tiene un arqueo posterior, va con la fecha de hoy.</summary>
    private DateTime? FechaCobranza()
    {
        if (asoc is null) return null;
        var dia = asoc.Fecha.ToArTime().Date;
        if (dia >= DateTimeExt.AhoraAr().Date) return null;
        if (cajaMp?.UltimoArqueo is DateTime arq && dia <= arq.Date) return null;
        return dia;
    }

    private string FechaCobranzaTexto() => (FechaCobranza() ?? DateTimeExt.AhoraAr().Date).ToString("dd/MM");

    private async Task GuardarAsociar()
    {
        if (asoc is null || asocCliente is null || asocPend is null) return;
        if (cajaMp is null) { asocError = "No hay una caja de tipo Mercado Pago activa. Creala en Tesorería → Cajas."; return; }
        guardandoAsoc = true; asocError = null;
        try
        {
            var (imps, aCuenta) = Imputar();
            var comps = imps.Select(i => i.p.ReservaId is > 0
                ? new ApiClient.CrearComprobanteItemRequest(null, i.importe, i.p.ReservaId)
                : new ApiClient.CrearComprobanteItemRequest(i.p.VentaId, i.importe)).ToList();
            if (aCuenta > 0.009m) comps.Add(new ApiClient.CrearComprobanteItemRequest(null, aCuenta));
            var medios = new List<ApiClient.CrearMedioItemRequest>
            {
                new(cajaMp.Id, asoc.Monto, $"MP #{asoc.MpPaymentId}", null)
            };
            var obs = $"Cobro Mercado Pago #{asoc.MpPaymentId}" + (string.IsNullOrWhiteSpace(asoc.Quien) ? "" : $" ({asoc.Quien})");
            var r = await Api.CrearCafeCobranzaAsync(asocCliente.Id, 0m, null, obs, comps, medios, null,
                FechaCobranza()?.ToString("yyyy-MM-dd"));
            if (r is null) { asocError = "No se pudo crear la cobranza."; return; }
            await Api.AsociarMpCobroAsync(asoc.Id, r.Id);
            ToastService.Show($"Listo: cobranza {r.Numero} de {asocCliente.Nombre}.", ToastType.Success);
            guardandoAsoc = false;
            asoc = null;
            await Cargar();
        }
        catch (Exception ex) { asocError = ex.Message; }
        finally { guardandoAsoc = false; }
    }

    private static string OrigenTexto(string o) => o switch
    {
        "link" => "Link de pago",
        "meli" => "Venta MercadoLibre",
        _ => "Transferencia / QR / otro"
    };

    private static string Medio(MpCobroDto c)
    {
        var t = c.TipoMedio switch
        {
            "account_money" => "dinero en cuenta",
            "debit_card" => "débito",
            "credit_card" => "crédito",
            "prepaid_card" => "prepaga",
            "ticket" => "efectivo",
            "bank_transfer" => "transferencia",
            "atm" => "cajero",
            _ => c.MedioPago switch
            {
                "account_money" => "dinero en cuenta",
                null or "" => "",
                var m when m.StartsWith("deb") => "débito",
                _ => c.MedioPago
            }
        };
        if (c.Cuotas is int n && n > 1) t += $" {n} cuotas";
        return t;
    }

    private static string Fmt(decimal v)
        => v == Math.Round(v, 0) ? v.ToString("#,0", Ar) : v.ToString("#,0.00", Ar);
}
