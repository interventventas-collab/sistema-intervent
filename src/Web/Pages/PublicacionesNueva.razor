                        <span class="pill gris">@preview.SinCambios.ToString("N0", ar) sin tocar</span>
                        <span class="pill verde">@preview.ConCambios.ToString("N0", ar) con cambios</span>
                        @if (preview.Bloqueadas > 0)
                        {
                            <span class="pill rojo">@preview.Bloqueadas.ToString("N0", ar) no se pueden</span>
                        }
                        @if (preview.CambianPrecio > 0)
                        {
                            <span class="pill ambar">💵 @preview.CambianPrecio.ToString("N0", ar) cambian el precio en MercadoLibre</span>
                        }
                        @if (preview.CambianObjetivo > 0)
                        {
                            <span class="pill">🎯 @preview.CambianObjetivo.ToString("N0", ar) cambian el objetivo</span>
                        }
                        @if (preview.CambianSincro > 0)
                        {
                            <span class="pill">🔁 @preview.CambianSincro.ToString("N0", ar) cambian el sincro</span>
                        }
                    </div>

                    @foreach (var p in preview.Problemas)
                    {
                        <div class="problema">⚠ @p</div>
                    }

                    @if (preview.Cambios.Count == 0)
                    {
                        <div class="vacio">
                            No hay nada para cambiar: el archivo tiene los mismos valores que el sistema.
                            Acordate de editar las columnas amarillas y <b>guardar</b> el Excel antes de subirlo.
                        </div>
                    }
                    else
                    {
                        <div class="acc-tildar">
                            <button class="p2-btn chico" @onclick="TildarTodosPreview">Tildar todo lo que se puede</button>
                            <button class="p2-btn chico" @onclick="() => preSel.Clear()">Destildar todo</button>
                            <span class="cnt">@preSel.Count elegidos</span>
                        </div>

                        <div class="tabla">
                            @foreach (var c in preview.Cambios)
                            {
                                <div class="fila @(c.Bloqueada ? "bloq" : "") @(preSel.Contains(c.Mla) ? "sel" : "")">
                                    <input type="checkbox" checked="@preSel.Contains(c.Mla)" disabled="@c.Bloqueada"
                                           @onchange="() => TogglePreview(c.Mla)" />
                                    <div class="txt">
                                        <div class="tit">
                                            @c.Titulo
                                            @if (!string.IsNullOrEmpty(c.Sku))
                                            {
                                                <span class="sku">@c.Sku</span>
                                            }
                                            <span class="mla">@c.Mla</span>
                                        </div>
                                        <div class="que">@c.Resumen</div>
                                        @if (c.MargenEstimadoPct.HasValue)
                                        {
                                            <div class="deja @(c.MargenEstimadoPct < 0 ? "mal" : c.MargenEstimadoPct < 50 ? "flojo" : "bien")">
                                                A ese precio te quedaría aprox. @c.MargenEstimadoPct.Value.ToString("0.#", ar)% sobre el costo
                                            </div>
                                        }
                                        @foreach (var a in c.Avisos)
                                        {
                                            <div class="aviso @(c.Bloqueada ? "err" : "")">@a</div>
                                        }
                                    </div>
                                </div>
                            }
                        </div>
                    }
                }
                else
                {
                    <div class="resumen">
                        <span class="pill verde">@aplicado.Ok.ToString("N0", ar) hechos</span>
                        @if (aplicado.Errores > 0)
                        {
                            <span class="pill rojo">@aplicado.Errores.ToString("N0", ar) con error</span>
                        }
                        @if (aplicado.Salteados > 0)
                        {
                            <span class="pill gris">@aplicado.Salteados.ToString("N0", ar) salteados</span>
                        }
                    </div>
                    <div class="tabla">
                        @foreach (var d in aplicado.Detalle)
                        {
                            <div class="fila">
                                <span class="ico @(d.Ok ? "ok" : "no")">@(d.Ok ? "✓" : "✗")</span>
                                <div class="txt">
                                    <div class="tit"><span class="mla">@d.Mla</span></div>
                                    <div class="que">@d.Mensaje</div>
                                </div>
                            </div>
                        }
                    </div>
                }
            </div>

            <div class="pie">
                @if (aplicado is null)
                {
                    @if (confirmando)
                    {
                        <span class="confirmar">
                            @ConfirmacionTexto
                            <button class="p2-btn go" @onclick="AplicarExcel" disabled="@excelAplicando">Sí, dale</button>
                            <button class="p2-btn" @onclick="() => confirmando = false" disabled="@excelAplicando">No</button>
                        </span>
                    }
                    else
                    {
                        <button class="p2-btn" @onclick="CerrarPreview" disabled="@excelAplicando">Cancelar</button>
                        <button class="p2-btn go" @onclick="PedirConfirmacion"
                                disabled="@(excelAplicando || preSel.Count == 0)">
                            @(excelAplicando ? "⏳ Aplicando… no cierres la pantalla" : $"Aplicar {preSel.Count} cambios")
                        </button>
                    }
                }
                else
                {
                    <button class="p2-btn go" @onclick="CerrarPreview">Cerrar</button>
                }
            </div>
        </div>
    }
</div>

@code {
    private static readonly System.Globalization.CultureInfo ar = new("es-AR");

    private ApiClient.PubV2Page? datos;
    private bool cargando;
    private int pagina = 1;
    private int porPagina = 50;   // 2026-08-26: pedido de Osmar, arranca en 50

    private string fTexto = "";
    private string fSku = "";
    private string fEstado = "";
    private decimal? fComision;
    private string fCuotas = "";
    private bool fVariosPrecios;
    private bool fPrecioAMano;
    private bool fSinCosto;
    private decimal? fNoLlegan;

    // Panel de medidas (peso y dimensiones): es lo que define el envío que cobra MeLi.
    // Etapa 2: lo tildado y las acciones
    private readonly HashSet<string> tildadas = new();
    private bool accionEnCurso;
    private string accionTexto = "";
    private ApiClient.PubV2AccionResultado? resultado;
    private decimal objetivoLote = 50;

    private bool TodasTildadas => datos is not null && datos.Items.Count > 0
                                  && datos.Items.All(i => tildadas.Contains(i.MeliItemId));

    private string? medidasAbiertas;
    private ApiClient.PubV2Medidas? medidas;
    private bool medidasCargando, medidasGuardando, medidasResultadoOk;
    private string? medidasResultado;
    private int? edPeso;
    private decimal? edLargo, edAncho, edAlto;
    private bool fComisionVieja;

    // 2026-08-27 — Osmar no tenia forma de saber si una publicacion era de FRIKAF o de GROVAS:
    // la fila no lo mostraba aunque el dato ya venia del servidor. Etiqueta en la fila + filtro.
    private int? fCuentaId;
    private List<MeliAccountDto> cuentas = new();

    private bool HayFiltros => fComisionVieja || fNoLlegan.HasValue || fComision.HasValue || fVariosPrecios || fPrecioAMano || fSinCosto
                               || !string.IsNullOrEmpty(fCuotas) || !string.IsNullOrEmpty(fEstado)
                               || !string.IsNullOrWhiteSpace(fTexto) || !string.IsNullOrWhiteSpace(fSku)
                               || fCuentaId.HasValue;

    private int TotalPaginas => datos is null || datos.Total == 0 ? 1 : (int)Math.Ceiling(datos.Total / (double)datos.PorPagina);

    protected override async Task OnInitializedAsync()
    {
        // Las cuentas solo alimentan los chips del filtro: si falla, la pantalla anda igual.
        try { cuentas = await Api.GetMeliAccountsAsync() ?? new(); } catch { cuentas = new(); }
        await Cargar();
    }

    private async Task Cargar()
    {
        CerrarCandado();   // que no quede una fila abierta de la lista anterior
        cargando = true;
        StateHasChanged();
        try
        {
            datos = await Api.GetPublicacionesV2Async(fTexto, fSku, fEstado, fComision, fCuotas, null,
                fVariosPrecios, fPrecioAMano, fSinCosto, fNoLlegan, fComisionVieja, pagina, porPagina, fCuentaId);
        }
        catch (Exception ex)
        {
            ToastService.Error("No se pudo cargar: " + ex.Message);
        }
        finally
        {
            cargando = false;
            StateHasChanged();
        }
    }

    private async Task CambiarPorPagina(ChangeEventArgs e)
    {
        if (int.TryParse(e.Value?.ToString(), out var n) && n > 0) porPagina = n;
        pagina = 1;
        await Cargar();
    }

    private async Task BuscarDesdeCero() { pagina = 1; await Cargar(); }
    private async Task OnEnter(KeyboardEventArgs e) { if (e.Key == "Enter") await BuscarDesdeCero(); }
    private async Task IrAPagina(int p) { if (p < 1 || p > TotalPaginas) return; pagina = p; await Cargar(); }
    private async Task SetEstado(string v) { fEstado = v; await BuscarDesdeCero(); }
    private void ToggleTildada(string mla)
    {
        if (!tildadas.Remove(mla)) tildadas.Add(mla);
        resultado = null;
    }

    private void TildarTodas(ChangeEventArgs e)
    {
        if (datos is null) return;
        var prender = e.Value is bool b && b;
        foreach (var i in datos.Items)
        {
            if (prender) tildadas.Add(i.MeliItemId);
            else tildadas.Remove(i.MeliItemId);
        }
        resultado = null;
    }

    /// <summary>Envoltorio común: muestra "en curso", corre la acción y recarga la lista.</summary>
    private async Task Correr(string texto, Func<List<string>, Task<ApiClient.PubV2AccionResultado?>> accion,
        bool pedirConfirmacion = false, string? confirmacion = null)
    {
        var lista = tildadas.ToList();
        if (lista.Count == 0) return;

        if (pedirConfirmacion)
        {
            var ok = await JS.InvokeAsync<bool>("confirm", confirmacion ?? $"Esto cambia {lista.Count} publicaciones en MercadoLibre. ¿Seguro?");
            if (!ok) return;
        }

        accionEnCurso = true;
        accionTexto = texto;
        resultado = null;
        StateHasChanged();
        try
        {
            resultado = await accion(lista);
            if (resultado is null) ToastService.Error("No se pudo completar la acción.");
            else
            {
                if (resultado.Errores == 0) ToastService.Success($"{resultado.Ok} listas.");
                else ToastService.Warning($"{resultado.Ok} ok, {resultado.Errores} con error — mirá el detalle.");
                await Cargar();
            }
        }
        catch (Exception ex) { ToastService.Error("Error: " + ex.Message); }
        finally { accionEnCurso = false; StateHasChanged(); }
    }

    private Task AccComisiones() => Correr("actualizando comisiones…", l => Api.AccionComisionesAsync(l));

    private Task AccSincro(bool? precio, bool? stock)
        => Correr("guardando…", l => Api.AccionSincroAsync(l, precio, stock));

    private Task AccObjetivo(bool aplicarAhora)
        => Correr(aplicarAhora ? "aplicando objetivo y publicando…" : "guardando objetivo…",
            l => Api.AccionObjetivoAsync(l, objetivoLote, aplicarAhora),
            aplicarAhora,
            $"Esto va a CAMBIAR EL PRECIO en MercadoLibre de {tildadas.Count} publicaciones para dejar {objetivoLote:0.#}% sobre el costo. ¿Seguro?");

    private Task AccPrecio()
        => Correr("publicando precios…", l => Api.AccionPrecioAsync(l), true,
            $"Esto va a publicar en MercadoLibre el precio que calcula el sistema para {tildadas.Count} publicaciones. ¿Seguro?");

    private Task AccStock()
        => Correr("mandando stock…", l => Api.AccionStockAsync(l), true,
            $"Esto manda el stock del sistema a MercadoLibre en {tildadas.Count} publicaciones. Las que queden en 0 MeLi las pausa. ¿Seguro?");

    private async Task ToggleMedidas(string mla)
    {
        if (medidasAbiertas == mla) { medidasAbiertas = null; medidas = null; return; }
        CerrarFotos();
        medidasAbiertas = mla;
        medidas = null;
        medidasResultado = null;
        medidasCargando = true;
        StateHasChanged();
        try
        {
            medidas = await Api.GetMedidasAsync(mla);
            edPeso = medidas?.PesoGramos;
            edLargo = medidas?.LargoCm;
            edAncho = medidas?.AnchoCm;
            edAlto = medidas?.AltoCm;
        }
        catch (Exception ex) { ToastService.Error("No se pudieron leer las medidas: " + ex.Message); }
        finally { medidasCargando = false; StateHasChanged(); }
    }

    private async Task GuardarMedidas(string mla)
    {
        medidasGuardando = true;
        medidasResultado = null;
        StateHasChanged();
        try
        {
            var (res, err) = await Api.GuardarMedidasAsync(mla, edPeso, edLargo, edAncho, edAlto);
            if (res is not null && res.Ok)
            {
                medidasResultadoOk = true;
                medidasResultado = res.Mensaje;
                medidas = res.Medidas ?? medidas;
                ToastService.Success(res.Mensaje);
                await Cargar();   // el margen de la fila cambia si el envío cambió
            }
            else
            {
                medidasResultadoOk = false;
                medidasResultado = res?.Mensaje ?? err ?? "No se pudo guardar";
                ToastService.Error(medidasResultado);
            }
        }
        catch (Exception ex)
        {
            medidasResultadoOk = false;
            medidasResultado = "Error: " + ex.Message;
        }
        finally { medidasGuardando = false; StateHasChanged(); }
    }

    // ── Etapa 3: fotos ──
    // Se abre al pinchar la miniatura. Reordenar, poner portada y borrar son la MISMA operación
    // en MeLi: se manda la lista final ordenada. Por eso se edita local y recién al guardar se
    // manda todo junto (así el usuario puede acomodar y deshacer sin tocar la publicación).
    private class FotoEdit
    {
        public string? Id { get; set; }        // foto que ya estaba en MeLi
        public string? DataUri { get; set; }   // foto nueva subida desde la compu
        public string Preview { get; set; } = "";
        public bool EsNueva => Id is null;
    }

    private string? fotosAbiertas;
    private ApiClient.PubV2Fotos? fotosDatos;
    private List<FotoEdit> fotosEdit = new();
    private List<string> fotosOriginal = new();   // firma de cómo estaban, para saber si cambió algo
    private readonly HashSet<string> hermanasElegidas = new();
    private bool fotosCargando, fotosGuardando, fotosCopiando, fotosResultadoOk;
    private string? fotosResultado;

    private bool fotosBloqueadas => fotosDatos?.DeCatalogo == true;

    private bool FotosCambiaron
        => !fotosEdit.Select(f => f.Id ?? "nueva:" + f.Preview.Length).SequenceEqual(fotosOriginal);

    private async Task ToggleFotos(string mla)
    {
        if (fotosAbiertas == mla) { CerrarFotos(); return; }
        medidasAbiertas = null;   // no tener los dos paneles abiertos a la vez
        fotosAbiertas = mla;
        fotosDatos = null;
        fotosEdit = new();
        fotosOriginal = new();
        hermanasElegidas.Clear();
        fotosResultado = null;
        fotoLink = "";
        fotosCargando = true;
        StateHasChanged();
        try
        {
            fotosDatos = await Api.GetFotosV2Async(mla);
            RefrescarEdicion();
        }
        catch (Exception ex) { ToastService.Error("No se pudieron leer las fotos: " + ex.Message); }
        finally { fotosCargando = false; StateHasChanged(); }
    }

    private void CerrarFotos()
    {
        fotosAbiertas = null;
        fotosDatos = null;
        fotosEdit = new();
        fotosOriginal = new();
        hermanasElegidas.Clear();
        fotosResultado = null;
    }

    private void RefrescarEdicion()
    {
        fotosEdit = fotosDatos?.Fotos.Select(f => new FotoEdit { Id = f.Id, Preview = f.Url }).ToList() ?? new();
        fotosOriginal = fotosEdit.Select(f => f.Id ?? "").ToList();
    }

    private void MoverFoto(int idx, int dir)
    {
        var destino = idx + dir;
        if (destino < 0 || destino >= fotosEdit.Count) return;
        (fotosEdit[idx], fotosEdit[destino]) = (fotosEdit[destino], fotosEdit[idx]);
    }

    private void HacerPortada(int idx)
    {
        if (idx <= 0 || idx >= fotosEdit.Count) return;
        var f = fotosEdit[idx];
        fotosEdit.RemoveAt(idx);
        fotosEdit.Insert(0, f);
    }

    private void QuitarFoto(int idx)
    {
        if (idx < 0 || idx >= fotosEdit.Count) return;
        if (fotosEdit.Count == 1)
        {
            ToastService.Error("La publicación tiene que quedar con al menos una foto.");
            return;
        }
        fotosEdit.RemoveAt(idx);
    }

    private void DeshacerFotos() { RefrescarEdicion(); fotosResultado = null; }

    // Traer una foto por ENLACE. El servidor la BAJA (esquiva bloqueos y convierte webp→jpg) y la deja
    // capturada como archivo: si mañana el fabricante la borra de su página, la nuestra sigue estando.
    private string fotoLink = "";
    private bool fotoTrayendo;

    private async Task AgregarFotoPorLink()
    {
        var url = (fotoLink ?? "").Trim();
        if (string.IsNullOrEmpty(url)) return;
        if (!url.StartsWith("http", StringComparison.OrdinalIgnoreCase))
        {
            ToastService.Error("Pegá un enlace que empiece con http…");
            return;
        }
        fotoTrayendo = true;
        StateHasChanged();
        try
        {
            var (dataUri, error) = await Api.FetchImageFromUrlAsync(url);
            if (string.IsNullOrEmpty(dataUri))
            {
                ToastService.Error(error ?? "No se pudo traer la foto de ese enlace.");
                return;
            }
            fotosEdit.Add(new FotoEdit { DataUri = dataUri, Preview = dataUri });
            fotoLink = "";
        }
        catch (Exception ex) { ToastService.Error("Error: " + ex.Message); }
        finally { fotoTrayendo = false; StateHasChanged(); }
    }

    private async Task SubirFotos(InputFileChangeEventArgs e)
    {
        const long max = 10L * 1024 * 1024;   // tope de MeLi
        foreach (var file in e.GetMultipleFiles(12))
        {
            if (file.Size > max)
            {
                ToastService.Error($"{file.Name}: pesa más de 10 MB, que es lo máximo que acepta MercadoLibre.");
                continue;
            }
            try
            {
                var tipo = string.IsNullOrEmpty(file.ContentType) ? "image/jpeg" : file.ContentType;
                using var stream = file.OpenReadStream(max);
                using var ms = new MemoryStream();
                await stream.CopyToAsync(ms);
                var dataUri = $"data:{tipo};base64,{Convert.ToBase64String(ms.ToArray())}";
                fotosEdit.Add(new FotoEdit { DataUri = dataUri, Preview = dataUri });
            }
            catch (Exception ex) { ToastService.Error($"{file.Name}: no se pudo leer ({ex.Message})"); }
        }
        StateHasChanged();
    }

    private async Task GuardarFotos(string mla)
    {
        if (fotosEdit.Count == 0) { ToastService.Error("Tiene que quedar al menos una foto."); return; }
        fotosGuardando = true;
        fotosResultado = null;
        StateHasChanged();
        try
        {
            var lista = fotosEdit.Select(f => (object)new { Id = f.Id, DataUri = f.DataUri }).ToList();
            var (res, err) = await Api.GuardarFotosV2Async(mla, lista);
            fotosResultadoOk = res?.Ok == true;
            fotosResultado = res?.Mensaje ?? err ?? "No se pudo guardar";
            if (fotosResultadoOk)
            {
                if (res!.Fotos is not null) { fotosDatos = res.Fotos; RefrescarEdicion(); }
                ToastService.Success(fotosResultado);
                await Cargar();   // la miniatura de la fila cambia si cambió la portada
            }
            else ToastService.Error(fotosResultado);
        }
        catch (Exception ex) { fotosResultadoOk = false; fotosResultado = "Error: " + ex.Message; }
        finally { fotosGuardando = false; StateHasChanged(); }
    }

    private void ToggleHermana(ApiClient.PubV2Hermana h)
    {
        if (h.DeCatalogo) return;   // MeLi no deja tocarles las fotos
        if (!hermanasElegidas.Remove(h.MeliItemId)) hermanasElegidas.Add(h.MeliItemId);
    }

    private void ElegirTodasHermanas()
    {
        if (hermanasElegidas.Count > 0) { hermanasElegidas.Clear(); return; }
        foreach (var h in fotosDatos?.Hermanas.Where(x => !x.DeCatalogo) ?? Enumerable.Empty<ApiClient.PubV2Hermana>())
            hermanasElegidas.Add(h.MeliItemId);
    }

    private async Task CopiarFotos(string mla)
    {
        if (hermanasElegidas.Count == 0) return;
        var ok = await JS.InvokeAsync<bool>("confirm",
            $"Esto le reemplaza TODAS las fotos a {hermanasElegidas.Count} publicación/es por las de esta. No se puede deshacer solo. ¿Seguro?");
        if (!ok) return;

        fotosCopiando = true;
        fotosResultado = null;
        StateHasChanged();
        try
        {
            var (res, err) = await Api.CopiarFotosV2Async(mla, hermanasElegidas.ToList());
            fotosResultadoOk = res?.Ok == true;
            fotosResultado = res?.Mensaje ?? err ?? "No se pudo copiar";
            if (fotosResultadoOk)
            {
                ToastService.Success(fotosResultado);
                hermanasElegidas.Clear();
                fotosDatos = await Api.GetFotosV2Async(mla);   // refrescar el conteo de fotos de cada hermana
                RefrescarEdicion();
                await Cargar();
            }
            else ToastService.Error(fotosResultado);
        }
        catch (Exception ex) { fotosResultadoOk = false; fotosResultado = "Error: " + ex.Message; }
        finally { fotosCopiando = false; StateHasChanged(); }
    }

    // ── Precio a mano en la fila (2026-08-26) ──
    // Osmar: "si me dejás poner el precio a mano y ya me aparece el porcentaje al lado, ya me vale".
    // El porcentaje NO se calcula acá: se le pregunta a MercadoLibre cuánto cobraría a ese precio,
    // porque la comisión cambia de escalón y una fórmula nuestra mentiría. Mientras espera se
    // muestran tres puntitos — antes que un número aproximado que después cambia.
    private string? editandoPrecio;
    private string precioEscrito = "";
    private ApiClient.PubV2Simulacion? simulacion;
    private bool simulando, precioGuardando;
    private CancellationTokenSource? simCts;

    /// <summary>¿Quién gobierna el precio de esta publicación? El porcentaje solo manda si además
    /// el sincro de precio está prendido: con el sincro apagado el objetivo queda de adorno.</summary>
    private bool MandaElPorcentaje(ApiClient.PubV2Fila it)
        => it.SyncPrecio && it.ObjetivoPct is > 0;

    private void EmpezarPrecio(ApiClient.PubV2Fila it)
    {
        editandoPrecio = it.MeliItemId;
        precioEscrito = it.Precio.ToString("0.##", System.Globalization.CultureInfo.InvariantCulture);
        simulacion = null;
        simulando = false;
    }

    private void CancelarPrecio()
    {
        simCts?.Cancel();
        editandoPrecio = null;
        precioEscrito = "";
        simulacion = null;
        simulando = false;
    }

    /// <summary>Se dispara mientras escribe. Espera 600 ms de quietud para no bombardear a MeLi
    /// con una consulta por tecla.</summary>
    private async Task PrecioEscritoCambio()
    {
        simCts?.Cancel();
        var cts = new CancellationTokenSource();
        simCts = cts;
        var mla = editandoPrecio;
        if (mla is null) return;

        if (!TryPrecio(precioEscrito, out var precio) || precio <= 0)
        {
            simulacion = null; simulando = false; StateHasChanged(); return;
        }

        simulando = true;
        StateHasChanged();
        try
        {
            await Task.Delay(600, cts.Token);
            var r = await Api.SimularPrecioV2Async(mla, precio);
            if (cts.Token.IsCancellationRequested || editandoPrecio != mla) return;
            simulacion = r;
        }
        catch (TaskCanceledException) { return; }
        catch (Exception ex) { ToastService.Error("No se pudo calcular: " + ex.Message); }
        finally
        {
            if (!cts.Token.IsCancellationRequested) { simulando = false; StateHasChanged(); }
        }
    }

    /// <summary>Acepta "33500", "33.500", "33500,50" — lo que salga de teclear con costumbre argentina.</summary>
    private static bool TryPrecio(string texto, out decimal precio)
    {
        precio = 0;
        var limpio = (texto ?? "").Trim().Replace("$", "").Replace(" ", "").Replace(".", "").Replace(",", ".");
        return decimal.TryParse(limpio, System.Globalization.NumberStyles.Any,
            System.Globalization.CultureInfo.InvariantCulture, out precio);
    }

    private async Task ConfirmarPrecio(ApiClient.PubV2Fila it)
    {
        if (!TryPrecio(precioEscrito, out var precio) || precio <= 0)
        {
            ToastService.Error("Escribí un precio válido.");
            return;
        }
        if (precio == it.Precio) { CancelarPrecio(); return; }

        // La pregunta que evita que el precio "se cambie solo" a la noche: si esta publicación
        // está en modo porcentaje, el sistema lo va a recalcular salvo que se apague el sincro.
        var quedaFijo = true;
        if (MandaElPorcentaje(it))
        {
            quedaFijo = await JS.InvokeAsync<bool>("confirm",
                $"Esta publicación hoy mantiene sola el {it.ObjetivoPct:0}% de ganancia.\n\n" +
                $"ACEPTAR: el precio ${precio:N0} queda FIJO y el sistema no lo toca más.\n" +
                $"CANCELAR: se publica igual, pero el sistema lo va a recalcular para volver al {it.ObjetivoPct:0}%.");
        }
        else
        {
            var ok = await JS.InvokeAsync<bool>("confirm",
                $"Publicar ${precio:N0} en MercadoLibre (hoy está ${it.Precio:N0}). ¿Seguro?");
            if (!ok) return;
        }

        precioGuardando = true;
        StateHasChanged();
        try
        {
            var (res, err) = await Api.PonerPrecioV2Async(it.MeliItemId, precio, quedaFijo);
            if (res?.Ok == true)
            {
                ToastService.Success(res.Mensaje);
                CancelarPrecio();
                await Cargar();
            }
            else ToastService.Error(res?.Mensaje ?? err ?? "No se pudo publicar el precio");
        }
        catch (Exception ex) { ToastService.Error("Error: " + ex.Message); }
        finally { precioGuardando = false; StateHasChanged(); }
    }

