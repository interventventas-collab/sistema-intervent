                                    <div class="aviso">@fotosDatos.Aviso</div>
                                }
                                @if (!string.IsNullOrEmpty(fotosResultado))
                                {
                                    <div class="aviso @(fotosResultadoOk ? "ok" : "err")">@fotosResultado</div>
                                }
                            }
                        </div>
                    }

                    @if (descAbierta == it.MeliItemId)
                    {
                        <div class="p2-fotos" @onclick:stopPropagation="true">
                            <h4>📝 Descripción en MercadoLibre</h4>
                            @if (descCargando)
                            {
                                <span class="cnt">Consultando a MercadoLibre…</span>
                            }
                            else if (descDatos is null)
                            {
                                <span class="aviso err">No se pudo leer la descripción.</span>
                            }
