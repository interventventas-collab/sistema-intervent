@page "/publicaciones-nueva"
@attribute [Authorize]
@inject ApiClient Api
@inject NavigationManager Nav
@inject ToastService ToastService
@inject IJSRuntime JS

@*
    2026-08-25 — Pantalla NUEVA de publicaciones. ETAPA 1: solo mirar.
    Convive con la de siempre (/publicaciones), que no se toca hasta que ésta esté aprobada.
    Novedades respecto de la vieja:
      · Pantalla completa (sin menú al costado ni barra arriba), como el Mapeo.
      · Debajo del título: de qué productos del sistema se compone y para cuántas alcanza.
      · Columna "Se lleva MeLi": el total real (porcentaje + cargo fijo + cuotas), no solo el %.
      · Cuando la familia tiene precios distintos, muestra el rango en vez de fingir uno solo.
      · Filtros por comisión / cuotas / varios precios / precio a mano.
*@

<style>
    .p2-full { position: fixed; inset: 0; z-index: 4000; display: flex; flex-direction: column;
               background: #f8f9f7; overflow: hidden; }
    .p2-bar { display: flex; align-items: center; gap: .6rem; justify-content: space-between;
              flex-wrap: wrap; padding: .6rem .9rem; background: #0f2a1c; color: #fff; }
    .p2-bar .ttl { font-weight: 700; font-size: .95rem; }
    .p2-bar .ttl small { font-weight: 400; opacity: .75; margin-left: .4rem; }
    .p2-bar .acts { display: flex; gap: .4rem; flex-wrap: wrap; }
    .p2-btn { font-size: .78rem; font-weight: 600; padding: .42rem .7rem; border-radius: .45rem;
              border: 1px solid rgba(255,255,255,.22); background: rgba(255,255,255,.08); color: #fff; cursor: pointer; }
    .p2-btn:hover { background: rgba(255,255,255,.16); }
    .p2-btn.go { background: #15803d; border-color: #15803d; }

    .p2-body { flex: 1; min-height: 0; overflow-y: auto; overflow-x: hidden; padding: .8rem .9rem 1.2rem; display: flex; flex-direction: column; gap: .6rem; }
    .p2-search { display: flex; gap: .5rem; flex-wrap: wrap; }
    .p2-search input { flex: 1; min-width: 160px; padding: .48rem .65rem; border: 1px solid #e3e7e0;
                       border-radius: .5rem; font-size: .8rem; }
    .p2-filters { display: flex; gap: .35rem; flex-wrap: wrap; align-items: center; }
    .p2-chip { font-size: .75rem; padding: .35rem .65rem; border-radius: 999px; border: 1px solid #e3e7e0;
               background: #fff; color: #6b7280; cursor: pointer; white-space: nowrap; }
    .p2-chip:hover { border-color: #9ca3af; }
    .p2-chip.on { background: #4f46e5; border-color: #4f46e5; color: #fff; font-weight: 600; }
    .p2-chip.nue { background: #e5efe8; border-color: #1f6b45; color: #1f6b45; font-weight: 600; }
    .p2-chip.nue.on { background: #1f6b45; color: #fff; }
    .p2-lbl { font-size: .62rem; letter-spacing: .09em; text-transform: uppercase; color: #9ca3af; font-weight: 700; }

    .p2-count { display: flex; justify-content: space-between; align-items: center; font-size: .75rem;
                color: #6b7280; flex-wrap: wrap; gap: .5rem; }
    .p2-pg { border: 1px solid #e3e7e0; background: #fff; border-radius: .35rem; padding: .18rem .5rem;
             font-size: .7rem; color: #6b7280; cursor: pointer; }
    .p2-pg[disabled] { opacity: .45; cursor: default; }

    /* 2026-08-26 — flex-shrink:0 es CLAVE: sin esto el contenedor flex comprimia la tabla y,
       como tiene overflow:hidden por el borde redondeado, las filas de abajo se RECORTABAN
       (se veian 9 de 17 y no aparecian ni bajando). */
    .p2-tbl { background: #fff; border: 1px solid #e3e7e0; border-radius: .6rem; overflow: hidden; flex-shrink: 0; }
    .p2-th, .p2-tr { display: grid; grid-template-columns: 30px minmax(0,1fr) 128px 148px 120px 140px 52px 70px;
                     gap: .6rem; align-items: center; padding: .55rem .65rem; }
    .p2-th { background: #f8f9f7; border-bottom: 1px solid #e3e7e0; font-size: .6rem; text-transform: uppercase;
             letter-spacing: .07em; color: #9ca3af; font-weight: 700; }
    .p2-tr { border-bottom: 1px solid #e3e7e0; font-size: .78rem; }
    .p2-tr:last-child { border-bottom: none; }
    .p2-tr:hover { background: #fafbf9; }
    .p2-prod { display: flex; gap: .5rem; align-items: center; min-width: 0; }
    .p2-thumb { width: 34px; height: 34px; border-radius: .35rem; border: 1px solid #e3e7e0; object-fit: cover;
                background: #f8f9f7; flex-shrink: 0; }
    .p2-pinfo { min-width: 0; }
    .p2-t { display: block; font-weight: 600; font-size: .76rem; color: #1f2937; white-space: nowrap;
            overflow: hidden; text-overflow: ellipsis; }
    .p2-m { display: block; font-family: ui-monospace, monospace; font-size: .63rem; color: #9ca3af;
            white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
    .p2-rec { display: block; font-size: .63rem; color: #9ca3af; white-space: nowrap; overflow: hidden;
              text-overflow: ellipsis; margin-top: .05rem; }
    .p2-rec b { color: #6b7280; font-weight: 600; }
    .p2-rec .frena { color: #b91c1c; font-weight: 700; }
    .p2-rec .arma { color: #6b7280; font-weight: 700; }

    .p2-price { display: block; font-weight: 700; font-size: .8rem; }
    .p2-rango { display: block; font-weight: 700; font-size: .76rem; color: #b91c1c; }
    .p2-flag { display: inline-block; font-size: .58rem; font-weight: 700; padding: .1rem .35rem;
               border-radius: .25rem; background: #fee2e2; color: #b91c1c; margin-top: .1rem; }
    .p2-marg { display: inline-flex; align-items: center; gap: .25rem; font-size: .64rem; margin-top: .05rem; }
    .p2-dot { width: 7px; height: 7px; border-radius: 50%; background: #16a34a; }
    .p2-dot.low { background: #f59e0b; }
    .p2-dot.bad { background: #b91c1c; }
    .p2-costo { display: block; font-size: .63rem; color: #9ca3af; }

    .p2-queda { display: block; min-width: 0; }
    .p2-queda .pct { display: block; font-weight: 800; font-size: 1.05rem; line-height: 1.15; color: #15803d; }
    .p2-queda .pct.tibio { color: #b45309; }
    .p2-queda .pct.malo { color: #b91c1c; }
    .p2-queda .ver { display: block; font-size: .64rem; font-weight: 700; margin-top: .05rem; }
    .p2-queda .ver.ok { color: #15803d; }
    .p2-queda .ver.no { color: #b91c1c; }
    .p2-queda .det { display: block; font-size: .6rem; color: #9ca3af; }
    .p2-queda .falta { display: block; font-size: .62rem; color: #b91c1c; font-weight: 700; }

    .p2-com { display: block; min-width: 0; }
    .p2-com .big { display: block; font-weight: 700; font-size: .8rem; }
    .p2-com .big.mid { color: #b45309; }
    .p2-com .big.hi { color: #b91c1c; }
    .p2-com .des { display: block; font-size: .6rem; color: #9ca3af; }
    .p2-com .viejo { display: inline-block; font-size: .58rem; font-weight: 700; color: #b45309;
                     background: #fef0d8; border-radius: .25rem; padding: .05rem .3rem; margin-top: .1rem; }
    .p2-com .bar { display: block; height: 4px; border-radius: 2px; background: #e3e7e0; margin-top: .2rem;
                   overflow: hidden; max-width: 118px; }
    .p2-com .bar i { display: block; height: 100%; background: #16a34a; }
    .p2-com .bar i.mid { background: #f59e0b; }
    .p2-com .bar i.hi { background: #b91c1c; }

    .p2-ctrl { display: flex; align-items: center; gap: .35rem; flex-wrap: nowrap; }
    .p2-obj { display: inline-flex; align-items: center; gap: .15rem; border: 1px solid #e3e7e0;
              border-radius: .35rem; padding: .1rem .3rem; background: #fff; font-size: .7rem; font-weight: 700; }
    .p2-obj .pc { font-size: .6rem; color: #9ca3af; font-weight: 400; }
    .p2-sw { display: inline-flex; align-items: center; gap: .15rem; font-size: .6rem; }
    .p2-led { width: 12px; height: 12px; border-radius: 50%; border: 1px solid #cbd5e1; background: #fff; }
    .p2-led.on { background: #15803d; border-color: #15803d; }

    .p2-stk { display: block; text-align: center; font-weight: 700; font-size: .8rem; }
    .p2-stk small { display: block; font-weight: 400; font-size: .55rem; color: #9ca3af; }
    .p2-stk.zero { color: #9ca3af; }
    .p2-st { font-size: .62rem; padding: .15rem .45rem; border-radius: 999px; font-weight: 600; text-align: center;
             white-space: nowrap; display: inline-block; }
    .p2-st.a { background: #dcfce7; color: #16a34a; }
    .p2-st.p { background: #fef0d8; color: #b45309; }
    .p2-st.o { background: #f1f5f9; color: #64748b; }

    /* panel de medidas (lo que define el envio) */
    .p2-med { background: #f8f9f7; border-bottom: 1px solid #e3e7e0; padding: .8rem 1rem .9rem 3rem; }
    .p2-med h4 { margin: 0 0 .5rem; font-size: .68rem; text-transform: uppercase; letter-spacing: .08em; color: #9ca3af; }
    .p2-med .campos { display: flex; gap: .8rem; flex-wrap: wrap; align-items: flex-end; }
    .p2-med .campo { display: flex; flex-direction: column; gap: .15rem; }
    .p2-med .campo label { font-size: .62rem; color: #6b7280; font-weight: 600; }
    .p2-med .campo input { width: 92px; padding: .35rem .5rem; border: 1px solid #e3e7e0; border-radius: .35rem;
                           font-size: .82rem; font-weight: 700; text-align: right; }
    .p2-med .envio { display: flex; flex-direction: column; gap: .1rem; padding: .35rem .7rem; border-radius: .4rem;
                     background: #fff; border: 1px solid #e3e7e0; }
    .p2-med .envio b { font-size: .95rem; }
    .p2-med .envio span { font-size: .6rem; color: #9ca3af; }
    .p2-med .aviso { font-size: .7rem; color: #b45309; background: #fef0d8; border-radius: .35rem;
                     padding: .35rem .6rem; margin-top: .5rem; display: inline-block; }
    .p2-med .ok { color: #15803d; background: #dcfce7; }
    .p2-med .err { color: #b91c1c; background: #fee2e2; }
    .p2-med .guardar { padding: .4rem .8rem; border-radius: .4rem; border: none; background: #15803d;
                       color: #fff; font-weight: 700; font-size: .78rem; cursor: pointer; }
    .p2-med .guardar[disabled] { opacity: .5; cursor: default; }
    .p2-med .nota { font-size: .68rem; color: #6b7280; margin-top: .45rem; }

    /* etapa 2: tildar y aplicar */
    .p2-chk { width: 15px; height: 15px; accent-color: #1d4f80; cursor: pointer; }
    .p2-tr.sel { background: #e9f1fa; }
    .p2-acciones { position: sticky; bottom: 0; z-index: 20; background: #fff; border-top: 2px solid #1d4f80;
                   box-shadow: 0 -3px 18px -8px rgba(0,0,0,.35); padding: .6rem .8rem; display: flex;
                   gap: .45rem; align-items: center; flex-wrap: wrap; }
    .p2-acciones .cnt { font-weight: 700; color: #1d4f80; font-size: .82rem; white-space: nowrap; }
    .p2-acciones .sep { width: 1px; height: 20px; background: #e3e7e0; }
    .p2-ac { font-size: .76rem; font-weight: 600; padding: .4rem .7rem; border-radius: .4rem;
             border: 1px solid #e3e7e0; background: #f8f9f7; color: #1f2937; cursor: pointer; white-space: nowrap; }
    .p2-ac:hover { border-color: #9ca3af; }
    .p2-ac.go { background: #15803d; border-color: #15803d; color: #fff; }
    .p2-ac.meli { border-color: #b45309; color: #b45309; background: #fef0d8; }
    .p2-ac[disabled] { opacity: .5; cursor: default; }
    .p2-ac-obj { display: inline-flex; align-items: center; gap: .2rem; border: 1px solid #e3e7e0;
                 border-radius: .4rem; padding: .15rem .4rem; background: #fff; }
    .p2-ac-obj input { width: 46px; border: none; outline: none; font-size: .8rem; font-weight: 700; text-align: right; }
    .p2-res { max-height: 130px; overflow: auto; background: #f8f9f7; border: 1px solid #e3e7e0;
              border-radius: .4rem; padding: .4rem .6rem; font-size: .7rem; margin-top: .4rem; width: 100%; }
    .p2-res .fila { padding: .1rem 0; border-bottom: 1px solid #eef1ec; }
    .p2-res .fila:last-child { border-bottom: none; }
    .p2-res .no { color: #b91c1c; }

    .p2-empty { padding: 2rem; text-align: center; color: #9ca3af; font-size: .85rem; }
    .p2-note { font-size: .7rem; color: #6b7280; background: #eef2ff; border-left: 3px solid #4f46e5;
               padding: .5rem .7rem; border-radius: 0 .4rem .4rem 0; }

    @@media (max-width: 1100px) {
        .p2-th, .p2-tr { grid-template-columns: 30px minmax(0,1fr) 120px 140px 112px; }
        .p2-h2 { display: none; }
    }
    @@media (max-width: 760px) {
        .p2-th, .p2-tr { grid-template-columns: 28px minmax(0,1fr) 130px; }
        .p2-h { display: none; }
    }
</style>

<div class="p2-full">

    <div class="p2-bar">
        <span class="ttl">🏷️ Publicaciones <small>@(datos?.Total.ToString("N0", ar) ?? "…") publicaciones</small></span>
        <span class="acts">
            <button class="p2-btn go" @onclick="Cargar" disabled="@cargando">
                @(cargando ? "⏳ Cargando…" : "🔄 Actualizar lista")
            </button>
            <button class="p2-btn" @onclick='() => Nav.NavigateTo("/publicaciones")'>⛶ Volver a la pantalla de siempre</button>
        </span>
    </div>

    <div class="p2-body">

        <div class="p2-note">
            <b>Pantalla nueva — etapa 1.</b> Por ahora es solo para mirar: no toca precios, stock ni nada en MercadoLibre.
            La pantalla de siempre sigue funcionando igual.
        </div>

        <div class="p2-search">
            <input placeholder="Buscar por título, ID o N° de publicación (MLA)…" @bind="fTexto" @bind:event="oninput" @onkeyup="OnEnter" />
            <input placeholder="SKU" style="max-width:170px;" @bind="fSku" @bind:event="oninput" @onkeyup="OnEnter" />
            <button class="p2-btn" style="background:#1f6b45;border-color:#1f6b45;" @onclick="BuscarDesdeCero">Buscar</button>
        </div>

        <div class="p2-filters">
            <span class="p2-lbl">Filtros</span>
            <span class="p2-chip @(fEstado == "" ? "on" : "")" @onclick='() => SetEstado("")'>Todas</span>
            <span class="p2-chip @(fEstado == "activas" ? "on" : "")" @onclick='() => SetEstado("activas")'>Activas</span>
            <span class="p2-chip @(fEstado == "pausadas" ? "on" : "")" @onclick='() => SetEstado("pausadas")'>Pausadas</span>

            <span class="p2-chip nue @(fNoLlegan == 50 ? "on" : "")" @onclick="() => SetNoLlegan(50)" style="border-width:2px;">⚠ No llegan al 50%</span>
            <span class="p2-chip nue @(fNoLlegan == 30 ? "on" : "")" @onclick="() => SetNoLlegan(30)">…al 30%</span>
            <span class="p2-chip nue @(fNoLlegan == 70 ? "on" : "")" @onclick="() => SetNoLlegan(70)">…al 70%</span>
            <span class="p2-chip nue @(fComision == 30 ? "on" : "")" @onclick="() => SetComision(30)">MeLi se lleva más de 30%</span>
            <span class="p2-chip nue @(fComision == 40 ? "on" : "")" @onclick="() => SetComision(40)">…más de 40%</span>
            <span class="p2-chip nue @(fVariosPrecios ? "on" : "")" @onclick="ToggleVarios">Varios precios en la familia</span>
            <span class="p2-chip nue @(fPrecioAMano ? "on" : "")" @onclick="TogglePrecioMano">Precio a mano</span>
            <span class="p2-chip nue @(fSinCosto ? "on" : "")" @onclick="ToggleSinCosto">Sin costo cargado</span>
            <span class="p2-chip nue @(fComisionVieja ? "on" : "")" @onclick="ToggleComisionVieja">⚠ Con datos viejos</span>
            <span class="p2-chip nue @(fCuotas == "12x_campaign" ? "on" : "")" @onclick='() => SetCuotas("12x_campaign")'>Cuotas: 12x</span>
            <span class="p2-chip nue @(fCuotas == "sin" ? "on" : "")" @onclick='() => SetCuotas("sin")'>Sin cuotas</span>
            @if (HayFiltros)
            {
                <span class="p2-chip" style="border-color:#b91c1c;color:#b91c1c;" @onclick="LimpiarFiltros">✕ Limpiar</span>
            }
        </div>

        <div class="p2-count">
            <span>
                @if (datos is not null)
                {
                    <text>Mostrando <b>@datos.Items.Count</b> de <b>@datos.Total.ToString("N0", ar)</b> publicaciones</text>
                }
            </span>
            <span>
                <button class="p2-pg" @onclick="() => IrAPagina(pagina - 1)" disabled="@(pagina <= 1 || cargando)">◀</button>
                <span class="p2-pg">Página @pagina de @TotalPaginas</span>
                <button class="p2-pg" @onclick="() => IrAPagina(pagina + 1)" disabled="@(pagina >= TotalPaginas || cargando)">▶</button>
                <select class="p2-pg" @onchange="CambiarPorPagina" style="cursor:pointer;">
                    <option value="50" selected="@(porPagina == 50)">50 por página</option>
                    <option value="100" selected="@(porPagina == 100)">100 por página</option>
                    <option value="200" selected="@(porPagina == 200)">200 por página</option>
                </select>
            </span>
        </div>

        <div class="p2-tbl">
            <div class="p2-th">
                <span><input type="checkbox" class="p2-chk" checked="@TodasTildadas" @onchange="TildarTodas" title="Tildar todas las de esta página" /></span>
                <span>Producto</span>
                <span class="p2-h">Precio</span>
                <span class="p2-h">Te queda<br /><span style="text-transform:none;font-weight:400;">sobre el costo</span></span>
                <span class="p2-h">Se lleva MeLi<br /><span style="text-transform:none;font-weight:400;">comisión + envío</span></span>
                <span class="p2-h2">Objetivo · Sincro</span>
                <span class="p2-h2">Stock</span>
                <span class="p2-h2">Estado</span>
            </div>

            @if (cargando)
            {
                <div class="p2-empty">⏳ Buscando…</div>
            }
            else if (datos is null || datos.Items.Count == 0)
            {
                <div class="p2-empty">No hay publicaciones con esos filtros.</div>
            }
            else
            {
                @foreach (var it in datos.Items)
                {
                    <div class="p2-tr @(tildadas.Contains(it.MeliItemId) ? "sel" : "")"
                         @onclick="() => ToggleMedidas(it.MeliItemId)" style="cursor:pointer;">
                        <span @onclick:stopPropagation="true">
                            <input type="checkbox" class="p2-chk"
                                   checked="@tildadas.Contains(it.MeliItemId)"
                                   @onchange="() => ToggleTildada(it.MeliItemId)" />
                        </span>

                        <span class="p2-pinfo">
                            @if (!string.IsNullOrEmpty(it.Thumbnail))
                            {
                                <img class="p2-thumb" src="@it.Thumbnail" alt="" loading="lazy"
                                     style="float:left; margin-right:.5rem;" />
                            }
                            <span class="p2-t" title="@it.Titulo">@it.Titulo</span>
                            <span class="p2-m">@it.Sku · @it.MeliItemId@(it.PublisFamilia > 1 ? $" · {it.PublisFamilia} publicaciones" : "") · @CuotasTexto(it.Cuotas, it.Tipo)</span>
                            <span class="p2-rec">@RecetaFragment(it)</span>
                        </span>

                        <span class="p2-h">
                            @if (it.VariosPrecios && it.PrecioMin.HasValue && it.PrecioMax.HasValue)
                            {
                                <span class="p2-rango">@Plata(it.PrecioMin.Value) – @Plata(it.PrecioMax.Value)</span>
                                <span class="p2-flag">⚠ precios distintos</span>
                            }
                            else
                            {
                                <span class="p2-price">@Plata(it.Precio)</span>
                            }
                        </span>

                        <span class="p2-queda p2-h">
                            @if (it.MargenPct.HasValue)
                            {
                                var m = it.MargenPct.Value;
                                var objetivo = it.ObjetivoPct ?? 50m;
                                var llega = m >= objetivo;
                                <span class="pct @(llega ? "" : m >= objetivo * 0.6m ? "tibio" : "malo")" style="@(it.ComisionVieja ? "opacity:.55;" : "")">@m.ToString("0.#", ar)%</span>
                                <span class="ver @(llega ? "ok" : "no")">@(llega ? "✓ estás arriba" : "✗ abajo") del @objetivo.ToString("0", ar)%</span>
                                <span class="det">@Plata(it.GananciaPesos ?? 0) · costo @Plata(it.Costo ?? 0)</span>
                                @if (!llega && it.Costo is > 0)
                                {
                                    <span class="falta">faltan @Plata(Math.Round(it.Costo.Value * objetivo / 100m - (it.GananciaPesos ?? 0m), 0))</span>
                                }
                            }
                            else
                            {
                                <span class="det" style="color:#b91c1c;font-weight:700;">falta cargar el costo</span>
                            }
                        </span>

                        <span class="p2-com p2-h">
                            @if (it.ComisionPct.HasValue)
                            {
                                var c = it.ComisionPct.Value;
                                var clase = c >= 40 ? "hi" : c >= 25 ? "mid" : "";
                                <span class="big @clase">@c.ToString("0.#", ar)%</span>
                                <span class="des">@DesgloseComision(it)</span>
                                @if (it.ComisionVieja)
                                {
                                    <span class="viejo" title="La comisión se calculó con otro precio. El margen de esta fila puede estar mal.">⚠ dato viejo</span>
                                }
                                <span class="bar"><i class="@clase" style="width:@(Math.Min(100, (double)c * 2).ToString("0", System.Globalization.CultureInfo.InvariantCulture))%"></i></span>
                            }
                            else
                            {
                                <span class="des">sin datos — actualizá comisiones</span>
                            }
                        </span>

                        <span class="p2-ctrl p2-h2">
                            <span class="p2-obj" title="Objetivo de ganancia sobre el costo">
                                🎯 @(it.ObjetivoPct.HasValue ? it.ObjetivoPct.Value.ToString("0", ar) : "—")<span class="pc">%</span>
                            </span>
                            <span class="p2-sw" title="@(it.SyncPrecio ? "Precio sincronizado: el sistema lo mantiene" : "Precio a mano: el sistema no lo toca")">
                                💲<span class="p2-led @(it.SyncPrecio ? "on" : "")"></span>
                            </span>
                            <span class="p2-sw" title="@(it.SyncStock ? "Stock sincronizado: se pushea solo" : "Stock a mano")">
                                📦<span class="p2-led @(it.SyncStock ? "on" : "")"></span>
                            </span>
                        </span>

                        <span class="p2-stk p2-h2 @(it.StockMeli == 0 ? "zero" : "")">
                            @it.StockMeli<small>@(it.StockMeli == 0 ? "SIN STOCK" : "UNID.")</small>
                        </span>

                        <span class="p2-h2">
                            <span class="p2-st @(it.Estado == "active" ? "a" : it.Estado == "paused" ? "p" : "o")">@EstadoTexto(it.Estado)</span>
                        </span>
                    </div>

                    @if (medidasAbiertas == it.MeliItemId)
                    {
                        <div class="p2-med" @onclick:stopPropagation="true">
                            <h4>📦 Peso y medidas del paquete — de acá sale el envío</h4>
                            @if (medidasCargando)
                            {
                                <span class="nota">Consultando a MercadoLibre…</span>
                            }
                            else if (medidas is null)
                            {
                                <span class="aviso err">No se pudieron leer las medidas.</span>
                            }
                            else
                            {
                                <div class="campos">
                                    <span class="campo"><label>Peso (gramos)</label>
                                        <input type="number" @bind="edPeso" placeholder="—" /></span>
                                    <span class="campo"><label>Largo (cm)</label>
                                        <input type="number" @bind="edLargo" placeholder="—" /></span>
                                    <span class="campo"><label>Ancho (cm)</label>
                                        <input type="number" @bind="edAncho" placeholder="—" /></span>
                                    <span class="campo"><label>Alto (cm)</label>
                                        <input type="number" @bind="edAlto" placeholder="—" /></span>
                                    <span class="envio">
                                        <b>@(medidas.EnvioActual.HasValue ? Plata(medidas.EnvioActual.Value) : "—")</b>
                                        <span>envío que pagás hoy</span>
                                    </span>
                                    <button class="guardar" @onclick="() => GuardarMedidas(it.MeliItemId)" disabled="@medidasGuardando">
                                        @(medidasGuardando ? "Guardando…" : "✓ Guardar en MeLi")
                                    </button>
                                </div>

                                @if (medidas.PesoVolumetricoKg.HasValue)
                                {
                                    <div class="nota">
                                        Volumen @medidas.VolumenCm3!.Value.ToString("N0", ar) cm³ ·
                                        peso volumétrico <b>@medidas.PesoVolumetricoKg.Value.ToString("0.##", ar) kg</b>
                                        — MeLi cobra por el que sea mayor: el peso real o el volumétrico.
                                    </div>
                                }
                                @if (!string.IsNullOrEmpty(medidas.Mensaje))
                                {
                                    <div class="aviso">@medidas.Mensaje</div>
                                }
                                @if (!string.IsNullOrEmpty(medidasResultado))
                                {
                                    <div class="aviso @(medidasResultadoOk ? "ok" : "err")">@medidasResultado</div>
                                }
                            }
                        </div>
                    }
                }
            }
        </div>

        @if (tildadas.Count > 0)
        {
            <div class="p2-acciones">
                <span class="cnt">@tildadas.Count @(tildadas.Count == 1 ? "publicación tildada" : "publicaciones tildadas")</span>
                <span class="sep"></span>

                <button class="p2-ac go" @onclick="AccComisiones" disabled="@accionEnCurso">💰 Actualizar comisiones</button>

                <span class="p2-ac-obj" title="Objetivo de ganancia sobre el costo">
                    🎯 <input type="number" @bind="objetivoLote" /> %
                </span>
                <button class="p2-ac" @onclick="() => AccObjetivo(false)" disabled="@accionEnCurso">Guardar objetivo</button>

                <button class="p2-ac" @onclick="() => AccSincro(true, null)" disabled="@accionEnCurso">💲 Prender precio</button>
                <button class="p2-ac" @onclick="() => AccSincro(false, null)" disabled="@accionEnCurso">💲 Apagar precio</button>
                <button class="p2-ac" @onclick="() => AccSincro(null, true)" disabled="@accionEnCurso">📦 Prender stock</button>

                <span class="sep"></span>
                <button class="p2-ac meli" @onclick="() => AccObjetivo(true)" disabled="@accionEnCurso">🎯 Aplicar objetivo y publicar</button>
                <button class="p2-ac meli" @onclick="AccPrecio" disabled="@accionEnCurso">💵 Publicar precio</button>
                <button class="p2-ac meli" @onclick="AccStock" disabled="@accionEnCurso">📦 Mandar stock</button>

                <button class="p2-ac" @onclick="() => { tildadas.Clear(); resultado = null; }" disabled="@accionEnCurso">✕ Limpiar</button>

                @if (accionEnCurso)
                {
                    <span class="cnt">⏳ @accionTexto</span>
                }
                @if (resultado is not null)
                {
                    <div class="p2-res">
                        <b>@resultado.Ok ok · @resultado.Errores con error</b>
                        @foreach (var f in resultado.Detalle.Take(40))
                        {
                            <div class="fila @(f.Ok ? "" : "no")">@(f.Ok ? "✓" : "✗") @f.MeliItemId — @f.Mensaje</div>
                        }
                    </div>
                }
            </div>
        }

        @if (datos is not null && datos.Items.Count > 0)
        {
            <div class="p2-count">
                <span>Etapa 1: mirar. Las acciones (cambiar precios, mandar stock, fotos) vienen en la etapa 2.</span>
                <span>
                    <button class="p2-pg" @onclick="() => IrAPagina(pagina - 1)" disabled="@(pagina <= 1 || cargando)">◀</button>
                    <span class="p2-pg">Página @pagina de @TotalPaginas</span>
                    <button class="p2-pg" @onclick="() => IrAPagina(pagina + 1)" disabled="@(pagina >= TotalPaginas || cargando)">▶</button>
                </span>
            </div>
        }

    </div>
</div>

@code {
    private static readonly System.Globalization.CultureInfo ar = new("es-AR");

    private ApiClient.PubV2Page? datos;
    private bool cargando;
    private int pagina = 1;
    private int porPagina = 50;   // 2026-08-26: pedido de Osmar, arranca en 50

    private string fTexto = "";
    private string fSku = "";
    private string fEstado = "";
    private decimal? fComision;
    private string fCuotas = "";
    private bool fVariosPrecios;
    private bool fPrecioAMano;
    private bool fSinCosto;
    private decimal? fNoLlegan;

    // Panel de medidas (peso y dimensiones): es lo que define el envío que cobra MeLi.
    // Etapa 2: lo tildado y las acciones
    private readonly HashSet<string> tildadas = new();
    private bool accionEnCurso;
    private string accionTexto = "";
    private ApiClient.PubV2AccionResultado? resultado;
    private decimal objetivoLote = 50;

    private bool TodasTildadas => datos is not null && datos.Items.Count > 0
                                  && datos.Items.All(i => tildadas.Contains(i.MeliItemId));

    private string? medidasAbiertas;
    private ApiClient.PubV2Medidas? medidas;
    private bool medidasCargando, medidasGuardando, medidasResultadoOk;
    private string? medidasResultado;
    private int? edPeso;
    private decimal? edLargo, edAncho, edAlto;
    private bool fComisionVieja;

    private bool HayFiltros => fComisionVieja || fNoLlegan.HasValue || fComision.HasValue || fVariosPrecios || fPrecioAMano || fSinCosto
                               || !string.IsNullOrEmpty(fCuotas) || !string.IsNullOrEmpty(fEstado)
                               || !string.IsNullOrWhiteSpace(fTexto) || !string.IsNullOrWhiteSpace(fSku);

    private int TotalPaginas => datos is null || datos.Total == 0 ? 1 : (int)Math.Ceiling(datos.Total / (double)datos.PorPagina);

    protected override async Task OnInitializedAsync() => await Cargar();

    private async Task Cargar()
    {
        cargando = true;
        StateHasChanged();
        try
        {
            datos = await Api.GetPublicacionesV2Async(fTexto, fSku, fEstado, fComision, fCuotas, null,
                fVariosPrecios, fPrecioAMano, fSinCosto, fNoLlegan, fComisionVieja, pagina, porPagina);
        }
        catch (Exception ex)
        {
            ToastService.Error("No se pudo cargar: " + ex.Message);
        }
        finally
        {
            cargando = false;
            StateHasChanged();
        }
    }

    private async Task CambiarPorPagina(ChangeEventArgs e)
    {
        if (int.TryParse(e.Value?.ToString(), out var n) && n > 0) porPagina = n;
        pagina = 1;
        await Cargar();
    }

    private async Task BuscarDesdeCero() { pagina = 1; await Cargar(); }
    private async Task OnEnter(KeyboardEventArgs e) { if (e.Key == "Enter") await BuscarDesdeCero(); }
    private async Task IrAPagina(int p) { if (p < 1 || p > TotalPaginas) return; pagina = p; await Cargar(); }
    private async Task SetEstado(string v) { fEstado = v; await BuscarDesdeCero(); }
    private void ToggleTildada(string mla)
    {
        if (!tildadas.Remove(mla)) tildadas.Add(mla);
        resultado = null;
    }

    private void TildarTodas(ChangeEventArgs e)
    {
        if (datos is null) return;
        var prender = e.Value is bool b && b;
        foreach (var i in datos.Items)
        {
            if (prender) tildadas.Add(i.MeliItemId);
            else tildadas.Remove(i.MeliItemId);
        }
        resultado = null;
    }

    /// <summary>Envoltorio común: muestra "en curso", corre la acción y recarga la lista.</summary>
    private async Task Correr(string texto, Func<List<string>, Task<ApiClient.PubV2AccionResultado?>> accion,
        bool pedirConfirmacion = false, string? confirmacion = null)
    {
        var lista = tildadas.ToList();
        if (lista.Count == 0) return;

        if (pedirConfirmacion)
        {
            var ok = await JS.InvokeAsync<bool>("confirm", confirmacion ?? $"Esto cambia {lista.Count} publicaciones en MercadoLibre. ¿Seguro?");
            if (!ok) return;
        }

        accionEnCurso = true;
        accionTexto = texto;
        resultado = null;
        StateHasChanged();
        try
        {
            resultado = await accion(lista);
            if (resultado is null) ToastService.Error("No se pudo completar la acción.");
            else
            {
                if (resultado.Errores == 0) ToastService.Success($"{resultado.Ok} listas.");
                else ToastService.Warning($"{resultado.Ok} ok, {resultado.Errores} con error — mirá el detalle.");
                await Cargar();
            }
        }
        catch (Exception ex) { ToastService.Error("Error: " + ex.Message); }
        finally { accionEnCurso = false; StateHasChanged(); }
    }

    private Task AccComisiones() => Correr("actualizando comisiones…", l => Api.AccionComisionesAsync(l));

    private Task AccSincro(bool? precio, bool? stock)
        => Correr("guardando…", l => Api.AccionSincroAsync(l, precio, stock));

    private Task AccObjetivo(bool aplicarAhora)
        => Correr(aplicarAhora ? "aplicando objetivo y publicando…" : "guardando objetivo…",
            l => Api.AccionObjetivoAsync(l, objetivoLote, aplicarAhora),
            aplicarAhora,
            $"Esto va a CAMBIAR EL PRECIO en MercadoLibre de {tildadas.Count} publicaciones para dejar {objetivoLote:0.#}% sobre el costo. ¿Seguro?");

    private Task AccPrecio()
        => Correr("publicando precios…", l => Api.AccionPrecioAsync(l), true,
            $"Esto va a publicar en MercadoLibre el precio que calcula el sistema para {tildadas.Count} publicaciones. ¿Seguro?");

    private Task AccStock()
        => Correr("mandando stock…", l => Api.AccionStockAsync(l), true,
            $"Esto manda el stock del sistema a MercadoLibre en {tildadas.Count} publicaciones. Las que queden en 0 MeLi las pausa. ¿Seguro?");

    private async Task ToggleMedidas(string mla)
    {
        if (medidasAbiertas == mla) { medidasAbiertas = null; medidas = null; return; }
        medidasAbiertas = mla;
        medidas = null;
        medidasResultado = null;
        medidasCargando = true;
        StateHasChanged();
        try
        {
            medidas = await Api.GetMedidasAsync(mla);
            edPeso = medidas?.PesoGramos;
            edLargo = medidas?.LargoCm;
            edAncho = medidas?.AnchoCm;
            edAlto = medidas?.AltoCm;
        }
        catch (Exception ex) { ToastService.Error("No se pudieron leer las medidas: " + ex.Message); }
        finally { medidasCargando = false; StateHasChanged(); }
    }

    private async Task GuardarMedidas(string mla)
    {
        medidasGuardando = true;
        medidasResultado = null;
        StateHasChanged();
        try
        {
            var (res, err) = await Api.GuardarMedidasAsync(mla, edPeso, edLargo, edAncho, edAlto);
            if (res is not null && res.Ok)
            {
                medidasResultadoOk = true;
                medidasResultado = res.Mensaje;
                medidas = res.Medidas ?? medidas;
                ToastService.Success(res.Mensaje);
                await Cargar();   // el margen de la fila cambia si el envío cambió
            }
            else
            {
                medidasResultadoOk = false;
                medidasResultado = res?.Mensaje ?? err ?? "No se pudo guardar";
                ToastService.Error(medidasResultado);
            }
        }
        catch (Exception ex)
        {
            medidasResultadoOk = false;
            medidasResultado = "Error: " + ex.Message;
        }
        finally { medidasGuardando = false; StateHasChanged(); }
    }

    private async Task SetNoLlegan(decimal v) { fNoLlegan = fNoLlegan == v ? null : v; await BuscarDesdeCero(); }
    private async Task SetComision(decimal v) { fComision = fComision == v ? null : v; await BuscarDesdeCero(); }
    private async Task SetCuotas(string v) { fCuotas = fCuotas == v ? "" : v; await BuscarDesdeCero(); }
    private async Task ToggleVarios() { fVariosPrecios = !fVariosPrecios; await BuscarDesdeCero(); }
    private async Task TogglePrecioMano() { fPrecioAMano = !fPrecioAMano; await BuscarDesdeCero(); }
    private async Task ToggleComisionVieja() { fComisionVieja = !fComisionVieja; await BuscarDesdeCero(); }
    private async Task ToggleSinCosto() { fSinCosto = !fSinCosto; await BuscarDesdeCero(); }

    private async Task LimpiarFiltros()
    {
        fTexto = ""; fSku = ""; fEstado = ""; fComision = null; fCuotas = "";
        fVariosPrecios = false; fPrecioAMano = false; fSinCosto = false; fNoLlegan = null; fComisionVieja = false;
        await BuscarDesdeCero();
    }

    private string Plata(decimal v) => "$" + v.ToString("N0", ar);

    private string EstadoTexto(string? s) => s switch
    {
        "active" => "Activa",
        "paused" => "Pausada",
        "under_review" => "En revisión",
        _ => s ?? "—"
    };

    private string CuotasTexto(string? tag, string? tipo)
    {
        var t = string.Equals(tipo, "gold_pro", StringComparison.OrdinalIgnoreCase) ? "Premium" : "Clásica";
        var c = tag switch
        {
            null or "" => "sin cuotas",
            "3x_campaign" => "3 cuotas",
            "6x_campaign" => "6 cuotas",
            "9x_campaign" => "9 cuotas",
            "12x_campaign" => "12 cuotas",
            "pcj-co-funded" => "cuotas co-fundadas",
            _ => tag
        };
        return $"{t} · {c}";
    }

    private string DesgloseComision(ApiClient.PubV2Fila it)
    {
        var partes = new List<string>();
        if (it.ComisionPorcentaje is > 0) partes.Add($"{it.ComisionPorcentaje.Value.ToString("0.#", ar)}%");
        if (it.ComisionFija is > 0) partes.Add($"+ ${it.ComisionFija.Value.ToString("N0", ar)} fijo");
        if (it.ComisionEnvio is > 0) partes.Add($"+ ${it.ComisionEnvio.Value.ToString("N0", ar)} de ENVÍO");
        return partes.Count > 0 ? string.Join(" ", partes) : "—";
    }

    /// <summary>El renglón gris: de qué se compone y para cuántas alcanza. El que frena va en rojo.</summary>
    private MarkupString RecetaFragment(ApiClient.PubV2Fila it)
    {
        if (it.Receta is null || it.Receta.Count == 0)
            return new MarkupString("<span style='color:#b91c1c'>⚠ sin producto del sistema vinculado</span>");

        var partes = it.Receta.Select(c =>
        {
            var cant = c.Cantidad == 1m ? "" : $"{c.Cantidad.ToString("0.##", ar)}× ";
            var txt = $"{cant}<b>{System.Net.WebUtility.HtmlEncode(c.Sku ?? "?")}</b> ({c.Stock})";
            return c.Frena && it.Receta.Count > 1 ? $"<span class='frena'>{txt}</span>" : txt;
        });

        var cola = it.Receta.Count > 1 || (it.Receta.Count == 1 && it.Receta[0].Cantidad != 1m)
            ? $" → <span class='arma'>arma {it.Arma ?? 0}</span>"
            : $" · stock <b>{it.Arma ?? 0}</b>";

        return new MarkupString("🧩 " + string.Join(" + ", partes) + cola);
    }
}
