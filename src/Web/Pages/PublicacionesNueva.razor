                            {
                                @* Si no se pudo leer, no se ofrece escribir: guardar encima de algo que no vimos pisaría la descripción. *@
                                <div class="aviso">@descDatos.Aviso</div>
                            }
                            else
                            {
                                @if (!descDatos.TieneDescripcion)
