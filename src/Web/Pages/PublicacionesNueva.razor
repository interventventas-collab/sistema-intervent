    /// <summary>OEM (o cualquier precio fijo): lo publica y queda fijo.</summary>
    private async Task ElegirPrecioFijo(ApiClient.PubV2Fila it, decimal precio, string etiqueta)
    {
        if (precioGuardando) return;
        if (precio == it.Precio)
        {
            if (MandaElPorcentaje(it)) await ElegirActual(it);
            else ToastService.Info($"Ya está en {Plata(precio)}.");
            return;
        }
        if (!await SeguirAunqueEsteEnPromo(it, precio)) return;
        var aviso = $"¿Publicar {Plata(precio)} ({etiqueta}) en MercadoLibre?\n\nHoy está {Plata(it.Precio)}.\n\nQueda FIJO: el sistema no lo toca.";
        if (MandaElPorcentaje(it)) aviso += $" Deja de mantener el {it.ObjetivoPct:0}%.";
        if (!await JS.InvokeAsync<bool>("confirm", aviso)) return;

        precioGuardando = true;
        StateHasChanged();
        try
        {
            var (res, err) = await Api.PonerPrecioV2Async(it.MeliItemId, precio, true);
            if (res?.Ok == true) { ToastService.Success(res.Mensaje); await RefrescarFilaDespuesDePublicar(it.MeliItemId); }
            else ToastService.Error(res?.Mensaje ?? err ?? "No se pudo publicar el precio");
        }
        catch (Exception ex) { ToastService.Error("Error: " + ex.Message); }
        finally { precioGuardando = false; StateHasChanged(); }
    }

    /// <summary>Dejar fijo el precio de hoy: apaga el sincro de precio (no toca MeLi).</summary>
    private async Task ElegirActual(ApiClient.PubV2Fila it)
    {
        if (!MandaElPorcentaje(it) || precioGuardando) return;   // ya está fijo
        if (!await JS.InvokeAsync<bool>("confirm",
                $"¿Dejar FIJO el precio de hoy, {Plata(it.Precio)}?\n\nEl sistema deja de mantener el {it.ObjetivoPct:0}% y no lo toca más.\n(No se cambia nada en MercadoLibre.)"))
            return;
        await CambiarSincroFila(it, false, null);
    }

    // ─── 2026-09-22 · "Mantener el N%": el casillero arranca con el % que deja el precio de hoy ───
    private readonly Dictionary<string, string> pctEscritos = new();

    private string PctEscrito(ApiClient.PubV2Fila it)
    {
        if (pctEscritos.TryGetValue(it.MeliItemId, out var t)) return t;
        // Si hoy pierde plata o deja casi nada, arrancar en ese número no sirve: va el objetivo (o 50).
        var v = MandaElPorcentaje(it) ? it.ObjetivoPct
              : (it.MargenPct is > 0 ? it.MargenPct : (it.ObjetivoPct ?? 50m));
        return (v ?? 50m).ToString("0.#", ar);
    }

    private decimal? ParsePct(string? t)
    {
        var v = (t ?? "").Replace("%", "").Trim().Replace(",", ".");
        return decimal.TryParse(v, System.Globalization.NumberStyles.Number, System.Globalization.CultureInfo.InvariantCulture, out var d)
               && d > 0 && d <= 500 ? Math.Round(d, 1) : null;
    }

    /// <summary>Qué % dejaría a otro precio, con la comisión guardada (aproximado: el cargo fijo y
    /// el envío pueden cambiar con el precio). Misma cuenta que la fila.</summary>
    private decimal? MargenA(ApiClient.PubV2Fila it, decimal precio)
    {
        if (it.Costo is not > 0 || it.ComisionMonto is null || precio <= 0) return null;
        var com = precio * ((it.ComisionPorcentaje ?? 0m) / 100m) + (it.ComisionFija ?? 0m);
        var neto = (precio - com - (it.ComisionEnvio ?? 0m)) / 1.21m;
        return Math.Round((neto - it.Costo.Value) / it.Costo.Value * 100m, 1);
    }

    /// <summary>Precio aproximado para dejar `pct`%, nunca abajo del OEM (como el motor).</summary>
    private decimal? PrecioParaPct(ApiClient.PubV2Fila it, decimal pct)
    {
        if (it.Costo is not > 0 || it.ComisionMonto is null) return null;
        var p = (it.ComisionPorcentaje ?? 0m) / 100m;
        if (p >= 0.95m) return null;
        var precio = (it.Costo.Value * (1 + pct / 100m) * 1.21m + (it.ComisionFija ?? 0m) + (it.ComisionEnvio ?? 0m)) / (1 - p);
        if (it.PrecioOem is decimal oem && oem >= precio) return oem;   // el piso OEM va tal cual
        // Mismo redondeo que el motor: sube hasta terminar en 99 ($44.175,94 → $44.199).
        var r99 = Math.Floor(precio / 100m) * 100m + 99m;
        return r99 >= precio ? r99 : r99 + 100m;
    }

    /// <summary>2026-09-23 — Osmar: "pediste 71,6 y dice 73,8, ¿por qué?". Con "Mantener el %"
    /// marcado, el motivo real de la diferencia (los casos abajo por más de 2 y OEM se dicen aparte).
    /// Redondeo: el precio sube hasta terminar en 99, o sea hasta $100; si al precio $100 más bajo
    /// ya quedaba en lo pedido, la diferencia es del redondeo. Null = no hay diferencia que explicar.</summary>
    private string? MotivoDiferencia(ApiClient.PubV2Fila it, decimal objRef)
    {
        if (it.MargenPct is not decimal real || Math.Abs(real - objRef) < 0.1m) return null;
        if (real < objRef)
            return $"se corrige sola si baja de {(objRef - 2m).ToString("0.#", ar)}%";
        if (Math.Round(it.Precio, 0) % 100m == 99m && MargenA(it, it.Precio - 100m) is decimal sinRedondeo
            && sinRedondeo <= objRef + 0.2m)
            return $"deja más por redondear a {Plata(it.Precio)}";
        return "deja más: bajó el costo o lo que cobra MeLi";
    }

    private static string ClasePct(decimal? m, decimal objetivo)
        => m is not decimal v ? "" : v >= objetivo ? "" : v >= objetivo * 0.6m ? "tibio" : "malo";

    private string TextoPct(decimal? m, bool aprox)
        => m is decimal v ? (aprox ? "≈ " : "") + v.ToString("0.#", ar) + "%" : "";

    /// <summary>Mantener el % del casillero: guarda el objetivo y aplica el precio ahora.</summary>
    private async Task ElegirObjetivo(ApiClient.PubV2Fila it) => await ElegirObjetivo(it, false);

    private async Task ElegirObjetivo(ApiClient.PubV2Fila it, bool reaplicar)
    {
        if (precioGuardando) return;
        var obj = ParsePct(PctEscrito(it));
        if (obj is null) { ToastService.Error("Escribí un porcentaje válido (por ejemplo 58,1)."); return; }
        if (!reaplicar && MandaElPorcentaje(it) && it.ObjetivoPct == obj) return;   // ya mantiene ese %
        var aprox = PrecioParaPct(it, obj.Value) ?? it.Precio;
        if (!await SeguirAunqueEsteEnPromo(it, aprox)) return;
        if (!await JS.InvokeAsync<bool>("confirm",
                $"¿Que el sistema mantenga el {obj.Value.ToString("0.#", ar)}%?\n\nHoy está {Plata(it.Precio)}. Queda alrededor de {Plata(aprox)}: el número exacto lo calcula ahora con lo que cobra MercadoLibre, y nunca baja del precio OEM.\n\n"
                + "Desde ahí lo revisa todos los días y lo corrige si se corre del %, salvo cuando está en promoción. Se publica en MercadoLibre ahora."))
            return;

        precioGuardando = true;
        StateHasChanged();
        try
        {
            var r = await Api.AccionObjetivoAsync(new List<string> { it.MeliItemId }, obj.Value, true);
            var fila = r?.Detalle.FirstOrDefault();
            if (r is not null && r.Ok > 0) ToastService.Success("Listo: " + (fila?.Mensaje ?? $"mantiene el {obj:0.#}%"));
            else ToastService.Error("No se pudo: " + (fila?.Mensaje ?? "error"));
            pctEscritos.Remove(it.MeliItemId);
            await RefrescarFilaDespuesDePublicar(it.MeliItemId);
        }
        catch (Exception ex) { ToastService.Error("Error: " + ex.Message); }
        finally { precioGuardando = false; StateHasChanged(); }
    }

    private void EmpezarPrecio(ApiClient.PubV2Fila it)
    {
        // 2026-08-31 — Si está en una campaña, el número que muestra el simulador NO es lo que
        // pasaría de verdad: el simulador calcula sobre el precio de lista y acá hay un descuento
        // encima. Y, según MercadoLibre, tocar el precio TUMBA el descuento. Se avisa antes de
        // que escriba, no después de que lo publique.
        if (it.PromoPrecio is > 0)
            ToastService.Info($"Ojo: esta publicación está en «{it.PromoNombre}» y se vende a {Plata(it.PromoPrecio.Value)}. "
                            + "Si le cambiás el precio, MercadoLibre le saca el descuento.");

        editandoPrecio = it.MeliItemId;
        precioEscrito = it.Precio.ToString("0.##", System.Globalization.CultureInfo.InvariantCulture);
        simulacion = null;
        simulando = false;
    }

    private void CancelarPrecio()
    {
        simCts?.Cancel();
        editandoPrecio = null;
        precioEscrito = "";
        simulacion = null;
        simulando = false;
    }

    /// <summary>Se dispara mientras escribe. Espera 600 ms de quietud para no bombardear a MeLi
    /// con una consulta por tecla.</summary>
    private async Task PrecioEscritoCambio()
    {
        simCts?.Cancel();
        var cts = new CancellationTokenSource();
        simCts = cts;
        var mla = editandoPrecio;
        if (mla is null) return;

        if (!TryPrecio(precioEscrito, out var precio) || precio <= 0)
        {
            simulacion = null; simulando = false; StateHasChanged(); return;
        }

        simulando = true;
        StateHasChanged();
        try
        {
            await Task.Delay(600, cts.Token);
            var r = await Api.SimularPrecioV2Async(mla, precio);
            if (cts.Token.IsCancellationRequested || editandoPrecio != mla) return;
            simulacion = r;
        }
        catch (TaskCanceledException) { return; }
        catch (Exception ex) { ToastService.Error("No se pudo calcular: " + ex.Message); }
        finally
        {
            if (!cts.Token.IsCancellationRequested) { simulando = false; StateHasChanged(); }
        }
    }

    /// <summary>Acepta "33500", "33.500", "33500,50" — lo que salga de teclear con costumbre argentina.</summary>
    private static bool TryPrecio(string texto, out decimal precio)
    {
        precio = 0;
        var limpio = (texto ?? "").Trim().Replace("$", "").Replace(" ", "").Replace(".", "").Replace(",", ".");
        return decimal.TryParse(limpio, System.Globalization.NumberStyles.Any,
            System.Globalization.CultureInfo.InvariantCulture, out precio);
    }

    private async Task ConfirmarPrecio(ApiClient.PubV2Fila it)
    {
        if (!TryPrecio(precioEscrito, out var precio) || precio <= 0)
        {
            ToastService.Error("Escribí un precio válido.");
            return;
        }
        if (precio == it.Precio) { CancelarPrecio(); return; }

        // 2026-08-31 — La publicación está en campaña: cambiarle el precio le saca el descuento.
        // Es una consecuencia que no se ve por ningún lado, así que se pregunta antes.
        if (it.PromoPrecio is > 0)
        {
            var seguir = await JS.InvokeAsync<bool>("confirm",
                $"Esta publicación está en «{it.PromoNombre}» y hoy se vende a {Plata(it.PromoPrecio.Value)}.\n\n"
                + $"Si le ponés {Plata(precio)}, MercadoLibre le va a SACAR el descuento y se va a vender a ese precio.\n\n"
                + "Si lo que querés es cambiar el precio y seguir en la campaña, hay que salir de la campaña primero, "
                + "cambiar el precio, y volver a entrar (el botón 🏷️ de la fila).\n\n¿Seguimos igual?");
            if (!seguir) return;
        }

        // La pregunta que evita que el precio "se cambie solo" a la noche: si esta publicación
        // está en modo porcentaje, el sistema lo va a recalcular salvo que se apague el sincro.
        var quedaFijo = true;
        if (MandaElPorcentaje(it))
        {
            quedaFijo = await JS.InvokeAsync<bool>("confirm",
                $"Esta publicación hoy mantiene sola el {it.ObjetivoPct:0}% de ganancia.\n\n" +
                $"ACEPTAR: el precio ${precio:N0} queda FIJO y el sistema no lo toca más.\n" +
                $"CANCELAR: se publica igual, pero el sistema lo va a recalcular para volver al {it.ObjetivoPct:0}%.");
        }
        else
        {
            var ok = await JS.InvokeAsync<bool>("confirm",
                $"Publicar ${precio:N0} en MercadoLibre (hoy está ${it.Precio:N0}). ¿Seguro?");
            if (!ok) return;
        }

        precioGuardando = true;
        StateHasChanged();
        try
        {
            var (res, err) = await Api.PonerPrecioV2Async(it.MeliItemId, precio, quedaFijo);
            if (res?.Ok == true)
            {
                ToastService.Success(res.Mensaje);
                CancelarPrecio();
                await RefrescarFilaDespuesDePublicar(it.MeliItemId);   // no recarga todo: no salta el scroll
            }
            else ToastService.Error(res?.Mensaje ?? err ?? "No se pudo publicar el precio");
        }
        catch (Exception ex) { ToastService.Error("Error: " + ex.Message); }
        finally { precioGuardando = false; StateHasChanged(); }
    }

