                                    <div class="cnt" style="margin-bottom:.4rem;">Esta publicación no tiene descripción. Escribila acá y guardala.</div>
                                }
                                <textarea @bind="descTexto" @bind:event="oninput" rows="@DescFilas" spellcheck="true"
                                          style="width:100%; max-width:900px; font-family:inherit; font-size:.82rem; line-height:1.45; padding:.55rem .7rem; border:1px solid #cbd5e1; border-radius:.4rem; background:#fff; resize:vertical;"></textarea>
                                <div class="pie">
                                    <button class="btn meli" disabled="@(descGuardando || !DescCambio)" @onclick="() => GuardarDescripcion(it.MeliItemId)">
                                        @(descGuardando ? "Guardando…" : "💾 Guardar en MercadoLibre")
                                    </button>
                                    <button class="btn" disabled="@(descGuardando || !DescCambio)" @onclick="() => { descTexto = descOriginal; descResultado = null; }">↩ Deshacer</button>
                                    <span class="cnt">@descTexto.Length.ToString("N0") letras · solo texto, sin negritas ni links · es la misma para todas las variantes</span>
                                </div>
                                @if (!string.IsNullOrEmpty(descResultado))
                                {
                                    <div class="aviso @(descResultadoOk ? "ok" : "err")">@descResultado</div>
                                }
                            }
                        </div>
                    }

                    @if (medidasAbiertas == it.MeliItemId)
                    {
                        <div class="p2-med" @onclick:stopPropagation="true">
                            <h4>📦 Peso y medidas del paquete — de acá sale el envío</h4>
                            @if (medidasCargando)
                            {
                                <span class="nota">Consultando a MercadoLibre…</span>
                            }
                            else if (medidas is null)
                            {
                                <span class="aviso err">No se pudieron leer las medidas.</span>
                            }
                            else
                            {
                                <div class="campos">
                                    <span class="campo"><label>Peso (gramos)</label>
                                        <input type="number" @bind="edPeso" placeholder="—" /></span>
                                    <span class="campo"><label>Largo (cm)</label>
                                        <input type="number" @bind="edLargo" placeholder="—" /></span>
                                    <span class="campo"><label>Ancho (cm)</label>
                                        <input type="number" @bind="edAncho" placeholder="—" /></span>
                                    <span class="campo"><label>Alto (cm)</label>
                                        <input type="number" @bind="edAlto" placeholder="—" /></span>
                                    <span class="envio">
                                        <b>@(medidas.EnvioActual.HasValue ? Plata(medidas.EnvioActual.Value) : "—")</b>
                                        <span>envío que pagás hoy</span>
                                    </span>
                                    <button class="guardar" @onclick="() => GuardarMedidas(it.MeliItemId)" disabled="@medidasGuardando">
                                        @(medidasGuardando ? "Guardando…" : "✓ Guardar en MeLi")
