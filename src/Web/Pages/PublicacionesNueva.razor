    private string fotoLink = "";
    private bool fotoTrayendo;

    private async Task AgregarFotoPorLink()
    {
        var url = (fotoLink ?? "").Trim();
        if (string.IsNullOrEmpty(url)) return;
        if (!url.StartsWith("http", StringComparison.OrdinalIgnoreCase))
        {
            ToastService.Error("Pegá un enlace que empiece con http…");
            return;
        }
        fotoTrayendo = true;
        StateHasChanged();
        try
        {
            var (dataUri, error) = await Api.FetchImageFromUrlAsync(url);
            if (string.IsNullOrEmpty(dataUri))
            {
                ToastService.Error(error ?? "No se pudo traer la foto de ese enlace.");
                return;
            }
            fotosEdit.Add(new FotoEdit { DataUri = dataUri, Preview = dataUri });
            fotoLink = "";
        }
        catch (Exception ex) { ToastService.Error("Error: " + ex.Message); }
        finally { fotoTrayendo = false; StateHasChanged(); }
    }

    private async Task SubirFotos(InputFileChangeEventArgs e)
    {
        const long max = 10L * 1024 * 1024;   // tope de MeLi
        foreach (var file in e.GetMultipleFiles(12))
        {
            if (file.Size > max)
            {
                ToastService.Error($"{file.Name}: pesa más de 10 MB, que es lo máximo que acepta MercadoLibre.");
                continue;
            }
            try
            {
                var tipo = string.IsNullOrEmpty(file.ContentType) ? "image/jpeg" : file.ContentType;
                using var stream = file.OpenReadStream(max);
                using var ms = new MemoryStream();
                await stream.CopyToAsync(ms);
                var dataUri = $"data:{tipo};base64,{Convert.ToBase64String(ms.ToArray())}";
                fotosEdit.Add(new FotoEdit { DataUri = dataUri, Preview = dataUri });
            }
            catch (Exception ex) { ToastService.Error($"{file.Name}: no se pudo leer ({ex.Message})"); }
        }
        StateHasChanged();
    }

