    private record CuentaFila(bool Simulada, string Etiqueta, decimal Precio, decimal Meli, decimal Recibis,
                              decimal? Iva, decimal? Costo, decimal? Queda, decimal Envio = 0m);

    /// <summary>2026-09-21 — La cuenta de la fila (opción B). Sale de los MISMOS números que el
    /// margen, así no hay dos cuentas distintas en la pantalla: Recibís = precio real − lo que se
    /// lleva MeLi (comisión + fijo + envío); el IVA es Recibís − neto sin IVA; te queda = neto − costo.
    /// Mientras se escribe un precio, muestra la cuenta con ESE precio.</summary>
    private CuentaFila? CuentaDe(ApiClient.PubV2Fila it)
    {
        // Sólo si MeLi contestó: si no, la simulación viene con comisión 0 y la cuenta diría
        // "Recibís" el precio entero. Mejor seguir mostrando la de hoy.
        if (editandoPrecio == it.MeliItemId && !simulando && simulacion is { MargenPct: not null } sim)
        {
            var meliSim = sim.Comision + sim.Envio;
            var recSim = sim.PrecioProbado - meliSim;
            var netoSim = Math.Round(recSim / 1.21m, 2);
            return new CuentaFila(true, "Precio nuevo", sim.PrecioProbado, meliSim, recSim,
                sim.Costo is > 0 ? recSim - netoSim : null, sim.Costo is > 0 ? sim.Costo : null, sim.Costo is > 0 ? sim.Ganancia : null,
                sim.Envio);
        }
        if (it.ComisionMonto is null || it.NetoSinIva is null) return null;
        var enPromo = it.PromoPrecio is > 0 && it.PromoPrecio < it.Precio;
        var precio = enPromo ? it.PromoPrecio!.Value : it.Precio;
        var recibis = precio - it.ComisionMonto.Value;
        var conCosto = it.Costo is > 0 && it.GananciaPesos.HasValue;
        return new CuentaFila(false, enPromo ? "Precio promo" : "Precio", precio, it.ComisionMonto.Value, recibis,
            conCosto ? recibis - it.NetoSinIva.Value : null, conCosto ? it.Costo : null, conCosto ? it.GananciaPesos : null,
            it.ComisionEnvio ?? 0m);
    }

