@page "/publicaciones-nueva"
@attribute [Authorize]
@inject ApiClient Api
@inject NavigationManager Nav
@inject ToastService ToastService
@inject IJSRuntime JS

@*
    2026-08-25 — Pantalla NUEVA de publicaciones. ETAPA 1: solo mirar.
    Convive con la de siempre (/publicaciones), que no se toca hasta que ésta esté aprobada.
    Novedades respecto de la vieja:
      · Pantalla completa (sin menú al costado ni barra arriba), como el Mapeo.
      · Debajo del título: de qué productos del sistema se compone y para cuántas alcanza.
      · Columna "Se lleva MeLi": el total real (porcentaje + cargo fijo + cuotas), no solo el %.
      · Precios distintos entre hermanas: solo es alarma si tienen LAS MISMAS condiciones de venta.
      La que ofrece cuotas paga mas comision, asi que TIENE que valer mas para dejar lo mismo.
      · Filtros por comisión / cuotas / varios precios / precio a mano.
*@

<style>
    .p2-full { position: fixed; inset: 0; z-index: 4000; display: flex; flex-direction: column;
               background: #f8f9f7; overflow: hidden; }
    .p2-bar { display: flex; align-items: center; gap: .6rem; justify-content: space-between;
              flex-wrap: wrap; padding: .6rem .9rem; background: #0f2a1c; color: #fff; }
    .p2-bar .ttl { font-weight: 700; font-size: .95rem; }
    .p2-bar .ttl small { font-weight: 400; opacity: .75; margin-left: .4rem; }
    .p2-bar .acts { display: flex; gap: .4rem; flex-wrap: wrap; }
    .p2-btn { font-size: .78rem; font-weight: 600; padding: .42rem .7rem; border-radius: .45rem;
              border: 1px solid rgba(255,255,255,.22); background: rgba(255,255,255,.08); color: #fff; cursor: pointer; }
    .p2-btn:hover { background: rgba(255,255,255,.16); }
    .p2-btn.go { background: #15803d; border-color: #15803d; }

    .p2-body { flex: 1; min-height: 0; overflow-y: auto; overflow-x: hidden; padding: .8rem .9rem 1.2rem; display: flex; flex-direction: column; gap: .6rem; }
    .p2-search { display: flex; gap: .5rem; flex-wrap: wrap; }
    .p2-search input { flex: 1; min-width: 160px; padding: .48rem .65rem; border: 1px solid #e3e7e0;
                       border-radius: .5rem; font-size: .8rem; }
    .p2-filters { display: flex; gap: .35rem; flex-wrap: wrap; align-items: center; }
    .p2-chip { font-size: .75rem; padding: .35rem .65rem; border-radius: 999px; border: 1px solid #e3e7e0;
               background: #fff; color: #6b7280; cursor: pointer; white-space: nowrap; }
    .p2-chip:hover { border-color: #9ca3af; }
    .p2-chip.on { background: #4f46e5; border-color: #4f46e5; color: #fff; font-weight: 600; }
    .p2-chip.nue { background: #e5efe8; border-color: #1f6b45; color: #1f6b45; font-weight: 600; }
    .p2-chip.nue.on { background: #1f6b45; color: #fff; }
    /* 2026-09-22 · los filtros de "problemas" van en un solo botón que despliega la lista */
    .p2-fmenu { position: relative; }
    .p2-fmenu-fondo { position: fixed; inset: 0; z-index: 40; }
    .p2-fmenu-lista { position: absolute; top: calc(100% + 4px); left: 0; z-index: 41; background: #fff;
                      border: 1px solid #d1d5db; border-radius: .5rem; box-shadow: 0 8px 24px rgba(0,0,0,.12);
                      padding: .35rem 0; min-width: 270px; }
    .p2-fmenu-lista .grp { font-size: .6rem; letter-spacing: .09em; text-transform: uppercase; color: #9ca3af;
                           font-weight: 700; padding: .5rem .85rem .2rem; }
    .p2-fmenu-lista .opc { font-size: .8rem; padding: .32rem .85rem; cursor: pointer; display: flex; gap: .45rem; color: #1f2937; }
    .p2-fmenu-lista .opc:hover { background: #f3f4f6; }
    .p2-fmenu-lista .opc .tic { width: 1rem; color: #1f6b45; font-weight: 700; }
    .p2-fmenu-lista .opc.on { font-weight: 600; }
    .p2-ampliar { font-size: .78rem; color: #4b5563; margin: .1rem 0 .4rem; }
    .p2-ampliar a { color: #1d4f80; cursor: pointer; text-decoration: underline; }
    .p2-ampliar b { color: #111827; }
    .p2-lbl { font-size: .62rem; letter-spacing: .09em; text-transform: uppercase; color: #9ca3af; font-weight: 700; }

    .p2-count { display: flex; justify-content: space-between; align-items: center; font-size: .75rem;
                color: #6b7280; flex-wrap: wrap; gap: .5rem; }
    .p2-pg { border: 1px solid #e3e7e0; background: #fff; border-radius: .35rem; padding: .18rem .5rem;
             font-size: .7rem; color: #6b7280; cursor: pointer; }
    .p2-pg[disabled] { opacity: .45; cursor: default; }

    /* 2026-08-26 — flex-shrink:0 es CLAVE: sin esto el contenedor flex comprimia la tabla y,
       como tiene overflow:hidden por el borde redondeado, las filas de abajo se RECORTABAN
       (se veian 9 de 17 y no aparecian ni bajando). */
    .p2-tbl { background: #fff; border: 1px solid #e3e7e0; border-radius: .6rem; overflow: hidden; flex-shrink: 0; }
    .p2-th, .p2-tr { display: grid; grid-template-columns: 30px minmax(0,1fr) 262px 180px 84px 82px;
                     gap: .6rem; align-items: center; padding: .55rem .65rem; }
    .p2-th { background: #f8f9f7; border-bottom: 1px solid #e3e7e0; font-size: .6rem; text-transform: uppercase;
             letter-spacing: .07em; color: #9ca3af; font-weight: 700; }
    .p2-tr { border-bottom: 1px solid #e3e7e0; font-size: .78rem; }
    .p2-tr:last-child { border-bottom: none; }
    .p2-tr:hover { background: #fafbf9; }
    .p2-prod { display: flex; gap: .5rem; align-items: center; min-width: 0; }
    .p2-thumb { width: 34px; height: 34px; border-radius: .35rem; border: 1px solid #e3e7e0; object-fit: cover;
                background: #f8f9f7; flex-shrink: 0; }
    .p2-pinfo { min-width: 0; }
    .p2-t { display: block; font-weight: 600; font-size: .76rem; color: #1f2937; white-space: nowrap;
            overflow: hidden; text-overflow: ellipsis; }
    .p2-m { display: block; font-family: ui-monospace, monospace; font-size: .63rem; color: #9ca3af;
            white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
    .p2-rec { display: block; font-size: .63rem; color: #9ca3af; white-space: nowrap; overflow: hidden;
              text-overflow: ellipsis; margin-top: .05rem; }
    .p2-rec b { color: #6b7280; font-weight: 600; }
    .p2-rec .frena { color: #b91c1c; font-weight: 700; }
    .p2-rec .arma { color: #6b7280; font-weight: 700; }
    .p2-rec.tocable { cursor: pointer; border-bottom: 1px dotted #cbd5e1; width: fit-content; max-width: 100%; }
    .p2-rec.tocable:hover, .p2-rec.on { color: #1d4f80; border-bottom-color: #1d4f80; }
    .p2-receta { grid-column: 1 / -1; background: #f8fafc; border: 1px solid #e3e7e0; border-radius: .5rem;
                 padding: .7rem .8rem; margin: .1rem 0 .3rem; }
    .p2-receta h4 { margin: 0 0 .5rem; font-size: .8rem; color: #1f2937; }
    .p2-receta .comp { display: flex; align-items: center; gap: .5rem; flex-wrap: wrap;
                       padding: .4rem .5rem; background: #fff; border: 1px solid #e5e7eb;
                       border-radius: .4rem; margin-bottom: .3rem; }
    .p2-receta .comp .nom { font-size: .78rem; font-weight: 600; color: #1f2937; }
    .p2-receta .comp .cod { font-size: .7rem; color: #6b7280; }
    .p2-receta .comp .dato { font-size: .7rem; color: #6b7280; }
    .p2-receta .comp .mal { color: #b91c1c; font-weight: 700; font-size: .7rem; }
    .p2-receta .comp .ojo { color: #b45309; font-weight: 600; font-size: .7rem; }
    .p2-receta .comp .ok-verde { color: #15803d; font-weight: 700; font-size: .7rem; }
    .p2-receta .comp input { width: 78px; text-align: right; font-size: .78rem; font-weight: 700;
                             border: 1px solid #cbd5e1; border-radius: .3rem; padding: .15rem .3rem; }
    .p2-receta .btn { font-size: .72rem; font-weight: 700; padding: .28rem .6rem; border-radius: .35rem;
                      border: 1px solid #cbd5e1; background: #fff; cursor: pointer; font-family: inherit; }
    .p2-receta .btn:hover { border-color: #9ca3af; }
    .p2-receta .btn.go { background: #15803d; border-color: #15803d; color: #fff; }
    .p2-receta .btn.del { color: #b91c1c; border-color: #fecaca; }
    .p2-receta .btn[disabled] { opacity: .5; cursor: default; }
    .p2-receta .buscar { display: flex; gap: .4rem; align-items: center; flex-wrap: wrap; margin-top: .5rem; }
    .p2-receta .buscar input.q { flex: 1; min-width: 220px; font-size: .78rem; padding: .3rem .5rem;
                                 border: 1px solid #cbd5e1; border-radius: .35rem; }
    .p2-receta .lista { max-height: 190px; overflow-y: auto; border: 1px solid #e5e7eb;
                        border-radius: .4rem; margin-top: .35rem; background: #fff; }
    .p2-receta .lista .op { padding: .3rem .5rem; font-size: .76rem; cursor: pointer; border-bottom: 1px solid #f1f5f9; }
    .p2-receta .lista .op:hover { background: #f0fdf4; }
    .p2-receta .lista .op .cod { color: #6b7280; font-size: .7rem; }
    .p2-receta .nota { font-size: .7rem; color: #6b7280; margin-top: .45rem; }

    .p2-price { display: block; font-weight: 700; font-size: .8rem; }
    .p2-rango { display: block; font-weight: 700; font-size: .76rem; color: #b91c1c; }
    .p2-flag { display: inline-block; font-size: .58rem; font-weight: 700; padding: .1rem .35rem;
               border-radius: .25rem; background: #fee2e2; color: #b91c1c; margin-top: .1rem; }
    .p2-marg { display: inline-flex; align-items: center; gap: .25rem; font-size: .64rem; margin-top: .05rem; }
    .p2-dot { width: 7px; height: 7px; border-radius: 50%; background: #16a34a; }
    .p2-dot.low { background: #f59e0b; }
    .p2-dot.bad { background: #b91c1c; }
    .p2-costo { display: block; font-size: .63rem; color: #9ca3af; }

    .p2-cuenta { display: block; min-width: 0; font-size: .68rem; color: #6b7280; line-height: 1.3; }
    .p2-cuenta .ln { display: flex; justify-content: space-between; gap: .4rem; }
    .p2-cuenta .ln b { font-weight: 500; color: #374151; font-variant-numeric: tabular-nums; }
    .p2-cuenta .ln.tot { border-top: 1px solid #e5e7eb; margin-top: .05rem; padding-top: .05rem; color: #111827; font-weight: 700; }
    .p2-cuenta .ln.tot b { font-weight: 700; color: #111827; }
    .p2-cuenta .ln.tot.neg, .p2-cuenta .ln.tot.neg b { color: #b91c1c; }
    .p2-cuenta .sin { display: block; font-size: .64rem; color: #9ca3af; }
    .p2-cuenta .viejo { display: block; font-size: .6rem; font-weight: 700; color: #b45309; margin-top: .1rem; }
    .p2-queda { display: block; min-width: 0; }
    .p2-queda .pct { display: block; font-weight: 800; font-size: 1.05rem; line-height: 1.15; color: #15803d; }
    .p2-queda .pct.tibio { color: #b45309; }
    .p2-queda .pct.malo { color: #b91c1c; }
    .p2-queda .ver { display: block; font-size: .64rem; font-weight: 700; margin-top: .05rem; }
    .p2-queda .ver.ok { color: #15803d; }
    .p2-queda .ver.no { color: #b91c1c; }
    .p2-queda .det { display: block; font-size: .6rem; color: #9ca3af; }
    .p2-queda .falta { display: block; font-size: .62rem; color: #b91c1c; font-weight: 700; }


    .p2-ctrl { display: flex; align-items: center; gap: .25rem; flex-wrap: nowrap; }
    .p2-obj { display: inline-flex; align-items: center; gap: .15rem; border: 1px solid #e3e7e0;
              border-radius: .35rem; padding: .1rem .3rem; background: #fff; font-size: .7rem; font-weight: 700;
              /* sin esto el chip se parte en dos renglones y la fila crece: con 50 filas por
                 página eso es media pantalla más de scroll (misma razón que la ⚖ al lado de la foto) */
              white-space: nowrap; }
    .p2-obj .pc { font-size: .6rem; color: #9ca3af; font-weight: 400; }
    /* 2026-08-27 · Candado por fila. Cerrado, los interruptores son sólo un cartel — como
       siempre. Abierto, se pueden tocar, y se vuelve a cerrar solo a los pocos segundos:
       pedido de Osmar, "obvio que no quiero que sea solo tocando". */
    .p2-sw { display: inline-flex; align-items: center; gap: .15rem; font-size: .6rem;
             border: 0; background: transparent; padding: 0; color: inherit; font-family: inherit; }
    .p2-sw.tocable { cursor: pointer; border: 1px solid #cbd5e1; border-radius: .35rem;
                     padding: .12rem .28rem; background: #fff; }
    .p2-sw.tocable:hover { border-color: #15803d; background: #f0fdf4; }
    .p2-sw[disabled] { cursor: default; }
    .p2-candado { border: 1px solid #e3e7e0; background: #f8f9f7; border-radius: .35rem;
                  padding: .12rem .26rem; font-size: .74rem; line-height: 1; cursor: pointer; }
    .p2-candado:hover { border-color: #9ca3af; }
    .p2-candado.abierto { background: #fef3c7; border-color: #f59e0b; }
    .p2-promo { display: block; font-size: .68rem; font-weight: 700; color: #7c2d12;
                background: #fff7ed; border: 1px solid #fdba74; border-radius: .3rem;
                padding: .05rem .3rem; margin-top: .15rem; width: fit-content; max-width: 100%; }
    .p2-promo small { font-weight: 400; color: #9a5b2d; margin-left: .2rem; }
    .p2-marca { display: inline-flex; align-items: center; gap: .35rem; flex-wrap: wrap; font-size: .68rem;
                color: #7c2d12; background: #fffbeb; border: 1px solid #fcd34d; border-radius: .35rem;
                padding: .12rem .4rem; margin-top: .1rem; width: fit-content; }
    .p2-marca button { font-size: .68rem; font-weight: 700; font-family: inherit; cursor: pointer;
                       border: 1px solid #b45309; background: #fff; color: #b45309;
                       border-radius: .3rem; padding: .05rem .35rem; }
    .p2-marca button:hover { background: #fef3c7; }
    .p2-marca button[disabled] { opacity: .5; cursor: default; }
    .p2-st.tocable { cursor: pointer; font-family: inherit; box-shadow: 0 0 0 1px rgba(0,0,0,.08); }
    .p2-st.tocable:hover { filter: brightness(.94); }
    .p2-st.tocable[disabled] { opacity: .6; cursor: default; }
    .p2-led { width: 12px; height: 12px; border-radius: 50%; border: 1px solid #cbd5e1; background: #fff; }
    .p2-led.on { background: #15803d; border-color: #15803d; }

    .p2-stk { display: block; text-align: center; font-weight: 700; font-size: .8rem; }
    .p2-stk small { display: block; font-weight: 400; font-size: .55rem; color: #9ca3af; }
    .p2-stk.zero { color: #9ca3af; }
    .p2-st { font-size: .62rem; padding: .15rem .45rem; border-radius: 999px; font-weight: 600; text-align: center;
             white-space: nowrap; display: inline-block; }
    .p2-st.a { background: #dcfce7; color: #16a34a; }
    .p2-st.p { background: #fef0d8; color: #b45309; }
    .p2-st.o { background: #f1f5f9; color: #64748b; }

    /* panel de medidas (lo que define el envio) */
    .p2-med { background: #f8f9f7; border-bottom: 1px solid #e3e7e0; padding: .8rem 1rem .9rem 3rem; }
    .p2-med h4 { margin: 0 0 .5rem; font-size: .68rem; text-transform: uppercase; letter-spacing: .08em; color: #9ca3af; }
    .p2-med .campos { display: flex; gap: .8rem; flex-wrap: wrap; align-items: flex-end; }
    .p2-med .campo { display: flex; flex-direction: column; gap: .15rem; }
    .p2-med .campo label { font-size: .62rem; color: #6b7280; font-weight: 600; }
    .p2-med .campo input { width: 92px; padding: .35rem .5rem; border: 1px solid #e3e7e0; border-radius: .35rem;
                           font-size: .82rem; font-weight: 700; text-align: right; }
    .p2-med .envio { display: flex; flex-direction: column; gap: .1rem; padding: .35rem .7rem; border-radius: .4rem;
                     background: #fff; border: 1px solid #e3e7e0; }
    .p2-med .envio b { font-size: .95rem; }
    .p2-med .envio span { font-size: .6rem; color: #9ca3af; }
    .p2-med .aviso { font-size: .7rem; color: #b45309; background: #fef0d8; border-radius: .35rem;
                     padding: .35rem .6rem; margin-top: .5rem; display: inline-block; }
    .p2-med .ok { color: #15803d; background: #dcfce7; }
    .p2-med .err { color: #b91c1c; background: #fee2e2; }
    .p2-med .guardar { padding: .4rem .8rem; border-radius: .4rem; border: none; background: #15803d;
                       color: #fff; font-weight: 700; font-size: .78rem; cursor: pointer; }
    .p2-med .guardar[disabled] { opacity: .5; cursor: default; }
    .p2-med .nota { font-size: .68rem; color: #6b7280; margin-top: .45rem; }

    /* 2026-09-22 · el precio se elige tildando: OEM · Actual · Para el N% · Manual */
    .p2-precios { display: flex; flex-direction: column; gap: 1px; }
    .p2-po { display: grid; grid-template-columns: 14px 74px 1fr 52px; align-items: center; gap: .3rem;
             font-size: .72rem; color: #6b7280; padding: 1px 4px; border-radius: .3rem; cursor: pointer;
             border: none; background: none; text-align: left; font-family: inherit; width: 100%; }
    .p2-po:hover { background: #f3f4f6; }
    .p2-po .rd { width: 12px; height: 12px; border-radius: 50%; border: 1.5px solid #9ca3af; display: inline-block; }
    .p2-po b { color: #374151; font-weight: 600; }
    .p2-po.sel { background: #eef4fb; cursor: default; }
    .p2-po.sel .rd { border-color: #1d4f80; background: radial-gradient(#1d4f80 45%, #fff 50%); }
    .p2-po.sel span, .p2-po.sel b { color: #1d4f80; font-weight: 700; }
    .p2-po .pp { text-align: right; font-size: .68rem; color: #6b7280; }
    .p2-po.sel .pp { font-size: .9rem; font-weight: 800; color: #15803d; }
    .p2-po.sel .pp.tibio { color: #b45309; }
    .p2-po.sel .pp.malo { color: #b91c1c; }
    .p2-po .pctin { width: 44px; font-size: .72rem; padding: 0 3px; border: 1px solid #9ca3af; border-radius: .25rem;
                    font-family: inherit; text-align: right; }
    .p2-po.sel .pctin { border-color: #1d4f80; color: #1d4f80; font-weight: 700; }
    .p2-pinfo2 { font-size: .6rem; color: #6b7280; padding: 1px 4px 0 22px; display: block; }
    .p2-pinfo2.mal { color: #b45309; font-weight: 700; }
    .p2-po .venta { grid-column: 2 / 5; font-size: .95rem; font-weight: 800; color: #111827; }
    .p2-po .venta small { font-size: .58rem; font-weight: 400; color: #1d4f80; margin-left: .35rem; }
    .p2-po .nota { grid-column: 2 / 5; font-size: .58rem; color: #6b7280; font-weight: 400; margin-top: -1px; }
    .p2-po.sel .nota { color: #1d4f80; font-weight: 400; }
    .p2-po.sel .nota.motivo { text-align: right; color: #6b7280; margin-top: -3px; }
    .p2-po.nodisp { cursor: default; opacity: .55; }
    .p2-po.nodisp:hover { background: none; }
    .p2-precios .p2-edit { margin: 2px 0 2px 18px; }
    .p2-stksync { display: inline-flex; align-items: center; gap: .2rem; margin-top: .3rem; font-size: .6rem;
                  color: #6b7280; cursor: pointer; border: none; background: none; font-family: inherit; padding: 0; }
    .p2-stksync .cb { width: 12px; height: 12px; border: 1.5px solid #9ca3af; border-radius: 3px; display: inline-flex;
                      align-items: center; justify-content: center; font-size: .6rem; line-height: 1; color: #fff; }
    .p2-stksync.on .cb { background: #15803d; border-color: #15803d; }
    .p2-stksync.on { color: #15803d; font-weight: 600; }
    .p2-stksync[disabled] { opacity: .5; cursor: default; }
    .p2-opcion { display: block; font-size: .6rem; color: #6b7280; margin-top: .1rem; }

    /* Al lado de la foto, no debajo: apilados la fila crecía 9 px y con 50 filas por página
       eso es media pantalla más de scroll. */
    /* Cómo se envía. El color separa lo que te cuesta plata de lo que no. */
    .p2-envio { display: inline-block; font-size: .58rem; font-weight: 700; padding: 0 .3rem;
                border-radius: .25rem; letter-spacing: .02em; vertical-align: 1px;
                background: #f1f5f9; color: #475569; border: 1px solid #e2e8f0; }
    .p2-envio.full { background: #ede9fe; color: #5b21b6; border-color: #ddd6fe; }
    .p2-envio.colecta { background: #e0f2fe; color: #075985; border-color: #bae6fd; }
    .p2-envio.flex { background: #dcfce7; color: #166534; border-color: #bbf7d0; }
    .p2-envio.acordar { background: #fef3c7; color: #92400e; border-color: #fde68a; }
    .p2-envio.sindato { background: #fff; color: #9ca3af; border-style: dashed; }

    /* 2026-08-27: en qué cuenta de MeLi está publicada. Va primero en el renglón gris,
       siempre en el mismo lugar, para poder barrer la lista de un vistazo. */
    .p2-cta { display: inline-block; font-size: .58rem; font-weight: 700; padding: 0 .3rem;
              border-radius: .25rem; letter-spacing: .02em; vertical-align: 1px; margin-right: .25rem;
              background: #e6f1fb; color: #0c447c; border: 1px solid #b5d4f4; }
    .p2-cta.c2 { background: #e1f5ee; color: #04342c; border-color: #9fe1cb; }

    .p2-rail { float: left; margin-right: .5rem; display: flex; align-items: center; gap: .25rem; }
    /* 2026-09-22 · (opción B de Osmar) foto más grande + 4 botones de a 2 con su nombre. */
    .p2-pinfo.v2 { display: flex; gap: .6rem; align-items: center; }
    .p2-pinfo.v2 .p2-thumb { width: 56px; height: 56px; }
    .p2-pinfo.v2 .p2-thumb.vacia { display: inline-block; }
    .p2-botones { display: grid; grid-template-columns: auto auto; gap: 4px; flex-shrink: 0; }
    .p2-botones button { height: 26px; border: 1px solid #e3e7e0; background: #fff; border-radius: .35rem;
                         font-size: .72rem; color: #374151; padding: 0 .45rem; text-align: left;
                         white-space: nowrap; cursor: pointer; font-family: inherit; }
    .p2-botones button .ic { font-size: .9rem; margin-right: .25rem; }
    .p2-botones button:hover { border-color: #1d4f80; color: #1d4f80; background: #eef4fb; }
    .p2-botones button.on { background: #1d4f80; border-color: #1d4f80; color: #fff; }
    .p2-txt { min-width: 0; flex: 1; }
    .p2-vend { margin-left: .3rem; font-weight: 400; color: #6b7280; font-size: .72rem; }
    .p2-m2 { display: block; font-size: .7rem; color: #6b7280; white-space: nowrap; overflow: hidden;
             text-overflow: ellipsis; margin-top: .1rem; }
    .p2-m2 b { color: #1f2937; font-weight: 600; }
    .p2-m2 .mla { color: #9ca3af; font-size: .65rem; }
    .p2-m2 .sindato { color: #b45309; }
    .p2-pinfo.v2 .p2-rec { display: inline; font-size: inherit; color: #6b7280; margin: 0; }
    .p2-pinfo.v2 .p2-rec b { color: #1f2937; font-weight: 600; }
    .p2-pinfo.v2 .p2-rec .frena, .p2-pinfo.v2 .p2-rec .frena b { color: #b91c1c; }
    .p2-cuentachica { display: block; font-size: .6rem; color: #6b7280; margin-top: .25rem; text-align: center; }
    .p2-balanza { border: 1px solid #e3e7e0; background: #fff; border-radius: .3rem; cursor: pointer;
                  font-size: .72rem; line-height: 1; padding: .15rem .34rem; color: #6b7280; }
    .p2-balanza:hover { border-color: #1d4f80; color: #1d4f80; background: #eef4fb; }
    .p2-balanza.on { background: #1d4f80; border-color: #1d4f80; color: #fff; }

    /* 2026-08-26: precio a mano en la fila */
    /* 2026-08-26: Osmar no encontraba dónde escribir el precio — el subrayado solo aparecía al
       pasar el mouse, y lo que no se ve no existe. Ahora se ve siempre, con un lapicito. */
    .p2-price.editable { cursor: text; border-bottom: 1px dashed #b9c6d8; display: inline-block; }
    .p2-price.editable:hover { border-bottom-color: #1d4f80; color: #1d4f80; background: #f2f7fc; }
    .p2-edit { display: block; }
    .p2-edit input { width: 100%; box-sizing: border-box; padding: .22rem .35rem; border: 1px solid #1d4f80;
                     border-radius: .3rem; font-size: .8rem; font-weight: 700; font-family: inherit; }
    .p2-edit .pie { display: flex; align-items: center; gap: 3px; margin-top: .2rem; }
    .p2-edit .antes { flex: 1; font-size: .56rem; color: #9ca3af; white-space: nowrap; overflow: hidden; }
    .p2-edit button { border: 1px solid #e3e7e0; background: #fff; border-radius: .3rem; cursor: pointer;
                      font-size: .68rem; line-height: 1; padding: .2rem .3rem; flex-shrink: 0; }
    .p2-edit button.ok { background: #15803d; border-color: #15803d; color: #fff; font-weight: 700; }
    .p2-edit button.ok[disabled] { opacity: .5; cursor: default; }
    .p2-edit button.no { color: #b91c1c; border-color: #fecaca; }
    .p2-queda .pct.sim { font-style: italic; }
    .p2-obj.manda { background: #dcfce7; border-color: #86efac; color: #15803d; font-weight: 700; }

    /* etapa 3: fotos de la publicacion */
    .p2-fotos { background: #f4f7fb; border-bottom: 1px solid #dbe3ee; padding: .8rem 1rem .9rem 3rem; }
    .p2-fotos h4 { margin: 0 0 .55rem; font-size: .68rem; text-transform: uppercase; letter-spacing: .08em; color: #9ca3af; }
    .p2-fotos .tira { display: flex; gap: .5rem; flex-wrap: wrap; align-items: flex-start; }
    .p2-fotos .pic { position: relative; width: 96px; border: 2px solid #e3e7e0; border-radius: .5rem;
                     background: #fff; padding: .25rem; }
    .p2-fotos .pic.portada { border-color: #15803d; box-shadow: 0 0 0 2px #dcfce7; }
    .p2-fotos .pic img { width: 100%; height: 78px; object-fit: contain; border-radius: .3rem; display: block; }
    .p2-fotos .pic .tag { position: absolute; top: -8px; left: 50%; transform: translateX(-50%);
                          background: #15803d; color: #fff; font-size: .55rem; font-weight: 700;
                          padding: .1rem .35rem; border-radius: .25rem; letter-spacing: .04em; white-space: nowrap; }
    .p2-fotos .pic .nueva { background: #1d4f80; }
    .p2-fotos .pic .btns { display: flex; gap: .15rem; justify-content: center; margin-top: .25rem; }
    .p2-fotos .pic .btns button { border: 1px solid #e3e7e0; background: #fff; border-radius: .3rem;
                                  font-size: .68rem; line-height: 1; padding: .2rem .3rem; cursor: pointer; }
    .p2-fotos .pic .btns button[disabled] { opacity: .35; cursor: default; }
    .p2-fotos .pic .btns .del { color: #b91c1c; border-color: #fecaca; }
    .p2-fotos .subir { width: 96px; height: 112px; border: 2px dashed #b9c6d8; border-radius: .5rem;
                       display: flex; flex-direction: column; align-items: center; justify-content: center;
                       gap: .2rem; cursor: pointer; color: #1d4f80; font-size: .68rem; font-weight: 700;
                       background: #fff; }
    .p2-fotos .subir span.mas { font-size: 1.3rem; line-height: 1; }
    .p2-fotos .pie { display: flex; gap: .6rem; align-items: center; flex-wrap: wrap; margin-top: .6rem; }
    .p2-fotos .cnt { font-size: .68rem; color: #6b7280; }
    .p2-fotos .btn { padding: .4rem .8rem; border-radius: .4rem; border: 1px solid #cbd5e1; background: #fff;
                     font-weight: 700; font-size: .75rem; cursor: pointer; color: #334155; }
    .p2-fotos .btn.meli { background: #15803d; border-color: #15803d; color: #fff; }
    .p2-fotos .btn.copiar { background: #1d4f80; border-color: #1d4f80; color: #fff; }
    .p2-fotos .btn[disabled] { opacity: .45; cursor: default; }
    .p2-fotos .link { flex: 1; min-width: 240px; max-width: 460px; padding: .4rem .6rem; font-size: .75rem;
                      border: 1px solid #cbd5e1; border-radius: .4rem; }
    .p2-fotos .herm { margin-top: .7rem; border-top: 1px dashed #cbd5e1; padding-top: .6rem; }
    .p2-fotos .herm .lista { display: flex; gap: .45rem; flex-wrap: wrap; margin-top: .4rem; }
    .p2-fotos .herm .h { display: flex; align-items: center; gap: .35rem; border: 1px solid #dbe3ee;
                         border-radius: .4rem; padding: .25rem .45rem; background: #fff; cursor: pointer;
                         font-size: .68rem; max-width: 290px; }
    .p2-fotos .herm .h.sel { border-color: #1d4f80; background: #e9f1fa; }
    .p2-fotos .herm .h.bloq { opacity: .5; cursor: not-allowed; }
    .p2-fotos .herm .h img { width: 24px; height: 24px; object-fit: cover; border-radius: .25rem; }
    .p2-fotos .herm .h .tit { overflow: hidden; text-overflow: ellipsis; white-space: nowrap; max-width: 165px; }
    .p2-fotos .herm .h .n { font-weight: 700; color: #1d4f80; white-space: nowrap; }
    .p2-fotos .herm .h .v { font-weight: 700; color: #15803d; white-space: nowrap; }
    .p2-fotos .aviso { font-size: .7rem; color: #b45309; background: #fef0d8; border-radius: .35rem;
                       padding: .35rem .6rem; margin-top: .5rem; display: inline-block; }
    .p2-fotos .aviso.ok { color: #15803d; background: #dcfce7; }
    .p2-fotos .aviso.err { color: #b91c1c; background: #fee2e2; }
    .p2-thumb.clickable { cursor: zoom-in; }
    .p2-thumb.clickable:hover { border-color: #1d4f80; box-shadow: 0 0 0 2px #e9f1fa; }

    /* etapa 2: tildar y aplicar */
    .p2-chk { width: 15px; height: 15px; accent-color: #1d4f80; cursor: pointer; }
    .p2-tr.sel { background: #e9f1fa; }
    /* 2026-08-27 · Vista previa del Excel. Tapa la pantalla a propósito: es una decisión que
       hay que tomar mirándola, no algo para ojear de costado mientras se scrollea la lista. */
    .p2-modal-fondo { position: fixed; inset: 0; background: rgba(15,42,28,.55); z-index: 4100; }
    .p2-modal { position: fixed; inset: 3vh 3vw; z-index: 4101; background: #fff; border-radius: .6rem;
                display: flex; flex-direction: column; overflow: hidden;
                box-shadow: 0 20px 60px -20px rgba(0,0,0,.6); }
    .p2-modal .cab { display: flex; align-items: center; justify-content: space-between; gap: .6rem;
                     padding: .7rem .9rem; background: #0f2a1c; color: #fff; }
    .p2-modal .cab .ttl { font-weight: 700; font-size: .95rem; }
    .p2-modal .cab .ttl small { font-weight: 400; opacity: .75; margin-left: .3rem; }
    .p2-modal .cab .cerrar { background: transparent; border: 0; color: #fff; font-size: 1.05rem; cursor: pointer; }
    .p2-modal .cuerpo { flex: 1; overflow-y: auto; padding: .8rem .9rem; }
    .p2-modal .pie { display: flex; gap: .5rem; justify-content: flex-end; align-items: center;
                     padding: .6rem .9rem; border-top: 2px solid #1d4f80; background: #f8f9f7; flex-wrap: wrap; }
    .p2-modal .pie .p2-btn { border-color: #cbd5e1; background: #fff; color: #1f2937; }
    .p2-modal .pie .p2-btn:hover { border-color: #9ca3af; background: #f1f5f9; }
    .p2-modal .pie .p2-btn.go { background: #15803d; border-color: #15803d; color: #fff; }
    .p2-modal .pie .p2-btn[disabled] { opacity: .5; cursor: default; }
    .p2-modal .pie .confirmar { display: flex; align-items: center; gap: .5rem; flex-wrap: wrap;
                                font-size: .82rem; font-weight: 600; color: #7c2d12; }
    .p2-modal .resumen { display: flex; gap: .35rem; flex-wrap: wrap; margin-bottom: .6rem; }
    .p2-modal .pill { font-size: .76rem; font-weight: 700; padding: .25rem .55rem; border-radius: 999px;
                      background: #eef2ff; color: #3730a3; border: 1px solid #c7d2fe; }
    .p2-modal .pill.gris { background: #f3f4f6; color: #4b5563; border-color: #e5e7eb; }
    .p2-modal .pill.verde { background: #dcfce7; color: #166534; border-color: #86efac; }
    .p2-modal .pill.rojo { background: #fee2e2; color: #991b1b; border-color: #fca5a5; }
    .p2-modal .pill.ambar { background: #fef3c7; color: #92400e; border-color: #fcd34d; }
    .p2-modal .problema { font-size: .8rem; color: #7c2d12; background: #fffbeb; border: 1px solid #fcd34d;
                          border-radius: .4rem; padding: .4rem .6rem; margin-bottom: .35rem; }
    .p2-modal .vacio { font-size: .85rem; color: #4b5563; background: #f8f9f7; border: 1px dashed #cbd5e1;
                       border-radius: .4rem; padding: .9rem; }
    .p2-modal .acc-tildar { display: flex; gap: .4rem; align-items: center; margin: .5rem 0; flex-wrap: wrap; }
    .p2-modal .acc-tildar .p2-btn.chico { background: #fff; color: #1f2937; border-color: #cbd5e1;
                                          font-size: .74rem; padding: .3rem .55rem; }
    .p2-modal .acc-tildar .cnt { font-size: .78rem; font-weight: 700; color: #1d4f80; }
    .p2-modal .tabla { border: 1px solid #e3e7e0; border-radius: .45rem; overflow: hidden; }
    .p2-modal .tabla .fila { display: flex; gap: .6rem; align-items: flex-start; padding: .5rem .6rem;
                             border-bottom: 1px solid #eef1ee; }
    .p2-modal .tabla .fila:last-child { border-bottom: 0; }
    .p2-modal .tabla .fila.sel { background: #f0fdf4; }
    .p2-modal .tabla .fila.bloq { background: #fef2f2; opacity: .85; }
    .p2-modal .tabla .fila input[type=checkbox] { width: 16px; height: 16px; margin-top: .15rem;
                                                  accent-color: #15803d; cursor: pointer; }
    .p2-modal .tabla .fila .ico { font-weight: 700; }
    .p2-modal .tabla .fila .ico.ok { color: #15803d; }
    .p2-modal .tabla .fila .ico.no { color: #b91c1c; }
    .p2-modal .tabla .txt { min-width: 0; flex: 1; }
    .p2-modal .tabla .tit { font-size: .82rem; font-weight: 600; color: #1f2937; }
    .p2-modal .tabla .tit .sku { font-size: .72rem; color: #6b7280; margin-left: .4rem; }
    .p2-modal .tabla .tit .mla { font-size: .72rem; color: #9ca3af; margin-left: .4rem; }
    .p2-modal .tabla .que { font-size: .8rem; font-weight: 600; color: #1d4f80; margin-top: .1rem; }
    .p2-modal .tabla .deja { font-size: .76rem; margin-top: .1rem; }
    .p2-modal .tabla .deja.bien { color: #15803d; }
    .p2-modal .tabla .deja.flojo { color: #b45309; }
    .p2-modal .tabla .deja.mal { color: #b91c1c; font-weight: 700; }
    .p2-modal .tabla .aviso { font-size: .76rem; color: #7c2d12; margin-top: .1rem; }
    .p2-modal .tabla .aviso.err { color: #b91c1c; font-weight: 600; }
    @@media (max-width: 760px) { .p2-modal { inset: 0; border-radius: 0; } }

    .p2-acciones { position: sticky; bottom: 0; z-index: 20; background: #fff; border-top: 2px solid #1d4f80;
                   box-shadow: 0 -3px 18px -8px rgba(0,0,0,.35); padding: .6rem .8rem; display: flex;
                   gap: .45rem; align-items: center; flex-wrap: wrap; }
    .p2-acciones .cnt { font-weight: 700; color: #1d4f80; font-size: .82rem; white-space: nowrap; }
    .p2-acciones .sep { width: 1px; height: 20px; background: #e3e7e0; }
    .p2-ac { font-size: .76rem; font-weight: 600; padding: .4rem .7rem; border-radius: .4rem;
             border: 1px solid #e3e7e0; background: #f8f9f7; color: #1f2937; cursor: pointer; white-space: nowrap; }
    .p2-ac:hover { border-color: #9ca3af; }
    .p2-ac.go { background: #15803d; border-color: #15803d; color: #fff; }
    .p2-ac.meli { border-color: #b45309; color: #b45309; background: #fef0d8; }
    .p2-ac[disabled] { opacity: .5; cursor: default; }
    .p2-ac-obj { display: inline-flex; align-items: center; gap: .2rem; border: 1px solid #e3e7e0;
                 border-radius: .4rem; padding: .15rem .4rem; background: #fff; }
    .p2-ac-obj input { width: 46px; border: none; outline: none; font-size: .8rem; font-weight: 700; text-align: right; }
    .p2-res { max-height: 130px; overflow: auto; background: #f8f9f7; border: 1px solid #e3e7e0;
              border-radius: .4rem; padding: .4rem .6rem; font-size: .7rem; margin-top: .4rem; width: 100%; }
    .p2-res .fila { padding: .1rem 0; border-bottom: 1px solid #eef1ec; }
    .p2-res .fila:last-child { border-bottom: none; }
    .p2-res .no { color: #b91c1c; }

    .p2-empty { padding: 2rem; text-align: center; color: #9ca3af; font-size: .85rem; }
    .p2-note { font-size: .7rem; color: #6b7280; background: #eef2ff; border-left: 3px solid #4f46e5;
               padding: .5rem .7rem; border-radius: 0 .4rem .4rem 0; }

    @@media (max-width: 1100px) {
        .p2-th, .p2-tr { grid-template-columns: 30px minmax(0,1fr) 250px 172px; }
        .p2-h2 { display: none; }
    }
    @@media (max-width: 760px) {
        .p2-th, .p2-tr { grid-template-columns: 28px minmax(0,1fr) 130px; }
        .p2-h { display: none; }
    }
</style>

<div class="p2-full">

    <div class="p2-bar">
        <span class="ttl">🏷️ Publicaciones <small>@(datos?.Total.ToString("N0", ar) ?? "…") publicaciones</small></span>
        <span class="acts">
            <button class="p2-btn go" @onclick="ActualizarLista" disabled="@cargando">
                @(cargando ? "⏳ Cargando…" : "🔄 Actualizar lista")
            </button>
            @* 2026-08-27 · Excel editable: es lo único que escala a 5.925 publicaciones.
               Baja lo FILTRADO (no la página), se edita en Excel y vuelve. Nada se aplica
               sin pasar por la vista previa. *@
            <button class="p2-btn" @onclick="BajarExcel" disabled="@(excelBajando || cargando)"
                    title="Bajar un Excel con las publicaciones que quedaron filtradas, para editar precios y objetivos de a muchas">
                @(excelBajando ? "⏳ Armando el Excel…" : "⬇ Bajar Excel")
            </button>
            <label class="p2-btn" style="display:inline-flex; align-items:center; gap:.25rem; margin:0;"
                   title="Subir el Excel editado. Primero te muestra qué cambiaría; no se aplica nada todavía">
                @(excelLeyendo ? "⏳ Leyendo…" : "⬆ Subir Excel")
                <InputFile OnChange="SubirExcel" accept=".xlsx" style="display:none;" disabled="@excelLeyendo" />
            </label>
            @* 2026-08-31 · promociones. Sale barato (una llamada por campaña), así que es un botón
               y no un proceso nocturno: se aprieta cuando uno quiere el dato al día. *@
            <button class="p2-btn" @onclick="TraerPromociones" disabled="@promosCargando"
                    title="Le pregunta a MercadoLibre qué publicaciones están vendiendo con descuento. No aplica ni saca nada.">
                @(promosCargando ? "⏳ Mirando promociones…" : "🏷️ Promociones")
            </button>
            <button class="p2-btn" @onclick='() => Nav.NavigateTo("/publicaciones")'>⛶ Volver a la pantalla de siempre</button>
        </span>
    </div>

    <div class="p2-body">

        <div class="p2-note">
            <b>Pantalla nueva.</b> Tildá publicaciones y abajo aparece qué podés hacerles.
            Las acciones en <b style="color:#b45309;">ámbar</b> cambian cosas en MercadoLibre y piden confirmación;
            el resto solo mira o guarda configuración. La pantalla de siempre sigue funcionando igual.
        </div>

        <div class="p2-search">
            <input placeholder="Buscar por título, ID o N° de publicación (MLA)…" @bind="fTexto" @bind:event="oninput" @onkeyup="OnEnter" />
            <input placeholder="SKU" style="max-width:170px;" @bind="fSku" @bind:event="oninput" @onkeyup="OnEnter" />
            <button class="p2-btn" style="background:#1f6b45;border-color:#1f6b45;" @onclick="BuscarDesdeCero">Buscar</button>
            @* 2026-08-31 · traer los datos frescos de MercadoLibre sin volver a la pantalla vieja.
               Aparece solo cuando lo escrito es un número: con texto libre no habría qué traer.
               No hay menú de opciones — el sistema mira lo que escribiste y hace lo que corresponde. *@
            @if (PuedeTraerDeMeli)
            {
                <button class="p2-btn" style="background:#1d4f80;border-color:#1d4f80;"
                        disabled="@trayendoDeMeli"
                        title="@TituloTraer"
                        @onclick="TraerDeMeli">
                    @(trayendoDeMeli ? (traerProgreso ?? "⏳ Trayendo…") : TextoTraer)
                </button>
                @if (!trayendoDeMeli && FamiliaDeLaBuscada is { } famB)
                {
                    <button class="p2-btn" style="background:#fff;color:#1d4f80;border-color:#1d4f80;"
                            title="Trae de MercadoLibre todas las publicaciones de la familia @famB"
                            @onclick="() => TraerFamilia(famB)">
                        ⬇ Traer toda la familia
                    </button>
                }
            }
        </div>

        <div class="p2-filters">
            <span class="p2-lbl">Filtros</span>
            <span class="p2-chip @(fEstado == "" ? "on" : "")" @onclick='() => SetEstado("")'>Todas</span>
            <span class="p2-chip @(fEstado == "activas" ? "on" : "")" @onclick='() => SetEstado("activas")'>Activas</span>
            <span class="p2-chip @(fEstado == "pausadas" ? "on" : "")" @onclick='() => SetEstado("pausadas")'>Pausadas</span>

            @if (cuentas.Count > 1)
            {
                foreach (var c in cuentas)
                {
                    <span class="p2-chip @(fCuentaId == c.Id ? "on" : "")" @onclick="() => SetCuenta(c.Id)">@c.Nickname</span>
                }
            }

            @* 2026-09-22 — Osmar: "que estén todas en un desplegable porque marean". Quedan a la
               vista solo estado y cuenta; el resto va en un botón. Si hay alguno puesto, el botón
               lo dice (para que no quede un filtro escondido achicando la lista sin darse cuenta). *@
            <span class="p2-fmenu">
                <span class="p2-chip nue @(FiltrosMenuActivos.Count > 0 ? "on" : "")" @onclick="() => menuFiltros = !menuFiltros">
                    @(FiltrosMenuActivos.Count > 0 ? "Filtro: " + string.Join(" · ", FiltrosMenuActivos) : "Más filtros") ▾
                </span>
                @if (menuFiltros)
                {
                    <div class="p2-fmenu-fondo" @onclick="() => menuFiltros = false"></div>
                    <div class="p2-fmenu-lista">
                        <div class="grp">Margen</div>
                        <div class="opc @(fNoLlegan == 50 ? "on" : "")" @onclick="() => ElegirFiltro(() => SetNoLlegan(50))"><span class="tic">@(fNoLlegan == 50 ? "✓" : "")</span>No llegan al 50%</div>
                        <div class="opc @(fNoLlegan == 30 ? "on" : "")" @onclick="() => ElegirFiltro(() => SetNoLlegan(30))"><span class="tic">@(fNoLlegan == 30 ? "✓" : "")</span>No llegan al 30%</div>
                        <div class="opc @(fNoLlegan == 70 ? "on" : "")" @onclick="() => ElegirFiltro(() => SetNoLlegan(70))"><span class="tic">@(fNoLlegan == 70 ? "✓" : "")</span>No llegan al 70%</div>

                        <div class="grp">Comisión de MeLi</div>
                        <div class="opc @(fComision == 30 ? "on" : "")" @onclick="() => ElegirFiltro(() => SetComision(30))"><span class="tic">@(fComision == 30 ? "✓" : "")</span>MeLi se lleva más de 30%</div>
                        <div class="opc @(fComision == 40 ? "on" : "")" @onclick="() => ElegirFiltro(() => SetComision(40))"><span class="tic">@(fComision == 40 ? "✓" : "")</span>MeLi se lleva más de 40%</div>

                        <div class="grp">Precios</div>
                        <div class="opc @(fVariosPrecios ? "on" : "")" @onclick="() => ElegirFiltro(ToggleVarios)"><span class="tic">@(fVariosPrecios ? "✓" : "")</span>Hermanas iguales a distinto precio</div>
                        <div class="opc @(fPrecioAMano ? "on" : "")" @onclick="() => ElegirFiltro(TogglePrecioMano)"><span class="tic">@(fPrecioAMano ? "✓" : "")</span>Precio a mano</div>

                        <div class="grp">Datos</div>
                        <div class="opc @(fSinCosto ? "on" : "")" @onclick="() => ElegirFiltro(ToggleSinCosto)"><span class="tic">@(fSinCosto ? "✓" : "")</span>Sin costo cargado</div>
                        <div class="opc @(fComisionVieja ? "on" : "")" @onclick="() => ElegirFiltro(ToggleComisionVieja)"><span class="tic">@(fComisionVieja ? "✓" : "")</span>Con datos viejos</div>

                        <div class="grp">Cuotas y promos</div>
                        <div class="opc @(fEnPromo ? "on" : "")" @onclick="() => ElegirFiltro(ToggleEnPromo)"><span class="tic">@(fEnPromo ? "✓" : "")</span>En promoción</div>
                        <div class="opc @(fCuotas == "12x_campaign" ? "on" : "")" @onclick='() => ElegirFiltro(() => SetCuotas("12x_campaign"))'><span class="tic">@(fCuotas == "12x_campaign" ? "✓" : "")</span>Cuotas: 12x</div>
                        <div class="opc @(fCuotas == "sin" ? "on" : "")" @onclick='() => ElegirFiltro(() => SetCuotas("sin"))'><span class="tic">@(fCuotas == "sin" ? "✓" : "")</span>Sin cuotas</div>
                    </div>
                }
            </span>
            @if (HayFiltros)
            {
                <span class="p2-chip" style="border-color:#b91c1c;color:#b91c1c;" @onclick="LimpiarFiltros">✕ Limpiar</span>
            }
        </div>

        @* 2026-09-22 — se buscó un número: se muestra lo pedido y se ofrece ampliar. *@
        @if (datos?.Grupo is { } gr)
        {
            <div class="p2-ampliar">
                @if (gr.Modo == "sola")
                {
                    <text>Mostrando solo la publicación <b>@gr.Mla</b></text>
                }
                else if (gr.Modo == "familia")
                {
                    <text>Mostrando <b>toda la familia</b> (@gr.Familia)</text>
                }
                else
                {
                    <text>Mostrando <b>todas las del mismo producto</b> (@gr.Producto) — incluye otras publicaciones con el mismo SKU</text>
                }
                @if (gr.Mla is not null && gr.Modo != "sola")
                {
                    <text> · </text><a @onclick='() => Ampliar(null)'>Ver solo @gr.Mla</a>
                }
                @if (gr.Modo != "familia" && gr.Familia > 1)
                {
                    <text> · </text><a @onclick='() => Ampliar("familia")'>Ver toda su familia (@gr.Familia)</a>
                }
                @if (gr.Modo != "producto" && gr.Producto > gr.Familia)
                {
                    <text> · </text><a @onclick='() => Ampliar("producto")'>Ver todas las del mismo producto (@gr.Producto)</a>
                }
            </div>
        }

        <div class="p2-count">
            <span>
                @if (datos is not null)
                {
                    <text>Mostrando <b>@datos.Items.Count</b> de <b>@datos.Total.ToString("N0", ar)</b> publicaciones</text>
                }
            </span>
            <span>
                <button class="p2-pg" @onclick="() => IrAPagina(pagina - 1)" disabled="@(pagina <= 1 || cargando)">◀</button>
                <span class="p2-pg">Página @pagina de @TotalPaginas</span>
                <button class="p2-pg" @onclick="() => IrAPagina(pagina + 1)" disabled="@(pagina >= TotalPaginas || cargando)">▶</button>
                <select class="p2-pg" @onchange="CambiarPorPagina" style="cursor:pointer;">
                    <option value="50" selected="@(porPagina == 50)">50 por página</option>
                    <option value="100" selected="@(porPagina == 100)">100 por página</option>
                    <option value="200" selected="@(porPagina == 200)">200 por página</option>
                </select>
            </span>
        </div>

        <div class="p2-tbl">
            <div class="p2-th">
                <span><input type="checkbox" class="p2-chk" checked="@TodasTildadas" @onchange="TildarTodas" title="Tildar todas las de esta página" /></span>
                <span>Producto</span>
                <span class="p2-h">Precio · tildá cuál · te queda</span>
                <span class="p2-h">La cuenta</span>
                <span class="p2-h2">Stock</span>
                <span class="p2-h2">Estado</span>
            </div>

            @if (cargando)
            {
                <div class="p2-empty">⏳ Buscando…</div>
            }
            else if (datos is null || datos.Items.Count == 0)
            {
                <div class="p2-empty">No hay publicaciones con esos filtros.</div>
            }
            else
            {
                @foreach (var it in datos.Items)
                {
                    @* 2026-08-26 — Osmar: "que apenas toco la publicación me dé esas opciones es
                       demasiado incómodo, siempre no voy a usar esto". La fila ya no abre nada sola:
                       el peso y las medidas tienen su botón (la balanza) y las fotos el suyo. *@
                    <div class="p2-tr @(tildadas.Contains(it.MeliItemId) ? "sel" : "")">
                        <span>
                            <input type="checkbox" class="p2-chk"
                                   checked="@tildadas.Contains(it.MeliItemId)"
                                   @onchange="() => ToggleTildada(it.MeliItemId)" />
                        </span>

                        <span class="p2-pinfo v2">
                            @if (!string.IsNullOrEmpty(it.Thumbnail))
                            {
                                <img class="p2-thumb clickable" src="@it.Thumbnail" alt="" loading="lazy"
                                     title="Ver y cambiar las fotos de esta publicación"
                                     @onclick="() => ToggleFotos(it.MeliItemId)" />
                            }
                            else
                            {
                                <span class="p2-thumb vacia clickable" title="Ver y cambiar las fotos de esta publicación"
                                      @onclick="() => ToggleFotos(it.MeliItemId)"></span>
                            }
                            @* 2026-09-22 — Osmar: los 4 botones eran muy chicos y había que adivinar cuál era
                               cuál. Van de a 2 y cada uno dice qué abre (opción B que eligió). *@
                            <span class="p2-botones">
                                <button class="@(descAbierta == it.MeliItemId ? "on" : "")"
                                        title="Descripción: la que tiene hoy en MercadoLibre, para leerla y cambiarla"
                                        @onclick="() => ToggleDescripcion(it.MeliItemId)" @onclick:stopPropagation="true"><span class="ic">📝</span>Descripción</button>
                                <button class="@(fichaAbierta == it.MeliItemId ? "on" : "")"
                                        title="Ficha técnica: qué datos le faltan para que la encuentren en los filtros de MercadoLibre"
                                        @onclick="() => ToggleFicha(it.MeliItemId)" @onclick:stopPropagation="true"><span class="ic">📋</span>Ficha</button>
                                <button class="@(promosAbiertas == it.MeliItemId ? "on" : "")"
                                        title="Promociones: en qué campañas puede entrar y qué te queda con cada una"
                                        @onclick="() => TogglePromosItem(it.MeliItemId)" @onclick:stopPropagation="true"><span class="ic">🏷️</span>Promos</button>
                                <button class="@(medidasAbiertas == it.MeliItemId ? "on" : "")"
                                        title="Peso y medidas del paquete — de acá sale el envío"
                                        @onclick="() => ToggleMedidas(it.MeliItemId)"><span class="ic">⚖</span>Medidas</button>
                            </span>
                            <span class="p2-txt">
                            <span class="p2-t" title="@it.Titulo">@it.Titulo
                                @if (it.Vendidas > 0)
                                {
                                    <span class="p2-vend">(@it.Vendidas.ToString("N0", ar) @(it.Vendidas == 1 ? "vendida" : "vendidas"))</span>
                                }
                            </span>
                            @* 2026-09-22 — en palabras y con letra normal: antes era un renglón de
                               códigos grises en letra de máquina que mareaba. La cuenta pasó a la
                               columna del estado y las cuotas abajo del precio. *@
                            @* 2026-09-22 — (opción 2 de Osmar) el SKU y de qué se arma en el MISMO renglón:
                               "SKU C1925BL (C2144BL + C7000BL → alcanza para 68)". El paréntesis se toca
                               para corregir el armado; lo que hay de cada pieza sale al pasar el mouse. *@
                            <span class="p2-m2">SKU <b>@(it.Sku ?? "—")</b> <span class="p2-rec tocable @(recetaAbierta == it.MeliItemId ? "on" : "")"
                                  title="Tocá para ver y corregir de qué se compone esta publicación"
                                  @onclick="() => ToggleReceta(it.MeliItemId)" @onclick:stopPropagation="true">(@RecetaFragment(it))</span></span>
                            <span class="p2-m2"><span class="@(string.IsNullOrEmpty(it.Envio) || it.Envio == "not_specified" ? "sindato" : "")" title="@TituloEnvio(it)">@EnvioConPalabra(it.Envio)@(it.EnvioGratis ? ", lo pagás vos" : "")</span>@(it.PublisFamilia > 1 ? $" · {it.PublisFamilia} publicaciones" : "") · <span class="mla">@it.MeliItemId</span></span>
                            @* 2026-08-27 · si el SKU dice la marca de "para revisar", se avisa acá y
                               se ofrece devolverle el SKU verdadero, que el sistema guardó al marcarla. *@
                            @if (!string.IsNullOrEmpty(it.SkuAnterior))
                            {
                                <span class="p2-marca" @onclick:stopPropagation="true">
                                    📌 Marcada para revisar · el SKU de verdad es <b>@it.SkuAnterior</b>
                                    <button disabled="@(skuEnCurso == it.MeliItemId)"
                                            title="Le devuelve el SKU @it.SkuAnterior en MercadoLibre. NO la activa: queda como está."
                                            @onclick="() => DevolverSku(it)" @onclick:stopPropagation="true">
                                        @(skuEnCurso == it.MeliItemId ? "···" : "↩ Devolvérselo")
                                    </button>
                                </span>
                            }
                            @* 2026-08-29 · el renglón de la receta se toca y se edita ahí mismo.
                               Era lo último que obligaba a volver a la pantalla vieja. *@
                            </span>
                        </span>

                        @* 2026-09-22 — Osmar: ver el precio OEM, el que tiene hoy y el que deja el objetivo, y
                           TILDAR cuál quiere (más uno a mano). La opción tildada dice también quién manda:
                           "Para el N%" = el sistema lo mantiene solo; cualquier otra = queda fijo. Eso
                           reemplaza al ✎, a los cartelitos 🎯/💲 y a la perilla del sincro de precio. *@
                        @* 2026-09-22 (2ª vuelta, idea de Osmar): tres opciones y cada una dice qué % deja.
                           Queda marcada la que manda: "Mantener el N%" si el sistema mantiene el %, OEM si
                           el precio es el de lista, y si no Manual con el número escrito. El casillero del %
                           arranca con el que deja el precio de hoy: cargás un precio a mano y tildás
                           "mantener" para que siga dejando ESE porcentaje. Reemplaza a la columna "Te queda". *@
                        @{
                            var selP = editandoPrecio == it.MeliItemId ? "manual"
                                     : MandaElPorcentaje(it) ? "obj"
                                     : (it.PrecioOem is decimal oemSel && oemSel == Math.Round(it.Precio, 0)) ? "oem" : "manual";
                            var objRef = it.ObjetivoPct ?? 50m;
                            var pctTxt = PctEscrito(it);
                            var pctNum = ParsePct(pctTxt);
                            var precioParaPct = pctNum is decimal pn ? PrecioParaPct(it, pn) : null;
                        }
                        <span class="p2-h p2-precios" @onclick:stopPropagation="true">
                            @if (it.PrecioOem is decimal oem)
                            {
                                var mOem = selP == "oem" ? it.MargenPct : MargenA(it, oem);
                                <button class="p2-po @(selP == "oem" ? "sel" : "")" disabled="@(precioGuardando)"
                                        title="Precio de lista (OEM de Colombraro, o el de las piezas si no hay uno del producto completo). Tocá para publicarlo fijo."
                                        @onclick='() => ElegirPrecioFijo(it, oem, "el precio OEM")'><span class="rd"></span><span>OEM</span><b>@Plata(oem)</b><span class="pp @ClasePct(mOem, objRef)">@TextoPct(mOem, selP != "oem")</span>
                                    @if (selP == "oem") { <span class="nota">precio de lista, queda fijo</span> }
                                </button>
                            }
                            @if (editandoPrecio == it.MeliItemId)
                            {
                                var mSim = simulacion?.MargenPct;
                                <span class="p2-po sel"><span class="rd"></span><span>Manual</span><b></b><span class="pp @ClasePct(mSim, objRef)">@(simulando ? "···" : TextoPct(mSim, false))</span></span>
                                <span class="p2-edit" @onclick:stopPropagation="true">
                                    <input type="text" value="@precioEscrito"
                                           @oninput="@(async e => { precioEscrito = e.Value?.ToString() ?? ""; await PrecioEscritoCambio(); })"
                                           @onkeydown="@(async e => { if (e.Key == "Enter") await ConfirmarPrecio(it); if (e.Key == "Escape") CancelarPrecio(); })"
                                           autofocus />
                                    <span class="pie">
                                        <span class="antes">antes @Plata(it.Precio)</span>
                                        <button class="ok" title="Publicar este precio (Enter)" disabled="@precioGuardando"
                                                @onclick="() => ConfirmarPrecio(it)">✓</button>
                                        <button class="no" title="Cancelar (Esc)" @onclick="CancelarPrecio">✕</button>
                                    </span>
                                </span>
                                @if (simulacion?.CruzaEscalonEnvio == true && simulacion.MargenSiPagasElEnvioPct is decimal m3)
                                {
                                    <span class="p2-pinfo2 mal">si el envío pasa a ser tuyo: @m3.ToString("0.#", ar)%</span>
                                }
                                else if (!simulando && simulacion?.MargenPct is null && !string.IsNullOrEmpty(simulacion?.Aviso))
                                {
                                    <span class="p2-pinfo2 mal">@simulacion.Aviso</span>
                                }
                            }
                            else if (selP == "manual")
                            {
                                <button class="p2-po sel" disabled="@(precioGuardando)" title="Precio fijo: el sistema no lo toca. Tocá para escribir otro."
                                        @onclick="() => EmpezarPrecio(it)"><span class="rd"></span><span>Manual</span><b>@Plata(it.Precio)</b><span class="pp @ClasePct(it.MargenPct, objRef)" style="@(it.ComisionVieja ? "opacity:.55;" : "")">@TextoPct(it.MargenPct, false)</span>
                                    <span class="nota">queda fijo, el sistema no lo toca</span>
                                </button>
                            }
                            else
                            {
                                <button class="p2-po" disabled="@(precioGuardando)" title="Escribir un precio a mano (queda fijo)"
                                        @onclick="() => EmpezarPrecio(it)"><span class="rd"></span><span>Manual</span><b style="font-weight:400;color:#9ca3af;">escribir…</b><span class="pp"></span></button>
                            }
                            @* 2026-08-31 · si está en campaña, el comprador paga MENOS que el precio de
                               lista. Sin este cartel, el "te queda" no se entiende. *@
                            @if (it.PromoPrecio is > 0)
                            {
                                <span class="p2-promo" title="Está en una campaña de MercadoLibre: el comprador paga @Plata(it.PromoPrecio!.Value). El margen ya está calculado con ese precio.">
                                    🏷️ @Plata(it.PromoPrecio!.Value)
                                    <small>@(it.PromoNombre ?? "en promoción")@(it.PromoHasta.HasValue ? $" · hasta {it.PromoHasta.Value:dd/MM}" : "")</small>
                                </span>
                            }
                            <span class="p2-po @(selP == "obj" ? "sel" : "")" role="button"
                                  title="@(selP == "obj" ? $"El sistema mantiene el {objRef:0.#}% solo: si cambia el costo o lo que cobra MeLi, recalcula el precio. Para otro %, escribilo y tocá la bolita." : "Tocá la bolita para que el sistema mantenga este porcentaje solo. Arranca con el que deja el precio de hoy; podés escribir otro.")"
                                  @onclick="() => ElegirObjetivo(it)">
                                <span class="rd"></span><span>Mantener el</span>
                                <b><input class="pctin" value="@pctTxt" @onclick:stopPropagation="true"
                                          @oninput="@(e => pctEscritos[it.MeliItemId] = e.Value?.ToString() ?? "")"
                                          @onkeydown="@(async e => { if (e.Key == "Enter") await ElegirObjetivo(it); })" /> %</b>
                                @* 2026-09-22 — Osmar: "ese porcentaje tiene que ser mi guía". Marcada, lo grande es
                                   el % que deja HOY de verdad, no el que se pidió. Si quedó abajo, se dice y se
                                   ofrece volver a aplicarlo; si está arriba porque no baja del OEM, también se dice. *@
                                @if (selP == "obj")
                                {
                                    var real = it.MargenPct;
                                    var abajo = real is decimal ra && ra < objRef - 2m;
                                    var porPiso = !abajo && real is decimal rb && rb > objRef + 0.1m && it.PrecioOem is decimal op && Math.Round(it.Precio, 0) <= op;
                                    var motivo = abajo || porPiso ? null : MotivoDiferencia(it, objRef);
                                    <span class="pp @ClasePct(real, objRef)" style="@(it.ComisionVieja ? "opacity:.55;" : "")">@(real is decimal rr ? rr.ToString("0.#", ar) + "%" : "—")</span>
                                    @if (abajo)
                                    {
                                        <span class="venta">@Plata(it.Precio)<small>se vende a esto</small></span>
                                        <span class="nota" style="color:#b91c1c;font-weight:700;">pediste @objRef.ToString("0.#", ar)% · <u @onclick="() => ElegirObjetivo(it, true)" @onclick:stopPropagation="true" style="cursor:pointer;">volver a aplicar ahora</u></span>
                                    }
                                    else if (porPiso)
                                    {
                                        <span class="nota motivo">pediste @objRef.ToString("0.#", ar)% · manda el precio OEM</span>
                                        <span class="venta">@Plata(it.Precio)<small>se vende a esto · no baja del OEM</small></span>
                                    }
                                    else if (motivo is not null)
                                    {
                                        <span class="nota motivo">pediste @objRef.ToString("0.#", ar)% · @motivo</span>
                                        <span class="venta">@Plata(it.Precio)<small>se vende a esto · lo mantiene todos los días</small></span>
                                    }
                                    else
                                    {
                                        <span class="venta">@Plata(it.Precio)<small>se vende a esto · lo mantiene todos los días</small></span>
                                    }
                                }
                                else
                                {
                                    <span class="pp">@(precioParaPct is decimal ppc ? "≈ " + Plata(ppc) : "—")</span>
                                }
                            </span>
                            @if (it.MargenPct is null && editandoPrecio != it.MeliItemId)
                            {
                                <span class="p2-pinfo2 mal">@(it.Costo is null or <= 0 ? "falta cargar el costo" : "falta la comisión — actualizala")</span>
                            }
                            else if (it.ComisionVieja)
                            {
                                <span class="p2-pinfo2 mal" title="La comisión se calculó con otro precio: el % puede estar mal. Traela de MercadoLibre.">⚠ dato viejo</span>
                            }
                            @if (it.VariosPrecios && it.PrecioMin.HasValue && it.PrecioMax.HasValue)
                            {
                                <span class="p2-flag" title="Otra publicación del mismo producto y con las MISMAS condiciones de venta está a otro precio. Eso sí es un descuido.">⚠ hermana igual a otro precio</span>
                                <span class="p2-rango">@Plata(it.PrecioMin.Value) – @Plata(it.PrecioMax.Value)</span>
                            }
                            @* 2026-09-22 — siempre abajo del precio, entre paréntesis (antes iba en el renglón del SKU). *@
                            <span class="p2-opcion" title="@(it.PublisFamilia > 1 ? $"Este producto está publicado {it.PublisFamilia} veces con distintas condiciones de venta. Cada una tiene que valer lo suyo: la que ofrece cuotas paga más comisión." : "Tipo de publicación y cuotas")">(@CuotasTexto(it.Cuotas, it.Tipo).Replace(" · ", ", "))</span>
                        </span>

                        @* 2026-09-21 — LA CUENTA HECHA (opción B que eligió él). Reemplaza a "Se lleva MeLi":
                           lo que paga el comprador, lo que se lleva MeLi, lo que MeLi te deposita
                           ("Recibís", el mismo número de su pantalla) y lo que te queda después de
                           IVA y costo. Todo en gris; sólo se pinta si te queda en negativo. *@
                        <span class="p2-cuenta p2-h">
                            @{ var cta = CuentaDe(it); }
                            @if (cta is null)
                            {
                                <span class="sin">sin datos — actualizá comisiones</span>
                            }
                            else
                            {
                                <span class="ln"><span>@cta.Etiqueta</span><b>@Plata(cta.Precio)</b></span>
                                @* 2026-09-22 — Osmar: "en ningún lado veo el costo de envío". Antes iba sumado en
                                   "− MeLi 43%"; ahora comisión y envío en renglones separados. *@
                                var comSola = cta.Meli - cta.Envio;
                                <span class="ln" title="@(cta.Simulada ? "Lo que cobraría MercadoLibre de comisión a ese precio" : DesgloseComisionSinEnvio(it))">
                                    <span>− Comisión @(cta.Precio > 0 ? Math.Round(comSola / cta.Precio * 100m, 0).ToString("0", ar) : "0")%</span><b>@Plata(comSola)</b>
                                </span>
                                @if (cta.Envio > 0)
                                {
                                    <span class="ln" title="Envío gratis: lo pagás vos (@(cta.Precio > 0 ? Math.Round(cta.Envio / cta.Precio * 100m, 0).ToString("0", ar) : "0")% del precio)">
                                        <span>− Envío</span><b>@Plata(cta.Envio)</b>
                                    </span>
                                }
                                else
                                {
                                    <span class="ln" title="El envío lo paga el comprador"><span>− Envío</span><b style="font-weight:400;color:#9ca3af;">lo paga el comprador</b></span>
                                }
                                <span class="ln tot"><span>= Recibís</span><b>@Plata(cta.Recibis)</b></span>
                                @if (cta.Queda is decimal q)
                                {
                                    <span class="ln" title="IVA @Plata(cta.Iva ?? 0) + costo @Plata(cta.Costo ?? 0)"><span>− IVA y costo</span><b>@Plata((cta.Iva ?? 0) + (cta.Costo ?? 0))</b></span>
                                    <span class="ln tot @(q < 0 ? "neg" : "")"><span>= Te queda</span><b>@(q < 0 ? "−" + Plata(-q) : Plata(q))</b></span>
                                }
                                else
                                {
                                    <span class="sin">falta cargar el costo</span>
                                }
                                @if (it.ComisionVieja && !cta.Simulada)
                                {
                                    <span class="viejo" title="La comisión se calculó con otro precio. La cuenta de esta fila puede estar mal: traela de MercadoLibre.">⚠ dato viejo</span>
                                }
                            }
                        </span>

                        <span class="p2-stk p2-h2 @(it.StockMeli == 0 ? "zero" : "")">
                            @it.StockMeli<small>@(it.StockMeli == 0 ? "SIN STOCK" : "UNID.")</small>
                            @* 2026-09-22 — un tilde y listo (reemplaza al 🔒 + 📦). Pregunta antes de cambiar
                               para que un clic de más no deje una publicación con el stock a mano. *@
                            <button class="p2-stksync @(it.SyncStock ? "on" : "")" disabled="@(sincroEnCurso == it.MeliItemId)"
                                    title="@(it.SyncStock ? "El sistema le manda el stock a MercadoLibre solo. Tocá para dejarlo a mano." : "El stock está a mano. Tocá para que el sistema lo mande solo.")"
                                    @onclick="() => ToggleStockFila(it)" @onclick:stopPropagation="true">
                                <span class="cb">@(it.SyncStock ? "✓" : "")</span>sincroniza
                            </button>
                        </span>

                        <span class="p2-h2">
                            @* 2026-08-27 · idea de Osmar: el cartelito que dice el estado ES el botón
                               para cambiarlo. No hay que aprender dónde está la acción. Sólo se puede
                               tocar con el 🔒 abierto — pausar de un toque sin querer sería feo. *@
                            @if (PuedeCambiarEstado(it))
                            {
                                <button class="p2-st tocable @(it.Estado == "active" ? "a" : "p")"
                                        disabled="@(estadoEnCurso == it.MeliItemId)"
                                        title="@(it.Estado == "active" ? "Tocá para PAUSAR: deja de venderse, pero podés volver cuando quieras" : "Tocá para ACTIVAR: vuelve a venderse, con el stock y el precio al día")"
                                        @onclick="() => CambiarEstado(it)" @onclick:stopPropagation="true">
                                    @(estadoEnCurso == it.MeliItemId ? "···" : (it.Estado == "active" ? "Activa ⏸" : "Pausada ▶"))
                                </button>
                            }
                            else
                            {
                                <span class="p2-st @(it.Estado == "active" ? "a" : it.Estado == "paused" ? "p" : "o")"
                                      title="@(it.Estado is "active" or "paused" ? "Abrí el 🔒 de esta fila para poder cambiar el estado" : "")">@EstadoTexto(it.Estado)</span>
                            }
                            @if (!string.IsNullOrWhiteSpace(it.Cuenta))
                            {
                                <span class="p2-cuentachica" title="Publicada en la cuenta @it.Cuenta">@it.Cuenta</span>
                            }
                        </span>
                    </div>

                    @* 2026-08-31 · FICHA TÉCNICA. Se muestra primero QUÉ FALTA, no un formulario
                       de 40 campos: lo que uno necesita saber en dos segundos es si está completa. *@
                    @if (fichaAbierta == it.MeliItemId)
                    {
                        <div class="p2-receta" @onclick:stopPropagation="true">
                            <h4>📋 Ficha técnica</h4>

                            @if (fichaCargando)
                            {
                                <div class="nota">Preguntándole a MercadoLibre…</div>
                            }
                            else if (fichaDatos is null)
                            {
                                <div class="nota" style="color:#b91c1c;">No se pudo leer la ficha técnica.</div>
                            }
                            else
                            {
                                @if (fichaDeCatalogo)
                                {
                                    <div class="nota" style="color:#b45309; font-weight:600;">
                                        Es una publicación de catálogo: la ficha técnica la maneja MercadoLibre y no se puede editar.
                                    </div>
                                }

                                @if (FichaFaltan.Count == 0)
                                {
                                    <div class="nota" style="color:#15803d; font-weight:700;">
                                        ✓ No le falta ningún dato obligatorio.
                                    </div>
                                }
                                else
                                {
                                    <div class="nota" style="color:#b91c1c; font-weight:700; margin-bottom:.4rem;">
                                        ⚠ Le faltan @FichaFaltan.Count dato(s) que MercadoLibre pide.
                                        Sin eso, no aparece cuando alguien filtra por ellos.
                                    </div>
                                }

                                @foreach (var f in (fichaTodos ? fichaDatos : FichaFaltan))
                                {
                                    <div class="comp">
                                        <span class="nom">@f.Name</span>
                                        @if (f.Required)
                                        {
                                            <span class="mal">obligatorio</span>
                                        }
                                        <span style="flex:1;"></span>
                                        @if (f.Values.Count > 0)
                                        {
                                            <select style="max-width:260px; font-size:.78rem; padding:.2rem .3rem; border:1px solid #cbd5e1; border-radius:.3rem;"
                                                    disabled="@fichaDeCatalogo"
                                                    value="@fichaInput.GetValueOrDefault(f.Id, "")"
                                                    @onchange="e => fichaInput[f.Id] = e.Value?.ToString() ?? string.Empty">
                                                <option value="">— sin completar —</option>
                                                @foreach (var op in f.Values)
                                                {
                                                    <option value="@op.Id">@op.Name</option>
                                                }
                                            </select>
                                        }
                                        else
                                        {
                                            <input style="max-width:260px; font-size:.78rem;" disabled="@fichaDeCatalogo"
                                                   placeholder="@(string.IsNullOrEmpty(f.ValueType) ? "" : f.ValueType)"
                                                   value="@fichaInput.GetValueOrDefault(f.Id, "")"
                                                   @oninput="e => fichaInput[f.Id] = e.Value?.ToString() ?? string.Empty" />
                                        }
                                        @if (fichaLlenadosIA.Contains(f.Id))
                                        {
                                            <span class="ojo">✨ lo puso la IA — revisalo</span>
                                        }
                                    </div>
                                }

                                <div class="buscar">
                                    @if (!fichaDeCatalogo)
                                    {
                                        <button class="btn" disabled="@(fichaIACargando || fichaGuardando)"
                                                title="Mira la publicación y propone los datos que faltan. No pisa lo que ya está cargado."
                                                @onclick="() => CompletarFichaConIA(it)">
                                            @(fichaIACargando ? "Pensando…" : "✨ Completar lo que falta")
                                        </button>
                                        <button class="btn go" disabled="@(fichaGuardando || fichaIACargando)"
                                                @onclick="() => GuardarFicha(it)">
                                            @(fichaGuardando ? "Guardando…" : "💾 Guardar en MercadoLibre")
                                        </button>
                                    }
                                    <button class="btn" @onclick="() => fichaTodos = !fichaTodos">
                                        @(fichaTodos ? "Ver sólo lo que falta" : $"Ver los {fichaDatos.Count} campos")
                                    </button>
                                </div>

                                <div class="nota">
                                    Estos datos son los que usa MercadoLibre para sus filtros de búsqueda
                                    (color, medida, material…). Cuantos más tenga, en más búsquedas aparece.
                                </div>
                            }
                        </div>
                    }

                    @* 2026-08-31 · PROMOCIONES de esta publicación. Lo que no se ve en ningún lado:
                       MercadoLibre dice hasta dónde podés bajar, el sistema sabe tu costo. *@
                    @if (promosAbiertas == it.MeliItemId)
                    {
                        <div class="p2-receta" @onclick:stopPropagation="true">
                            <h4>🏷️ Promociones de esta publicación</h4>

                            @if (promosItemCargando)
                            {
                                <div class="nota">Preguntándole a MercadoLibre…</div>
                            }
                            else if (promosItem is null)
                            {
                                <div class="nota" style="color:#b91c1c;">No se pudieron leer las promociones.</div>
                            }
                            else
                            {
                                @if (!string.IsNullOrEmpty(promosItem.Aviso))
                                {
                                    <div class="nota" style="color:#b45309; font-weight:600;">@promosItem.Aviso</div>
                                }
                                @if (promosItem.Opciones.Count == 0)
                                {
                                    <div class="nota">MercadoLibre no le ofrece ninguna promoción a esta publicación hoy.</div>
                                }
                                else
                                {
                                    <div class="nota" style="margin-bottom:.4rem;">
                                        Precio de lista <b>@Plata(promosItem.PrecioLista)</b>
                                        @if (promosItem.Costo is > 0)
                                        {
                                            <span> · costo <b>@Plata(promosItem.Costo.Value)</b></span>
                                        }
                                        @if (promosItem.Opciones.FirstOrDefault(o => o.PrecioParaElObjetivo is > 0) is { } refe)
                                        {
                                            <span> · para que te quede el @((promosItem.ObjetivoPct ?? 50m).ToString("0", ar))% no deberías bajar de <b>@Plata(refe.PrecioParaElObjetivo!.Value)</b></span>
                                        }
                                    </div>

                                    @foreach (var o in promosItem.Opciones)
                                    {
                                        <div class="comp" style="@(o.Estado == "started" ? "border-color:#fdba74; background:#fff7ed;" : "")">
                                            <span class="nom">@o.Nombre</span>
                                            @if (o.Estado == "started")
                                            {
                                                <span class="ojo">● ESTÁ ADENTRO</span>
                                            }
                                            else
                                            {
                                                <span class="dato">puede entrar</span>
                                            }
                                            @if (o.Hasta.HasValue)
                                            {
                                                <span class="dato">· hasta @o.Hasta.Value.ToString("dd/MM")</span>
                                            }
                                            @if (o.PoneMeliPct is > 0)
                                            {
                                                <span class="dato">· MercadoLibre pone @o.PoneMeliPct.Value.ToString("0.#", ar)%</span>
                                            }

                                            <span style="flex:1;"></span>

                                            @if (o.Estado == "started" && o.PrecioActual is > 0)
                                            {
                                                <span class="dato">se vende a <b>@Plata(o.PrecioActual.Value)</b></span>
                                                @if (o.MargenSugeridoPct.HasValue || o.MargenMaximoPct.HasValue)
                                                {
                                                    <span class="@MargenClase(o.MargenSugeridoPct ?? o.MargenMaximoPct)">te queda @((o.MargenSugeridoPct ?? o.MargenMaximoPct)!.Value.ToString("0.#", ar))%</span>
                                                }
                                                <button class="btn del" disabled="@promoAccionEnCurso"
                                                        title="Saca la publicación de esta campaña. Vuelve a su precio de lista."
                                                        @onclick="() => SacarPromo(it, o)">Sacar de la campaña</button>
                                            }
                                            else
                                            {
                                                @if (o.PrecioSugerido is > 0)
                                                {
                                                    <span class="dato">sugerido <b>@Plata(o.PrecioSugerido.Value)</b></span>
                                                    <span class="@MargenClase(o.MargenSugeridoPct)">
                                                        @(o.MargenSugeridoPct.HasValue ? $"te queda {o.MargenSugeridoPct.Value.ToString("0.#", ar)}%" : "no se puede calcular")
                                                    </span>
                                                }
                                                @if (o.PrecioMinimo is > 0 && o.MargenMinimoPct.HasValue)
                                                {
                                                    <span class="dato">· si bajás al máximo (@Plata(o.PrecioMinimo.Value)) te queda
                                                        <span class="@MargenClase(o.MargenMinimoPct)">@o.MargenMinimoPct.Value.ToString("0.#", ar)%</span>
                                                    </span>
                                                }

                                                <span class="dato">entrar a</span>
                                                <input type="number" step="1" style="width:104px;"
                                                       value="@PrecioEntrarTexto(o)"
                                                       @oninput="e => precioEntrar[ClavePromo(o)] = e.Value?.ToString() ?? string.Empty" />
                                                @if (MargenEscrito(o) is decimal mEsc)
                                                {
                                                    <span class="@MargenClase(mEsc)">deja @mEsc.ToString("0.#", ar)%</span>
                                                }
                                                @if (o.PrecioParaElObjetivo is > 0)
                                                {
                                                    <button class="btn" title="Pone el precio más bajo con el que todavía llegás a tu objetivo"
                                                            @onclick="() => UsarPrecioObjetivo(o)">
                                                        usar el de mi objetivo
                                                    </button>
                                                }
                                                <button class="btn go" disabled="@promoAccionEnCurso"
                                                        @onclick="() => AplicarPromo(it, o)">Entrar</button>
                                            }
                                        </div>
                                    }

                                    @* 2026-08-31 · este cartel decía "todavía no se puede entrar ni salir desde acá"
                                       y quedó viejo cuando se agregaron los botones: contradecía lo que se ve. *@
                                    <div class="nota">
                                        ⚠ Ojo: si le cambiás el precio a una publicación que ya está adentro de una campaña,
                                        <b>MercadoLibre le saca el descuento</b>. Si querés cambiarle el precio y que siga
                                        en la campaña, salí primero, cambiá el precio, y volvé a entrar.
                                    </div>
                                }
                            }
                        </div>
                    }

                    @* 2026-08-29 · RECETA editable. Hasta hoy la pantalla nueva mostraba de qué se
                       compone la publicación pero no dejaba tocarlo, y había que ir a la vieja. *@
                    @if (recetaAbierta == it.MeliItemId)
                    {
                        <div class="p2-receta" @onclick:stopPropagation="true">
                            <h4>🧩 De qué se compone esta publicación</h4>

                            @if (it.Receta is null || it.Receta.Count == 0)
                            {
                                <div class="nota" style="color:#b91c1c; font-weight:600;">
                                    Todavía no está vinculada a ningún producto del sistema. Por eso no se sabe
                                    ni el costo ni el stock. Buscá el producto acá abajo.
                                </div>
                            }
                            else
                            {
                                @foreach (var c in it.Receta)
                                {
                                    <div class="comp">
                                        <span class="nom">@c.Nombre</span>
                                        <span class="cod">@(c.Sku ?? "sin código")</span>
                                        <span class="dato">·</span>
                                        <span class="dato">cada venta descuenta</span>
                                        @if (c.Id > 0)
                                        {
                                            <input type="number" min="1" step="1" value="@CantTexto(c)"
                                                   @oninput="e => recetaCantEdit[c.Id] = e.Value?.ToString() ?? string.Empty" />
                                            @if (CantCambiada(c))
                                            {
                                                <button class="btn go" disabled="@recetaGuardando"
                                                        @onclick="() => GuardarCantidad(it, c)">✓ Guardar</button>
                                            }
                                        }
                                        else
                                        {
                                            <span class="dato"><b>@c.Cantidad.ToString("0.##", ar)</b></span>
                                        }
                                        <span class="dato">· hay <b>@c.Stock.ToString("N0", ar)</b> · alcanza para <b>@c.Alcanza</b></span>

                                        @if (c.Costo <= 0)
                                        {
                                            <span class="mal">⚠ sin costo cargado</span>
                                        }
                                        else if (c.Costo <= 1)
                                        {
                                            <span class="ojo" title="Algunos productos están en $1 a propósito (por ejemplo las tapas que vienen con la caja). Si no es el caso, hay que corregirlo.">⚠ costo $1 — ¿es a propósito?</span>
                                        }
                                        else
                                        {
                                            <span class="dato">costo @Plata(c.Costo)</span>
                                        }

                                        <span style="flex:1;"></span>
                                        @if (c.Id > 0)
                                        {
                                            <button class="btn del" disabled="@recetaGuardando"
                                                    title="Sacar este producto de la receta"
                                                    @onclick="() => QuitarComponente(it, c)">🗑 Sacar</button>
                                        }
                                    </div>
                                }
                            }

                            <div class="buscar">
                                <input class="q" placeholder="Buscá el producto por código o nombre…"
                                       @bind="recetaBusqueda" @bind:event="oninput" />
                                <span class="dato" style="font-size:.72rem; color:#6b7280;">cantidad</span>
                                <input type="number" min="1" step="1" style="width:86px; text-align:right; font-size:.78rem; font-weight:700; border:1px solid #cbd5e1; border-radius:.3rem; padding:.15rem .3rem;"
                                       @bind="recetaCantidadNueva" />
                            </div>

                            @if (productosCargando)
                            {
                                <div class="nota">Cargando los productos…</div>
                            }
                            else if (!string.IsNullOrWhiteSpace(recetaBusqueda))
                            {
                                var encontrados = BuscarProductos(recetaBusqueda);
                                <div class="lista">
                                    @if (encontrados.Count == 0)
                                    {
                                        <div class="op" style="cursor:default; color:#9ca3af;">No encontré ningún producto con eso.</div>
                                    }
                                    @foreach (var pr in encontrados)
                                    {
                                        <div class="op" @onclick="() => AgregarComponente(it, pr)">
                                            <b>@pr.Nombre</b>
                                            <span class="cod">· @(pr.Sku ?? "sin código") · stock @pr.StockUnidades.ToString("N0", ar) · costo @Plata(pr.Costo)</span>
                                        </div>
                                    }
                                </div>
                            }

                            <div class="nota">
                                Si la publicación vende un pack, poné cuántas unidades lleva (por ejemplo <b>100</b>).
                                Si vende una sola unidad, poné <b>1</b>.
                                Al guardar, el sistema le manda el stock a MercadoLibre.
                            </div>
                        </div>
                    }

                    @if (fotosAbiertas == it.MeliItemId)
                    {
                        <div class="p2-fotos" @onclick:stopPropagation="true">
                            <h4>🖼️ Fotos de esta publicación — la primera es la portada</h4>
                            @if (fotosCargando)
                            {
                                <span class="cnt">Consultando a MercadoLibre…</span>
                            }
                            else if (fotosDatos is null)
                            {
                                <span class="aviso err">No se pudieron leer las fotos.</span>
                            }
                            else
                            {
                                <div class="tira">
                                    @for (int i = 0; i < fotosEdit.Count; i++)
                                    {
                                        var idx = i;
                                        var f = fotosEdit[idx];
                                        <div class="pic @(idx == 0 ? "portada" : "")">
                                            @if (idx == 0)
                                            {
                                                <span class="tag">PORTADA</span>
                                            }
                                            else if (f.EsNueva)
                                            {
                                                <span class="tag nueva">NUEVA</span>
                                            }
                                            <img src="@f.Preview" alt="" loading="lazy" />
                                            <span class="btns">
                                                <button title="Mover para adelante" disabled="@(idx == 0 || fotosBloqueadas)"
                                                        @onclick="() => MoverFoto(idx, -1)">◀</button>
                                                <button title="Ponerla de portada" disabled="@(idx == 0 || fotosBloqueadas)"
                                                        @onclick="() => HacerPortada(idx)">★</button>
                                                <button class="del" title="Sacar esta foto" disabled="@fotosBloqueadas"
                                                        @onclick="() => QuitarFoto(idx)">🗑</button>
                                                <button title="Mover para atrás" disabled="@(idx == fotosEdit.Count - 1 || fotosBloqueadas)"
                                                        @onclick="() => MoverFoto(idx, 1)">▶</button>
                                            </span>
                                        </div>
                                    }
                                    @if (!fotosBloqueadas)
                                    {
                                        <label class="subir" title="Subir fotos desde la computadora (JPG o PNG, hasta 10 MB)">
                                            <span class="mas">＋</span>
                                            <span>Subir</span>
                                            <InputFile OnChange="SubirFotos" accept="image/*" multiple style="display:none;" />
                                        </label>
                                    }
                                </div>

                                @if (!fotosBloqueadas)
                                {
                                    <div class="pie">
                                        <input class="link" placeholder="Pegá el enlace de una foto de cualquier página (http…)"
                                               @bind="fotoLink" @bind:event="oninput" disabled="@fotoTrayendo"
                                               @onkeydown="@(async e => { if (e.Key == "Enter") await AgregarFotoPorLink(); })" />
                                        <button class="btn" disabled="@fotoTrayendo" @onclick="AgregarFotoPorLink">
                                            @(fotoTrayendo ? "Trayendo…" : "＋ Agregar por enlace")
                                        </button>
                                    </div>
                                }

                                <div class="pie">
                                    <span class="cnt">@fotosEdit.Count foto@(fotosEdit.Count == 1 ? "" : "s") · máx. 10 MB cada una (JPG o PNG)</span>
                                    @if (!fotosBloqueadas)
                                    {
                                        <button class="btn meli" disabled="@(fotosGuardando || !FotosCambiaron)"
                                                @onclick="() => GuardarFotos(it.MeliItemId)">
                                            @(fotosGuardando ? "Guardando…" : "💾 Guardar en MercadoLibre")
                                        </button>
                                        @if (FotosCambiaron)
                                        {
                                            <button class="btn" disabled="@fotosGuardando" @onclick="DeshacerFotos">↩ Deshacer</button>
                                        }
                                    }
                                    @if (!string.IsNullOrEmpty(fotosDatos.Permalink))
                                    {
                                        <a class="btn" href="@fotosDatos.Permalink" target="_blank">🔗 Ver en MercadoLibre</a>
                                    }
                                </div>

                                @if (fotosDatos.Hermanas.Count > 0)
                                {
                                    <div class="herm">
                                        <h4>Otras publicaciones del mismo producto (@fotosDatos.Sku)</h4>
                                        <span class="cnt">Elegí a cuáles copiarles estas fotos. Les reemplaza TODAS las que tienen ahora.</span>
                                        <div class="lista">
                                            @foreach (var h in fotosDatos.Hermanas)
                                            {
                                                <span class="h @(hermanasElegidas.Contains(h.MeliItemId) ? "sel" : "") @(h.DeCatalogo ? "bloq" : "")"
                                                      title="@(h.DeCatalogo ? "Es de catálogo: MercadoLibre no deja cambiarle las fotos" : h.Titulo)"
                                                      @onclick="() => ToggleHermana(h)">
                                                    @if (!h.DeCatalogo)
                                                    {
                                                        <input type="checkbox" class="p2-chk" checked="@hermanasElegidas.Contains(h.MeliItemId)"
                                                               @onclick:stopPropagation="true" @onchange="() => ToggleHermana(h)" />
                                                    }
                                                    @if (!string.IsNullOrEmpty(h.Thumbnail))
                                                    {
                                                        <img src="@h.Thumbnail" alt="" loading="lazy" />
                                                    }
                                                    <span class="tit">@h.Titulo</span>
                                                    <span class="n">@(h.CantidadFotos < 0 ? "?" : h.CantidadFotos.ToString()) 📷</span>
                                                    @if (h.Vendidas > 0)
                                                    {
                                                        <span class="v" title="Ventas desde que se publicó">@h.Vendidas 🛒</span>
                                                    }
                                                </span>
                                            }
                                        </div>
                                        <div class="pie">
                                            <button class="btn" @onclick="ElegirTodasHermanas">
                                                @(hermanasElegidas.Count > 0 ? "✕ Ninguna" : "✓ Todas")
                                            </button>
                                            <button class="btn copiar" disabled="@(fotosCopiando || hermanasElegidas.Count == 0 || fotosEdit.Count == 0)"
