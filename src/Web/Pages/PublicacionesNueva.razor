                                {
                                    <div class="aviso">@medidas.Mensaje</div>
                                }
                                @if (!string.IsNullOrEmpty(medidasResultado))
                                {
                                    <div class="aviso @(medidasResultadoOk ? "ok" : "err")">@medidasResultado</div>
                                }
                            }
                        </div>
                    }
                }
            }
        </div>

        @if (tildadas.Count > 0)
        {
            <div class="p2-acciones">
                <span class="cnt">@tildadas.Count @(tildadas.Count == 1 ? "publicación tildada" : "publicaciones tildadas")</span>
                <span class="sep"></span>

                <button class="p2-ac go" @onclick="AccComisiones" disabled="@accionEnCurso">💰 Actualizar comisiones</button>

                <span class="p2-ac-obj" title="Objetivo de ganancia sobre el costo">
                    🎯 <input type="number" @bind="objetivoLote" /> %
                </span>
                <button class="p2-ac" @onclick="() => AccObjetivo(false)" disabled="@accionEnCurso">Guardar objetivo</button>

                @* 2026-09-21: UN botón por sincro que dice cómo están las tildadas y qué pasa al tocarlo.
                   Osmar: "si está prendida que el mismo botón diga apagar o prender". Antes eran 3 botones
                   (precio prender / precio apagar / stock prender) y el stock no se podía apagar desde acá.
                   Prender/apagar sólo guarda la configuración; mandar el valor ya es "Publicar precio" / "Mandar stock". *@
                @{ var (sPrecio, aPrecio) = EstadoSincroTildadas(true); var (sStock, aStock) = EstadoSincroTildadas(false); }
                <button class="p2-ac" @onclick="() => AccSincro(aPrecio, null)" disabled="@accionEnCurso"
                        title="@(aPrecio ? "Deja el precio sincronizándose solo de acá en adelante. NO publica el precio ahora: para eso usá 💵 Publicar precio." : "El precio pasa a manejarse a mano: el sistema deja de publicarlo solo.")">💲 Sincro de precio: @sPrecio · @AccionSincroTexto(sPrecio, aPrecio)</button>
                <button class="p2-ac" @onclick="() => AccSincro(null, aStock)" disabled="@accionEnCurso"
                        title="@(aStock ? "Deja el stock sincronizándose solo de acá en adelante. NO le manda el stock ahora: para eso usá 📦 Mandar stock." : "El stock pasa a manejarse a mano: el sistema deja de mandarlo solo.")">📦 Sincro de stock: @sStock · @AccionSincroTexto(sStock, aStock)</button>

                <span class="sep"></span>
                <button class="p2-ac meli" @onclick="() => AccObjetivo(true)" disabled="@accionEnCurso">🎯 Aplicar objetivo y publicar</button>
                <button class="p2-ac meli" @onclick="AccPrecio" disabled="@accionEnCurso">💵 Publicar precio</button>
                <button class="p2-ac meli" @onclick="AccStock" disabled="@accionEnCurso">📦 Mandar stock</button>

                @* 2026-09-04: duplicar las tildadas a la otra cuenta de MeLi (solo si hay dos conectadas). *@
                @if (cuentas.Count == 2)
                {
                    <button class="p2-ac meli" @onclick="AccDuplicar" disabled="@accionEnCurso">⧉ Duplicar a la otra cuenta</button>
                }

                <button class="p2-ac" @onclick="() => { tildadas.Clear(); resultado = null; }" disabled="@accionEnCurso">✕ Limpiar</button>

                @if (accionEnCurso)
                {
                    <span class="cnt">⏳ @accionTexto</span>
                }
                @if (resultado is not null)
                {
                    <div class="p2-res">
                        <b>@resultado.Ok ok · @resultado.Errores con error</b>
                        @foreach (var f in resultado.Detalle.Take(40))
                        {
                            <div class="fila @(f.Ok ? "" : "no")">@(f.Ok ? "✓" : "✗") @f.MeliItemId — @f.Mensaje</div>
                        }
                    </div>
                }
            </div>
        }

        @if (datos is not null && datos.Items.Count > 0)
        {
            <div class="p2-count">
                <span>En el precio tildá cuál querés: el OEM, uno a mano, o «Mantener el %» para que el sistema lo sostenga solo · El % grande es lo que te deja hoy de verdad · El tilde abajo del stock lo sincroniza · Tocando Activa/Pausada la cambiás (pregunta antes) · La foto abre todas las fotos.</span>
                <span>
                    <button class="p2-pg" @onclick="() => IrAPagina(pagina - 1)" disabled="@(pagina <= 1 || cargando)">◀</button>
                    <span class="p2-pg">Página @pagina de @TotalPaginas</span>
                    <button class="p2-pg" @onclick="() => IrAPagina(pagina + 1)" disabled="@(pagina >= TotalPaginas || cargando)">▶</button>
                </span>
            </div>
        }

    </div>

    @* ─── 2026-08-27 · Vista previa del Excel ───
       El paso del medio, el que nunca se saltea: acá se ve QUÉ cambiaría antes de tocar nada.
       Arranca todo tildado menos lo que no se puede hacer, y se destilda lo que no va. *@
    @if (preview is not null)
    {
        <div class="p2-modal-fondo" @onclick="CerrarPreview"></div>
        <div class="p2-modal" @onclick:stopPropagation="true">

            <div class="cab">
                <span class="ttl">
                    @(aplicado is null ? "📋 Esto es lo que cambiaría" : "✅ Listo")
                    @if (aplicado is null && !string.IsNullOrEmpty(preview.BajadoEl))
                    {
                        <small>· archivo bajado el @preview.BajadoEl</small>
                    }
                </span>
                <button class="cerrar" @onclick="CerrarPreview" title="Cerrar">✕</button>
            </div>

            <div class="cuerpo">

                @if (aplicado is null)
                {
                    <div class="resumen">
                        <span class="pill">@preview.FilasLeidas.ToString("N0", ar) filas en el archivo</span>
                        <span class="pill gris">@preview.SinCambios.ToString("N0", ar) sin tocar</span>
                        <span class="pill verde">@preview.ConCambios.ToString("N0", ar) con cambios</span>
                        @if (preview.Bloqueadas > 0)
                        {
                            <span class="pill rojo">@preview.Bloqueadas.ToString("N0", ar) no se pueden</span>
                        }
                        @if (preview.CambianPrecio > 0)
                        {
                            <span class="pill ambar">💵 @preview.CambianPrecio.ToString("N0", ar) cambian el precio en MercadoLibre</span>
                        }
                        @if (preview.CambianObjetivo > 0)
                        {
                            <span class="pill">🎯 @preview.CambianObjetivo.ToString("N0", ar) cambian el objetivo</span>
                        }
                        @if (preview.CambianSincro > 0)
                        {
                            <span class="pill">🔁 @preview.CambianSincro.ToString("N0", ar) cambian el sincro</span>
                        }
                    </div>

                    @foreach (var p in preview.Problemas)
                    {
                        <div class="problema">⚠ @p</div>
                    }

                    @if (preview.Cambios.Count == 0)
                    {
                        <div class="vacio">
                            No hay nada para cambiar: el archivo tiene los mismos valores que el sistema.
                            Acordate de editar las columnas amarillas y <b>guardar</b> el Excel antes de subirlo.
                        </div>
                    }
                    else
                    {
                        <div class="acc-tildar">
                            <button class="p2-btn chico" @onclick="TildarTodosPreview">Tildar todo lo que se puede</button>
                            <button class="p2-btn chico" @onclick="() => preSel.Clear()">Destildar todo</button>
                            <span class="cnt">@preSel.Count elegidos</span>
                        </div>

                        <div class="tabla">
                            @foreach (var c in preview.Cambios)
                            {
                                <div class="fila @(c.Bloqueada ? "bloq" : "") @(preSel.Contains(c.Mla) ? "sel" : "")">
                                    <input type="checkbox" checked="@preSel.Contains(c.Mla)" disabled="@c.Bloqueada"
                                           @onchange="() => TogglePreview(c.Mla)" />
                                    <div class="txt">
                                        <div class="tit">
                                            @c.Titulo
                                            @if (!string.IsNullOrEmpty(c.Sku))
                                            {
                                                <span class="sku">@c.Sku</span>
                                            }
                                            <span class="mla">@c.Mla</span>
                                        </div>
                                        <div class="que">@c.Resumen</div>
                                        @if (c.MargenEstimadoPct.HasValue)
                                        {
                                            <div class="deja @(c.MargenEstimadoPct < 0 ? "mal" : c.MargenEstimadoPct < 50 ? "flojo" : "bien")">
                                                A ese precio te quedaría aprox. @c.MargenEstimadoPct.Value.ToString("0.#", ar)% sobre el costo
                                            </div>
                                        }
                                        @foreach (var a in c.Avisos)
                                        {
                                            <div class="aviso @(c.Bloqueada ? "err" : "")">@a</div>
                                        }
                                    </div>
                                </div>
                            }
                        </div>
                    }
                }
                else
                {
                    <div class="resumen">
                        <span class="pill verde">@aplicado.Ok.ToString("N0", ar) hechos</span>
                        @if (aplicado.Errores > 0)
                        {
                            <span class="pill rojo">@aplicado.Errores.ToString("N0", ar) con error</span>
                        }
                        @if (aplicado.Salteados > 0)
                        {
                            <span class="pill gris">@aplicado.Salteados.ToString("N0", ar) salteados</span>
                        }
                    </div>
                    <div class="tabla">
                        @foreach (var d in aplicado.Detalle)
                        {
                            <div class="fila">
                                <span class="ico @(d.Ok ? "ok" : "no")">@(d.Ok ? "✓" : "✗")</span>
                                <div class="txt">
                                    <div class="tit"><span class="mla">@d.Mla</span></div>
                                    <div class="que">@d.Mensaje</div>
                                </div>
                            </div>
                        }
                    </div>
                }
            </div>

            <div class="pie">
                @if (aplicado is null)
                {
                    @if (confirmando)
                    {
                        <span class="confirmar">
                            @ConfirmacionTexto
                            <button class="p2-btn go" @onclick="AplicarExcel" disabled="@excelAplicando">Sí, dale</button>
                            <button class="p2-btn" @onclick="() => confirmando = false" disabled="@excelAplicando">No</button>
                        </span>
                    }
                    else
                    {
                        <button class="p2-btn" @onclick="CerrarPreview" disabled="@excelAplicando">Cancelar</button>
                        <button class="p2-btn go" @onclick="PedirConfirmacion"
                                disabled="@(excelAplicando || preSel.Count == 0)">
                            @(excelAplicando ? "⏳ Aplicando… no cierres la pantalla" : $"Aplicar {preSel.Count} cambios")
                        </button>
                    }
                }
                else
                {
                    <button class="p2-btn go" @onclick="CerrarPreview">Cerrar</button>
                }
            </div>
        </div>
    }
</div>

@code {
    private static readonly System.Globalization.CultureInfo ar = new("es-AR");

    private ApiClient.PubV2Page? datos;
    private bool cargando;
    private int pagina = 1;
    private int porPagina = 50;   // 2026-08-26: pedido de Osmar, arranca en 50

    private string fTexto = "";
    private string fSku = "";
    private string fEstado = "";
    private decimal? fComision;
    private string fCuotas = "";
    private bool fVariosPrecios;
    private bool fPrecioAMano;
    private bool fSinCosto;
    private decimal? fNoLlegan;

    // Panel de medidas (peso y dimensiones): es lo que define el envío que cobra MeLi.
    // Etapa 2: lo tildado y las acciones
    private readonly HashSet<string> tildadas = new();
    private bool accionEnCurso;
    private string accionTexto = "";
    private ApiClient.PubV2AccionResultado? resultado;
    private decimal objetivoLote = 50;

    private bool TodasTildadas => datos is not null && datos.Items.Count > 0
                                  && datos.Items.All(i => tildadas.Contains(i.MeliItemId));

    private string? medidasAbiertas;
    private ApiClient.PubV2Medidas? medidas;
    private bool medidasCargando, medidasGuardando, medidasResultadoOk;
    private string? medidasResultado;
    private int? edPeso;
    private decimal? edLargo, edAncho, edAlto;
    private bool fComisionVieja;
    private bool fEnPromo;   // 2026-08-31: sólo las que venden con descuento por una campaña

    // 2026-08-27 — Osmar no tenia forma de saber si una publicacion era de FRIKAF o de GROVAS:
    // la fila no lo mostraba aunque el dato ya venia del servidor. Etiqueta en la fila + filtro.
    private int? fCuentaId;
    private List<MeliAccountDto> cuentas = new();

    private bool HayFiltros => fEnPromo || fComisionVieja || fNoLlegan.HasValue || fComision.HasValue || fVariosPrecios || fPrecioAMano || fSinCosto
                               || !string.IsNullOrEmpty(fCuotas) || !string.IsNullOrEmpty(fEstado)
                               || !string.IsNullOrWhiteSpace(fTexto) || !string.IsNullOrWhiteSpace(fSku)
                               || fCuentaId.HasValue;

    private int TotalPaginas => datos is null || datos.Total == 0 ? 1 : (int)Math.Ceiling(datos.Total / (double)datos.PorPagina);

    protected override async Task OnInitializedAsync()
    {
        // Las cuentas solo alimentan los chips del filtro: si falla, la pantalla anda igual.
        try { cuentas = await Api.GetMeliAccountsAsync() ?? new(); } catch { cuentas = new(); }
        await Cargar();
    }

    private async Task Cargar()
    {
        CerrarCandado();   // que no quede una fila abierta de la lista anterior
        cargando = true;
        StateHasChanged();
        try
        {
            datos = await Api.GetPublicacionesV2Async(fTexto, fSku, fEstado, fComision, fCuotas, null,
                fVariosPrecios, fPrecioAMano, fSinCosto, fNoLlegan, fComisionVieja, pagina, porPagina, fCuentaId, fEnPromo, AmpliarVigente);
        }
        catch (Exception ex)
        {
            ToastService.Error("No se pudo cargar: " + ex.Message);
        }
        finally
        {
            cargando = false;
            StateHasChanged();
        }
    }

    /// <summary>2026-09-21 — "Actualizar lista" también relee las promociones de MercadoLibre.
    /// Antes sólo se releían con el botón 🏷️ Promociones, que casi nadie apretaba: del 01/09 al 21/09
    /// el azúcar ABEAZU siguió calculándose con la CYBER FEST vencida. Primero muestra la lista (no
    /// hay que esperar a MeLi para verla) y después, con las promos al día, la vuelve a leer.</summary>
    private async Task ActualizarLista()
    {
        await Cargar();
        if (promosCargando) return;
        promosCargando = true;
        StateHasChanged();
        try
        {
            var (res, error) = await Api.RefrescarPromocionesAsync();
            if (res is null) { ToastService.Error(error ?? "No se pudieron releer las promociones."); return; }
            await Cargar();
        }
        catch (Exception ex) { ToastService.Error("No se pudieron releer las promociones: " + ex.Message); }
        finally { promosCargando = false; StateHasChanged(); }
    }

    private async Task CambiarPorPagina(ChangeEventArgs e)
    {
        if (int.TryParse(e.Value?.ToString(), out var n) && n > 0) porPagina = n;
        pagina = 1;
        await Cargar();
    }

    private async Task BuscarDesdeCero() { pagina = 1; await Cargar(); }
    private async Task OnEnter(KeyboardEventArgs e) { if (e.Key == "Enter") await BuscarDesdeCero(); }
    private async Task IrAPagina(int p) { if (p < 1 || p > TotalPaginas) return; pagina = p; await Cargar(); }
    private async Task SetEstado(string v) { fEstado = v; await BuscarDesdeCero(); }
    private void ToggleTildada(string mla)
    {
        if (!tildadas.Remove(mla)) tildadas.Add(mla);
        resultado = null;
    }

    private void TildarTodas(ChangeEventArgs e)
    {
        if (datos is null) return;
        var prender = e.Value is bool b && b;
        foreach (var i in datos.Items)
        {
            if (prender) tildadas.Add(i.MeliItemId);
            else tildadas.Remove(i.MeliItemId);
        }
        resultado = null;
    }

    /// <summary>Envoltorio común: muestra "en curso", corre la acción y recarga la lista.</summary>
    private async Task Correr(string texto, Func<List<string>, Task<ApiClient.PubV2AccionResultado?>> accion,
        bool pedirConfirmacion = false, string? confirmacion = null)
    {
        var lista = tildadas.ToList();
        if (lista.Count == 0) return;

        if (pedirConfirmacion)
        {
            var ok = await JS.InvokeAsync<bool>("confirm", confirmacion ?? $"Esto cambia {lista.Count} publicaciones en MercadoLibre. ¿Seguro?");
            if (!ok) return;
        }

        accionEnCurso = true;
        accionTexto = texto;
        resultado = null;
        StateHasChanged();
        try
        {
            resultado = await accion(lista);
            if (resultado is null) ToastService.Error("No se pudo completar la acción.");
            else
            {
                if (resultado.Errores == 0) ToastService.Success($"{resultado.Ok} listas.");
                else ToastService.Warning($"{resultado.Ok} ok, {resultado.Errores} con error — mirá el detalle.");
                await Cargar();
            }
        }
        catch (Exception ex) { ToastService.Error("Error: " + ex.Message); }
        finally { accionEnCurso = false; StateHasChanged(); }
    }

    private Task AccComisiones() => Correr("actualizando comisiones…", l => Api.AccionComisionesAsync(l));

    /// <summary>2026-09-21: cómo está el sincro (precio o stock) en las tildadas y qué haría el botón.
    /// Todas prendidas → "prendido", acción apagar. Todas apagadas → "apagado", acción prender.
    /// Mezcladas (o alguna tildada en otra página, que no sabemos cómo está) → "N de M prendidas", prender todas.</summary>
    private (string estado, bool accionPrender) EstadoSincroTildadas(bool precio)
    {
        var visibles = datos?.Items.Where(i => tildadas.Contains(i.MeliItemId))
            .GroupBy(i => i.MeliItemId).Select(g => g.First()).ToList() ?? new();
        var prendidas = visibles.Count(i => precio ? i.SyncPrecio : i.SyncStock);
        var total = tildadas.Count;
        if (visibles.Count == total && prendidas == total) return ("prendido", false);
        if (visibles.Count == total && prendidas == 0) return ("apagado", true);
        // Si hay tildadas en otra página no sabemos cómo están: contamos sobre las que se ven.
        return visibles.Count < total
            ? ($"{prendidas} de {visibles.Count} a la vista prendidas", true)
            : ($"{prendidas} de {total} prendidas", true);
    }

    private static string AccionSincroTexto(string estado, bool prender)
        => !prender ? "apagar" : estado == "apagado" ? "prender" : "prender todas";

    private Task AccSincro(bool? precio, bool? stock)
