    /// <summary>El renglón gris: de qué se compone y para cuántas alcanza. El que frena va en rojo.</summary>
    private MarkupString RecetaFragment(ApiClient.PubV2Fila it)
    {
        if (it.Receta is null || it.Receta.Count == 0)
            return new MarkupString("<span style='color:#b91c1c'>⚠ sin producto del sistema vinculado</span>");

        var partes = it.Receta.Select(c =>
        {
            var cant = c.Cantidad == 1m ? "" : $"{c.Cantidad.ToString("0.##", ar)}× ";
            var txt = $"{cant}<b>{System.Net.WebUtility.HtmlEncode(c.Sku ?? "?")}</b> ({c.Stock})";
            return c.Frena && it.Receta.Count > 1 ? $"<span class='frena'>{txt}</span>" : txt;
        });

        var cola = it.Receta.Count > 1 || (it.Receta.Count == 1 && it.Receta[0].Cantidad != 1m)
            ? $" → <span class='arma'>arma {it.Arma ?? 0}</span>"
            : $" · stock <b>{it.Arma ?? 0}</b>";

        return new MarkupString("🧩 " + string.Join(" + ", partes) + cola);
    }

    // ─────────────── 2026-08-27 · CANDADO POR FILA ───────────────
    // Osmar: prender y apagar el sincro sin tener que tildar y bajar a la barra de acciones,
    // pero "obvio que no quiero que sea solo tocando" — un toque de más sobre 5.925 filas es
    // justo la clase de accidente que hace que después los precios "cambien solos".
    // Entonces: candado cerrado por default, se abre a propósito, y se cierra solo.

    /// <summary>Cuánto queda abierto sin que lo toquen. Cada vez que se usa, el reloj vuelve a cero.</summary>
    private const int SEGUNDOS_CANDADO = 12;

    private string? filaDesbloqueada;
    private string? sincroEnCurso;
    private CancellationTokenSource? candadoReloj;

    private bool FilaAbierta(ApiClient.PubV2Fila it) => filaDesbloqueada == it.MeliItemId;

    private void ToggleCandado(string mla)
    {
        if (filaDesbloqueada == mla) { CerrarCandado(); return; }
        filaDesbloqueada = mla;      // una sola fila abierta por vez
        ArrancarRelojCandado();
    }

    private void CerrarCandado()
    {
        candadoReloj?.Cancel();
        candadoReloj = null;
        filaDesbloqueada = null;
    }

    private void ArrancarRelojCandado()
    {
        candadoReloj?.Cancel();
        var cts = new CancellationTokenSource();
        candadoReloj = cts;
        _ = CerrarSoloAsync(cts);
    }

    private async Task CerrarSoloAsync(CancellationTokenSource cts)
    {
        try { await Task.Delay(TimeSpan.FromSeconds(SEGUNDOS_CANDADO), cts.Token); }
        catch (OperationCanceledException) { return; }   // lo volvieron a tocar: manda el reloj nuevo
        if (cts.IsCancellationRequested || !ReferenceEquals(candadoReloj, cts)) return;
        filaDesbloqueada = null;
        candadoReloj = null;
        await InvokeAsync(StateHasChanged);
    }

    /// <summary>Prende o apaga el sincro de UNA fila. Reusa el mismo endpoint que la barra de
    /// acciones: no hay una segunda forma de hacer lo mismo que después se desincronice.</summary>
    private async Task CambiarSincroFila(ApiClient.PubV2Fila it, bool? precio, bool? stock)
    {
        if (!FilaAbierta(it) || sincroEnCurso is not null) return;

        sincroEnCurso = it.MeliItemId;
        ArrancarRelojCandado();   // usarlo lo mantiene abierto, para poder tocar los dos seguidos
        StateHasChanged();
        try
        {
            var res = await Api.AccionSincroAsync(new List<string> { it.MeliItemId }, precio, stock);
            if (res is null || res.Ok == 0)
            {
                ToastService.Error("No se pudo cambiar el sincro de esta publicación.");
                return;
            }

            // Se actualiza la fila en el lugar en vez de recargar la lista entera: recargar hace
            // saltar el scroll y con 50 filas por página se pierde de vista lo que se estaba mirando.
            var idx = datos?.Items.FindIndex(x => x.MeliItemId == it.MeliItemId) ?? -1;
            if (idx >= 0 && datos is not null)
                datos.Items[idx] = datos.Items[idx] with
                {
                    SyncPrecio = precio ?? datos.Items[idx].SyncPrecio,
                    SyncStock = stock ?? datos.Items[idx].SyncStock
                };

            var que = precio.HasValue
                ? (precio.Value ? "Precio sincronizado: el sistema lo mantiene." : "Precio a mano: el sistema no lo toca más.")
                : (stock!.Value ? "Stock sincronizado." : "Stock a mano.");
            ToastService.Success(que);

            // ─── 2026-08-29 · prender el verde tiene que DEJARLO BIEN, no sólo anotar la intención ───
            // Osmar: *"si aprieto el verde de stock y precio, ya debería estar ok, ¿no te parece?"*.
            // Tenía razón: prender el sincro y que el número siga viejo no se entiende. Antes esto
            // sólo guardaba la configuración y el valor recién se emparejaba cuando algo se movía.
            //
            // El stock va solo; el precio NO. El precio se ve al instante en MercadoLibre y está la
            // trampa del escalón de los $33.000 — un toque distraído puede fundir una publicación
            // (le pasó con la silla Reina). Así que ahí se pregunta.

            if (stock == true)
            {
                var r = await Api.AccionStockAsync(new List<string> { it.MeliItemId });
                var fila = r?.Detalle.FirstOrDefault();
                if (r is not null && r.Ok > 0) ToastService.Success("Stock mandado a MercadoLibre. " + (fila?.Mensaje ?? ""));
                else ToastService.Error("El sincro quedó prendido, pero el stock no se pudo mandar: "
                                        + (fila?.Mensaje ?? "probá con 📦 Mandar stock"));
                await RefrescarFila(it.MeliItemId);
            }
            else if (precio == true)
            {
                if (it.ObjetivoPct is null)
                {
                    ToastService.Info("Ojo: esta publicación no tiene objetivo de ganancia cargado, "
                                      + "así que el sistema todavía no sabe qué precio ponerle.");
                }
                else if (await JS.InvokeAsync<bool>("confirm",
                    $"El sincro quedó prendido.\n\n¿Querés que además le aplique el precio AHORA, "
                    + $"según el objetivo del {it.ObjetivoPct.Value.ToString("0.#", ar)}%?\n\n"
                    + "Esto se ve en MercadoLibre al instante. Si decís que no, el precio se va a "
                    + "acomodar solo la próxima vez que el sistema pase."))
                {
                    var r = await Api.AccionPrecioAsync(new List<string> { it.MeliItemId });
                    var fila = r?.Detalle.FirstOrDefault();
                    if (r is not null && r.Ok > 0) ToastService.Success("Precio aplicado. " + (fila?.Mensaje ?? ""));
                    else ToastService.Error("No se pudo aplicar el precio: " + (fila?.Mensaje ?? "sin detalle"));
                    await RefrescarFila(it.MeliItemId);
                }
            }
        }
        catch (Exception ex) { ToastService.Error("No se pudo cambiar el sincro: " + ex.Message); }
        finally { sincroEnCurso = null; }
    }

    /// <summary>Vuelve a pedir UNA sola fila y la reemplaza en la lista. Se usa después de mandar
    /// stock o precio: recargar la lista entera hace saltar el scroll y se pierde de vista la
    /// publicación con la que se estaba trabajando.</summary>
    private async Task RefrescarFila(string mla)
    {
        try
        {
            var page = await Api.GetPublicacionesV2Async(texto: mla, porPagina: 1);
            var fresca = page?.Items.FirstOrDefault(x => x.MeliItemId == mla);
            if (fresca is null || datos is null) return;
            var idx = datos.Items.FindIndex(x => x.MeliItemId == mla);
            if (idx >= 0) datos.Items[idx] = fresca;
        }
        catch { /* si no se puede refrescar, la fila queda con el dato viejo y no pasa nada grave */ }
    }

    // ─────────────── 2026-08-27 · PAUSAR Y ACTIVAR DESDE LA FILA ───────────────
    // El cartelito de la derecha es el botón. Sólo se puede tocar con el 🔒 abierto, así no se
    // pausa nada de un toque sin querer, y siempre pregunta antes: esto se ve en MercadoLibre
    // al instante. Es de a UNA a propósito — nunca en lote.
    // NO hay eliminar: en MeLi es irreversible y se pierde antigüedad, historial de ventas,
    // preguntas y posición en el buscador. Pausada tampoco vende, y se vuelve.

    // ─────────────── 2026-08-29 · RECETA EDITABLE DESDE LA FILA ───────────────
    // Era lo último que obligaba a volver a la pantalla vieja: para vincular una publicación a su
    // producto había que salir de acá. Y el botón 🔗 de la vieja encima está roto (apunta a unas
    // tablas viejas vacías y dice "no hay productos creados"), así que era fácil terminar creando
    // el producto de nuevo y partiendo el stock en dos.
    //
    // Reusa los endpoints que ya existían (POST/PUT/DELETE /api/meli/componente): esos ya
    // re-pushean el stock solos, así que al guardar la publicación queda con el stock correcto.

    private string? recetaAbierta;
    private bool recetaGuardando, productosCargando;
    private string recetaBusqueda = "";
    private decimal recetaCantidadNueva = 1;
    private List<CafeProductoDto>? productos;
    private readonly Dictionary<int, string> recetaCantEdit = new();

    private async Task ToggleReceta(string mla)
    {
        if (recetaAbierta == mla) { recetaAbierta = null; return; }

        // Los paneles se excluyen: dos abiertos a la vez es un lío en una fila angosta.
        recetaAbierta = mla;
        fotosAbiertas = null;
        medidasAbiertas = null;
        recetaBusqueda = "";
        recetaCantidadNueva = 1;
        recetaCantEdit.Clear();

        // La lista de productos se trae UNA vez y se filtra acá: son ~1.900 y buscar contra el
        // servidor en cada tecla es peor que traerlos una vez.
        if (productos is null && !productosCargando)
        {
            productosCargando = true;
            try { productos = await Api.GetCafeProductosAsync("OTROS"); }
            catch (Exception ex) { ToastService.Error("No se pudieron traer los productos: " + ex.Message); }
            finally { productosCargando = false; }
        }
    }

    /// <summary>Busca por código o por nombre, con varias palabras. El código exacto va primero:
    /// es lo que uno tipea cuando ya sabe cuál quiere.</summary>
    private List<CafeProductoDto> BuscarProductos(string texto)
    {
        if (productos is null) return new();
        var q = texto.Trim().ToLowerInvariant();
        if (q.Length < 2) return new();
        var palabras = q.Split(' ', StringSplitOptions.RemoveEmptyEntries);

        return productos
            .Where(p => palabras.All(w =>
                (p.Sku ?? "").ToLowerInvariant().Contains(w) || p.Nombre.ToLowerInvariant().Contains(w)))
            .OrderByDescending(p => string.Equals(p.Sku, q, StringComparison.OrdinalIgnoreCase))
            .ThenByDescending(p => (p.Sku ?? "").StartsWith(q, StringComparison.OrdinalIgnoreCase))
            .ThenBy(p => p.Nombre)
            .Take(25)
            .ToList();
    }

    private async Task AgregarComponente(ApiClient.PubV2Fila it, CafeProductoDto prod)
    {
        if (recetaGuardando) return;
        if (recetaCantidadNueva <= 0) { ToastService.Error("La cantidad tiene que ser mayor que cero."); return; }

        // La cantidad es el error caro de este formulario: dejarla en 1 cuando la publicación vende
        // un pack manda MILES de unidades a MercadoLibre. Por eso se confirma mostrando la cuenta.
        var alcanza = (int)Math.Floor(prod.StockUnidades / recetaCantidadNueva);
        var aviso = $"Vinculo esta publicación a:\n\n{prod.Nombre} ({prod.Sku})\n\n"
                  + $"Cada venta va a descontar {recetaCantidadNueva.ToString("0.##", ar)} unidad(es).\n"
                  + $"Como hay {prod.StockUnidades.ToString("N0", ar)} en el depósito, le voy a mandar "
                  + $"{alcanza.ToString("N0", ar)} a MercadoLibre.\n\n¿Va así?";
        if (!await JS.InvokeAsync<bool>("confirm", aviso)) return;

        recetaGuardando = true;
        StateHasChanged();
        try
        {
            await Api.CreateComponenteAsync(it.MeliItemId, prod.Id, recetaCantidadNueva);
            ToastService.Success($"Listo: {prod.Sku} × {recetaCantidadNueva.ToString("0.##", ar)}.");
            recetaBusqueda = "";
            await RefrescarFila(it.MeliItemId);
            await AvisarSiElStockNoLlego(it.MeliItemId, alcanza);
        }
        catch (Exception ex) { ToastService.Error("No se pudo vincular: " + ex.Message); }
        finally { recetaGuardando = false; }
    }

    /// <summary>Lo que muestra el campo: lo que el usuario está tipeando, o la cantidad guardada.</summary>
    private string CantTexto(ApiClient.PubV2Componente c)
        => recetaCantEdit.TryGetValue(c.Id, out var v) ? v : c.Cantidad.ToString("0.##", ar);

    private bool CantCambiada(ApiClient.PubV2Componente c)
        => recetaCantEdit.TryGetValue(c.Id, out var v) && v != c.Cantidad.ToString("0.##", ar);

    private async Task GuardarCantidad(ApiClient.PubV2Fila it, ApiClient.PubV2Componente c)
    {
        if (recetaGuardando || !recetaCantEdit.TryGetValue(c.Id, out var txt)) return;
        if (!decimal.TryParse(txt.Replace(',', '.'), System.Globalization.NumberStyles.Any,
                System.Globalization.CultureInfo.InvariantCulture, out var cant) || cant <= 0)
        { ToastService.Error("Poné una cantidad mayor que cero."); return; }

        recetaGuardando = true;
        StateHasChanged();
        try
        {
            if (await Api.UpdateComponenteAsync(c.Id, cant))
            {
                ToastService.Success($"Ahora cada venta descuenta {cant.ToString("0.##", ar)}.");
                recetaCantEdit.Remove(c.Id);
                await RefrescarFila(it.MeliItemId);
            }
            else ToastService.Error("No se pudo cambiar la cantidad.");
        }
        catch (Exception ex) { ToastService.Error("No se pudo cambiar la cantidad: " + ex.Message); }
        finally { recetaGuardando = false; }
    }

    private async Task QuitarComponente(ApiClient.PubV2Fila it, ApiClient.PubV2Componente c)
    {
        if (recetaGuardando) return;
        if (!await JS.InvokeAsync<bool>("confirm",
            $"Saco «{c.Nombre}» de la receta.\n\nSi era el único, la publicación queda sin producto "
            + "y el sistema no va a saber ni su costo ni su stock.\n\n¿Dale?")) return;

        recetaGuardando = true;
        StateHasChanged();
        try
        {
            if (await Api.DeleteComponenteAsync(c.Id))
            {
                ToastService.Success("Sacado de la receta.");
                await RefrescarFila(it.MeliItemId);
            }
            else ToastService.Error("No se pudo sacar.");
        }
        catch (Exception ex) { ToastService.Error("No se pudo sacar: " + ex.Message); }
        finally { recetaGuardando = false; }
    }

    /// <summary>El endpoint que vincula ya manda el stock, pero si eso falla se lo traga y contesta
    /// que salió bien (nos pasó con las tapas de 8 onzas: quedó en 24 en vez de 147). Acá se compara
    /// contra lo que quedó y, si no coincide, se avisa en vez de dejarlo pasar.</summary>
    private async Task AvisarSiElStockNoLlego(string mla, int esperado)
    {
        var fila = datos?.Items.FirstOrDefault(x => x.MeliItemId == mla);
        if (fila is null) return;
        if (fila.StockMeli != esperado)
            ToastService.Error($"Ojo: quedó vinculada, pero MercadoLibre sigue con {fila.StockMeli} "
                             + $"en vez de {esperado}. Tildala y usá 📦 Mandar stock.");
        await Task.CompletedTask;
    }

    private string? estadoEnCurso;
    private string? skuEnCurso;

    /// <summary>Le devuelve a la publicación el SKU que tenía antes de que la marcaran.
    /// ⚠ NO la activa: eso queda para el cartel de estado, que además avisa el margen.</summary>
    private async Task DevolverSku(ApiClient.PubV2Fila it)
    {
        if (string.IsNullOrEmpty(it.SkuAnterior) || skuEnCurso is not null) return;

        var aviso = $"Le vuelvo a poner el SKU:\n\n{it.SkuAnterior}\n\n"
                  + "En MercadoLibre va a dejar de decir la marca y va a decir el SKU de verdad.\n\n"
                  + "NO la voy a activar: queda como está ahora. Cuando la quieras despertar, "
                  + "tocás el cartel de la derecha.\n\n¿Dale?";
        if (!await JS.InvokeAsync<bool>("confirm", aviso)) return;

        skuEnCurso = it.MeliItemId;
        StateHasChanged();
        try
        {
            var (res, error) = await Api.DevolverSkuAsync(it.MeliItemId);
            if (res is null || !res.Ok)
            {
                ToastService.Error(error ?? res?.Mensaje ?? "No se pudo devolver el SKU.");
                return;
            }

            var idx = datos?.Items.FindIndex(x => x.MeliItemId == it.MeliItemId) ?? -1;
            if (idx >= 0 && datos is not null)
                datos.Items[idx] = datos.Items[idx] with { Sku = it.SkuAnterior, SkuAnterior = null };

            ToastService.Success(res.Mensaje);
        }
        catch (Exception ex) { ToastService.Error("No se pudo devolver el SKU: " + ex.Message); }
        finally { skuEnCurso = null; }
    }


    /// <summary>Sólo las activas y las pausadas, y sólo con el candado abierto. Una cerrada o en
    /// revisión no se puede tocar, así que ni se muestra como botón.</summary>
    private bool PuedeCambiarEstado(ApiClient.PubV2Fila it)
        => FilaAbierta(it) && it.Estado is "active" or "paused";

    private async Task CambiarEstado(ApiClient.PubV2Fila it)
    {
        if (!PuedeCambiarEstado(it) || estadoEnCurso is not null) return;
        ArrancarRelojCandado();   // usarlo mantiene la fila abierta

        var pausar = it.Estado == "active";
        var aviso = pausar
            ? $"Vas a PAUSAR:\n\n{it.Titulo}\n\nDeja de venderse, pero no se pierde nada: la podés activar de nuevo cuando quieras."
            : $"Vas a ACTIVAR:\n\n{it.Titulo}\n\nVuelve a venderse. Le mando el stock real, y si tiene objetivo con el sincro prendido le aplico el precio.";

        // Antes de despertar una pausada conviene mirar el precio: la regla es PRECIO PRIMERO,
        // después despertar. Si el margen de hoy no llega al objetivo, se dice acá y no después.
        if (!pausar && it.MargenPct is decimal m)
        {
            var objetivo = it.ObjetivoPct ?? 50m;
            if (m < objetivo)
                aviso += $"\n\n⚠ OJO: hoy te deja {m.ToString("0.#", ar)}% sobre el costo, abajo del {objetivo.ToString("0", ar)}% que pediste."
                       + (m < 0 ? " Está vendiendo A PÉRDIDA." : "");
        }
        else if (!pausar && it.MargenPct is null)
            aviso += "\n\n⚠ OJO: de esta publicación no se sabe qué deja (le falta el costo o la comisión).";

        if (!await JS.InvokeAsync<bool>("confirm", aviso + "\n\n¿Dale?")) return;

        estadoEnCurso = it.MeliItemId;
        StateHasChanged();
        try
        {
            var (res, error) = pausar
                ? await Api.PausarPublicacionAsync(it.MeliItemId)
                : await Api.ActivarPublicacionV2Async(it.MeliItemId);

            if (res is null || !res.Ok)
            {
                ToastService.Error(error ?? res?.Mensaje ?? "No se pudo cambiar el estado.");
                return;
            }

            // Igual que con el candado: se cambia la fila en el lugar, sin recargar la lista.
            var idx = datos?.Items.FindIndex(x => x.MeliItemId == it.MeliItemId) ?? -1;
            if (idx >= 0 && datos is not null && res.EstadoNuevo is not null)
                datos.Items[idx] = datos.Items[idx] with { Estado = res.EstadoNuevo };

            ToastService.Success(res.Mensaje);
            if (!string.IsNullOrWhiteSpace(res.Detalle)) ToastService.Info(res.Detalle!);
        }
        catch (Exception ex) { ToastService.Error("No se pudo cambiar el estado: " + ex.Message); }
        finally { estadoEnCurso = null; }
    }

    // ─────────────── 2026-08-27 · EXCEL EDITABLE ───────────────
    // Bajar lo filtrado → editar en Excel → subir → VISTA PREVIA → aplicar sólo lo tildado.
    // El paso de la vista previa no se saltea nunca: es la única forma de que un archivo con
    // 300 filas no cambie precios que nadie miró.

    private bool excelBajando, excelLeyendo, excelAplicando, confirmando;
    private ApiClient.PubV2ExcelPreview? preview;
    private ApiClient.PubV2ExcelAplicado? aplicado;
    private readonly HashSet<string> preSel = new();

    private async Task BajarExcel()
    {
        excelBajando = true;
        StateHasChanged();
        try
        {
            // Va con los MISMOS filtros que la pantalla: lo que ves es lo que baja, todas las
            // páginas de una. Si filtrás "no llegan al 50%", el Excel trae sólo esas.
            var (bytes, error) = await Api.BajarExcelPublicacionesV2Async(fTexto, fSku, fEstado,
                fComision, fCuotas, null, fVariosPrecios, fPrecioAMano, fSinCosto, fNoLlegan, fComisionVieja);

            if (bytes is null || bytes.Length == 0)
            {
                ToastService.Error(error ?? "No se pudo armar el Excel.");
                return;
            }

            var nombre = $"publicaciones-{DateTime.Now:dd-MM-yyyy-HHmm}.xlsx";
            await JS.InvokeVoidAsync("downloadBytesAsFile", nombre, Convert.ToBase64String(bytes),
                "application/vnd.openxmlformats-officedocument.spreadsheetml.sheet");
            ToastService.Success($"Listo: {nombre}. Editá las columnas amarillas, guardá, y subilo con “⬆ Subir Excel”.");
        }
        catch (Exception ex) { ToastService.Error("No se pudo bajar el Excel: " + ex.Message); }
        finally { excelBajando = false; }
    }

    private async Task SubirExcel(InputFileChangeEventArgs e)
    {
        var file = e.File;
        if (file is null) return;

        excelLeyendo = true;
        aplicado = null;
        preview = null;
        preSel.Clear();
        confirmando = false;
        StateHasChanged();
        try
        {
            // 20 MB: un Excel de 6.000 filas pesa menos de 1 MB, pero conviene dejar aire.
            using var stream = file.OpenReadStream(20 * 1024 * 1024);
            using var ms = new MemoryStream();
            await stream.CopyToAsync(ms);
            ms.Position = 0;

            var (res, error) = await Api.VistaPreviaExcelV2Async(ms, file.Name);
            if (res is null)
            {
                ToastService.Error(error ?? "No se pudo leer el archivo.");
                return;
            }

            preview = res;
            TildarTodosPreview();

            if (res.Cambios.Count == 0 && res.Problemas.Count == 0)
                ToastService.Info("El archivo no trae cambios: quedó igual a lo que hay en el sistema.");
        }
        catch (Exception ex) { ToastService.Error("No se pudo leer el archivo: " + ex.Message); }
        finally { excelLeyendo = false; }
    }

    /// <summary>Arranca con todo tildado menos lo que no se puede hacer: es lo que el usuario
    /// pidió al editar el archivo. Destildar es más rápido que tildar 200 filas.</summary>
    private void TildarTodosPreview()
    {
        if (preview is null) return;
        preSel.Clear();
        foreach (var c in preview.Cambios.Where(x => !x.Bloqueada)) preSel.Add(c.Mla);
    }

    private void TogglePreview(string mla)
    {
        if (!preSel.Remove(mla)) preSel.Add(mla);
    }

    private List<ApiClient.PubV2ExcelCambio> Elegidos =>
        preview?.Cambios.Where(c => preSel.Contains(c.Mla) && !c.Bloqueada).ToList() ?? new();

    /// <summary>Lo que dice el cartel de confirmación. Los precios se nombran aparte porque son
    /// los únicos que se ven en MercadoLibre al instante.</summary>
    private string ConfirmacionTexto
    {
        get
        {
            var elegidos = Elegidos;
            var conPrecio = elegidos.Count(c => c.PrecioNuevo.HasValue);
            if (conPrecio == 0)
                return $"Se van a guardar {elegidos.Count} cambios de configuración. No se toca MercadoLibre. ¿Vamos?";
            return $"⚠ {conPrecio} de estos cambian el precio EN MERCADOLIBRE ahora mismo. ¿Seguro?";
        }
    }

    private void PedirConfirmacion() => confirmando = true;

    private async Task AplicarExcel()
    {
        var elegidos = Elegidos;
        if (elegidos.Count == 0) { confirmando = false; return; }

        excelAplicando = true;
        StateHasChanged();
        try
        {
            var items = elegidos.Select(c => (object)new
            {
                Mla = c.Mla,
                PrecioNuevo = c.PrecioNuevo,
                ObjetivoNuevo = c.ObjetivoNuevo,
                SincPrecioNuevo = c.SincPrecioNuevo,
                SincStockNuevo = c.SincStockNuevo
            }).ToList();

            var (res, error) = await Api.AplicarExcelV2Async(items);
            if (res is null)
            {
                ToastService.Error(error ?? "No se pudieron aplicar los cambios.");
                return;
            }

            aplicado = res;
            confirmando = false;
            if (res.Errores == 0) ToastService.Success($"Listo: {res.Ok} cambios aplicados.");
            else ToastService.Error($"{res.Ok} aplicados y {res.Errores} con error. Mirá el detalle.");

            // La lista de atrás quedó vieja: los precios y los sincros cambiaron.
            await Cargar();
        }
        catch (Exception ex) { ToastService.Error("No se pudieron aplicar los cambios: " + ex.Message); }
        finally { excelAplicando = false; }
    }

    private void CerrarPreview()
    {
        if (excelAplicando) return;   // no dejar cerrar en el medio de una tanda
        preview = null;
        aplicado = null;
        preSel.Clear();
        confirmando = false;
    }
}
