    // ─────────────── 2026-08-31 · FICHA TÉCNICA ───────────────
    // Traída de la pantalla vieja (donde estaba desde el 22/07), pero dada vuelta: primero se
    // muestra QUÉ FALTA y no un formulario de 40 campos. Lo que uno necesita saber en dos segundos
    // es si esa publicación está completa o no.
    //
    // Por qué importa: los atributos son de donde salen los FILTROS DE BÚSQUEDA de MercadoLibre.
    // Si le falta el color o la medida, la publicación no aparece cuando alguien filtra por eso —
    // se pierden ventas sin enterarse.
    //
    // Reusa los endpoints que ya existían: GET/PUT /api/meli/items/{id}/attributes y
    // POST .../suggest-attributes (el que completa con IA).

    private string? fichaAbierta;
    private bool fichaCargando, fichaGuardando, fichaIACargando, fichaDeCatalogo, fichaTodos;
    private List<MeliAttributeFieldDto>? fichaDatos;
    private readonly Dictionary<string, string> fichaInput = new();
    private readonly HashSet<string> fichaLlenadosIA = new();

    /// <summary>Los obligatorios que están vacíos. Es lo primero que se muestra.</summary>
    private List<MeliAttributeFieldDto> FichaFaltan => fichaDatos?
        .Where(f => f.Required && string.IsNullOrWhiteSpace(fichaInput.GetValueOrDefault(f.Id)))
        .ToList() ?? new();

    private async Task ToggleFicha(string mla)
    {
        if (fichaAbierta == mla) { fichaAbierta = null; fichaDatos = null; return; }
        descAbierta = null;   // 2026-09-21: cierra el panel de descripción

        fichaAbierta = mla;
        fichaDatos = null;
        fichaInput.Clear();
        fichaLlenadosIA.Clear();
        fichaTodos = false;
        fichaDeCatalogo = false;
        // Los paneles se excluyen: dos abiertos en una fila angosta es un lío.
        promosAbiertas = null;
        recetaAbierta = null;
        fotosAbiertas = null;
        medidasAbiertas = null;

        fichaCargando = true;
        StateHasChanged();
        try
        {
            var dto = await Api.GetMeliItemAttributesAsync(mla);
            if (dto is null) return;
            fichaDeCatalogo = dto.CatalogListing;
            fichaDatos = dto.Attributes;
            foreach (var f in fichaDatos)
                fichaInput[f.Id] = f.Values.Count > 0 ? (f.CurrentValueId ?? "") : (f.CurrentValueName ?? "");
        }
        catch (Exception ex) { ToastService.Error("No se pudo leer la ficha técnica: " + ex.Message); }
        finally { fichaCargando = false; }
    }

    /// <summary>Le pide a la IA los datos que faltan. NO pisa lo que ya está cargado: lo que puso
    /// una persona vale más que lo que adivina la máquina.</summary>
    private async Task CompletarFichaConIA(ApiClient.PubV2Fila it)
    {
        if (fichaDatos is null || fichaIACargando) return;
        fichaIACargando = true;
        StateHasChanged();
        try
        {
            var sugs = await Api.SuggestItemAttributesAsync(it.MeliItemId);
            if (sugs is null) { ToastService.Error("No se pudo consultar la IA."); return; }

            var puestos = 0;
            foreach (var sug in sugs)
            {
                var campo = fichaDatos.FirstOrDefault(x => x.Id == sug.AttributeId);
                if (campo is null) continue;
                if (!string.IsNullOrWhiteSpace(fichaInput.GetValueOrDefault(campo.Id))) continue;

                if (campo.Values.Count > 0)
                {
                    // Desplegable: hay que mandar un valor de la lista, no texto libre.
                    var op = campo.Values.FirstOrDefault(o => o.Id == sug.ValueId)
                             ?? campo.Values.FirstOrDefault(o => string.Equals(o.Name, sug.ValueName, StringComparison.OrdinalIgnoreCase));
                    if (op is null) continue;
                    fichaInput[campo.Id] = op.Id;
                }
                else
                {
                    if (string.IsNullOrWhiteSpace(sug.ValueName)) continue;
                    fichaInput[campo.Id] = sug.ValueName!;
                }
                fichaLlenadosIA.Add(campo.Id);
                puestos++;
            }

            if (puestos == 0) ToastService.Info("La IA no encontró nada nuevo para completar.");
            else ToastService.Success($"La IA completó {puestos} dato(s). Revisalos y después guardá — todavía no se mandó nada.");
        }
        catch (Exception ex) { ToastService.Error("No se pudo consultar la IA: " + ex.Message); }
        finally { fichaIACargando = false; }
    }

    private async Task GuardarFicha(ApiClient.PubV2Fila it)
    {
        if (fichaDatos is null || fichaGuardando) return;

        var aCargar = fichaInput.Where(kv => !string.IsNullOrWhiteSpace(kv.Value)).ToList();
        if (aCargar.Count == 0) { ToastService.Error("No hay nada para guardar."); return; }

        var conIA = fichaLlenadosIA.Count;
        var aviso = $"Voy a guardar {aCargar.Count} dato(s) en MercadoLibre."
                  + (conIA > 0 ? $"\n\n{conIA} los completó la IA — fijate que estén bien antes de mandarlos." : "")
                  + "\n\n¿Dale?";
        if (!await JS.InvokeAsync<bool>("confirm", aviso)) return;

        fichaGuardando = true;
        StateHasChanged();
        try
        {
            var inputs = aCargar.Select(kv =>
            {
                var campo = fichaDatos.First(f => f.Id == kv.Key);
                return campo.Values.Count > 0
                    ? new SaveAttributeInput { Id = kv.Key, ValueId = kv.Value }
                    : new SaveAttributeInput { Id = kv.Key, ValueName = kv.Value };
            }).ToList();

            var (res, err) = await Api.UpdateMeliItemAttributesAsync(it.MeliItemId,
                new UpdateItemAttributesRequest { Attributes = inputs });

            if (res is null) { ToastService.Error(err ?? "No se pudo guardar la ficha técnica."); return; }

            fichaDatos = res.Attributes;
            fichaInput.Clear();
            foreach (var f in fichaDatos)
                fichaInput[f.Id] = f.Values.Count > 0 ? (f.CurrentValueId ?? "") : (f.CurrentValueName ?? "");
            fichaLlenadosIA.Clear();

            var faltan = FichaFaltan.Count;
            ToastService.Success(faltan == 0
                ? "Ficha técnica guardada. Ya no le falta ningún dato obligatorio."
                : $"Ficha técnica guardada. Todavía le faltan {faltan} dato(s) obligatorio(s).");
        }
        catch (Exception ex) { ToastService.Error("No se pudo guardar: " + ex.Message); }
        finally { fichaGuardando = false; }
    }

    // ── Entrar y salir de campañas ──
    // De a UNA y siempre confirmando: esto se ve en MercadoLibre al instante.

    private bool promoAccionEnCurso;
    private readonly Dictionary<string, string> precioEntrar = new();

    private static string ClavePromo(ApiClient.PubV2PromoOpcion o) => (o.Id ?? "") + "|" + o.Tipo;

    /// <summary>El precio que se va a mandar: lo que el usuario escribió, o el que sugiere MeLi.</summary>
    private string PrecioEntrarTexto(ApiClient.PubV2PromoOpcion o)
        => precioEntrar.TryGetValue(ClavePromo(o), out var v) ? v
           : (o.PrecioSugerido is > 0 ? o.PrecioSugerido.Value.ToString("0", System.Globalization.CultureInfo.InvariantCulture) : "");

    private decimal? PrecioEntrarValor(ApiClient.PubV2PromoOpcion o)
        => decimal.TryParse(PrecioEntrarTexto(o).Replace(',', '.'),
               System.Globalization.NumberStyles.Any,
               System.Globalization.CultureInfo.InvariantCulture, out var v) && v > 0 ? v : null;

    /// <summary>Qué deja el precio que se está escribiendo. Es una CUENTA DE PANTALLA para no ir y
    /// volver al servidor en cada tecla; usa el porcentaje, el cargo fijo y el envío que ya mandó
    /// el servidor. El número que vale es el que devuelve el servidor al aplicar.</summary>
    private decimal? MargenEscrito(ApiClient.PubV2PromoOpcion o)
    {
        var precio = PrecioEntrarValor(o);
        if (precio is null || promosItem?.Costo is not > 0 || promosItem.ComisionPct is not > 0) return null;
        var comision = precio.Value * (promosItem.ComisionPct.Value / 100m) + (promosItem.ComisionFija ?? 0m);
        var neto = (precio.Value - comision - (promosItem.Envio ?? 0m)) / 1.21m;
        return Math.Round((neto - promosItem.Costo.Value) / promosItem.Costo.Value * 100m, 1);
    }

    /// <summary>Completa el campo con el precio más bajo que todavía llega al objetivo.</summary>
    private void UsarPrecioObjetivo(ApiClient.PubV2PromoOpcion o)
    {
        if (o.PrecioParaElObjetivo is not > 0) return;
        precioEntrar[ClavePromo(o)] = o.PrecioParaElObjetivo.Value
            .ToString("0", System.Globalization.CultureInfo.InvariantCulture);
    }

    private async Task AplicarPromo(ApiClient.PubV2Fila it, ApiClient.PubV2PromoOpcion o)
    {
        if (promoAccionEnCurso) return;
        var precio = PrecioEntrarValor(o);
        if (precio is null) { ToastService.Error("Poné a qué precio querés entrar."); return; }

        var margen = MargenEscrito(o);
        var objetivo = promosItem?.ObjetivoPct ?? 50m;

        var aviso = $"Vas a meter esta publicación en:\n\n{o.Nombre}\n\n"
                  + $"Se va a vender a ${precio.Value:N0} en vez de ${promosItem?.PrecioLista ?? it.Precio:N0}.\n";
        if (margen.HasValue)
            aviso += $"Te quedaría {margen.Value.ToString("0.#", ar)}% sobre el costo"
                   + (margen.Value < objetivo ? $" — POR DEBAJO del {objetivo.ToString("0", ar)}% que pedís." : ".") + "\n";
        aviso += "\nOjo: mientras esté en la campaña, si le cambiás el precio se le cae el descuento.\n\n¿Dale?";

        if (!await JS.InvokeAsync<bool>("confirm", aviso)) return;

        promoAccionEnCurso = true;
        StateHasChanged();
        try
        {
            var (res, error) = await Api.AplicarPromocionAsync(it.MeliItemId, o.Id, o.Tipo, precio.Value);
            if (res is null || !res.Ok) { ToastService.Error(error ?? res?.Mensaje ?? "No se pudo entrar a la promoción."); return; }
            ToastService.Success(res.Mensaje);
            await RefrescarFila(it.MeliItemId);
            promosItem = await Api.GetPromocionesDeItemAsync(it.MeliItemId);
        }
        catch (Exception ex) { ToastService.Error("No se pudo entrar a la promoción: " + ex.Message); }
        finally { promoAccionEnCurso = false; }
    }

    private async Task SacarPromo(ApiClient.PubV2Fila it, ApiClient.PubV2PromoOpcion o)
    {
        if (promoAccionEnCurso) return;
        if (!await JS.InvokeAsync<bool>("confirm",
            $"Vas a sacar esta publicación de:\n\n{o.Nombre}\n\n"
            + $"Va a volver a venderse a ${promosItem?.PrecioLista ?? it.Precio:N0}, sin el descuento.\n\n¿Dale?")) return;

        promoAccionEnCurso = true;
        StateHasChanged();
        try
        {
            var (res, error) = await Api.SacarPromocionAsync(it.MeliItemId, o.Id, o.Tipo);
            if (res is null || !res.Ok) { ToastService.Error(error ?? res?.Mensaje ?? "No se pudo sacar de la promoción."); return; }
            ToastService.Success(res.Mensaje);
            await RefrescarFila(it.MeliItemId);
            promosItem = await Api.GetPromocionesDeItemAsync(it.MeliItemId);
        }
        catch (Exception ex) { ToastService.Error("No se pudo sacar de la promoción: " + ex.Message); }
        finally { promoAccionEnCurso = false; }
    }

    /// <summary>Verde si llega al objetivo, ámbar si se acerca, rojo si no da. Mismo criterio que
    /// la columna "te queda", para no tener dos semáforos distintos en la misma pantalla.</summary>
    private string MargenClase(decimal? margen)
    {
        if (margen is null) return "dato";
        var obj = promosItem?.ObjetivoPct ?? 50m;
        if (margen.Value >= obj) return "ok-verde";
        return margen.Value >= obj * 0.6m ? "ojo" : "mal";
    }


    private async Task TraerPromociones()
    {
        if (promosCargando) return;
        promosCargando = true;
        StateHasChanged();
        try
        {
            var (res, error) = await Api.RefrescarPromocionesAsync();
            if (res is null) { ToastService.Error(error ?? "No se pudieron traer las promociones."); return; }

            if (res.ConPromo == 0)
                ToastService.Info($"Miré {res.Campanias} campañas: hoy no tenés ninguna publicación vendiendo con descuento.");
            else
                ToastService.Success($"{res.ConPromo} publicación(es) están vendiendo con descuento. "
                                   + "El margen de esas filas ya está calculado con el precio de la promoción.");

            foreach (var d in res.Detalle.Take(6)) ToastService.Info(d);
            if (res.Limpiadas > 0)
                ToastService.Info($"{res.Limpiadas} salieron de promoción y volvieron a su precio de lista.");

            await Cargar();
        }
        catch (Exception ex) { ToastService.Error("No se pudieron traer las promociones: " + ex.Message); }
        finally { promosCargando = false; }
    }

    // ─────────────── 2026-08-31 · TRAER DE MERCADOLIBRE ───────────────
    // Era lo último que obligaba a volver a la pantalla vieja. "🔄 Actualizar lista" sólo relee lo
    // que el sistema ya tenía guardado; esto le pregunta a MercadoLibre de verdad.
    //
    // Sin menú de opciones: se mira lo que el usuario escribió en el buscador y se hace lo que
    // corresponde. Un MLA trae esa publicación; un número suelto (el de FAMILIA que muestra MeLi)
    // trae la familia entera. Es el mismo criterio que usa el buscador, así que no hay dos reglas
    // distintas que aprender.

    private bool trayendoDeMeli;
    private string? traerProgreso;

    private static bool EsMla(string? t)
    {
        var v = (t ?? "").Trim().TrimStart('#').Trim();
        return v.Length >= 6 && v.StartsWith("MLA", StringComparison.OrdinalIgnoreCase);
    }

    private static bool EsNumeroDeFamilia(string? t)
    {
        var v = (t ?? "").Trim().TrimStart('#').Trim();
        return v.Length >= 6 && v.All(char.IsDigit);
    }

    /// <summary>El botón aparece cuando se sabe QUÉ traer: una publicación, una familia, o —con el
    /// buscador vacío— el catálogo entero. Con texto libre no aparece: no habría qué pedirle a MeLi.</summary>
    private bool PuedeTraerDeMeli => string.IsNullOrWhiteSpace(fTexto) || EsMla(fTexto) || EsNumeroDeFamilia(fTexto);

    private string TextoTraer => string.IsNullOrWhiteSpace(fTexto)
        ? "⬇ Traer TODO de MercadoLibre" : "⬇ Traer de MercadoLibre";

    private string TituloTraer => string.IsNullOrWhiteSpace(fTexto)
        ? "Trae de MercadoLibre las 5.900 publicaciones. Tarda varios minutos."
        : (MlaDelBuscador is not null ? "Le pregunta a MercadoLibre cómo está ESTA publicación ahora"
                                      : "Trae de MercadoLibre todas las publicaciones de esta familia");

    /// <summary>2026-09-22 — La publicación que está escrita en el buscador: un MLA, o un número
    /// suelto que el sistema ya reconoció como publicación (MeLi los muestra con "#" igual que
    /// a las familias). Null si es un número de familia o todavía no se buscó.</summary>
    private string? MlaDelBuscador
    {
        get
        {
            var t = (fTexto ?? "").Trim().TrimStart('#').Trim();
            if (EsMla(t)) return t.ToUpperInvariant();
            return EsNumeroDeFamilia(t) && datos?.Grupo?.Mla == "MLA" + t ? datos.Grupo.Mla : null;
        }
    }

    /// <summary>La familia de la publicación buscada, para ofrecer traerla entera.</summary>
    private string? FamiliaDeLaBuscada =>
        MlaDelBuscador is { } m && datos?.Grupo is { } g && g.Mla == m && !string.IsNullOrEmpty(g.FamiliaId)
            ? g.FamiliaId : null;

    private async Task TraerDeMeli()
    {
        if (trayendoDeMeli) return;
        var t = (fTexto ?? "").Trim().TrimStart('#').Trim();

        // Traer TODO son varios minutos y muchas llamadas a MercadoLibre: se confirma aparte.
        if (t.Length == 0 && !await JS.InvokeAsync<bool>("confirm",
            "Vas a traer de MercadoLibre TODAS las publicaciones.\n\n"
            + "Tarda varios minutos y no conviene cerrar la pantalla mientras corre.\n\n"
            + "Si sólo querés una publicación o una familia, escribí su número en el buscador "
            + "y el botón trae nada más que eso.\n\n¿Dale?")) return;

        trayendoDeMeli = true;
        traerProgreso = null;
        StateHasChanged();
        try
        {
            var mla = MlaDelBuscador;
            // Número suelto que el sistema no conoce todavía: puede ser una publicación nueva o
            // una familia. Primero se prueba como publicación; si MeLi no la tiene, como familia.
            var probarComoPubli = mla is null && t.Length > 0 && EsNumeroDeFamilia(t) && datos?.Grupo is null;
            if (mla is not null || probarComoPubli)
            {
                var (res, error) = await Api.SyncMeliItemByIdAsync(mla ?? "MLA" + t);
                if (res?.TotalSynced > 0)
                    ToastService.Success($"Traída de MercadoLibre: {res.TotalSynced} publicación(es) al día.");
                else if (probarComoPubli)
                {
                    var progressId = await Api.SyncMeliFamilyAsync(t);
                    if (progressId is null) { ToastService.Error("No se pudo traer de MercadoLibre."); return; }
                    await SeguirProgresoAsync(progressId, "Familia traída");
                }
                else if (res is null) { ToastService.Error(error ?? "No se pudo traer de MercadoLibre."); return; }
                else
                    ToastService.Error("MercadoLibre no devolvió nada para ese número. Fijate que esté bien escrito.");
            }
            else if (t.Length == 0)
            {
                // Todo el catálogo. Mismo seguimiento que la familia: el backend devuelve un
                // número y se va preguntando cómo viene.
                var res = await Api.SyncMeliItemsAsync();
                if (res is null || string.IsNullOrEmpty(res.ProgressId))
                {
                    ToastService.Error("No se pudo empezar a traer.");
                    return;
                }
                await SeguirProgresoAsync(res.ProgressId!, "Catálogo traído");
            }
            else
            {
                // La familia puede tener muchas publicaciones: el backend devuelve un número de
                // seguimiento y se va preguntando cómo viene, para no dejar la pantalla muda.
                var progressId = await Api.SyncMeliFamilyAsync(t);
                if (progressId is null) { ToastService.Error("No se pudo empezar a traer la familia."); return; }
                await SeguirProgresoAsync(progressId, "Familia traída");
            }

            await Cargar();   // la lista tiene que mostrar lo que se acaba de traer
        }
        catch (Exception ex) { ToastService.Error("No se pudo traer de MercadoLibre: " + ex.Message); }
        finally { trayendoDeMeli = false; traerProgreso = null; }
    }

    private async Task TraerFamilia(string familiaId)
    {
        if (trayendoDeMeli) return;
        trayendoDeMeli = true;
        traerProgreso = null;
        StateHasChanged();
        try
        {
            var progressId = await Api.SyncMeliFamilyAsync(familiaId);
            if (progressId is null) { ToastService.Error("No se pudo empezar a traer la familia."); return; }
            await SeguirProgresoAsync(progressId, "Familia traída");
            // Queda a la vista lo que se trajo: la familia entera.
            fAmpliar = "familia";
            fAmpliarTexto = (fTexto ?? "").Trim();
            await Cargar();
        }
        catch (Exception ex) { ToastService.Error("No se pudo traer la familia: " + ex.Message); }
        finally { trayendoDeMeli = false; traerProgreso = null; }
    }

    /// <summary>Va preguntando cómo viene el traído y muestra "12 de 30…" en el botón. Sin esto la
    /// pantalla queda muda varios minutos y uno no sabe si está funcionando o se colgó.</summary>
    private async Task SeguirProgresoAsync(string progressId, string textoFinal)
    {
        for (var i = 0; i < 600; i++)   // ~15 minutos de techo
        {
            await Task.Delay(1500);
            var pr = await Api.GetSyncProgressAsync(progressId);
            if (pr is null) break;

            traerProgreso = pr.TotalItemsFound > 0
                ? $"⏳ {pr.ItemsSynced} de {pr.TotalItemsFound}…"
                : "⏳ Trayendo…";
            StateHasChanged();

            if (string.Equals(pr.Status, "completed", StringComparison.OrdinalIgnoreCase))
            {
                ToastService.Success($"{textoFinal}: {pr.ItemsSynced} publicaciones al día."
                                   + (pr.TotalErrors > 0 ? $" ({pr.TotalErrors} con error)" : ""));
                return;
            }
            if (string.Equals(pr.Status, "error", StringComparison.OrdinalIgnoreCase))
            {
                ToastService.Error("MercadoLibre cortó a mitad de camino. Probá de nuevo.");
                return;
            }
        }
        ToastService.Info("Está tardando más de lo normal. Podés seguir usando la pantalla; "
                        + "el traído sigue corriendo por atrás.");
    }

    // ─────────────── 2026-08-29 · RECETA EDITABLE DESDE LA FILA ───────────────
    // Era lo último que obligaba a volver a la pantalla vieja: para vincular una publicación a su
    // producto había que salir de acá. Y el botón 🔗 de la vieja encima está roto (apunta a unas
    // tablas viejas vacías y dice "no hay productos creados"), así que era fácil terminar creando
    // el producto de nuevo y partiendo el stock en dos.
    //
    // Reusa los endpoints que ya existían (POST/PUT/DELETE /api/meli/componente): esos ya
    // re-pushean el stock solos, así que al guardar la publicación queda con el stock correcto.

    private string? recetaAbierta;
    private bool recetaGuardando, productosCargando;
    private string recetaBusqueda = "";
    private decimal recetaCantidadNueva = 1;
    private List<CafeProductoDto>? productos;
    private readonly Dictionary<int, string> recetaCantEdit = new();

    private async Task ToggleReceta(string mla)
    {
        if (recetaAbierta == mla) { recetaAbierta = null; return; }
        descAbierta = null;   // 2026-09-21: cierra el panel de descripción

        // Los paneles se excluyen: dos abiertos a la vez es un lío en una fila angosta.
        recetaAbierta = mla;
        fotosAbiertas = null;
        medidasAbiertas = null;
        recetaBusqueda = "";
        recetaCantidadNueva = 1;
        recetaCantEdit.Clear();

        // La lista de productos se trae UNA vez y se filtra acá: son ~1.900 y buscar contra el
        // servidor en cada tecla es peor que traerlos una vez.
        if (productos is null && !productosCargando)
        {
            productosCargando = true;
            try { productos = await Api.GetCafeProductosAsync("OTROS"); }
            catch (Exception ex) { ToastService.Error("No se pudieron traer los productos: " + ex.Message); }
            finally { productosCargando = false; }
        }
    }

    /// <summary>Busca por código o por nombre, con varias palabras. El código exacto va primero:
    /// es lo que uno tipea cuando ya sabe cuál quiere.</summary>
    private List<CafeProductoDto> BuscarProductos(string texto)
    {
        if (productos is null) return new();
        var q = texto.Trim().ToLowerInvariant();
        if (q.Length < 2) return new();
        var palabras = q.Split(' ', StringSplitOptions.RemoveEmptyEntries);

        return productos
            .Where(p => palabras.All(w =>
                (p.Sku ?? "").ToLowerInvariant().Contains(w) || p.Nombre.ToLowerInvariant().Contains(w)))
            .OrderByDescending(p => string.Equals(p.Sku, q, StringComparison.OrdinalIgnoreCase))
            .ThenByDescending(p => (p.Sku ?? "").StartsWith(q, StringComparison.OrdinalIgnoreCase))
            .ThenBy(p => p.Nombre)
            .Take(25)
            .ToList();
    }

    private async Task AgregarComponente(ApiClient.PubV2Fila it, CafeProductoDto prod)
    {
        if (recetaGuardando) return;
        if (recetaCantidadNueva <= 0) { ToastService.Error("La cantidad tiene que ser mayor que cero."); return; }

        // La cantidad es el error caro de este formulario: dejarla en 1 cuando la publicación vende
        // un pack manda MILES de unidades a MercadoLibre. Por eso se confirma mostrando la cuenta.
        var alcanza = (int)Math.Floor(prod.StockUnidades / recetaCantidadNueva);
        var aviso = $"Vinculo esta publicación a:\n\n{prod.Nombre} ({prod.Sku})\n\n"
                  + $"Cada venta va a descontar {recetaCantidadNueva.ToString("0.##", ar)} unidad(es).\n"
                  + $"Como hay {prod.StockUnidades.ToString("N0", ar)} en el depósito, le voy a mandar "
                  + $"{alcanza.ToString("N0", ar)} a MercadoLibre.\n\n¿Va así?";
        if (!await JS.InvokeAsync<bool>("confirm", aviso)) return;

        recetaGuardando = true;
        StateHasChanged();
        try
        {
            await Api.CreateComponenteAsync(it.MeliItemId, prod.Id, recetaCantidadNueva);
            ToastService.Success($"Listo: {prod.Sku} × {recetaCantidadNueva.ToString("0.##", ar)}.");
            recetaBusqueda = "";
            await RefrescarFila(it.MeliItemId);
            await AvisarSiElStockNoLlego(it.MeliItemId, alcanza);
        }
        catch (Exception ex) { ToastService.Error("No se pudo vincular: " + ex.Message); }
        finally { recetaGuardando = false; }
    }

    /// <summary>Lo que muestra el campo: lo que el usuario está tipeando, o la cantidad guardada.</summary>
    private string CantTexto(ApiClient.PubV2Componente c)
        => recetaCantEdit.TryGetValue(c.Id, out var v) ? v : c.Cantidad.ToString("0.##", ar);

    private bool CantCambiada(ApiClient.PubV2Componente c)
        => recetaCantEdit.TryGetValue(c.Id, out var v) && v != c.Cantidad.ToString("0.##", ar);

    private async Task GuardarCantidad(ApiClient.PubV2Fila it, ApiClient.PubV2Componente c)
    {
        if (recetaGuardando || !recetaCantEdit.TryGetValue(c.Id, out var txt)) return;
        if (!decimal.TryParse(txt.Replace(',', '.'), System.Globalization.NumberStyles.Any,
                System.Globalization.CultureInfo.InvariantCulture, out var cant) || cant <= 0)
        { ToastService.Error("Poné una cantidad mayor que cero."); return; }

        recetaGuardando = true;
        StateHasChanged();
        try
        {
            if (await Api.UpdateComponenteAsync(c.Id, cant))
            {
                ToastService.Success($"Ahora cada venta descuenta {cant.ToString("0.##", ar)}.");
                recetaCantEdit.Remove(c.Id);
                await RefrescarFila(it.MeliItemId);
            }
            else ToastService.Error("No se pudo cambiar la cantidad.");
        }
        catch (Exception ex) { ToastService.Error("No se pudo cambiar la cantidad: " + ex.Message); }
        finally { recetaGuardando = false; }
    }

    private async Task QuitarComponente(ApiClient.PubV2Fila it, ApiClient.PubV2Componente c)
    {
        if (recetaGuardando) return;
        if (!await JS.InvokeAsync<bool>("confirm",
            $"Saco «{c.Nombre}» de la receta.\n\nSi era el único, la publicación queda sin producto "
            + "y el sistema no va a saber ni su costo ni su stock.\n\n¿Dale?")) return;

        recetaGuardando = true;
        StateHasChanged();
        try
        {
            if (await Api.DeleteComponenteAsync(c.Id))
            {
                ToastService.Success("Sacado de la receta.");
                await RefrescarFila(it.MeliItemId);
            }
            else ToastService.Error("No se pudo sacar.");
        }
        catch (Exception ex) { ToastService.Error("No se pudo sacar: " + ex.Message); }
        finally { recetaGuardando = false; }
    }

    /// <summary>El endpoint que vincula ya manda el stock, pero si eso falla se lo traga y contesta
    /// que salió bien (nos pasó con las tapas de 8 onzas: quedó en 24 en vez de 147). Acá se compara
    /// contra lo que quedó y, si no coincide, se avisa en vez de dejarlo pasar.</summary>
    private async Task AvisarSiElStockNoLlego(string mla, int esperado)
    {
        var fila = datos?.Items.FirstOrDefault(x => x.MeliItemId == mla);
        if (fila is null) return;
        if (fila.StockMeli != esperado)
            ToastService.Error($"Ojo: quedó vinculada, pero MercadoLibre sigue con {fila.StockMeli} "
                             + $"en vez de {esperado}. Tildala y usá 📦 Mandar stock.");
        await Task.CompletedTask;
    }

    private string? estadoEnCurso;
    private string? skuEnCurso;

    /// <summary>Le devuelve a la publicación el SKU que tenía antes de que la marcaran.
    /// ⚠ NO la activa: eso queda para el cartel de estado, que además avisa el margen.</summary>
    private async Task DevolverSku(ApiClient.PubV2Fila it)
    {
        if (string.IsNullOrEmpty(it.SkuAnterior) || skuEnCurso is not null) return;

        var aviso = $"Le vuelvo a poner el SKU:\n\n{it.SkuAnterior}\n\n"
                  + "En MercadoLibre va a dejar de decir la marca y va a decir el SKU de verdad.\n\n"
                  + "NO la voy a activar: queda como está ahora. Cuando la quieras despertar, "
                  + "tocás el cartel de la derecha.\n\n¿Dale?";
        if (!await JS.InvokeAsync<bool>("confirm", aviso)) return;

        skuEnCurso = it.MeliItemId;
        StateHasChanged();
        try
        {
            var (res, error) = await Api.DevolverSkuAsync(it.MeliItemId);
            if (res is null || !res.Ok)
            {
                ToastService.Error(error ?? res?.Mensaje ?? "No se pudo devolver el SKU.");
                return;
            }

            var idx = datos?.Items.FindIndex(x => x.MeliItemId == it.MeliItemId) ?? -1;
            if (idx >= 0 && datos is not null)
                datos.Items[idx] = datos.Items[idx] with { Sku = it.SkuAnterior, SkuAnterior = null };

            ToastService.Success(res.Mensaje);
        }
        catch (Exception ex) { ToastService.Error("No se pudo devolver el SKU: " + ex.Message); }
        finally { skuEnCurso = null; }
    }


    /// <summary>Sólo las activas y las pausadas, y sólo con el candado abierto. Una cerrada o en
    /// revisión no se puede tocar, así que ni se muestra como botón.</summary>
    private bool PuedeCambiarEstado(ApiClient.PubV2Fila it)
        => it.Estado is "active" or "paused";   // 2026-09-22: sin candado; CambiarEstado pregunta antes

    private async Task CambiarEstado(ApiClient.PubV2Fila it)
    {
        if (!PuedeCambiarEstado(it) || estadoEnCurso is not null) return;

        var pausar = it.Estado == "active";
        var aviso = pausar
            ? $"Vas a PAUSAR:\n\n{it.Titulo}\n\nDeja de venderse, pero no se pierde nada: la podés activar de nuevo cuando quieras."
            : $"Vas a ACTIVAR:\n\n{it.Titulo}\n\nVuelve a venderse. Le mando el stock real, y si tiene objetivo con el sincro prendido le aplico el precio.";

        // Antes de despertar una pausada conviene mirar el precio: la regla es PRECIO PRIMERO,
        // después despertar. Si el margen de hoy no llega al objetivo, se dice acá y no después.
        if (!pausar && it.MargenPct is decimal m)
        {
            var objetivo = it.ObjetivoPct ?? 50m;
            if (m < objetivo)
                aviso += $"\n\n⚠ OJO: hoy te deja {m.ToString("0.#", ar)}% sobre el costo, abajo del {objetivo.ToString("0", ar)}% que pediste."
                       + (m < 0 ? " Está vendiendo A PÉRDIDA." : "");
        }
        else if (!pausar && it.MargenPct is null)
            aviso += "\n\n⚠ OJO: de esta publicación no se sabe qué deja (le falta el costo o la comisión).";

        if (!await JS.InvokeAsync<bool>("confirm", aviso + "\n\n¿Dale?")) return;

        estadoEnCurso = it.MeliItemId;
        StateHasChanged();
        try
        {
            var (res, error) = pausar
                ? await Api.PausarPublicacionAsync(it.MeliItemId)
                : await Api.ActivarPublicacionV2Async(it.MeliItemId);

            if (res is null || !res.Ok)
            {
                ToastService.Error(error ?? res?.Mensaje ?? "No se pudo cambiar el estado.");
                return;
            }

            // Igual que con el candado: se cambia la fila en el lugar, sin recargar la lista.
            var idx = datos?.Items.FindIndex(x => x.MeliItemId == it.MeliItemId) ?? -1;
            if (idx >= 0 && datos is not null && res.EstadoNuevo is not null)
                datos.Items[idx] = datos.Items[idx] with { Estado = res.EstadoNuevo };

            ToastService.Success(res.Mensaje);
            if (!string.IsNullOrWhiteSpace(res.Detalle)) ToastService.Info(res.Detalle!);
        }
        catch (Exception ex) { ToastService.Error("No se pudo cambiar el estado: " + ex.Message); }
        finally { estadoEnCurso = null; }
    }

    // ─────────────── 2026-08-27 · EXCEL EDITABLE ───────────────
    // Bajar lo filtrado → editar en Excel → subir → VISTA PREVIA → aplicar sólo lo tildado.
    // El paso de la vista previa no se saltea nunca: es la única forma de que un archivo con
    // 300 filas no cambie precios que nadie miró.

    private bool excelBajando, excelLeyendo, excelAplicando, confirmando;
    private ApiClient.PubV2ExcelPreview? preview;
    private ApiClient.PubV2ExcelAplicado? aplicado;
    private readonly HashSet<string> preSel = new();

    private async Task BajarExcel()
    {
        excelBajando = true;
        StateHasChanged();
        try
        {
            // Va con los MISMOS filtros que la pantalla: lo que ves es lo que baja, todas las
            // páginas de una. Si filtrás "no llegan al 50%", el Excel trae sólo esas.
            var (bytes, error) = await Api.BajarExcelPublicacionesV2Async(fTexto, fSku, fEstado,
                fComision, fCuotas, null, fVariosPrecios, fPrecioAMano, fSinCosto, fNoLlegan, fComisionVieja, AmpliarVigente);

            if (bytes is null || bytes.Length == 0)
            {
                ToastService.Error(error ?? "No se pudo armar el Excel.");
                return;
            }

            var nombre = $"publicaciones-{DateTime.Now:dd-MM-yyyy-HHmm}.xlsx";
            await JS.InvokeVoidAsync("downloadBytesAsFile", nombre, Convert.ToBase64String(bytes),
                "application/vnd.openxmlformats-officedocument.spreadsheetml.sheet");
            ToastService.Success($"Listo: {nombre}. Editá las columnas amarillas, guardá, y subilo con “⬆ Subir Excel”.");
        }
        catch (Exception ex) { ToastService.Error("No se pudo bajar el Excel: " + ex.Message); }
        finally { excelBajando = false; }
    }

    private async Task SubirExcel(InputFileChangeEventArgs e)
    {
        var file = e.File;
        if (file is null) return;

        excelLeyendo = true;
        aplicado = null;
        preview = null;
        preSel.Clear();
        confirmando = false;
        StateHasChanged();
        try
        {
            // 20 MB: un Excel de 6.000 filas pesa menos de 1 MB, pero conviene dejar aire.
            using var stream = file.OpenReadStream(20 * 1024 * 1024);
            using var ms = new MemoryStream();
            await stream.CopyToAsync(ms);
            ms.Position = 0;

            var (res, error) = await Api.VistaPreviaExcelV2Async(ms, file.Name);
            if (res is null)
            {
                ToastService.Error(error ?? "No se pudo leer el archivo.");
                return;
            }

            preview = res;
            TildarTodosPreview();

            if (res.Cambios.Count == 0 && res.Problemas.Count == 0)
                ToastService.Info("El archivo no trae cambios: quedó igual a lo que hay en el sistema.");
        }
        catch (Exception ex) { ToastService.Error("No se pudo leer el archivo: " + ex.Message); }
        finally { excelLeyendo = false; }
    }

    /// <summary>Arranca con todo tildado menos lo que no se puede hacer: es lo que el usuario
    /// pidió al editar el archivo. Destildar es más rápido que tildar 200 filas.</summary>
    private void TildarTodosPreview()
    {
        if (preview is null) return;
        preSel.Clear();
        foreach (var c in preview.Cambios.Where(x => !x.Bloqueada)) preSel.Add(c.Mla);
    }

    private void TogglePreview(string mla)
    {
        if (!preSel.Remove(mla)) preSel.Add(mla);
    }

    private List<ApiClient.PubV2ExcelCambio> Elegidos =>
        preview?.Cambios.Where(c => preSel.Contains(c.Mla) && !c.Bloqueada).ToList() ?? new();

    /// <summary>Lo que dice el cartel de confirmación. Los precios se nombran aparte porque son
    /// los únicos que se ven en MercadoLibre al instante.</summary>
    private string ConfirmacionTexto
    {
        get
        {
            var elegidos = Elegidos;
            var conPrecio = elegidos.Count(c => c.PrecioNuevo.HasValue);
            if (conPrecio == 0)
                return $"Se van a guardar {elegidos.Count} cambios de configuración. No se toca MercadoLibre. ¿Vamos?";
            return $"⚠ {conPrecio} de estos cambian el precio EN MERCADOLIBRE ahora mismo. ¿Seguro?";
        }
    }

    private void PedirConfirmacion() => confirmando = true;

    private async Task AplicarExcel()
    {
        var elegidos = Elegidos;
        if (elegidos.Count == 0) { confirmando = false; return; }

        excelAplicando = true;
        StateHasChanged();
        try
        {
            var items = elegidos.Select(c => (object)new
            {
                Mla = c.Mla,
                PrecioNuevo = c.PrecioNuevo,
                ObjetivoNuevo = c.ObjetivoNuevo,
                SincPrecioNuevo = c.SincPrecioNuevo,
                SincStockNuevo = c.SincStockNuevo
            }).ToList();

            var (res, error) = await Api.AplicarExcelV2Async(items);
            if (res is null)
            {
                ToastService.Error(error ?? "No se pudieron aplicar los cambios.");
                return;
            }

            aplicado = res;
            confirmando = false;
            if (res.Errores == 0) ToastService.Success($"Listo: {res.Ok} cambios aplicados.");
            else ToastService.Error($"{res.Ok} aplicados y {res.Errores} con error. Mirá el detalle.");

            // La lista de atrás quedó vieja: los precios y los sincros cambiaron.
            await Cargar();
        }
        catch (Exception ex) { ToastService.Error("No se pudieron aplicar los cambios: " + ex.Message); }
        finally { excelAplicando = false; }
    }

    private void CerrarPreview()
    {
        if (excelAplicando) return;   // no dejar cerrar en el medio de una tanda
        preview = null;
        aplicado = null;
        preSel.Clear();
        confirmando = false;
    }
}
