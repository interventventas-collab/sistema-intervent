    // Dibuja en el mapa las rutas que ya tenemos en memoria (rutasResumen), salteando las zonas
    // que estén ocultas por el ojito. Se usa al optimizar y al prender/apagar un ojito.
    private async Task PintarRutas()
    {
        var paraDibujar = rutasResumen
            .Where(r => (r.Segments?.Count ?? 0) > 0 || !string.IsNullOrEmpty(r.EncodedPolyline))
            .Where(r => !(r.DriverId.HasValue && zonasOcultasMapa.Contains(r.DriverId.Value)))
            .Select(r => new
            {
                color = r.Color,
                // Tramos de la ruta (una ruta larga viene partida). Respaldo: la línea única vieja.
                segments = (r.Segments?.Count ?? 0) > 0 ? r.Segments.ToArray() : new[] { r.EncodedPolyline! },
                // Texto del cartelito flotante sobre la línea (tiempo total + km), estilo Google Maps.
                label = $"{FormatoDuracion(r.DurationSeconds)} · {(r.DistanceMeters / 1000.0):0.#} km",
                // Cada tramo (parada→parada) con su línea propia: deja tocar el mapa y ver la distancia de ese tramo.
                // 'transito' = pedacitos con su nivel (NORMAL/SLOW/TRAFFIC_JAM) para pintar rojo/amarillo el embotellamiento.
                legs = (r.Legs ?? new()).Select(l => new {
                    meters = l.Meters, seconds = l.Seconds, encoded = l.Encoded, from = l.From, to = l.To,
                    transito = (l.Transito ?? new()).Select(t => new { start = t.Start, end = t.End, speed = t.Speed }).ToArray()
                }).ToArray()
            })
            .ToArray();
        await JS.InvokeVoidAsync("mapeoFlex.drawRoutes", new object[] { paraDibujar });
        lineasOn = true;
    }

