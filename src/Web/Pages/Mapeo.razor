    // El mapa nos manda las esquinas de la zona dibujada. Calculamos qué paradas caen adentro.
    [JSInvokable]
    public async Task OnZoneDrawn(double[][] pts)
    {
        dibujandoZona = false;
        if (pts is null || pts.Length < 3) { ToastService.Info("La zona quedó muy chica (marcá al menos 3 esquinas). Probá de nuevo."); StateHasChanged(); return; }
        var dentro = (stops ?? new())
            .Where(s => s.Latitude != 0 && s.Longitude != 0
                     && PuntoEnPoligono((double)s.Latitude, (double)s.Longitude, pts))
            .Select(s => s.Id)
            .ToList();
        if (dentro.Count == 0) { ToastService.Info("No hay envíos dentro de esa zona."); return; }
        zoneStopIds = dentro;
        showZoneAssignModal = true;
        StateHasChanged();
        await Task.CompletedTask;
    }

    // Ray casting: ¿el punto (lat,lng) está dentro del polígono? poly = [[lat,lng],...]
    private static bool PuntoEnPoligono(double lat, double lng, double[][] poly)
    {
        bool dentro = false;
        int n = poly.Length;
        for (int i = 0, j = n - 1; i < n; j = i++)
        {
            double yi = poly[i][0], xi = poly[i][1];
            double yj = poly[j][0], xj = poly[j][1];
            bool cruza = ((yi > lat) != (yj > lat)) &&
                         (lng < (xj - xi) * (lat - yi) / ((yj - yi) == 0 ? 1e-12 : (yj - yi)) + xi);
            if (cruza) dentro = !dentro;
        }
        return dentro;
    }

    private async Task AsignarZonaARepartidor(int driverId)
    {
        if (assigningZone) return;
        assigningZone = true;
        try
        {
            // Guardamos cómo estaba cada parada ANTES, para poder deshacer.
            lastZoneUndo = (stops ?? new())
                .Where(s => zoneStopIds.Contains(s.Id))
                .Select(s => (s.Id, s.AssignedDriverId))
                .ToList();

            foreach (var id in zoneStopIds)
                await Api.UpdateMapeoStopAsync(id, new { assignedDriverId = driverId });
            await LoadStops();
            await RenderMap();
            rutasResumen = new();
            var driver = drivers?.FirstOrDefault(d => d.Id == driverId);
            var nombre = driver?.Nombre ?? "el repartidor";
            // Registramos la zona creada (cuadradito "Zona N")
            zonasCreadas.Add(new ZonaCreada(
                zonasCreadas.Count + 1, driverId, nombre,
                string.IsNullOrEmpty(driver?.Color) ? "#1d4ed8" : driver!.Color!,
                new List<int>(zoneStopIds)));
            ToastService.Success($"✅ Zona {zonasCreadas.Count}: {zoneStopIds.Count} envío(s) para {nombre}");
            showZoneAssignModal = false;
            zoneStopIds = new();
        }
        catch (Exception ex) { ToastService.Error("No se pudo asignar la zona: " + ex.Message); }
        finally { assigningZone = false; StateHasChanged(); }
    }

    // "Crear zona sin chofer" (método nuevo): mete los envíos dibujados en un VEHÍCULO nuevo (zona sin
    // repartidor). Los choferes se eligen al final con "👤 Asignar choferes". Así se puede dibujar la zona
    // y armar el orden ANTES de decidir quién la hace (pedido del usuario: zonas primero, choferes al final).
    private async Task CrearZonaSinChofer()
    {
        if (assigningZone) return;
        assigningZone = true;
        try
        {
            // Vehículo nuevo = el mayor usado hasta ahora + 1 (o 1 si no hay ninguno).
            int slot = (stops ?? new()).Select(s => s.AssignedVehicleSlot ?? 0).DefaultIfEmpty(0).Max() + 1;
            // Nos aseguramos de que la zona quede 100% sin chofer (por si algún envío arrastraba uno).
            await Api.AssignBulkStopsAsync(new List<int>(zoneStopIds), null);
            foreach (var id in zoneStopIds)
                await Api.AssignVehicleSlotAsync(id, slot);
            // Para que el vehículo nuevo aparezca en la ventana "Asignar choferes".
            if (cantidadVehiculos < slot) cantidadVehiculos = slot;
            await LoadStops();
            await RenderMap();
            rutasResumen = new();
            ToastService.Success($"✅ Zona {slot} creada: {zoneStopIds.Count} envío(s), sin chofer. Armá el orden y al final apretá 👤 Asignar choferes.");
            showZoneAssignModal = false;
            zoneStopIds = new();
        }
        catch (Exception ex) { ToastService.Error("No se pudo crear la zona: " + ex.Message); }
        finally { assigningZone = false; StateHasChanged(); }
    }

    // Encuadra el mapa sobre las paradas de una zona SIN chofer (por número de zona/slot).
    private async Task FocoVehiculo(int slot)
    {
        // Esta zona SIN chofer pasa a ser la zona activa para "ordenar a mano" y "armar ruta guiada".
        ordenSlot = slot;
        ordenDriverId = null;
        ordenVehiculoSeleccionado = slot;
        var pts = (stops ?? new())
            .Where(s => s.AssignedVehicleSlot == slot && !s.AssignedDriverId.HasValue && s.Latitude != 0 && s.Longitude != 0)
            .Select(s => new double[] { (double)s.Latitude, (double)s.Longitude })
            .ToArray();
        if (pts.Length == 0) { ToastService.Info("Esa zona ya no tiene envíos."); return; }
        // Si ya estás ordenando a mano, cambiamos a ESTA zona al toque (mostramos solo la suya).
        if (modoOrden)
        {
            MostrarSoloZonaOrdenActiva();
            await RenderMap();
        }
        try { await JS.InvokeVoidAsync("mapeoFlex.fitPoints", new object[] { pts }); } catch { }
        ToastService.Info($"Zona {slot} · {pts.Length} envío(s) · sin chofer todavía");
    }

    // Muestra/oculta en el mapa una zona SIN chofer.
    private async Task ToggleZonaSlotVisible(int slot)
    {
        if (!zonasSlotOcultas.Add(slot)) zonasSlotOcultas.Remove(slot);
        await RenderMap();
    }

    // Le pone un chofer a una zona SIN chofer (desde el 👤 del cuadradito "Zona N").
    // Al asignarlo, la zona pasa a mostrarse con el nombre del chofer.
    private async Task AsignarChoferASlot(int slot, int driverId)
    {
        if (assigningZone) return;
        assigningZone = true;
        try
        {
            await Api.AssignDriverToSlotAsync(slot, driverId);
            await LoadStops();
            ReconstruirZonasCreadas();
            await RenderMap();
            rutasResumen = new();
            var nombre = drivers?.FirstOrDefault(d => d.Id == driverId)?.Nombre ?? "el repartidor";
            ToastService.Success($"✅ Zona {slot} ahora la hace {nombre}");
        }
        catch (Exception ex) { ToastService.Error("No se pudo asignar el chofer: " + ex.Message); }
        finally { assigningZone = false; slotDriverMenu = null; StateHasChanged(); }
    }

    // Cambia el repartidor de TODA una zona ya creada (desde el 👤 del cuadradito Z1/Z2…).
    // Reasigna todas sus paradas de una y rearma los cuadraditos (toma color/nombre del nuevo repartidor).
    private async Task CambiarRepartidorZona(ZonaCreada z, int nuevoDriverId)
    {
        if (assigningZone) { return; }
        if (nuevoDriverId == z.DriverId) { zonaDriverMenuId = null; return; } // ya es de ese repartidor
        assigningZone = true;
        try
        {
            foreach (var id in z.StopIds)
                await Api.UpdateMapeoStopAsync(id, new { assignedDriverId = nuevoDriverId });
            await LoadStops();
            // Rearmar los cuadraditos desde las paradas: así la zona toma el color/nombre del nuevo
            // repartidor (y se fusiona con otra zona si ya era de ese mismo repartidor).
            zonasCreadas = new();
            ReconstruirZonasCreadas();
            await RenderMap();
            rutasResumen = new();
            var nombre = drivers?.FirstOrDefault(d => d.Id == nuevoDriverId)?.Nombre ?? "el repartidor";
            ToastService.Success($"✅ La zona ahora es de {nombre} ({z.StopIds.Count} envío(s))");
        }
        catch (Exception ex) { ToastService.Error("No se pudo cambiar el repartidor: " + ex.Message); }
        finally { assigningZone = false; zonaDriverMenuId = null; StateHasChanged(); }
    }

    // Deshacer la última zona asignada: cada parada vuelve al repartidor que tenía antes (o a "sin asignar").
    private async Task DeshacerUltimaZona()
    {
        if (lastZoneUndo.Count == 0) return;
        assigningZone = true;
        try
        {
            foreach (var (id, prev) in lastZoneUndo)
                await Api.UpdateMapeoStopAsync(id, new { assignedDriverId = prev ?? 0 });
            await LoadStops();
            await RenderMap();
            if (zonasCreadas.Count > 0) zonasCreadas.RemoveAt(zonasCreadas.Count - 1);
            rutasResumen = new();
            ToastService.Info($"↩ Se deshizo la última zona ({lastZoneUndo.Count} envío/s).");
            lastZoneUndo = new();
        }
        catch (Exception ex) { ToastService.Error("No se pudo deshacer: " + ex.Message); }
        finally { assigningZone = false; StateHasChanged(); }
    }

