    // El mapa nos manda los pines tocados EN ORDEN. Guardamos ese orden (las que sean paradas) y dibujamos la ruta.
    [JSInvokable]
    public async Task OnArmarFinished(int[] markerIds)
    {
        modoArmar = false;
        // De los pines tocados nos quedamos con los que son PARADAS (id <= -1000 → stopId = -1000 - id).
        var stopIds = new List<int>();
        foreach (var mid in markerIds ?? Array.Empty<int>())
            if (mid <= -1000) stopIds.Add(-1000 - mid);
        if (stopIds.Count < 2)
        {
            ToastService.Info("Para guardar la ruta tocá al menos 2 envíos que ya sean paradas (importados de Flex).");
            await CargarYDibujarRutas(single: false);
            StateHasChanged();
            return;
        }
        armarGuardando = true;
        StateHasChanged();
        try
        {
            await Api.ReorderMapeoStopsAsync(stopIds); // OrderInRoute = 1..N en el orden tocado
            await LoadStops();
            await RenderMap();
            await CargarYDibujarRutas(single: true);   // dibuja la ruta ya guardada
            ToastService.Success($"✅ Ruta armada: {stopIds.Count} paradas en orden.");
        }
        catch (Exception ex) { ToastService.Error("No se pudo guardar la ruta: " + ex.Message); }
        finally { armarGuardando = false; StateHasChanged(); }
    }

    // ¿La parada 'b' es de la misma zona que 'a'? Zona = repartidor si tiene; si no, el vehículo (sin repartidor).
    private bool MismaZonaGuiada(MapeoStopDto a, MapeoStopDto b)
    {
        if (a.AssignedDriverId.HasValue) return b.AssignedDriverId == a.AssignedDriverId;
        if (a.AssignedVehicleSlot.HasValue) return !b.AssignedDriverId.HasValue && b.AssignedVehicleSlot == a.AssignedVehicleSlot;
        return false;
    }

    // Click sobre una parada en modo guiado: 1° elige la primera, 2° la última, después clava/desclava del medio.
    private async Task OnMarkerGuiada(MapeoStopDto st)
    {
        if (armandoGuiada) return;
        if (!st.AssignedDriverId.HasValue && !st.AssignedVehicleSlot.HasValue)
        {
            ToastService.Info("Esa parada no está en ninguna zona todavía. Armá la zona primero (dibujá una zona y creala).");
            return;
        }

        // Paso 1: elegir la primera.
        if (!guiadaPrimeraId.HasValue)
        {
            guiadaPrimeraId = st.Id;
            await RefrescarMapaGuiada();
            return;
        }
        // Volver a tocar la primera la deselecciona (y limpia todo lo demás).
        if (st.Id == guiadaPrimeraId)
        {
            guiadaPrimeraId = null; guiadaUltimaId = null; guiadaFijasMedio.Clear();
            await RefrescarMapaGuiada();
            return;
        }

        var primera = stops?.FirstOrDefault(x => x.Id == guiadaPrimeraId);
        if (primera is null) { guiadaPrimeraId = null; await RefrescarMapaGuiada(); return; }
        if (!MismaZonaGuiada(primera, st))
        {
            ToastService.Info("Esa parada es de otra zona. La primera y la última tienen que ser de la misma zona.");
            return;
        }

        // Paso 2: elegir la última.
        if (!guiadaUltimaId.HasValue)
        {
            guiadaUltimaId = st.Id;
            await RefrescarMapaGuiada();
            return;
        }
        // Tocar la última la deselecciona.
        if (st.Id == guiadaUltimaId)
        {
            guiadaUltimaId = null;
            await RefrescarMapaGuiada();
            return;
        }
        // Paso 3: clavar/desclavar una del medio (en el orden en que se tocan).
        if (guiadaFijasMedio.Contains(st.Id)) guiadaFijasMedio.Remove(st.Id);
        else guiadaFijasMedio.Add(st.Id);
        await RefrescarMapaGuiada();
    }

    // Redibuja los pines (sin mover la vista) para que el resaltado verde/rojo/azul aparezca al instante,
    // y refresca el cartelito de arriba.
    private async Task RefrescarMapaGuiada()
    {
        await RenderMap(keepView: true);
        StateHasChanged();
    }

    // Manda al servidor primera + última (+ clavadas del medio) y ordena el resto. Un solo guardado.
    private async Task ArmarGuiada()
    {
        if (!guiadaPrimeraId.HasValue || !guiadaUltimaId.HasValue)
        {
            ToastService.Info("Elegí la primera y la última parada tocándolas en el mapa.");
            return;
        }
        armandoGuiada = true;
        try
        {
            // Las clavadas del medio salen 2°, 3°, 4°… en el orden en que las tocaste.
            var fijas = guiadaFijasMedio.Select((id, i) => new FijaMedioDto { StopId = id, Puesto = i + 2 }).ToList();
            var r = await Api.ArmarRutaGuiadaAsync(guiadaPrimeraId.Value, guiadaUltimaId.Value, fijas);
            await LoadStops();
            await RenderMap();
            await CargarYDibujarRutas(single: false);
            if (r != null && !r.PorGoogle)
                ToastService.Info($"Ruta armada ({r.Total} paradas). La ordené en línea recta (son más de 25 o Google no respondió) — igual va de la primera a la última.");
            else
                ToastService.Success($"✅ Ruta armada: {r?.Total ?? 0} paradas, de la primera a la última.");
            // Limpiamos la selección para poder armar la próxima zona.
            guiadaPrimeraId = null; guiadaUltimaId = null; guiadaFijasMedio.Clear();
        }
        catch (Exception ex) { ToastService.Error("Error: " + ex.Message); }
        finally { armandoGuiada = false; StateHasChanged(); }
    }

    // Limpia la selección del modo guiado (sin salir del modo).
    private void ReiniciarGuiada()
    {
        guiadaPrimeraId = null; guiadaUltimaId = null; guiadaFijasMedio.Clear();
        StateHasChanged();
    }

    private async Task ToggleModoOrden()
    {
        if (!modoOrden)
        {
            // ENTRAR: numerar a mano. Las zonas pueden tener chofer (driver) o no (slot). Tiene que haber alguna.
            ReconstruirZonasCreadas();
            var driverZones = (stops ?? new()).Where(s => s.AssignedDriverId.HasValue)
                .Select(s => s.AssignedDriverId!.Value).Distinct().OrderBy(x => x).ToList();
            var slotZones = (stops ?? new()).Where(s => !s.AssignedDriverId.HasValue && s.AssignedVehicleSlot.HasValue)
                .Select(s => s.AssignedVehicleSlot!.Value).Distinct().OrderBy(x => x).ToList();
            if (driverZones.Count == 0 && slotZones.Count == 0)
            {
                ToastService.Info("Primero armá las zonas (dibujá una zona y creala). Después numerás cada zona tocando los globitos.");
                return;
            }
            modoOrden = true;
            modoAsignacion = false;
            modoGuiada = false;
            // Zona activa: respetamos la que venías enfocando; si no vale, la primera que haya (chofer primero).
            if (ordenDriverId.HasValue && driverZones.Contains(ordenDriverId.Value)) { ordenSlot = null; }
            else if (ordenSlot.HasValue && slotZones.Contains(ordenSlot.Value)) { ordenDriverId = null; }
            else if (driverZones.Count > 0) { ordenDriverId = driverZones.First(); ordenSlot = null; }
            else { ordenSlot = slotZones.First(); ordenDriverId = null; }
            // Guardamos qué se veía y dejamos SOLO la zona a numerar.
            ordenBackupZonasOcultas = new HashSet<int>(zonasOcultasMapa);
            ordenBackupSlotOcultas = new HashSet<int>(zonasSlotOcultas);
            ordenBackupSinAsignar = sinAsignarOcultos;
            MostrarSoloZonaOrdenActiva();
            // Sacamos cualquier línea de ruta vieja: la dibujamos recién al terminar (apretar "Listo").
            rutasResumen = new();
            try { await JS.InvokeVoidAsync("mapeoFlex.clearRoutes"); } catch { }
            await RenderMap();
            await FocoZonaOrdenActiva();
        }
        else
        {
            // SALIR: restauramos lo que se veía y dibujamos la ruta ahora (la línea recién al final).
            modoOrden = false;
            zonasOcultasMapa = new HashSet<int>(ordenBackupZonasOcultas);
            zonasSlotOcultas = new HashSet<int>(ordenBackupSlotOcultas);
            sinAsignarOcultos = ordenBackupSinAsignar;
            await RenderMap();
            await CargarYDibujarRutas(single: false);
        }
        StateHasChanged();
    }

    // Cambió la zona en el desplegable del modo orden (d:driverId o s:slot).
    private async Task OnZonaOrdenChanged(ChangeEventArgs e)
    {
        var v = e.Value?.ToString() ?? "";
        if (v.StartsWith("d:") && int.TryParse(v.Substring(2), out var d)) { ordenDriverId = d; ordenSlot = null; }
        else if (v.StartsWith("s:") && int.TryParse(v.Substring(2), out var sl)) { ordenSlot = sl; ordenDriverId = null; }
        else return;
        MostrarSoloZonaOrdenActiva();
        await RenderMap();
        await FocoZonaOrdenActiva();
    }

    // Deja visible SOLO la zona (repartidor) que se está numerando: oculta las otras zonas y las sin-asignar.
    private void MostrarSoloZonaOrden(int driverId)
    {
        var otras = (stops ?? new()).Where(s => s.AssignedDriverId.HasValue && s.AssignedDriverId!.Value != driverId)
            .Select(s => s.AssignedDriverId!.Value).Distinct();
        zonasOcultasMapa = new HashSet<int>(otras);
        sinAsignarOcultos = true;
    }

    // Encuadra el mapa sobre las paradas de un repartidor.
    private async Task FocoZonaDriver(int driverId)
    {
        var pts = (stops ?? new())
            .Where(s => s.AssignedDriverId == driverId && s.Latitude != 0 && s.Longitude != 0)
            .Select(s => new double[] { (double)s.Latitude, (double)s.Longitude })
            .ToArray();
        if (pts.Length == 0) return;
        try { await JS.InvokeVoidAsync("mapeoFlex.fitPoints", new object[] { pts }); } catch { }
    }

