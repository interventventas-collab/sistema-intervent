        }
        catch (Exception ex)
        {
            try { await JS.InvokeVoidAsync("scanBeep", false); } catch { }
            ToastService.Error("No pude agregar la parada: " + ex.Message);
        }
        finally { wedgeBusy = false; await InvokeAsync(StateHasChanged); }
