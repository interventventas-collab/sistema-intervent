    private async Task AddDriver()
    {
        int? cafeRepId = newDriverCafeRepId > 0 ? newDriverCafeRepId : (int?)null;
        var rep = cafeRepId.HasValue ? cafeRepartidores?.FirstOrDefault(x => x.Id == cafeRepId.Value) : null;
        // Si no escribieron nombre pero eligieron un repartidor real, usamos su nombre.
        var nombre = string.IsNullOrWhiteSpace(newDriverName) ? (rep?.Nombre ?? "") : newDriverName.Trim();
        if (string.IsNullOrWhiteSpace(nombre)) return;
        try
        {
            var d = await Api.CreateMapeoDriverAsync(nombre, string.IsNullOrWhiteSpace(newDriverPhone) ? null : newDriverPhone, newDriverColor, cafeRepId);
            if (d is not null) { drivers ??= new(); drivers.Add(d); newDriverName = ""; newDriverPhone = ""; newDriverCafeRepId = 0; ToastService.Success("Repartidor agregado"); }
        }
        catch (Exception ex) { ToastService.Error("Error: " + ex.Message); }
    }

    private async Task SaveDriver(MapeoDriverDto d)
    {
        try
        {
            // Pasamos 0 cuando está sin vincular, para que el backend lo desvincule (null lo dejaría igual).
            await Api.UpdateMapeoDriverAsync(d.Id, d.Nombre, d.Telefono, d.Color, d.IsActive, d.CafeRepartidorId ?? 0);
            ToastService.Success("Guardado");
        }
        catch (Exception ex) { ToastService.Error("Error: " + ex.Message); }
    }

    private async Task DeleteDriver(MapeoDriverDto d)
    {
        if (!await ConfirmAsync($"Eliminar al repartidor '{d.Nombre}'?")) return;
        try { if (await Api.DeleteMapeoDriverAsync(d.Id)) { drivers?.Remove(d); ToastService.Success("Eliminado"); } }
        catch (Exception ex) { ToastService.Error("Error: " + ex.Message); }
    }

