    private static string FormatoDuracion(int seg)
    {
        if (seg <= 0) return "—";
        int min = (int)Math.Round(seg / 60.0);
        if (min < 60) return $"{min} min";
        return $"{min / 60}h {min % 60:00}min";
    }

