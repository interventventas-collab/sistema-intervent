    /// <summary>
    /// Cuando el usuario clickea en modo asignación visual sobre un marker de Flex / ME1
    /// (que todavía no es parada), creamos la parada al toque con Origin="flex" + OriginRefId
    /// = MeliShipmentId y le asignamos el V activo. Asi el usuario no tiene que pasar antes
    /// por el modal "Sumar Flex a paradas" — un solo click hace todo.
    /// </summary>
    private async Task ImportarShipmentYAsignarV(MeliShipmentDto s)
    {
        if (!s.Latitude.HasValue || !s.Longitude.HasValue)
        {
            ToastService.Error("Este envío no tiene coordenadas, no se puede asignar.");
            return;
        }
        assigningSlot = true;
        try
        {
            // Construimos la dirección completa "calle, localidad" si tenemos ambos campos.
            var dir = !string.IsNullOrWhiteSpace(s.AddressLine)
                ? (string.IsNullOrWhiteSpace(s.City) ? s.AddressLine! : $"{s.AddressLine}, {s.City}")
                : (s.City ?? "(sin dirección)");
            // Origin "me1" si es envío manual del vendedor, "flex" si es Flex de MeLi.
            // El render del marker mapea ese Origin a la forma del globito (cuadrado vs círculo).
            var origenStop = s.Mode == "me1" ? "me1" : "flex";
            var nuevo = await Api.CreateMapeoStopAsync(
                origin: origenStop,
                originRefId: s.MeliShipmentId.ToString(),
                alias: s.ReceiverName,
                direccion: dir,
                lat: s.Latitude.Value,
                lng: s.Longitude.Value,
                contact: s.ReceiverName,
                tel: s.ReceiverPhone,
                notas: s.ItemsSummary);
            if (nuevo is null) { ToastService.Error("No se pudo crear la parada"); return; }
            // Le asignamos el V activo
            await Api.AssignVehicleSlotAsync(nuevo.Id, vehiculoSeleccionado);
            nuevo.AssignedVehicleSlot = vehiculoSeleccionado;
            stops!.Add(nuevo);
            await RenderMap();
            StateHasChanged();
        }
        catch (Exception ex) { ToastService.Error("Error: " + ex.Message); }
        finally { assigningSlot = false; }
    }

