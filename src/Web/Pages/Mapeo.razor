    {
        "en_ruta" => "#d97706",
        "entregado" => "#15803d",
        "no_encontrado" => "#b91c1c",
        "reprogramado" => "#7c3aed",
        "cancelled" => "#6b7280",
        _ => "#1d4ed8"
    };

    private static string StatusLabel(string s) => s switch
    {
        "en_ruta" => "En ruta",
        "entregado" => "Entregado",
        "no_encontrado" => "No encontró",
        "reprogramado" => "Reprogramado",
        "cancelled" => "Cancelado",
