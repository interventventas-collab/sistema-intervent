    private sealed class GrupoUnificado
    {
        public string Key { get; set; } = "";
        public string Zona { get; set; } = "";
        public List<MeliShipmentDto> Flex { get; set; } = new();
        public List<MapeoStopDto> Manual { get; set; } = new();
        // Cuenta los envíos del grupo SIN duplicar: una parada con Origin flex/me1 se descuenta
        // solo si su Flex "crudo" TAMBIÉN está cargado en la lista (ahí sí sería el mismo envío dos
        // veces). Si el Flex crudo no está cargado, igual la contamos (antes daba 0 y confundía).
        public int Count
        {
            get
            {
                var flexIds = new HashSet<string>(Flex.Select(f => f.MeliShipmentId.ToString()));
                var duplicadas = Manual.Count(m => (m.Origin == "flex" || m.Origin == "me1")
                                                   && !string.IsNullOrEmpty(m.OriginRefId)
                                                   && flexIds.Contains(m.OriginRefId!));
                return Flex.Count + Manual.Count - duplicadas;
            }
        }
        public bool TieneFlex => Flex.Count > 0;
        public bool TieneManual => Manual.Count > 0;
        // Devuelve la parada (Origin=flex) que linkea con un Flex puntual, si existe.
        public MapeoStopDto? GetParadaFlex(long meliShipmentId) =>
