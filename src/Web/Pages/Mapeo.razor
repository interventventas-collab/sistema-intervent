    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            selfRef = DotNetObjectReference.Create(this);
            await JS.InvokeVoidAsync("mapeoFlex.init", "leafletMap", selfRef);
            mapInitialized = true;
            try { await JS.InvokeVoidAsync("mapeoFlex.attachSearch", "mapeoSearchInput"); } catch { }
            try { startPoint = await Api.GetMapeoStartPointAsync(); } catch { }
            try { var pu = await Api.GetMapeoPublicBaseUrlAsync(); publicBaseUrl = string.IsNullOrWhiteSpace(pu?.Url) ? null : pu.Url; } catch { }
            await LoadDrivers();
            await LoadFavoritos();
            await LoadClientesMapeados();
            await Api.ClearStaleMapeoStopsAsync(); // limpiar lo de días anteriores; lo de hoy queda
            await LoadStops();
            ReconstruirZonasCreadas(); // rearma los cuadraditos "Zona N" desde las paradas guardadas (sobrevive al refresco)
            await CargarNotas();
            await LoadAndRender();
            StateHasChanged();
            IniciarAutoRefresh(); // refresco automático del mapa (envíos escaneados aparecen solos)
        }
        // (Re)engancha el arrastre de la lista (⠿) cuando está a la vista la ruta ordenable.
        // El JS destruye la instancia previa antes de crear una nueva, así que es seguro llamarlo en cada render.
        if (listaOrdenableActiva && selfRef is not null)
        {
            try { await JS.InvokeVoidAsync("mapeoInitSortable", "mapeoStopsList", selfRef); } catch { }
        }
        // Barra negra (dock) arrastrable: engancha el arrastre y restaura la posición guardada.
        if (mapaFullscreen)
        {
            try { await JS.InvokeVoidAsync("mapeoDock.enableDrag"); } catch { }
        }
    }

    private async Task LoadAndRender()
    {
        isLoading = true;
        try
        {
            // Por defecto el mapa arranca LIMPIO: solo muestra lo que cargás vos (escaneando o asignando).
            // El Flex de MercadoLibre se trae solo si el usuario tilda "Traer Flex" (doble-check).
            shipments = mostrarFlexAuto
                ? (await Api.GetMeliFlexShipmentsAsync(diasFiltro, string.IsNullOrEmpty(filtroInterno) ? null : filtroInterno, excluirEntregados) ?? new())
                : new();
            try { entregadosHoy = await Api.GetFlexDeliveredTodayCountAsync(); } catch { }
            if (mapInitialized) await RenderMap();
        }
        catch (Exception ex) { ToastService.Error("Error: " + ex.Message); }
        finally { isLoading = false; }
    }

    // ===== Refresco automático del mapa =====
    // 2026-07-29: a medida que se van escaneando/agregando envíos, aparecen solos en el mapa
    // sin tener que apretar refrescar. Trae SOLO las paradas (de nuestra base, liviano) y las
    // redibuja SIN moverte la vista. Se pausa solo mientras estás en el medio de algo.
    private System.Threading.Timer? autoRefreshTimer;
    private bool autoRefreshBusy;

    private void IniciarAutoRefresh()
    {
        if (autoRefreshTimer is not null) return;
        // Primer chequeo a los 7s y después cada 7s.
        autoRefreshTimer = new System.Threading.Timer(async _ =>
        {
            try { await InvokeAsync(AutoRefreshTick); } catch { }
        }, null, 7000, 7000);
    }

    private async Task AutoRefreshTick()
    {
        if (autoRefreshBusy || !mapInitialized) return;
        // Guarda: no interrumpir si el usuario está haciendo algo sobre el mapa,
        // ni mientras mira la foto de un día anterior (no pisar el histórico con lo de hoy).
        if (dibujandoZona || modoOrden || modoGuiada || modoAsignacion || modoArmar || corrigiendoDomicilioStopId is not null
            || editandoPinStopId is not null
            || routeBusy || actualizandoEntregas || assigningZone || assigningSlot || isLoading
            || viewingSnapshot) return;
        autoRefreshBusy = true;
        try
        {
            var antes = stops?.Count ?? 0;
            await LoadStops();                      // paradas frescas (incluye lo recién escaneado)
            if (mapInitialized) await RenderMap(keepView: true); // redibuja sin mover la vista
            // RenderMap borra las líneas de ruta al redibujar los pines; si había rutas dibujadas,
            // las volvemos a pintar para que el refresco automático no las haga desaparecer.
            if (rutasResumen.Count > 0) await PintarRutas();
            if ((stops?.Count ?? 0) != antes) StateHasChanged();  // refresca la lista de la izquierda si cambió
        }
        catch { /* silencioso: es un refresco de fondo, no molestamos con errores */ }
        finally { autoRefreshBusy = false; }
    }

    // 2026-07-17: boton "Traer telefono ahora" — le pide a MeLi el telefono del comprador de este envio.
    // Si MeLi ya lo libero, lo muestra al toque y lo deja escrito en la nota de la venta.
    private async Task TraerTelefono(MeliShipmentDto s)
    {
        if (trayendoTel) return;
        trayendoTel = true;
        try
        {
            var r = await Api.TraerTelefonoAsync(s.MeliShipmentId);
            if (r is null) { ToastService.Error("No se pudo consultar MeLi."); return; }
            if (!string.IsNullOrEmpty(r.Phone))
            {
                s.ReceiverPhone = r.Phone;
                ToastService.Success(r.NotePosted ? "📞 Teléfono traído y guardado en la nota de la venta." : "📞 Teléfono traído.");
            }
            else
            {
                ToastService.Info(r.Message ?? "MeLi todavía no liberó el teléfono de este envío.");
            }
        }
        catch (Exception ex) { ToastService.Error("Error: " + ex.Message); }
        finally { trayendoTel = false; }
    }

    // keepView=true (refresco automático): redibuja los globitos SIN mover el mapa.
    private async Task RenderMap(bool keepView = false)
    {
        if (shipments is null) return;

        // 2026-07-30: modo "corregir/mover pin" → mostramos SOLO ese pin (arrastrable) para ubicarlo
        // cómodo, sin el resto de los pines encima ni saltos de zoom.
        if (editandoPinStopId is int epid)
        {
            var stEd = stops?.FirstOrDefault(x => x.Id == epid);
            var elat = editPinLat ?? (stEd is not null && (stEd.Latitude != 0 || stEd.Longitude != 0) ? stEd.Latitude : (decimal?)null);
            var elng = editPinLng ?? (stEd is not null && (stEd.Latitude != 0 || stEd.Longitude != 0) ? stEd.Longitude : (decimal?)null);
            var elist = new List<object>();
            if (elat.HasValue && elng.HasValue)
            {
                elist.Add(new
                {
                    id = -1000 - epid,
                    lat = elat.Value,
                    lng = elng.Value,
                    label = "📍",
                    color = "#f59e0b",
                    shape = "circle",
                    draggable = true,
                    stopId = epid,
                    popupHtml = $"<div style='font-size:0.8rem;'><strong>{System.Net.WebUtility.HtmlEncode(editandoPinNombre ?? "Corrigiendo domicilio")}</strong><br/><em style='color:#6b7280;'>Arrastrame o buscá la dirección arriba.</em></div>"
                });
            }
            await JS.InvokeVoidAsync("mapeoFlex.renderMarkers", elist.ToArray(), keepView);
            return;
        }

        var list = new List<object>();
        if (startPoint?.Lat is not null && startPoint?.Lng is not null)
        {
            list.Add(new
            {
                id = -1,
                lat = startPoint.Lat,
                lng = startPoint.Lng,
                label = "🏠",
                color = "#15803d",
                draggable = true, // se puede arrastrar para afinar la ubicación
                popupHtml = $"<div style='font-size:0.85rem;'><strong>📍 Punto de partida</strong><br/>{System.Net.WebUtility.HtmlEncode(startPoint.Address ?? "")}<br/><em style='color:#6b7280;font-size:0.72rem;'>Podés arrastrar esta casita para ajustarla.</em></div>"
            });
        }
        // Set de shipment IDs que ya fueron importados como stops (origin=flex) — para no duplicar marcadores
        var shipmentsImportados = new HashSet<long>(
            (stops ?? new()).Where(s => (s.Origin == "flex" || s.Origin == "me1") && s.OriginRefId != null && long.TryParse(s.OriginRefId, out _))
                            .Select(s => long.Parse(s.OriginRefId!))
        );
        // Lista unificada cacheada para el render: se usa para saber si cada marker
        // está en la selección de ruta (rutaSeleccion) y mostrar el botón apropiado
        // en el popup (Sumar / Quitar).
        var listaUnificadaCacheada = BuildListaUnificada();
        // Si hay un filtro de vehículo activo (no es "Todos"), también ocultamos los shipments
        // (porque solo queremos ver los stops asignados a ese vehículo).
        // Si "TODO" está apagado (y hay zonas creadas), tampoco mostramos el Flex crudo (sin asignar).
        var ocultarSinAsignar = sinAsignarOcultos && zonasCreadas.Count > 0;
        var verShipments = vehiculoFiltro == null && !ocultarSinAsignar;
        if (verShipments)
        {
            list.AddRange(shipments.Where(s => s.Latitude.HasValue && s.Longitude.HasValue
                                            && !shipmentsImportados.Contains(s.MeliShipmentId)).Select((s, i) =>
            {
                var grupo = listaUnificadaCacheada?.FirstOrDefault(g => g.Flex.Any(f => f.Id == s.Id));
                var enRuta = grupo is not null && rutaSeleccion.Contains(grupo.Key);
                var btnBg = enRuta ? "#dc2626" : "#16a34a";
                var btnTxt = enRuta ? "✗ Quitar de ruta" : "✓ Sumar a ruta";
                var esMe1 = s.Mode == "me1";
                var entregadaFlex = EffectiveKey(s) == "entregado";
                // Cartelito verde dentro del globito Flex/ME1: "✔ Entregado" + hora que confirmó MercadoLibre.
                var horaEntregaFlexHtml = entregadaFlex
                    ? $"<div style='margin-top:0.3rem; color:#15803d; font-weight:700; font-size:0.72rem;'>✔ Entregado{(s.DateDelivered.HasValue ? " · 🕒 " + s.DateDelivered.Value.ToArTime().ToString("dd/MM 'a las' HH:mm") + " hs" : "")}</div>"
                    : "";
                return (object)new
                {
                    id = s.Id,
                    lat = s.Latitude,
                    lng = s.Longitude,
                    // Pin sin número por defecto (queda limpio). El total de la zona se ve en la
                    // lista de la izquierda. El color amarillo indica "sin asignar"; cuando se le
                    // asigna un vehículo/repartidor toma su color. Recién se numera al ordenar la ruta.
                    label = "",
                    color = "#eab308",
                    shape = esMe1 ? "square" : "circle",
                    dimmed = false,
                    inRoute = enRuta,
                    delivered = entregadaFlex,
                    popupHtml = $"<div style='font-size:0.8rem; line-height:1.4;'><strong>{System.Net.WebUtility.HtmlEncode(s.ReceiverName ?? "—")}</strong>{(esMe1 ? " <span style='background:#fce7f3;color:#9d174d;padding:0 0.3rem;border-radius:3px;font-size:0.65rem;font-weight:800;'>ME1</span>" : "")}<br/>{System.Net.WebUtility.HtmlEncode(s.AddressLine ?? "")}<br/><em>{System.Net.WebUtility.HtmlEncode(s.City ?? "")}</em>{horaEntregaFlexHtml}<div class='mapeo-vinfo' data-ship='{s.MeliShipmentId}'></div><button onclick=\"window.mapeoActions.toggleRoute({s.Id}); event.stopPropagation();\" style='margin-top:0.3rem; padding:0.2rem 0.5rem; background:{btnBg}; color:white; border:none; border-radius:4px; font-size:0.72rem; font-weight:600; cursor:pointer;'>{btnTxt}</button></div>"
                };
            }));
        }
        // Stops (incluye los Flex importados + favoritos + manuales)
        // Si tienen driver asignado: color del driver y label = número de orden.
        // Si no: naranja con ★.
        if (stops is not null)
        {
            // Filtro de vehículo: null=todos, 0=sin asignar, >0=slot
            var stopsFiltrados = stops.Where(st =>
                !(excluirEntregados && EstaEntregado(st)) &&
                // Sin ubicación (0,0): no dibujamos pin en el mapa (aparece solo en el listado con el aviso).
                !(st.Latitude == 0 && st.Longitude == 0) &&
                // Ojito del cuadradito: si la zona (repartidor) está apagada, no se dibujan sus paradas.
                !(st.AssignedDriverId.HasValue && zonasOcultasMapa.Contains(st.AssignedDriverId.Value)) &&
                // Chip "TODO" apagado: ocultamos las paradas todavía sin repartidor asignado.
                !(ocultarSinAsignar && !st.AssignedDriverId.HasValue && !st.AssignedVehicleSlot.HasValue) &&
                // Ojito de una zona sin chofer (por slot): si está apagada, no dibujamos sus paradas.
                !(st.AssignedVehicleSlot.HasValue && !st.AssignedDriverId.HasValue && zonasSlotOcultas.Contains(st.AssignedVehicleSlot.Value)) &&
                (vehiculoFiltro == null ||
                (vehiculoFiltro == 0 && !st.AssignedVehicleSlot.HasValue) ||
                (vehiculoFiltro > 0 && st.AssignedVehicleSlot == vehiculoFiltro)));
            list.AddRange(stopsFiltrados.Select(st => {
                // 2026-08-07: prioridad de color = 1) REPARTIDOR asignado (para que coincida con los
                // chips de abajo), 2) color de la zona/slot (si todavía no tiene repartidor), 3) amarillo.
                string color = !string.IsNullOrEmpty(st.AssignedDriverColor) ? st.AssignedDriverColor!
                              : (st.AssignedVehicleSlot.HasValue ? VehicleColor(st.AssignedVehicleSlot.Value) : "#eab308");
                // Número SOLO cuando la parada tiene orden de ruta (armada a mano u optimizada).
                // Sin orden → pin limpio, sin número (el total de la zona se ve en la lista).
                string label = st.OrderInRoute.HasValue ? st.OrderInRoute.Value.ToString() : "";
                // Modo "Armar ruta guiada": resaltamos en el mapa la parada elegida como PRIMERA (verde 1°),
                // ÚLTIMA (rojo Ú) y las clavadas del medio (azul ★), para que se vea de un vistazo cuál es cuál.
                if (modoGuiada)
                {
                    if (st.Id == guiadaPrimeraId) { color = "#16a34a"; label = "1°"; }
                    else if (st.Id == guiadaUltimaId) { color = "#dc2626"; label = "Ú"; }
                    else if (guiadaFijasMedio.Contains(st.Id)) { color = "#2563eb"; label = "★"; }
                }
                // Forma del marker según el origen, para reconocer el tipo de un vistazo:
                // CÍRCULO=Flex · CUADRADO=ME1 · ROMBO=Alquiler · TRIÁNGULO=Venta por fuera (café)
                // · CÍRCULO=manual/favorito (default). El color sigue indicando el repartidor/asignación.
                string shape = st.Origin switch
                {
                    "flex" => "circle",
                    "me1" => "square",
                    "alquiler" => "diamond",
                    "venta_cafe" => "triangle",
                    _ => "circle"
                };
                var markerId = -1000 - st.Id;
                var grupoSt = listaUnificadaCacheada.FirstOrDefault(g => g.Manual.Any(m => m.Id == st.Id));
                var enRutaSt = grupoSt is not null && rutaSeleccion.Contains(grupoSt.Key);
                var btnBgSt = enRutaSt ? "#dc2626" : "#16a34a";
                var btnTxtSt = enRutaSt ? "✗ Quitar de ruta" : "✓ Sumar a ruta";
                var driverBorde = string.IsNullOrEmpty(st.AssignedDriverColor) ? "#cbd5e1" : st.AssignedDriverColor!;
                // 2026-08-06: selector de ZONA dentro del globito (reemplaza al de repartidor). Los choferes
                // se asignan por zona al final; acá mandás el envío a una zona existente o a una nueva.
                var zonaOpts = new System.Text.StringBuilder();
                zonaOpts.Append($"<option value='0'{(!st.AssignedVehicleSlot.HasValue ? " selected" : "")}>— Sin zona —</option>");
                // 2026-08-07: cada zona sale con SU color. Si la zona ya tiene repartidor, usa el color
                // del REPARTIDOR (para que coincida con los pines y los chips); si no, el color del slot.
                foreach (var sl in (stops ?? new()).Where(x => x.AssignedVehicleSlot.HasValue).Select(x => x.AssignedVehicleSlot!.Value).Distinct().OrderBy(x => x))
                {
                    var slColor = (stops ?? new()).Where(x => x.AssignedVehicleSlot == sl && !string.IsNullOrEmpty(x.AssignedDriverColor))
                                      .Select(x => x.AssignedDriverColor!).FirstOrDefault() ?? VehicleColor(sl);
                    zonaOpts.Append($"<option value='{sl}'{(st.AssignedVehicleSlot == sl ? " selected" : "")} style='background-color:{slColor}; color:#fff;'>● Zona {sl}</option>");
                }
                zonaOpts.Append("<option value='-1' style='color:#111;'>➕ Nueva zona</option>");
                // Tinte del selector CERRADO = mismo color que el pin (repartidor si tiene, si no zona).
                var selBg = st.AssignedVehicleSlot.HasValue ? color : "white";
                var selFg = st.AssignedVehicleSlot.HasValue ? "#fff" : "#111";
                // Entregado: Flex/ME1 lo confirma MeLi (MeliStatus), venta del café trae la hora real (DateDelivered),
                // y cualquier parada marcada a mano queda como InternalStatus="entregado".
                var entregadaStop = string.Equals(st.MeliStatus, "delivered", StringComparison.OrdinalIgnoreCase)
                                    || string.Equals(st.InternalStatus, "entregado", StringComparison.OrdinalIgnoreCase)
                                    || st.DateDelivered.HasValue;
                // Cartelito verde dentro del globito: "✔ Entregado" + la hora si la conocemos.
                var horaEntregaStopHtml = entregadaStop
                    ? $"<div style='margin-top:0.35rem; color:#15803d; font-weight:700; font-size:0.72rem;'>✔ Entregado{(st.DateDelivered.HasValue ? " · 🕒 " + st.DateDelivered.Value.ToArTime().ToString("dd/MM 'a las' HH:mm") + " hs" : "")}</div>"
                    : "";
                // 2026-08-04: cajita "Puesto en la ruta" dentro del globito. El usuario escribe el número
                // que quiere y aprieta "Poner acá" → la parada queda en ese puesto y corre las demás de la
                // misma zona hacia adelante. Solo aparece si la parada está en una zona (repartidor o V).
                var tieneZonaStop = st.AssignedDriverId.HasValue || st.AssignedVehicleSlot.HasValue;
                var puestoActualStop = st.OrderInRoute?.ToString() ?? "";
                var puestoRowHtml = tieneZonaStop
                    ? $"<div style='margin-top:0.35rem; display:flex; align-items:center; gap:0.25rem;'><span title='Puesto en la ruta'>🔢</span><input type='number' min='1' id='pos-{markerId}' value='{puestoActualStop}' placeholder='N°' onclick=\"event.stopPropagation();\" style='width:56px; padding:0.15rem 0.25rem; border:2px solid {driverBorde}; border-radius:4px; font-size:0.72rem;'/><button onclick=\"window.mapeoActions.setOrder({markerId}, document.getElementById('pos-{markerId}').value); event.stopPropagation();\" style='padding:0.2rem 0.5rem; background:#1d4ed8; color:white; border:none; border-radius:4px; font-size:0.72rem; font-weight:600; cursor:pointer;'>👉 Poner acá</button></div>"
                    : "";
                // Solo en paradas Flex/ME1 (MercadoLibre): cajón que se llena al abrir el globito con
                // QUÉ compró el cliente + los MENSAJES de la venta. OriginRefId guarda el nº de envío de MeLi.
                var vinfoStopHtml = (st.Origin == "flex" || st.Origin == "me1") && !string.IsNullOrEmpty(st.OriginRefId)
                    ? $"<div class='mapeo-vinfo' data-ship='{st.OriginRefId}'></div>"
                    : "";
                return (object)new
                {
                    id = markerId,
                    lat = st.Latitude,
                    lng = st.Longitude,
                    label,
                    color,
                    shape,
                    inRoute = enRutaSt,
                    delivered = entregadaStop,
                    // Candado: si la parada está desbloqueada, su pin se puede arrastrar para ajustar la ubicación.
                    draggable = paradasDesbloqueadas.Contains(st.Id),
                    stopId = st.Id,
