    // Arma la parte de la URL con las columnas elegidas (misma para PDF, Excel y texto).
    private string BuildExportQuery()
    {
        string B(bool v) => v ? "true" : "false";
        var qs = new List<string>();
        if (exportDriverSel != 0) qs.Add($"driverId={exportDriverSel}");
        qs.Add($"orden={B(expOrden)}");
        qs.Add($"nombre={B(expNombre)}");
        qs.Add($"direccion={B(expDireccion)}");
        qs.Add($"telefono={B(expTelefono)}");
        qs.Add($"notas={B(expNotas)}");
        qs.Add($"repartidor={B(expRepartidor)}");
        qs.Add($"estado={B(expEstado)}");
        qs.Add($"ventaMeli={B(expVentaMeli)}");
        qs.Add($"incluirEntregados={B(expIncluirEntregados)}");
        return string.Join("&", qs);
    }

