    // "Repartir y optimizar": reparte TODAS las paradas entre los choferes activos (por zona) y le
    // arma a cada uno la mejor ruta según el tránsito. Es la Fase 2 "versión gratis" (cluster + ruta).
    private async Task RepartirYOptimizar()
    {
        if (routeBusy) return;
        var activos = drivers?.Count(d => d.IsActive) ?? 0;
        if (activos == 0) { ToastService.Error("Primero configurá al menos un repartidor activo."); return; }
        routeBusy = true;
        try
        {
            await Api.AutoAssignStopsAsync(reassignAll: true); // reparte TODAS las paradas entre los choferes
            await Api.OptimizeStopsOrderAsync();               // optimiza la ruta de cada chofer (por tránsito)
            await LoadStops();
            await LoadDrivers();
            await RenderMap();
            ToastService.Success("🧠 Repartido entre los choferes y optimizado por el tránsito actual");
        }
        catch (Exception ex) { ToastService.Error("No se pudo repartir/optimizar: " + ex.Message); }
        finally { routeBusy = false; StateHasChanged(); }
    }

    // Asignar (o quitar) el repartidor de una parada desde el desplegable de la lista.
    // driverId 0 (o vacío) = sin repartidor. Vos elegís el quién; el sistema solo optimiza el orden.
    private async Task AsignarRepartidor(MapeoStopDto st, string? driverIdStr)
    {
        int driverId = int.TryParse(driverIdStr, out var d) ? d : 0;
        try
        {
            await Api.UpdateMapeoStopAsync(st.Id, new { assignedDriverId = driverId });
            await LoadStops();
            await RenderMap();
        }
        catch (Exception ex) { ToastService.Error("No se pudo asignar el repartidor: " + ex.Message); }
    }

    // "Optimizar rutas": ordena el recorrido de CADA repartidor asignado (por tránsito). Vos ya elegiste
    // el quién con los desplegables; esto solo optimiza el orden de cada uno.
    private async Task OptimizarRutas()
    {
        if (routeBusy) return;
        routeBusy = true;
        try
        {
            await Api.OptimizeStopsOrderAsync();   // per-driver, traffic-aware
            await LoadStops();
            await RenderMap();
            await CargarYDibujarRutas(single: false);
            ToastService.Success("⚡ Rutas optimizadas por el tránsito actual");
        }
        catch (Exception ex) { ToastService.Error("No se pudo optimizar: " + ex.Message); }
        finally { routeBusy = false; StateHasChanged(); }
    }

    // "Armar ruta óptima": ordena TODAS las paradas cargadas en el mejor recorrido según el tránsito actual.
    private async Task ArmarRutaOptima()
    {
        if (routeBusy) return;
        routeBusy = true;
        try
        {
            await Api.OptimizeStopsOrderAsync(all: true);
            await LoadStops();
            await RenderMap();
            await CargarYDibujarRutas(single: true);
            ToastService.Success("🚦 Ruta armada y optimizada por el tránsito actual");
        }
        catch (Exception ex) { ToastService.Error("No se pudo armar la ruta: " + ex.Message); }
        finally { routeBusy = false; StateHasChanged(); }
    }

