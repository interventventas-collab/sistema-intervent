    // ¿La parada está en la zona que estoy ordenando ahora (con o sin chofer)?
    private bool EnZonaOrden(MapeoStopDto s)
    {
        if (ordenDriverId.HasValue) return s.AssignedDriverId == ordenDriverId;
        if (ordenSlot.HasValue) return !s.AssignedDriverId.HasValue && s.AssignedVehicleSlot == ordenSlot;
        return false;
    }
    private string NombreZonaOrden()
    {
        if (ordenDriverId.HasValue) return drivers?.FirstOrDefault(d => d.Id == ordenDriverId)?.Nombre ?? "la zona";
        if (ordenSlot.HasValue) return $"Zona {ordenSlot}";
        return "la zona";
    }
    // Muestra SOLO la zona activa (con o sin chofer); esconde el resto.
    private void MostrarSoloZonaOrdenActiva()
    {
        var otrosDrivers = (stops ?? new()).Where(s => s.AssignedDriverId.HasValue && s.AssignedDriverId != ordenDriverId)
            .Select(s => s.AssignedDriverId!.Value).Distinct();
        zonasOcultasMapa = new HashSet<int>(otrosDrivers);
        var otrosSlots = (stops ?? new()).Where(s => !s.AssignedDriverId.HasValue && s.AssignedVehicleSlot.HasValue && s.AssignedVehicleSlot != ordenSlot)
            .Select(s => s.AssignedVehicleSlot!.Value).Distinct();
        zonasSlotOcultas = new HashSet<int>(otrosSlots);
        // La zona activa es siempre una zona concreta, así que las paradas sueltas se ocultan.
        sinAsignarOcultos = true;
    }
    // Encuadra el mapa sobre la zona activa.
    private async Task FocoZonaOrdenActiva()
    {
        var pts = (stops ?? new()).Where(EnZonaOrden).Where(s => s.Latitude != 0 && s.Longitude != 0)
            .Select(s => new double[] { (double)s.Latitude, (double)s.Longitude }).ToArray();
        if (pts.Length == 0) return;
        try { await JS.InvokeVoidAsync("mapeoFlex.fitPoints", new object[] { pts }); } catch { }
    }
