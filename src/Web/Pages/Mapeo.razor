    // 2026-08-04: botón "👉 Poner acá" del globito. Mete la parada en el puesto que el usuario
    // escribió y reacomoda las demás de la MISMA zona (repartidor si tiene; si no, el vehículo V).
    // 2026-08-05: ahora TODO el reacomodo lo hace el servidor en UN SOLO guardado atómico
    // (endpoint poner-en-puesto). Antes se corrían las paradas una por una desde acá con muchos
    // guardados sueltos y, si se cortaba a mitad, quedaban números repetidos y saltos (ej: tres
    // paradas en el puesto 13). Además el servidor renumera la zona limpia 1..N, así que también
    // auto-corrige cualquier repetido/salto que hubiera quedado de antes.
    [JSInvokable]
    public async Task PonerEnPuestoDesdePopup(int markerId, int puesto)
    {
        if (markerId > -1000) return; // solo paradas (stops)
        var stopId = -1000 - markerId;
        var s = stops?.FirstOrDefault(x => x.Id == stopId);
        if (s is null) return;

        if (!s.AssignedDriverId.HasValue && !s.AssignedVehicleSlot.HasValue)
        {
            ToastService.Info("Primero meté este envío en una zona para poder darle un puesto en la ruta.");
            return;
        }

        assigningSlot = true;
        try
        {
            // Un solo guardado en el servidor: mete la parada en el puesto y renumera toda la zona 1..N.
            await Api.PonerEnPuestoMapeoAsync(s.Id, puesto);
            await LoadStops();   // traemos los números ya renumerados
            await RenderMap();
            var final = stops?.FirstOrDefault(x => x.Id == stopId)?.OrderInRoute;
            ToastService.Success(final.HasValue
                ? $"Puesto #{final} asignado — reacomodé los demás."
                : "Puesto asignado — reacomodé los demás.");
        }
        catch (Exception ex) { ToastService.Error("Error: " + ex.Message); }
        finally { assigningSlot = false; StateHasChanged(); }
    }

    /// <summary>
    /// Click sobre un cluster (varias paradas apiladas en la misma coordenada).
    /// En modo asignación: asigna TODAS al V activo de un solo click.
    /// En modo orden: numera TODAS en secuencia (la primera con el próximo número, etc.).
    /// En modo normal: abre el detalle del primer Flex del grupo si lo hay.
    /// </summary>
    [JSInvokable]
    public async Task OnClusterClicked(int[] ids)
    {
        if (ids is null || ids.Length == 0) return;

        if (modoGuiada)
        {
            // Del grupo apilado tomamos la primera parada (stop) y la tratamos como un click normal.
            var firstStop = ids.Where(i => i <= -1000)
                .Select(i => stops?.FirstOrDefault(x => x.Id == -1000 - i))
                .FirstOrDefault(x => x is not null);
            if (firstStop is not null) await OnMarkerGuiada(firstStop);
            return;
        }

        if (modoAsignacion)
        {
            assigningSlot = true;
            try
            {
                foreach (var id in ids)
                {
                    if (id <= -1000)
                    {
                        var stopId = -1000 - id;
                        var st = stops?.FirstOrDefault(x => x.Id == stopId);
                        if (st is null) continue;
                        await Api.AssignVehicleSlotAsync(st.Id, vehiculoSeleccionado);
                        st.AssignedVehicleSlot = vehiculoSeleccionado;
                    }
                    else
                    {
                        // Flex / ME1 del cluster: importar como parada + asignar V
                        var ship = shipments?.FirstOrDefault(x => x.Id == id);
                        if (ship is null) continue;
                        await ImportarShipmentYAsignarV(ship);
                    }
                }
                await RenderMap();
                StateHasChanged();
                ToastService.Success($"{ids.Length} paradas asignadas al V{vehiculoSeleccionado}");
            }
            catch (Exception ex) { ToastService.Error("Error: " + ex.Message); }
            finally { assigningSlot = false; }
            return;
        }

        if (modoOrden)
        {
            // Numerar en secuencia las paradas de la ZONA activa. Las de otra zona se saltan.
            int salteadas = 0;
            foreach (var id in ids)
            {
                if (id > -1000) continue;
                var stopId = -1000 - id;
                var st = stops?.FirstOrDefault(x => x.Id == stopId);
                if (st is null) continue;
                if (!EnZonaOrden(st)) { salteadas++; continue; }
                if (st.OrderInRoute.HasValue) continue; // ya numerada, dejamos como está
                await OnMarkerOrden(st);
            }
            if (salteadas > 0) ToastService.Info($"{salteadas} paradas del grupo son de otra zona y se saltaron");
            return;
        }

        // Modo normal: si hay un Flex en el grupo, abrir su detalle
        var firstFlexId = ids.FirstOrDefault(id => id > -1000);
        if (firstFlexId > 0)
        {
            var s = shipments?.FirstOrDefault(x => x.Id == firstFlexId);
            if (s is not null) { activeShipmentId = firstFlexId; selected = s; showDetail = true; StateHasChanged(); }
        }
    }

    [JSInvokable]
    public async Task OnMarkerClicked(int id)
    {
        // En modo orden o modo asignación, los clicks NO deben abrir la ventana de detalle,
        // sino ejecutar la acción del modo (numerar / asignar). Bloqueamos el comportamiento
        // de "abrir popup" para que el usuario pueda trabajar sin que se interponga el panel.
        if (modoGuiada)
        {
            if (id <= -1000)
            {
                var stopId = -1000 - id;
                var st = stops?.FirstOrDefault(x => x.Id == stopId);
                if (st is not null) await OnMarkerGuiada(st);
            }
            else
            {
                ToastService.Info("Ese envío no es una parada todavía. Metelo en una zona para poder ordenarlo.");
            }
            return;
        }
        if (modoOrden)
        {
            if (id <= -1000)
            {
                var stopId = -1000 - id;
                var st = stops?.FirstOrDefault(x => x.Id == stopId);
                if (st is not null) await OnMarkerOrden(st);
            }
            else
            {
                ToastService.Info("Este envío no es una parada todavía. Importalo desde el paso 'Sumar Flex' para poder ordenarlo.");
            }
            return;
        }
        if (modoAsignacion)
        {
            if (id <= -1000)
            {
                var stopId = -1000 - id;
                var st = stops?.FirstOrDefault(x => x.Id == stopId);
                if (st is not null) await OnMarkerAssign(st);
            }
            else
            {
                // Flex / ME1 click en modo asignación: lo importamos como parada Y le asignamos
                // el V activo en una sola operación. Asi el usuario ve el marker pintarse del
                // color del V sin tener que ir antes al modal "Sumar Flex a paradas".
                var ship = shipments?.FirstOrDefault(x => x.Id == id);
                if (ship is null) return;
                await ImportarShipmentYAsignarV(ship);
            }
            return;
        }
        // Modo normal: click abre el panel de detalle del envío
        if (id <= -1000) return;
        var s = shipments?.FirstOrDefault(x => x.Id == id);
        if (s is not null) { activeShipmentId = id; selected = s; showDetail = true; StateHasChanged(); }
    }

