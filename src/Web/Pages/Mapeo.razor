    private async Task AddFavorito()
    {
        if (string.IsNullOrWhiteSpace(newFavAlias) || (newFavLat == 0 && newFavLng == 0)) return;
        try
        {
            var dto = new MapeoFavoritoDto
            {
                Alias = newFavAlias.Trim(),
                Direccion = newFavDireccion,
                Latitude = newFavLat, Longitude = newFavLng,
                ContactName = string.IsNullOrWhiteSpace(newFavContact) ? null : newFavContact.Trim(),
                Telefono = string.IsNullOrWhiteSpace(newFavPhone) ? null : newFavPhone.Trim(),
                Notas = string.IsNullOrWhiteSpace(newFavNotas) ? null : newFavNotas.Trim()
            };
            var f = await Api.CreateMapeoFavoritoAsync(dto);
            if (f is not null)
            {
                favoritos ??= new(); favoritos.Insert(0, f);
                newFavAlias = ""; newFavQuery = ""; newFavDireccion = ""; newFavContact = ""; newFavPhone = ""; newFavNotas = "";
                newFavLat = 0; newFavLng = 0; favGeocodeResults = null;
                ToastService.Success("Favorito guardado");
            }
        }
        catch (Exception ex) { ToastService.Error("Error: " + ex.Message); }
    }

    // Guardar una parada del listado como favorito (para después poder elegirla como punto de partida).
    private async Task SaveStopAsFavorito(MapeoStopDto st)
    {
        if (st.Latitude == 0 && st.Longitude == 0) { ToastService.Error("Esta parada no tiene ubicación en el mapa."); return; }
        if (favoritos?.Any(f => Math.Abs(f.Latitude - st.Latitude) < 0.0001m && Math.Abs(f.Longitude - st.Longitude) < 0.0001m) ?? false)
        { ToastService.Info("Ya está en tus favoritos."); return; }
        var sugerido = st.Alias ?? st.ContactName ?? st.Direccion ?? "Favorito";
        var nombre = await JS.InvokeAsync<string?>("prompt", "Ponele un nombre a este favorito:", sugerido);
        if (string.IsNullOrWhiteSpace(nombre)) return; // canceló
        savingStopFav = true;
        try
        {
            var dto = new MapeoFavoritoDto
            {
                Alias = nombre.Trim(),
                Direccion = st.Direccion ?? "",
                Latitude = st.Latitude, Longitude = st.Longitude,
                ContactName = string.IsNullOrWhiteSpace(st.ContactName) ? null : st.ContactName,
                Telefono = string.IsNullOrWhiteSpace(st.Telefono) ? null : st.Telefono,
                Notas = string.IsNullOrWhiteSpace(st.Notas) ? null : st.Notas
            };
            var f = await Api.CreateMapeoFavoritoAsync(dto);
            if (f is not null)
            {
                favoritos ??= new(); favoritos.Insert(0, f);
                ToastService.Success($"⭐ '{nombre}' guardado en favoritos");
            }
        }
        catch (Exception ex) { ToastService.Error("Error: " + ex.Message); }
        finally { savingStopFav = false; }
    }

    private async Task DeleteFavorito(MapeoFavoritoDto f)
