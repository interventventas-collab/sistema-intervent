    // Reconstruye los cuadraditos "Zona 1 / Zona 2 / ..." a partir de las paradas YA guardadas,
    // agrupándolas por repartidor asignado. Se llama al abrir la pantalla para que los cuadraditos
    // sobrevivan a un refresco (antes vivían solo en memoria y se perdían al recargar la página).
    private void ReconstruirZonasCreadas()
    {
        if (zonasCreadas.Count > 0) return; // ya hay zonas de esta sesión: no las pisamos
        if (stops is null) return;
        zonasCreadas = stops
            .Where(s => s.AssignedDriverId.HasValue)
            .GroupBy(s => s.AssignedDriverId!.Value)
            .Select(g => new
            {
                DriverId = g.Key,
                Orden = g.Min(s => s.OrderInRoute ?? int.MaxValue),
                Nombre = g.Select(s => s.AssignedDriverName).FirstOrDefault(n => !string.IsNullOrEmpty(n)) ?? "Repartidor",
                Color = g.Select(s => s.AssignedDriverColor).FirstOrDefault(c => !string.IsNullOrEmpty(c)) ?? "#1d4ed8",
                StopIds = g.Select(s => s.Id).ToList()
            })
            .OrderBy(x => x.Orden).ThenBy(x => x.DriverId)
            .Select((x, i) => new ZonaCreada(i + 1, x.DriverId, x.Nombre, x.Color!, x.StopIds))
            .ToList();
    }

    // Al tocar el cuadradito de una zona, encuadramos el mapa sobre sus envíos.
    private async Task FocoZona(ZonaCreada z)
    {
        // La zona tocada (CON chofer) pasa a ser la ZONA ACTIVA para "ordenar a mano" y "armar ruta guiada".
        // Así, si después entrás a esos modos, arrancan en ESTA zona (no siempre en la primera).
        ordenDriverId = z.DriverId;
        ordenSlot = null;
        var pts = (stops ?? new())
            .Where(s => z.StopIds.Contains(s.Id) && s.Latitude != 0 && s.Longitude != 0)
            .Select(s => new double[] { (double)s.Latitude, (double)s.Longitude })
            .ToArray();
        if (pts.Length == 0) { ToastService.Info("Esa zona ya no tiene envíos."); return; }
        // Si ya estás trabajando (ordenar a mano o ruta guiada), cambiamos a ESTA zona al toque:
        // mostramos solo la suya y limpiamos lo que venías eligiendo, para no quedar enganchado a otra.
        if (modoOrden || modoGuiada)
        {
            MostrarSoloZonaOrdenActiva();
            guiadaPrimeraId = null; guiadaUltimaId = null; guiadaFijasMedio.Clear();
            await RenderMap();
        }
        try { await JS.InvokeVoidAsync("mapeoFlex.fitPoints", new object[] { pts }); } catch { }
        ToastService.Info($"Zona {z.Numero} · {z.DriverName} · {pts.Length} envío(s)");
    }

    private bool limpiandoAsignaciones;
    // Saca el repartidor (y el número de orden) de TODAS las paradas, para empezar el zoneo de cero.
    private async Task LimpiarAsignaciones()
    {
        showConfigMenu = false;
        showZonasMenu = false;
        // Una parada está "en una zona" si tiene chofer, o zona sin chofer (slot), o un orden armado.
        var asignadas = (stops ?? new()).Where(s => s.AssignedDriverId.HasValue || s.AssignedVehicleSlot.HasValue || s.OrderInRoute.HasValue).ToList();
        if (asignadas.Count == 0) { ToastService.Info("No hay zonas para limpiar."); return; }
        if (!await ConfirmAsync($"¿Deshacer las zonas de las {asignadas.Count} paradas?\n\nNo borra las paradas ni los envíos — solo las saca de las zonas (y de los choferes) para volver a armar todo desde cero.")) return;
        limpiandoAsignaciones = true;
        StateHasChanged();
        try
        {
            // Sacamos chofer y orden de cada parada, y de una limpiamos TODAS las zonas sin chofer (slots).
            foreach (var s in asignadas)
                await Api.UpdateMapeoStopAsync(s.Id, new { assignedDriverId = 0, orderInRoute = 0 });
            await Api.ClearVehicleAssignmentsAsync();
            await LoadStops();
            await RenderMap();
            lastZoneUndo = new();
            zonasCreadas = new();
            zonasOcultasMapa = new();
            zonasSlotOcultas = new();
            sinAsignarOcultos = false;
            rutasResumen = new();
            ToastService.Success($"🧹 {asignadas.Count} paradas quedaron sin zona, listas para volver a armar.");
        }
        catch (Exception ex) { ToastService.Error("No se pudo limpiar: " + ex.Message); }
        finally { limpiandoAsignaciones = false; StateHasChanged(); }
    }

