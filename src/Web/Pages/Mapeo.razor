    // ===== 2026-07-30: modo "corregir/mover pin" unificado =====
    // Mientras está activo: el mapa muestra SOLO ese pin (arrastrable, sin saltos de zoom), el buscador
    // lo reubica, y al final elegís si queda en la ficha del cliente (definitivo) o solo en esta entrega.
    private int? editandoPinStopId;
    private string? editandoPinNombre;
    private decimal? editPinLat;
    private decimal? editPinLng;
    private string editPinDireccion = "";   // texto del domicilio (lo que sale en el comprobante), editable
    private bool EditPinEsVenta;
    private bool EditPinTieneUbicacion => editPinLat.HasValue && editPinLng.HasValue;

    private async Task IniciarEdicionPin(int stopId, string nombre)
    {
        var st = stops?.FirstOrDefault(x => x.Id == stopId);
        var tieneUbic = st is not null && (st.Latitude != 0 || st.Longitude != 0);
        editandoPinStopId = stopId;
        editandoPinNombre = nombre;
        editPinLat = tieneUbic ? st!.Latitude : (decimal?)null;
        editPinLng = tieneUbic ? st!.Longitude : (decimal?)null;
        editPinDireccion = st?.Direccion ?? "";   // precargamos el domicilio actual (como sale en el comprobante)
        EditPinEsVenta = st?.Origin == "venta_cafe";
        // Salir de otros modos y dejar SOLO este pin arrastrable.
        corrigiendoDomicilioStopId = null; corrigiendoDomicilioNombre = null;
        paradasDesbloqueadas.Clear();
        paradasDesbloqueadas.Add(stopId);
        await RenderMap(keepView: true);   // dibuja únicamente este pin
        if (EditPinTieneUbicacion)
        { try { await JS.InvokeVoidAsync("mapeoFlex.focusOn", (double)editPinLat!.Value, (double)editPinLng!.Value, 17); } catch { } }
        StateHasChanged();
    }

    private void SalirEdicionPin()
    {
        if (editandoPinStopId is int sid) paradasDesbloqueadas.Remove(sid);
        editandoPinStopId = null; editandoPinNombre = null;
        editPinLat = null; editPinLng = null; editPinDireccion = "";
        EditPinEsVenta = false;
    }

    private async Task CancelarEdicionPin()
    {
        SalirEdicionPin();
        await RenderMap();
        StateHasChanged();
    }

    private async Task GuardarEdicionPin(bool guardarEnCliente)
    {
        if (editandoPinStopId is not int sid) return;
        if (!EditPinTieneUbicacion)
        { ToastService.Error("Primero buscá la dirección o arrastrá el pin al lugar correcto."); return; }
        var lat = (double)editPinLat!.Value; var lng = (double)editPinLng!.Value;
        var dir = string.IsNullOrWhiteSpace(editPinDireccion) ? null : editPinDireccion;
        try
        {
            await Api.SetMapeoStopUbicacionAsync(sid, lat, lng, dir, guardarEnCliente);
            SalirEdicionPin();
            await LoadStops();
            await RenderMap();
            try { await JS.InvokeVoidAsync("mapeoFlex.focusOn", lat, lng, 16); } catch { }
            ToastService.Success(guardarEnCliente
                ? "📍 Ubicación corregida y guardada en la ficha del cliente"
                : "📍 Ubicación corregida (solo esta entrega)");
            StateHasChanged();
        }
        catch (Exception ex) { ToastService.Error("No se pudo guardar la ubicación: " + ex.Message); }
    }

    // Candado por parada: si está desbloqueada, su pin se puede arrastrar en el mapa para ubicarlo al metro.
    private HashSet<int> paradasDesbloqueadas = new();
    private async Task ToggleCandado(int stopId)
    {
        if (!paradasDesbloqueadas.Add(stopId)) paradasDesbloqueadas.Remove(stopId);
        await RenderMap(); // redibuja el pin como arrastrable (o fijo)
        StateHasChanged();
    }

    // Se llama desde el JS cuando arrastrás y soltás el pin de una parada desbloqueada.
    [JSInvokable]
    public async Task OnStopDragged(int stopId, double lat, double lng)
    {
        // Modo "corregir/mover pin": el arrastre solo fija la ubicación PENDIENTE; se guarda al elegir
        // "definitivo" o "solo esta vez". No re-renderizamos (el pin ya está donde lo soltaste).
        if (editandoPinStopId == stopId)
        {
            editPinLat = (decimal)lat;
            editPinLng = (decimal)lng;
            StateHasChanged();
            return;
        }
        try
        {
            await Api.SetMapeoStopUbicacionAsync(stopId, lat, lng, null);
            paradasDesbloqueadas.Remove(stopId); // lo volvemos a bloquear: fue un ajuste puntual
            await LoadStops();
            await RenderMap();
            ToastService.Success("📍 Ubicación ajustada y guardada");
            StateHasChanged();
        }
        catch (Exception ex) { ToastService.Error("No se pudo guardar la ubicación: " + ex.Message); }
    }

    // 2026-07-25: el buscador de Google (Places) eligió una dirección → creamos o corregimos una parada.
    [JSInvokable]
    public async Task OnPlacePicked(double lat, double lng, string direccion)
    {
        // Modo "corregir/mover pin": el buscador reubica el pin (queda pendiente; se guarda al elegir la opción).
        if (editandoPinStopId is not null)
        {
            editPinLat = (decimal)lat;
            editPinLng = (decimal)lng;
            // El buscador propone el texto del domicilio; el usuario lo puede seguir editando a mano.
            if (!string.IsNullOrWhiteSpace(direccion)) editPinDireccion = direccion;
            await RenderMap(keepView: true);
            try { await JS.InvokeVoidAsync("mapeoFlex.focusOn", lat, lng, 17); } catch { }
            StateHasChanged();
            return;
        }
        try
        {
            // Si estamos corrigiendo una parada, le asignamos esta dirección (y se guarda en el cliente).
            if (corrigiendoDomicilioStopId is int sid)
            {
                await Api.SetMapeoStopUbicacionAsync(sid, lat, lng, string.IsNullOrWhiteSpace(direccion) ? null : direccion);
                corrigiendoDomicilioStopId = null;
                corrigiendoDomicilioNombre = null;
                await LoadStops();
                await RenderMap();
                try { await JS.InvokeVoidAsync("mapeoFlex.focusOn", lat, lng, 16); } catch { }
                ToastService.Success("📍 Domicilio cargado y guardado en la ficha del cliente");
                StateHasChanged();
                return;
            }
            await Api.CreateMapeoStopAsync("manual", null, null,
                string.IsNullOrWhiteSpace(direccion) ? "Punto en el mapa" : direccion,
                (decimal)lat, (decimal)lng, null, null, null);
            await LoadStops();
            await RenderMap();
            ToastService.Success("📍 Dirección agregada al mapa");
            StateHasChanged();
        }
        catch (Exception ex) { ToastService.Error("No se pudo agregar: " + ex.Message); }
    }

    // Se dispara cuando el usuario arrastra la casita del punto de partida y la suelta.
    // Guarda la nueva posición (misma dirección/nombre, solo se afinan las coordenadas).
    [JSInvokable]
    public async Task OnStartPointDragged(double lat, double lng)
    {
        if (startPoint is null) return;
        try
        {
            // Averiguamos ANTES de mover si el punto de partida viene de un favorito (por id o por dirección),
            // así ese favorito también aprende la ubicación corregida y no se vuelve a correr.
            var fav = favoritos?.FirstOrDefault(f => f.Id == startFavoritoId)
                      ?? favoritos?.FirstOrDefault(f => !string.IsNullOrEmpty(startPoint.Address)
                            && (f.Alias == startPoint.Address || f.Direccion == startPoint.Address));

            startPoint.Lat = (decimal)lat;
            startPoint.Lng = (decimal)lng;
            var ok = await Api.SetMapeoStartPointAsync(startPoint.Address ?? "", startPoint.Lat, startPoint.Lng);

            if (fav is not null)
            {
                fav.Latitude = (decimal)lat;
                fav.Longitude = (decimal)lng;
                try { await Api.UpdateMapeoFavoritoAsync(fav.Id, fav); } catch { }
            }

            if (ok) ToastService.Success(fav is not null
                ? $"📍 Ajustado y guardado en el favorito '{fav.Alias}'"
                : "📍 Punto de partida ajustado");
            StateHasChanged();
        }
        catch (Exception ex) { ToastService.Error("No se pudo ajustar: " + ex.Message); }
    }

