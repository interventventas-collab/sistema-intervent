    // 2026-08-06: selector de ZONA dentro del globito. slot: 0 = sin zona, -1 = zona nueva, >0 = zona existente.
    // Al mandarlo a una zona que YA tiene chofer, el envío hereda ese chofer; si no, queda sin chofer.
    [JSInvokable]
    public async Task AsignarZonaDesdePopup(int markerId, int slot)
    {
        if (markerId > -1000) return; // solo paradas (stops)
        var stopId = -1000 - markerId;
        var st = stops?.FirstOrDefault(x => x.Id == stopId);
        if (st is null) return;
        assigningSlot = true;
        try
        {
            if (slot == 0)
            {
                // Sin zona: la sacamos de todo (zona, chofer y orden).
                await Api.AssignVehicleSlotAsync(st.Id, null);
                await Api.UpdateMapeoStopAsync(st.Id, new { assignedDriverId = 0, orderInRoute = 0 });
                ToastService.Info("Envío sacado de la zona.");
            }
            else
            {
                int destino = slot == -1
                    ? ((stops ?? new()).Select(x => x.AssignedVehicleSlot ?? 0).DefaultIfEmpty(0).Max() + 1)
                    : slot;
                await Api.AssignVehicleSlotAsync(st.Id, destino);
                // Si esa zona ya tiene chofer, el envío nuevo lo hereda; si no, queda sin chofer.
                var chofer = (stops ?? new()).FirstOrDefault(x => x.AssignedVehicleSlot == destino && x.Id != st.Id && x.AssignedDriverId.HasValue)?.AssignedDriverId;
                await Api.UpdateMapeoStopAsync(st.Id, new { assignedDriverId = chofer ?? 0, orderInRoute = 0 });
                if (cantidadVehiculos < destino) cantidadVehiculos = destino;
                ToastService.Success($"✅ Envío agregado a la Zona {destino}.");
            }
            await LoadStops();
            ReconstruirZonasCreadas();
            await RenderMap();
            rutasResumen = new();
        }
        catch (Exception ex) { ToastService.Error("Error: " + ex.Message); }
        finally { assigningSlot = false; StateHasChanged(); }
    }

