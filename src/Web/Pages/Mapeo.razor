    private async Task TraerPorNumero()
    {
        if (trayendoPorNumero) return;
        // Un número por línea (permite pegar varios de una). Sacamos vacíos y repetidos.
        var numeros = (porNumeroTexto ?? "")
            .Split(new[] { '\n', '\r', ',', ';' }, StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries)
            .Distinct(StringComparer.OrdinalIgnoreCase)
            .ToList();
        if (numeros.Count == 0) { ToastService.Info("Escribí al menos un número."); return; }

        trayendoPorNumero = true;
        porNumeroResultados = new();
        int agregados = 0;
        try
        {
            foreach (var n in numeros)
            {
                try
                {
                    var r = await Api.TraerPorNumeroAsync(n);
                    porNumeroResultados.Add(new PorNumeroLineaVm
                    {
                        Numero = n,
                        Ok = r?.Ok ?? false,
                        YaEstaba = r?.YaEstaba ?? false,
                        Tipo = r?.Tipo,
                        Nombre = r?.Nombre,
                        Mensaje = r?.Mensaje ?? "No hubo respuesta."
                    });
                    if ((r?.Ok ?? false) && !(r?.YaEstaba ?? false)) agregados++;
                }
                catch (Exception ex)
                {
                    porNumeroResultados.Add(new PorNumeroLineaVm { Numero = n, Ok = false, Mensaje = "Error: " + ex.Message });
                }
                StateHasChanged();
            }
            if (agregados > 0)
            {
                await LoadStops();
                await RenderMap();
                ToastService.Success($"✓ {agregados} parada(s) agregada(s) al mapa.");
            }
            else if (porNumeroResultados.Any(x => x.Ok))
            {
                ToastService.Info("Esas paradas ya estaban en el mapa.");
            }
            else
            {
                ToastService.Error("No pude traer ninguna. Revisá los números.");
            }
            porNumeroTexto = "";
        }
        finally { trayendoPorNumero = false; StateHasChanged(); }
    }

