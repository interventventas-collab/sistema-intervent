                                           style="display:inline-flex; align-items:center; padding:0.05rem 0.35rem; background:#dbeafe; color:#1e40af; border-radius:4px; font-size:0.65rem; font-weight:700; text-decoration:none;">
                                            🗺
                                        </a>
                                    }
                                </div>
                                @if (!string.IsNullOrEmpty(st.Telefono))
                                { <div style="font-size:0.72rem; color:#6b7280;">📞 @st.Telefono</div> }
                                @* Novedad del repartidor: estado que marcó desde su celular + comentario que dejó. *@
                                @if (!string.Equals(st.InternalStatus, "pending", StringComparison.OrdinalIgnoreCase))
                                {
                                    <div style="margin-top:0.25rem;">
                                        <span style="@StatusStyle(st.InternalStatus) padding:0.1rem 0.5rem; border-radius:999px; font-size:0.68rem; font-weight:800;">@StatusIcon(st.InternalStatus) @StatusLabel(st.InternalStatus)</span>
                                    </div>
                                }
                                @if (!string.IsNullOrWhiteSpace(st.Notas))
                                { <div style="font-size:0.72rem; color:#78350f; background:#fef3c7; padding:0.25rem 0.5rem; border-radius:6px; margin-top:0.25rem;">💬 @st.Notas</div> }
                                @* Sin domicilio en el mapa: cartel + buscar. Con domicilio: opción de corregirlo. *@
                                @{ var stNombreDom = st.Alias ?? st.ContactName ?? "Parada"; }
                                @if (st.Latitude == 0 && st.Longitude == 0)
                                {
                                    <div style="margin-top:0.3rem; background:#fef2f2; border:1px solid #fecaca; color:#b91c1c; border-radius:6px; padding:0.3rem 0.45rem; font-size:0.72rem; display:flex; align-items:center; gap:0.4rem; flex-wrap:wrap;" @onclick:stopPropagation="true">
                                        <span>⚠ Sin domicilio cargado</span>
                                        <button class="btn" style="font-size:0.7rem; padding:0.15rem 0.5rem; background:#b91c1c; color:#fff; border:none; border-radius:5px;" @onclick="() => IniciarEdicionPin(st.Id, stNombreDom)">📍 Buscar en el mapa</button>
                                    </div>
                                }
                                else
                                {
                                    <div style="margin-top:0.2rem; display:flex; gap:0.35rem; align-items:center; flex-wrap:wrap;" @onclick:stopPropagation="true">
                                        <button class="btn" style="font-size:0.66rem; padding:0.08rem 0.5rem; background:@(editandoPinStopId == st.Id ? "#fef3c7" : "transparent"); border:1px solid @(editandoPinStopId == st.Id ? "#f59e0b" : "#d1d5db"); color:@(editandoPinStopId == st.Id ? "#92400e" : "#6b7280"); border-radius:5px;" @onclick="() => IniciarEdicionPin(st.Id, stNombreDom)" title="Corregir/mover la ubicación de este pin: mostramos solo este pin, lo buscás o arrastrás, y elegís cómo guardarlo">📍 Corregir ubicación</button>
                                    </div>
                                }
                                @* Selector de repartidor por parada: escaneás y elegís acá quién la lleva. *@
                                <div style="margin-top:0.3rem;" @onclick:stopPropagation="true">
                                    <select class="form-input" style="font-size:0.72rem; padding:0.15rem 0.3rem; width:100%; border-color:@(st.AssignedDriverId.HasValue ? stopColor : "#d1d5db");"
                                            value="@(st.AssignedDriverId?.ToString() ?? "")"
                                            @onchange="@(e => AsignarRepartidor(st, e.Value?.ToString()))">
                                        <option value="">🚚 Elegir repartidor…</option>
                                        @foreach (var d in (drivers ?? new()).Where(d => d.IsActive))
                                        {
                                            <option value="@d.Id">@d.Nombre</option>
                                        }
                                    </select>
                                </div>
                                @if (asignado)
                                {
                                    <div style="display:flex; gap:0.3rem; margin-top:0.3rem; flex-wrap:wrap;">
                                        @if (st.AssignedVehicleSlot.HasValue)
                                        {
                                            <span style="display:inline-block; padding:0.1rem 0.4rem; background:@stopColor; color:white; border-radius:4px; font-size:0.68rem; font-weight:700;">
                                                Zona @(st.AssignedVehicleSlot)
                                            </span>
                                        }
                                        @if (!string.IsNullOrEmpty(st.AssignedDriverName))
                                        {
                                            <span style="display:inline-block; padding:0.1rem 0.4rem; background:white; border:1px solid @stopColor; color:@stopColor; border-radius:4px; font-size:0.68rem; font-weight:700;">
                                                👤 @st.AssignedDriverName
                                            </span>
                                        }
                                        @if (st.OrderInRoute.HasValue)
                                        {
                                            <span style="display:inline-block; padding:0.1rem 0.4rem; background:#1f2937; color:white; border-radius:4px; font-size:0.68rem; font-weight:700;">
                                                #@st.OrderInRoute
                                            </span>
                                        }
                                    </div>
                                }
                                @* Entregado: chip verde compacto; al pincharlo muestra SOLO fecha y hora. *@
                                @if (string.Equals(st.MeliStatus, "delivered", StringComparison.OrdinalIgnoreCase))
                                {
                                    var eKey = "M" + st.Id;
                                    <div style="margin-top:0.3rem;" @onclick:stopPropagation="true">
                                        <span @onclick="() => ToggleEntregaDetalle(eKey)"
                                              title="Entregado — tocá para ver fecha y hora"
                                              style="cursor:pointer; display:inline-flex; align-items:center; gap:0.25rem; background:#dcfce7; color:#15803d; border:1px solid #86efac; padding:0.1rem 0.45rem; border-radius:999px; font-size:0.72rem; font-weight:800;">
                                            ✔ Entregado
                                        </span>
                                        @if (entregaDetalleAbierta.Contains(eKey))
                                        {
                                            <div style="font-size:0.72rem; color:#166534; margin-top:0.15rem;">
                                                🕒 @(st.DateDelivered.HasValue ? st.DateDelivered.Value.ToArTime().ToString("dd/MM/yyyy 'a las' HH:mm") + " hs" : "sin fecha")
                                            </div>
                                        }
                                    </div>
                                }
                            </div>
                            }
                            }
                            }
                            </div>
                        </div>
                    }
                }
            }
        </div>
    </div>
    <div class="mapeo-map" style="position:relative;">
        @if (dibujandoZona)
        {
            <div style="position:absolute; top:12px; left:50%; transform:translateX(-50%); z-index:600; background:#1d4ed8; color:#fff; border-radius:10px; box-shadow:0 3px 14px rgba(0,0,0,0.35); padding:0.5rem 0.7rem; display:flex; gap:0.6rem; align-items:center; flex-wrap:wrap;">
                <span style="font-size:0.85rem; font-weight:600;">✏️ Tocá alrededor de los envíos para marcar la zona — apretá "Terminar zona" para asignarla</span>
                <button class="btn" style="font-size:0.85rem; font-weight:800; background:#16a34a; color:#fff; border:none; padding:0.35rem 0.8rem; border-radius:8px; cursor:pointer;"
                        @onclick="TerminarZona">✓ Terminar zona</button>
                <button class="btn" style="font-size:0.85rem; font-weight:700; background:transparent; color:#fff; border:1px solid #fff; padding:0.35rem 0.7rem; border-radius:8px; cursor:pointer;"
                        @onclick="DeshacerUltimoPunto" title="Sacar la última esquina que marcaste">↩ Deshacer punto</button>
                <button class="btn" style="font-size:0.85rem; font-weight:700; background:transparent; color:#fff; border:1px solid #fff; padding:0.35rem 0.7rem; border-radius:8px; cursor:pointer;"
                        @onclick="CancelarZona">✕ Cancelar</button>
            </div>
        }
        @* ═════════ Barra flotante: Ordenar a mano (numerar por zona tocando los globitos) ═════════ *@
        @if (modoOrden)
        {
            var ordDriverIds = (stops ?? new()).Where(s => s.AssignedDriverId.HasValue)
                .Select(s => s.AssignedDriverId!.Value).Distinct().OrderBy(x => x).ToList();
            var ordSlots = (stops ?? new()).Where(s => !s.AssignedDriverId.HasValue && s.AssignedVehicleSlot.HasValue)
                .Select(s => s.AssignedVehicleSlot!.Value).Distinct().OrderBy(x => x).ToList();
            var ordStopsZona = (stops ?? new()).Where(EnZonaOrden).ToList();
            var ordColor = ordenDriverId.HasValue
                ? (ordStopsZona.Select(s => s.AssignedDriverColor).FirstOrDefault(c => !string.IsNullOrEmpty(c)) ?? "#1d4ed8")
                : (ordenSlot.HasValue ? VehicleColor(ordenSlot.Value) : "#1d4ed8");
            var ordNumeradas = ordStopsZona.Count(s => s.OrderInRoute.HasValue);
            var ordProximo = ordStopsZona.Select(s => s.OrderInRoute ?? 0).DefaultIfEmpty(0).Max() + 1;
            var ordNombre = NombreZonaOrden();
            var ordSelValue = ordenDriverId.HasValue ? $"d:{ordenDriverId}" : (ordenSlot.HasValue ? $"s:{ordenSlot}" : "");
            <div style="position:absolute; top:12px; left:50%; transform:translateX(-50%); z-index:600; background:@ordColor; color:#fff; border-radius:12px; box-shadow:0 4px 16px rgba(0,0,0,0.4); padding:0.55rem 0.8rem; display:flex; flex-direction:column; gap:0.4rem; max-width:94vw;">
                <div style="display:flex; gap:0.55rem; align-items:center; flex-wrap:wrap;">
                    <span style="font-size:0.9rem; font-weight:800;">🔢 Ordenar a mano</span>
                    <select class="form-input" style="font-size:0.82rem; max-width:210px; color:#1f2937;" @onchange="OnZonaOrdenChanged">
                        @foreach (var did in ordDriverIds)
                        {
                            var nom = drivers?.FirstOrDefault(d => d.Id == did)?.Nombre ?? $"Repartidor {did}";
                            var cant = (stops ?? new()).Count(s => s.AssignedDriverId == did);
                            <option value="@($"d:{did}")" selected="@(ordSelValue == $"d:{did}")">🧑 @nom (@cant)</option>
                        }
                        @foreach (var sl in ordSlots)
                        {
                            var cant = (stops ?? new()).Count(s => !s.AssignedDriverId.HasValue && s.AssignedVehicleSlot == sl);
                            <option value="@($"s:{sl}")" selected="@(ordSelValue == $"s:{sl}")">📍 Zona @sl (@cant)</option>
                        }
                    </select>
                    <span style="font-size:0.82rem; font-weight:800; background:#fff; color:@ordColor; border-radius:8px; padding:0.2rem 0.55rem;">Próximo: #@ordProximo</span>
                    <span style="font-size:0.76rem; font-weight:700; opacity:0.95;">@ordNumeradas/@ordStopsZona.Count listas</span>
                    <button class="btn" style="font-size:0.8rem; font-weight:700; background:rgba(255,255,255,0.18); color:#fff; border:1px solid rgba(255,255,255,0.6); padding:0.3rem 0.6rem; border-radius:8px; cursor:pointer;"
                            @onclick="ResetOrdenDeLaZona" disabled="@assigningSlot">🔄 Reiniciar</button>
                    <button class="btn" style="font-size:0.82rem; font-weight:800; background:#16a34a; color:#fff; border:none; padding:0.32rem 0.8rem; border-radius:8px; cursor:pointer;"
                            @onclick="ToggleModoOrden">✓ Listo (dibujar ruta)</button>
                </div>
                <div style="font-size:0.76rem; opacity:0.95; line-height:1.35;">
                    Tocá los globitos de <strong>@ordNombre</strong> en el orden de entrega — se numeran 1, 2, 3…
                    Tocá uno ya numerado para sacarlo. Cambiá de zona con el desplegable. Al terminar, apretá <strong>Listo</strong> y se dibuja la ruta.
                </div>
            </div>
        }
        @* ═════════ Barra flotante: Armar ruta guiada (elegir primera + última, ordena el resto) ═════════ *@
        @if (modoGuiada)
        {
            var gPrimera = stops?.FirstOrDefault(x => x.Id == guiadaPrimeraId);
            var gUltima = stops?.FirstOrDefault(x => x.Id == guiadaUltimaId);
            var gPaso = !guiadaPrimeraId.HasValue ? 1 : (!guiadaUltimaId.HasValue ? 2 : 3);
            var gTxt = gPaso == 1 ? "Tocá la parada que va PRIMERA (la que sale a repartir apenas arranca)."
                     : gPaso == 2 ? "Ahora tocá la que va ÚLTIMA (ej: la que te queda de paso a tu casa)."
                     : "¡Listo! Apretá \"Armar ruta\" y ordeno todas las del medio. Opcional: tocá alguna del medio para clavarla en el orden que la tocás.";
            var gPrimeraNom = gPrimera?.Alias ?? gPrimera?.ContactName ?? (guiadaPrimeraId.HasValue ? "elegida" : "—");
            var gUltimaNom = gUltima?.Alias ?? gUltima?.ContactName ?? (guiadaUltimaId.HasValue ? "elegida" : "—");
            <div style="position:absolute; top:12px; left:50%; transform:translateX(-50%); z-index:600; background:@(gPaso==3?"#16a34a":"#1d4ed8"); color:#fff; border-radius:12px; box-shadow:0 4px 16px rgba(0,0,0,0.4); padding:0.6rem 0.85rem; display:flex; flex-direction:column; gap:0.45rem; max-width:94vw; width:520px;">
                <div style="display:flex; gap:0.5rem; align-items:center;">
                    <span style="font-size:1rem;">🧭</span>
                    <span style="font-size:0.92rem; font-weight:800;">Armar ruta guiada</span>
                    <span style="font-size:0.72rem; font-weight:700; background:rgba(255,255,255,0.22); border-radius:8px; padding:0.15rem 0.5rem;">@(gPaso==3 ? "Listo" : $"Paso {gPaso} de 3")</span>
                </div>
                <div style="font-size:0.85rem; line-height:1.35;">@gTxt</div>
                <div style="display:flex; gap:0.5rem; font-size:0.74rem; flex-wrap:wrap; align-items:center;">
                    <span style="background:#16a34a; color:#fff; border-radius:8px; padding:0.15rem 0.5rem;">🟢 1ª: <strong>@gPrimeraNom</strong></span>
                    <span style="background:#dc2626; color:#fff; border-radius:8px; padding:0.15rem 0.5rem;">🔴 Última: <strong>@gUltimaNom</strong></span>
                    @if (guiadaFijasMedio.Count > 0)
                    {
                        <span style="background:#2563eb; color:#fff; border-radius:8px; padding:0.15rem 0.5rem;">🔵 Clavadas: <strong>@guiadaFijasMedio.Count</strong></span>
                    }
                </div>
                <div style="display:flex; gap:0.5rem; align-items:center; flex-wrap:wrap;">
                    <button class="btn" style="font-size:0.85rem; font-weight:800; background:#fff; color:#1d4ed8; border:none; padding:0.35rem 0.9rem; border-radius:8px; cursor:pointer;"
                            @onclick="ArmarGuiada" disabled="@(armandoGuiada || !guiadaPrimeraId.HasValue || !guiadaUltimaId.HasValue)">
                        @(armandoGuiada ? "Armando…" : "✨ Armar ruta")
                    </button>
                    <button class="btn" style="font-size:0.8rem; font-weight:700; background:rgba(255,255,255,0.18); color:#fff; border:1px solid rgba(255,255,255,0.6); padding:0.32rem 0.7rem; border-radius:8px; cursor:pointer;"
                            @onclick="ReiniciarGuiada" disabled="@armandoGuiada">↩ Empezar de nuevo</button>
                    <button class="btn" style="font-size:0.8rem; font-weight:800; background:transparent; color:#fff; border:1px solid #fff; padding:0.32rem 0.7rem; border-radius:8px; cursor:pointer;"
                            @onclick="ToggleModoGuiada">✓ Salir</button>
                </div>
            </div>
        }
        @* ═════════ Barra flotante: Armar ruta INTERACTIVA (estilo Google Maps) ═════════ *@
        @if (modoArmar)
        {
            var arKm = (armarTotalMetros / 1000.0);
            var arHayTotal = armarTotalSec > 0;
            <div style="position:absolute; top:12px; left:50%; transform:translateX(-50%); z-index:600; background:#1d4ed8; color:#fff; border-radius:12px; box-shadow:0 4px 16px rgba(0,0,0,0.4); padding:0.6rem 0.85rem; display:flex; flex-direction:column; gap:0.45rem; max-width:94vw; width:560px;">
                <div style="display:flex; gap:0.5rem; align-items:center; flex-wrap:wrap;">
                    <span style="font-size:1rem;">🖊️</span>
                    <span style="font-size:0.95rem; font-weight:800;">Armar ruta</span>
                    <span style="font-size:0.8rem; font-weight:800; background:#fff; color:#1d4ed8; border-radius:8px; padding:0.2rem 0.6rem;">@armarCount @(armarCount == 1 ? "parada" : "paradas")</span>
                    @if (arHayTotal)
                    {
                        <span style="font-size:0.85rem; font-weight:800; background:rgba(255,255,255,0.2); border-radius:8px; padding:0.2rem 0.6rem;">
                            🕒 @FmtDuracion(armarTotalSec) &nbsp;·&nbsp; 🛣️ @arKm.ToString("0.0").Replace('.', ',') km
                        </span>
                    }
                </div>
                <div style="font-size:0.78rem; opacity:0.95; line-height:1.35;">
                    Tocá los envíos en el orden que los vas a repartir. La línea se dibuja sola por las calles y arriba se va sumando el tiempo y los km. Cuando termines, apretá <strong>Terminar ruta</strong> y queda guardada.
                </div>
                <div style="display:flex; gap:0.5rem; align-items:center; flex-wrap:wrap;">
                    <label style="font-size:0.76rem; display:flex; align-items:center; gap:0.35rem; cursor:@(armarCount > 0 || !armarDepotLat.HasValue ? "default" : "pointer"); @(armarCount > 0 ? "opacity:0.55;" : "")"
                           title="@(armarDepotLat.HasValue ? "Arrancar la línea desde la casita del depósito" : "Configurá primero el punto de partida (la casita) para usar esto")">
                        <input type="checkbox" checked="@armarDesdeDeposito" disabled="@(armarCount > 0 || !armarDepotLat.HasValue)" @onchange="OnArmarDepotToggle" />
                        🏁 Arrancar desde el depósito
                    </label>
                    <button class="btn" style="font-size:0.8rem; font-weight:700; background:rgba(255,255,255,0.18); color:#fff; border:1px solid rgba(255,255,255,0.6); padding:0.3rem 0.65rem; border-radius:8px; cursor:pointer;"
                            @onclick="ArmarDeshacer" disabled="@(armarCount == 0)">↩ Deshacer punto</button>
                    <button class="btn" style="font-size:0.82rem; font-weight:800; background:#16a34a; color:#fff; border:none; padding:0.32rem 0.85rem; border-radius:8px; cursor:pointer;"
                            @onclick="ArmarTerminar" disabled="@(armarCount < 2 || armarGuardando)">@(armarGuardando ? "Guardando…" : "✓ Terminar ruta")</button>
                    <button class="btn" style="font-size:0.8rem; font-weight:800; background:transparent; color:#fff; border:1px solid #fff; padding:0.3rem 0.65rem; border-radius:8px; cursor:pointer;"
                            @onclick="ToggleModoArmar">✕ Cancelar</button>
                </div>
                @if (!armarDepotLat.HasValue)
                {
                    <div style="font-size:0.72rem; opacity:0.85;">💡 Para poder arrancar desde el depósito, primero fijá el punto de partida (la casita) en el mapa.</div>
                }
            </div>
        }
        @if (viewingSnapshot)
        {
            @* Cartel: estás mirando la foto de un día anterior (modo solo mirar). *@
            <div style="position:absolute; top:10px; left:50%; transform:translateX(-50%); z-index:560; display:flex; align-items:center; gap:0.7rem; background:#7c3aed; color:#fff; padding:0.5rem 0.9rem; border-radius:999px; box-shadow:0 4px 14px rgba(0,0,0,0.35); font-size:0.85rem; font-weight:700; max-width:92vw;">
                <span style="white-space:nowrap; overflow:hidden; text-overflow:ellipsis;">👁 Estás viendo: @viewingSnapshotTitle</span>
                <button class="btn" style="font-size:0.78rem; font-weight:800; background:#fff; color:#6d28d9; border:none; padding:0.3rem 0.7rem; border-radius:999px; white-space:nowrap;"
                        @onclick="SalirDelSnapshot">↩ Volver al mapa de hoy</button>
            </div>
        }
        @if (mapaFullscreen)
        {
            @* "← Volver" ya NO va acá flotando (tapaba el botón "Ver dirección al tocar").
               Ahora vive en la fila del buscador, arriba. *@
            @* Columna de botones (dock). Aparece a la DERECHA por defecto; se puede arrastrar
               de la manija (⣿) a cualquier lado y la posición queda guardada. *@
            <div id="mapeoDock" class="mapeo-dock" style="position:absolute; right:8px; top:50%; transform:translateY(-50%); z-index:530;">
                @* Manija para arrastrar toda la barra. *@
                <div class="mapeo-dock-handle" title="Arrastrame para mover la barra a donde quieras">
                    <span class="dot"></span><span class="dot"></span><span class="dot"></span>
                </div>
                @* Mostrar/ocultar el listado de la izquierda. *@
                <button class="mapeo-dock-btn" @onclick="ToggleSideCollapsed"
                        title="@(sideCollapsed ? "Mostrar el listado" : "Ocultar el listado")">
                    @if (sideCollapsed)
                    {
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="9 6 15 12 9 18"></polyline></svg>
                    }
                    else
                    {
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="4" width="18" height="16" rx="2"></rect><line x1="9" y1="4" x2="9" y2="20"></line></svg>
                    }
                    <span class="mapeo-dock-label">@(sideCollapsed ? "Mostrar listado" : "Ocultar listado")</span>
                </button>
                <div class="mapeo-dock-sep"></div>
                @* Actualizar entregas: le pregunta a MeLi por las entregas confirmadas (los ✔). Ícono de refrescar. *@
                <button class="mapeo-dock-btn" @onclick="ActualizarEntregas" disabled="@(actualizandoEntregas || isLoading)"
                        title="@(actualizandoEntregas ? "Actualizando entregas…" : "Actualizar entregas (preguntarle a MeLi por las entregas más recientes)")">
                    <svg class="@(actualizandoEntregas ? "mapeo-dock-spin" : "")" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="23 4 23 10 17 10"></polyline><polyline points="1 20 1 14 7 14"></polyline><path d="M3.51 9a9 9 0 0 1 14.85-3.36L23 10M1 14l4.64 4.36A9 9 0 0 0 20.49 15"></path></svg>
                    <span class="mapeo-dock-label">Entregas</span>
                    @if (entregadosHoy > 0 && !actualizandoEntregas)
                    {
                        <span class="mapeo-dock-badge">@entregadosHoy</span>
                    }
                </button>
                @* Escanear con el celular (muestra el QR) — ícono de cámara de fotos. *@
                <button class="mapeo-dock-btn" @onclick="OpenScanModal" title="Escanear con el celular, o traer por número (venta/alquiler/Flex)">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M23 19a2 2 0 0 1-2 2H3a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h4l2-3h6l2 3h4a2 2 0 0 1 2 2z"></path><circle cx="12" cy="13" r="4"></circle></svg>
                    <span class="mapeo-dock-label">Escanear</span>
                </button>
                @* Modo pistola: leer con el escáner FÍSICO (USB). Se prende/apaga; mientras está
                   verde, pasás las etiquetas por el escáner y las paradas caen solas al mapa. *@
                <button class="mapeo-dock-btn @(wedgeOn ? "activo" : "")" @onclick="ToggleWedge"
                        style="@(wedgeOn ? "background:#16a34a; color:#fff; border-color:#16a34a;" : "")"
                        title="@(wedgeOn ? "Leyendo con el escáner… (tocá para apagar)" : "Leer con el escáner físico: pasá las etiquetas por adelante")">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M3 7V5a2 2 0 0 1 2-2h2"></path><path d="M17 3h2a2 2 0 0 1 2 2v2"></path><path d="M21 17v2a2 2 0 0 1-2 2h-2"></path><path d="M7 21H5a2 2 0 0 1-2-2v-2"></path><line x1="7" y1="7" x2="7" y2="17"></line><line x1="10.5" y1="7" x2="10.5" y2="17"></line><line x1="14" y1="7" x2="14" y2="17"></line><line x1="17.5" y1="7" x2="17.5" y2="17"></line></svg>
                    <span class="mapeo-dock-label">Pistola</span>
                    @if (wedgeOn)
                    {
                        <span class="mapeo-dock-badge" style="background:#16a34a;">@wedgeCount</span>
                    }
                </button>
                @* Agregar parada manual — ícono de globito (pin) de Google. *@
                <button class="mapeo-dock-btn" @onclick="OpenAddStopModal" title="Agregar parada manual">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"></path><circle cx="12" cy="10" r="3"></circle></svg>
                    <span class="mapeo-dock-label">Agregar parada</span>
                </button>
                @* Zonificar: dibujar zonas sobre el mapa — ícono de lápiz sobre el recuadro. *@
                <div style="position:relative;">
                    <button class="mapeo-dock-btn @(showZonasMenu ? "activo" : "")" @onclick="() => showZonasMenu = !showZonasMenu" title="Zonificar (dibujar zonas sobre el mapa)">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 3H5a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7"></path><path d="M18.375 2.625a1 1 0 0 1 3 3l-9.013 9.014a2 2 0 0 1-.853.505l-2.873.84a.5.5 0 0 1-.62-.62l.84-2.873a2 2 0 0 1 .506-.852z"></path></svg>
                        <span class="mapeo-dock-label">Zonas</span>
                    </button>
                    @if (showZonasMenu)
                    {
                        <div class="mapeo-flyout" style="min-width:240px;">
                            <div style="display:flex; align-items:center; justify-content:space-between; gap:0.5rem; padding:0.2rem 0.4rem 0.2rem 0.6rem;">
                                <span style="font-size:0.72rem; color:#6b7280; font-weight:700;">ZONIFICAR</span>
                                <button @onclick="() => showZonasMenu = false" title="Cerrar" style="border:none; background:transparent; color:#6b7280; font-size:1.1rem; line-height:1; cursor:pointer; padding:0 0.2rem;">&times;</button>
                            </div>
                            <button class="btn" style="display:flex; width:100%; align-items:center; font-size:0.85rem; padding:0.45rem 0.6rem; background:transparent; color:#1f2937; border:none; text-align:left; font-weight:600;"
                                    @onclick="@(async () => { showZonasMenu = false; await IniciarDibujoZona(); })">
                                ✏️ Dibujar zona nueva
                            </button>
                            @if (lastZoneUndo.Count > 0)
                            {
                                <button class="btn" style="display:flex; width:100%; align-items:center; font-size:0.85rem; padding:0.45rem 0.6rem; background:transparent; color:#1f2937; border:none; text-align:left;"
                                        @onclick="@(async () => { showZonasMenu = false; await DeshacerUltimaZona(); })" disabled="@assigningZone">
                                    ↩ Deshacer última zona (@lastZoneUndo.Count)
                                </button>
                            }
                            <hr style="margin:0.3rem 0; border:none; border-top:1px solid #f3f4f6;" />
                            <button class="btn" style="display:flex; width:100%; align-items:center; font-size:0.85rem; padding:0.45rem 0.6rem; background:transparent; color:#b91c1c; border:none; text-align:left;"
                                    @onclick="@(async () => { showZonasMenu = false; await LimpiarAsignaciones(); })" disabled="@limpiandoAsignaciones">
                                @(limpiandoAsignaciones ? "Limpiando..." : "🧹 Limpiar asignaciones")
                            </button>
                        </div>
                    }
                </div>
                @* Ordenar a mano: numerar los envíos de cada zona tocándolos en el mapa (1, 2, 3…). *@
                <button class="mapeo-dock-btn @(modoOrden ? "activo" : "")" @onclick="ToggleModoOrden"
                        title="Ordenar a mano: tocá los envíos de una zona en el orden de entrega y se numeran 1, 2, 3…">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="10" y1="6" x2="21" y2="6"></line><line x1="10" y1="12" x2="21" y2="12"></line><line x1="10" y1="18" x2="21" y2="18"></line><text x="2.5" y="8.5" font-size="7" font-weight="700" stroke="none" fill="currentColor">1</text><text x="2.5" y="14.5" font-size="7" font-weight="700" stroke="none" fill="currentColor">2</text><text x="2.5" y="20.5" font-size="7" font-weight="700" stroke="none" fill="currentColor">3</text></svg>
                    <span class="mapeo-dock-label">Ordenar a mano</span>
                </button>
                @* Armar ruta guiada (método NUEVO): elegí la primera y la última parada de una zona y el
                   sistema ordena el resto. Sirve también ANTES de asignar choferes (por zona). *@
                <button class="mapeo-dock-btn @(modoGuiada ? "activo" : "")" @onclick="ToggleModoGuiada"
                        title="Armar ruta guiada: elegí la primera y la última parada de una zona y el sistema ordena el resto (podés hacerlo antes de poner choferes)">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polygon points="3 11 22 2 13 21 11 13 3 11"></polygon></svg>
                    <span class="mapeo-dock-label">Armar ruta guiada</span>
                </button>
                @* Armar ruta INTERACTIVA (estilo Google Maps): pinchás los envíos en orden y se va dibujando
                   la línea por las calles con el tiempo y los km en vivo. *@
                <button class="mapeo-dock-btn @(modoArmar ? "activo" : "")" @onclick="ToggleModoArmar"
                        title="Armar ruta como Google Maps: pinchá los envíos en orden y se va dibujando la línea por las calles con el tiempo y los km">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="6" cy="19" r="2.5"></circle><circle cx="18" cy="5" r="2.5"></circle><path d="M8.2 17.6 15.5 6.8"></path><path d="M6 16.5V13a3 3 0 0 1 3-3h4"></path></svg>
                    <span class="mapeo-dock-label">Armar ruta</span>
                </button>
                @* Prender/apagar el tránsito (embotellamientos). Arranca apagado = mapa limpio. Ícono semáforo. *@
                <button class="mapeo-dock-btn @(traficoOn ? "activo" : "")" @onclick="ToggleTrafico"
                        title="@(traficoOn ? "Tránsito ENCENDIDO — tocá para apagar" : "Ver tránsito (embotellamientos en rojo/amarillo/verde)")">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="8" y="2" width="8" height="20" rx="4"></rect><circle cx="12" cy="7" r="1.4"></circle><circle cx="12" cy="12" r="1.4"></circle><circle cx="12" cy="17" r="1.4"></circle></svg>
                    <span class="mapeo-dock-label">Tránsito</span>
                </button>
                @* Cuadraditos de las zonas. Las zonas CON chofer muestran el nombre del chofer;
                   las zonas SIN chofer todavía muestran "Zona N". Tocar = foco; ojito = mostrar/ocultar. *@
                @{
                    var zonasSlot = (stops ?? new())
                        .Where(s => s.AssignedVehicleSlot.HasValue && !s.AssignedDriverId.HasValue)
                        .Select(s => s.AssignedVehicleSlot!.Value).Distinct().OrderBy(x => x).ToList();
                }
                @if (zonasCreadas.Count > 0 || zonasSlot.Count > 0)
                {
                    <div class="mapeo-dock-sep"></div>
                    @* "TODO" = las paradas todavía SIN asignar. Arriba el título; abajo el ojito (mostrar/ocultar) y la cantidad. *@
                    <div class="mapeo-dock-btn" style="flex-direction:column; gap:6px; width:auto; min-width:104px; height:auto; padding:9px 10px; background:@(sinAsignarOcultos ? "#9ca3af" : "#eab308"); @(sinAsignarOcultos ? "opacity:0.55;" : "")">
                        <span style="font-size:0.82rem; font-weight:800; line-height:1; color:#fff;">TODO (sin asignar)</span>
                        <div style="display:flex; align-items:center; justify-content:center; gap:12px;">
                            <span @onclick="ToggleSinAsignarVisible" style="cursor:pointer; font-size:1.35rem; line-height:1;"
                                  title="@(sinAsignarOcultos ? "Mostrar las paradas sin asignar" : "Ocultar las paradas sin asignar (ver solo las zonas)")">
                                @(sinAsignarOcultos ? "🚫" : "👁")
                            </span>
                            <span style="font-size:1.05rem; font-weight:800; color:#fff; line-height:1; background:rgba(0,0,0,0.22); border-radius:8px; padding:3px 9px; min-width:24px; text-align:center;"
                                  title="Envíos todavía sin repartidor">
                                @(stops?.Count(s => !s.AssignedDriverId.HasValue && !s.AssignedVehicleSlot.HasValue) ?? 0)
                            </span>
                        </div>
                    </div>
                    @foreach (var z in zonasCreadas)
                    {
                        var zVisible = !zonasOcultasMapa.Contains(z.DriverId);
                        var zNombreCorto = string.IsNullOrWhiteSpace(z.DriverName) ? "?" : z.DriverName.Split(' ')[0];
                        <div style="position:relative;">
                            <div class="mapeo-dock-btn" style="flex-direction:column; gap:6px; width:auto; min-width:104px; height:auto; padding:9px 10px; background:@(zVisible ? z.Color : "#9ca3af"); @(zVisible ? "" : "opacity:0.55;")">
                                @* Arriba: "Z1 (Juan)" — tocar hace foco en la zona. *@
                                <span @onclick="() => FocoZona(z)" style="cursor:pointer; font-size:0.9rem; font-weight:800; line-height:1.1; color:#fff; text-align:center; white-space:nowrap; max-width:170px; overflow:hidden; text-overflow:ellipsis;"
                                      title="@($"Zona de {z.DriverName} · {z.StopIds.Count} envío(s) — tocá para hacer foco en esta zona")">
                                    🧑 @zNombreCorto
                                </span>
                                @* Abajo: 👁 mostrar/ocultar · 👤 cambiar repartidor de toda la zona · cantidad de envíos. *@
                                <div style="display:flex; align-items:center; justify-content:center; gap:12px;">
                                    <span @onclick="() => ToggleZonaVisible(z)" style="cursor:pointer; font-size:1.35rem; line-height:1;"
                                          title="@(zVisible ? "Ocultar esta zona del mapa" : "Mostrar esta zona en el mapa")">
                                        @(zVisible ? "👁" : "🚫")
                                    </span>
                                    <span @onclick="@(() => zonaDriverMenuId = (zonaDriverMenuId == z.Numero ? (int?)null : z.Numero))"
                                          style="cursor:pointer; font-size:1.35rem; line-height:1;"
                                          title="Cambiar el repartidor de toda esta zona">
                                        👤
                                    </span>
                                    <span style="font-size:1.05rem; font-weight:800; color:#fff; line-height:1; background:rgba(0,0,0,0.22); border-radius:8px; padding:3px 9px; min-width:24px; text-align:center;"
                                          title="@z.StopIds.Count envío(s) en esta zona">
                                        @z.StopIds.Count
                                    </span>
                                </div>
                            </div>
                            @if (zonaDriverMenuId == z.Numero)
                            {
                                <div class="mapeo-flyout" style="min-width:210px;">
                                    <div style="display:flex; align-items:center; justify-content:space-between; gap:0.5rem; padding:0.2rem 0.4rem 0.2rem 0.6rem;">
                                        <span style="font-size:0.7rem; color:#6b7280; font-weight:700;">Repartidor de la Zona @z.Numero</span>
                                        <button @onclick="() => zonaDriverMenuId = null" title="Cerrar" style="border:none; background:transparent; color:#6b7280; font-size:1.1rem; line-height:1; cursor:pointer; padding:0 0.2rem;">&times;</button>
                                    </div>
                                    @foreach (var d in (drivers ?? new()).Where(d => d.IsActive))
                                    {
                                        var dColor = string.IsNullOrEmpty(d.Color) ? "#1d4ed8" : d.Color!;
                                        <button class="btn" style="display:flex; width:100%; align-items:center; gap:0.4rem; font-size:0.85rem; padding:0.4rem 0.6rem; background:@(d.Id == z.DriverId ? "#eff6ff" : "transparent"); color:#1f2937; border:none; text-align:left;"
                                                @onclick="@(() => CambiarRepartidorZona(z, d.Id))" disabled="@assigningZone">
                                            <span style="width:12px; height:12px; border-radius:50%; background:@dColor; flex:0 0 12px;"></span>
                                            <span style="flex:1;">@d.Nombre</span>
                                            @if (d.Id == z.DriverId) { <span style="color:#16a34a;">✓</span> }
                                        </button>
                                    }
                                    @if ((drivers?.Count(d => d.IsActive) ?? 0) == 0)
                                    {
                                        <div style="font-size:0.78rem; color:#b45309; padding:0.3rem 0.6rem;">No hay repartidores. Agregalos en ⚙ → 👥 Repartidores.</div>
                                    }
                                </div>
                            }
                        </div>
                    }
                    @* Zonas SIN chofer todavía (creadas con "Crear la zona"): se muestran como "Zona N". *@
                    @foreach (var slot in zonasSlot)
                    {
                        var svVisible = !zonasSlotOcultas.Contains(slot);
                        var svColor = VehicleColor(slot);
                        var svCount = (stops ?? new()).Count(s => s.AssignedVehicleSlot == slot && !s.AssignedDriverId.HasValue);
                        <div style="position:relative;">
                            <div class="mapeo-dock-btn" style="flex-direction:column; gap:6px; width:auto; min-width:104px; height:auto; padding:9px 10px; background:@(svVisible ? svColor : "#9ca3af"); @(svVisible ? "" : "opacity:0.55;")">
                                <span @onclick="() => FocoVehiculo(slot)" style="cursor:pointer; font-size:0.9rem; font-weight:800; line-height:1.1; color:#fff; text-align:center; white-space:nowrap;"
                                      title="@($"Zona {slot} (sin chofer todavía) · {svCount} envío(s) — tocá para hacer foco")">
                                    Zona @slot
                                </span>
                                <div style="display:flex; align-items:center; justify-content:center; gap:12px;">
                                    <span @onclick="() => ToggleZonaSlotVisible(slot)" style="cursor:pointer; font-size:1.35rem; line-height:1;"
                                          title="@(svVisible ? "Ocultar esta zona del mapa" : "Mostrar esta zona en el mapa")">
                                        @(svVisible ? "👁" : "🚫")
                                    </span>
                                    <span @onclick="@(() => slotDriverMenu = (slotDriverMenu == slot ? (int?)null : slot))"
                                          style="cursor:pointer; font-size:1.35rem; line-height:1;" title="Asignar un chofer a esta zona">
                                        👤
                                    </span>
                                    <span style="font-size:1.05rem; font-weight:800; color:#fff; line-height:1; background:rgba(0,0,0,0.22); border-radius:8px; padding:3px 9px; min-width:24px; text-align:center;"
                                          title="@svCount envío(s) en esta zona">
                                        @svCount
                                    </span>
                                </div>
                            </div>
                            @if (slotDriverMenu == slot)
                            {
                                <div class="mapeo-flyout" style="min-width:210px;">
                                    <div style="display:flex; align-items:center; justify-content:space-between; gap:0.5rem; padding:0.2rem 0.4rem 0.2rem 0.6rem;">
                                        <span style="font-size:0.7rem; color:#6b7280; font-weight:700;">Chofer de la Zona @slot</span>
                                        <button @onclick="() => slotDriverMenu = null" title="Cerrar" style="border:none; background:transparent; color:#6b7280; font-size:1.1rem; line-height:1; cursor:pointer; padding:0 0.2rem;">&times;</button>
                                    </div>
                                    @foreach (var d in (drivers ?? new()).Where(d => d.IsActive))
                                    {
                                        var dColor = string.IsNullOrEmpty(d.Color) ? "#1d4ed8" : d.Color!;
                                        <button class="btn" style="display:flex; width:100%; align-items:center; gap:0.4rem; font-size:0.85rem; padding:0.4rem 0.6rem; background:transparent; color:#1f2937; border:none; text-align:left;"
                                                @onclick="@(() => AsignarChoferASlot(slot, d.Id))" disabled="@assigningZone">
                                            <span style="width:12px; height:12px; border-radius:50%; background:@dColor; flex:0 0 12px;"></span>
                                            <span style="flex:1;">@d.Nombre</span>
                                        </button>
                                    }
                                    @if ((drivers?.Count(d => d.IsActive) ?? 0) == 0)
                                    {
                                        <div style="font-size:0.78rem; color:#b45309; padding:0.3rem 0.6rem;">No hay repartidores. Agregalos en ⚙ → 👥 Repartidores.</div>
                                    }
                                </div>
                            }
                        </div>
                    }
                }
                @* Calendario: ver el mapa de días anteriores (historial de rutas). *@
                <div class="mapeo-dock-sep"></div>
                <button class="mapeo-dock-btn @(showHistorialModal || viewingSnapshot ? "activo" : "")" @onclick="OpenHistorialModal"
                        title="Ver el mapa de días anteriores (historial de rutas)">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="4" width="18" height="18" rx="2"></rect><line x1="16" y1="2" x2="16" y2="6"></line><line x1="8" y1="2" x2="8" y2="6"></line><line x1="3" y1="10" x2="21" y2="10"></line></svg>
                </button>
                @* Configuración: SIEMPRE al fondo del dock, separada del resto. El menú se abre hacia arriba. *@
                <div class="mapeo-dock-sep"></div>
                <div style="position:relative;">
                    <button class="mapeo-dock-btn @(showConfigMenu ? "activo" : "")" @onclick="() => showConfigMenu = !showConfigMenu" title="Configuración">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="3"></circle><path d="M19.4 15a1.65 1.65 0 0 0 .33 1.82l.06.06a2 2 0 1 1-2.83 2.83l-.06-.06a1.65 1.65 0 0 0-1.82-.33 1.65 1.65 0 0 0-1 1.51V21a2 2 0 0 1-4 0v-.09A1.65 1.65 0 0 0 9 19.4a1.65 1.65 0 0 0-1.82.33l-.06.06a2 2 0 1 1-2.83-2.83l.06-.06a1.65 1.65 0 0 0 .33-1.82 1.65 1.65 0 0 0-1.51-1H3a2 2 0 0 1 0-4h.09A1.65 1.65 0 0 0 4.6 9a1.65 1.65 0 0 0-.33-1.82l-.06-.06a2 2 0 1 1 2.83-2.83l.06.06a1.65 1.65 0 0 0 1.82.33H9a1.65 1.65 0 0 0 1-1.51V3a2 2 0 0 1 4 0v.09a1.65 1.65 0 0 0 1 1.51 1.65 1.65 0 0 0 1.82-.33l.06-.06a2 2 0 1 1 2.83 2.83l-.06.06a1.65 1.65 0 0 0-.33 1.82V9a1.65 1.65 0 0 0 1.51 1H21a2 2 0 0 1 0 4h-.09a1.65 1.65 0 0 0-1.51 1z"></path></svg>
                    </button>
                    @if (showConfigMenu)
                    {
                        <div class="mapeo-flyout" style="top:auto; bottom:0; min-width:240px;">
                            <button class="btn" style="display:flex; width:100%; justify-content:space-between; align-items:center; font-size:0.82rem; padding:0.4rem 0.6rem; background:transparent; color:#1f2937; border:none; text-align:left;"
                                    @onclick="@(async () => { showConfigMenu = false; await OpenStartPointModal(); })">
                                <span>📍 Punto de partida</span>
                                @if (startPoint?.Lat.HasValue == true) { <span style="color:#16a34a;">✓</span> }
                            </button>
                            <button class="btn" style="display:flex; width:100%; justify-content:space-between; align-items:center; font-size:0.82rem; padding:0.4rem 0.6rem; background:transparent; color:#1f2937; border:none; text-align:left;"
                                    @onclick="@(() => { showConfigMenu = false; OpenPublicUrlModal(); })">
                                <span>🌐 URL pública</span>
                                @if (!string.IsNullOrEmpty(publicBaseUrl)) { <span style="color:#16a34a;">✓</span> }
                            </button>
                            <button class="btn" style="display:flex; width:100%; justify-content:space-between; align-items:center; font-size:0.82rem; padding:0.4rem 0.6rem; background:transparent; color:#1f2937; border:none; text-align:left;"
                                    @onclick="@(async () => { showConfigMenu = false; await OpenDriversModal(); })">
                                <span>👥 Repartidores</span>
                                <span style="color:#6b7280; font-size:0.72rem;">@(drivers?.Count ?? 0)</span>
                            </button>
                            <button class="btn" style="display:flex; width:100%; justify-content:space-between; align-items:center; font-size:0.82rem; padding:0.4rem 0.6rem; background:transparent; color:#1f2937; border:none; text-align:left;"
                                    @onclick="@(async () => { showConfigMenu = false; await OpenFavoritosModal(); })">
                                <span>⭐ Favoritos</span>
                                <span style="color:#6b7280; font-size:0.72rem;">@(favoritos?.Count ?? 0)</span>
                            </button>
                            <hr style="margin:0.3rem 0; border:none; border-top:1px solid #f3f4f6;" />
                            <button class="btn" style="display:flex; width:100%; justify-content:space-between; align-items:center; font-size:0.82rem; padding:0.4rem 0.6rem; background:transparent; color:#1f2937; border:none; text-align:left;"
                                    @onclick="@(async () => { showConfigMenu = false; await OpenHistorialModal(); })">
                                <span>📚 Historial de rutas</span>
                            </button>
                            <button class="btn" style="display:flex; width:100%; justify-content:space-between; align-items:center; font-size:0.82rem; padding:0.4rem 0.6rem; background:transparent; color:#1f2937; border:none; text-align:left;"
                                    @onclick="@(async () => { showConfigMenu = false; await GuardarSnapshotAhora(); })" disabled="@savingSnapshot">
                                <span>@(savingSnapshot ? "Guardando..." : "💾 Guardar ruta en el historial")</span>
                            </button>
                            <button class="btn" style="display:flex; width:100%; justify-content:space-between; align-items:center; font-size:0.82rem; padding:0.4rem 0.6rem; background:transparent; color:#1f2937; border:none; text-align:left;"
                                    @onclick="@(async () => { showConfigMenu = false; await OpenExportModal(); })">
                                <span>📤 Descargar / Compartir ruta</span>
                            </button>
                            <hr style="margin:0.3rem 0; border:none; border-top:1px solid #f3f4f6;" />
                            @* Ocultar entregados: antes era un tilde en la barra de arriba; ahora vive acá. *@
                            <button class="btn" style="display:flex; width:100%; justify-content:space-between; align-items:center; font-size:0.82rem; padding:0.4rem 0.6rem; background:transparent; color:#1f2937; border:none; text-align:left;"
                                    @onclick="@(async () => { excluirEntregados = !excluirEntregados; await LoadAndRender(); })">
                                <span>✔ Ocultar entregados</span>
                                <span style="font-weight:700; color:@(excluirEntregados ? "#16a34a" : "#9ca3af");">@(excluirEntregados ? "SÍ" : "NO")</span>
                            </button>
                            @* Empezar desde cero: borra todas las paradas para arrancar el día limpio. *@
                            <button class="btn" style="display:flex; width:100%; justify-content:space-between; align-items:center; font-size:0.82rem; padding:0.4rem 0.6rem; background:transparent; color:#b91c1c; border:none; text-align:left;"
                                    @onclick="@(async () => { showConfigMenu = false; await EmpezarDesdeCero(); })" disabled="@reseteandoTodo">
                                <span>@(reseteandoTodo ? "Borrando..." : "🆕 Empezar desde cero")</span>
                            </button>
                            <hr style="margin:0.3rem 0; border:none; border-top:1px solid #f3f4f6;" />
                            @* Notas del día: el post-it de antes, ahora dentro de Configuración. *@
                            <div style="padding:0.3rem 0.6rem;">
                                <div style="font-size:0.7rem; font-weight:700; color:#854d0e; margin-bottom:0.2rem;">📝 Notas del día</div>
                                <textarea @bind="notasMapeo" @bind:event="oninput" @onblur="GuardarNotas"
                                          placeholder="Anotá algo para acordarte (proveedor que llamar, parada especial, etc)…"
                                          style="width:100%; min-height:52px; resize:vertical; border:1px solid #facc15; background:#fef9c3; border-radius:6px; font-size:0.8rem; color:#422006; font-family:inherit; padding:0.3rem 0.4rem; outline:none;"></textarea>
                            </div>
                        </div>
                    }
                </div>
            </div>
        }
        @* Resumen de rutas: tiempo estimado + km por repartidor (aparece al optimizar). *@
        @if (rutasResumen.Count > 0)
        {
            <div style="position:absolute; top:52px; right:10px; z-index:470; background:white; border:1px solid #e5e7eb; border-radius:10px; box-shadow:0 3px 14px rgba(0,0,0,0.2); padding:0.5rem 0.6rem; max-width:250px;">
                <div style="display:flex; justify-content:space-between; align-items:center; margin-bottom:0.35rem;">
                    <strong style="font-size:0.82rem;">🛣️ Rutas (tránsito)</strong>
                    <button class="btn-close" style="font-size:0.9rem;" @onclick="CerrarResumenRutas" title="Ocultar">&times;</button>
                </div>
                @foreach (var r in rutasResumen)
                {
                    var abierta = rutasExpandidas.Contains(r.Key);
                    var hayTramos = r.Legs != null && r.Legs.Count > 0;
                    <div style="padding:0.2rem 0; border-top:1px solid #f3f4f6;">
                        <div style="display:flex; align-items:center; gap:0.4rem; font-size:0.8rem; cursor:@(hayTramos ? "pointer" : "default");"
                             @onclick="@(() => ToggleTramos(r.Key))"
                             title="@(hayTramos ? "Ver el tiempo entre cada parada" : "")">
                            <span style="width:12px; height:12px; border-radius:50%; background:@r.Color; flex:0 0 12px;"></span>
                            <span style="flex:1; overflow:hidden; text-overflow:ellipsis; white-space:nowrap;">@r.Label</span>
                            <strong>@FormatoDuracion(r.DurationSeconds)</strong>
                            @if (hayTramos)
                            {
                                <span style="color:#9ca3af; font-size:0.7rem;">@(abierta ? "▲" : "▼")</span>
                            }
                        </div>
                        <div style="font-size:0.68rem; color:#9ca3af; margin-left:1.1rem;">
                            @r.StopCount parada@(r.StopCount == 1 ? "" : "s") · @((r.DistanceMeters / 1000.0).ToString("0.0")) km
                        </div>
                        @if (abierta && hayTramos)
                        {
                            var conSalida = r.Legs.Count == r.StopCount && r.StopCount > 0; // hay punto de partida
                            <div style="margin:0.25rem 0 0.15rem 1.1rem; padding-left:0.5rem; border-left:2px solid @r.Color;">
                                @for (int i = 0; i < r.Legs.Count; i++)
                                {
                                    var desde = conSalida ? (i == 0 ? "Salida" : i.ToString()) : (i + 1).ToString();
                                    var hasta = conSalida ? (i + 1).ToString() : (i + 2).ToString();
                                    <div style="display:flex; gap:0.4rem; font-size:0.7rem; color:#4b5563; padding:0.08rem 0;">
                                        <span style="flex:1; white-space:nowrap;">@desde <span style="color:#9ca3af;">→</span> @hasta</span>
                                        <strong style="color:#374151;">@FormatoDuracion(r.Legs[i].Seconds)</strong>
                                        <span style="color:#9ca3af; width:46px; text-align:right;">@((r.Legs[i].Meters / 1000.0).ToString("0.0")) km</span>
                                    </div>
                                }
                            </div>
                        }
                    </div>
                }
            </div>
        }
        @* Acciones de ruta: repartir la flota entre choferes (si hay 2+) y/o armar una ruta única. Por tránsito. *@
        @if ((stops?.Count ?? 0) > 0)
        {
            <div style="position:absolute; bottom:18px; left:50%; transform:translateX(-50%); z-index:450; display:flex; gap:0.5rem; align-items:center; flex-wrap:wrap; justify-content:center;">
                @if (stops?.Any(s => s.AssignedDriverId.HasValue) ?? false)
                {
                    <button class="btn" style="font-size:0.92rem; font-weight:800; background:#111827; color:#fff; border:none; padding:0.6rem 1.3rem; border-radius:999px; box-shadow:0 3px 14px rgba(0,0,0,0.35); cursor:pointer;"
                            @onclick="() => showOptiPanel = true"
                            title="Abrir el panel con todas las herramientas para optimizar los recorridos">
                        ⚡ Optimizar recorridos
                    </button>
                    <button class="btn" style="font-size:0.92rem; font-weight:800; background:#7c3aed; color:#fff; border:none; padding:0.6rem 1.3rem; border-radius:999px; box-shadow:0 3px 14px rgba(0,0,0,0.35); cursor:pointer;"
                            @onclick="OptimizarRutas" disabled="@routeBusy"
                            title="Le arma a cada repartidor (los que asignaste) su mejor recorrido según el tránsito actual">
                        ⚡ @(routeBusy ? "Optimizando…" : "Optimizar rutas")
                    </button>
                    <button class="btn" style="font-size:0.9rem; font-weight:800; background:#0f766e; color:#fff; border:none; padding:0.6rem 1.2rem; border-radius:999px; box-shadow:0 3px 14px rgba(0,0,0,0.35); cursor:pointer;"
                            @onclick="() => showRutasReparto = true"
                            title="Abrir la pantalla de cada repartidor (la misma que ven ellos en su celular) para chequear su ruta">
                        👁 Ver como repartidores
                    </button>
                }
                <button class="btn" style="font-size:0.9rem; font-weight:800; background:#1d4ed8; color:#fff; border:none; padding:0.6rem 1.2rem; border-radius:999px; box-shadow:0 3px 14px rgba(0,0,0,0.35); cursor:pointer;"
                        @onclick="ArmarRutaOptima" disabled="@routeBusy"
                        title="Ordena TODAS las paradas en una sola ruta óptima (según el tránsito)">
                    🚦 @(routeBusy ? "…" : "Ruta única")
                </button>
                @* Ver/ocultar las líneas ya calculadas (aparece cuando hay recorridos). Tocando una línea se ve su distancia. *@
                @if (rutasResumen.Count > 0)
                {
                    <button class="btn" style="font-size:0.9rem; font-weight:800; background:@(lineasOn ? "#475569" : "#0d9488"); color:#fff; border:none; padding:0.6rem 1.2rem; border-radius:999px; box-shadow:0 3px 14px rgba(0,0,0,0.35); cursor:pointer;"
                            @onclick="ToggleLineas"
                            title="Mostrar u ocultar las líneas de los recorridos. Tocá una línea para ver la distancia del tramo y el total de la ruta.">
                        @(lineasOn ? "🙈 Ocultar líneas" : "👁 Ver líneas")
                    </button>
                }
            </div>
        }
        @* ── Panel "⚡ Optimizar recorridos": aparece al tocar el botón, con una tarjeta por herramienta ── *@
        @if (showOptiPanel)
        {
            <div style="position:fixed; inset:0; background:rgba(0,0,0,0.45); z-index:9000; display:flex; align-items:center; justify-content:center; padding:1rem;"
                 @onclick="() => showOptiPanel = false">
                <div style="background:#fff; border-radius:16px; max-width:580px; width:100%; max-height:88vh; overflow:auto; box-shadow:0 12px 48px rgba(0,0,0,0.4);"
                     @onclick:stopPropagation="true">
                    <div style="display:flex; align-items:center; justify-content:space-between; padding:0.9rem 1.2rem; border-bottom:1px solid #eee; position:sticky; top:0; background:#fff; z-index:1;">
                        <strong style="font-size:1.05rem;">⚡ Optimizar recorridos</strong>
                        <button class="btn-close" style="font-size:1.2rem;" @onclick="() => showOptiPanel = false" title="Cerrar">&times;</button>
                    </div>
                    <div style="padding:1rem 1.2rem; display:flex; flex-direction:column; gap:0.75rem;">
                        <p style="font-size:0.82rem; color:#6b7280; margin:0;">
                            Ya tenés las zonas armadas. Elegí una herramienta y probala. Las que necesitan habilitar algo en Google
                            <strong>no se activan solas</strong>: te aviso el costo y me pedís el OK.
                        </p>

                        @* Tarjeta 1: ordenar paradas (lista) *@
                        <div style="border:1px solid #e5e7eb; border-left:4px solid #16a34a; border-radius:10px; padding:0.7rem 0.85rem;">
                            <div style="display:flex; justify-content:space-between; align-items:center; gap:0.5rem;">
                                <strong style="font-size:0.9rem;">🟢 Ordenar las paradas de cada repartidor</strong>
                                <span style="font-size:0.65rem; font-weight:800; color:#16a34a; background:#dcfce7; padding:0.12rem 0.5rem; border-radius:999px; white-space:nowrap;">LISTA</span>
                            </div>
                            <p style="font-size:0.78rem; color:#4b5563; margin:0.35rem 0 0.55rem;">
                                Google reordena las entregas de cada zona para el camino más corto por calles (según el tránsito de ahora). No cambia quién lleva qué.
                            </p>
                            <button class="btn" style="font-size:0.82rem; font-weight:700; background:#16a34a; color:#fff; border:none; padding:0.4rem 0.9rem; border-radius:8px; cursor:pointer;"
                                    @onclick="PanelOrdenarParadas" disabled="@routeBusy">
                                @(routeBusy ? "Aplicando…" : "Aplicar")
                            </button>
                        </div>

                        @* Tarjeta 2: ver cuánto ahorra (lista) *@
                        <div style="border:1px solid #e5e7eb; border-left:4px solid #16a34a; border-radius:10px; padding:0.7rem 0.85rem;">
                            <div style="display:flex; justify-content:space-between; align-items:center; gap:0.5rem;">
                                <strong style="font-size:0.9rem;">🟢 Ver cuánto ahorrarías</strong>
                                <span style="font-size:0.65rem; font-weight:800; color:#16a34a; background:#dcfce7; padding:0.12rem 0.5rem; border-radius:999px; white-space:nowrap;">LISTA</span>
                            </div>
                            <p style="font-size:0.78rem; color:#4b5563; margin:0.35rem 0 0.55rem;">
                                Compara el orden actual con el óptimo y te dice cuánto tiempo y km te ahorra cada repartidor, <strong>sin cambiar nada</strong>.
                            </p>
                            <button class="btn" style="font-size:0.82rem; font-weight:700; background:#0ea5e9; color:#fff; border:none; padding:0.4rem 0.9rem; border-radius:8px; cursor:pointer;"
                                    @onclick="CalcularAhorro" disabled="@calculandoAhorro">
                                @(calculandoAhorro ? "Calculando…" : "Calcular ahorro")
                            </button>
                            @if (ahorros.Count > 0)
                            {
                                var totAct = ahorros.Where(a => a.Calculable).Sum(a => a.ActualSeconds);
                                var totOpt = ahorros.Where(a => a.Calculable).Sum(a => a.OptimoSeconds);
                                var totSave = totAct - totOpt;
                                <div style="margin-top:0.6rem; border-top:1px dashed #e5e7eb; padding-top:0.5rem; display:flex; flex-direction:column; gap:0.3rem;">
                                    @foreach (var a in ahorros)
                                    {
                                        var save = a.ActualSeconds - a.OptimoSeconds;
                                        <div style="display:flex; align-items:center; gap:0.4rem; font-size:0.76rem;">
                                            <span style="width:10px; height:10px; border-radius:50%; background:@a.Color; flex:0 0 10px;"></span>
                                            <span style="flex:1; overflow:hidden; text-overflow:ellipsis; white-space:nowrap;">@a.Label</span>
                                            @if (!a.Calculable)
                                            {
                                                <span style="color:#9ca3af;">— (más de 25 paradas)</span>
                                            }
                                            else if (save > 30)
                                            {
                                                <span style="color:#6b7280;">@FormatoDuracion(a.ActualSeconds) → @FormatoDuracion(a.OptimoSeconds)</span>
                                                <strong style="color:#16a34a; white-space:nowrap;">−@FormatoDuracion(save)</strong>
                                            }
                                            else
                                            {
                                                <span style="color:#16a34a; font-weight:700;">ya está óptima ✓</span>
                                            }
                                        </div>
                                    }
                                    @if (totSave > 30)
                                    {
                                        <div style="font-size:0.8rem; font-weight:800; color:#065f46; margin-top:0.2rem;">
                                            Ahorro total estimado: −@FormatoDuracion(totSave)
                                        </div>
                                    }
                                </div>
                            }
                            else if (!calculandoAhorro && ahorroCalculado)
                            {
                                <div style="margin-top:0.5rem; font-size:0.76rem; color:#9ca3af;">
                                    No hay rutas para comparar. Primero asigná repartidores y ordená las paradas.
                                </div>
                            }
                        </div>

                        @* Tarjeta 3: repartir la carga (gratis) *@
                        <div style="border:1px solid #e5e7eb; border-left:4px solid #16a34a; border-radius:10px; padding:0.7rem 0.85rem;">
                            <div style="display:flex; justify-content:space-between; align-items:center; gap:0.5rem;">
                                <strong style="font-size:0.9rem;">🟢 Repartir la carga entre repartidores</strong>
                                <span style="font-size:0.65rem; font-weight:800; color:#16a34a; background:#dcfce7; padding:0.12rem 0.5rem; border-radius:999px; white-space:nowrap;">LISTA · GRATIS</span>
                            </div>
                            <p style="font-size:0.78rem; color:#4b5563; margin:0.35rem 0 0.55rem;">
                                Reparte solo las entregas entre los repartidores por cercanía y le arma la mejor ruta a cada uno. Versión gratis (sin costo extra de Google).
                            </p>
                            <button class="btn" style="font-size:0.82rem; font-weight:700; background:#0f766e; color:#fff; border:none; padding:0.4rem 0.9rem; border-radius:8px; cursor:pointer;"
                                    @onclick="PanelRepartir" disabled="@routeBusy">
                                @(routeBusy ? "Repartiendo…" : "Repartir y optimizar")
                            </button>
                        </div>

                        @* Tarjeta 4: motor grande de Google (hay que habilitar) *@
                        <div style="border:1px solid #e5e7eb; border-left:4px solid #f59e0b; border-radius:10px; padding:0.7rem 0.85rem; background:#fffbeb;">
                            <div style="display:flex; justify-content:space-between; align-items:center; gap:0.5rem;">
                                <strong style="font-size:0.9rem;">🟡 Motor "grande" de Google</strong>
                                <span style="font-size:0.65rem; font-weight:800; color:#b45309; background:#fef3c7; padding:0.12rem 0.5rem; border-radius:999px; white-space:nowrap;">HAY QUE ACTIVAR</span>
                            </div>
                            <p style="font-size:0.78rem; color:#4b5563; margin:0.35rem 0 0.55rem;">
                                El sistema decide solo <strong>quién lleva cada cosa</strong> respetando horarios de entrega ("recibe de 9 a 12"), capacidad del vehículo y turnos de cada repartidor (Route Optimization API). Es la que usan las empresas grandes. Hay que habilitarla en Google y tiene costo aparte.
                            </p>
                            <button class="btn" style="font-size:0.82rem; font-weight:700; background:#f59e0b; color:#fff; border:none; padding:0.4rem 0.9rem; border-radius:8px; cursor:pointer;"
                                    @onclick="InfoMotorGrande">
                                Quiero activarla
                            </button>
                        </div>

                        @* Tarjeta 5: respetar horarios (próximamente) *@
                        <div style="border:1px solid #e5e7eb; border-left:4px solid #d1d5db; border-radius:10px; padding:0.7rem 0.85rem; opacity:0.85;">
                            <div style="display:flex; justify-content:space-between; align-items:center; gap:0.5rem;">
                                <strong style="font-size:0.9rem;">⚪ Respetar franjas horarias de entrega</strong>
                                <span style="font-size:0.65rem; font-weight:800; color:#6b7280; background:#f3f4f6; padding:0.12rem 0.5rem; border-radius:999px; white-space:nowrap;">PRÓXIMAMENTE</span>
                            </div>
                            <p style="font-size:0.78rem; color:#4b5563; margin:0.35rem 0 0;">
                                Que la ruta ordene las entregas según la franja horaria que pidió cada cliente. Va junto con el motor grande.
                            </p>
                        </div>
                    </div>
                </div>
            </div>
        }
        @{
            var vehiclesActivos = stops?.Where(s => s.AssignedVehicleSlot.HasValue)
                .GroupBy(s => s.AssignedVehicleSlot!.Value)
                .OrderBy(g => g.Key)
                .Select(g => new { Slot = g.Key, Count = g.Count() })
                .ToList();
        }
        @if (vehiclesActivos is not null && vehiclesActivos.Count > 0)
        {
            <div style="flex:0 0 auto; margin:0.5rem 0.5rem 0; z-index:500; display:flex; gap:0.3rem; flex-wrap:wrap; padding:0.4rem 0.5rem; background:rgba(255,255,255,0.96); border:1px solid #e5e7eb; border-radius:8px; box-shadow:0 1px 4px rgba(0,0,0,0.08);">
                <span style="font-size:0.75rem; color:#6b7280; font-weight:600; align-self:center;">Mostrar en mapa:</span>
                <button class="btn" style="font-size:0.78rem; padding:0.2rem 0.55rem; font-weight:700; border-radius:999px; border:1.5px solid @(vehiculoFiltro == null ? "#1f2937" : "#d1d5db"); background:@(vehiculoFiltro == null ? "#1f2937" : "white"); color:@(vehiculoFiltro == null ? "white" : "#374151");"
                        @onclick="@(() => SetVehiculoFiltro(null))">
                    Todos (@stops!.Count(s => s.Latitude != 0))
                </button>
                @foreach (var v in vehiclesActivos)
                {
                    var slot = v.Slot;
                    var color = VehicleColor(slot);
                    var sel = vehiculoFiltro == slot;
                    <button class="btn" style="font-size:0.78rem; padding:0.2rem 0.55rem; font-weight:700; border-radius:999px; border:2px solid @color; background:@(sel ? color : "white"); color:@(sel ? "white" : color);"
                            @onclick="@(() => SetVehiculoFiltro(slot))">
                        Zona @(slot) (@v.Count)
                    </button>
                }
                @{
                    var sinAsignar = stops!.Count(s => !s.AssignedVehicleSlot.HasValue);
                }
                @if (sinAsignar > 0)
                {
                    var selSin = vehiculoFiltro == 0; // 0 = "sin asignar"
                    <button class="btn" style="font-size:0.78rem; padding:0.2rem 0.55rem; font-weight:700; border-radius:999px; border:2px dashed #9ca3af; background:@(selSin ? "#9ca3af" : "white"); color:@(selSin ? "white" : "#6b7280");"
                            @onclick="@(() => SetVehiculoFiltro(0))">
                        ❓ Sin asignar (@sinAsignar)
                    </button>
                }
                @* Botón para abrir el mapa en una ventana aparte (ideal para doble pantalla) *@
                <button class="btn" style="margin-left:auto; font-size:0.78rem; padding:0.2rem 0.55rem; font-weight:700; border-radius:6px; border:1.5px solid #1d4ed8; background:#dbeafe; color:#1d4ed8;"
                        @onclick="AbrirMapaFlotante" title="Abrir el mapa en una ventana separada (podés moverla a otro monitor)">
                    🪟 Abrir en otra ventana
                </button>
            </div>
        }
        @* 2026-07-25: buscador de direcciones estilo Google (Places). Escribís, elegís, y se planta la parada.
           2026-07-27: si estás "corrigiendo domicilio", lo que elijas se le asigna a esa parada. *@
        <div style="flex:0 0 auto; padding:0.5rem 0.5rem 0.4rem;">
            @if (editandoPinStopId is not null)
            {
                <div style="margin-bottom:0.35rem; padding:0.5rem 0.6rem; background:#fffbeb; border:1px solid #f59e0b; border-radius:8px;">
                    <div style="font-size:0.82rem; color:#92400e; font-weight:700; margin-bottom:0.25rem;">
                        📍 Corrigiendo la ubicación de <strong>@editandoPinNombre</strong>
                    </div>
                    <div style="font-size:0.72rem; color:#92400e; margin-bottom:0.45rem;">
                        Buscá la dirección abajo (el pin salta ahí) y/o <strong>arrastrá el pin</strong> en el mapa hasta el punto exacto. Después elegí cómo guardarlo.
                        @if (!EditPinTieneUbicacion) { <span style="color:#b91c1c;"> — todavía no elegiste ubicación.</span> }
                    </div>
                    @* Texto del domicilio, editable: es lo que se ve en el comprobante. *@
                    <div style="margin-bottom:0.45rem;">
                        <label style="font-size:0.68rem; color:#92400e; font-weight:700; display:block; margin-bottom:0.15rem;">📝 Domicilio (así sale en el comprobante)</label>
                        <input type="text" class="form-input" @bind="editPinDireccion" @bind:event="oninput"
                               placeholder="Ej: Monteagudo 150 3ro D — Parque Patricios"
                               style="width:100%; font-size:0.8rem; padding:0.35rem 0.5rem; border:1px solid #f59e0b; border-radius:6px;" />
                    </div>
                    <div style="display:flex; gap:0.4rem; flex-wrap:wrap; align-items:center;">
                        @if (EditPinEsVenta)
                        {
                            <button class="btn" style="font-size:0.74rem; padding:0.3rem 0.6rem; background:#16a34a; color:#fff; border:none; border-radius:6px;" @onclick="() => GuardarEdicionPin(true)" disabled="@(!EditPinTieneUbicacion)" title="Guarda la ubicación en la ficha del cliente (el domicilio que se usó en esta venta) para las próximas.">💾 Guardar en el cliente (definitivo)</button>
                            <button class="btn" style="font-size:0.74rem; padding:0.3rem 0.6rem; background:#2563eb; color:#fff; border:none; border-radius:6px;" @onclick="() => GuardarEdicionPin(false)" disabled="@(!EditPinTieneUbicacion)" title="Corrige solo esta entrega, sin tocar la ficha del cliente.">📍 Solo esta vez</button>
                        }
                        else
                        {
                            <button class="btn" style="font-size:0.74rem; padding:0.3rem 0.6rem; background:#16a34a; color:#fff; border:none; border-radius:6px;" @onclick="() => GuardarEdicionPin(false)" disabled="@(!EditPinTieneUbicacion)">💾 Guardar ubicación</button>
                        }
                        <button class="btn" style="font-size:0.74rem; padding:0.3rem 0.6rem; background:transparent; border:1px solid #92400e; color:#92400e; border-radius:6px;" @onclick="CancelarEdicionPin">✕ Cancelar</button>
                    </div>
                </div>
            }
            else if (corrigiendoDomicilioStopId is not null)
            {
                <div style="display:flex; align-items:center; gap:0.5rem; margin-bottom:0.35rem; padding:0.35rem 0.5rem; background:#fef3c7; border:1px solid #fcd34d; border-radius:8px; font-size:0.8rem; color:#92400e;">
                    <span>📍 Buscá el domicilio para <strong>@corrigiendoDomicilioNombre</strong> y elegilo de la lista.</span>
                    <button class="btn" style="margin-left:auto; font-size:0.72rem; padding:0.15rem 0.5rem; background:transparent; border:1px solid #92400e; color:#92400e; border-radius:6px;" @onclick="CancelarCorregirDomicilio">✕ Cancelar</button>
                </div>
            }
            <div style="display:flex; gap:0.5rem; align-items:stretch;">
                <input id="mapeoSearchInput" type="text" class="form-input" autocomplete="off"
                       placeholder="@(editandoPinStopId is not null ? "🔍 Buscá la dirección correcta y elegila (mueve el pin)…" : (corrigiendoDomicilioStopId is not null ? "🔍 Escribí el domicilio correcto y elegilo…" : "🔍 Buscar una dirección y sumarla al mapa…"))"
                       style="flex:1; font-size:1.05rem; padding:0.7rem 0.95rem; border:1.5px solid @((editandoPinStopId is not null || corrigiendoDomicilioStopId is not null) ? "#f59e0b" : (verDireccionAlTocar ? "#2563eb" : "#d1d5db")); border-radius:8px;" />
                @* Botón "Ver dirección al tocar": prende/apaga el modo geolocalización inversa (tocá el mapa → te dice la calle y número). *@
                <button type="button" @onclick="ToggleVerDireccion"
                        style="white-space:nowrap; font-size:0.88rem; font-weight:600; padding:0 0.95rem; border-radius:8px; cursor:pointer; border:1.5px solid @(verDireccionAlTocar ? "#2563eb" : "#d1d5db"); background:@(verDireccionAlTocar ? "#2563eb" : "#ffffff"); color:@(verDireccionAlTocar ? "#ffffff" : "#374151");"
                        title="Prendé esto y tocá cualquier punto del mapa: te digo la calle y número de ese lugar. Tocá de nuevo para apagar.">
                    📍 @(verDireccionAlTocar ? "Tocá el mapa…" : "Ver dirección al tocar")
                </button>
                @if (mapaFullscreen)
                {
                    <button type="button" @onclick="VolverAlSistema" title="Volver al sistema (cierra esta pantalla del mapa)"
                            style="white-space:nowrap; font-size:0.88rem; font-weight:700; padding:0 0.95rem; border-radius:8px; cursor:pointer; border:none; background:#111827; color:#ffffff;">
                        ← Volver
                    </button>
                }
            </div>
        </div>
        @* Mini-leyenda: qué forma de globito es cada tipo de envío. La forma indica el TIPO;
           el color sigue indicando el repartidor/asignación. Solo aparece si hay algo en el mapa. *@
        @if ((stops?.Count ?? 0) > 0 || (shipments?.Count ?? 0) > 0)
        {
            <div style="position:absolute; left:8px; bottom:14px; z-index:460; background:rgba(255,255,255,0.95); border:1px solid #e5e7eb; border-radius:10px; box-shadow:0 2px 8px rgba(0,0,0,0.18); padding:0.4rem 0.55rem; font-size:0.72rem; color:#374151;">
                <div style="font-weight:800; color:#6b7280; margin-bottom:0.25rem; font-size:0.62rem; letter-spacing:0.03em;">TIPOS DE ENVÍO</div>
                <div style="display:flex; flex-direction:column; gap:0.22rem;">
                    <span style="display:flex; align-items:center; gap:0.4rem;"><svg width="14" height="14" viewBox="0 0 14 14"><circle cx="7" cy="7" r="6" fill="#6b7280"/></svg> Flex</span>
                    <span style="display:flex; align-items:center; gap:0.4rem;"><svg width="14" height="14" viewBox="0 0 14 14"><rect x="1" y="1" width="12" height="12" rx="3" fill="#6b7280"/></svg> ME1</span>
                    <span style="display:flex; align-items:center; gap:0.4rem;"><svg width="14" height="14" viewBox="0 0 14 14"><path d="M7 0.5 L13.5 7 L7 13.5 L0.5 7 Z" fill="#6b7280"/></svg> Alquiler</span>
                    <span style="display:flex; align-items:center; gap:0.4rem;"><svg width="14" height="14" viewBox="0 0 14 14"><path d="M1 2 L13 2 L7 13 Z" fill="#6b7280"/></svg> Venta por fuera</span>
                </div>
            </div>
        }
        <div id="leafletMap"></div>
    </div>
</div>

@if (showHistorialModal)
{
    <div class="modal-overlay" @onclick="() => showHistorialModal = false">
        <div class="modal-card" @onclick:stopPropagation="true" style="max-width:720px; max-height:85vh; display:flex; flex-direction:column;">
            <div class="modal-header" style="background:#dbeafe;">
                <h3 style="margin:0;">📅 Días anteriores</h3>
                <button class="btn-close" @onclick="() => showHistorialModal = false">&times;</button>
            </div>
            <div class="modal-body" style="overflow-y:auto;">
                @if (snapshots is null) { <p class="text-muted" style="text-align:center;">Cargando...</p> }
                else if (snapshots.Count == 0)
                {
                    <div style="text-align:center; padding:2rem; color:#6b7280;">
                        <div style="font-size:3rem;">📭</div>
                        <strong>No hay rutas guardadas todavía</strong>
                        <p style="font-size:0.85rem; margin-top:0.4rem;">Cuando armes una ruta y aprietes "Empezar desde cero", el sistema guarda la ruta del día en el historial. También podés guardarla a mano desde ⚙ Configuración → 💾 Guardar ruta en el historial.</p>
                    </div>
                }
                else
                {
                    <p style="font-size:0.8rem; color:#4b5563; margin:0 0 0.8rem; background:#f0fdf4; border:1px solid #bbf7d0; border-radius:6px; padding:0.5rem 0.7rem;">
                        💡 Cada día puede tener varias fotos (incluidas pruebas). El sistema marca sola con <strong style="color:#15803d;">✅ Definitiva</strong> la que tuvo más entregas — esa es la ruta real de ese día. Tocá <strong>🗺 Ver en el mapa</strong> para verla dibujada.
                    </p>
                    var hoy = DateTime.UtcNow.AddHours(-3).Date;
                    @foreach (var dia in snapshots.GroupBy(s => s.CreatedAt.ToArTime().Date).OrderByDescending(g => g.Key))
                    {
                        // La "definitiva" del día: la que tuvo más entregas (si hubo alguna). Empate → la más tardía.
                        var definitiva = dia.Where(x => x.DeliveredCount > 0)
                                            .OrderByDescending(x => x.DeliveredCount).ThenByDescending(x => x.CreatedAt)
                                            .FirstOrDefault();
                        var etiquetaDia = dia.Key == hoy ? "Hoy" : (dia.Key == hoy.AddDays(-1) ? "Ayer" : dia.Key.ToString("dd/MM/yyyy"));
                        <div style="margin-bottom:1rem;">
                            <div style="font-weight:800; color:#1f2937; font-size:0.95rem; border-bottom:2px solid #e5e7eb; padding-bottom:0.25rem; margin-bottom:0.5rem;">
                                @etiquetaDia <span style="font-weight:500; color:#9ca3af; font-size:0.78rem;">· @dia.Count() foto@(dia.Count() == 1 ? "" : "s")</span>
                            </div>
                            @foreach (var s in dia.OrderByDescending(x => x.CreatedAt))
                            {
                                var esDefi = definitiva is not null && s.Id == definitiva.Id;
                                <div style="display:flex; align-items:center; gap:0.6rem; padding:0.5rem 0.7rem; border-radius:8px; margin-bottom:0.35rem;
                                            background:@(esDefi ? "#f0fdf4" : "#f9fafb"); border:1px solid @(esDefi ? "#86efac" : "#f3f4f6");">
                                    <div style="flex:1; min-width:0;">
                                        <div style="font-weight:700; color:#111827; font-size:0.88rem;">
                                            🕒 @s.CreatedAt.ToArTime().ToString("HH:mm") hs
                                            @if (esDefi)
                                            { <span style="background:#15803d; color:#fff; font-size:0.66rem; font-weight:800; padding:0.1rem 0.45rem; border-radius:999px; margin-left:0.3rem;">✅ DEFINITIVA</span> }
                                            else if (s.DeliveredCount == 0)
                                            { <span style="background:#e5e7eb; color:#6b7280; font-size:0.66rem; font-weight:700; padding:0.1rem 0.45rem; border-radius:999px; margin-left:0.3rem;">prueba</span> }
                                        </div>
                                        <div style="font-size:0.74rem; color:#6b7280; margin-top:0.15rem;">
                                            @s.StopsCount parada@(s.StopsCount == 1 ? "" : "s") ·
                                            <span style="color:@(s.DeliveredCount > 0 ? "#15803d" : "#9ca3af"); font-weight:@(s.DeliveredCount > 0 ? "700" : "400");">✔ @s.DeliveredCount entregada@(s.DeliveredCount == 1 ? "" : "s")</span>
                                            @if (s.VehiclesCount > 0) { <text> · @s.VehiclesCount zona@(s.VehiclesCount == 1 ? "" : "s")</text> }
                                        </div>
                                    </div>
                                    <button class="btn" style="font-size:0.74rem; font-weight:700; padding:0.3rem 0.6rem; background:#2563eb; color:#fff; border:none; border-radius:6px; white-space:nowrap;"
                                            @onclick="() => VerSnapshotEnMapa(s.Id)">🗺 Ver en el mapa</button>
                                    <button class="btn btn-secondary" style="font-size:0.72rem; padding:0.3rem 0.5rem;"
                                            @onclick="() => OpenSnapshotDetail(s.Id)" title="Ver la lista de paradas">📋</button>
                                    <button class="btn btn-danger" style="font-size:0.72rem; padding:0.3rem 0.5rem;"
                                            @onclick="() => DeleteSnapshot(s)" title="Borrar esta foto">🗑</button>
                                </div>
                            }
                        </div>
                    }
                }
            </div>
            <div class="modal-footer">
                <button class="btn btn-secondary" @onclick="() => showHistorialModal = false">Cerrar</button>
            </div>
        </div>
    </div>
}

@if (showSnapshotDetail && snapshotDetail is not null)
{
    <div class="modal-overlay" @onclick="() => showSnapshotDetail = false">
        <div class="modal-card" @onclick:stopPropagation="true" style="max-width:900px; max-height:88vh; display:flex; flex-direction:column;">
            <div class="modal-header" style="background:#f0f9ff;">
                <h3 style="margin:0;">📋 @snapshotDetail.Title</h3>
                <button class="btn-close" @onclick="() => showSnapshotDetail = false">&times;</button>
            </div>
            <div class="modal-body" style="overflow-y:auto;">
                <p style="font-size:0.85rem; color:#4b5563;">
                    @snapshotDetail.StopsCount paradas · @snapshotDetail.VehiclesCount zonas · @snapshotDetail.DriversCount choferes
                    · @snapshotDetail.CreatedAt.ToArTime().ToString("dd/MM/yyyy HH:mm")
                </p>
                <table class="data-table" style="font-size:0.78rem;">
                    <thead>
                        <tr><th>Orden</th><th>Zona</th><th>Chofer</th><th>Parada</th><th>Dirección</th><th>Estado</th></tr>
                    </thead>
                    <tbody>
                    @foreach (var s in snapshotDetail.Stops.OrderBy(x => x.AssignedDriverId ?? int.MaxValue).ThenBy(x => x.OrderInRoute ?? int.MaxValue).ThenBy(x => x.Id))
                    {
                        <tr>
                            <td style="text-align:center; font-weight:700;">@(s.OrderInRoute?.ToString() ?? "—")</td>
                            <td>@(s.AssignedVehicleSlot.HasValue ? "Zona " + s.AssignedVehicleSlot : "—")</td>
                            <td>@(s.AssignedDriverName ?? "—")</td>
                            <td>@(s.Alias ?? s.ContactName ?? "—")</td>
                            <td>@s.Direccion</td>
                            <td>
                                @if (s.Delivered || string.Equals(s.InternalStatus, "entregado", StringComparison.OrdinalIgnoreCase))
                                { <span style="color:#15803d; font-weight:700;">✔ Entregado</span> }
                                else { <span style="color:#9ca3af;">@s.InternalStatus</span> }
                            </td>
                        </tr>
                    }
                    </tbody>
                </table>
            </div>
            <div class="modal-footer">
                <button class="btn" style="background:#2563eb; color:#fff; border:none;" @onclick="() => VerSnapshotEnMapa(snapshotDetail.Id)">🗺 Ver en el mapa</button>
                <button class="btn btn-secondary" @onclick="() => showSnapshotDetail = false">Cerrar</button>
            </div>
        </div>
    </div>
}

@if (showPublicUrlModal)
{
    <div class="modal-overlay" @onclick="() => showPublicUrlModal = false">
        <div class="modal-card modal-small" @onclick:stopPropagation="true">
            <div class="modal-header" style="background:#dbeafe;">
                <h3 style="margin:0;">🌐 URL pública del sistema</h3>
                <button class="btn-close" @onclick="() => showPublicUrlModal = false">&times;</button>
            </div>
            <div class="modal-body">
                <p style="font-size:0.85rem; color:#4b5563; margin:0 0 0.6rem;">
                    Es la dirección pública del sistema desde la que los <strong>choferes van a abrir sus rutas</strong>.
                    Si no la configurás, los links salen con la URL que tenés vos en el navegador
                    (ej: <code style="background:#f3f4f6; padding:0 0.2rem;">@Navigation.BaseUri</code>) — y eso falla
                    si tiene IP/puerto raros.
                </p>
                <div class="form-group">
                    <label class="form-label">URL pública (sin barra final)</label>
                    <input class="form-input" @bind="formPublicUrl" placeholder="https://midominio.com" />
                    <p style="font-size:0.7rem; color:#6b7280; margin:0.2rem 0 0;">
                        Idealmente con HTTPS y sin puerto. Ejemplos válidos:
                        <code>https://palanica.com.ar</code> o <code>https://app.frikaf.com</code>.
                    </p>
                </div>
                @if (!string.IsNullOrWhiteSpace(formPublicUrl))
                {
                    <div style="background:#ecfdf5; border:1px solid #a7f3d0; padding:0.5rem; border-radius:6px; font-size:0.8rem;">
                        Vista previa del link:<br/>
                        <code style="word-break:break-all;">@(formPublicUrl.TrimEnd('/'))/r/<em>token</em></code>
                    </div>
                }
            </div>
            <div class="modal-footer">
                <button class="btn btn-secondary" @onclick="ClearPublicUrl" disabled="@savingPublicUrl">Borrar</button>
                <button class="btn btn-secondary" @onclick="() => showPublicUrlModal = false" disabled="@savingPublicUrl">Cancelar</button>
                <button class="btn btn-primary" @onclick="SavePublicUrl" disabled="@savingPublicUrl">@(savingPublicUrl ? "Guardando..." : "Guardar")</button>
            </div>
        </div>
    </div>
}

@if (showAssignDriversModal)
{
    <div class="modal-overlay" @onclick="() => showAssignDriversModal = false">
        <div class="modal-card" @onclick:stopPropagation="true" style="max-width:560px;">
            <div class="modal-header" style="background:#dbeafe;">
                <h3 style="margin:0;">👤 Asignar choferes a las zonas</h3>
                <button class="btn-close" @onclick="() => showAssignDriversModal = false">&times;</button>
            </div>
            <div class="modal-body">
                @if ((drivers?.Count(d => d.IsActive) ?? 0) == 0)
                {
                    <div style="background:#fee2e2; padding:0.6rem; border-left:3px solid #b91c1c; font-size:0.85rem;">
                        ⚠ No hay choferes cargados. Volvé y agregá en <strong>👥 Repartidores</strong>.
                    </div>
                }
                else
                {
                    @foreach (var slot in (stops ?? new()).Where(s => s.AssignedVehicleSlot.HasValue).Select(s => s.AssignedVehicleSlot!.Value).Distinct().OrderBy(x => x))
                    {
                        var color = VehicleColor(slot);
                        var count = stops?.Count(s => s.AssignedVehicleSlot == slot) ?? 0;
                        var currentDriverId = stops?.FirstOrDefault(s => s.AssignedVehicleSlot == slot)?.AssignedDriverId;
                        var driverObj = currentDriverId.HasValue ? drivers?.FirstOrDefault(d => d.Id == currentDriverId.Value) : null;
                        <div style="margin-bottom:0.5rem; padding:0.5rem; background:@(color)11; border:1px solid @color; border-radius:6px;">
                            <div style="display:flex; align-items:center; gap:0.5rem;">
                                <strong style="color:@color; min-width:60px;">Zona @slot</strong>
                                <span style="font-size:0.78rem; color:#6b7280;">@count parada(s)</span>
                                <select class="form-input" style="flex:1;" @onchange="@(e => SaveDriverForSlot(slot, e.Value?.ToString()))">
                                    <option value="">— Sin chofer —</option>
                                    @foreach (var d in drivers!.Where(x => x.IsActive))
                                    {
                                        <option value="@d.Id" selected="@(currentDriverId == d.Id)">@d.Nombre</option>
                                    }
                                </select>
                            </div>
                            @if (driverObj is not null && count > 0)
                            {
                                var baseForLink = !string.IsNullOrWhiteSpace(publicBaseUrl) ? publicBaseUrl + "/" : Navigation.BaseUri;
                                var link = string.IsNullOrEmpty(driverObj.ShareToken) ? null : $"{baseForLink}r/{driverObj.ShareToken}";
                                var gmapsLinkChofer = BuildGmapsRouteUrlForDriver(driverObj.Id);
                                <div style="margin-top:0.4rem; display:flex; flex-direction:column; gap:0.3rem;">
                                    @if (link is null)
                                    {
                                        <button class="btn btn-secondary" style="font-size:0.78rem; align-self:flex-start;" @onclick="() => GenerateLink(driverObj)">🔗 Generar link</button>
                                    }
                                    else
                                    {
                                        <div style="display:flex; gap:0.3rem; flex-wrap:wrap; align-items:center;">
                                            <span style="font-size:0.7rem; font-weight:700; color:#1e40af; min-width:65px;">📋 Detalle:</span>
                                            <a href="@link" target="_blank" rel="noopener noreferrer"
                                               style="flex:1; font-size:0.72rem; padding:0.3rem 0.5rem; background:#f0f9ff; border:1px solid #93c5fd; border-radius:4px; color:#1d4ed8; text-decoration:none; font-family:monospace; word-break:break-all;"
                                               title="Pantalla nuestra con detalle de paradas, teléfonos, notas, etc.">
                                                🔗 @link
                                            </a>
                                            <button class="btn btn-secondary" style="font-size:0.78rem;" @onclick="() => CopyLink(link)">📋 Copiar</button>
                                        </div>
                                        @if (gmapsLinkChofer != "#")
                                        {
                                            <div style="display:flex; gap:0.3rem; flex-wrap:wrap; align-items:center;">
                                                <span style="font-size:0.7rem; font-weight:700; color:#9a3412; min-width:65px;">🗺 Maps:</span>
                                                <a href="@gmapsLinkChofer" target="_blank" rel="noopener noreferrer"
                                                   style="flex:1; font-size:0.72rem; padding:0.3rem 0.5rem; background:#fff7ed; border:1px solid #fed7aa; border-radius:4px; color:#9a3412; text-decoration:none; font-family:monospace; word-break:break-all;"
                                                   title="Google Maps con las paradas del chofer en orden. Para navegar manejando.">
                                                    🗺 Google Maps (@count paradas)
                                                </a>
                                                <button class="btn btn-secondary" style="font-size:0.78rem;" @onclick="() => CopyLink(gmapsLinkChofer)">📋 Copiar</button>
                                            </div>
                                        }
                                        @if (!string.IsNullOrEmpty(driverObj.Telefono))
                                        {
                                            var digits = new string(driverObj.Telefono.Where(char.IsDigit).ToArray());
                                            var msgParts = new List<string> { $"Hola {driverObj.Nombre}! Tu ruta de hoy ({count} paradas):", "", $"📋 Detalle: {link}" };
                                            if (gmapsLinkChofer != "#") { msgParts.Add(""); msgParts.Add($"🗺 Navegar: {gmapsLinkChofer}"); }
                                            var waMsg = Uri.EscapeDataString(string.Join("\n", msgParts));
                                            var waDetMsg = Uri.EscapeDataString(BuildWhatsAppDetallado(driverObj.Id, driverObj.Nombre ?? "Chofer"));
                                            <div style="display:flex; gap:0.3rem; flex-wrap:wrap;">
                                                <a class="btn" style="font-size:0.78rem; background:#25D366; color:white; border:none;" target="_blank" href="@($"https://wa.me/{digits}?text={waMsg}")" title="Mensaje corto con los 2 enlaces (Detalle + Maps general)">💬 Enviar 2 links</a>
                                                <a class="btn" style="font-size:0.78rem; background:#128C7E; color:white; border:none;" target="_blank" href="@($"https://wa.me/{digits}?text={waDetMsg}")" title="Mensaje largo con cada parada en orden + link de Maps individual">📋 Enviar detallado</a>
                                            </div>
                                        }
                                    }
                                </div>
                            }
                        </div>
                    }
                }
            </div>
            <div class="modal-footer">
                <button class="btn btn-primary" @onclick="() => showAssignDriversModal = false">Listo</button>
            </div>
        </div>
    </div>
}

@if (showImportFlexModal)
{
    <div class="modal-overlay" @onclick="() => showImportFlexModal = false">
        <div class="modal-card modal-small" @onclick:stopPropagation="true">
            <div class="modal-header" style="background:#dbeafe;">
                <h3 style="margin:0;">📥 Sumar Flex a paradas</h3>
                <button class="btn-close" @onclick="() => showImportFlexModal = false">&times;</button>
            </div>
            <div class="modal-body" style="font-size:0.9rem;">
                <div class="form-group">
                    <label class="form-label">Período a importar</label>
                    <select class="form-input" @bind="importFlexDays" @bind:after="LoadImportPreview">
                        <option value="today">Hoy</option>
                        <option value="tomorrow">Mañana</option>
                        <option value="overdue">⚠ Atrasados</option>
                        <option value="all">Todos los pendientes</option>
                    </select>
                </div>
                @if (importPreview is null)
                {
                    <p class="text-muted" style="text-align:center;">Cargando preview...</p>
                }
                else
                {
                    <div style="background:#f9fafb; border:1px solid #e5e7eb; border-radius:6px; padding:0.6rem; margin-bottom:0.6rem;">
                        <div style="font-size:0.85rem;">
                            <strong>📊 Encontrados:</strong> @importPreview.Total Flex en el período<br/>
                            <strong>✅ Ya en paradas:</strong> @importPreview.YaCargados<br/>
                            <strong style="color:#15803d; font-size:1.05rem;">➕ A importar: @importPreview.AImportar</strong>
                        </div>
                    </div>
                    @if (importPreview.AImportar == 0)
                    {
                        <p style="color:#6b7280; text-align:center; padding:0.5rem;">No hay Flex nuevos para importar en este período.</p>
                    }
                    else if (importPreview.Sample.Count > 0)
                    {
                        <div style="font-size:0.78rem; color:#6b7280; margin-bottom:0.3rem;">Primeros @importPreview.Sample.Count de @importPreview.AImportar:</div>
                        <ul style="font-size:0.78rem; color:#4b5563; padding-left:1.2rem; margin:0;">
                            @foreach (var s in importPreview.Sample)
                            {
                                <li><strong>@(s.ReceiverName ?? "—")</strong> · @(s.City ?? "") · @(s.AddressLine ?? "")</li>
                            }
                            @if (importPreview.AImportar > importPreview.Sample.Count)
                            { <li style="color:#9ca3af;">... y @(importPreview.AImportar - importPreview.Sample.Count) más</li> }
                        </ul>
                    }
                }
            </div>
            <div class="modal-footer">
                <button class="btn btn-secondary" @onclick="() => showImportFlexModal = false" disabled="@importingFlex">Cancelar</button>
                <button class="btn btn-primary" @onclick="ConfirmImportFlex"
                        disabled="@(importingFlex || importPreview is null || importPreview.AImportar == 0)">
                    @(importingFlex ? "Importando..." : $"Importar {(importPreview?.AImportar ?? 0)}")
                </button>
            </div>
        </div>
    </div>
}

@if (showArmarRutaModal)
{
    <div class="modal-overlay" @onclick="() => showArmarRutaModal = false">
        <div class="modal-card" @onclick:stopPropagation="true" style="max-width:1100px; max-height:92vh; display:flex; flex-direction:column;">
            <div class="modal-header" style="background:#dbeafe;">
                <h3 style="margin:0;">📋 Armar ruta — @(stops?.Count ?? 0) paradas · @(drivers?.Count(d => d.IsActive) ?? 0) repartidores</h3>
                <button class="btn-close" @onclick="() => showArmarRutaModal = false">&times;</button>
            </div>
            <div class="modal-body" style="overflow-y:auto;">
                @if ((drivers?.Count(d => d.IsActive) ?? 0) == 0)
                {
                    <div style="background:#fee2e2; border-left:3px solid #b91c1c; padding:0.7rem; margin-bottom:0.7rem; font-size:0.9rem;">
                        ⚠ No tenés repartidores activos. Andá a <strong>👥 Repartidores</strong> arriba y agregá al menos uno.
                    </div>
                }
                else if ((stops?.Count ?? 0) == 0)
                {
                    <div style="background:#fef3c7; border-left:3px solid #d97706; padding:0.7rem; margin-bottom:0.7rem; font-size:0.9rem;">
                        ⚠ No hay paradas. Tocá <strong>📥 Sumar Flex a paradas</strong> o <strong>➕ Agregar parada</strong> arriba.
                    </div>
                }
                else
                {
                    <div style="display:flex; gap:0.4rem; flex-wrap:wrap; margin-bottom:0.8rem; padding:0.5rem; background:#f9fafb; border-radius:6px;">
                        <button class="btn btn-secondary" style="font-size:0.85rem;" @onclick="DoAutoAssign" disabled="@routeBusy" title="Reparte las paradas SIN driver entre los repartidores activos por cercanía geográfica (k-means)">
                            @(routeBusy ? "..." : "🧠 Repartir auto (sin asignar)")
                        </button>
                        <button class="btn btn-secondary" style="font-size:0.85rem;" @onclick="DoAutoAssignAll" disabled="@routeBusy" title="Reasigna TODAS las paradas (incluso las que ya tenían driver)">
                            🔄 Reasignar todas
                        </button>
                        <button class="btn btn-secondary" style="font-size:0.85rem;" @onclick="DoOptimizeAll" disabled="@routeBusy" title="Calcula el mejor orden por driver desde tu punto de partida (nearest-neighbor)">
                            ⚡ Optimizar orden
                        </button>
                        <button class="btn btn-secondary" style="font-size:0.85rem; color:#b91c1c;" @onclick="DoUnassignAll" disabled="@routeBusy" title="Quita todas las asignaciones">
                            🗑 Limpiar
                        </button>
                    </div>

                    @foreach (var g in stops!.GroupBy(s => s.AssignedDriverId).OrderBy(g => g.Key.HasValue ? 0 : 1).ThenBy(g => g.Key))
                    {
                        var driver = g.Key.HasValue ? drivers!.FirstOrDefault(d => d.Id == g.Key.Value) : null;
                        var headerColor = driver?.Color ?? "#9ca3af";
                        var headerLabel = driver?.Nombre ?? "🚫 Sin asignar";
                        <div style="margin-bottom:0.7rem; border:1px solid #e5e7eb; border-radius:8px; overflow:hidden;">
                            <div style="padding:0.5rem 0.7rem; background:@(headerColor)22; border-bottom:1px solid @headerColor; display:flex; justify-content:space-between; align-items:center;">
                                <strong style="color:@headerColor;">@headerLabel · @g.Count() parada(s)</strong>
                                @if (driver is not null)
                                {
                                    <button class="btn btn-secondary" style="font-size:0.72rem; padding:0.15rem 0.4rem;" @onclick="() => DoOptimizeDriver(driver.Id)" disabled="@routeBusy" title="Optimizar solo este driver">⚡</button>
                                }
                            </div>
                            @{
                                var sortedStops = g.OrderBy(x => x.OrderInRoute ?? int.MaxValue).ThenBy(x => x.Id).ToList();
                            }
                            <table class="data-table" style="font-size:0.8rem; margin:0;">
                                <thead><tr><th style="width:90px;">Orden</th><th>Parada</th><th>Dirección</th><th style="width:170px;">Repartidor</th></tr></thead>
                                <tbody>
                                @for (int idx = 0; idx < sortedStops.Count; idx++)
                                {
                                    var s = sortedStops[idx];
                                    var localIdx = idx;
                                    <tr>
                                        <td style="white-space:nowrap;">
                                            <span style="font-weight:700; font-size:0.95rem; color:@headerColor; margin-right:0.3rem;">@(s.OrderInRoute?.ToString() ?? "—")</span>
                                            <button class="btn-icon" style="font-size:0.85rem; padding:0; width:22px; height:22px;" disabled="@(localIdx == 0 || routeBusy)"
                                                    @onclick="() => MoveStop(sortedStops, localIdx, -1)" title="Subir">▲</button>
                                            <button class="btn-icon" style="font-size:0.85rem; padding:0; width:22px; height:22px;" disabled="@(localIdx == sortedStops.Count - 1 || routeBusy)"
                                                    @onclick="() => MoveStop(sortedStops, localIdx, +1)" title="Bajar">▼</button>
                                        </td>
                                        <td>
                                            <strong>@(s.Alias ?? s.ContactName ?? "Parada")</strong>
                                            <div style="font-size:0.7rem; color:#9ca3af;">@OriginLabel(s.Origin)</div>
                                        </td>
                                        <td style="font-size:0.78rem;">@s.Direccion</td>
                                        <td>
                                            <select class="form-input" style="font-size:0.78rem; padding:0.15rem 0.3rem;"
                                                    value="@(s.AssignedDriverId?.ToString() ?? "")"
                                                    @onchange="@(e => OnAssignDriver(s, e.Value?.ToString()))">
                                                <option value="">— Sin asignar —</option>
                                                @foreach (var d in drivers!.Where(x => x.IsActive))
                                                {
                                                    <option value="@d.Id" selected="@(s.AssignedDriverId == d.Id)">@d.Nombre</option>
                                                }
                                            </select>
                                        </td>
                                    </tr>
                                }
                                </tbody>
                            </table>
                        </div>
                    }
                }
            </div>
            <div class="modal-footer">
                <button class="btn btn-secondary" @onclick="() => showArmarRutaModal = false">Cerrar</button>
            </div>
        </div>
    </div>
}

@if (showAddStopModal)
{
    <div class="modal-overlay" @onclick="() => showAddStopModal = false">
        <div class="modal-card" @onclick:stopPropagation="true" style="max-width:620px;">
            <div class="modal-header" style="background:#fef3c7;">
                <h3 style="margin:0;">➕ Agregar parada al mapa</h3>
                <button class="btn-close" @onclick="() => showAddStopModal = false">&times;</button>
            </div>
            <div class="modal-body">
                <div style="display:flex; gap:0.4rem; margin-bottom:0.7rem; flex-wrap: wrap;">
                    <button class="btn @(addStopTab == "favorito" ? "btn-primary" : "btn-secondary")" style="flex:1; min-width:0;" @onclick="@(() => addStopTab = "favorito")">⭐ Favoritos</button>
                    <button class="btn @(addStopTab == "cliente" ? "btn-primary" : "btn-secondary")" style="flex:1; min-width:0;" @onclick="@(() => addStopTab = "cliente")">🍵 Clientes mapeados</button>
                    <button class="btn @(addStopTab == "manual" ? "btn-primary" : "btn-secondary")" style="flex:1; min-width:0;" @onclick="@(() => addStopTab = "manual")">✏️ Tipear nueva</button>
                </div>
                @if (addStopTab == "cliente")
                {
                    @if (clientesMapeados is null || clientesMapeados.Count == 0)
                    {
                        <p style="text-align:center; color:#6b7280; padding:1rem;">
                            No hay clientes mapeados. Andá a <strong>Café → Clientes</strong>, editá uno y cargale el enlace de Google Maps.
                        </p>
                    }
                    else
                    {
                        <input class="form-input" @bind="addStopClienteSearch" @bind:event="oninput" placeholder="Buscar por código, nombre, dirección..." style="margin-bottom:0.5rem;" />
                        <div style="max-height:340px; overflow-y:auto;">
                            @{
                                var t = addStopClienteSearch?.Trim() ?? "";
                                bool hasMatch(string? s) => !string.IsNullOrEmpty(s) && s.Contains(t, StringComparison.OrdinalIgnoreCase);
                            }
                            @foreach (var cli in clientesMapeados.Where(c => string.IsNullOrEmpty(t)
                                || hasMatch(c.Nombre) || hasMatch(c.RazonSocial) || hasMatch(c.Direccion)
                                || hasMatch(c.Localidad) || hasMatch(c.Cuit)
                                || (c.CodigoInterno.HasValue && c.CodigoInterno.Value.ToString().Contains(t))))
                            {
                                <div style="border:1px solid #e5e7eb; padding:0.5rem 0.7rem; border-radius:6px; margin-bottom:0.3rem; cursor:pointer; display:flex; gap:0.5rem; align-items:center;"
                                     @onclick="() => AddStopFromCliente(cli)"
                                     title="Click para agregar al mapa">
                                    @if (cli.CodigoInterno.HasValue)
                                    {
                                        <span style="display:inline-block; background:#1e40af; color:white; font-family:monospace; font-weight:700; padding:0.15rem 0.5rem; border-radius:4px; font-size:0.78rem;">@cli.CodigoInterno</span>
                                    }
                                    <div style="flex:1;">
                                        <strong>@cli.Nombre</strong>
                                        @if (cli.Tipo == "BAR")
                                        { <span style="display:inline-block; padding:0.05rem 0.35rem; background:#dbeafe; color:#1e40af; border-radius:999px; font-size:0.65rem; font-weight:700; margin-left:0.3rem;">🍺 BAR</span> }
                                        <div style="font-size:0.78rem; color:#4b5563;">@(cli.Direccion ?? "—")@(string.IsNullOrEmpty(cli.Localidad) ? "" : ", " + cli.Localidad)</div>
                                        @if (!cli.MapeoLat.HasValue)
                                        {
                                            <div style="font-size:0.7rem; color:#d97706;">⚠ Sin coordenadas extraídas — no se puede agregar al mapa</div>
                                        }
                                    </div>
                                </div>
                            }
                        </div>
                    }
                }
                @if (addStopTab == "favorito")
                {
                    @if (favoritos is null || favoritos.Count == 0)
                    {
                        <p style="text-align:center; color:#6b7280; padding:1rem;">No tenés favoritos. Tocá ⭐ Favoritos arriba para crearlos.</p>
                    }
                    else
                    {
                        <input class="form-input" @bind="addStopFavSearch" @bind:event="oninput" placeholder="Buscar..." style="margin-bottom:0.5rem;" />
                        <div style="max-height:340px; overflow-y:auto;">
                            @foreach (var f in favoritos.Where(x => string.IsNullOrEmpty(addStopFavSearch)
                                || x.Alias.Contains(addStopFavSearch, StringComparison.OrdinalIgnoreCase)
                                || x.Direccion.Contains(addStopFavSearch, StringComparison.OrdinalIgnoreCase)))
                            {
                                <div style="border:1px solid #e5e7eb; padding:0.5rem 0.7rem; border-radius:6px; margin-bottom:0.3rem; cursor:pointer;"
                                     @onclick="() => AddStopFromFavorito(f)" title="Click para agregar al mapa">
                                    <strong>@f.Alias</strong>
                                    <div style="font-size:0.78rem; color:#4b5563;">@f.Direccion</div>
                                    @if (!string.IsNullOrEmpty(f.Telefono))
                                    { <div style="font-size:0.7rem; color:#6b7280;">📞 @f.Telefono</div> }
                                </div>
                            }
                        </div>
                    }
                }
                @if (addStopTab == "manual")
                {
                    <div class="form-group">
                        <label class="form-label">Buscar dirección</label>
                        <div style="display:flex; gap:0.4rem;">
                            <input class="form-input" @bind="addStopQuery" placeholder="Calle 123, Ciudad" @onkeydown="OnAddStopGeocodeKey" style="flex:1;" />
                            <button class="btn btn-secondary" @onclick="DoAddStopGeocode" disabled="@addStopGeocoding">@(addStopGeocoding ? "..." : "🔍")</button>
                        </div>
                    </div>
                    @if (addStopGeocodeResults is not null && addStopGeocodeResults.Count > 0)
                    {
                        <div style="border:1px solid #e5e7eb; border-radius:6px; max-height:140px; overflow-y:auto; margin-bottom:0.5rem;">
                            @foreach (var r in addStopGeocodeResults)
                            {
                                <div style="padding:0.3rem 0.5rem; border-bottom:1px solid #f3f4f6; cursor:pointer; font-size:0.78rem;"
                                     @onclick="() => PickAddStopGeocode(r)">@r.DisplayName</div>
                            }
                        </div>
                    }
                    @if (addStopLat != 0 || addStopLng != 0)
                    {
                        <div style="font-size:0.75rem; color:#15803d; margin-bottom:0.4rem;">✓ @addStopDireccion (@addStopLat.ToString("0.####") , @addStopLng.ToString("0.####"))</div>
                    }
                    <div class="form-group"><label class="form-label">Alias / Cliente</label><input class="form-input" @bind="addStopAlias" placeholder="Bar Don Pepe" /></div>
                    <div class="form-row">
                        <div class="form-group" style="flex:1;"><label class="form-label">Contacto</label><input class="form-input" @bind="addStopContact" placeholder="Pepe" /></div>
                        <div class="form-group" style="flex:1;"><label class="form-label">Tel</label><input class="form-input" @bind="addStopPhone" /></div>
                    </div>
                    <div class="form-group"><label class="form-label">Notas (instrucciones, comentarios)</label><input class="form-input" @bind="addStopNotas" /></div>
                    <label style="display:flex; align-items:center; gap:0.3rem; font-size:0.78rem; color:#6b7280;">
                        <input type="checkbox" @bind="addStopAlsoSaveFav" /> También guardar como favorito
                    </label>
                    <button class="btn btn-primary" style="width:100%; margin-top:0.5rem;" @onclick="AddStopManual"
                            disabled="@(addStopLat == 0 && addStopLng == 0)">+ Agregar parada</button>
                }
            </div>
            <div class="modal-footer">
                <button class="btn btn-secondary" @onclick="() => showAddStopModal = false">Cerrar</button>
            </div>
        </div>
    </div>
}

@if (showDriversModal)
{
    <div class="modal-overlay" @onclick="() => showDriversModal = false">
        <div class="modal-card" @onclick:stopPropagation="true" style="max-width:640px;">
            <div class="modal-header" style="background:#dbeafe;">
                <h3 style="margin:0;">👥 Repartidores</h3>
                <button class="btn-close" @onclick="() => showDriversModal = false">&times;</button>
            </div>
            <div class="modal-body">
                <div style="font-size:0.78rem; color:#374151; margin-bottom:0.6rem; padding:0.5rem 0.6rem; background:#eff6ff; border:1px solid #bfdbfe; border-radius:6px;">
                    👥 Estos son tus <strong>repartidores reales</strong> (los del teléfono). Aparecen solos acá.
                    Para <strong>agregar, sacar o renombrar</strong> un repartidor, andá a
                    <strong>Administración → Repartidores</strong>. Acá solo elegís el <strong>color</strong> con el que
                    lo ves en el mapa, y su ruta le llega automáticamente a <strong>Mis Pedidos</strong>.
                </div>
                @if (drivers is null || drivers.Count == 0)
                {
                    <p style="text-align:center; color:#6b7280; padding:1rem;">
                        No hay repartidores activos. Cargalos en <strong>Administración → Repartidores</strong>.
                    </p>
                }
                else
                {
                    <table class="data-table" style="font-size:0.9rem;">
                        <thead><tr><th>Color</th><th>Repartidor</th><th></th></tr></thead>
                        <tbody>
                        @foreach (var d in drivers)
                        {
                            <tr>
                                <td><input type="color" @bind="d.Color" style="width:34px; height:26px; border:none; padding:0;" /></td>
                                <td style="font-weight:600;">@d.Nombre</td>
                                <td style="white-space:nowrap;">
                                    <button class="btn btn-secondary" style="font-size:0.78rem; padding:0.25rem 0.6rem;" @onclick="() => SaveDriver(d)" title="Guardar el color">💾 Guardar color</button>
                                </td>
                            </tr>
                        }
                        </tbody>
                    </table>
                }
            </div>
            <div class="modal-footer">
                <button class="btn btn-secondary" @onclick="() => showDriversModal = false">Cerrar</button>
            </div>
        </div>
    </div>
}

@if (showFavoritosModal)
{
    <div class="modal-overlay" @onclick="() => showFavoritosModal = false">
        <div class="modal-card" @onclick:stopPropagation="true" style="max-width:780px;">
            <div class="modal-header" style="background:#fef3c7;">
                <h3 style="margin:0;">⭐ Direcciones favoritas</h3>
                <button class="btn-close" @onclick="() => showFavoritosModal = false">&times;</button>
            </div>
            <div class="modal-body" style="max-height:65vh; overflow-y:auto;">
                <div style="background:#f9fafb; border:1px solid #e5e7eb; padding:0.6rem; border-radius:6px; margin-bottom:0.7rem;">
                    <strong style="font-size:0.85rem;">Agregar nueva dirección</strong>
                    <div class="form-group">
                        <label class="form-label">Alias (corto)</label>
                        <input class="form-input" @bind="newFavAlias" placeholder="Cafetería Don Pepe" />
                    </div>
                    <div class="form-group">
                        <label class="form-label">Buscar dirección</label>
                        <div style="display:flex; gap:0.4rem;">
                            <input class="form-input" @bind="newFavQuery" placeholder="Calle 123, Ciudad" @onkeydown="OnFavGeocodeKey" style="flex:1;" />
                            <button class="btn btn-secondary" @onclick="DoFavGeocode" disabled="@favGeocoding">@(favGeocoding ? "..." : "🔍")</button>
                        </div>
                    </div>
                    @if (favGeocodeResults is not null && favGeocodeResults.Count > 0)
                    {
                        <div style="border:1px solid #e5e7eb; border-radius:6px; max-height:120px; overflow-y:auto; margin-bottom:0.5rem;">
                            @foreach (var r in favGeocodeResults)
                            {
                                <div style="padding:0.3rem 0.5rem; border-bottom:1px solid #f3f4f6; cursor:pointer; font-size:0.78rem;"
                                     @onclick="() => PickFavGeocode(r)">@r.DisplayName</div>
                            }
                        </div>
                    }
                    @if (newFavLat != 0 || newFavLng != 0)
                    {
                        <div style="font-size:0.75rem; color:#15803d;">✓ @newFavDireccion (@newFavLat.ToString("0.####") , @newFavLng.ToString("0.####"))</div>
                    }
                    <div class="form-row" style="margin-top:0.4rem;">
                        <div class="form-group" style="flex:1;"><label class="form-label">Contacto</label><input class="form-input" @bind="newFavContact" placeholder="Pepe" /></div>
                        <div class="form-group" style="flex:1;"><label class="form-label">Tel</label><input class="form-input" @bind="newFavPhone" /></div>
                    </div>
                    <div class="form-group"><label class="form-label">Notas</label><input class="form-input" @bind="newFavNotas" placeholder="Tocar timbre 3 veces" /></div>
                    <button class="btn btn-primary" style="width:100%;" @onclick="AddFavorito" disabled="@(string.IsNullOrWhiteSpace(newFavAlias) || (newFavLat == 0 && newFavLng == 0))">+ Guardar favorito</button>
                </div>
                @if (favoritos is null || favoritos.Count == 0)
                { <p style="text-align:center; color:#6b7280; padding:1rem;">No hay favoritos cargados todavía.</p> }
                else
                {
                    @foreach (var f in favoritos)
                    {
                        <div style="border:1px solid #e5e7eb; padding:0.5rem 0.7rem; border-radius:6px; margin-bottom:0.4rem;">
                            <div style="display:flex; justify-content:space-between; align-items:flex-start; gap:0.4rem;">
                                <div>
                                    <strong>@f.Alias</strong> · <span style="font-size:0.78rem; color:#4b5563;">@f.Direccion</span>
                                    @if (!string.IsNullOrEmpty(f.ContactName) || !string.IsNullOrEmpty(f.Telefono))
                                    {
                                        <div style="font-size:0.75rem; color:#6b7280;">
                                            @if (!string.IsNullOrEmpty(f.ContactName)) { <span>👤 @f.ContactName</span> }
                                            @if (!string.IsNullOrEmpty(f.Telefono)) { <span> · 📞 @f.Telefono</span> }
                                        </div>
                                    }
                                    @if (!string.IsNullOrEmpty(f.Notas))
                                    { <div style="font-size:0.72rem; color:#9ca3af;">📝 @f.Notas</div> }
                                </div>
                                <button class="btn btn-danger" style="font-size:0.75rem; padding:0.2rem 0.5rem;" @onclick="() => DeleteFavorito(f)">🗑</button>
                            </div>
                        </div>
                    }
                }
            </div>
            <div class="modal-footer">
                <button class="btn btn-secondary" @onclick="() => showFavoritosModal = false">Cerrar</button>
            </div>
        </div>
    </div>
}

@if (showZoneAssignModal)
{
    <div class="modal-overlay" @onclick="() => showZoneAssignModal = false">
        <div class="modal-card modal-small" @onclick:stopPropagation="true">
            <div class="modal-header" style="background:#dbeafe;">
                <h3 style="margin:0;">🗺️ Asignar zona</h3>
                <button class="btn-close" @onclick="() => showZoneAssignModal = false">&times;</button>
            </div>
            <div class="modal-body">
                <p style="font-size:0.9rem; color:#374151; margin:0 0 0.6rem;">
                    Dibujaste una zona con <strong>@zoneStopIds.Count envío(s)</strong> adentro.
                </p>
                @* Opción recomendada: crear la zona SIN chofer y elegirlos al final. *@
                <button class="btn" style="display:flex; align-items:center; gap:0.5rem; width:100%; justify-content:center; padding:0.7rem 0.8rem; font-size:0.95rem; font-weight:800; background:#16a34a; color:#fff; border:none; border-radius:8px; margin-bottom:0.3rem;"
                        @onclick="CrearZonaSinChofer" disabled="@assigningZone">
                    ➕ Crear la zona (elijo los choferes al final)
                </button>
                <p style="font-size:0.74rem; color:#6b7280; margin:0 0 0.7rem; text-align:center;">
                    Después armás el orden y recién al final ponés los choferes con <strong>👤 Asignar choferes</strong>.
                </p>
                <div style="border-top:1px solid #e5e7eb; margin:0 0 0.6rem;"></div>
                <p style="font-size:0.82rem; color:#6b7280; margin:0 0 0.5rem;">…o si ya sabés quién la hace, asignale el chofer ahora:</p>
                @if ((drivers?.Count(d => d.IsActive) ?? 0) == 0)
                {
                    <p style="font-size:0.85rem; color:#b45309;">No tenés repartidores cargados. Agregalos en ⚙ Configuración → 👥 Repartidores.</p>
                }
                else
                {
                    <div style="display:flex; flex-direction:column; gap:0.4rem;">
                        @foreach (var d in drivers!.Where(x => x.IsActive))
                        {
                            <button class="btn" style="display:flex; align-items:center; gap:0.5rem; width:100%; justify-content:flex-start; padding:0.6rem 0.8rem; font-size:0.95rem; font-weight:700; border:2px solid @d.Color; background:white; color:#1f2937;"
                                    @onclick="() => AsignarZonaARepartidor(d.Id)" disabled="@assigningZone">
                                <span style="width:14px; height:14px; border-radius:50%; background:@d.Color; display:inline-block;"></span>
                                @d.Nombre
                            </button>
                        }
                    </div>
                }
            </div>
            <div class="modal-footer">
                <button class="btn btn-secondary" @onclick="() => showZoneAssignModal = false" disabled="@assigningZone">Cancelar</button>
            </div>
        </div>
    </div>
}

@if (showRutasReparto)
{
    <div class="modal-overlay" @onclick="() => showRutasReparto = false">
        <div class="modal-card" @onclick:stopPropagation="true" style="max-width:540px;">
            <div class="modal-header" style="background:#dbeafe;">
                <h3 style="margin:0;">👁 Ver como repartidores</h3>
                <button class="btn-close" @onclick="() => showRutasReparto = false">&times;</button>
            </div>
            <div class="modal-body">
                @{
                    // Cuántas paradas tiene asignada cada repartidor hoy (para mostrar al lado del nombre).
                    var paradasPorDriver = (stops ?? new()).Where(s => s.AssignedDriverId.HasValue)
                        .GroupBy(s => s.AssignedDriverId!.Value)
                        .ToDictionary(g => g.Key, g => g.Count());
                    var reparts = (drivers ?? new()).Where(d => d.IsActive).ToList();
                }
                <p style="font-size:0.82rem; color:#6b7280; margin:0 0 0.6rem;">
                    Esta es la MISMA pantalla que ve cada repartidor en su celular (<span style="font-family:monospace;">/mis-pedidos</span>): su lista en orden de ruta, escáner y el mapa completo. Tocá “Ver su pantalla” para revisarla.
                </p>
                @if (reparts.Count == 0)
                {
                    <p style="color:#6b7280; font-size:0.9rem;">No hay repartidores. Agregalos en ⚙ Configuración → 👥 Repartidores.</p>
                }
                else
                {
                    @foreach (var d in reparts)
                    {
                        var cant = paradasPorDriver.TryGetValue(d.Id, out var c) ? c : 0;
                        var baseForLink = !string.IsNullOrWhiteSpace(publicBaseUrl) ? publicBaseUrl + "/" : Navigation.BaseUri;
                        var link = string.IsNullOrEmpty(d.PublicToken) ? null : $"{baseForLink}mis-pedidos/{d.PublicToken}";
                        <div style="border:1px solid @d.Color; border-radius:8px; padding:0.6rem; margin-bottom:0.6rem;">
                            <div style="display:flex; align-items:center; gap:0.5rem; flex-wrap:wrap;">
                                <span style="width:14px; height:14px; border-radius:50%; background:@d.Color; flex:0 0 14px;"></span>
                                <strong>@d.Nombre</strong>
                                <span style="font-size:0.78rem; color:#6b7280;">· @cant parada@(cant == 1 ? "" : "s") hoy</span>
                            </div>
                            @if (link is null)
                            {
                                <div style="font-size:0.72rem; color:#9ca3af; margin-top:0.4rem;">Este repartidor todavía no tiene link. Refrescá la lista (⚙ Repartidores) e intentá de nuevo.</div>
                            }
                            else
                            {
                                <div style="margin-top:0.45rem; display:flex; gap:0.3rem; align-items:center; flex-wrap:wrap;">
                                    <a class="btn" style="font-size:0.82rem; background:#0f766e; color:white; border:none; font-weight:700;" href="@link" target="_blank" rel="noopener noreferrer">👁 Ver su pantalla</a>
                                    <button class="btn btn-secondary" style="font-size:0.78rem;" @onclick="() => CopyLink(link)">📋 Copiar link</button>
                                </div>
                            }
                        </div>
                    }
                }
            </div>
            <div class="modal-footer">
                <button class="btn btn-primary" @onclick="() => showRutasReparto = false">Listo</button>
            </div>
        </div>
    </div>
}

@* ===== Descargar / Compartir ruta ===== *@
@if (showExportModal)
{
    <div class="modal-overlay" @onclick="() => showExportModal = false">
        <div class="modal-card" @onclick:stopPropagation="true" style="max-width:540px;">
            <div class="modal-header" style="background:#e0f2fe;">
                <h3 style="margin:0;">📤 Descargar / Compartir ruta</h3>
                <button class="btn-close" @onclick="() => showExportModal = false">&times;</button>
            </div>
            <div class="modal-body" style="max-height:72vh; overflow-y:auto;">
                <div class="form-group">
                    <label class="form-label">¿De quién?</label>
                    <select class="form-input" @bind="exportDriverSel">
                        <option value="0">Toda la ruta (todos los repartidores)</option>
                        @if (drivers is not null)
                        {
                            @foreach (var d in drivers)
                            {
                                <option value="@d.Id">@d.Nombre</option>
                            }
                        }
                    </select>
                </div>

                <label class="form-label" style="margin-top:0.7rem; display:block;">¿Qué info incluir?</label>
                <div style="display:grid; grid-template-columns:1fr 1fr; gap:0.35rem 0.9rem;">
                    <label style="font-size:0.85rem; display:flex; align-items:center; gap:0.4rem;"><input type="checkbox" @bind="expOrden" /> Orden (1, 2, 3…)</label>
                    <label style="font-size:0.85rem; display:flex; align-items:center; gap:0.4rem;"><input type="checkbox" @bind="expNombre" /> Nombre / cliente</label>
                    <label style="font-size:0.85rem; display:flex; align-items:center; gap:0.4rem;"><input type="checkbox" @bind="expDireccion" /> Dirección</label>
                    <label style="font-size:0.85rem; display:flex; align-items:center; gap:0.4rem;"><input type="checkbox" @bind="expTelefono" /> Teléfono</label>
                    <label style="font-size:0.85rem; display:flex; align-items:center; gap:0.4rem;"><input type="checkbox" @bind="expNotas" /> Notas</label>
                    <label style="font-size:0.85rem; display:flex; align-items:center; gap:0.4rem;"><input type="checkbox" @bind="expRepartidor" /> Repartidor</label>
                    <label style="font-size:0.85rem; display:flex; align-items:center; gap:0.4rem;"><input type="checkbox" @bind="expEstado" /> Estado (entregado)</label>
                    <label style="font-size:0.85rem; display:flex; align-items:center; gap:0.4rem;"><input type="checkbox" @bind="expVentaMeli" /> Nº de venta MeLi</label>
                </div>

                <div style="margin-top:0.6rem; border-top:1px solid #f3f4f6; padding-top:0.5rem;">
                    <label style="font-size:0.85rem; display:flex; align-items:center; gap:0.4rem;"><input type="checkbox" @bind="expIncluirEntregados" /> Incluir paradas ya entregadas</label>
                </div>

                <div style="margin-top:1.1rem; display:flex; gap:0.5rem; flex-wrap:wrap;">
                    <button class="btn btn-secondary" style="flex:1; min-width:120px;" @onclick='() => DescargarRuta("pdf")' disabled="@exportBusy">📄 PDF</button>
                    <button class="btn btn-secondary" style="flex:1; min-width:120px;" @onclick='() => DescargarRuta("excel")' disabled="@exportBusy">📊 Excel</button>
                    <button class="btn btn-primary" style="flex:1; min-width:120px; background:#16a34a; border-color:#16a34a;" @onclick="CompartirWhatsapp" disabled="@exportBusy">💬 WhatsApp</button>
                </div>
                <p style="font-size:0.74rem; color:#6b7280; margin-top:0.7rem; line-height:1.35;">
                    💬 <strong>WhatsApp</strong> arma el listado como texto y abre WhatsApp para que elijas a quién mandárselo.
                    Para mandar el <strong>PDF o Excel</strong> como archivo, descargalo y adjuntalo vos en el chat.
                </p>
            </div>
        </div>
    </div>
}

@if (showScanModal)
{
    <div class="modal-overlay" @onclick="() => showScanModal = false">
        <div class="modal-card" @onclick:stopPropagation="true" style="max-width:440px; max-height:90vh; display:flex; flex-direction:column;">
            <div class="modal-header" style="background:#dcfce7;">
                <h3 style="margin:0;">📷 Escanear o traer por número</h3>
                <button class="btn-close" @onclick="() => showScanModal = false">&times;</button>
            </div>
            <div class="modal-body" style="text-align:center; overflow-y:auto;">
                <img src="@ScanQrUrl" alt="QR para escanear" style="width:200px; height:200px; background:#fff; border:1px solid #e5e7eb; border-radius:8px; padding:6px;" />
                <div style="font-weight:700; color:#166534; font-size:1rem; margin-top:0.6rem;">📱 Escaneá este QR con el celular</div>
                <div style="font-size:0.83rem; color:#15803d; margin-top:0.3rem; line-height:1.4;">
                    Se te abre el escáner en el teléfono. Apuntás al QR de cada etiqueta Flex y los paquetes se suman solos al mapa.
                </div>
                <div style="display:flex; gap:0.4rem; align-items:center; margin-top:0.8rem;">
                    <input class="form-input" readonly value="@EscanearUrl" style="flex:1; font-size:0.78rem; color:#374151;" @onclick:stopPropagation="true" />
                    <button class="btn btn-secondary" style="white-space:nowrap;" @onclick="@(() => CopyValue(EscanearUrl, "Enlace"))" title="Copiar el enlace">📋 Copiar</button>
                </div>
                <a href="@EscanearUrl" target="_blank" rel="noopener" style="display:inline-block; margin-top:0.6rem; font-size:0.82rem; color:#2563eb;">
                    🔗 Abrir el escáner en este dispositivo
                </a>

                @* ─── O traer por número, sin escanear (plan B si falla el escáner/impresora) ─── *@
                <div style="display:flex; align-items:center; gap:0.6rem; margin:1.1rem 0 0.7rem;">
                    <div style="flex:1; height:1px; background:#e5e7eb;"></div>
                    <span style="font-size:0.78rem; font-weight:700; color:#6b7280; white-space:nowrap;">⌨️ o traé por número</span>
                    <div style="flex:1; height:1px; background:#e5e7eb;"></div>
                </div>
                <p style="font-size:0.82rem; color:#4b5563; margin:0 0 0.5rem; line-height:1.45; text-align:left;">
                    Escribí o pegá el <strong>número</strong> y lo traigo al mapa igual que escaneándolo.
                    Sirve para <strong>ventas del sistema</strong>, <strong>alquileres</strong> y <strong>envíos de MercadoLibre</strong>
                    (nº de venta o nº de envío). El sistema reconoce solo de qué es.
                    <br /><span style="color:#6b7280; font-size:0.76rem;">💡 Podés poner varios, uno por línea.</span>
                </p>
                <textarea class="form-input" @bind="porNumeroTexto" rows="3" placeholder="Ej:&#10;0001-00012345&#10;2000012345678901" @onclick:stopPropagation="true"
                          style="width:100%; font-size:0.95rem; font-family:monospace; text-align:left;"></textarea>
                <button class="btn" style="width:100%; margin-top:0.6rem; padding:0.65rem; font-size:1rem; font-weight:700; background:#2563eb; color:#fff; border:none; border-radius:8px;"
                        @onclick="TraerPorNumero" disabled="@trayendoPorNumero">
                    @(trayendoPorNumero ? "Trayendo…" : "🔎 Traer al mapa")
                </button>

                @if (porNumeroResultados.Count > 0)
                {
                    <div style="margin-top:0.8rem; display:flex; flex-direction:column; gap:0.35rem; text-align:left;">
                        @foreach (var r in porNumeroResultados)
                        {
                            var ok = r.Ok;
                            var color = ok ? (r.YaEstaba ? "#d97706" : "#15803d") : "#dc2626";
                            var bg = ok ? (r.YaEstaba ? "#fffbeb" : "#f0fdf4") : "#fef2f2";
                            var ico = ok ? (r.YaEstaba ? "↻" : "✓") : "✕";
                            <div style="display:flex; align-items:flex-start; gap:0.5rem; background:@bg; border:1px solid @color; border-radius:8px; padding:0.4rem 0.6rem;">
                                <span style="color:@color; font-weight:800; font-size:1rem;">@ico</span>
                                <div style="flex:1; min-width:0; font-size:0.8rem;">
                                    <strong style="color:#111827;">@r.Numero</strong>
                                    @if (!string.IsNullOrEmpty(r.Tipo)) { <span style="color:#6b7280;"> · @r.Tipo</span> }
                                    <div style="color:#4b5563;">@r.Mensaje @(string.IsNullOrEmpty(r.Nombre) ? "" : $"— {r.Nombre}")</div>
                                </div>
                            </div>
                        }
                    </div>
                }
            </div>
            <div class="modal-footer">
                <button class="btn btn-secondary" @onclick="() => showScanModal = false">Cerrar</button>
            </div>
        </div>
    </div>
}

@if (showStartPointModal)
{
    <div class="modal-overlay" @onclick="CloseStartPointModal">
        <div class="modal-card modal-small" @onclick:stopPropagation="true">
            <div class="modal-header" style="background:#dcfce7;">
                <h3 style="margin:0;">📍 Punto de partida</h3>
                <button class="btn-close" @onclick="CloseStartPointModal">&times;</button>
            </div>
            <div class="modal-body">
                <p style="color:#6b7280; font-size:0.85rem; margin:0 0 0.5rem;">
                    Es el lugar desde donde salís a repartir. Aparece como casita verde 🏠 en el mapa para que veas la ruta desde ahí.
                </p>

                @* Camino principal: elegir de tus Favoritos (sin tocar coordenadas). *@
                <div class="form-group">
                    <label class="form-label">⭐ Elegí de tus favoritos</label>
                    @if (favoritos is null || favoritos.Count == 0)
                    {
                        <p style="font-size:0.78rem; color:#6b7280; margin:0.2rem 0;">
                            Todavía no tenés favoritos. Guardá lugares con el botón ⭐ en la lista de la izquierda, o buscá una dirección acá abajo.
                        </p>
                    }
                    else
                    {
                        <div style="border:1px solid #e5e7eb; border-radius:6px; max-height:170px; overflow-y:auto;">
                            @foreach (var f in favoritos)
                            {
                                var esActual = startPoint?.Address == f.Direccion && startPoint?.Lat == f.Latitude;
                                <div style="padding:0.45rem 0.6rem; border-bottom:1px solid #f3f4f6; cursor:pointer; font-size:0.82rem; display:flex; justify-content:space-between; align-items:center; gap:0.5rem; @(esActual ? "background:#dcfce7;" : "")"
                                     @onclick="() => PickFavoritoAsStart(f)" title="Usar este favorito como punto de partida">
                                    <div>
                                        <strong>@f.Alias</strong>
                                        <div style="font-size:0.72rem; color:#9ca3af;">@f.Direccion</div>
                                    </div>
                                    <div style="display:flex; align-items:center; gap:0.5rem; white-space:nowrap;">
                                        @if (esActual) { <span style="color:#16a34a; font-size:0.75rem; font-weight:700;">✓ actual</span> }
                                        else { <span style="color:#2563eb; font-size:0.75rem; font-weight:700;">Elegir →</span> }
                                        <button class="btn-icon btn-delete" style="font-size:0.8rem; color:#dc2626;"
                                                @onclick="() => DeleteFavorito(f)" @onclick:stopPropagation="true"
                                                title="Eliminar este favorito">🗑</button>
                                    </div>
                                </div>
                            }
                        </div>
                        <p style="font-size:0.68rem; color:#9ca3af; margin:0.3rem 0 0;">🗑 borra el favorito de la lista (no toca el punto de partida ya guardado).</p>
                    }
                </div>

                <div style="text-align:center; color:#9ca3af; font-size:0.72rem; margin:0.3rem 0;">— o buscá una dirección nueva —</div>

                <div class="form-group">
                    <label class="form-label">🔍 Buscar dirección</label>
                    <div style="display:flex; gap:0.4rem;">
                        <input class="form-input" @bind="geocodeQuery" placeholder="Calle 123, Ciudad, Provincia" @onkeydown="OnGeocodeKey" style="flex:1;" />
                        <button class="btn btn-secondary" @onclick="DoGeocode" disabled="@geocoding">@(geocoding ? "..." : "🔍")</button>
                    </div>
                    <p style="font-size:0.7rem; color:#6b7280; margin:0.2rem 0 0;">Buscamos con Google Maps. Tocá el resultado correcto para fijarlo.</p>
                </div>
                @if (geocodeResults is not null && geocodeResults.Count > 0)
                {
                    <div style="border:1px solid #e5e7eb; border-radius:6px; max-height:160px; overflow-y:auto; margin-bottom:0.5rem;">
                        @foreach (var r in geocodeResults)
                        {
                            <div style="padding:0.4rem 0.6rem; border-bottom:1px solid #f3f4f6; cursor:pointer; font-size:0.8rem;"
                                 @onclick="() => PickGeocode(r)" title="Usar esta dirección">
                                <strong>@r.DisplayName</strong>
                                <div style="font-size:0.7rem; color:#9ca3af;">@r.Lat.ToString("0.######") , @r.Lng.ToString("0.######")</div>
                            </div>
                        }
                    </div>
                }
                @if (StartHasCoords)
                {
                    <div style="background:#f0fdf4; border:1px solid #bbf7d0; border-radius:8px; padding:0.6rem; margin-bottom:0.6rem;">
                        <div style="font-size:0.8rem; color:#166534; margin-bottom:0.5rem;">
                            ✅ <strong>Ubicación elegida.</strong> Confirmá abajo con la foto que sea el lugar correcto.
                        </div>
                        <img src="@StreetViewUrl" alt="Street View del punto de partida"
                             style="width:100%; border-radius:6px; display:block; background:#e5e7eb; min-height:120px; object-fit:cover;"
                             onerror="this.style.display='none'; var n=this.nextElementSibling; if(n) n.style.display='block';" />
                        <div style="display:none; font-size:0.78rem; color:#92400e; background:#fffbeb; border:1px solid #fde68a; border-radius:6px; padding:0.4rem; margin-top:0.3rem;">
                            📷 No hay foto de Street View en este punto exacto. Igual podés guardarlo, o abrir el mapa para chequearlo.
                        </div>
                        <a href="@StreetViewLink" target="_blank" rel="noopener"
                           style="display:inline-block; margin-top:0.5rem; font-size:0.8rem; color:#2563eb; text-decoration:none;">
                            🔍 Abrir en Google Street View (para mirar alrededor)
                        </a>
                    </div>
                }
                <div class="form-group">
                    <label class="form-label">Nombre / dirección a guardar</label>
                    <input class="form-input" @bind="formStartAddress" placeholder="Ej: DEPOSITO" />
                    @if (StartHasCoords)
                    {
                        <p style="font-size:0.68rem; color:#9ca3af; margin:0.2rem 0 0;">Coordenadas fijadas automáticamente (@formStartLat , @formStartLng).</p>
                    }
                    else
                    {
                        <p style="font-size:0.7rem; color:#b45309; margin:0.2rem 0 0;">👆 Buscá la dirección arriba y tocá el resultado correcto para fijar el punto.</p>
                    }
                </div>
            </div>
            <div class="modal-footer">
                <button class="btn btn-secondary" @onclick="ClearStartPoint" disabled="@savingStartPoint">Borrar</button>
                <button class="btn btn-secondary" @onclick="CloseStartPointModal" disabled="@savingStartPoint">Cancelar</button>
                <button class="btn btn-primary" @onclick="SaveStartPoint" disabled="@savingStartPoint">
                    @(savingStartPoint ? "Guardando..." : "Guardar")
                </button>
            </div>
        </div>
    </div>
}

@if (showDetail && selected is not null)
{
    <div class="modal-overlay" @onclick="() => showDetail = false">
        <div class="modal-card modal-small" @onclick:stopPropagation="true">
            <div class="modal-header">
                <h3 style="margin:0;">📦 Envío @selected.MeliShipmentId</h3>
                <button class="btn-close" @onclick="() => showDetail = false">&times;</button>
            </div>
            <div class="modal-body" style="font-size:0.88rem;">
                @if (selected.MeliOrderId.HasValue || !string.IsNullOrEmpty(selected.BuyerNickname))
                {
                    <div style="background:#f0f9ff; border:1px solid #bfdbfe; padding:0.4rem 0.6rem; border-radius:6px; margin-bottom:0.5rem; font-size:0.82rem; display:flex; gap:0.5rem; flex-wrap:wrap;">
                        @if (!string.IsNullOrEmpty(selected.BuyerNickname))
                        {
                            <span class="copy-chip" title="Click: copiar nickname"
                                  @onclick="@(e => CopyValue(selected.BuyerNickname!, "Comprador"))">
                                👤 <strong>@selected.BuyerNickname</strong> 📋
                            </span>
                        }
                        @if (selected.MeliOrderId.HasValue)
                        {
                            <span class="copy-chip" title="Click: copiar N° de venta" style="font-family:monospace;"
                                  @onclick="@(e => CopyValue(selected.MeliOrderId.Value.ToString(), "N° venta"))">
                                🧾 <strong>@selected.MeliOrderId.Value</strong> 📋
                            </span>
                        }
                    </div>
                }
                <p><strong>@(selected.ReceiverName ?? "—")</strong></p>
                <p style="color:#4b5563; margin:0.2rem 0;">@selected.AddressLine</p>
                <p style="color:#6b7280; font-size:0.78rem; margin:0;">
                    @selected.Neighborhood @(string.IsNullOrEmpty(selected.Neighborhood) ? "" : "·") @selected.City · @selected.State · CP @selected.ZipCode
                </p>
                @if (!string.IsNullOrEmpty(selected.ReceiverPhone))
                {
                    var tel = selected.ReceiverPhone!;
                    var digits = new string(tel.Where(char.IsDigit).ToArray());
                    <p style="margin:0.4rem 0;"><strong>📞 Tel:</strong>
                        <a href="@($"https://wa.me/{digits}")" target="_blank" style="color:#25D366; font-weight:700;">@tel (WhatsApp)</a>
                        · <a href="@($"tel:{digits}")" style="color:#185fa5; font-weight:600;">Llamar</a>
                    </p>
                }
                else
                {
                    <div style="margin:0.4rem 0;">
                        <button style="background:#fff3cd; border:1px solid #ffe08a; color:#7a5c00; font-weight:600; padding:0.35rem 0.6rem; border-radius:6px; cursor:pointer;"
                                @onclick="() => TraerTelefono(selected)" disabled="@trayendoTel">
                            @(trayendoTel ? "Consultando a MeLi..." : "📞 Traer teléfono de MeLi")
                        </button>
                        <div style="font-size:0.72rem; color:#9ca3af; margin-top:0.2rem;">MeLi esconde el teléfono hasta que el envío avanza. Apretá para pedírselo ahora.</div>
                    </div>
                }
                @if (!string.IsNullOrEmpty(selected.Comment))
                {
                    <p style="background:#fef3c7; border-left:3px solid #d97706; padding:0.4rem 0.6rem; margin:0.4rem 0; font-size:0.82rem;">
                        💬 <strong>Comentario del comprador:</strong> @selected.Comment
                    </p>
                }
                <p style="margin:0.4rem 0;"><strong>Items:</strong> @(selected.ItemsSummary ?? "—")</p>
                @if (selected.OrderTotal.HasValue)
                { <p style="margin:0.2rem 0;"><strong>Total:</strong> $@selected.OrderTotal.Value.ToString("N0", System.Globalization.CultureInfo.GetCultureInfo("es-AR"))</p> }
                <p style="margin:0.2rem 0;"><strong>Tracking:</strong> @(selected.TrackingNumber ?? "—")</p>
                <p style="margin:0.2rem 0;"><strong>Estado MeLi:</strong> @selected.Status / @(selected.Substatus ?? "—")</p>

                <hr style="margin:0.7rem 0;" />

                <div class="form-group">
                    <label class="form-label">Estado interno (lo controlas vos)</label>
                    <select class="form-input" @bind="selected.InternalStatus">
                        <option value="pending">Pendiente</option>
                        <option value="en_ruta">En ruta</option>
                        <option value="entregado">Entregado</option>
                        <option value="no_encontrado">No encontrado</option>
                        <option value="reprogramado">Reprogramado</option>
                    </select>
                </div>
                <div class="form-group">
                    <label class="form-label">Notas internas</label>
                    <textarea class="form-input" rows="2" @bind="selected.Notes" placeholder="Ej: tocar timbre 3 veces, dejar en portería..."></textarea>
                </div>
            </div>
            <div class="modal-footer">
                <button class="btn btn-secondary" @onclick="() => showDetail = false">Cancelar</button>
                <button class="btn btn-primary" @onclick="GuardarEstadoInterno" disabled="@isSavingDetail">
                    @(isSavingDetail ? "Guardando..." : "Guardar")
                </button>
            </div>
        </div>
    </div>
