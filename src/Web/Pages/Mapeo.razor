    // Lo llama el JS cada vez que el escáner físico lee una etiqueta (código crudo del QR).
    // Usa el mismo cerebro que el escaneo con el celu: reconoce venta / alquiler / MercadoLibre.
    [JSInvokable]
    public async Task OnWedgeScan(string code)
    {
        if (!wedgeOn || wedgeBusy || string.IsNullOrWhiteSpace(code)) return;
        wedgeBusy = true;
        try
        {
            var res = await Api.ScanFlexAsync(code.Trim());
            var ok = res?.Ok ?? false;
            var yaEstaba = res?.YaEstaba ?? false;
            try { await JS.InvokeVoidAsync("scanBeep", ok); } catch { }
            if (ok && !yaEstaba)
            {
                wedgeCount++;
                await LoadStops();
                await RenderMap(keepView: true);
                ToastService.Success($"✓ {(string.IsNullOrWhiteSpace(res?.Nombre) ? "Parada" : res!.Nombre)} agregada.");
            }
            else if (ok && yaEstaba)
            {
                ToastService.Info($"↻ {(string.IsNullOrWhiteSpace(res?.Nombre) ? "Esa parada" : res!.Nombre)} ya estaba en el mapa.");
            }
            else
            {
                ToastService.Error(string.IsNullOrWhiteSpace(res?.Mensaje) ? "No pude leer ese código." : res!.Mensaje!);
