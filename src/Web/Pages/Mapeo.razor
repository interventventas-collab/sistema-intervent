    private void LimpiarSeleccionRuta() => rutaSeleccion.Clear();

    private static string AddrFromGroup(GrupoUnificado g)
    {
        // Estrategia (cambiada 2026-05-20 por pedido del usuario): PREFERIR siempre el texto
        // calle + localidad sobre las coordenadas. Las coords son precisas pero Google las
        // reverse-geocodea y muestra el negocio mas cercano (ej: "Apartamentos Boutique BA"
        // en lugar de "Costa Rica 1234"). El texto le da a Google un formato que respeta
        // mas seguido. Solo caemos a coords si NO hay texto.
        const string CONTEXTO_DEFAULT = "Buenos Aires, Argentina";

        if (g.Flex.Count > 0)
        {
            var s = g.Flex.First();
            if (!string.IsNullOrWhiteSpace(s.AddressLine) && !ParecenCoordenadas(s.AddressLine))
            {
                var city = !string.IsNullOrWhiteSpace(s.City) ? s.City : CONTEXTO_DEFAULT;
                return BuildMapsAddress(s.AddressLine, city);
            }
            // Fallback a coords solo si NO hay texto
            if (s.Latitude.HasValue && s.Longitude.HasValue && (s.Latitude.Value != 0 || s.Longitude.Value != 0))
            {
                var coord = $"{s.Latitude.Value.ToString(System.Globalization.CultureInfo.InvariantCulture)},{s.Longitude.Value.ToString(System.Globalization.CultureInfo.InvariantCulture)}";
                return Uri.EscapeDataString(coord);
            }
            return Uri.EscapeDataString(s.City ?? CONTEXTO_DEFAULT);
        }
        else
        {
            var st = g.Manual.First();
            if (!string.IsNullOrWhiteSpace(st.Direccion) && !ParecenCoordenadas(st.Direccion))
            {
                var loc = !string.IsNullOrWhiteSpace(st.Localidad) ? st.Localidad : CONTEXTO_DEFAULT;
                return BuildMapsAddress(st.Direccion, loc);
            }
            // Fallback a coords solo si NO hay texto
            if (st.Latitude != 0 && st.Longitude != 0)
            {
                var coord = $"{st.Latitude.ToString(System.Globalization.CultureInfo.InvariantCulture)},{st.Longitude.ToString(System.Globalization.CultureInfo.InvariantCulture)}";
                return Uri.EscapeDataString(coord);
            }
            return Uri.EscapeDataString(st.Localidad ?? CONTEXTO_DEFAULT);
        }
    }

    /// <summary>Limpia la direccion + localidad para que Google Maps la respete como TEXTO
    /// (en vez de reverse-geocodearla al negocio mas cercano). Quita codigos postales
    /// argentinos (C1234FFF o 1234), agrega "Argentina" como contexto y deja un formato
    /// estandar: "{calle + numero}, {localidad}, Argentina". Pedido del usuario 2026-05-20.</summary>
    private static string BuildMapsAddress(string direccion, string localidad)
    {
        // 1) Limpiar postal code argentino del final de la direccion. Patrones:
        //    "Costa Rica 1234, C1234FFF" → "Costa Rica 1234"
        //    "Calle X 5678, 1234"        → "Calle X 5678"
        var dir = System.Text.RegularExpressions.Regex.Replace(
            direccion,
            @"\s*,?\s*C\d{4}[A-Z]{0,3}\s*$|\s*,?\s*\d{4}(?=\s*$)",
            "",
            System.Text.RegularExpressions.RegexOptions.IgnoreCase
        ).Trim().TrimEnd(',').Trim();

        // 2) Localidad — sacar postal code si tambien lo tiene
        var loc = System.Text.RegularExpressions.Regex.Replace(
            localidad,
            @"\s*,?\s*C\d{4}[A-Z]{0,3}\s*$|\s*,?\s*\d{4}(?=\s*$)",
            "",
            System.Text.RegularExpressions.RegexOptions.IgnoreCase
        ).Trim().TrimEnd(',').Trim();

        // 3) Asegurar contexto pais para que Google no resuelva a otro pais (ej "Costa Rica")
        var sufijoArg = ", Argentina";
        if (loc.IndexOf("argentina", StringComparison.OrdinalIgnoreCase) >= 0) sufijoArg = "";

        var final = $"{dir}, {loc}{sufijoArg}".Trim();
        return Uri.EscapeDataString(final);
    }

    /// <summary>
    /// Construye una "address string" lista para Google Maps a partir de una parada del Mapeo
    /// (no de un envío Flex). PREFERIMOS TEXTO sobre coords (mismo motivo que AddrFromGroup).
    /// </summary>
    private static string AddrFromStop(MapeoStopDto st)
    {
        const string CONTEXTO_DEFAULT = "Buenos Aires, Argentina";
        if (!string.IsNullOrWhiteSpace(st.Direccion) && !ParecenCoordenadas(st.Direccion))
        {
            var loc = !string.IsNullOrWhiteSpace(st.Localidad) ? st.Localidad : CONTEXTO_DEFAULT;
            return BuildMapsAddress(st.Direccion, loc);
        }
        // Fallback a coords solo si NO hay texto
        if (st.Latitude != 0 && st.Longitude != 0)
        {
            var coord = $"{st.Latitude.ToString(System.Globalization.CultureInfo.InvariantCulture)},{st.Longitude.ToString(System.Globalization.CultureInfo.InvariantCulture)}";
            return Uri.EscapeDataString(coord);
        }
        return Uri.EscapeDataString(st.Localidad ?? CONTEXTO_DEFAULT);
    }

    /// <summary>
    /// Devuelve la URL de Google Maps con LAS paradas de un chofer puntual, en el orden ya cargado
    /// (OrderInRoute ascendente, luego Id). Usa el formato path-based para no tener tope de 10.
    /// Si la URL queda muy larga (browser limit), la trunca a las primeras paradas que entren.
    /// </summary>
    /// <summary>
    /// Arma un mensaje de WhatsApp largo con cada parada del chofer en orden + link
    /// individual de Google Maps por parada. Ideal para que el chofer abra el mapa
    /// de a una sin perderse en una ruta enorme.
    /// </summary>
    private string BuildWhatsAppDetallado(int driverId, string driverNombre)
    {
        if (stops is null) return "";
        var driverStops = stops
            .Where(s => s.AssignedDriverId == driverId)
            .OrderBy(s => s.OrderInRoute ?? int.MaxValue)
            .ThenBy(s => s.Id)
            .ToList();
        if (driverStops.Count == 0) return "";

        var sb = new System.Text.StringBuilder();
        sb.AppendLine($"Hola {driverNombre}! Tu ruta de hoy ({driverStops.Count} paradas):");
        sb.AppendLine();
        int idx = 1;
        foreach (var st in driverStops)
        {
            var nombre = !string.IsNullOrWhiteSpace(st.Alias) ? st.Alias
                       : (!string.IsNullOrWhiteSpace(st.ContactName) ? st.ContactName : "Parada");
            // Link individual de Maps: preferimos coords si las tiene (siempre funcionan),
            // sino direccion + localidad como query.
            string mapsUrl;
            if (st.Latitude != 0 && st.Longitude != 0)
            {
                var lat = st.Latitude.ToString(System.Globalization.CultureInfo.InvariantCulture);
                var lng = st.Longitude.ToString(System.Globalization.CultureInfo.InvariantCulture);
                mapsUrl = $"https://www.google.com/maps/search/?api=1&query={lat},{lng}";
            }
            else if (!string.IsNullOrWhiteSpace(st.Direccion))
            {
                var q = Uri.EscapeDataString((st.Direccion + " " + (st.Localidad ?? "")).Trim());
                mapsUrl = $"https://www.google.com/maps/search/?api=1&query={q}";
            }
            else
            {
                mapsUrl = "";
            }

            sb.AppendLine($"{idx}. 📍 {nombre}");
            if (!string.IsNullOrWhiteSpace(st.Direccion))
                sb.AppendLine($"   {st.Direccion}{(string.IsNullOrEmpty(st.Localidad) ? "" : ", " + st.Localidad)}");
            if (!string.IsNullOrWhiteSpace(st.Telefono))
                sb.AppendLine($"   📞 {st.Telefono}");
            if (!string.IsNullOrWhiteSpace(st.Notas))
                sb.AppendLine($"   📝 {st.Notas}");
            if (!string.IsNullOrEmpty(mapsUrl))
                sb.AppendLine($"   🗺 {mapsUrl}");
            sb.AppendLine();
            idx++;
        }
        return sb.ToString().TrimEnd();
    }

    private string BuildGmapsRouteUrlForDriver(int driverId)
    {
        if (stops is null) return "#";
        var driverStops = stops
            .Where(s => s.AssignedDriverId == driverId)
            .OrderBy(s => s.OrderInRoute ?? int.MaxValue)
            .ThenBy(s => s.Id)
            .ToList();
        if (driverStops.Count == 0) return "#";

        const int MAX_URL_LEN = 1800;
        const string BASE = "https://www.google.com/maps/dir/";
        var direcciones = driverStops.Select(AddrFromStop).ToList();
        var chunk = new List<string>();
        int len = BASE.Length;
        foreach (var d in direcciones)
        {
            int addLen = d.Length + 1;
            if (chunk.Count >= 2 && len + addLen > MAX_URL_LEN) break;
            chunk.Add(d);
            len += addLen;
        }
        return BASE + string.Join("/", chunk) + "/";
    }

    /// <summary>
    /// Arma la(s) URL(s) de ruta para Google Maps usando el formato "path-based"
    /// (https://www.google.com/maps/dir/A/B/C/...) que NO tiene tope de 10 paradas como el formato ?api=1.
    /// Si la URL resultante supera ~1800 chars (límite seguro de browsers), parte en TRAMOS
    /// encadenados — cada tramo arranca con la última parada del tramo anterior, así el chofer
    /// nunca pierde continuidad. Devuelve una lista de tramos con label legible y URL.
    /// </summary>
    private List<(string Label, string Url, int Desde, int Hasta)> BuildGmapsRouteTramos()
    {
        var tramos = new List<(string, string, int, int)>();
        if (rutaSeleccion.Count == 0) return tramos;
        var lista = BuildListaUnificada();
        var seleccionados = lista.Where(g => rutaSeleccion.Contains(g.Key)).ToList();
        if (seleccionados.Count == 0) return tramos;

        var direcciones = seleccionados.Select(AddrFromGroup).ToList();
        const int MAX_URL_LEN = 1800;
        const string BASE = "https://www.google.com/maps/dir/";

        int i = 0;
        int tramoNum = 1;
        while (i < direcciones.Count)
        {
            var chunk = new List<string>();
            int len = BASE.Length;
            int startIdx = i;
            while (i < direcciones.Count)
            {
                int addLen = direcciones[i].Length + 1; // + "/"
                if (chunk.Count >= 2 && len + addLen > MAX_URL_LEN) break;
                chunk.Add(direcciones[i]);
                len += addLen;
                i++;
            }
            if (chunk.Count == 0) break;
            var url = BASE + string.Join("/", chunk) + "/";
            int endIdx = startIdx + chunk.Count - 1;
            var label = direcciones.Count <= chunk.Count
                ? "🗺 Abrir ruta"
                : $"🗺 Tramo {tramoNum} ({startIdx + 1}–{endIdx + 1})";
            tramos.Add((label, url, startIdx + 1, endIdx + 1));
            tramoNum++;
            // Encadenar: si quedan paradas, retrocedo 1 para que el próximo tramo
            // arranque con la última de éste como origen.
            if (i < direcciones.Count) i--;
        }
        return tramos;
    }

