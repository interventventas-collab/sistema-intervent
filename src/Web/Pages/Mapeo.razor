    // Mueve una parada de una posición a otra y guarda el nuevo orden (OrderInRoute = 1,2,3…).
    private async Task MoverEnRuta(int fromIdx, int toIdx)
    {
        if (reordenandoRuta) return;
        var ruta = RutaVisibleOrdenada();
        if (fromIdx < 0 || fromIdx >= ruta.Count || toIdx < 0 || toIdx >= ruta.Count || fromIdx == toIdx) return;
        reordenandoRuta = true;
        try
        {
            var item = ruta[fromIdx];
            ruta.RemoveAt(fromIdx);
            ruta.Insert(toIdx, item);
            var ids = ruta.SelectMany(x => x).ToList();
            if (ids.Count == 0) return;
            await Api.ReorderMapeoStopsAsync(ids);
            await LoadStops();
            await RenderMap();
            if (rutasResumen.Count > 0) await CargarYDibujarRutas(single: false); // redibuja la línea con el nuevo orden
        }
