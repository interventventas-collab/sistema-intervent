        {
            await DeleteStop(st);
        }
    }

    // Tope MUY alto: para un día de reparto 30 es ya muchísimo, pero permitimos hasta 30
    // porque la URL path-based de Google Maps soporta sin problemas ese rango.
    private const int MaxParadasRuta = 30;

    private void ToggleRutaSeleccion(string groupKey)
    {
        if (rutaSeleccion.Contains(groupKey))
            rutaSeleccion.Remove(groupKey);
        else if (rutaSeleccion.Count < MaxParadasRuta)
            rutaSeleccion.Add(groupKey);
