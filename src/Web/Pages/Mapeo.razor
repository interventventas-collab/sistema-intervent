    // Prende/apaga el modo guiado. Al entrar, saca la línea vieja; al salir, la vuelve a dibujar.
    private async Task ToggleModoGuiada()
    {
        if (!modoGuiada)
        {
            var hayZonas = (stops ?? new()).Any(s => s.AssignedDriverId.HasValue || s.AssignedVehicleSlot.HasValue);
            if (!hayZonas)
            {
                ToastService.Info("Primero armá las zonas (dibujá una zona y creala). Después armás el orden de cada una.");
                return;
            }
            modoGuiada = true;
            modoOrden = false;
            modoAsignacion = false;
            guiadaPrimeraId = null; guiadaUltimaId = null; guiadaFijasMedio.Clear();
            rutasResumen = new();
            try { await JS.InvokeVoidAsync("mapeoFlex.clearRoutes"); } catch { }
            // Si tocaste el cuadradito de una zona antes de entrar, mostramos SOLO esa zona (para no
            // mezclar con las otras). Guardamos qué se veía para restaurarlo al salir.
            ordenBackupZonasOcultas = new HashSet<int>(zonasOcultasMapa);
            ordenBackupSinAsignar = sinAsignarOcultos;
            if (ordenDriverId.HasValue && (stops ?? new()).Any(s => s.AssignedDriverId == ordenDriverId))
            {
                MostrarSoloZonaOrden(ordenDriverId.Value);
                await RenderMap();
                await FocoZonaDriver(ordenDriverId.Value);
            }
            else
            {
                await RenderMap();
            }
        }
        else
        {
            modoGuiada = false;
            // Restauramos lo que se veía antes de entrar al modo guiado.
            zonasOcultasMapa = new HashSet<int>(ordenBackupZonasOcultas);
            sinAsignarOcultos = ordenBackupSinAsignar;
            await RenderMap();
            await CargarYDibujarRutas(single: false);
        }
        StateHasChanged();
    }

    // ═════════ Armar ruta INTERACTIVA (estilo Google Maps): pinchar punto por punto ═════════
    // Formatea segundos como "45 min" o "1h 20min".
    private static string FmtDuracion(int segundos)
    {
        int min = (int)Math.Round(segundos / 60.0);
        if (min < 60) return min + " min";
        int h = min / 60, mm = min % 60;
        return mm > 0 ? $"{h}h {mm}min" : $"{h}h";
    }

    private async Task ToggleModoArmar()
    {
        if (!modoArmar)
        {
            if ((stops?.Count ?? 0) == 0 && (shipments?.Count ?? 0) == 0)
            { ToastService.Info("Primero sumá envíos al mapa (escaneá o importá Flex)."); return; }
            // Entrar: apagamos los otros modos para no pisarnos.
            modoArmar = true;
            modoOrden = false; modoGuiada = false; modoAsignacion = false;
            if (dibujandoZona) { try { await JS.InvokeVoidAsync("mapeoFlex.cancelDrawZone"); } catch { } dibujandoZona = false; }
            armarCount = 0; armarTotalSec = 0; armarTotalMetros = 0; armarDesdeDeposito = false;
            armarDepotLat = null; armarDepotLng = null;
            // Traemos el punto de partida (depósito) por si el usuario quiere arrancar desde ahí.
            try
            {
                var sp = await Api.GetMapeoStartPointAsync();
