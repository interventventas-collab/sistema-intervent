@page "/integraciones/camaras"
@attribute [Authorize]
@inject ApiClient Api
@inject ToastService ToastService
@inject IJSRuntime JS
@implements IAsyncDisposable

<PageTitle>Cámaras</PageTitle>

<div class="page-container" style="max-width:1100px;">
    <div style="display:flex;align-items:center;gap:0.6rem;margin-bottom:0.4rem;">
        <span style="font-size:1.6rem;">📹</span>
        <h1 style="margin:0;">Cámaras</h1>
    </div>
    <p style="color:#64748b;margin-top:0;">
        Las cámaras EZVIZ acá adentro, sin abrir la app del celular.
    </p>

    @if (loading)
    {
        <p style="color:#94a3b8;">Cargando…</p>
    }
    else
    {
        @if (account is null || !account.HasCredentials || verClaves)
        {
            <!-- ─────────── Claves de la cuenta de desarrollador (se cargan una vez) ─────────── -->
            <div style="padding:1rem 1.2rem;margin-bottom:1.2rem;border:1px solid #e2e8f0;border-radius:10px;background:#fff;">
                <h3 style="margin:0 0 0.4rem;">Claves de EZVIZ</h3>
                <p style="color:#64748b;font-size:0.9rem;margin:0 0 0.8rem;">
                    El <b>appKey</b> y el <b>appSecret</b> de la web de desarrolladores de EZVIZ (isaopen.ezviz.com → Account Settings → Appkey management).
                </p>
                <div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(260px,1fr));gap:0.8rem;">
                    <div>
                        <label style="font-weight:600;font-size:0.85rem;">appKey</label>
                        <input @bind="appKey" placeholder="@(account?.HasCredentials == true ? "•••• (ya guardado)" : "")" class="form-control" style="width:100%;" />
                    </div>
                    <div>
                        <label style="font-weight:600;font-size:0.85rem;">appSecret</label>
                        <input @bind="appSecret" type="password" placeholder="@(account?.HasCredentials == true ? "•••• (ya guardado)" : "")" class="form-control" style="width:100%;" />
                    </div>
                    <div>
                        <label style="font-weight:600;font-size:0.85rem;">Región</label>
                        <select @bind="apiHost" class="form-control" style="width:100%;">
                            <option value="https://isaopen.ezvizlife.com">Sudamérica</option>
                            <option value="https://open.ezvizlife.com">Global</option>
                            <option value="https://ieuopen.ezvizlife.com">Europa</option>
                            <option value="https://iusopen.ezviz.com">EE.UU.</option>
                        </select>
                    </div>
                </div>
                <div style="display:flex;align-items:center;gap:0.8rem;margin-top:0.8rem;flex-wrap:wrap;">
                    <button class="btn btn-primary" @onclick="Guardar" disabled="@saving">@(saving ? "Guardando…" : "Guardar claves")</button>
                    @if (account?.HasCredentials == true)
                    {
                        <button class="btn btn-secondary" @onclick="Probar" disabled="@probando">@(probando ? "Probando…" : "Probar claves")</button>
                        <button class="btn btn-secondary" @onclick="() => verClaves = false">Cerrar</button>
                    }
                </div>
            </div>
        }

        @if (account is not null && account.HasCredentials)
        {
            <!-- ─────────── Permiso para ver las cámaras de la cuenta de la app ─────────── -->
            <div style="padding:1rem 1.2rem;margin-bottom:1.2rem;border:1px solid #e2e8f0;border-radius:10px;background:#fff;">
                <div style="display:flex;align-items:center;justify-content:space-between;gap:0.8rem;flex-wrap:wrap;">
                    <div>
                        <b>Permiso para ver las cámaras</b> ·
                        @if (account.UsuarioAutorizado)
                        {
                            <span>vigente hasta el @account.UserTokenExpiresAt!.Value.ToArTime().ToString("dd/MM HH:mm")</span>
                        }
                        else if (account.UserTokenExpiresAt.HasValue)
                        {
                            <span style="color:#b91c1c;font-weight:600;">venció el @account.UserTokenExpiresAt.Value.ToArTime().ToString("dd/MM HH:mm") — hay que renovarlo</span>
                        }
                        else
                        {
                            <span style="color:#b91c1c;font-weight:600;">falta darlo</span>
                        }
                    </div>
                    <div style="display:flex;gap:0.5rem;">
                        <button class="btn btn-secondary btn-sm" @onclick="() => verAutorizar = !verAutorizar">
                            @(account.UsuarioAutorizado ? "Renovar permiso" : "Dar permiso")
                        </button>
                        <button class="btn btn-secondary btn-sm" @onclick="() => verClaves = !verClaves" title="appKey / appSecret">⚙ Claves</button>
                    </div>
                </div>

                @if (verAutorizar || !account.UsuarioAutorizado)
                {
                    <ol style="margin:0.8rem 0 0;padding-left:1.2rem;color:#334155;line-height:1.7;">
                        <li>
                            Abrí la página de EZVIZ y entrá con el usuario y clave de la <b>app de las cámaras</b>:
                            <a href="@account.AuthUrl" target="_blank" rel="noopener" class="btn btn-primary btn-sm" style="margin-left:0.3rem;">Abrir EZVIZ ↗</a>
                        </li>
                        <li>Cuando diga <b>"Authorization Succeeded"</b>, copiá la dirección entera de esa pestaña (la barra de arriba).</li>
                        <li>
                            Pegala acá:
                            <div style="display:flex;gap:0.5rem;margin-top:0.3rem;flex-wrap:wrap;">
                                <input @bind="linkAutorizacion" placeholder="https://openauth.ezvizlife.com/oauth/success#access_token=…"
                                       class="form-control" style="flex:1;min-width:260px;" />
                                <button class="btn btn-primary" @onclick="Autorizar" disabled="@(autorizando || string.IsNullOrWhiteSpace(linkAutorizacion))">
                                    @(autorizando ? "Probando…" : "Guardar permiso")
                                </button>
                            </div>
                        </li>
                    </ol>
                    <small style="color:#94a3b8;display:block;margin-top:0.4rem;">EZVIZ da el permiso por 7 días. Cuando vence, se repiten estos 3 pasos.</small>
                }
            </div>

            @if (account.UsuarioAutorizado)
            {
                <!-- ─────────── Grilla de cámaras ─────────── -->
                <div style="display:flex;align-items:center;justify-content:space-between;margin-bottom:0.8rem;">
                    <h3 style="margin:0;">@camaras.Count cámaras</h3>
                    <button class="btn btn-secondary btn-sm" @onclick="FotosDeTodas" disabled="@(cargandoCamaras || camaras.Count == 0)">📸 Foto de todas</button>
                </div>

                @if (cargandoCamaras)
                {
                    <p style="color:#94a3b8;">Buscando cámaras…</p>
                }
                else if (!string.IsNullOrEmpty(camarasError))
                {
                    <p style="color:#b91c1c;">No se pudieron traer las cámaras: @camarasError</p>
                }
                else if (camaras.Count == 0)
                {
                    <p style="color:#64748b;">No aparecen cámaras con este permiso.</p>
                }
                else
                {
                    <div style="display:grid;grid-template-columns:repeat(auto-fill,minmax(300px,1fr));gap:1rem;">
                        @foreach (var cam in camaras)
                        {
                            var foto = fotos.GetValueOrDefault(cam.DeviceSerial);
                            var sacando = sacandoFoto.Contains(cam.DeviceSerial);
                            <div style="border:1px solid #e2e8f0;border-radius:10px;overflow:hidden;background:#fff;">
                                <div style="position:relative;aspect-ratio:16/9;background:#0f172a;display:flex;align-items:center;justify-content:center;cursor:@(foto is null ? "default" : "zoom-in");"
                                     @onclick="() => { if (foto is not null) fotoGrande = foto; }">
                                    @if (foto is not null)
                                    {
                                        <img src="@foto" alt="@cam.Nombre" style="width:100%;height:100%;object-fit:cover;" />
                                    }
                                    else
                                    {
                                        <span style="color:#64748b;font-size:0.85rem;">@(sacando ? "Sacando foto…" : (cam.Online ? "Sin foto" : "Desconectada"))</span>
                                    }
                                    @if (sacando && foto is not null)
                                    {
                                        <span style="position:absolute;bottom:6px;right:8px;color:#fff;font-size:0.75rem;background:rgba(0,0,0,0.55);padding:0.1rem 0.4rem;border-radius:4px;">actualizando…</span>
                                    }
                                </div>
                                <div style="padding:0.6rem 0.8rem;">
                                    <div style="display:flex;justify-content:space-between;align-items:baseline;gap:0.5rem;">
                                        <b style="white-space:nowrap;overflow:hidden;text-overflow:ellipsis;">@(string.IsNullOrWhiteSpace(cam.Nombre) ? cam.DeviceSerial : cam.Nombre)</b>
                                        @if (!cam.Online)
                                        {
                                            <span style="color:#b91c1c;font-size:0.8rem;white-space:nowrap;">desconectada</span>
                                        }
                                    </div>
                                    @if (fotoError.TryGetValue(cam.DeviceSerial, out var fe))
                                    {
                                        <div style="color:#b91c1c;font-size:0.8rem;">@fe</div>
                                    }
                                    <div style="display:flex;gap:0.5rem;margin-top:0.5rem;">
                                        <button class="btn btn-secondary btn-sm" style="flex:1;" @onclick="() => SacarFoto(cam)" disabled="@(sacando || !cam.Online)">📸 Foto ahora</button>
                                        @if (!cam.Encriptada)
                                        {
                                            <button class="btn btn-primary btn-sm" style="flex:1;" @onclick="() => VerEnVivo(cam)" disabled="@(!cam.Online)">▶ En vivo</button>
                                        }
                                    </div>
                                    @if (cam.Encriptada)
                                    {
                                        <small style="color:#94a3b8;display:block;margin-top:0.3rem;">Encriptada: solo foto (EZVIZ no da el video en vivo de las encriptadas).</small>
                                    }
                                </div>
                            </div>
                        }
                    </div>
                }
            }
        }
    }
</div>

@if (fotoGrande is not null)
{
    <div style="position:fixed;inset:0;background:rgba(0,0,0,0.85);z-index:2000;display:flex;align-items:center;justify-content:center;padding:1rem;cursor:zoom-out;"
         @onclick="() => fotoGrande = null">
        <img src="@fotoGrande" style="max-width:100%;max-height:100%;border-radius:6px;" />
    </div>
}

<!-- ─────────── Video en vivo ─────────── -->
@if (liveOpen)
{
    <div style="position:fixed;inset:0;background:rgba(0,0,0,0.75);z-index:2000;display:flex;align-items:center;justify-content:center;padding:1rem;"
         @onclick="CerrarVivo">
        <div style="background:#111827;border-radius:12px;max-width:900px;width:100%;overflow:hidden;" @onclick:stopPropagation="true">
            <div style="display:flex;align-items:center;justify-content:space-between;padding:0.7rem 1rem;color:#fff;">
                <span style="font-weight:600;">@(camActiva?.Nombre ?? camActiva?.DeviceSerial) · en vivo</span>
                <button class="btn btn-sm" style="background:#374151;color:#fff;" @onclick="CerrarVivo">✕ Cerrar</button>
            </div>
            <div style="padding:0 1rem 1rem;">
                <video id="ezviz-video" data-ezviz controls muted autoplay playsinline
                       style="width:100%;aspect-ratio:16/9;background:#000;border-radius:6px;"></video>
                @if (!string.IsNullOrEmpty(liveError))
                {
                    <div style="color:#fca5a5;padding:0.8rem;text-align:center;">@liveError</div>
                }
            </div>
        </div>
    </div>
}

@code {
    private EzvizAccountDto? account;
    private bool loading = true, saving = false, probando = false, cargandoCamaras = false, autorizando = false;
    private bool verClaves = false, verAutorizar = false;

    private string appKey = "", appSecret = "", apiHost = "https://isaopen.ezvizlife.com";
    private string linkAutorizacion = "";

    private List<EzvizCamaraDto> camaras = new();
    private string? camarasError;
    private readonly Dictionary<string, string> fotos = new();
    private readonly Dictionary<string, string> fotoError = new();
    private readonly HashSet<string> sacandoFoto = new();
    private string? fotoGrande;

    private bool liveOpen = false;
    private EzvizCamaraDto? camActiva;
    private string? liveError;

    protected override async Task OnInitializedAsync()
    {
        await CargarCuenta();
        loading = false;
        if (account?.UsuarioAutorizado == true)
            await CargarCamarasYFotos();
    }

    private async Task CargarCuenta()
    {
        try
        {
            account = await Api.GetEzvizAccountAsync();
            if (account is not null && !string.IsNullOrWhiteSpace(account.ApiHost)) apiHost = account.ApiHost;
        }
        catch (Exception ex) { ToastService.Error("No se pudo leer la configuración: " + ex.Message); }
    }

    private async Task Guardar()
    {
        saving = true;
        try
        {
            var res = await Api.SaveEzvizAccountAsync(new SaveEzvizAccountRequest
            {
                AppKey = string.IsNullOrWhiteSpace(appKey) ? null : appKey.Trim(),
                AppSecret = string.IsNullOrWhiteSpace(appSecret) ? null : appSecret.Trim(),
                Alias = account?.Alias,
                IsActive = true,
                ApiHost = apiHost
            });
            if (res is not null)
            {
                account = res;
                appKey = appSecret = "";
                ToastService.Success("Claves guardadas.");
            }
        }
        catch (Exception ex) { ToastService.Error(ex.Message); }
        finally { saving = false; }
    }

    private async Task Probar()
    {
        probando = true;
        try
        {
            var res = await Api.ProbarEzvizAsync();
            if (res is not null && res.Ok) ToastService.Success("Las claves andan.");
            else ToastService.Error(res?.Error ?? "No se pudo conectar con EZVIZ.");
        }
        catch (Exception ex) { ToastService.Error(ex.Message); }
        finally { probando = false; }
    }

    private async Task Autorizar()
    {
        autorizando = true;
        try
        {
            var res = await Api.AutorizarEzvizAsync(linkAutorizacion);
            if (res is not null && res.Ok)
            {
                ToastService.Success($"Permiso guardado: se ven {res.Camaras} cámaras.");
                linkAutorizacion = "";
                verAutorizar = false;
                await CargarCuenta();
                await CargarCamarasYFotos();
            }
            else ToastService.Error(res?.Error ?? "No se pudo guardar el permiso.");
        }
        catch (Exception ex) { ToastService.Error(ex.Message); }
        finally { autorizando = false; }
    }

    private async Task CargarCamarasYFotos()
    {
        cargandoCamaras = true;
        camarasError = null;
        try { camaras = await Api.GetEzvizCamarasAsync(); }
        catch (Exception ex) { camarasError = ex.Message; camaras = new(); }
        finally { cargandoCamaras = false; }
        StateHasChanged();
        await FotosDeTodas();
    }

    private async Task FotosDeTodas()
        => await Task.WhenAll(camaras.Where(c => c.Online).Select(SacarFoto));

    private async Task SacarFoto(EzvizCamaraDto cam)
    {
        if (!sacandoFoto.Add(cam.DeviceSerial)) return;
        fotoError.Remove(cam.DeviceSerial);
        StateHasChanged();
        try
        {
            var r = await Api.FotoEzvizAsync(cam.DeviceSerial, cam.ChannelNo);
            if (r is not null && r.Ok && !string.IsNullOrEmpty(r.PicUrl)) fotos[cam.DeviceSerial] = r.PicUrl;
            else fotoError[cam.DeviceSerial] = r?.Error ?? "No se pudo sacar la foto.";
        }
        catch (Exception ex) { fotoError[cam.DeviceSerial] = ex.Message; }
        finally
        {
            sacandoFoto.Remove(cam.DeviceSerial);
            StateHasChanged();
        }
    }

    private async Task VerEnVivo(EzvizCamaraDto cam)
    {
        camActiva = cam;
        liveError = null;
        liveOpen = true;
        StateHasChanged();
        try
        {
            var live = await Api.GetEzvizLiveAsync(cam.DeviceSerial, cam.ChannelNo);
            if (live is null || !live.Ok || string.IsNullOrEmpty(live.Url))
            {
                liveError = live?.Error ?? "No se pudo abrir el video de esta cámara.";
                return;
            }
            await Task.Delay(50); // que el <video> ya esté en pantalla
            var problema = await JS.InvokeAsync<string>("ezvizPlayer.play", "ezviz-video", live.Url);
            if (!string.IsNullOrEmpty(problema)) liveError = problema;
        }
        catch (Exception ex) { liveError = ex.Message; }
    }

    private async Task CerrarVivo()
    {
        try { await JS.InvokeVoidAsync("ezvizPlayer.stop"); } catch { }
        liveOpen = false;
        camActiva = null;
        liveError = null;
    }

    public async ValueTask DisposeAsync()
    {
        try { await JS.InvokeVoidAsync("ezvizPlayer.stop"); } catch { }
    }
}
