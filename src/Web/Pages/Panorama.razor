@page "/panorama"
@attribute [Authorize]
@inject ApiClient Api
@inject IJSRuntime JS
@inject NavigationManager Nav
@inject ToastService Toast
@using System.Globalization
@using System.Text
@using Web.Models

@*
    2026-08-31 — PANORAMA: las 4 patas del negocio en una sola pantalla.
      · Intervent      → MercadoLibre
      · Intereventos   → alquiler de equipos
      · Frikaf         → café, venta directa
      · Logística      → reparto propio

    Todo llega en UNA sola llamada a /api/panorama, así cambiar de solapa de ranking es
    instantáneo. Cambiar el período sí vuelve a pedir (cambian todos los números).

    Criterio visual (pedido del dueño): texto plano separado por "·", sin cajitas de colores.
    El color se usa SOLO para dos cosas: identificar la pata en los gráficos, y marcar una
    alarma en rojo. Nada más.
*@

<div class="pan-wrap">

    <div class="pan-top">
        <div>
            <h2 class="pan-h1">Panorama</h2>
            <p class="pan-sub">
                @if (data is not null)
                {
                    <span>@data.Etiqueta · @data.Comparacion</span>
                }
                else
                {
                    <span>Las cuatro patas del negocio en una pantalla</span>
                }
            </p>
        </div>

        <div class="pan-pills" role="group" aria-label="Período">
            @foreach (var p in Periodos)
            {
                <button type="button" class="pan-pill @(periodo == p.Key ? "on" : "")"
                        aria-pressed="@(periodo == p.Key ? "true" : "false")"
                        disabled="@cargando"
                        @onclick="() => CambiarPeriodo(p.Key)">@p.Label</button>
            }
        </div>
    </div>

    @if (cargando && data is null)
    {
        <p class="pan-muted" style="padding:2rem 0;">Juntando los números de las cuatro patas…</p>
    }
    else if (error is not null)
    {
        <p class="pan-alarma" style="padding:1.5rem 0;">No se pudieron traer los números: @error</p>
    }
    else if (data is not null)
    {
        <div class="pan-patas @(cargando ? "pan-cargando" : "")">
            @foreach (var pata in data.Patas)
            {
                var col = ColorPata(pata.Clave);
                <div class="pan-pata" style="--pc:@col">
                    <div class="pan-pata-h">
                        <span class="pan-dot" style="background:@col"></span>
                        <strong>@pata.Nombre</strong>
                        <span class="pan-canal">@pata.Canal</span>
                    </div>

                    @* Logística no factura por ninguna tabla todavía: mostrarle "$0" sería mentirle.
                       Su número grande son las ENTREGAS, que sí se cuentan de verdad. *@
                    @if (pata.Clave == "lg")
                    {
                        <div class="pan-big">@Miles(pata.Operaciones)</div>
                        <div class="pan-line">entregas hechas con gente propia</div>
                        <div class="pan-line pan-muted">@pata.SinMargenPorque</div>
                    }
                    else
                    {
                        <div class="pan-big">@Plata(pata.Facturado)</div>

                        <div class="pan-line">
                            @if (pata.Facturado == 0)
                            {
                                <span class="pan-muted">sin movimiento en este período</span>
                            }
                            else if (pata.Margen is not null && pata.MargenPct is not null)
                            {
                                <span>deja @Plata(pata.Margen.Value)</span>
                                <span class="pan-sep">·</span>
                                <span>@Pct(pata.MargenPct.Value)</span>
                                @* Del costo de MercadoLibre solo guardamos el de HOY. Si el precio se
                                   movió mucho desde la venta, esa venta no se puede juzgar y queda
                                   afuera del margen. Decirlo es la diferencia entre un dato y un invento. *@
                                @if (pata.MargenCobertura is not null && pata.MargenCobertura < 95)
                                {
                                    <span class="pan-sep">·</span>
                                    <span class="pan-muted"
                                          title="El resto son ventas viejas: el precio cambió tanto desde entonces que el costo de hoy ya no sirve para juzgarlas.">
                                        medido sobre @Pct(pata.MargenCobertura.Value) de lo facturado
                                    </span>
                                }
                            }
                            else
                            {
                                <span class="pan-muted">sin margen · @pata.SinMargenPorque</span>
                            }
                        </div>

                        <div class="pan-line">
                            <span>@Miles(pata.Operaciones) @pata.UnidadOperacion</span>
                            @if (pata.VarFacturado is not null)
                            {
                                <span class="pan-sep">·</span>
                                @Delta(pata.VarFacturado.Value)
                            }
                        </div>
                    }

                    @Sparkline(pata.Clave, col)
                </div>
            }
        </div>

        <div class="pan-total">
            <span>Facturado en total</span>
            <b class="pan-total-v">@Plata(data.TotalFacturado)</b>
            @if (data.VarTotal is not null)
            {
                @Delta(data.VarTotal.Value)
            }
            <span class="pan-sep">·</span>
            <span>margen <b class="pan-total-v pan-total-v2">@Plata(data.TotalMargen)</b>
                <span class="pan-muted">sobre @data.TotalMargenSobre · @Pct(data.TotalMargenPct)</span></span>
            <span class="pan-sep">·</span>
            <span>@Miles(data.TotalOperaciones) operaciones</span>
            <span class="pan-sep">·</span>
            <span>@Kg(data.KgCafe) de café
                @if (data.KgCafeVar is not null)
                {
                    @Delta(data.KgCafeVar.Value)
                }
            </span>
        </div>

        @* ─────────── Gráfico de barras: los últimos 12 meses ─────────── *@
        <div class="pan-panel">
            <div class="pan-panel-h">
                <h3>Los últimos @data.Serie.Count meses</h3>
                <div class="pan-pills sm" role="group" aria-label="Qué mostrar">
                    @foreach (var m in Metricas)
                    {
                        <button type="button" class="pan-pill @(metrica == m.Key ? "on" : "")"
                                aria-pressed="@(metrica == m.Key ? "true" : "false")"
                                @onclick="() => metrica = m.Key">@m.Label</button>
                    }
                </div>
            </div>

            <div class="pan-legend">
                @if (metrica == "kg")
                {
                    <span class="pan-muted">Kilos de café vendidos por mes — solo Frikaf, que es la única pata que vende café.</span>
                }
                else
                {
                    @foreach (var s in SeriesVisibles())
                    {
                        <span><i class="pan-dot" style="background:@ColorPata(s)"></i>@NombrePata(s)</span>
                    }
                    @if (metrica == "margen")
                    {
                        <span class="pan-muted">Alquileres y logística no aparecen: no tienen costo cargado.</span>
                    }
                }
            </div>

            <div class="pan-chart-scroll">
                @Grafico()
            </div>
        </div>

        @* ─────────── Rankings + avisos ─────────── *@
        <div class="pan-grid2">

            <div class="pan-panel">
                <div class="pan-panel-h">
                    <h3>Rankings</h3>
                    <div class="pan-panel-h-r">
                        @if (RankingActual()?.Filas.Any(f => f.Margen is not null) == true)
                        {
                            <div class="pan-pills sm" role="group" aria-label="Ordenar por">
                                <button type="button" class="pan-pill @(orden == "valor" ? "on" : "")"
                                        @onclick='() => orden = "valor"'>Por plata</button>
                                <button type="button" class="pan-pill @(orden == "margen" ? "on" : "")"
                                        @onclick='() => orden = "margen"'>Por margen</button>
                            </div>
                        }
                        <button type="button" class="pan-link" @onclick="BajarExcel" title="Bajar esta tabla para abrir en Excel">
                            Bajar a Excel
                        </button>
                    </div>
                </div>

                <div class="pan-tabs" role="tablist">
                    @foreach (var rk in data.Rankings)
                    {
                        <button type="button" class="pan-tab @(tab == rk.Clave ? "on" : "")" role="tab"
                                aria-selected="@(tab == rk.Clave ? "true" : "false")"
                                @onclick="() => CambiarTab(rk.Clave)">@rk.Titulo</button>
                    }
                </div>

                @{
                    var rank = RankingActual();
                    var filas = FilasOrdenadas(rank);
                    var maxVal = filas.Count > 0
                        ? Math.Max(0.0001m, filas.Max(f => Math.Abs(ValorOrden(f))))
                        : 1m;
                }

                @if (rank is not null && !string.IsNullOrWhiteSpace(rank.Nota))
                {
                    <p class="pan-nota">@rank.Nota</p>
                }

                @if (filas.Count == 0)
                {
                    <p class="pan-muted" style="padding:1.2rem 0;">No hay nada en este período.</p>
                }
                else
                {
                    <div class="pan-tbl-scroll">
                        <table class="pan-tbl">
                            <thead>
                                <tr>
                                    <th>@(rank?.ColumnaNombre ?? "")</th>
                                    <th class="pan-bar-col"></th>
                                    <th class="r">@(rank?.ColumnaValor ?? "")</th>
                                    <th class="r">Margen</th>
                                    <th class="r">Var.</th>
                                </tr>
                            </thead>
                            <tbody>
                                @for (var i = 0; i < filas.Count; i++)
                                {
                                    var f = filas[i];
                                    var w = (double)(Math.Abs(ValorOrden(f)) / maxVal * 100m);
                                    var col = ColorPata(f.Pata);
                                    <tr>
                                        <td>
                                            <div class="pan-rk">
                                                <span class="pan-pos">@(i + 1)</span>
                                                <i class="pan-dot" style="background:@col" title="@NombrePata(f.Pata)"></i>
                                                <span class="pan-nm" title="@f.Nombre">@f.Nombre</span>
                                            </div>
                                            @if (!string.IsNullOrWhiteSpace(f.Detalle))
                                            {
                                                <div class="pan-det">@f.Detalle</div>
                                            }
                                        </td>
                                        <td class="pan-bar-col">
                                            <div class="pan-barwrap">
                                                <div class="pan-barfill"
                                                     style="width:@Inv(w)%; background:@col"></div>
                                            </div>
                                        </td>
                                        <td class="r"><span class="pan-num">@ValorFormateado(rank, f.Valor)</span></td>
                                        <td class="r">
                                            @if (f.Margen is not null)
                                            {
                                                <span class="pan-num @(f.Margen < 0 ? "pan-alarma" : "")">@Plata(f.Margen.Value)</span>
                                            }
                                            else
                                            {
                                                <span class="pan-muted">—</span>
                                            }
                                        </td>
                                        <td class="r">
                                            @if (f.Var is not null)
                                            {
                                                @Delta(f.Var.Value)
                                            }
                                            else
                                            {
                                                <span class="pan-muted">—</span>
                                            }
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
            </div>

            <div class="pan-panel">
                <div class="pan-panel-h">
                    <h3>Qué mirar hoy</h3>
                    <span class="pan-muted">@data.Avisos.Count @(data.Avisos.Count == 1 ? "aviso" : "avisos")</span>
                </div>

                @if (data.Avisos.Count == 0)
                {
                    <p class="pan-muted" style="padding:1.2rem 0;">Nada llamativo en este período.</p>
                }
                else
                {
                    @foreach (var a in data.Avisos)
                    {
                        <div class="pan-aviso">
                            <div class="@(a.EsAlarma ? "pan-alarma-txt" : "")">@a.Texto</div>
                            <div class="pan-det">
                                @a.Detalle
                                @if (!string.IsNullOrWhiteSpace(a.Link))
                                {
                                    <a class="pan-link inline" href="@a.Link">ir a verlo</a>
                                }
                            </div>
                        </div>
                    }
                }
            </div>
        </div>

        <p class="pan-pie">
            Los números salen de tu base en el momento. Café: sin anuladas y sin proformas ya facturadas; las notas de
            crédito restan. MercadoLibre: órdenes pagadas, con el margen descontando comisión, envío e IVA — la misma
            cuenta que la pantalla de Publicaciones. De MercadoLibre solo se guarda el costo de hoy, así que
            las ventas cuyo precio se movió más de 25% desde entonces quedan fuera del margen (se avisa cuándo pasa).
            Alquileres: sin canceladas.
            Actualizado @data.GeneradoAt.AddHours(-3).ToString("HH:mm", Ar) de Argentina.
        </p>
    }
</div>

<style>
    .pan-wrap { padding: 0.2rem 0 2rem; }

    .pan-top { display:flex; align-items:flex-end; justify-content:space-between; gap:1rem; flex-wrap:wrap; margin-bottom:1.1rem; }
    .pan-h1 { margin:0; font-size:1.5rem; font-weight:700; letter-spacing:-0.02em; color:var(--text-primary); }
    .pan-sub { margin:0.2rem 0 0; color:var(--text-secondary); font-size:0.87rem; }

    .pan-pills { display:inline-flex; gap:2px; background:#eef1f5; border:1px solid var(--border); border-radius:9px; padding:3px; }
    .pan-pills.sm .pan-pill { font-size:0.78rem; padding:4px 10px; }
    .pan-pill { appearance:none; border:0; background:transparent; color:var(--text-secondary); font:inherit;
                font-size:0.83rem; font-weight:500; padding:5px 13px; border-radius:6px; cursor:pointer; }
    .pan-pill:hover:not(:disabled) { color:var(--text-primary); }
    .pan-pill.on { background:#fff; color:var(--text-primary); font-weight:600; box-shadow:0 1px 2px rgba(15,20,27,.10); }
    .pan-pill:disabled { opacity:.55; cursor:default; }
    .pan-pill:focus-visible { outline:2px solid #1d4ed8; outline-offset:2px; }

    /* ── las 4 patas ── */
    .pan-patas { display:grid; grid-template-columns:repeat(4,1fr); gap:1px; background:var(--border);
                 border:1px solid var(--border); border-radius:11px; overflow:hidden; }
    .pan-cargando { opacity:.45; transition:opacity .15s; }
    .pan-pata { background:var(--card-bg); padding:0.85rem 0.95rem 0.8rem; position:relative; }
    .pan-pata::before { content:""; position:absolute; top:0; bottom:0; left:0; width:3px; background:var(--pc); }
    .pan-pata-h { display:flex; align-items:center; gap:6px; font-size:0.78rem; color:var(--text-secondary); }
    .pan-pata-h strong { color:var(--text-primary); font-weight:600; }
    .pan-canal { font-size:0.7rem; color:var(--text-muted); }
    .pan-dot { width:9px; height:9px; border-radius:2px; flex:none; display:inline-block; }
    .pan-big { font-size:1.55rem; font-weight:700; letter-spacing:-0.03em; margin:0.4rem 0 0.15rem;
               font-variant-numeric:tabular-nums; color:var(--text-primary); line-height:1.05; }
    .pan-line { font-size:0.78rem; color:var(--text-secondary); margin-top:2px; }
    .pan-sep { color:var(--text-muted); margin:0 5px; }
    .pan-muted { color:var(--text-muted); }
    .pan-spark { display:block; width:100%; height:26px; margin-top:0.5rem; }

    .pan-delta { font-size:0.75rem; font-weight:600; font-variant-numeric:tabular-nums; color:var(--text-secondary); }
    .pan-delta.down { color:#dc2626; }

    .pan-total { display:flex; align-items:baseline; gap:0.5rem; flex-wrap:wrap; margin-top:0.8rem;
                 font-size:0.87rem; color:var(--text-secondary); }
    .pan-total-v { font-size:1.25rem; font-weight:700; letter-spacing:-0.025em; color:var(--text-primary);
                   font-variant-numeric:tabular-nums; }
    .pan-total-v2 { font-size:1.02rem; }

    /* ── paneles ── */
    .pan-panel { background:var(--card-bg); border:1px solid var(--border); border-radius:11px;
                 padding:1rem 1.05rem; margin-top:1rem; }
    .pan-panel-h { display:flex; align-items:center; justify-content:space-between; gap:0.8rem; flex-wrap:wrap; }
    .pan-panel-h h3 { margin:0; font-size:0.98rem; font-weight:600; color:var(--text-primary); }
    .pan-panel-h-r { display:flex; align-items:center; gap:0.7rem; flex-wrap:wrap; }
    .pan-link { appearance:none; border:0; background:none; padding:0; font:inherit; font-size:0.8rem;
                color:#1d4ed8; cursor:pointer; text-decoration:underline; text-underline-offset:2px; }
    .pan-link.inline { margin-left:6px; }

    .pan-legend { display:flex; flex-wrap:wrap; gap:5px 15px; margin:0.7rem 0 0.2rem; font-size:0.78rem;
                  color:var(--text-secondary); align-items:center; }
    .pan-legend span { display:flex; align-items:center; gap:6px; }

    .pan-chart-scroll { overflow-x:auto; }
    .pan-chart { display:block; width:100%; min-width:560px; height:auto; }
    .pan-chart text { font-size:10.5px; fill:var(--text-muted); font-variant-numeric:tabular-nums; }
    .pan-chart text.mes { font-size:11px; fill:var(--text-secondary); }
    .pan-chart .gl { stroke:rgba(15,20,27,.08); stroke-width:1; }
    .pan-chart .hit { fill:transparent; }
    .pan-chart .col:hover .hit { fill:rgba(15,20,27,.05); }

    /* ── rankings ── */
    .pan-grid2 { display:grid; grid-template-columns:1.45fr 1fr; gap:1rem; align-items:start; }
    .pan-grid2 > .pan-panel { margin-top:1rem; }

    .pan-tabs { display:flex; flex-wrap:wrap; gap:2px; margin:0.75rem 0 0.2rem; }
    .pan-tab { appearance:none; border:0; background:transparent; color:var(--text-secondary); font:inherit;
               font-size:0.79rem; font-weight:500; padding:4px 9px; border-radius:6px; cursor:pointer; }
    .pan-tab:hover { background:#eef1f5; color:var(--text-primary); }
    .pan-tab.on { background:var(--text-primary); color:#fff; font-weight:600; }
    .pan-tab:focus-visible { outline:2px solid #1d4ed8; outline-offset:2px; }

    .pan-nota { margin:0.5rem 0 0.2rem; font-size:0.76rem; color:var(--text-muted); }

    .pan-tbl-scroll { overflow-x:auto; margin-top:0.4rem; }
    .pan-tbl { width:100%; border-collapse:collapse; font-size:0.82rem; min-width:430px; }
    .pan-tbl th { text-align:left; font-size:0.66rem; letter-spacing:.09em; text-transform:uppercase;
                  color:var(--text-muted); font-weight:600; padding:0 0 6px; border-bottom:1px solid var(--border); }
    .pan-tbl th.r, .pan-tbl td.r { text-align:right; padding-left:12px; white-space:nowrap; }
    .pan-tbl td { padding:7px 0; border-bottom:1px solid #f1f4f8; vertical-align:top; }
    .pan-tbl tr:last-child td { border-bottom:0; }
    .pan-num { font-variant-numeric:tabular-nums; font-weight:500; }

    .pan-rk { display:flex; align-items:center; gap:7px; }
    .pan-pos { font-size:0.7rem; color:var(--text-muted); width:16px; flex:none; font-variant-numeric:tabular-nums; }
    .pan-nm { font-weight:500; color:var(--text-primary); overflow:hidden; text-overflow:ellipsis;
              white-space:nowrap; max-width:20rem; }
    .pan-det { font-size:0.72rem; color:var(--text-muted); margin-top:1px; padding-left:23px; }

    .pan-bar-col { width:26%; }
    .pan-barwrap { height:8px; background:#eef1f5; border-radius:0 4px 4px 0; overflow:hidden; margin-top:5px; }
    .pan-barfill { height:100%; border-radius:0 4px 4px 0; }

    /* ── avisos ── */
    .pan-aviso { padding:0.6rem 0; border-bottom:1px solid #f1f4f8; font-size:0.83rem; line-height:1.45;
                 color:var(--text-primary); }
    .pan-aviso:last-child { border-bottom:0; }
    .pan-aviso .pan-det { padding-left:0; margin-top:2px; font-size:0.76rem; }
    .pan-alarma, .pan-alarma-txt { color:#dc2626; }
    .pan-alarma-txt { font-weight:600; }

    .pan-pie { margin:1.1rem 0 0; font-size:0.73rem; color:var(--text-muted); line-height:1.6; max-width:80ch; }

    @@media (max-width: 1100px) {
        .pan-grid2 { grid-template-columns:1fr; }
        .pan-patas { grid-template-columns:repeat(2,1fr); }
    }
    @@media (max-width: 640px) {
        .pan-patas { grid-template-columns:1fr; }
        .pan-top { align-items:flex-start; }
        .pan-nm { max-width:11rem; }
    }
</style>

@code {
    private static readonly CultureInfo Ar = CultureInfo.GetCultureInfo("es-AR");
    private static readonly CultureInfo Inv0 = CultureInfo.InvariantCulture;

    private PanoramaDto? data;
    private bool cargando = true;
    private string? error;

    private string periodo = "mes";
    private string metrica = "facturado";
    private string orden = "valor";
    private string tab = "clientes";

    private record Opcion(string Key, string Label);

    private static readonly Opcion[] Periodos =
    {
        new("hoy", "Hoy"), new("7d", "7 días"), new("mes", "Este mes"),
        new("90d", "90 días"), new("anio", "Este año")
    };

    private static readonly Opcion[] Metricas =
    {
        new("facturado", "Facturado"), new("margen", "Margen"),
        new("ops", "Operaciones"), new("kg", "Kilos de café")
    };

    protected override async Task OnInitializedAsync() => await Cargar();

    private async Task CambiarPeriodo(string p)
    {
        if (periodo == p || cargando) return;
        periodo = p;
        await Cargar();
    }

    private void CambiarTab(string t)
    {
        tab = t;
        // "Por margen" solo tiene sentido donde hay margen; si no lo hay, se vuelve a plata.
        if (orden == "margen" && RankingActual()?.Filas.All(f => f.Margen is null) == true)
            orden = "valor";
    }

    private async Task Cargar()
    {
        cargando = true;
        error = null;
        StateHasChanged();
        try
        {
            var r = await Api.GetPanoramaAsync(periodo, 12);
            if (r is null) { error = "el servidor no devolvió nada."; }
            else
            {
                data = r;
                if (!r.Rankings.Any(x => x.Clave == tab) && r.Rankings.Count > 0)
                    tab = r.Rankings[0].Clave;
            }
        }
        catch (Exception ex)
        {
            error = ex.Message;
        }
        finally
        {
            cargando = false;
            StateHasChanged();
        }
    }

    // ── identidad de cada pata ────────────────────────────────────────────
    private static string ColorPata(string clave) => clave switch
    {
        "iv" => "#d97706",   // Intervent — MercadoLibre
        "ie" => "#a21caf",   // Intereventos — alquileres
        "fk" => "#0d9488",   // Frikaf — café
        "lg" => "#1d4ed8",   // Logística — reparto propio
        _ => "#64748b"
    };

    private static string NombrePata(string clave) => clave switch
    {
        "iv" => "Intervent", "ie" => "Intereventos", "fk" => "Frikaf", "lg" => "Logística", _ => "—"
    };

    // El orden de las series es fijo y NO se reordena por tamaño: cada pata conserva
    // siempre su color y su lugar, para que dos meses distintos se lean igual.
    private string[] SeriesVisibles() => metrica switch
    {
        "margen" => new[] { "iv", "fk" },
        "kg" => new[] { "fk" },
        _ => new[] { "iv", "ie", "fk", "lg" }
    };

    private decimal ValorSerie(PanoramaPuntoDto p, string s) => metrica switch
    {
        "facturado" => s switch { "iv" => p.Iv, "ie" => p.Ie, "fk" => p.Fk, _ => p.Lg },
        "margen" => s switch { "iv" => p.MargenIv, _ => p.MargenFk },
        "ops" => s switch { "iv" => p.OpsIv, "ie" => p.OpsIe, "fk" => p.OpsFk, _ => p.OpsLg },
        _ => p.KgCafe
    };

    // ── formato ───────────────────────────────────────────────────────────
    private static string Inv(double v) => v.ToString("0.##", Inv0);

    private static string Plata(decimal v)
    {
        var s = Math.Abs(Math.Round(v, 0)).ToString("N0", Ar);
        return (v < 0 ? "-$" : "$") + s;
    }

    /// <summary>Para los ejes del gráfico: $1,2 M cuando el número es grande.</summary>
    private static string PlataCorta(decimal v)
    {
        if (Math.Abs(v) >= 1_000_000m) return "$" + (v / 1_000_000m).ToString("0.#", Ar) + " M";
        if (Math.Abs(v) >= 1_000m) return "$" + (v / 1_000m).ToString("0", Ar) + " mil";
        return "$" + Math.Round(v, 0).ToString("N0", Ar);
    }

    private static string Miles(decimal v) => Math.Round(v, 0).ToString("N0", Ar);
    private static string Pct(decimal v) => Math.Round(v, 1).ToString("0.#", Ar) + "%";
    private static string Kg(decimal v) => Math.Round(v, 1).ToString("N1", Ar) + " kg";

    private RenderFragment Delta(decimal v) => builder =>
    {
        var baja = v < 0;
        builder.OpenElement(0, "span");
        builder.AddAttribute(1, "class", "pan-delta " + (baja ? "down" : "up"));
        builder.AddContent(2, (baja ? "▼ " : "▲ ") + Math.Abs(v).ToString("0.#", Ar) + "%");
        builder.CloseElement();
    };

    private string ValorFormateado(PanoramaRankingDto? rank, decimal v) =>
        rank?.Clave == "kgcafe" ? Kg(v) : Plata(v);

    // ── rankings ──────────────────────────────────────────────────────────
    private PanoramaRankingDto? RankingActual() =>
        data?.Rankings.FirstOrDefault(r => r.Clave == tab) ?? data?.Rankings.FirstOrDefault();

    private decimal ValorOrden(PanoramaFilaDto f) =>
        orden == "margen" && f.Margen is not null ? f.Margen.Value : f.Valor;

    private List<PanoramaFilaDto> FilasOrdenadas(PanoramaRankingDto? rank)
    {
        if (rank is null) return new();
        return orden == "margen" && rank.Filas.Any(f => f.Margen is not null)
            ? rank.Filas.OrderByDescending(f => f.Margen ?? decimal.MinValue).ToList()
            : rank.Filas.ToList();
    }

    // ── el gráfico de barras ──────────────────────────────────────────────
    private RenderFragment Grafico() => builder =>
    {
        if (data is null || data.Serie.Count == 0) return;

        var serie = data.Serie;
        var series = SeriesVisibles();

        const double W = 760, H = 250, ml = 52, mr = 8, mt = 12, mb = 26;
        var iw = W - ml - mr;
        var ih = H - mt - mb;

        var totales = serie.Select(p => series.Sum(s => ValorSerie(p, s))).ToList();
        var max = totales.Count > 0 ? totales.Max() : 0m;
        if (max <= 0) max = 1m;

        // Escala "linda": el tope es un múltiplo redondo, con 4 rayas.
        var paso = PasoLindo(max / 4m);
        var tope = Math.Ceiling(max / paso) * paso;
        if (tope <= 0) tope = paso;

        Func<decimal, double> y = v => mt + ih - (double)(v / tope) * ih;
        var bw = iw / serie.Count;
        var bar = Math.Min(30.0, bw * 0.56);

        var sb = new StringBuilder();
        sb.Append($"<svg class=\"pan-chart\" viewBox=\"0 0 {Inv(W)} {Inv(H)}\" role=\"img\" ")
          .Append($"aria-label=\"{EtiquetaMetrica()} por mes, últimos {serie.Count} meses\">");

        // rayas horizontales + números del eje
        for (decimal t = 0; t <= tope + 0.0001m; t += paso)
        {
            var yy = y(t);
            sb.Append($"<line class=\"gl\" x1=\"{Inv(ml)}\" y1=\"{Inv(yy)}\" x2=\"{Inv(W - mr)}\" y2=\"{Inv(yy)}\"/>");
            sb.Append($"<text x=\"{Inv(ml - 8)}\" y=\"{Inv(yy + 3.5)}\" text-anchor=\"end\">{Escapar(EtiquetaEje(t))}</text>");
        }

        for (var i = 0; i < serie.Count; i++)
        {
            var p = serie[i];
            var cx = ml + bw * i + bw / 2;
            sb.Append("<g class=\"col\">");
            sb.Append($"<rect class=\"hit\" x=\"{Inv(ml + bw * i)}\" y=\"{Inv(mt)}\" width=\"{Inv(bw)}\" height=\"{Inv(ih)}\">");
            sb.Append($"<title>{Escapar(TituloColumna(p, series))}</title></rect>");

            decimal acum = 0m;
            foreach (var s in series)
            {
                var v = ValorSerie(p, s);
                if (v <= 0) continue;
                var alto = (double)(v / tope) * ih;
                var top = y(acum + v);
                // 2px de aire entre tramo y tramo: si no, dos colores pegados se leen como uno.
                var alt = Math.Max(0.0, alto - (series.Length > 1 ? 2.0 : 0.0));
                sb.Append($"<rect x=\"{Inv(cx - bar / 2)}\" y=\"{Inv(top)}\" width=\"{Inv(bar)}\" ")
                  .Append($"height=\"{Inv(alt)}\" fill=\"{ColorPata(s)}\"><title>")
                  .Append(Escapar($"{NombrePata(s)} · {EtiquetaValor(v)}")).Append("</title></rect>");
                acum += v;
            }

            sb.Append($"<text class=\"mes\" x=\"{Inv(cx)}\" y=\"{Inv(H - 8)}\" text-anchor=\"middle\">")
              .Append(Escapar(p.Etiqueta)).Append("</text>");
            sb.Append("</g>");
        }

        sb.Append("</svg>");
        builder.AddMarkupContent(0, sb.ToString());
    };

    /// <summary>Redondea el paso del eje al 1, 2 o 5 más cercano de su orden de magnitud,
    /// así los números del costado quedan redondos y no "$3.417.221".</summary>
    private static decimal PasoLindo(decimal aprox)
    {
        if (aprox <= 0) return 1m;
        var orden = (decimal)Math.Pow(10, Math.Floor(Math.Log10((double)aprox)));
        var n = aprox / orden;
        var mult = n <= 1m ? 1m : n <= 2m ? 2m : n <= 5m ? 5m : 10m;
        return mult * orden;
    }

    private string EtiquetaMetrica() => metrica switch
    {
        "margen" => "Margen", "ops" => "Operaciones", "kg" => "Kilos de café", _ => "Facturación"
    };

    private string EtiquetaEje(decimal v) => metrica switch
    {
        "ops" => Miles(v),
        "kg" => Math.Round(v, 0).ToString("N0", Ar) + " kg",
        _ => PlataCorta(v)
    };

    private string EtiquetaValor(decimal v) => metrica switch
    {
        "ops" => Miles(v),
        "kg" => Kg(v),
        _ => Plata(v)
    };

    private string TituloColumna(PanoramaPuntoDto p, string[] series)
    {
        var partes = series.Select(s => $"{NombrePata(s)}: {EtiquetaValor(ValorSerie(p, s))}");
        var total = series.Sum(s => ValorSerie(p, s));
        return $"{p.Etiqueta} {p.Anio}\n" + string.Join("\n", partes) + $"\nTotal: {EtiquetaValor(total)}";
    }

    private static string Escapar(string s) =>
        s.Replace("&", "&amp;").Replace("<", "&lt;").Replace(">", "&gt;").Replace("\"", "&quot;");

    // ── la rayita de 12 meses de cada pata ────────────────────────────────
    private RenderFragment Sparkline(string clave, string color) => builder =>
    {
        if (data is null || data.Serie.Count < 2) return;

        // Para logística la rayita muestra ENTREGAS, no plata: todavía no hay dónde guardar
        // lo que se cobra de flete propio, así que la plata siempre daría cero.
        var vals = data.Serie.Select(p => clave switch
        {
            "iv" => p.Iv, "ie" => p.Ie, "fk" => p.Fk, _ => (decimal)p.OpsLg
        }).ToList();

        const double W = 118, H = 24;
        var max = vals.Max();
        var min = vals.Min();
        var rango = max - min;
        if (rango <= 0) rango = 1m;

        var pts = new List<(double x, double y)>();
        for (var i = 0; i < vals.Count; i++)
        {
            var x = i * (W / (vals.Count - 1));
            var yy = H - (double)((vals[i] - min) / rango) * (H - 4) - 2;
            pts.Add((x, yy));
        }

        var d = new StringBuilder();
        for (var i = 0; i < pts.Count; i++)
            d.Append(i == 0 ? "M" : "L").Append(Inv(pts[i].x)).Append(' ').Append(Inv(pts[i].y)).Append(' ');

        var area = d.ToString() + $"L{Inv(W)} {Inv(H)} L0 {Inv(H)} Z";
        var last = pts[^1];

        var svg = $"<svg class=\"pan-spark\" viewBox=\"0 0 {Inv(W)} {Inv(H)}\" preserveAspectRatio=\"none\" aria-hidden=\"true\">"
                + $"<path d=\"{area}\" fill=\"{color}\" opacity=\"0.12\"/>"
                + $"<path d=\"{d}\" fill=\"none\" stroke=\"{color}\" stroke-width=\"1.6\" stroke-linejoin=\"round\" vector-effect=\"non-scaling-stroke\"/>"
                + $"<circle cx=\"{Inv(last.x)}\" cy=\"{Inv(last.y)}\" r=\"2.4\" fill=\"{color}\"/>"
                + "</svg>";

        builder.AddMarkupContent(0, svg);
    };

    // ── bajar el ranking a Excel ──────────────────────────────────────────
    private async Task BajarExcel()
    {
        var rank = RankingActual();
        if (rank is null || data is null) return;

        var filas = FilasOrdenadas(rank);
        var sb = new StringBuilder();
        // BOM + separador ";" → Excel en español lo abre en columnas sin preguntar nada.
        sb.Append('﻿');
        sb.AppendLine($"Panorama - {rank.Titulo}");
        sb.AppendLine($"{data.Etiqueta} ({data.Comparacion})");
        sb.AppendLine();
        sb.AppendLine($"Puesto;{rank.ColumnaNombre};Pata;{rank.ColumnaValor};Margen;Variacion;Detalle");

        for (var i = 0; i < filas.Count; i++)
        {
            var f = filas[i];
            sb.Append(i + 1).Append(';')
              .Append(Csv(f.Nombre)).Append(';')
              .Append(Csv(NombrePata(f.Pata))).Append(';')
              .Append(Math.Round(f.Valor, 2).ToString(Ar)).Append(';')
              .Append(f.Margen is null ? "" : Math.Round(f.Margen.Value, 2).ToString(Ar)).Append(';')
              .Append(f.Var is null ? "" : Math.Round(f.Var.Value, 1).ToString(Ar) + "%").Append(';')
              .Append(Csv(f.Detalle ?? ""))
              .AppendLine();
        }

        var bytes = Encoding.UTF8.GetBytes(sb.ToString());
        var nombre = $"panorama-{rank.Clave}-{DateTime.UtcNow.AddHours(-3):yyyy-MM-dd}.csv";
        await JS.InvokeVoidAsync("downloadFile", nombre, "text/csv;charset=utf-8", Convert.ToBase64String(bytes));
        Toast.Show($"Bajé «{rank.Titulo}» — se abre con Excel.", ToastType.Success);
    }

    private static string Csv(string s) =>
        s.Contains(';') || s.Contains('"') || s.Contains('\n')
            ? "\"" + s.Replace("\"", "\"\"") + "\""
            : s;
}
