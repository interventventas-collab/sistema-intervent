@page "/ideal-celu"
@layout EmptyLayout
@attribute [AllowAnonymous]
@inject ApiClient Api
@inject ToastService ToastService
@inject IJSRuntime JS
@implements IAsyncDisposable
@using System.Globalization
@using System.Text.RegularExpressions

@* 2026-11-10: stock ideal y piso en el celu del depósito, sin usuario. Se abre con el QR del botón
   de la pantalla de armado y pide la clave del día, que se ve ahí mismo. *@

<PageTitle>Stock ideal</PageTitle>

<style>
    body { background:#f3f4f6 !important; }
    .ic-wrap { max-width:520px; margin:0 auto; padding:0.8rem; font-family:inherit; color:#111827; }
    .ic-tit { font-size:1.25rem; font-weight:800; margin:0.2rem 0 0.7rem; }
    .ic-caja { background:#fff; border:1px solid #e5e7eb; border-radius:10px; padding:1.1rem; }
    .ic-txt { color:#6b7280; font-size:0.9rem; margin:0 0 0.8rem; }
    .ic-clave { width:100%; box-sizing:border-box; min-height:56px; border:1px solid #d1d5db; border-radius:8px; font:inherit; font-size:28px; font-weight:700; letter-spacing:0.25em; text-align:center; }
    .ic-entrar { width:100%; min-height:48px; margin-top:0.7rem; background:#111827; color:#fff; border:none; border-radius:8px; font:inherit; font-size:1rem; font-weight:700; }
    .ic-error { color:#b91c1c; font-size:0.88rem; margin-top:0.6rem; }
    .ic-busca { width:100%; box-sizing:border-box; min-height:46px; border:1px solid #d1d5db; border-radius:8px; padding:0.4rem 0.7rem; font:inherit; font-size:16px; margin-bottom:0.6rem; }
    .ic-prod { background:#fff; border:1px solid #e5e7eb; border-radius:10px; padding:0.65rem 0.75rem; margin-bottom:0.5rem; }
    .ic-nom { font-weight:700; overflow-wrap:anywhere; }
    .ic-hay { font-size:0.8rem; color:#6b7280; margin-top:1px; }
    .ic-ok { color:#15803d; font-weight:600; }
    .ic-dos { display:flex; gap:0.6rem; margin-top:0.4rem; }
    .ic-dos label { flex:1; min-width:0; font-size:0.76rem; color:#6b7280; margin:0; }
    .ic-dos input { display:block; width:100%; box-sizing:border-box; min-height:44px; margin-top:2px; border:1px solid #d1d5db; border-radius:7px; padding:0.3rem 0.6rem; font:inherit; font-size:16px; font-weight:600; color:#111827; }
    .ic-fila-busca { display:flex; gap:0.5rem; margin-bottom:0.6rem; }
    .ic-fila-busca .ic-busca { flex:1; min-width:0; margin-bottom:0; }
    .ic-escanear { flex-shrink:0; min-height:46px; padding:0 0.9rem; background:#111827; color:#fff; border:none; border-radius:8px; font:inherit; font-weight:700; }
    .ic-lector { background:#000; border-radius:10px; overflow:hidden; margin-bottom:0.5rem; }
    .ic-cancelar { width:100%; min-height:44px; margin-bottom:0.6rem; background:#fff; border:1px solid #d1d5db; border-radius:8px; font:inherit; font-weight:600; color:#111827; }
    .ic-codigo { display:flex; align-items:center; gap:0.5rem; font-size:0.88rem; color:#374151; margin:-0.2rem 0 0.6rem; }
    .ic-codigo button { margin-left:auto; background:none; border:none; color:#6b7280; font:inherit; text-decoration:underline; }
    .ic-mas { display:block; width:100%; min-height:46px; background:#fff; border:1px solid #d1d5db; border-radius:8px; font:inherit; font-weight:600; color:#111827; }
    .ic-inicio { display:inline-block; font-size:0.88rem; color:#374151; text-decoration:none; margin-bottom:0.2rem; }
    .ic-top { display:flex; gap:0.65rem; }
    .ic-foto { width:72px; height:72px; flex-shrink:0; border-radius:8px; background:#e5e7eb; object-fit:cover; display:flex; align-items:center; justify-content:center; font-size:0.7rem; color:#6b7280; text-align:center; }
    .ic-datos { min-width:0; flex:1; }
    .ic-d { font-size:0.8rem; color:#4b5563; margin-top:2px; line-height:1.4; overflow-wrap:anywhere; }
    .ic-d b { color:#111827; font-weight:600; }
    .ic-gris { color:#9ca3af; }
    .ic-acc { display:flex; gap:0.4rem; margin-top:0.5rem; }
    .ic-acc button { flex:1; min-height:40px; border:1px solid #d1d5db; background:#fff; border-radius:7px; font:inherit; font-size:0.8rem; font-weight:600; color:#111827; padding:0 0.2rem; }
    .ic-acc button.on { background:#111827; color:#fff; border-color:#111827; }
    .ic-panel { margin-top:0.5rem; padding:0.6rem; background:#f9fafb; border:1px solid #e5e7eb; border-radius:8px; }
    .ic-panel label { display:block; font-size:0.76rem; color:#6b7280; margin-bottom:0.45rem; }
    .ic-panel select, .ic-panel input { display:block; width:100%; box-sizing:border-box; min-height:44px; margin-top:2px; border:1px solid #d1d5db; border-radius:7px; padding:0.3rem 0.5rem; font:inherit; font-size:16px; background:#fff; color:#111827; }
    .ic-panel-bs { display:flex; gap:0.5rem; }
    .ic-panel-bs button { flex:1; min-height:44px; border-radius:7px; font:inherit; font-weight:700; border:1px solid #d1d5db; background:#fff; color:#111827; }
    .ic-panel-bs button.prim { background:#111827; color:#fff; border-color:#111827; }
    .ic-solo { display:flex; align-items:center; gap:0.5rem; font-size:0.88rem; color:#374151; margin:-0.1rem 0 0.6rem; }
    .ic-solo input { width:20px; height:20px; }
</style>

<div class="ic-wrap">
    <a class="ic-inicio" href="/depo">← Inicio</a>
    <div class="ic-tit">@Titulo</div>

    @if (pase is null)
    {
        <form class="ic-caja" @onsubmit="Entrar">
            <p class="ic-txt">Escribí la clave de hoy. Está en el sistema, en la pantalla de armado.</p>
            <input class="ic-clave" type="tel" inputmode="numeric" maxlength="6" autocomplete="off" @bind="clave" @bind:event="oninput" />
            <button class="ic-entrar" type="submit" disabled="@(entrando || clave.Trim().Length != 6)">@(entrando ? "Entrando…" : "Entrar")</button>
            @if (error is not null) { <div class="ic-error">@error</div> }
        </form>
    }
    else if (filas is null)
    {
        <p class="ic-txt">Cargando…</p>
    }
    else
    {
        @if (escaneando)
        {
            <div id="ic-lector" class="ic-lector"></div>
            <button class="ic-cancelar" @onclick="DejarDeEscanear">Cancelar</button>
        }
        else
        {
            <div class="ic-fila-busca">
                <input class="ic-busca" type="search" placeholder="🔍 Buscar producto, marca o código" @bind="busca" @bind:event="oninput" @bind:after="() => limite = PASO" />
                <button class="ic-escanear" @onclick="Escanear">📷 Escanear</button>
            </div>
        }
        @if (errorCamara is not null) { <div class="ic-error" style="margin:-0.2rem 0 0.6rem;">@errorCamara</div> }
        @if (escaneado is not null && !escaneando)
        {
            <div class="ic-codigo">
                <span>Código <b>@escaneado</b>: @(Filtradas.Count == 1 ? "1 producto" : $"{Filtradas.Count} productos")</span>
                <button @onclick="LimpiarEscaneo">Ver todos</button>
            </div>
        }
        @if (Modo != "ideal" && escaneado is null)
        {
            <label class="ic-solo">
                <input type="checkbox" @bind="soloSinDato" @bind:after="() => limite = PASO" />
                @(Modo == "venc" ? "Solo los que no tienen vencimiento" : "Solo los que no tienen ubicación")
            </label>
        }
        @if (Filtradas.Count == 0)
        {
            <p class="ic-txt">@(escaneado is not null ? "Ningún producto tiene cargado ese código de barras." : "No hay productos con esa búsqueda.")</p>
        }
        @foreach (var f in Filtradas.Take(limite))
        {
            var pid = f.ProductoId;
            var kilos = f.Unidad == "kg";
            <div class="ic-prod" @key="pid">
                <div class="ic-top">
                    @if (f.Foto is not null)
                    {
                        <img class="ic-foto" src="@f.Foto" alt="" loading="lazy" />
                    }
                    else
                    {
                        <div class="ic-foto">sin foto</div>
                    }
                    <div class="ic-datos">
                        <div class="ic-nom">@f.Nombre</div>
                        <div class="ic-d">@(f.Codigo ?? "Sin código") · @(string.IsNullOrWhiteSpace(f.Marca) ? "Sin marca" : f.Marca)</div>
                        <div class="ic-d">@if (string.IsNullOrWhiteSpace(f.Barcode)) { <span class="ic-gris">Sin código de barras</span> } else { <text>Barras @f.Barcode</text> }</div>
                        <div class="ic-d">
                            <span style="@(f.StockActual <= 0 ? "color:#b91c1c; font-weight:700;" : "")">Hay @Num(f.StockActual)@(kilos ? " kilos" : "")</span> ·
                            📍 @if (f.Ubicacion is null) { <span class="ic-gris">sin ubicación</span> } else { <b>@f.Ubicacion</b> }
                        </div>
                        <div class="ic-d">
                            📅 @if (f.Vence is null) { <span class="ic-gris">sin vencimiento</span> } else { <text>Vence <b>@f.Vence.Value.ToString("dd/MM/yyyy")</b> (@Num(f.VenceQuedan)@(kilos ? " kg" : " u"))</text> }
                            @if (guardados.Contains(pid)) { <span class="ic-ok"> · ✓ Guardado</span> }
                        </div>
                    </div>
                </div>
                <div class="ic-dos">
                    <label>
                        Ideal@(kilos ? " (kilos)" : "")
                        <input type="text" inputmode="numeric" autocomplete="off" placeholder="—"
                               value="@(editsIdeal.TryGetValue(pid, out var vi) ? vi : Miles(f.StockIdeal))"
                               @onchange="@(e => Cambiar(f, e.Value?.ToString(), false))" />
                    </label>
                    <label>
                        Piso@(kilos ? " (kilos)" : "")
                        <input type="text" inputmode="numeric" autocomplete="off" placeholder="—"
                               value="@(editsPiso.TryGetValue(pid, out var vp) ? vp : Miles(f.StockPiso))"
                               @onchange="@(e => Cambiar(f, e.Value?.ToString(), true))" />
                    </label>
                </div>
                <div class="ic-acc">
                    <button disabled="@(abriendoFoto == pid)" @onclick="() => SacarFoto(f)">@(abriendoFoto == pid ? "Abriendo…" : "📷 Foto")</button>
                    <button class="@(panel == (pid, "ubic") ? "on" : "")" @onclick='() => AbrirPanel(f, "ubic")'>📍 Ubicación</button>
                    <button class="@(panel == (pid, "venc") ? "on" : "")" @onclick='() => AbrirPanel(f, "venc")'>📅 Vencimiento</button>
                </div>
                @if (panel == (pid, "ubic"))
                {
                    <div class="ic-panel">
                        @if (zonas is null)
                        {
                            <div class="ic-d">Cargando lugares…</div>
                        }
                        else
                        {
                            <label>Planta
                                <select value="@plantaSel" @onchange="ElegirPlanta">
                                    <option value="">— Sin ubicación —</option>
                                    @foreach (var pl in zonas.Plantas) { <option value="@pl.Codigo">@pl.Nombre</option> }
                                </select>
                            </label>
                            @if (plantaSel != "")
                            {
                                <label>Lugar
                                    <select @bind="zonaSel">
                                        <option value="">— Solo la planta —</option>
                                        @foreach (var z in zonas.Zonas.Where(z => z.Planta == plantaSel)) { <option value="@z.Codigo">@(z.Nombre is null ? z.Codigo : $"{z.Codigo} · {z.Nombre}")</option> }
                                    </select>
                                </label>
                            }
                            <div class="ic-panel-bs">
                                <button @onclick="() => panel = null">Cancelar</button>
                                <button class="prim" disabled="@guardandoPanel" @onclick="() => GuardarUbicacion(f)">@(guardandoPanel ? "Guardando…" : "Guardar")</button>
                            </div>
                        }
                    </div>
                }
                @if (panel == (pid, "venc"))
                {
                    <div class="ic-panel">
                        <label>¿Cuándo vence?<input type="date" @bind="fechaSel" /></label>
                        <label>¿Cuántos vencen ese día?@(kilos ? " (kilos)" : "")<input type="text" inputmode="decimal" autocomplete="off" @bind="cantidadSel" /></label>
                        <div class="ic-panel-bs">
                            <button @onclick="() => panel = null">Cancelar</button>
                            <button class="prim" disabled="@guardandoPanel" @onclick="() => GuardarVencimiento(f)">@(guardandoPanel ? "Guardando…" : "Guardar")</button>
                        </div>
                    </div>
                }
            </div>
        }
        @if (Filtradas.Count > limite)
        {
            <button class="ic-mas" @onclick="() => limite += PASO">Ver más (quedan @(Filtradas.Count - limite))</button>
        }
    }
</div>

@code {
    private const string CLAVE_GUARDADA = "ideal_celu_pase";
    private const int PASO = 40;

    private string? pase, error;
    private string clave = "", busca = "";
    private bool entrando;
    private int limite = PASO;
    private List<StockIdealRowDto>? filas;
    private readonly Dictionary<int, string> editsIdeal = new(), editsPiso = new();
    private readonly HashSet<int> guardados = new();

    private List<StockIdealRowDto> Filtradas
    {
        get
        {
            if (filas is null) return new();
            // Escaneado: solo los que tienen ESE código (también sin los ceros de adelante: EAN vs UPC).
            if (escaneado is not null)
                return filas.Where(f => MismoCodigo(f.Barcode, escaneado) || MismoCodigo(f.Codigo, escaneado)).ToList();
            IEnumerable<StockIdealRowDto> r = filas;
            if (soloSinDato && Modo == "venc") r = r.Where(f => f.Vence is null);
            if (soloSinDato && Modo == "ubic") r = r.Where(f => f.Ubicacion is null);
            var q = busca.Trim();
            if (q.Length > 0) r = r.Where(f => Tiene(f.Nombre, q) || Tiene(f.Marca, q) || Tiene(f.Codigo, q) || Tiene(f.Barcode, q));
            return r.ToList();
        }
    }

    // ───── 2026-11-10: desde el inicio (/depo) se entra por Vencimientos o Ubicaciones: misma lista ─────
    [Parameter, SupplyParameterFromQuery(Name = "ver")] public string? Ver { get; set; }
    [Inject] private NavigationManager Nav { get; set; } = default!;
    private string Modo => Ver is "venc" or "ubic" ? Ver : "ideal";
    private string Titulo => Modo switch { "venc" => "📅 Vencimientos", "ubic" => "📍 Ubicaciones", _ => "📦 Stock ideal y piso" };
    private bool soloSinDato;

    private (int Id, string Tipo)? panel;
    private string plantaSel = "", zonaSel = "", cantidadSel = "";
    private DateTime? fechaSel;
    private bool guardandoPanel;
    private int? abriendoFoto;
    private ZonasDepoCeluDto? zonas;

    private async Task AbrirPanel(StockIdealRowDto f, string tipo)
    {
        if (panel == (f.ProductoId, tipo)) { panel = null; return; }
        panel = (f.ProductoId, tipo);
        if (tipo == "venc") { fechaSel = null; cantidadSel = ""; return; }
        // Ubicación: arranca con la que tiene (la API la manda como "PB · RACK 2").
        var partes = (f.Ubicacion ?? "").Split('·', StringSplitOptions.TrimEntries | StringSplitOptions.RemoveEmptyEntries);
        if (zonas is null)
        {
            var r = await Api.GetZonasDepoCeluAsync(pase!);
            if (r.Vencido) { await PedirClaveDeNuevo(); return; }
            zonas = r.Dato ?? new();
        }
        plantaSel = zonas.Plantas.FirstOrDefault(p => partes.Length > 0 && (p.Codigo == partes[0] || p.Nombre == partes[0]))?.Codigo ?? "";
        zonaSel = partes.Length > 1 ? partes[1] : "";
    }

    private void ElegirPlanta(ChangeEventArgs e)
    {
        plantaSel = e.Value?.ToString() ?? "";
        zonaSel = "";
    }

    private async Task GuardarUbicacion(StockIdealRowDto f)
    {
        guardandoPanel = true;
        var r = await Api.PonerUbicacionCeluAsync(pase!, f.ProductoId, plantaSel == "" ? null : plantaSel, zonaSel == "" ? null : zonaSel);
        guardandoPanel = false;
        if (r.Vencido) { await PedirClaveDeNuevo(); return; }
        if (r.Error is not null) { ToastService.Error(r.Error); return; }
        string? lugar = null;
        try { if (r.Dato.TryGetProperty("lugar", out var l)) lugar = l.GetString(); } catch { }
        f.Ubicacion = lugar;
        panel = null;
        guardados.Add(f.ProductoId);
    }

    private async Task GuardarVencimiento(StockIdealRowDto f)
    {
        if (fechaSel is null) { ToastService.Error("Poné la fecha de vencimiento."); return; }
        var txt = (cantidadSel ?? "").Trim().Replace(" ", "");
        if (!decimal.TryParse(txt, NumberStyles.Number, CultureInfo.GetCultureInfo("es-AR"), out var cant) || cant <= 0)
        {
            ToastService.Error("Poné cuántos vencen ese día (por ejemplo 12, o 2,5 kilos).");
            return;
        }
        guardandoPanel = true;
        var r = await Api.SumarVencimientoCeluAsync(pase!, f.ProductoId, fechaSel.Value, cant);
        guardandoPanel = false;
        if (r.Vencido) { await PedirClaveDeNuevo(); return; }
        if (r.Error is not null) { ToastService.Error(r.Error); return; }
        try
        {
            f.Vence = r.Dato.TryGetProperty("vence", out var v) && v.ValueKind == System.Text.Json.JsonValueKind.String ? v.GetDateTime() : null;
            f.VenceQuedan = r.Dato.TryGetProperty("quedan", out var q) ? q.GetDecimal() : 0;
        }
        catch { }
        panel = null;
        guardados.Add(f.ProductoId);
        // Lo que queda de cada fecha sale del stock (se saca primero lo que vence antes): con 0 no queda nada.
        if (f.Vence is null)
            ToastService.Info($"Vencimiento guardado. Como hay {Num(f.StockActual)} en stock, no queda nada por vencer.");
    }

    /// <summary>Abre la subida de foto de siempre (/subir-foto-producto). Al volver atrás, la lista se recarga con la foto nueva.</summary>
    private async Task SacarFoto(StockIdealRowDto f)
    {
        abriendoFoto = f.ProductoId;
        var r = await Api.TokenFotoCeluAsync(pase!, f.ProductoId);
        abriendoFoto = null;
        if (r.Vencido) { await PedirClaveDeNuevo(); return; }
        if (r.Dato?.Token is not { Length: > 0 } token) { ToastService.Error(r.Error ?? "No se pudo abrir la cámara."); return; }
        Nav.NavigateTo($"/subir-foto-producto/{token}");
    }

    private static bool MismoCodigo(string? guardado, string leido)
    {
        if (string.IsNullOrWhiteSpace(guardado)) return false;
        var a = guardado.Trim();
        return string.Equals(a, leido, StringComparison.OrdinalIgnoreCase)
            || (a.TrimStart('0').Length > 0 && a.TrimStart('0') == leido.TrimStart('0'));
    }

    // ───── Escanear con la cámara (mismo lector que el escáner del depósito) ─────
    private bool escaneando;
    private string? escaneado, errorCamara;
    private DotNetObjectReference<IdealCelu>? refJs;

    private async Task Escanear()
    {
        errorCamara = null;
        refJs ??= DotNetObjectReference.Create(this);
        escaneando = true;
        StateHasChanged();
        await Task.Yield(); // que el cuadro del lector entre a la pantalla
        try { await JS.InvokeVoidAsync("scannerBarcode.start", "ic-lector", refJs); }
        catch { errorCamara = "No se pudo abrir la cámara."; escaneando = false; }
    }

    private async Task DejarDeEscanear()
    {
        escaneando = false;
        try { await JS.InvokeVoidAsync("scannerBarcode.stop"); } catch { }
    }

    [JSInvokable]
    public async Task OnScanDetected(string text, string format)
    {
        if (string.IsNullOrWhiteSpace(text) || !escaneando) return;
        await DejarDeEscanear();
        escaneado = text.Trim();
        busca = "";
        limite = PASO;
        StateHasChanged();
    }

    [JSInvokable]
    public void OnScanError(string message)
    {
        errorCamara = message;
        escaneando = false;
        InvokeAsync(StateHasChanged);
    }

    private void LimpiarEscaneo() { escaneado = null; busca = ""; limite = PASO; }

    public async ValueTask DisposeAsync()
    {
        if (escaneando) { try { await JS.InvokeVoidAsync("scannerBarcode.stop"); } catch { } }
        refJs?.Dispose();
    }

    private static bool Tiene(string? texto, string q) => texto is not null
        && CultureInfo.InvariantCulture.CompareInfo.IndexOf(texto, q, CompareOptions.IgnoreCase | CompareOptions.IgnoreNonSpace) >= 0;

    protected override async Task OnInitializedAsync()
    {
        string? guardado = null;
        try { guardado = await JS.InvokeAsync<string?>("localStorage.getItem", CLAVE_GUARDADA); } catch { }
        if (string.IsNullOrEmpty(guardado)) return;
        pase = guardado;
        await CargarAsync();
    }

    private async Task Entrar()
    {
        if (entrando || clave.Trim().Length != 6) return;
        entrando = true; error = null;
        var (token, err) = await Api.EntrarIdealCeluAsync(clave.Trim());
        entrando = false;
        if (token is null) { error = err; return; }
        pase = token;
        try { await JS.InvokeVoidAsync("localStorage.setItem", CLAVE_GUARDADA, token); } catch { }
        await CargarAsync();
    }

    private async Task CargarAsync()
    {
        try
        {
            var (lista, vencido) = await Api.GetListaIdealCeluAsync(pase!);
            if (vencido) { await PedirClaveDeNuevo(); return; }
            if (lista is null) { pase = null; error = "No se pudo cargar la lista. Probá de nuevo."; return; }
            filas = lista;
        }
        catch { pase = null; error = "Sin conexión. Probá de nuevo."; }
    }

    private async Task PedirClaveDeNuevo()
    {
        pase = null; filas = null; clave = "";
        error = "La clave cambió. Escribí la de hoy.";
        try { await JS.InvokeVoidAsync("localStorage.removeItem", CLAVE_GUARDADA); } catch { }
    }

    private async Task Cambiar(StockIdealRowDto f, string? valor, bool esPiso)
    {
        var edits = esPiso ? editsPiso : editsIdeal;
        var texto = (valor ?? "").Trim();
        edits[f.ProductoId] = texto;

        if (!LeerNumero(texto, out var nuevo))
        {
            ToastService.Error($"'{texto}' no sirve: escribí un número entero, sin decimales (por ejemplo 12 o 1.500)");
            await Task.Yield();   // deja dibujar lo tipeado para que al sacarlo el casillero vuelva al valor guardado
            edits.Remove(f.ProductoId);
            return;
        }
        if ((esPiso ? f.StockPiso : f.StockIdeal) == nuevo) { edits.Remove(f.ProductoId); return; }

        var item = new StockIdealBulkItemDto
        {
            ProductoId = f.ProductoId,
            StockIdeal = esPiso ? null : nuevo,
            StockPiso = esPiso ? nuevo : null,
            TocaIdeal = !esPiso,
            TocaPiso = esPiso,
        };
        string? r;
        try { r = await Api.GuardarIdealCeluAsync(pase!, item); }
        catch { r = null; }

        if (r == "vencido") { await PedirClaveDeNuevo(); return; }
        if (r is null)
        {
            ToastService.Error("No se pudo guardar. Probá de nuevo.");
            edits.Remove(f.ProductoId);
            return;
        }
        if (esPiso) f.StockPiso = nuevo; else f.StockIdeal = nuevo;
        edits.Remove(f.ProductoId);
        guardados.Add(f.ProductoId);
    }

    /// <summary>Misma regla que la pantalla de la compu: vacío borra, "1.500" son 1500 y no hay decimales.</summary>
    private static bool LeerNumero(string texto, out int? valor)
    {
        valor = null;
        if (texto.Length == 0) return true;
        var sinEspacios = texto.Replace(" ", "");
        if (!Regex.IsMatch(sinEspacios, @"^\d+$|^\d{1,3}(\.\d{3})+$")) return false;
        if (!int.TryParse(sinEspacios.Replace(".", ""), NumberStyles.None, CultureInfo.InvariantCulture, out var n)) return false;
        valor = n;
        return true;
    }

    private static string Miles(int? v) => v.HasValue ? v.Value.ToString("N0", CultureInfo.GetCultureInfo("es-AR")) : "";

    private static string Num(decimal v) => v.ToString("#,##0.##", CultureInfo.GetCultureInfo("es-AR"));
}
