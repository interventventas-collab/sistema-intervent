@page "/meli/preguntas"
@attribute [Authorize]
@inject ApiClient Api
@inject ToastService Toast
@inject NavigationManager Nav
@inject IJSRuntime JS

<div class="bp-page">

    <div class="bp-header">
        <div>
            <h1 class="bp-title">📥 Preguntas de MercadoLibre</h1>
            <p class="bp-sub">Respondé, mirá la publicación y quién te pregunta — todo en una pantalla.</p>
        </div>
        <button class="btn btn-secondary" @onclick="Refrescar" disabled="@refreshing">
            @(refreshing ? "Buscando..." : "🔄 Refrescar")
        </button>
    </div>

    <!-- Pestañas de la sección Respuestas automáticas -->
    <div class="bp-tabs">
        <span class="bp-tab active">📥 Preguntas</span>
        <a href="/meli/respuestas-automaticas" class="bp-tab">🤖 Robot de respuestas</a>
        <a href="/meli/postventa-cafe" class="bp-tab">☕ Post-venta café</a>
    </div>

    <!-- Filtro sin responder / historial -->
    <div class="bp-filters">
        <button class="bp-filter @(tab == "pend" ? "active" : "")" @onclick='() => SwitchTab("pend")'>
            📥 Sin responder <span class="bp-pill">@(pend?.Count ?? 0)</span>
        </button>
        <button class="bp-filter @(tab == "hist" ? "active" : "")" @onclick='() => SwitchTab("hist")'>
            🗂️ Historial <span class="bp-pill muted">@(hist?.Count ?? 0)</span>
        </button>
        <span class="bp-filters-hint">Se actualiza sola cuando entran preguntas</span>
        @* 2026-08-31: el cotizador de alquileres, siempre a mano. Adentro de una pregunta el
           presupuesto cae en la respuesta; acá arriba se copia, para usarlo aunque no haya
           ninguna pregunta esperando. *@
        <button class="bp-filter bp-filter-cotiz @(cotizArriba ? "active" : "")"
                @onclick="() => cotizArriba = !cotizArriba">🎪 Cotizar alquiler</button>
    </div>

    @if (cotizArriba)
    {
        <div class="bp-cotiz bp-cotiz-arriba">
            <CotizadorAlquiler TextoBoton="📋 Copiar el presupuesto"
                               OnListo="CopiarCotizacionPreguntas" />
        </div>
    }

    @if (loading)
    {
        <div class="loading-container"><div class="spinner"></div><span>Cargando preguntas...</span></div>
    }
    else
    {
        <div class="bp-grid">

            <!-- IZQUIERDA: lista -->
            <div class="bp-col">
                <div class="card bp-listcard">
                    <div class="bp-card-h">@(tab == "pend" ? "Preguntas sin responder" : "Preguntas respondidas")</div>
                    <div class="bp-qlist">
                        @{ var visible = tab == "pend" ? pend : hist; }
                        @if (visible is null || visible.Count == 0)
                        {
                            <div class="bp-empty">✅<br />No hay preguntas acá.</div>
                        }
                        else
                        {
                            @foreach (var q in visible)
                            {
                                <button class="bp-qitem @(q.Id == selId ? "active" : "")" @onclick="() => Select(q.Id)">
                                    @if (!string.IsNullOrEmpty(q.ItemThumbnail))
                                    {
                                        <img class="bp-qthumb" src="@q.ItemThumbnail" alt="" onerror="this.style.visibility='hidden'" />
                                    }
                                    else
                                    {
                                        <div class="bp-qthumb bp-qthumb-ph">🛒</div>
                                    }
                                    <div class="bp-qmeta">
                                        <div class="bp-qtop">
                                            @if (q.IsNew) { <span class="bp-dot"></span> }
                                            <span class="bp-qbuyer">@(q.FromNickname ?? "Usuario")</span>
                                            @if (q.IsNew) { <span class="bp-badge-new">NUEVA</span> }
                                            @if (q.Status == "ANSWERED" && q.AutoAnswered) { <span class="bp-badge-robot">🤖</span> }
                                            <span class="bp-qtime">@FormatRelative(q.DateCreated)</span>
                                        </div>
                                        <div class="bp-qtext">@q.Text</div>
                                        <div class="bp-qtitle">
                                            🏷️ @(string.IsNullOrEmpty(q.ItemTitle) ? q.ItemId : q.ItemTitle)
                                            @{ var sm = ShipInfo(q.LogisticType); }
                                            @if (!string.IsNullOrEmpty(sm.label))
                                            {
                                                <span class="bp-ship @sm.cls bp-ship-mini">@sm.label</span>
                                            }
                                        </div>
                                    </div>
                                </button>
                            }
                        }
                    </div>
                </div>
            </div>

            <!-- CENTRO: conversación + respuesta -->
            <div class="bp-col">
                <div class="card bp-threadcard">
                    @if (selectedQ is null)
                    {
                        <div class="bp-empty" style="padding:60px 20px">👈<br />Elegí una pregunta de la lista.</div>
                    }
                    else
                    {
                        <div class="bp-thread-h">
                            @if (!string.IsNullOrEmpty(selectedQ.ItemThumbnail))
                            {
                                <img class="bp-qthumb bp-qthumb-lg" src="@selectedQ.ItemThumbnail" alt="" />
                            }
                            <div style="min-width:0">
                                <div class="bp-thread-title">@(string.IsNullOrEmpty(selectedQ.ItemTitle) ? selectedQ.ItemId : selectedQ.ItemTitle)</div>
                                <div class="bp-thread-sub">
                                    <span><b>Cuenta:</b> @(selectedQ.AccountNickname ?? "—")</span>
                                    <span><b>Cliente:</b> @(selectedQ.FromNickname ?? "Usuario")</span>
                                    @{ var sh = ShipInfo(detail?.Item?.LogisticType ?? selectedQ.LogisticType); }
                                    @if (!string.IsNullOrEmpty(sh.label))
                                    {
                                        <span class="bp-ship @sh.cls">@sh.icon @sh.label</span>
                                    }
                                    <span>@FormatRelative(selectedQ.DateCreated)</span>
                                    <a class="bp-link" href="@selectedQ.MeliUrl" target="_blank">Ver en MeLi ↗</a>
                                </div>
                            </div>
                        </div>

                        <div class="bp-bubbles">
                            <div class="bp-bubble q">
                                <div class="bp-who">@(selectedQ.FromNickname ?? "Usuario") pregunta</div>
                                @selectedQ.Text
                                <div class="bp-stamp">@FormatRelative(selectedQ.DateCreated)</div>
                            </div>
                            @if (selectedQ.Status == "ANSWERED" && !string.IsNullOrEmpty(selectedQ.AnswerText))
                            {
                                <div class="bp-bubble a">
                                    <div class="bp-who">@(selectedQ.AutoAnswered ? "🤖 Respuesta automática" : "Respuesta enviada")</div>
                                    @selectedQ.AnswerText
                                    <div class="bp-stamp">✔ Enviada @(selectedQ.DateAnswered.HasValue ? "· " + FormatRelative(selectedQ.DateAnswered.Value) : "")</div>
                                </div>
                            }
                        </div>

                        @if (selectedQ.Status == "UNANSWERED")
                        {
                            <div class="bp-reply">
                                <div class="bp-canned-lbl">
                                    ⚡ Respuestas rápidas
                                    <span class="bp-canned-hint">— tocá una para insertarla</span>
                                </div>
                                <div class="bp-chip-groups">
                                    @if (quickReplies.Count == 0)
                                    {
                                        <span class="bp-canned-hint">Todavía no cargaste respuestas rápidas.</span>
                                    }
                                    else
                                    {
                                        @foreach (var g in GroupedQuickReplies())
                                        {
                                            var cm = CatMeta(g.Key);
                                            <div class="bp-chip-group">
                                                <span class="bp-cat bp-cat-@cm.cls">@cm.icon @g.Key</span>
                                                @foreach (var c in g)
                                                {
                                                    <button class="bp-chip" title="@c.Text" @onclick="() => InsertCanned(c.Text)">@Corto(c.Text)</button>
                                                }
                                            </div>
                                        }
                                    }
                                    <div style="margin-top:4px">
                                        <button class="bp-chip bp-chip-manage" @onclick="OpenQuickReplies">✏️ Editar respuestas rápidas</button>
                                        @* 2026-08-31: cotizar un alquiler sin salir de la bandeja. Es el MISMO
                                           cotizador del chat de WhatsApp; acá el presupuesto cae en el cuadro
                                           de respuesta y se manda con "Responder", como cualquier otra. *@
                                        <button class="bp-chip bp-chip-cotiz @(mostrarCotizador ? "on" : "")"
                                                @onclick="() => mostrarCotizador = !mostrarCotizador">🎪 Cotizar alquiler</button>
                                    </div>
                                    @if (mostrarCotizador)
                                    {
                                        <div class="bp-cotiz">
                                            <div class="bp-cotiz-aviso">
                                                ⚠️ Ojo: la respuesta de MercadoLibre es <b>pública</b> — el presupuesto lo ve cualquiera que entre a la publicación.
                                            </div>
                                            <CotizadorAlquiler TextoBoton="📝 Poner en la respuesta"
                                                               OnListo="PonerCotizacionEnRespuesta" />
                                        </div>
                                    }
                                </div>
                                <div class="bp-composer">
                                    <textarea class="form-input bp-ta" rows="3" placeholder="Escribí tu respuesta..."
                                              @bind="draft" @bind:event="oninput"></textarea>
                                    <div class="bp-send-col">
                                        <button class="btn bp-send-btn" @onclick="Send" disabled="@(sending || string.IsNullOrWhiteSpace(draft))">
                                            @(sending ? "Enviando..." : "📤 Responder")
                                        </button>
                                        <span class="bp-counter @(draft.Length > 2000 ? "warn" : "")">@draft.Length / 2000</span>
                                    </div>
                                </div>
                            </div>
                        }
                    }
                </div>
            </div>

            <!-- DERECHA: detalle publicación + cliente -->
            <div class="bp-col">
                <div class="card">
                    <div class="bp-card-h">🏷️ Publicación</div>
                    <div class="bp-detail">
                        @if (loadingDetail)
                        {
                            <div class="bp-empty" style="padding:24px">Cargando...</div>
                        }
                        else if (detail?.Item is null)
                        {
                            <div class="bp-empty" style="padding:24px 16px; font-size:.85rem">
                                No tenemos esta publicación cacheada todavía.
                                @if (selectedQ is not null)
                                {
                                    <br /><a class="bp-link" href="@selectedQ.MeliUrl" target="_blank">Ver en MeLi ↗</a>
                                }
                            </div>
                        }
                        else
                        {
                            var it = detail.Item;
                            @if (!string.IsNullOrEmpty(it.Thumbnail))
                            {
                                <img class="bp-pub-photo" src="@it.Thumbnail" alt="" />
                            }
                            <div class="bp-pub-title">@it.Title</div>
                            <div class="bp-pub-priceline">
                                <span class="bp-price">$@it.Price.ToString("N0")</span>
                                @{ var si = ShipInfo(it.LogisticType); }
                                @if (!string.IsNullOrEmpty(si.label))
                                {
                                    <span class="bp-ship @si.cls">@si.icon @si.label</span>
                                }
                            </div>
                            <div class="bp-kv"><span class="k">Envío</span><span class="v">@ShipLabelFull(it.LogisticType)</span></div>
                            <div class="bp-kv"><span class="k">Stock</span><span class="v @(it.Stock <= 5 ? "low" : "ok")">@it.Stock u.@(it.Stock <= 5 ? " ⚠️" : "")</span></div>
                            @if (!string.IsNullOrEmpty(it.Sku))
                            {
                                <div class="bp-kv"><span class="k">SKU</span><span class="v">@it.Sku</span></div>
                            }
                            <div class="bp-kv"><span class="k">Publicación</span><span class="v">@it.ItemId</span></div>
                            @if (it.CatalogListing)
                            {
                                <div class="bp-kv"><span class="k">Catálogo</span><span class="v">Sí</span></div>
                            }
                            <div style="margin-top:12px">
                                <a class="btn btn-secondary btn-sm" style="width:100%; text-align:center" href="@(string.IsNullOrEmpty(it.Permalink) ? selectedQ?.MeliUrl : it.Permalink)" target="_blank">Ver en MeLi ↗</a>
                            </div>
                        }
                    </div>
                </div>

                <div class="card">
                    <div class="bp-card-h">👤 Quién pregunta</div>
                    <div class="bp-detail">
                        @if (detail?.Buyer is null)
                        {
                            <div class="bp-empty" style="padding:24px">—</div>
                        }
                        else
                        {
                            var b = detail.Buyer;
                            <div class="bp-buyer-row">
                                <div class="bp-avatar">@Iniciales(b.Nickname)</div>
                                <div style="min-width:0">
                                    <div class="bp-buyer-name">
                                        @if (!string.IsNullOrEmpty(b.ProfileUrl))
                                        {
                                            <a class="bp-buyer-link" href="@b.ProfileUrl" target="_blank"
                                               title="Abrir el perfil de @b.Nickname en MercadoLibre">@(b.Nickname ?? "Usuario") ↗</a>
                                        }
                                        else
                                        {
                                            @(b.Nickname ?? "Usuario")
                                        }
                                    </div>
                                    <div class="bp-buyer-id">
                                        ID @b.BuyerId
                                        @if (!string.IsNullOrEmpty(Ubicacion(b))) { <text> · @Ubicacion(b)</text> }
                                    </div>
                                </div>
                            </div>
                            @if (string.IsNullOrEmpty(b.ProfileUrl))
                            {
                                <div class="bp-buyer-nolink">
                                    MercadoLibre no nos dice el apodo de este comprador, así que no se puede abrir su perfil.
                                </div>
                            }
                            @if (b.IsKnown)
                            {
                                <div class="bp-kv"><span class="k">Ya compró</span><span class="v">@b.OrdersCount @(b.OrdersCount == 1 ? "vez" : "veces")</span></div>
                                @if (b.TotalSpent > 0)
                                {
                                    <div class="bp-kv"><span class="k">Total gastado</span><span class="v">$@b.TotalSpent.ToString("N0")</span></div>
                                }
                                @if (b.LastPurchaseAt.HasValue)
                                {
                                    <div class="bp-kv"><span class="k">Última compra</span><span class="v">@b.LastPurchaseAt.Value.ToLocalTime().ToString("dd/MM/yyyy")</span></div>
                                }
                                @if (!string.IsNullOrEmpty(b.Phone))
                                {
                                    <div class="bp-kv"><span class="k">Teléfono</span><span class="v">@b.Phone</span></div>
                                }
                                @* 2026-08-16: qué compró en cada visita anterior (últimas 10). Reemplaza al
                                   renglón "lo último que compró", que era lo mismo pero de una sola venta. *@
                                @if (b.Compras.Count > 0)
                                {
                                    <div class="bp-compras-h">🛒 Sus compras anteriores</div>
                                    <div class="bp-compras">
                                        @foreach (var c in b.Compras)
                                        {
                                            <div class="bp-compra">
                                                <div class="bp-compra-top">
                                                    <span class="bp-compra-fecha">@(c.Fecha.HasValue ? c.Fecha.Value.ToLocalTime().ToString("dd/MM/yy") : "—")</span>
                                                    <span class="bp-compra-total">$@c.Total.ToString("N0")</span>
                                                </div>
                                                <div class="bp-compra-items">@(string.IsNullOrWhiteSpace(c.Items) ? "(sin detalle)" : c.Items)</div>
                                                @if (!string.IsNullOrEmpty(c.Canal))
                                                {
                                                    <span class="bp-compra-canal">@c.Canal</span>
                                                }
                                            </div>
                                        }
                                    </div>
                                    @if (b.OrdersCount > b.Compras.Count)
                                    {
                                        <div class="bp-compras-mas">Se muestran las últimas @b.Compras.Count de @b.OrdersCount compras.</div>
                                    }
                                }
                                else if (!string.IsNullOrEmpty(b.LastItems))
                                {
                                    <div class="bp-buyer-last"><b>Lo último que compró:</b> @b.LastItems</div>
                                }
                            }
                            else
                            {
                                <div class="bp-empty" style="padding:12px 4px 0; font-size:.82rem; text-align:left; color:var(--text-muted,#6b7280)">
                                    Este comprador todavía no figura en tu base de clientes (aún no te compró). Cuando compre, vas a ver acá sus datos y su historial.
                                </div>
                            }
                        }
                    </div>
                </div>
            </div>

        </div>
    }

    @* ===== Modal: editar respuestas rápidas ===== *@
    @if (showQR)
    {
        <div class="bp-overlay" @onclick="CloseQuickReplies">
            <div class="bp-modal" @onclick:stopPropagation="true">
                <div class="bp-modal-h">
                    <div>
                        <h3 style="margin:0">⚡ Respuestas rápidas</h3>
                        <div style="font-size:.8rem; color:var(--text-muted,#6b7280); margin-top:2px">
                            Estas son tus respuestas para contestar rápido a mano. No son las del robot.
                        </div>
                    </div>
                    <button class="bp-modal-x" @onclick="CloseQuickReplies" aria-label="Cerrar">×</button>
                </div>
                <div class="bp-modal-b">
                    @if (qrEdit.Count == 0)
                    {
                        <p style="color:var(--text-muted,#6b7280); font-size:.85rem">No hay ninguna. Agregá la primera abajo 👇</p>
                    }
                    @for (int i = 0; i < qrEdit.Count; i++)
                    {
                        var idx = i;
                        <div class="bp-qr-item">
                            <div class="bp-qr-cats">
                                <span class="bp-qr-cats-lbl">Categoría:</span>
                                @foreach (var cat in Cats)
                                {
                                    <button class="bp-cat bp-cat-@cat.cls @(qrEdit[idx].Category == cat.name ? "sel" : "off")"
                                            @onclick="() => qrEdit[idx].Category = cat.name">@cat.icon @cat.name</button>
                                }
                            </div>
                            <div class="bp-qr-row">
                                <textarea class="form-input bp-qr-ta" rows="2" @bind="qrEdit[idx].Text" placeholder="Escribí una respuesta rápida..."></textarea>
                                <button class="btn btn-danger btn-sm" title="Borrar" @onclick="() => qrEdit.RemoveAt(idx)">🗑️</button>
                            </div>
                        </div>
                    }
                    <button class="btn btn-secondary btn-sm" style="margin-top:6px" @onclick="AddQuickReply">➕ Agregar respuesta</button>
                </div>
                <div class="bp-modal-f">
                    <button class="btn btn-secondary" @onclick="CloseQuickReplies">Cancelar</button>
                    <button class="btn bp-send-btn" @onclick="SaveQuickReplies" disabled="@savingQR">@(savingQR ? "Guardando..." : "💾 Guardar")</button>
                </div>
            </div>
        </div>
    }
</div>

@code {
    private List<MeliQuestionDto>? pend;
    private List<MeliQuestionDto>? hist;
    private string tab = "pend";
    private int? selId;
    private MeliQuestionDto? selectedQ;
    private MeliQuestionDetailDto? detail;
    private List<MeliQuickReplyDto> quickReplies = new();
    private string draft = "";
    private bool mostrarCotizador = false;
    private bool cotizArriba = false;
    private bool loading = true, loadingDetail, sending, refreshing;

    // Editor de respuestas rápidas
    private bool showQR, savingQR;
    private List<MeliQuickReplyDto> qrEdit = new();

    // Categorías predefinidas (botones, sin desplegables)
    private static readonly (string name, string icon, string cls)[] Cats =
    {
        ("Envío", "🚚", "envio"),
        ("Precio", "💲", "precio"),
        ("Stock", "📦", "stock"),
        ("Pago", "💳", "pago"),
        ("Retiro", "🏬", "retiro"),
        ("Otros", "💬", "otros")
    };

    private static (string icon, string cls) CatMeta(string cat)
    {
        foreach (var c in Cats) if (c.name == cat) return (c.icon, c.cls);
        return ("💬", "otros");
    }

    /// <summary>Agrupa las respuestas por categoría, en el orden de Cats (las desconocidas al final).</summary>
    private IEnumerable<IGrouping<string, MeliQuickReplyDto>> GroupedQuickReplies()
    {
        int Order(string cat)
        {
            for (int i = 0; i < Cats.Length; i++) if (Cats[i].name == cat) return i;
            return Cats.Length;
        }
        return quickReplies.GroupBy(q => string.IsNullOrWhiteSpace(q.Category) ? "Otros" : q.Category)
                           .OrderBy(g => Order(g.Key)).ThenBy(g => g.Key);
    }

    private void AddQuickReply() => qrEdit.Add(new MeliQuickReplyDto { Category = "Otros", Text = "" });

    protected override async Task OnInitializedAsync()
    {
        await LoadQuickReplies();
        await LoadLists(selectFirst: true);
        loading = false;
    }

    private async Task LoadQuickReplies()
    {
        try { quickReplies = await Api.GetMeliQuickRepliesAsync() ?? new(); }
        catch { quickReplies = new(); }
    }

    private void OpenQuickReplies()
    {
        // Copia profunda: si el usuario cancela, no tocamos la lista original.
        qrEdit = quickReplies.Select(q => new MeliQuickReplyDto { Category = q.Category, Text = q.Text }).ToList();
        showQR = true;
    }

    private void CloseQuickReplies() => showQR = false;

    private async Task SaveQuickReplies()
    {
        savingQR = true;
        try
        {
            var saved = await Api.SaveMeliQuickRepliesAsync(qrEdit);
            quickReplies = saved ?? qrEdit.Where(q => !string.IsNullOrWhiteSpace(q.Text)).ToList();
            showQR = false;
            Toast.Success("Respuestas rápidas guardadas");
        }
        catch (Exception ex) { Toast.Error("No se pudo guardar: " + ex.Message); }
        finally { savingQR = false; }
    }

    private async Task LoadLists(bool selectFirst)
    {
        try
        {
            pend = await Api.GetMeliQuestionsAsync("UNANSWERED") ?? new();
            hist = (await Api.GetMeliQuestionsAsync("ANSWERED") ?? new())
                .OrderByDescending(q => q.DateAnswered ?? q.DateCreated).ToList();
        }
        catch (Exception ex) { Toast.Error("No se pudo cargar: " + ex.Message); pend ??= new(); hist ??= new(); }

        if (selectFirst)
        {
            var first = (tab == "pend" ? pend : hist)?.FirstOrDefault();
            if (first is not null) await Select(first.Id);
            else { selId = null; selectedQ = null; detail = null; }
        }
    }

    private async Task Select(int id)
    {
        selId = id;
        draft = "";
        selectedQ = (pend?.FirstOrDefault(q => q.Id == id)) ?? (hist?.FirstOrDefault(q => q.Id == id));
        detail = null;
        loadingDetail = true;
        StateHasChanged();
        try { detail = await Api.GetMeliQuestionDetailAsync(id); }
        catch (Exception ex) { Toast.Error("No se pudo cargar el detalle: " + ex.Message); }
        finally { loadingDetail = false; }
    }

    /// <summary>El de arriba no tiene a quién responderle: copia el presupuesto para pegarlo donde sea.</summary>
    private async Task CopiarCotizacionPreguntas(string texto)
    {
        if (string.IsNullOrWhiteSpace(texto)) return;
        try
        {
            await JS.InvokeVoidAsync("copyToClipboard", texto);
            Toast.Success("Presupuesto copiado — pegalo donde quieras");
        }
        catch { Toast.Error("No se pudo copiar"); }
    }

    /// <summary>2026-08-31: el presupuesto armado cae en el cuadro de respuesta; lo manda él con "Responder".</summary>
    private void PonerCotizacionEnRespuesta(string texto)
    {
        if (string.IsNullOrWhiteSpace(texto)) return;
        draft = string.IsNullOrWhiteSpace(draft) ? texto : draft.TrimEnd() + "\n\n" + texto;
        mostrarCotizador = false;
        Toast.Success("Presupuesto puesto en la respuesta — revisalo y tocá Responder");
    }

    private void InsertCanned(string body)
    {
        if (string.IsNullOrWhiteSpace(body)) return;
        draft = string.IsNullOrWhiteSpace(draft) ? body : draft.TrimEnd() + " " + body;
    }

    private async Task Send()
    {
        if (selectedQ is null || string.IsNullOrWhiteSpace(draft)) return;
        sending = true;
        try
        {
            var ok = await Api.AnswerMeliQuestionAsync(selectedQ.Id, draft.Trim());
            if (ok)
            {
                Toast.Success("¡Respuesta enviada a MercadoLibre!");
                await LoadLists(selectFirst: false);
                // Nos quedamos en "sin responder" y pasamos a la siguiente
                var next = pend?.FirstOrDefault();
                if (next is not null) await Select(next.Id);
                else { selId = null; selectedQ = null; detail = null; }
            }
            else { Toast.Error("MeLi no aceptó la respuesta."); }
        }
        catch (Exception ex) { Toast.Error("No se pudo enviar: " + ex.Message); }
        finally { sending = false; }
    }

    private async Task Refrescar()
    {
        refreshing = true;
        try
        {
            await Api.SyncMeliQuestionsNowAsync();
            await LoadLists(selectFirst: selectedQ is null);
            Toast.Success("Lista actualizada");
        }
        catch (Exception ex) { Toast.Error("Error: " + ex.Message); }
        finally { refreshing = false; }
    }

    private async Task SwitchTab(string t)
    {
        tab = t;
        var first = (tab == "pend" ? pend : hist)?.FirstOrDefault();
        if (first is not null) await Select(first.Id);
        else { selId = null; selectedQ = null; detail = null; }
    }

    // ---- Helpers ----
    private static string Corto(string? s, int max = 46)
    {
        s = (s ?? "").Trim();
        return s.Length <= max ? s : s.Substring(0, max - 1).TrimEnd() + "…";
    }

    private static string Iniciales(string? nick)
    {
        nick = (nick ?? "").Trim();
        return nick.Length >= 2 ? nick.Substring(0, 2).ToUpperInvariant() : (nick.Length == 1 ? nick.ToUpperInvariant() : "US");
    }

    private static string Ubicacion(MeliBuyerBriefDto b)
    {
        var parts = new[] { b.City, b.State }.Where(s => !string.IsNullOrWhiteSpace(s));
        return string.Join(", ", parts);
    }

    /// <summary>Cartelito corto: (etiqueta, clase css, icono). Vacío si no sabemos el tipo.</summary>
    private static (string label, string cls, string icon) ShipInfo(string? lt)
    {
        switch ((lt ?? "").ToLowerInvariant())
        {
            case "self_service": return ("Flex", "flex", "⚡");
            case "fulfillment": return ("Full", "full", "🏬");
            case "me1":
            case "custom": return ("ME1", "me1", "🏷️");
            case "drop_off":
            case "cross_docking":
            case "xd_drop_off": return ("Correo", "correo", "📦");
            default: return ("", "", "");
        }
    }

    private static string ShipLabelFull(string? lt)
    {
        var s = ShipInfo(lt);
        return s.label switch
        {
            "Flex" => "⚡ Flex (reparto propio)",
            "Full" => "🏬 Full (depósito MeLi)",
            "ME1" => "🏷️ ME1 (despacho propio)",
            "Correo" => "📦 Correo (Mercado Envíos)",
            _ => "—"
        };
    }

    private static string FormatRelative(DateTime utc)
    {
        var d = DateTime.UtcNow - utc;
        if (d.TotalMinutes < 1) return "recién";
        if (d.TotalMinutes < 60) return $"hace {(int)d.TotalMinutes} min";
        if (d.TotalHours < 24) return $"hace {(int)d.TotalHours} h";
        if (d.TotalDays < 7) return $"hace {(int)d.TotalDays} d";
        return utc.ToLocalTime().ToString("dd/MM/yyyy");
    }
}

