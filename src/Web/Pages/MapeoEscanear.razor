@page "/mapeo/escanear"
@attribute [Authorize]
@layout EmptyLayout
@inject IJSRuntime JS
@inject ApiClient Api
@implements IAsyncDisposable

<PageTitle>Escanear Flex</PageTitle>

<div class="esc-shell">

    <div class="esc-head">
        <NavLink class="esc-volver" href="mapeo">← Volver al mapa</NavLink>
        <div class="esc-count"><span class="esc-count-num">@_agregadas</span> agregadas</div>
    </div>

    <div class="esc-hero">
        <div class="esc-hero-title">📷 Escanear paquetes Flex</div>
        <div class="esc-hero-sub">Apuntá al <b>QR</b> de cada etiqueta. Suena un "pip" y se agrega solo al mapa.</div>
    </div>

    <div id="reader" class="esc-reader @(_scanning ? "on" : "")">
        @if (!_scanning)
        {
            <div class="esc-reader-off">La cámara está apagada</div>
        }
    </div>

    @if (_last is not null)
    {
        <div class="esc-flash @FlashClass(_last)">
            <div class="esc-flash-ico">@FlashIco(_last)</div>
            <div class="esc-flash-body">
                <div class="esc-flash-msg">@(string.IsNullOrEmpty(_last.Nombre) ? _last.Mensaje : _last.Nombre)</div>
                <div class="esc-flash-sub">
                    @if (!string.IsNullOrEmpty(_last.Nombre)) { <span>@_last.Mensaje</span> }
                    @if (!string.IsNullOrEmpty(_last.Localidad)) { <span> · @_last.Localidad</span> }
                </div>
            </div>
        </div>
    }

    @if (!string.IsNullOrEmpty(_error))
    {
        <div class="esc-error">@_error</div>
    }

    @if (!_scanning)
    {
        <button class="esc-btn esc-btn-go" @onclick="StartAsync">▶ Empezar a escanear</button>
    }
    else
    {
        <button class="esc-btn esc-btn-stop" @onclick="StopAsync">■ Terminar</button>
    }

    <div class="esc-list-head">
        <span>Scaneados (@_historial.Count)</span>
        @if (_historial.Count > 0)
        {
            <button class="esc-clear" @onclick="() => _historial.Clear()">Limpiar</button>
        }
    </div>

    @if (_historial.Count == 0)
    {
        <p class="esc-empty">Todavía no scaneaste nada.</p>
    }
    else
    {
        <div class="esc-cards">
            @foreach (var h in _historial)
            {
                <div class="esc-card @FlashClass(h)">
                    <span class="esc-card-ico">@FlashIco(h)</span>
                    <span class="esc-card-txt">@(string.IsNullOrEmpty(h.Nombre) ? h.Mensaje : h.Nombre)</span>
                    <span class="esc-card-loc">@h.Localidad</span>
                </div>
            }
        </div>
    }
</div>

<style>
    body { background: #0f172a !important; }
    .esc-shell { max-width: 480px; margin: 0 auto; min-height: 100vh; padding: 12px 14px 28px; font-family: Inter, sans-serif; color: #e2e8f0; }
    .esc-head { display: flex; align-items: center; justify-content: space-between; padding: 4px 0 10px; }
    .esc-volver { color: #93c5fd; font-size: 14px; text-decoration: none; }
    .esc-count { background: #064e3b; color: #6ee7b7; border-radius: 999px; padding: 5px 14px; font-size: 13px; font-weight: 600; }
    .esc-count-num { font-size: 17px; font-weight: 800; color: #fff; }
    .esc-hero { text-align: center; margin: 6px 0 12px; }
    .esc-hero-title { font-size: 21px; font-weight: 800; color: #fff; }
    .esc-hero-sub { font-size: 13px; color: #94a3b8; margin-top: 4px; line-height: 1.4; }

    .esc-reader { width: 100%; aspect-ratio: 3 / 4; max-height: 58vh; background: #000; border-radius: 16px; overflow: hidden; display: flex; align-items: center; justify-content: center; border: 3px solid #1e293b; }
    .esc-reader.on { border-color: #16a34a; box-shadow: 0 0 0 3px rgba(22,163,74,0.25); }
    .esc-reader :is(video) { width: 100% !important; height: 100% !important; object-fit: cover; }
    .esc-reader-off { color: #475569; font-size: 14px; }

    .esc-flash { display: flex; gap: 12px; align-items: center; padding: 14px; border-radius: 14px; margin: 12px 0; }
    .esc-flash.ok { background: #052e1b; border: 1px solid #16a34a; }
    .esc-flash.warn { background: #3a2e05; border: 1px solid #d97706; }
    .esc-flash.err { background: #3b0d0d; border: 1px solid #dc2626; }
    .esc-flash-ico { font-size: 30px; font-weight: 900; width: 40px; text-align: center; }
    .esc-flash.ok .esc-flash-ico { color: #34d399; }
    .esc-flash.warn .esc-flash-ico { color: #fbbf24; }
    .esc-flash.err .esc-flash-ico { color: #f87171; }
    .esc-flash-msg { font-weight: 800; color: #fff; font-size: 17px; }
    .esc-flash-sub { color: #94a3b8; font-size: 13px; margin-top: 2px; }

    .esc-error { background: #3b0d0d; color: #fca5a5; border: 1px solid #dc2626; padding: 10px 12px; border-radius: 10px; font-size: 14px; margin: 10px 0; }

    .esc-btn { width: 100%; padding: 16px; font-size: 18px; font-weight: 800; color: #fff; border: none; border-radius: 14px; cursor: pointer; margin-top: 10px; }
    .esc-btn-go { background: #16a34a; }
    .esc-btn-stop { background: #dc2626; }

    .esc-list-head { display: flex; align-items: center; justify-content: space-between; margin-top: 20px; font-size: 15px; color: #cbd5e1; font-weight: 600; }
    .esc-clear { background: #1e293b; border: none; color: #94a3b8; padding: 6px 12px; border-radius: 8px; font-size: 13px; cursor: pointer; }
    .esc-empty { color: #64748b; font-size: 14px; }
    .esc-cards { display: flex; flex-direction: column; gap: 6px; margin-top: 10px; }
    .esc-card { display: flex; align-items: center; gap: 10px; background: #1e293b; border-radius: 10px; padding: 10px 12px; }
    .esc-card.ok { border-left: 4px solid #16a34a; }
    .esc-card.warn { border-left: 4px solid #d97706; }
    .esc-card.err { border-left: 4px solid #dc2626; }
    .esc-card-ico { font-weight: 900; }
    .esc-card.ok .esc-card-ico { color: #34d399; }
    .esc-card.warn .esc-card-ico { color: #fbbf24; }
    .esc-card.err .esc-card-ico { color: #f87171; }
    .esc-card-txt { flex: 1; color: #e2e8f0; font-size: 14px; }
    .esc-card-loc { color: #94a3b8; font-size: 12px; }
</style>

@code {
    private bool _scanning;
    private string? _error;
    private int _agregadas;
    private ScanFlexResult? _last;
    private DotNetObjectReference<MapeoEscanear>? _ref;
    private readonly List<ScanFlexResult> _historial = new();
    private string? _lastCode;
    private bool _processing;

    private static string FlashClass(ScanFlexResult r) => !r.Ok ? "err" : (r.YaEstaba ? "warn" : "ok");
    private static string FlashIco(ScanFlexResult r) => !r.Ok ? "✕" : (r.YaEstaba ? "↻" : "✓");

    private async Task StartAsync()
    {
        _error = null;
        _ref ??= DotNetObjectReference.Create(this);
        _scanning = true;
        await Task.Yield(); // dejar que el <div id="reader"> entre al DOM
        await JS.InvokeVoidAsync("scannerBarcode.start", "reader", _ref);
    }

    private async Task StopAsync()
    {
        _scanning = false;
        try { await JS.InvokeVoidAsync("scannerBarcode.stop"); } catch { }
    }

    [JSInvokable]
    public async Task OnScanDetected(string text, string format)
    {
        if (string.IsNullOrWhiteSpace(text) || _processing) return;
        if (text == _lastCode) return; // mismo QR seguido, no repetir
        _processing = true;
        _lastCode = text;
        try
        {
            var res = await Api.ScanFlexAsync(text);
            if (res is not null)
            {
                _last = res;
                _historial.Insert(0, res);
                if (res.Ok && !res.YaEstaba) _agregadas++;
                try { await JS.InvokeVoidAsync("scanBeep", res.Ok); } catch { }
            }
        }
        catch (Exception ex)
        {
            _error = "No pude agregar la parada: " + ex.Message;
            try { await JS.InvokeVoidAsync("scanBeep", false); } catch { }
        }
        finally
        {
            _processing = false;
            await InvokeAsync(StateHasChanged);
        }
    }

    [JSInvokable]
    public void OnScanError(string message)
    {
        _error = message;
        _scanning = false;
        InvokeAsync(StateHasChanged);
    }

    public async ValueTask DisposeAsync()
    {
        try { await JS.InvokeVoidAsync("scannerBarcode.stop"); } catch { }
        _ref?.Dispose();
    }
}
