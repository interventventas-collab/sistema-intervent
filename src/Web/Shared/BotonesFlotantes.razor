@* 2026-11-03: un solo botón abajo a la derecha en vez de los círculos sueltos (☀ resumen del día,
   WhatsApp y 💬 asistente). Al pasar el mouse (o tocarlo en el celu) se despliegan para arriba con su
   nombre; suma "Preguntas MeLi" para ir al respondedor desde cualquier pantalla.
   Cada ventana sigue siendo la de siempre: este botón solo llama a su Abrir(). *@
@inject NavigationManager Nav

@if (Items().Count > 0)
{
    <div class="bf @(abierto ? "bf-abierto" : "")" @onmouseenter="() => abierto = true" @onmouseleave="() => abierto = false">
        @if (abierto)
        {
            <div class="bf-lista">
                @foreach (var it in Items())
                {
                    <button type="button" class="bf-item" @onclick="() => Elegir(it)">
                        <span class="bf-lab">@it.Texto</span>
                        <span class="bf-circ @it.Clase">
                            @if (it.Icono == "wa")
                            {
                                <svg viewBox="0 0 24 24" fill="currentColor" width="24" height="24" aria-hidden="true"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51l-.57-.01c-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.872.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/></svg>
                            }
                            else
                            {
                                @it.Icono
                            }
                            @if (it.Numero > 0) { <span class="bf-num">@(it.Numero > 99 ? "99+" : it.Numero.ToString())</span> }
                        </span>
                    </button>
                }
            </div>
        }
        <button type="button" class="bf-main" title="Resumen del día, asistente, preguntas y WhatsApp" @onclick="() => abierto = !abierto">
            @(abierto ? "✕" : "☰")
            @if (!abierto && PreguntasSinResponder > 0) { <span class="bf-num">@(PreguntasSinResponder > 99 ? "99+" : PreguntasSinResponder.ToString())</span> }
        </button>
    </div>
}

<style>
    .bf { position: fixed; right: 22px; bottom: 22px; z-index: 9000; display: flex; flex-direction: column; align-items: flex-end; gap: 12px; }
    /* Colchón invisible para que el mouse no "se caiga" entre el botón y la lista. */
    .bf-abierto { padding: 12px 0 0 60px; }
    .bf-main { position: relative; width: 56px; height: 56px; border-radius: 50%; border: none; background: #1f2937; color: #fff;
        font-size: 24px; cursor: pointer; box-shadow: 0 6px 18px rgba(0,0,0,.28); display: flex; align-items: center; justify-content: center; }
    .bf-abierto .bf-main { background: #374151; }
    .bf-lista { display: flex; flex-direction: column; align-items: flex-end; gap: 12px; margin-right: 4px; animation: bf-sube .15s ease; }
    @@keyframes bf-sube { from { opacity: 0; transform: translateY(8px); } }
    .bf-item { display: flex; align-items: center; gap: 10px; background: none; border: none; padding: 0; cursor: pointer; }
    .bf-lab { background: #1f2937; color: #fff; font-size: 13px; padding: 5px 10px; border-radius: 7px; white-space: nowrap; }
    .bf-circ { position: relative; width: 48px; height: 48px; border-radius: 50%; background: #fff; border: 1px solid #e5e7eb; color: #111827;
        font-size: 21px; display: flex; align-items: center; justify-content: center; box-shadow: 0 3px 10px rgba(0,0,0,.16); }
    .bf-item:hover .bf-circ { transform: scale(1.06); }
    .bf-item:hover .bf-lab { background: #111827; }
    .bf-circ.bf-wa { background: #25d366; border-color: #25d366; color: #fff; }
    .bf-num { position: absolute; top: -4px; right: -4px; min-width: 20px; height: 20px; border-radius: 10px; background: #dc2626; color: #fff;
        font-size: 11px; font-weight: 700; display: flex; align-items: center; justify-content: center; padding: 0 5px; border: 2px solid #fff; }
    @@media (max-width: 768px) { .bf { right: 12px; bottom: 12px; } }
    @@media print { .bf { display: none !important; } }
</style>

@code {
    [Parameter] public BienvenidaVentana? Bienvenida { get; set; }
    [Parameter] public AssistantWidget? Asistente { get; set; }
    [Parameter] public WaBuscadorFlotante? WhatsApp { get; set; }
    [Parameter] public bool VePreguntas { get; set; }
    [Parameter] public int PreguntasSinResponder { get; set; }

    private bool abierto;

    private record Item(string Clave, string Texto, string Icono, string Clase, int Numero);

    // Se arma en cada dibujo: así toma si la bienvenida ya cargó, si hay mensajes del asistente, etc.
    private List<Item> Items()
    {
        var l = new List<Item>();
        if (Bienvenida?.Disponible == true)
            l.Add(new("bienvenida", Bienvenida.Trayendo ? "Resumen del día · trayendo movimientos…" : "Resumen del día", "☀", "", Bienvenida.Pendientes));
        if (Asistente is not null)
            l.Add(new("asistente", "Asistente", "💬", "", Asistente.SinLeer));
        if (VePreguntas)
            l.Add(new("preguntas", PreguntasSinResponder > 0 ? $"Preguntas MeLi · {PreguntasSinResponder} sin responder" : "Preguntas MeLi", "📥", "", PreguntasSinResponder));
        if (WhatsApp?.Disponible == true)
            l.Add(new("whatsapp", "WhatsApp", "wa", "bf-wa", 0));
        return l;
    }

    private async Task Elegir(Item it)
    {
        abierto = false;
        switch (it.Clave)
        {
            case "bienvenida": if (Bienvenida is not null) await Bienvenida.Abrir(); break;
            case "asistente": if (Asistente is not null) await Asistente.Abrir(); break;
            case "preguntas": Nav.NavigateTo("/meli/preguntas"); break;
            case "whatsapp": WhatsApp?.Abrir(); break;
        }
    }

    // El layout avisa cuando cambian cosas (la bienvenida terminó de cargar, llegó el conteo de preguntas).
    public void Refrescar() => InvokeAsync(StateHasChanged);
}
