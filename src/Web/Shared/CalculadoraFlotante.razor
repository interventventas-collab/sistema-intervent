    // ─── 2026-10-20: a quién + historial de presupuestos guardados ───
    private string quienNombre = "";
    private string quienTel = "";
    private bool verHistorial = false;
    private bool buscandoHist = false;
    private string histQ = "";
    private List<AlqCotizacionDto> histAlq = new();
    private List<CafeCotizacionChatDto> histProd = new();
    private CotizadorAlquiler? cotAlqRef;
    private CotizadorProductos? cotProdRef;
    private CancellationTokenSource? histCts;

    private bool HayQuien => !string.IsNullOrWhiteSpace(quienNombre) || quienTel.Any(char.IsDigit);
    private static string Plata(decimal v) => "$" + v.ToString(v == Math.Round(v) ? "N0" : "N2", ARS);
    private static string QuienDe(string? nombre, string? tel)
        => !string.IsNullOrWhiteSpace(nombre) && !string.IsNullOrWhiteSpace(tel) ? $"{nombre} · {tel}"
         : !string.IsNullOrWhiteSpace(nombre) ? nombre!
         : !string.IsNullOrWhiteSpace(tel) ? tel! : "(sin nombre)";

    private static string ResumenAlq(AlqCotizacionDto c)
    {
        if (c.Items.Count == 0) return "solo flete";
        var txt = string.Join(" + ", c.Items.Take(2).Select(i => $"{i.Cantidad} {i.Nombre}"));
        return c.Items.Count > 2 ? txt + $" +{c.Items.Count - 2} más" : txt;
    }

    private static string ResumenProd(CafeCotizacionChatDto c)
    {
        var txt = string.Join(" + ", c.Items.Take(2).Select(i => $"{i.Cantidad.ToString("0.##", ARS)} {i.Nombre}"));
        return c.Items.Count > 2 ? txt + $" +{c.Items.Count - 2} más" : txt;
    }

    private async Task ToggleHistorial()
    {
        verHistorial = !verHistorial;
        if (verHistorial) await CargarHistorialAsync();
    }

    private async Task OnBuscarHistorial(ChangeEventArgs e)
    {
        histQ = e.Value?.ToString() ?? "";
        histCts?.Cancel();
        histCts = new CancellationTokenSource();
        var token = histCts.Token;
        try { await Task.Delay(300, token); } catch (TaskCanceledException) { return; }
        await CargarHistorialAsync();
    }

    private async Task CargarHistorialAsync()
    {
        buscandoHist = true;
        StateHasChanged();
        try
        {
            if (tab == "alquiler") histAlq = await Api.BuscarAlqCotizacionesAsync(histQ) ?? new();
            else if (tab == "productos") histProd = await Api.BuscarCotizacionesChatAsync(histQ) ?? new();
        }
        catch { ToastService.Error("No pude traer los presupuestos guardados"); }
        finally { buscandoHist = false; StateHasChanged(); }
    }

    private async Task AlGuardar()
    {
        if (verHistorial) await CargarHistorialAsync();
    }

