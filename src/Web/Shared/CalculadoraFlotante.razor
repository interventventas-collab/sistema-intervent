    private async Task CambiarTab(string t)
    {
        tab = t;
        if (verHistorial && t is "alquiler" or "productos") await CargarHistorialAsync();
    }

    /// <summary>2026-10-20: el botón "CALCU ALQUILER" de la barra abre directo en una solapa.
    /// Si ya estaba abierta en esa misma solapa, la cierra (como el botón de CALCUPRECIOS).</summary>
    public async Task AbrirEnAsync(string t)
    {
        if (visible && tab == t) { Close(); return; }
        if (!visible) await OpenAsync();
        await CambiarTab(t);
        StateHasChanged();
    }

