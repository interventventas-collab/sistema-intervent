@* Calculadora flotante: ventanita arrastrable que se abre desde el botón de la topbar.
   Se puede mover a cualquier lado de la pantalla, recuerda la última posición en
   localStorage. Funciona en cualquier pantalla del sistema porque vive en MainLayout.
   Pedido del usuario 2026-05-28.
   2026-07-14: se agregó la solapa "Precios" — buscar un producto por código (costo sin IVA
   + sugerido) y calcular precio de venta poniendo el % que se le quiere ganar sobre el costo. *@

@using System.Globalization
@using Web.Models.Mobile
@inject IJSRuntime JS
@inject ApiClient Api
@inject ToastService ToastService
@inject Web.Services.Mobile.CatalogIndex Catalog
@inject Web.Services.OperatorService Op
@implements IAsyncDisposable

@if (visible)
{
    <div class="calc-floating" id="calc-floating"
         style="left: @(posX)px; top: @(posY)px;@SizeStyle">
        <div class="calc-header" @onmousedown="StartDrag" @ontouchstart="StartDragTouch">
            <span class="calc-title">🧮 Calculadora</span>
            <button class="calc-close" @onclick="Close" title="Cerrar">×</button>
        </div>

        @if (mostrarNovedad)
        {
            <div class="calc-novedad">✨ Nuevo · Calculadora de precios</div>
        }

        <div class="calc-tabs">
            <button class="calc-tab @(tab == "precios" ? "active" : "")" @onclick='() => tab = "precios"'>🏷️ Precios</button>
            <button class="calc-tab @(tab == "numeros" ? "active" : "")" @onclick='() => tab = "numeros"'>🔢 Números</button>
            <button class="calc-tab @(tab == "alquiler" ? "active" : "")" @onclick='() => CambiarTab("alquiler")'>🪑 Alquiler</button>
            <button class="calc-tab @(tab == "productos" ? "active" : "")" @onclick='() => CambiarTab("productos")'>🧮 Cotizar</button>
        </div>

        <div class="calc-body">
        @if (tab == "numeros")
        {
            <div class="calc-display" title="@history">@display</div>
            <div class="calc-grid">
                <button class="calc-btn calc-fn" @onclick="Clear">C</button>
                <button class="calc-btn calc-fn" @onclick="ClearEntry">CE</button>
                <button class="calc-btn calc-fn" @onclick="Backspace">⌫</button>
                <button class="calc-btn calc-op" @onclick='() => SetOperator("/")'>÷</button>

                <button class="calc-btn" @onclick='() => Digit("7")'>7</button>
                <button class="calc-btn" @onclick='() => Digit("8")'>8</button>
                <button class="calc-btn" @onclick='() => Digit("9")'>9</button>
                <button class="calc-btn calc-op" @onclick='() => SetOperator("*")'>×</button>

                <button class="calc-btn" @onclick='() => Digit("4")'>4</button>
                <button class="calc-btn" @onclick='() => Digit("5")'>5</button>
                <button class="calc-btn" @onclick='() => Digit("6")'>6</button>
                <button class="calc-btn calc-op" @onclick='() => SetOperator("-")'>−</button>

                <button class="calc-btn" @onclick='() => Digit("1")'>1</button>
                <button class="calc-btn" @onclick='() => Digit("2")'>2</button>
                <button class="calc-btn" @onclick='() => Digit("3")'>3</button>
                <button class="calc-btn calc-op" @onclick='() => SetOperator("+")'>+</button>

                <button class="calc-btn" @onclick="ToggleSign">±</button>
                <button class="calc-btn" @onclick='() => Digit("0")'>0</button>
                <button class="calc-btn" @onclick="Decimal">,</button>
                <button class="calc-btn calc-eq" @onclick="Equals">=</button>
            </div>
        }
        else if (tab == "alquiler" || tab == "productos")
        {
            @* 2026-08-31: la cotización la arma Shared/CotizadorAlquiler.razor — la MISMA pieza que
               usa el chat de WhatsApp. Acá el texto se copia al portapapeles para pegarlo donde sea.
               2026-10-20: el WhatsApp de la API ya no se usa y ahí vivían el historial y "pasar a
               reserva / venta". Ahora viven acá: todo presupuesto pide nombre O teléfono y queda
               guardado; la solapa 🧮 Cotizar trae el cotizador de PRODUCTOS (antes solo en el chat). *@
            <div class="ca-panel">
                <div class="cq-quien">
                    <div class="cq-quien-t">¿A quién se lo pasás? <span>nombre o teléfono, con uno alcanza</span></div>
                    <div class="cq-quien-f">
                        <input class="cq-inp" placeholder="Nombre" autocomplete="off"
                               @bind="quienNombre" @bind:event="oninput" />
                        <input class="cq-inp" placeholder="Teléfono" inputmode="tel" autocomplete="off"
                               @bind="quienTel" @bind:event="oninput" />
                    </div>
                </div>

                <div class="cq-hist">
                    <button class="cq-hist-tog" @onclick="ToggleHistorial">
                        📚 Presupuestos guardados @(verHistorial ? "▴" : "▾")
                    </button>
                    @if (verHistorial)
                    {
                        <input class="cq-inp" placeholder="Buscar por nombre o teléfono…" autocomplete="off"
                               value="@histQ" @oninput="OnBuscarHistorial" />
                        @if (buscandoHist)
                        {
                            <div class="cq-hist-vacio">Buscando…</div>
                        }
                        else if (tab == "alquiler")
                        {
                            @if (histAlq.Count == 0)
                            {
                                <div class="cq-hist-vacio">@(string.IsNullOrWhiteSpace(histQ) ? "Todavía no hay presupuestos guardados." : "No encontré presupuestos con eso.")</div>
                            }
                            @foreach (var c in histAlq)
                            {
                                <div class="cq-hist-i">
                                    <div class="cq-hist-l1">
                                        <span class="cq-hist-q">@QuienDe(c.Nombre, c.Telefono)</span>
                                        <b>@Plata(c.Total)</b>
                                    </div>
                                    <div class="cq-hist-l2">
                                        @c.CreatedAt.ToArTime().ToString("dd/MM/yy")@(string.IsNullOrWhiteSpace(c.Operador) ? "" : " · " + c.Operador)
                                        · @ResumenAlq(c)@(c.FechaEvento is DateTime fe ? $" · evento {fe:dd/MM}" : "")
                                    </div>
                                    <div class="cq-hist-acc">
                                        <button class="cq-hist-b" @onclick="() => RepetirAlq(c)" title="Cargarlo abajo para recotizar con los precios de hoy">↻ Repetir</button>
                                        <button class="cq-hist-b" @onclick="() => CopiarDeNuevo(c.Texto)" title="Copiar el mismo texto que se le pasó">📋 Copiar</button>
                                        @if (!string.IsNullOrWhiteSpace(c.ReservaNumero))
                                        {
                                            <button class="cq-hist-b cq-hist-ok" @onclick='() => AbrirEnPestana("/alquileres/reservas?openId=" + c.ReservaId)'>✅ Reservado @c.ReservaNumero</button>
                                        }
                                        else
                                        {
                                            <button class="cq-hist-b cq-hist-go" @onclick='() => AbrirEnPestana("/alquileres/reservas?cotizacion=" + c.Id)'
                                                    title="Abrir Nueva Reserva ya cargada con esto, en otra pestaña">📅 Pasar a reserva</button>
                                        }
                                    </div>
                                </div>
                            }
                        }
                        else
                        {
                            @if (histProd.Count == 0)
                            {
                                <div class="cq-hist-vacio">@(string.IsNullOrWhiteSpace(histQ) ? "Todavía no hay presupuestos guardados." : "No encontré presupuestos con eso.")</div>
                            }
                            @foreach (var c in histProd)
                            {
                                <div class="cq-hist-i">
                                    <div class="cq-hist-l1">
                                        <span class="cq-hist-q">@QuienDe(c.Nombre, c.Telefono)</span>
                                        <b>@Plata(c.Total) <small>@(c.ConIva ? "c/IVA" : "s/IVA")</small></b>
                                    </div>
                                    <div class="cq-hist-l2">
                                        @c.CreatedAt.ToArTime().ToString("dd/MM/yy")@(string.IsNullOrWhiteSpace(c.Operador) ? "" : " · " + c.Operador)
                                        · @ResumenProd(c)
                                    </div>
                                    <div class="cq-hist-acc">
                                        <button class="cq-hist-b" @onclick="() => CopiarDeNuevo(c.Texto)" title="Copiar el mismo texto que se le pasó">📋 Copiar</button>
                                        @if (!string.IsNullOrWhiteSpace(c.VentaNumero))
                                        {
                                            <span class="cq-hist-b cq-hist-ok" title="Este presupuesto ya se pasó a venta">✅ Venta @c.VentaNumero</span>
                                        }
                                        else
                                        {
                                            <button class="cq-hist-b cq-hist-go" @onclick='() => AbrirEnPestana("/cafe/ventas?desdePresupuesto=" + c.Id)'
                                                    title="Abrir Nueva Venta con estos productos, cantidades y precios, en otra pestaña">🛒 Pasar a venta</button>
                                        }
                                    </div>
                                </div>
                            }
                        }
                    }
                </div>

                @if (tab == "alquiler")
                {
                    <CotizadorAlquiler @ref="cotAlqRef" Oscuro="true" MostrarDescuento="true"
                                       TextoBoton="📋 Copiar y guardar el presupuesto"
                                       PedirAQuien="true" Nombre="@quienNombre" Telefono="@quienTel"
                                       Operador="@(Web.Services.OperatorService.FirmaCorta(Op.Current))"
                                       OnListo="CopiarCotizacion" OnGuardada="AlGuardar" />
                }
                else
                {
                    <div class="cq-claro">
                        <CotizadorProductos @ref="cotProdRef" TextoBoton="📋 Copiar y guardar el presupuesto"
                                            OnListo="CopiarYGuardarProductos" />
                    </div>
                }
            </div>
        }
        else
        {
            <div class="calc-precios">
                <div class="cp-search">
                    <input class="cp-input" placeholder="Escribí código o nombre…"
                           value="@codigoBusq" @oninput="OnCodigoInput" @onkeydown="OnCodigoKey" />
                    <button class="cp-buscar" @onclick="BuscarProducto"
                            disabled="@(buscandoProd || string.IsNullOrWhiteSpace(codigoBusq))">
                        @(buscandoProd ? "…" : "Buscar")
                    </button>
                </div>

                @if (sugerencias.Count > 0)
                {
                    <div class="cp-suggest">
                        @foreach (var s in sugerencias)
                        {
                            <button class="cp-sug-item" @onclick="() => SelectSugerencia(s)">
                                <span class="cp-sug-sku">@s.Sku</span>
                                <span class="cp-sug-name">@Trunc(s.Nombre, 32)</span>
                            </button>
                        }
                    </div>
                }

                @if (prodResult is not null && prodResult.Encontrado)
                {
                    <div class="cp-card">
                        <div class="cp-nombre">@prodResult.Nombre</div>
                        <div class="cp-sub">@prodResult.Sku · @prodResult.Categoria</div>
                        @if (!string.IsNullOrWhiteSpace(prodResult.Stock))
                        {
                            <div class="cp-row"><span>📦 Stock</span><b class="cp-stock">@prodResult.Stock</b></div>
                        }
                        <div class="cp-row"><span>Costo sin IVA</span><b>@Money(prodResult.CostoSinIva)</b></div>
                        @foreach (var l in prodResult.Precios)
                        {
                            <div class="cp-row cp-row-price">
                                <span>@l.Etiqueta</span>
                                <span class="cp-price-vals">
                                    <b class="cp-verde">@Money(l.SinIva)</b>
                                    <span class="cp-civa">c/IVA @Money(l.ConIva)</span>
                                </span>
                            </div>
                        }
                    </div>
                }
                else if (prodResult is not null && !prodResult.Encontrado)
                {
                    <div class="cp-msg">@prodResult.Mensaje</div>
                }

                <div class="cp-margen">
                    <div class="cp-margen-title">Calcular ganancia</div>
                    <div class="cp-field">
                        <label>Costo (sin IVA)</label>
                        <input class="cp-input" inputmode="decimal" placeholder="0"
                               @bind="costoStr" @bind:event="oninput" />
                    </div>
                    <div class="cp-field">
                        <label>Quiero ganar %</label>
                        <input class="cp-input" inputmode="decimal" placeholder="ej: 20"
                               @bind="pctStr" @bind:event="oninput" />
                    </div>

                    @if (PrecioSinIva is decimal pSin)
                    {
                        <div class="cp-result">
                            <div class="cp-row"><span>Precio venta (sin IVA)</span><b class="cp-verde">@Money(pSin)</b></div>
                            <div class="cp-row"><span>Precio venta (con IVA @FmtPct(ivaCalc)%)</span><b>@Money(PrecioConIva!.Value)</b></div>
                        </div>
                    }
                    else
                    {
                        <div class="cp-hint">Poné un costo y el % para ver el precio.</div>
                    }
                </div>
            </div>
        }
        </div>

        @if (mostrarNovedad)
        {
            <div class="calc-novedad-foot">
                <button @onclick="NoAbrirSola">ya la vi · no abrir sola</button>
            </div>
        }

        <div class="calc-resize" @onmousedown="StartResize" @ontouchstart="StartResizeTouch" title="Agrandar / achicar"></div>
    </div>
}

<style>
    .calc-floating {
        position: fixed;
        z-index: 9000;
        width: 268px;
        min-width: 240px; max-width: 560px;
        min-height: 200px; max-height: 92vh;
        display: flex; flex-direction: column;
        overflow: hidden;
        background: #1f2937;
        border-radius: 12px;
        box-shadow: 0 12px 30px rgba(0,0,0,0.35);
        color: #f9fafb;
        font-family: 'Segoe UI', sans-serif;
        user-select: none;
        -webkit-user-select: none;
    }
    .calc-header {
        background: #111827;
        padding: 0.5rem 0.75rem;
        display: flex;
        align-items: center;
        cursor: move;
        gap: 0.5rem;
        flex-shrink: 0;
    }
    .calc-body { flex: 1 1 auto; overflow-y: auto; min-height: 0; }
    .calc-novedad {
        background: #065f46; color: #d1fae5; font-size: 0.72rem;
        padding: 4px 10px; text-align: center; font-weight: 700; flex-shrink: 0;
    }
    .calc-novedad-foot {
        border-top: 1px solid #374151; padding: 5px; text-align: center; flex-shrink: 0;
    }
    .calc-novedad-foot button {
        background: none; border: none; color: #9ca3af; font-size: 0.74rem;
        text-decoration: underline; cursor: pointer;
    }
    .calc-novedad-foot button:hover { color: #f9fafb; }
    .calc-resize {
        position: absolute; right: 0; bottom: 0;
        width: 18px; height: 18px; cursor: nwse-resize; z-index: 3;
    }
    .calc-resize::after {
        content: ""; position: absolute; right: 3px; bottom: 3px;
        width: 9px; height: 9px;
        border-right: 2px solid #9ca3af; border-bottom: 2px solid #9ca3af;
        opacity: 0.7;
    }
    .calc-title { flex: 1; font-size: 0.82rem; font-weight: 700; }
    .calc-close {
        background: transparent;
        border: none;
        color: #f9fafb;
        font-size: 1.3rem;
        line-height: 1;
        padding: 0 0.4rem;
        cursor: pointer;
        border-radius: 4px;
    }
    .calc-close:hover { background: #dc2626; }

    /* Solapas */
    .calc-tabs { display: flex; gap: 4px; padding: 6px 8px 0; flex-shrink: 0; }
    .calc-tab {
        flex: 1; background: #374151; color: #d1d5db; border: none;
        padding: 0.45rem 0.3rem; font-size: 0.8rem; font-weight: 700;
        cursor: pointer; border-radius: 7px 7px 0 0;
    }
    .calc-tab:hover { background: #4b5563; }
    .calc-tab.active { background: #111827; color: #fff; }

    .calc-display {
        background: #111827;
        padding: 0.7rem 0.8rem;
        font-family: monospace;
        font-size: 1.4rem;
        font-weight: 800;
        text-align: right;
        min-height: 1.6rem;
        overflow-x: auto;
        border-bottom: 1px solid #374151;
        white-space: nowrap;
    }
    .calc-grid {
        display: grid;
        grid-template-columns: repeat(4, 1fr);
        gap: 4px;
        padding: 8px;
    }
    .calc-btn {
        background: #374151;
        color: #f9fafb;
        border: none;
        padding: 0.65rem 0.4rem;
        font-size: 1rem;
        font-weight: 700;
        cursor: pointer;
        border-radius: 6px;
        transition: background 0.05s;
    }
    .calc-btn:hover { background: #4b5563; }
    .calc-btn:active { transform: scale(0.95); }
    .calc-fn { background: #6b7280; }
    .calc-fn:hover { background: #7e8694; }
    .calc-op { background: #f59e0b; color: white; }
    .calc-op:hover { background: #d97706; }
    .calc-op.active { background: #fbbf24; }
    .calc-eq { background: #16a34a; color: white; }
    .calc-eq:hover { background: #15803d; }

    /* Panel Precios */
    .calc-precios {
        padding: 10px;
        user-select: text;
        -webkit-user-select: text;
    }
    .cp-search { display: flex; gap: 5px; margin-bottom: 8px; }
    .cp-input {
        flex: 1; width: 100%; box-sizing: border-box;
        background: #111827; border: 1px solid #374151; color: #f9fafb;
        border-radius: 6px; padding: 0.5rem 0.6rem; font-size: 0.9rem;
    }
    .cp-input:focus { outline: none; border-color: #3b82f6; }
    .cp-input::placeholder { color: #6b7280; }
    .cp-buscar {
        background: #2563eb; color: white; border: none; border-radius: 6px;
        padding: 0 0.8rem; font-size: 0.85rem; font-weight: 700; cursor: pointer;
    }
    .cp-buscar:hover:not(:disabled) { background: #1d4ed8; }
    .cp-buscar:disabled { opacity: 0.5; cursor: default; }

    /* Desplegable de sugerencias (busca mientras escribís, como en Nueva Venta) */
    .cp-suggest {
        background: #0b1220; border: 1px solid #374151; border-radius: 6px;
        margin: -3px 0 9px; max-height: 190px; overflow-y: auto;
    }
    .cp-sug-item {
        display: flex; flex-direction: column; align-items: flex-start; width: 100%;
        background: transparent; border: none; border-bottom: 1px solid #1f2937;
        color: #e5e7eb; padding: 6px 9px; cursor: pointer; text-align: left;
    }
    .cp-sug-item:last-child { border-bottom: none; }
    .cp-sug-item:hover { background: #1e293b; }
    .cp-sug-sku { font-family: monospace; font-weight: 700; font-size: 0.85rem; }
    .cp-sug-name { font-size: 0.72rem; color: #9ca3af; }

    .cp-card {
        background: #111827; border: 1px solid #374151; border-radius: 8px;
        padding: 0.6rem 0.7rem; margin-bottom: 10px;
    }
    .cp-nombre { font-weight: 700; font-size: 0.9rem; color: #e5e7eb; }
    .cp-sub { font-size: 0.75rem; color: #9ca3af; margin-bottom: 6px; }
    .cp-row {
        display: flex; justify-content: space-between; align-items: baseline;
        gap: 8px; font-size: 0.82rem; padding: 3px 0; color: #d1d5db;
    }
    .cp-row b { font-weight: 800; color: #f9fafb; }
    .cp-row-price { align-items: flex-start; }
    .cp-price-vals { display: flex; flex-direction: column; align-items: flex-end; }
    .cp-civa { font-size: 0.7rem; color: #9ca3af; font-weight: 400; }
    .cp-verde { color: #34d399 !important; }
    .cp-stock { color: #60a5fa !important; }
    .cp-msg {
        background: #7f1d1d; color: #fecaca; border-radius: 6px;
        padding: 0.5rem 0.6rem; font-size: 0.8rem; margin-bottom: 10px;
    }

    .cp-margen {
        background: #111827; border: 1px solid #374151; border-radius: 8px;
        padding: 0.6rem 0.7rem;
    }
    .cp-margen-title { font-weight: 700; font-size: 0.82rem; color: #93c5fd; margin-bottom: 8px; }
    .cp-field { margin-bottom: 8px; }
    .cp-field label { display: block; font-size: 0.72rem; color: #9ca3af; margin-bottom: 3px; }
    .cp-result { margin-top: 4px; border-top: 1px solid #374151; padding-top: 6px; }
    .cp-hint { font-size: 0.76rem; color: #6b7280; margin-top: 2px; }

    /* La solapa Alquiler ya no trae estilos propios: los pone el componente CotizadorAlquiler. */
    .ca-panel { padding: 10px; user-select: text; -webkit-user-select: text; }

    /* 2026-10-20: a quién + historial de presupuestos (alquiler y productos) */
    .cq-quien { margin-bottom: 8px; }
    .cq-quien-t { font-size: 0.76rem; font-weight: 700; color: #e5e7eb; margin-bottom: 4px; }
    .cq-quien-t span { font-weight: 400; color: #9ca3af; }
    .cq-quien-f { display: flex; gap: 6px; }
    .cq-inp { flex: 1; min-width: 0; width: 100%; box-sizing: border-box; background: #111827; color: #f9fafb;
        border: 1px solid #4b5563; border-radius: 6px; padding: 0.35rem 0.45rem; font-size: 0.8rem; font-family: inherit; }
    .cq-inp:focus { outline: none; border-color: #60a5fa; }
    .cq-hist { margin-bottom: 8px; }
    .cq-hist > .cq-inp { margin: 6px 0; }
    .cq-hist-tog { width: 100%; text-align: left; background: #374151; color: #e5e7eb; border: none; border-radius: 6px;
        padding: 0.35rem 0.5rem; font-size: 0.78rem; font-weight: 700; cursor: pointer; font-family: inherit; }
    .cq-hist-tog:hover { background: #4b5563; }
    .cq-hist-vacio { font-size: 0.76rem; color: #9ca3af; padding: 4px 2px; }
    .cq-hist-i { border-bottom: 1px solid #374151; padding: 6px 2px; }
    .cq-hist-l1 { display: flex; justify-content: space-between; gap: 6px; font-size: 0.8rem; }
    .cq-hist-q { font-weight: 700; color: #f9fafb; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
    .cq-hist-l1 small { font-weight: 400; color: #9ca3af; }
    .cq-hist-l2 { font-size: 0.72rem; color: #9ca3af; margin: 2px 0 4px; }
    .cq-hist-acc { display: flex; flex-wrap: wrap; gap: 4px; }
    .cq-hist-b { background: #374151; color: #e5e7eb; border: none; border-radius: 5px; padding: 0.2rem 0.45rem;
        font-size: 0.72rem; cursor: pointer; font-family: inherit; }
    .cq-hist-b:hover { background: #4b5563; }
    .cq-hist-go { background: #065f46; color: #d1fae5; }
    .cq-hist-ok { background: transparent; color: #6ee7b7; cursor: default; }
    /* El cotizador de productos es claro (viene del chat): va en su tarjeta blanca. */
    .cq-claro { background: #fff; color: #1f2937; border-radius: 8px; padding: 8px; }

</style>

@code {
    // Estado expuesto al MainLayout para poder abrir/cerrar desde el botón de la topbar.
    private bool visible = false;
    private string tab = "precios"; // "precios" | "numeros" | "alquiler" | "productos"
    private double posX = 100, posY = 100;
    private string display = "0";
    private string history = "";
    private double? acumulado = null;
    private string? operador = null;
    private bool esperandoNuevoNumero = true;
    private DotNetObjectReference<CalculadoraFlotante>? selfRef;
    private bool jsHooked = false;

    // ─── Estado del panel Precios ───
    private string codigoBusq = "";
    private bool buscandoProd = false;
    private CafePrecioConsultaDto? prodResult;
    private string costoStr = "";
    private string pctStr = "";
    private decimal ivaCalc = 21m;
    private List<CatalogItem> sugerencias = new();
    private bool catalogoCargado = false;
    private double? sizeW, sizeH;
    private bool mostrarNovedad = false;
    private string SizeStyle => (sizeW.HasValue && sizeH.HasValue)
        ? $" width:{sizeW.Value.ToString(CultureInfo.InvariantCulture)}px; height:{sizeH.Value.ToString(CultureInfo.InvariantCulture)}px;"
        // 2026-10-20: los cotizadores no entran en los 268 px de la calculadora: arrancan más anchos.
        : (tab is "alquiler" or "productos" ? " width:390px;" : "");

    private static readonly CultureInfo ARS = CultureInfo.GetCultureInfo("es-AR");
    private static string Money(decimal v) => "$" + v.ToString("N2", ARS);
    private static string FmtPct(decimal v) => v.ToString("0.##", ARS);

    private decimal? Costo => ParseNum(costoStr);
    private decimal? Pct => ParseNum(pctStr);
    private decimal? PrecioSinIva => (Costo is decimal c && c > 0m && Pct is decimal p)
        ? Math.Round(c * (1m + p / 100m), 2) : (decimal?)null;
    private decimal? PrecioConIva => PrecioSinIva is decimal ps
        ? Math.Round(ps * (1m + ivaCalc / 100m), 2) : (decimal?)null;

    public async Task ToggleAsync()
    {
        if (visible) { Close(); return; }
        await OpenAsync();
    }

    private async Task OpenAsync()
    {
        visible = true;

        // Cargar posición previa
        try
        {
            var saved = await JS.InvokeAsync<string?>("localStorage.getItem", "calc.position");
            if (!string.IsNullOrEmpty(saved))
            {
                var parts = saved.Split(',');
                if (parts.Length == 2 && double.TryParse(parts[0], out var x) && double.TryParse(parts[1], out var y))
                {
                    posX = x; posY = y;
                }
            }
        }
        catch { /* primera apertura */ }

        // Cargar tamaño previo (agrandar/achicar se recuerda)
        try
        {
            var s = await JS.InvokeAsync<string?>("localStorage.getItem", "calc.size");
            if (!string.IsNullOrEmpty(s))
            {
                var p = s.Split(',');
                if (p.Length == 2
                    && double.TryParse(p[0], NumberStyles.Any, CultureInfo.InvariantCulture, out var w)
                    && double.TryParse(p[1], NumberStyles.Any, CultureInfo.InvariantCulture, out var h))
                {
                    sizeW = w; sizeH = h;
                }
            }
        }
        catch { }

        // Registrar JS para drag + teclado físico de la solapa Números
        if (!jsHooked)
        {
            selfRef ??= DotNetObjectReference.Create(this);
            await JS.InvokeVoidAsync("registerCalcDrag", selfRef);
            await JS.InvokeVoidAsync("registerCalcKeys", selfRef);
            jsHooked = true;
        }

        // Cargar el catálogo (mismo motor que el buscador de Nueva Venta) para
        // buscar mientras se escribe. Es idempotente: si ya lo cargó otra pantalla, es instantáneo.
        if (!catalogoCargado)
        {
            try { await Catalog.EnsureLoadedAsync(); catalogoCargado = Catalog.Count > 0; }
            catch { /* si falla, el botón Buscar sigue andando contra el servidor */ }
        }

        // Marcar como usada — apaga el cartel "nuevo" del acceso de la barra.
        try { await JS.InvokeVoidAsync("localStorage.setItem", "calc.usada", "1"); } catch { }

        StateHasChanged();
    }

    // 2026-07-16: la calculadora YA NO se abre sola al entrar (pedido de Osmar: molestaba).
    // Queda solo el cartel "nuevo" titilante en el botón CALCUPRECIOS de la barra, que se
    // apaga cuando la usa (calc.usada). El aviso "no abrir sola" (mostrarNovedad) quedó sin
    // uso: nunca se prende porque ya no hay apertura automática.

    public bool IsVisible => visible;

    private void Close() { visible = false; mostrarNovedad = false; StateHasChanged(); }

