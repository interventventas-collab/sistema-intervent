@* 2026-08-06: Chat de WhatsApp FLOTANTE y ARRASTRABLE para el usuario Depósito.
   Vive en el layout, así que está disponible en CUALQUIER pantalla de la sesión.
   - Globito 💬 abajo a la derecha para abrirlo desde donde estés.
   - Al abrir, aparece una ventanita que se puede mover por toda la pantalla (se agarra del
     encabezado; funciona con mouse y con el dedo, reusa window.waDraggable).
   - Adentro va el mini-chat PinnedWaChat, que para Depósito ya trae la barrita de FIRMA.
   Solo se muestra si el usuario es de Depósito; los demás no lo ven.

   2026-08-28: los chats ya no están escritos acá. Salen de DepositoChats (los arma oficina desde
   el menú ⋮ de cada chat). Si hay más de uno, arriba aparece una fila para elegir cuál mirar. *@
@using Web.Services
@inject Web.Services.AuthService AuthSvc
@inject ApiClient Api
@inject Microsoft.JSInterop.IJSRuntime JS

@if (esDeposito && Chats.Count > 0)
{
    @if (!abierto)
    {
        <button class="depwa-bubble" @onclick="Abrir" title="Abrir el chat de WhatsApp">
            <span class="depwa-bubble-ic">💬</span>
        </button>
    }
    else
    {
        <div class="depwa-panel" id="dep-wa-panel">
            <div class="depwa-bar">
                @* El "agarre" para arrastrar es el título, así el botón ✕ sigue tocable en el celu. *@
                <span class="depwa-bar-title" id="dep-wa-handle">💬 WhatsApp — @Actual.TituloLindo</span>
                @* 2026-08-28: agrandar = abrir el chat en OTRA VENTANA del navegador, así lo pueden
                   dejar a un costado o en el segundo monitor. Pantalla: Pages/DepositoWhatsApp.razor. *@
                <button type="button" class="depwa-bar-btn" @onclick="AbrirEnVentanaAparte"
                        title="Abrir el chat en una ventana aparte, a pantalla completa">⤢</button>
                <button type="button" class="depwa-bar-btn" @onclick="Cerrar" title="Cerrar (queda el globito abajo)">✕</button>
            </div>
            @* Con un solo chat no hay nada que elegir: la fila aparece recién con el segundo. *@
            @if (Chats.Count > 1)
            {
                <div class="depwa-tabs">
                    @foreach (var c in Chats)
                    {
                        <button type="button" class="depwa-tab @(EsActual(c) ? "on" : "")"
                                @onclick="() => Elegir(c)" title="@c.TituloLindo">@c.TituloLindo</button>
                    }
                </div>
            }
            <div class="depwa-body">
                <PinnedWaChat @key="@(Actual.Numero + "|" + Actual.LineaPhoneId)"
                              Numero="@Actual.Numero" LineaPhoneId="@Actual.LineaPhoneId"
                              TituloContacto="@Actual.TituloLindo" NombreLinea="@Actual.LineaNombre"
                              PuedeAbrirEnGrande="false" />
            </div>
        </div>
    }
}

<style>
    /* 2026-08-06: bottom 86px (no 22) para que NO tape el botón de Ayuda de IA (assistant-fab). */
    .depwa-bubble {
        position: fixed; right: 22px; bottom: 86px; z-index: 8500;
        width: 58px; height: 58px; border-radius: 50%; border: none;
        background: #25d366; color: #fff; cursor: pointer;
        box-shadow: 0 8px 22px rgba(37,211,102,0.45);
        display: flex; align-items: center; justify-content: center;
        animation: depwa-pop 0.2s ease;
    }
    .depwa-bubble:hover { filter: brightness(1.05); transform: translateY(-1px); }
    .depwa-bubble-ic { font-size: 26px; line-height: 1; }
    @@keyframes depwa-pop { from { transform: scale(0.7); opacity: 0; } to { transform: scale(1); opacity: 1; } }

    .depwa-panel {
        position: fixed; right: 22px; bottom: 86px; z-index: 8500;
        width: 360px; height: 540px; max-height: calc(100vh - 110px);
        display: flex; flex-direction: column;
        background: #fff; border-radius: 16px; overflow: hidden;
        box-shadow: 0 16px 40px rgba(0,0,0,0.30);
        animation: depwa-pop 0.18s ease;
    }
    .depwa-bar {
        display: flex; align-items: center; justify-content: space-between; gap: 8px;
        background: #0b7a4b; color: #fff; padding: 8px 12px;
        user-select: none;
    }
    .depwa-bar-title { font-weight: 800; font-size: 0.9rem; flex: 1; cursor: move; touch-action: none;
        white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
    .depwa-bar-btn { background: rgba(255,255,255,0.18); border: none; color: #fff;
        border-radius: 7px; width: 28px; height: 26px; cursor: pointer; font-size: 0.85rem;
        flex: none; display: flex; align-items: center; justify-content: center; }
    .depwa-bar-btn:hover { background: rgba(255,255,255,0.34); }
    /* 2026-08-28: fila para elegir chat (solo si hay más de uno) */
    .depwa-tabs { display: flex; gap: 4px; padding: 6px 8px; background: #e7f3ec;
        border-bottom: 1px solid #cfe3d8; overflow-x: auto; flex: none; }
    .depwa-tab { flex: none; max-width: 150px; background: #fff; border: 1px solid #cfe3d8;
        border-radius: 999px; padding: 3px 10px; font-size: 0.76rem; color: #0b7a4b; cursor: pointer;
        white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
    .depwa-tab.on { background: #0b7a4b; border-color: #0b7a4b; color: #fff; font-weight: 800; }
    .depwa-body { flex: 1; min-height: 0; }
    /* PinnedWaChat trae su propio marco; adentro del panel lo dejamos a ras. */
    .depwa-body .pwa-card { height: 100%; min-height: 0; border: none; border-radius: 0; box-shadow: none; }

    /* En el celu: pantalla completa. !important para que gane aunque se haya arrastrado. */
    @@media (max-width: 640px) {
        .depwa-panel { inset: 0 !important; width: auto !important; height: auto !important;
            max-height: none !important; border-radius: 0; }
    }
</style>

@code {
    private bool esDeposito;
    private bool abierto;
    private bool _attachPending;
    private DepositoChats.ChatRef? elegido;

    private IReadOnlyList<DepositoChats.ChatRef> Chats => DepositoChats.Chats;
    private DepositoChats.ChatRef Actual => elegido ?? Chats[0];
    private bool EsActual(DepositoChats.ChatRef c)
        => c.Numero == Actual.Numero && c.LineaPhoneId == Actual.LineaPhoneId;

    private void Elegir(DepositoChats.ChatRef c) { elegido = c; StateHasChanged(); }

    protected override async Task OnInitializedAsync()
    {
        try
        {
            var user = await AuthSvc.GetUserAsync();
            var perms = user?.Permissions ?? new();
            esDeposito = perms.Contains("deposito") && !perms.Contains("cafe") && !perms.Contains("oficina");
        }
        catch { esDeposito = false; }

        if (esDeposito)
        {
            // Qué chats le asignaron. Si oficina le suma otro, aparece al recargar la pantalla.
            await DepositoChats.CargarAsync(Api);
            StateHasChanged();
        }
    }

    /// <summary>Abre la ventanita flotante (la puede llamar el layout desde el ítem del menú).</summary>
    public void Abrir() { abierto = true; _attachPending = true; StateHasChanged(); }

    /// <summary>Abre el chat a pantalla completa en OTRA ventana del navegador.</summary>
    private async Task AbrirEnVentanaAparte()
    {
        try { await JS.InvokeVoidAsync("open", "/deposito/whatsapp", "depwaFull", "width=1100,height=860"); }
        catch { }
    }

    public void Cerrar() { abierto = false; StateHasChanged(); }
    public void Toggle() { if (abierto) Cerrar(); else Abrir(); }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        // Cuando se abre, enganchamos el arrastre por el encabezado (mouse + dedo).
        if (_attachPending && abierto)
        {
            _attachPending = false;
            try { await JS.InvokeVoidAsync("waDraggable.attach", "dep-wa-handle", "dep-wa-panel"); }
            catch { }
        }
    }
}
