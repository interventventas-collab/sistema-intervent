@* 21/10/2026: Oficina → 🕐 Fichaje. Lo de la tarjeta "Equipo trabajando ahora" del Dashboard, para
   cualquier día: quién entró, quién salió y quién no fichó (en rojo). Solo mirar: los horarios se
   corrigen desde la compu (Horario). *@
@using System.Globalization
@using System.Net.Http.Json
@inject HttpClient Http

<div class="mpc-overlay">
    <div class="mpc-wrap">
        <div class="mpc-top">
            <button type="button" class="mpc-back" @onclick="OnCerrar">←</button>
            <div class="mpc-title">🕐 Fichaje</div>
        </div>
        <div class="mpc-chips">
            <span class="mpc-chip @(dia == Hoy ? "on" : "")" @onclick="() => ElegirDia(Hoy)">Hoy</span>
            <span class="mpc-chip @(dia == Hoy.AddDays(-1) ? "on" : "")" @onclick="() => ElegirDia(Hoy.AddDays(-1))">Ayer</span>
            @if (eligeDia || (dia != Hoy && dia != Hoy.AddDays(-1)))
            {
                <input class="mpc-dia-input" type="date" value="@dia.ToString("yyyy-MM-dd")" @onchange="OnDiaInput" />
            }
            else
            {
                <span class="mpc-chip" @onclick="() => eligeDia = true">📅 Elegir día</span>
            }
        </div>

        @if (cargando && filas.Count == 0)
        {
            <div class="mpc-nota">Buscando…</div>
        }
        else if (error)
        {
            <div class="mpc-nota">No se pudo traer el fichaje. <button type="button" class="mpc-mas" @onclick="Cargar">🔄 Reintentar</button></div>
        }
        else if (filas.Count == 0)
        {
            <div class="mpc-nota">No hay empleados para mostrar.</div>
        }
        else
        {
            var trabajando = filas.Count(f => f.Estado == "trabajando");
            var salio = filas.Count(f => f.Estado == "salio");
            var sinFichar = filas.Count(f => f.Estado == "sin-fichar");
            <div class="mpc-dia">@DiaTexto(dia)</div>
            <div class="mpc-est" style="margin:0 0.15rem 0.45rem;">
                @if (dia == Hoy) { <text>@trabajando trabajando · </text> }
                @salio @(salio == 1 ? "salió" : "salieron")
                @if (sinFichar > 0) { <span class="mpc-pend"> · @sinFichar sin fichar</span> }
            </div>
            <div class="mpc-row" style="padding:0;">
                @foreach (var f in filas)
                {
                    <div style="padding:0.6rem 0.75rem; border-bottom:1px solid #f3f4f6;">
                        <div class="mpc-r1"><span class="mpc-cli" style="@(f.Estado == "no-trabaja" ? "color:#9ca3af;" : "")">@f.Nombre</span></div>
                        <div class="mpc-est" style="color:#6b7280;">
                            @switch (f.Estado)
                            {
                                case "trabajando": <text>entró @f.Entrada@(f.Trabajado is null ? "" : $" · trabajando hace {f.Trabajado}")</text> break;
                                case "salio": <text>entró @f.Entrada · salió @f.Salida@(f.Trabajado is null ? "" : $" · {f.Trabajado}")</text> break;
                                case "sin-salida": <text>entró @f.Entrada · </text><span class="mpc-pend">no fichó la salida</span> break;
                                case "sin-fichar": <span class="mpc-pend">sin fichar</span> break;
                                default: <text>no trabaja este día</text> break;
                            }
                        </div>
                    </div>
                }
            </div>
            <div class="mpc-nota" style="font-size:0.75rem;">Solo mirar: un horario se corrige desde la compu (Horario).</div>
        }
    </div>
</div>

@code {
    [Parameter, EditorRequired] public string Token { get; set; } = "";
    [Parameter] public EventCallback OnCerrar { get; set; }

    public record FichajeDto(string Nombre, string Estado, string? Entrada, string? Salida, string? Trabajado);

    private static readonly CultureInfo Ar = CultureInfo.GetCultureInfo("es-AR");
    private static DateTime Hoy => DateTime.UtcNow.AddHours(-3).Date;
    private DateTime dia = Hoy;
    private List<FichajeDto> filas = new();
    private bool cargando = true, error, eligeDia;

    protected override Task OnInitializedAsync() => Cargar();

    private async Task Cargar()
    {
        cargando = true; error = false;
        StateHasChanged();
        try
        {
            var buscado = dia;
            var r = await Http.GetFromJsonAsync<List<FichajeDto>>($"api/horas-extras/repartidor/{Token}/fichaje?dia={dia:yyyy-MM-dd}");
            if (buscado != dia) return;
            filas = r ?? new();
        }
        catch { error = true; }
        finally { cargando = false; StateHasChanged(); }
    }

    private async Task ElegirDia(DateTime d)
    {
        dia = d;
        eligeDia = false;
        await Cargar();
    }

    private async Task OnDiaInput(ChangeEventArgs e)
    {
        if (DateTime.TryParse(e.Value?.ToString(), out var d)) { dia = d.Date; await Cargar(); }
    }

    private static string DiaTexto(DateTime d)
    {
        var nombre = d.ToString("dddd dd/MM", Ar);
        if (d == Hoy) return "Hoy · " + nombre;
        if (d == Hoy.AddDays(-1)) return "Ayer · " + nombre;
        return nombre;
    }
}
