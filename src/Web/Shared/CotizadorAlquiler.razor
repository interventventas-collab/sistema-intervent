    .cotalq-dark .cotalq-btn-main:disabled { background: #374151; color: #9ca3af; }
    .cotalq-dark .cotalq-info { color: #6b7280; }
</style>

@code {
    /// <summary>Texto del botón principal ("📝 Escribir la cotización", "📋 Copiar"…).</summary>
    [Parameter] public string TextoBoton { get; set; } = "📝 Escribir la cotización";

    /// <summary>Se dispara con el presupuesto ya armado. El que lo usa decide qué hacer con el texto.</summary>
    [Parameter] public EventCallback<string> OnListo { get; set; }

    /// <summary>Colores para fondo oscuro (la calculadora flotante).</summary>
    [Parameter] public bool Oscuro { get; set; }

    /// <summary>Casillero de descuento: baja el total pero NO sale en el texto del cliente.</summary>
    [Parameter] public bool MostrarDescuento { get; set; }

    /// <summary>
    /// Teléfono del chat. Si viene, la cotización QUEDA GUARDADA contra ese teléfono al darle al
    /// botón — así, si el mismo número escribe en tres meses, está a mano lo que se le presupuestó.
    /// Sin teléfono (calculadora flotante, preguntas de MeLi) no se guarda nada.
    /// </summary>
    [Parameter] public string? Telefono { get; set; }

    /// <summary>Si el chat ya está vinculado a un cliente, queda anotado en la cotización.</summary>
    [Parameter] public int? ClienteId { get; set; }

    /// <summary>Quién la hizo (operador del PIN).</summary>
    [Parameter] public string? Operador { get; set; }

    /// <summary>Se dispara cuando la cotización quedó guardada (para refrescar el historial).</summary>
    [Parameter] public EventCallback OnGuardada { get; set; }

    private List<AlqEquipoDto> equipos = new();
    private List<AlqFleteDto> fletes = new();
    private readonly Dictionary<int, int> cant = new();
    private readonly Dictionary<int, string> cantTxt = new();
    private string filtro = "";
    private string fleteSel = "";
    private string fleteZona = "";
    private string fleteTxt = "";
    private string descuentoTxt = "";
    private DateTime? fecha = null;
    private bool cargando = true;

    protected override async Task OnInitializedAsync() => await Cargar();

    private async Task Cargar()
    {
        cargando = true;
        try
        {
            // Vienen en el orden que él armó en Alquileres → Equipos (flechitas ↑↓): NO reordenar acá.
            var eqs = await Api.GetAlqEquiposAsync();
            equipos = (eqs ?? new()).Where(e => e.IsActive).ToList();
            fletes = await Api.GetAlqFletesAsync(soloActivos: true) ?? new();
        }
        catch (Exception ex) { Toast.Error("No pude traer los precios: " + ex.Message); }
        finally { cargando = false; }
    }

    private int CantDe(int id) => cant.TryGetValue(id, out var n) ? n : 0;
    private string CantTxtDe(int id) => cantTxt.TryGetValue(id, out var t) ? t : "0";

    private decimal FleteMonto => ParsePlata(fleteTxt) ?? 0m;
    private decimal Descuento => MostrarDescuento ? (ParsePlata(descuentoTxt) ?? 0m) : 0m;
    private decimal Total => equipos.Sum(e => e.PrecioDiario * CantDe(e.Id)) + FleteMonto - Descuento;
    private bool HayAlgo => equipos.Any(e => CantDe(e.Id) > 0);

    private List<AlqEquipoDto> Visibles()
    {
        var q = (filtro ?? "").Trim();
        if (q.Length == 0) return equipos;
        return equipos
            .Where(x => x.Nombre.Contains(q, StringComparison.OrdinalIgnoreCase)
                     || x.Sku.Contains(q, StringComparison.OrdinalIgnoreCase))
            .ToList();
    }

    private void OnFiltrar(ChangeEventArgs e) => filtro = e.Value?.ToString() ?? "";
    private void OnMontoFlete(ChangeEventArgs e) => fleteTxt = e.Value?.ToString() ?? "";
    private void OnDescuento(ChangeEventArgs e) => descuentoTxt = e.Value?.ToString() ?? "";

    private void Sumar(int id, int delta)
    {
        var n = Math.Max(0, CantDe(id) + delta);
        cant[id] = n;
        cantTxt[id] = n.ToString();
    }

    // Se ata a TEXTO, no a número: atado a int, borrar el campo lo deja en 0 y tipear 1 da 10.
    private void CambiarCant(int id, string? txt)
    {
        var t = (txt ?? "").Trim();
        cantTxt[id] = t;
        cant[id] = int.TryParse(t, out var n) && n > 0 ? n : 0;
    }

    private void ElegirFlete(ChangeEventArgs e)
    {
        fleteSel = e.Value?.ToString() ?? "";
        if (!int.TryParse(fleteSel, out var id)) { fleteZona = ""; fleteTxt = ""; return; }
        var f = fletes.FirstOrDefault(x => x.Id == id);
        if (f is null) return;
        fleteZona = f.Zona;
        fleteTxt = f.Precio.ToString("0.##", ARS);
    }

    /// <summary>Vacía la cotización. Se puede llamar desde afuera (ej. al cambiar de chat).</summary>
    public void Limpiar()
    {
        cant.Clear(); cantTxt.Clear();
        filtro = ""; fleteSel = ""; fleteZona = ""; fleteTxt = "";
        descuentoTxt = ""; fecha = null;
        StateHasChanged();
    }

    private async Task Listo()
    {
        var texto = ArmarTexto();
        await OnListo.InvokeAsync(texto);
        await GuardarSiHayTelefono(texto);
    }

    /// <summary>Deja el presupuesto guardado contra el teléfono. Si falla, no molesta: el
    /// presupuesto ya está escrito y lo importante es que lo pueda mandar.</summary>
    private async Task GuardarSiHayTelefono(string texto)
    {
        var tel = new string((Telefono ?? "").Where(char.IsDigit).ToArray());
        if (tel.Length == 0) return;

        try
        {
            var req = new CrearAlqCotizacionRequest
            {
                Telefono = tel,
                ClienteId = ClienteId,
                FechaEvento = fecha,
                FleteZona = fleteZona,
                FleteMonto = FleteMonto,
                Descuento = Descuento,
                Texto = texto,
                Operador = Operador,
                Items = equipos
                    .Where(e => CantDe(e.Id) > 0)
                    .Select(e => new CrearAlqCotizacionItemRequest
                    {
                        EquipoId = e.Id,
                        Nombre = e.Nombre,          // congelado: en 3 meses el nombre puede cambiar
                        Cantidad = CantDe(e.Id),
                        PrecioUnitario = e.PrecioDiario   // congelado: el precio de HOY
                    }).ToList()
            };
            var guardada = await Api.CrearAlqCotizacionAsync(req);
            if (guardada is not null) await OnGuardada.InvokeAsync();
        }
        catch { /* que no se pierda el presupuesto por no poder guardarlo */ }
    }

    /// <summary>
    /// Carga una cotización vieja para repetirla. Los precios se recalculan con los de HOY
    /// (por eso avisa si alguno cambió): la vieja queda guardada tal cual se le pasó.
    /// </summary>
    public void CargarDesde(AlqCotizacionDto cot)
    {
        cant.Clear(); cantTxt.Clear();
        var faltan = 0;
        foreach (var it in cot.Items)
        {
            var eq = it.EquipoId is int eid ? equipos.FirstOrDefault(e => e.Id == eid) : null;
            if (eq is null) { faltan++; continue; }
            cant[eq.Id] = it.Cantidad;
            cantTxt[eq.Id] = it.Cantidad.ToString();
        }

        fecha = cot.FechaEvento;
        fleteZona = cot.FleteZona ?? "";
        fleteTxt = cot.FleteMonto > 0m ? cot.FleteMonto.ToString("0.##", ARS) : "";
        fleteSel = fletes.FirstOrDefault(f => f.Zona == cot.FleteZona)?.Id.ToString() ?? "";
        descuentoTxt = cot.Descuento > 0m ? cot.Descuento.ToString("0.##", ARS) : "";

        if (faltan > 0)
            Toast.Warning($"{faltan} cosa(s) de esa cotización ya no están en el catálogo: revisá antes de mandar.");
        else if (Total != cot.Total)
            Toast.Info("Ojo: con los precios de hoy el total da distinto al de esa cotización.");

        StateHasChanged();
    }

    /// <summary>
    /// El presupuesto como lo lee el cliente: qué y cuánto, SIN precio por renglón.
    /// El único importe es el TOTAL (pedido expreso del dueño).
    /// </summary>
    public string ArmarTexto()
    {
        var sb = new System.Text.StringBuilder();
        sb.AppendLine("*Presupuesto*");
        if (fecha is DateTime f) sb.AppendLine($"Fecha: {f:dd/MM/yyyy}");
        sb.AppendLine();

        foreach (var eq in equipos)
        {
            var c = CantDe(eq.Id);
            if (c > 0) sb.AppendLine($"{c} x {eq.Nombre}");
        }

        if (FleteMonto != 0m)
            sb.AppendLine(string.IsNullOrWhiteSpace(fleteZona) ? "Flete" : $"Flete {fleteZona}");

        sb.AppendLine();
        sb.Append($"*TOTAL: {Plata(Total)}*");
        return sb.ToString();
    }

    private static readonly CultureInfo ARS = CultureInfo.GetCultureInfo("es-AR");
    private static string Plata(decimal v) => "$" + v.ToString("N2", ARS);

    /// <summary>
    /// Plata como la escribe una persona: "35000", "35.000", "35000,50", "$35.000".
    /// La coma SIEMPRE es el decimal; el punto es separador de miles cuando lo siguen 3 dígitos.
    /// </summary>
    private static decimal? ParsePlata(string? s)
    {
        if (string.IsNullOrWhiteSpace(s)) return null;
        s = s.Trim().Replace(" ", "").Replace("$", "");
        if (s.Length == 0) return null;
        if (s.Contains(','))
        {
            s = s.Replace(".", "").Replace(",", ".");
        }
        else if (s.Contains('.'))
        {
            var partes = s.Split('.');
            var ult = partes[^1];
            if (partes.Length > 1 && ult.Length == 3 && ult.All(char.IsDigit)) s = s.Replace(".", "");
        }
        return decimal.TryParse(s, NumberStyles.Any, CultureInfo.InvariantCulture, out var n) ? n : (decimal?)null;
    }
}
