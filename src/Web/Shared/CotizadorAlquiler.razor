@* ══════════════════════════════════════════════════════════════════════════════════
   COTIZADOR DE ALQUILERES — la pieza única. 2026-08-31.

   Antes esto estaba escrito DOS veces (la calculadora flotante y el chat de WhatsApp) y
   cada arreglo había que hacerlo en los dos lados. Ahora vive acá una sola vez y se
   enchufa donde haga falta: el chat, la calculadora, la bandeja de preguntas de MeLi.

   Qué hace: muestra TODOS los equipos de Alquileres → Equipos con − 0 + (son pocos y
   buscarlos de a uno era más lento que verlos), el flete por zona en un desplegable
   (Alquileres → Fletes), la fecha del evento, y el total.

   Qué NO hace: mandar. Arma el texto del presupuesto y se lo pasa al que lo usó por
   OnListo — el que decide qué hacer con él (escribirlo en el chat, copiarlo, pegarlo en
   una respuesta). El envío SIEMPRE lo decide una persona.

   ⚠ El texto que le llega al cliente lleva el detalle SIN precio por renglón: el único
   importe es el TOTAL. Es un pedido expreso del dueño, no lo cambies sin preguntarle.

   Cotiza UN día. Multiplicar por cantidad de días quedó para más adelante.
   ══════════════════════════════════════════════════════════════════════════════════ *@

@using System.Globalization
@inject ApiClient Api
@inject ToastService Toast

<div class="cotalq @(Oscuro ? "cotalq-dark" : "")">
    @if (cargando)
    {
        <div class="cotalq-info">⏳ Trayendo los equipos…</div>
    }
    else
    {
        @if (equipos.Count > 8)
        {
            <input class="cotalq-inp" placeholder="Filtrar…" value="@filtro" @oninput="OnFiltrar" autocomplete="off" />
        }

        @if (Visibles().Count == 0)
        {
            <div class="cotalq-info">
                @(equipos.Count == 0 ? "No hay equipos cargados (Alquileres → Equipos)." : "Nada con ese filtro.")
            </div>
        }

        <div class="cotalq-lista">
            @foreach (var eq in Visibles())
            {
                var cant = CantDe(eq.Id);
                <div class="cotalq-fila @(cant > 0 ? "puesto" : "")">
                    <div class="cotalq-fila-n">
                        <span class="cotalq-nom">@eq.Nombre</span>
                        <span class="cotalq-pre">
                            @Plata(eq.PrecioDiario) c/u
                            @if (cant > 0)
                            {
                                <b class="cotalq-sub">@Plata(eq.PrecioDiario * cant)</b>
                            }
                        </span>
                    </div>
                    <span class="cotalq-cant">
                        <button class="cotalq-mas" @onclick="() => Sumar(eq.Id, -1)">−</button>
                        <input class="cotalq-cant-inp" value="@CantTxtDe(eq.Id)" inputmode="numeric"
                               onfocus="this.select()" @oninput="(e) => CambiarCant(eq.Id, e.Value?.ToString())" />
                        <button class="cotalq-mas" @onclick="() => Sumar(eq.Id, 1)">+</button>
                    </span>
                </div>
            }
        </div>

        <div class="cotalq-sec">🚚 Flete</div>
        @if (fletes.Count > 0)
        {
            <select class="cotalq-inp" value="@fleteSel" @onchange="ElegirFlete">
                <option value="">— Sin flete —</option>
                @foreach (var f in fletes)
                {
                    <option value="@f.Id">@f.Zona@(string.IsNullOrWhiteSpace(f.Notas) ? "" : $" · {f.Notas}") — @Plata(f.Precio)</option>
                }
            </select>
        }
        else
        {
            <div class="cotalq-info">No hay fletes cargados (Alquileres → Fletes). Podés poner el monto a mano.</div>
        }

        <label class="cotalq-lbl">Monto del flete</label>
        <input class="cotalq-inp cotalq-plata" inputmode="decimal" placeholder="0"
               value="@fleteTxt" onfocus="this.select()" @oninput="OnMontoFlete" />

        <label class="cotalq-lbl">Fecha del evento</label>
        <input class="cotalq-inp" type="date" @bind="fecha" />

        @if (MostrarDescuento)
        {
            <label class="cotalq-lbl">Descuento (baja el total, no sale en el texto)</label>
            <input class="cotalq-inp cotalq-plata" inputmode="decimal" placeholder="0"
                   value="@descuentoTxt" onfocus="this.select()" @oninput="OnDescuento" />
        }

        <div class="cotalq-total">
            <span>Total</span>
            <b>@Plata(Total)</b>
        </div>

        <button class="cotalq-btn-main" @onclick="Listo" disabled="@(!HayAlgo && FleteMonto == 0m)">
            @TextoBoton
        </button>
        <button class="cotalq-btn-limpiar" @onclick="Limpiar">Vaciar y empezar de nuevo</button>
    }
</div>

<style>
    .cotalq { font-size: 0.8rem; }
    .cotalq-info { font-size: 0.78rem; color: #94a3b8; padding: 0.35rem 0; line-height: 1.45; }
    .cotalq-inp { display: block; width: 100%; box-sizing: border-box; font-family: inherit; font-size: 0.8rem;
        border: 1px solid #e2e8f0; border-radius: 7px; padding: 0.25rem 0.4rem; margin-bottom: 0.35rem;
        background: #fff; color: #1f2937; }
    .cotalq-inp:focus { outline: none; border-color: #3b82f6; }
    .cotalq-plata { text-align: right; font-weight: 600; }
    .cotalq-lbl { display: block; font-size: 0.68rem; font-weight: 700; color: #94a3b8;
        text-transform: uppercase; letter-spacing: 0.03em; margin: 0.35rem 0 0.1rem;
        overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }

    .cotalq-lista { border: 1px solid #e2e8f0; border-radius: 9px; background: #fff; overflow: hidden; }
    .cotalq-fila { display: flex; align-items: center; justify-content: space-between; gap: 0.4rem;
        padding: 0.3rem 0.45rem; border-bottom: 1px solid #f1f5f9; }
    .cotalq-fila:last-child { border-bottom: none; }
    .cotalq-fila.puesto { background: #f0fdf4; }
    .cotalq-fila-n { min-width: 0; }
    .cotalq-nom { display: block; font-size: 0.78rem; color: #334155; line-height: 1.25; }
    .cotalq-pre { display: block; font-size: 0.68rem; color: #94a3b8; }
    .cotalq-sub { color: #047857; margin-left: 0.3rem; }
    .cotalq-cant { display: flex; align-items: center; gap: 0.15rem; }
    .cotalq-mas { width: 22px; height: 22px; background: #f8fafc; border: 1px solid #e2e8f0; border-radius: 6px;
        color: #334155; cursor: pointer; font-size: 0.85rem; line-height: 1; font-family: inherit; }
    .cotalq-mas:hover { background: #ecfdf5; border-color: #16a34a; }
    .cotalq-cant-inp { width: 46px; text-align: center; font-family: inherit; font-size: 0.8rem; font-weight: 700;
        border: 1px solid #e2e8f0; border-radius: 6px; padding: 0.15rem 0.1rem; background: #fff; color: #1f2937; }
    .cotalq-cant-inp:focus { outline: none; border-color: #3b82f6; }

