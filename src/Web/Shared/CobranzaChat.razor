@code {
    /// <summary>A quién se le carga el pago (la razón social tildada del chat, o la que se eligió).</summary>
    [Parameter] public int? ClienteId { get; set; }
    [Parameter] public string? ClienteNombre { get; set; }
    /// <summary>Número del chat: el recibo sale a este número, no al de la ficha.</summary>
    [Parameter] public string? Numero { get; set; }
    /// <summary>Línea del chat: el recibo sale por la misma línea por la que escribe el cliente.</summary>
    [Parameter] public string? Linea { get; set; }
    /// <summary>La foto/PDF del pago que mandó el cliente (opcional).</summary>
    [Parameter] public string? MediaUrl { get; set; }
    [Parameter] public EventCallback OnCambiarCliente { get; set; }
    [Parameter] public EventCallback OnQuitarFoto { get; set; }
    /// <summary>Se cargó la cobranza: el chat actualiza la deuda de la barra de arriba.</summary>
    [Parameter] public EventCallback OnCreada { get; set; }

    private const string ModoEfectivo = "EFECTIVO";
    private const string ModoRedirigido = "REDIRIGIDO";
    private const string DestinoViajes = "viajes";
    private const string DestinoSueldo = "sueldo";
    private const string DestinoPrivada = "privada";
    private const int MaxFacturas = 6;

    private string modo = ModoEfectivo;
    private decimal Importe;
    private string ImporteTexto
    {
        get => Importe > 0 ? MontoInput.Formato(Importe) : "";
        set { MontoInput.TryParse(value, out var v); Importe = Math.Max(0, v); }
    }

    private List<CafeCajaDto> cajas = new();
    private List<CafeCajaDto> cajasEfectivo = new();
    private int cajaEfectivoId;
    private List<CafeDestinatarioDto> destinatarios = new();
    private List<CafeProveedorRedirDto> provRedir = new();
    private readonly Dictionary<int, List<CafeFacturaProvDto>> facturasProv = new();
    private bool fijosCargados;

    private int empleadoId;
    private int proveedorId;
    private int compraId;
    private string? destino;

    private List<ComprobantePendienteDto> pendientes = new();
    private readonly HashSet<int> excluidas = new();
    private bool cargado;
    private bool verTodas;
    private bool mandarRecibo;

    private bool leyendo;
    private ApiClient.LecturaComprobanteDto? lectura;
    private bool guardando;
    private string? creada;
    private decimal creadaImporte;
    private string? creadaAviso;

    private int? clienteCargado;
    private string? mediaLeida;

    private CafeDestinatarioDto? EmpleadoElegido => destinatarios.FirstOrDefault(d => d.EmpleadoId == empleadoId && empleadoId > 0);

    /// <summary>Lo que debe: facturas con saldo positivo. Las notas de crédito y lo pagado de más
    /// se compensan desde Tesorería → Cobranzas, acá no se tocan.</summary>
    private List<ComprobantePendienteDto> Deudas => pendientes.Where(p => p.Saldo > 0.01m).OrderBy(p => p.Fecha).ToList();

    /// <summary>El importe repartido de la factura más vieja a la más nueva, salteando las destildadas.</summary>
    private IEnumerable<(ComprobantePendienteDto p, decimal imp)> Reparto()
    {
        var resto = Importe;
        foreach (var p in Deudas)
        {
            if (excluidas.Contains(p.Clave)) { yield return (p, 0m); continue; }
            var imp = Math.Min(resto, p.Saldo);
            resto -= imp;
            yield return (p, imp);
        }
    }

    private decimal ACuenta => Importe - Reparto().Sum(x => x.imp);
    /// <summary>La deuda del cliente con la MISMA cuenta que la barra de arriba del chat (ficha-chat →
    /// CafeSaldosService). Sumar las facturas de la lista daba otro número (no descuenta notas de
    /// crédito ni plata a favor) y dos "debe" distintos en la misma pantalla no se entienden.</summary>
    private decimal? saldoCliente;
    private decimal? QuedaDebiendo => saldoCliente is decimal sc ? sc - Importe : null;

    protected override async Task OnParametersSetAsync()
    {
        if (!fijosCargados)
        {
            fijosCargados = true;
            try { cajas = await Api.GetCafeCajasAsync() ?? new(); } catch { cajas = new(); }
            cajasEfectivo = cajas.Where(c => c.Tipo == "EFECTIVO").ToList();
            cajaEfectivoId = cajasEfectivo.FirstOrDefault()?.Id ?? 0;
            try { destinatarios = await Api.GetCafeDestinatariosAsync() ?? new(); } catch { destinatarios = new(); }
            try { provRedir = await Api.GetCafeProveedoresRedirigidoAsync(); } catch { provRedir = new(); }
        }

        if (ClienteId != clienteCargado)
        {
            clienteCargado = ClienteId;
            // Las facturas eran del cliente anterior: si quedaran tildadas, el pago iría a otro.
            pendientes = new(); excluidas.Clear(); verTodas = false; creada = null; cargado = false; saldoCliente = null;
            if (ClienteId is int cid)
            {
                try { pendientes = await Api.GetComprobantesPendientesAsync(cid) ?? new(); }
                catch { pendientes = new(); }
                await CargarSaldoAsync(cid);
            }
            cargado = true;
        }

        if (MediaUrl != mediaLeida)
        {
            mediaLeida = MediaUrl;
            lectura = null;
            if (!string.IsNullOrEmpty(MediaUrl))
            {
                creada = null;
                _ = LeerFotoAsync(MediaUrl);
            }
        }
    }

    private async Task CargarSaldoAsync(int cid)
    {
        try { saldoCliente = (await Api.GetFichaChatAsync(cid))?.Saldo; }
        catch { saldoCliente = null; }
    }

    private async Task LeerFotoAsync(string url)
    {
        leyendo = true;
        StateHasChanged();
        ApiClient.LecturaComprobanteDto? r = null;
        try { r = await Api.LeerComprobanteWhatsappAsync(url); } catch { }
        if (url != MediaUrl) return;     // mientras leía, tocaron otra foto
        leyendo = false;
        lectura = r ?? new ApiClient.LecturaComprobanteDto(false, null, null, null, null, null, null);
        if (lectura.EsPago)
        {
            if (lectura.Importe is decimal imp && Importe <= 0) Importe = imp;
            // Si la foto dice a quién fue la plata y es alguien de la lista, es un redirigido.
            if (lectura.EmpleadoId is int eid && destinatarios.FirstOrDefault(d => d.EmpleadoId == eid) is { } d)
            {
                modo = ModoRedirigido;
                ElegirEmpleado(d);
            }
            else if (lectura.ProveedorId is int pid && provRedir.Any(p => p.Id == pid))
            {
                modo = ModoRedirigido;
                await ElegirProveedor(pid);
            }
        }
        StateHasChanged();
    }

    private void ElegirModo(string m)
    {
        modo = m;
        if (m == ModoEfectivo) { empleadoId = 0; proveedorId = 0; compraId = 0; destino = null; }
    }

    private void ElegirEmpleado(CafeDestinatarioDto d)
    {
        empleadoId = d.EmpleadoId;
        proveedorId = 0;
        compraId = 0;
        destino = d.TieneViajes ? null : DestinoSueldo;
    }

    private async Task ElegirProveedor(int id)
    {
        proveedorId = id;
        empleadoId = 0;
        destino = null;
        compraId = 0;
        if (!facturasProv.ContainsKey(id))
        {
            try { facturasProv[id] = await Api.GetCafeFacturasPendientesProveedorAsync(id); }
            catch { facturasProv[id] = new(); }
        }
    }

    private void ElegirPrivada()
    {
        empleadoId = 0;
        proveedorId = 0;
        compraId = 0;
        destino = DestinoPrivada;
    }

    private void ToggleExcluida(int clave)
    {
        if (!excluidas.Remove(clave)) excluidas.Add(clave);
    }

    private Task QuitarFoto() => OnQuitarFoto.InvokeAsync();

    private void CargarOtra()
    {
        creada = null;
        creadaAviso = null;
    }

    private async Task Cargar()
    {
        if (guardando || ClienteId is not int cid) return;
        if (Importe <= 0) { Toast.Error("Poné el importe que pagó."); return; }

        var cajaId = 0;
        string forma;
        if (modo == ModoEfectivo)
        {
            cajaId = cajaEfectivoId;
            if (cajaId == 0) { Toast.Error("No hay caja de efectivo activa."); return; }
            forma = $"en efectivo ({cajas.FirstOrDefault(c => c.Id == cajaId)?.Nombre})";
        }
        else
        {
            // La caja de paso se llama "Redirigido" desde el 05/09; si hubiera otra V_PRIVADO vieja, va la renombrada.
            var paso = cajas.Where(c => c.Tipo == "V_PRIVADO").ToList();
            cajaId = (paso.FirstOrDefault(c => c.Nombre.Contains("Redirig", StringComparison.OrdinalIgnoreCase)) ?? paso.FirstOrDefault())?.Id ?? 0;
            if (cajaId == 0) { Toast.Error("No hay caja Redirigido activa (Tesorería → Cajas)."); return; }
            // Mismas dos trabas que la pantalla de Cobranzas (07/09): no se guarda a medias.
            if (empleadoId <= 0 && proveedorId <= 0 && destino != DestinoPrivada)
            { Toast.Error("Elegí a QUIÉN se le pasó la plata (o \"A nadie · queda en la privada\")."); return; }
            if (empleadoId > 0 && string.IsNullOrWhiteSpace(destino))
            { Toast.Error($"Falta decir de qué se le descuenta a {EmpleadoElegido?.Nombre}: VIAJES o SUELDO."); return; }
            forma = empleadoId > 0 ? $"redirigido a {EmpleadoElegido?.Nombre} ({destino})"
                  : proveedorId > 0 ? $"redirigido a {provRedir.FirstOrDefault(p => p.Id == proveedorId)?.Nombre}"
                  : "redirigido a la privada";
        }

        var reparto = Reparto().Where(x => x.imp > 0.009m).ToList();
        var comps = reparto.Select(x => x.p.Clave < 0
            ? new ApiClient.CrearComprobanteItemRequest(null, x.imp, -x.p.Clave)
            : new ApiClient.CrearComprobanteItemRequest(x.p.Clave, x.imp)).ToList();
        var aCuenta = Importe - reparto.Sum(x => x.imp);
        if (aCuenta > 0.009m) comps.Add(new ApiClient.CrearComprobanteItemRequest(null, aCuenta));

        var confirmTxt = $"¿Cargar una cobranza de {Plata(Importe)} {forma} a {ClienteNombre}?\n\n" +
            (reparto.Count > 0 ? "Paga: " + string.Join(", ", reparto.Select(x => NombreComprobante(x.p))) : "Queda toda a cuenta") +
            (reparto.Count > 0 && aCuenta > 0.009m ? $" · {Plata(aCuenta)} a cuenta" : "") +
            (mandarRecibo ? "\nSe le manda el recibo por WhatsApp." : "");
        if (!await JS.InvokeAsync<bool>("confirm", confirmTxt)) return;

        var esRedir = modo == ModoRedirigido;
        var medio = new ApiClient.CrearMedioItemRequest(cajaId, Importe, null, null,
            esRedir && empleadoId > 0 ? empleadoId : null,
            esRedir ? destino : null,
            esRedir && proveedorId > 0 ? proveedorId : null,
            esRedir && proveedorId > 0 && compraId > 0 ? compraId : null);

        guardando = true;
        try
        {
            var r = await Api.CrearCafeCobranzaAsync(cid, 0m, null, null, comps, new() { medio });
            if (r is null) { Toast.Error("No se pudo cargar la cobranza."); return; }

            var avisos = new List<string>();
            if (!string.IsNullOrEmpty(MediaUrl))
            {
                try
                {
                    var adj = await Api.AdjuntarCobranzaDesdeWhatsappAsync(r.Id, MediaUrl, esRedir ? "TRANSFERENCIA" : "OTRO");
                    avisos.Add(adj is null ? "⚠ el comprobante no se pudo adjuntar" : "comprobante adjunto");
                }
                catch (Exception ex) { avisos.Add("⚠ el comprobante no se pudo adjuntar: " + ex.Message); }
            }
            if (mandarRecibo)
            {
                try
                {
                    var destinoWa = (Numero ?? "").Replace("whatsapp:", "");
                    var env = await Api.EnviarReciboCobranzaAsync(r.Id, false, true, destinoWa, Linea);
                    avisos.Add(env?.WhatsappOk == true ? "recibo enviado" : "⚠ el recibo no salió: " + (env?.WhatsappError ?? "error"));
                }
                catch (Exception ex) { avisos.Add("⚠ el recibo no salió: " + ex.Message); }
            }

            creada = r.Numero;
            creadaImporte = Importe;
            creadaAviso = string.Join(" · ", avisos);
            Toast.Success($"Cobranza {r.Numero} cargada");

            // Queda listo para otro pago del mismo cliente: con lo que debe AHORA.
            Importe = 0; excluidas.Clear(); verTodas = false; mandarRecibo = false; lectura = null;
            empleadoId = 0; proveedorId = 0; compraId = 0; destino = null;
            try { pendientes = await Api.GetComprobantesPendientesAsync(cid) ?? new(); } catch { }
            await CargarSaldoAsync(cid);
            try { destinatarios = await Api.GetCafeDestinatariosAsync() ?? destinatarios; } catch { }
            if (!string.IsNullOrEmpty(MediaUrl)) await OnQuitarFoto.InvokeAsync();
            await OnCreada.InvokeAsync();
        }
        catch (Exception ex) { Toast.Error(ex.Message); }
        finally { guardando = false; }
    }

    private static string NombreComprobante(ComprobantePendienteDto p)
    {
        if (p.EsAlquiler) return $"Alquiler {p.Numero}";
        if (p.ArcaPtoVta is int pv && p.ArcaCbteNro is int nro && !string.IsNullOrEmpty(p.TipoComprobante))
            return $"{p.TipoComprobante} {pv:D4}-{nro:D8}";
        return p.Numero;
    }

    private static bool EsImagen(string url)
    {
        var u = url.Split('?')[0].ToLowerInvariant();
        return u.EndsWith(".jpg") || u.EndsWith(".jpeg") || u.EndsWith(".png") || u.EndsWith(".webp") || u.EndsWith(".gif");
    }

    private static string Plata(decimal v)
    {
        var ar = CultureInfo.GetCultureInfo("es-AR");
        return (v < 0 ? "-$" : "$") + Math.Abs(v).ToString("N0", ar);
    }
}
