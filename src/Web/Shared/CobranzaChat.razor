@* ══════════════════════════════════════════════════════════════════════════════════
   COBRANZA DESDE EL CHAT DE WHATSAPP — 14/09/2026.

   Pedido del dueño: "poder cargar la cobranza fácil desde el mismo chat". Es para EFECTIVO y
   para el COBRO REDIRIGIDO (el cliente le pasa la plata directo a un empleado o proveedor).
   ⚠ Las transferencias que entran al Galicia NO van por acá: siguen entrando por el extracto
   del banco como siempre (lo dijo él). Por eso no hay opción "transferencia" ni "banco".

   Qué hace:
   - Si se abrió desde una foto o PDF del cliente, la IA lee el importe y a quién se le pagó
     (es una sugerencia, se ve y se corrige), y la foto queda adjunta a la cobranza.
   - El importe se reparte solo de la factura más vieja a la más nueva. Destildar una la saltea.
     Lo que sobra queda "a cuenta".
   - El recibo por WhatsApp sale SÓLO si se tilda (decisión de él: lo tilda cada vez).

   Las reglas de la plata son las MISMAS de Tesorería → Cobranzas (CafeTesoreriaCobranzas.razor):
   la caja Redirigido (V_PRIVADO), viajes o sueldo, proveedor con su factura o a cuenta, y
   "a nadie · queda en la privada". Si alguna cambia allá, cambiarla acá también.

   Vive como pieza aparte para poder usarla después en el celular.
   ══════════════════════════════════════════════════════════════════════════════════ *@

@using System.Globalization
@inject ApiClient Api
@inject ToastService Toast
@inject IJSRuntime JS

<div class="cobch">
    @if (ClienteId is null)
    {
        <div class="cobch-info">Este chat no tiene un cliente vinculado.</div>
        <button class="cobch-cli" @onclick="OnCambiarCliente">Elegir a qué cliente se le carga el pago</button>
    }
    else
    {
        <button class="cobch-cli" @onclick="OnCambiarCliente" title="Cargarle el pago a otro cliente">
            <span class="cobch-cli-nom">@ClienteNombre</span>
            <span class="cobch-cli-cta">cambiar</span>
        </button>

        @if (creada is not null)
        {
            <div class="cobch-ok">
                <div>✅ Cobranza <b>@creada</b> cargada · @Plata(creadaImporte)</div>
                @if (!string.IsNullOrEmpty(creadaAviso))
                {
                    <div class="cobch-ok-sub">@creadaAviso</div>
                }
                <button class="cobch-link" @onclick="CargarOtra">Cargar otro pago</button>
            </div>
        }
        else
        {
            <div class="cobch-modos">
                <button class="cobch-modo @(modo == ModoEfectivo ? "on" : "")" @onclick="() => ElegirModo(ModoEfectivo)">💵 Efectivo</button>
                <button class="cobch-modo @(modo == ModoRedirigido ? "on" : "")" @onclick="() => ElegirModo(ModoRedirigido)">↪ Redirigido</button>
            </div>

            @if (!string.IsNullOrEmpty(MediaUrl))
            {
                <div class="cobch-foto">
                    @if (EsImagen(MediaUrl))
                    {
                        <img src="@MediaUrl" alt="comprobante" />
                    }
                    else
                    {
                        <span class="cobch-foto-pdf">📄</span>
                    }
                    <div class="cobch-foto-txt">
                        <div>Comprobante adjunto</div>
                        @if (leyendo)
                        {
                            <div class="cobch-sub">⏳ Leyendo la foto…</div>
                        }
                        else if (lectura is { EsPago: true })
                        {
                            <div class="cobch-sub">
                                Según la foto: @(lectura.Importe is decimal li ? Plata(li) : "importe sin leer")@(string.IsNullOrWhiteSpace(lectura.PagadoA) ? "" : $" · para {lectura.PagadoA}")
                            </div>
                        }
                        else if (lectura is not null)
                        {
                            <div class="cobch-sub">No pude leer un pago en la foto: poné el importe a mano.</div>
                        }
                    </div>
                    <button class="cobch-x" title="No adjuntar este comprobante" @onclick="QuitarFoto">×</button>
                </div>
            }

            <div class="cobch-fila">
                <label class="cobch-lbl" for="cobch-imp">Importe</label>
                <input id="cobch-imp" class="cobch-inp cobch-imp" type="text" inputmode="decimal" placeholder="0"
                       @bind="ImporteTexto" @bind:event="onchange" onfocus="this.select()" />
            </div>

            @if (modo == ModoEfectivo)
            {
                @if (cajasEfectivo.Count > 1)
                {
                    <div class="cobch-t">¿A qué caja entra?</div>
                    <div class="cobch-chips">
                        @foreach (var c in cajasEfectivo)
                        {
                            <button class="cobch-chip @(cajaEfectivoId == c.Id ? "on" : "")" @onclick="() => cajaEfectivoId = c.Id">@c.Nombre</button>
                        }
                    </div>
                }
                else if (cajasEfectivo.Count == 1)
                {
                    <div class="cobch-sub cobch-pad">Entra a la caja @cajasEfectivo[0].Nombre</div>
                }
                else if (cargado)
                {
                    <div class="cobch-alerta">⚠ No hay ninguna caja de efectivo activa (Tesorería → Cajas).</div>
                }
            }
            else
            {
                <div class="cobch-t">¿A quién se le pasó la plata?</div>
                <div class="cobch-chips">
                    @foreach (var d in destinatarios)
                    {
                        <button class="cobch-chip @(empleadoId == d.EmpleadoId ? "on" : "")" @onclick="() => ElegirEmpleado(d)">@d.Nombre</button>
                    }
                    @foreach (var p in provRedir)
                    {
                        <button class="cobch-chip @(proveedorId == p.Id ? "on" : "")" @onclick="() => ElegirProveedor(p.Id)">@p.Nombre</button>
                    }
                    <button class="cobch-chip @(destino == DestinoPrivada ? "on" : "")" @onclick="ElegirPrivada">A nadie · queda en la privada</button>
                </div>

                @if (EmpleadoElegido is { } de)
                {
                    @if (de.TieneViajes)
                    {
                        <div class="cobch-t">¿De qué se lo descuento?</div>
                        <div class="cobch-chips">
                            <button class="cobch-chip @(destino == DestinoViajes ? "on" : "")" @onclick="() => destino = DestinoViajes">Viajes · le debemos @Plata(de.DeudaViajes)</button>
                            <button class="cobch-chip @(destino == DestinoSueldo ? "on" : "")" @onclick="() => destino = DestinoSueldo">Sueldo · le debemos @Plata(de.DeudaSueldo)</button>
                        </div>
                    }
                    else
                    {
                        <div class="cobch-sub cobch-pad">Se le descuenta del sueldo · le debemos @Plata(de.DeudaSueldo)</div>
                    }
                }
                @if (proveedorId > 0)
                {
                    var facts = facturasProv.TryGetValue(proveedorId, out var ff) ? ff : new();
                    @if (facts.Count == 0)
                    {
                        <div class="cobch-sub cobch-pad">Va a cuenta del proveedor: no tiene facturas cargadas con saldo.</div>
                    }
                    else
                    {
                        <div class="cobch-t">¿Contra qué factura del proveedor?</div>
                        <div class="cobch-chips">
                            <button class="cobch-chip @(compraId == 0 ? "on" : "")" @onclick="() => compraId = 0">A cuenta</button>
                            @foreach (var f in facts)
                            {
                                <button class="cobch-chip @(compraId == f.Id ? "on" : "")" @onclick="() => compraId = f.Id">
                                    @(string.IsNullOrWhiteSpace(f.Comprobante) ? f.Numero : f.Comprobante) · debe @Plata(f.Saldo)
                                </button>
                            }
                        </div>
                    }
                }
                <div class="cobch-ayuda">
                    @(destino == DestinoPrivada
                        ? "No entra a ninguna caja del negocio y no se le descuenta a nadie."
                        : "No entra a ninguna caja: se la queda quien elijas y le cuenta como pago.")
                    ¿No está en la lista? Cargala desde Tesorería → Cobranzas.
                </div>
            }

            <div class="cobch-t">Paga estas facturas <span class="cobch-t-sub">de la más vieja a la más nueva</span></div>
            @if (!cargado)
            {
                <div class="cobch-sub cobch-pad">⏳ Trayendo lo que debe…</div>
            }
            else if (Deudas.Count == 0)
            {
                <div class="cobch-sub cobch-pad">No debe ninguna factura: el pago queda a cuenta.</div>
            }
            else
            {
                <div class="cobch-facts">
                    @foreach (var (p, imp) in Reparto().Take(verTodas ? int.MaxValue : MaxFacturas))
                    {
                        var excl = excluidas.Contains(p.Clave);
                        <label class="cobch-fact @(imp > 0 ? "paga" : "")">
                            <input type="checkbox" checked="@(!excl)" @onchange="() => ToggleExcluida(p.Clave)" />
                            <span class="cobch-fact-n">@NombreComprobante(p) · @p.Fecha.ToString("dd/MM")</span>
                            <span class="cobch-fact-imp">
                                @if (imp > 0 && imp < p.Saldo - 0.01m)
                                {
                                    <span class="cobch-sub">@Plata(imp) de @Plata(p.Saldo)</span>
                                }
                                else
                                {
                                    @Plata(p.Saldo)
                                }
                            </span>
                        </label>
                    }
                    @if (!verTodas && Deudas.Count > MaxFacturas)
                    {
                        <button class="cobch-link" @onclick="() => verTodas = true">Ver las @Deudas.Count facturas</button>
                    }
                </div>
                @if (Importe > 0)
                {
                    <div class="cobch-resumen">
                        @if (ACuenta > 0.01m)
                        {
                            <div>Sobran @Plata(ACuenta): quedan a cuenta.</div>
                        }
                        @if (QuedaDebiendo is decimal qd)
                        {
                            <div>@(qd > 0.01m ? $"Queda debiendo {Plata(qd)}" : qd < -0.01m ? $"Queda con {Plata(-qd)} a favor" : "Queda al día")</div>
                        }
                    </div>
                }
            }

            <label class="cobch-recibo">
                <input type="checkbox" @bind="mandarRecibo" />
                <span>Mandarle el recibo por WhatsApp</span>
            </label>

            <button class="cobch-go" disabled="@guardando" @onclick="Cargar">
                @(guardando ? "Cargando…" : Importe > 0 ? $"Cargar cobranza de {Plata(Importe)}" : "Cargar cobranza")
            </button>
        }
    }
</div>

