@* 2026-11-06: barra de menú nueva, ordenada por las 5 partes del negocio + lo que comparten.
   Fila propia debajo de la barra de arriba (ocupa todo el ancho). La ve SOLO quien tenga
   MainLayout.MenuNuevo (por ahora, el usuario admin). Catálogo en MenuNuevoCatalogo.cs; el orden
   que acomoda el dueño (✏ Acomodar) se guarda en la base vía MenuNuevoService. *@
@implements IDisposable
@inject NavigationManager Nav
@inject MenuNuevoService Svc
@inject ToastService Toast
@inject ApiClient Api
@inject HttpClient Http

<div class="mnb @(editando ? "editando" : "")">
    @if (editando)
    {
        @* Guardar/Cancelar adelante: si la fila se parte en dos, un desplegable abierto los tapaba. *@
        <span class="mnb-aviso">✏ Acomodando</span>
        <button class="mnb-btn primario" disabled="@guardando" @onclick="Guardar">@(guardando ? "Guardando…" : "Guardar")</button>
        <button class="mnb-btn" disabled="@guardando" @onclick="Cancelar">Cancelar</button>
        @if (Svc.TieneOrdenPropio)
        {
            <button class="mnb-btn suave" disabled="@guardando" @onclick="VolverAlOriginal">Volver al orden original</button>
        }
        <span class="mnb-sep"></span>
        @Desplegable(DIRECTOS, "★ Directos", "botones de un clic", Lista(DIRECTOS))
    }
    else
    {
        @foreach (var d in Svc.Actual.Directos.Where(Visible))
        {
            <span class="mnb-cont">
                @if (d.Nuevo is { } tipo)
                {
                    <span class="mnb-doble" style="@EstiloCard(d.Href)">
                        <button class="mnb-directo @(EsActual(d.Href) ? "on" : "")" @onclick="() => Ir(d)"><span class="mnb-ico-e @(MenuNuevoCatalogo.IconoDe(Svc.Actual.Iconos, d.Href) != null ? "propio" : "")">@IconoBoton(d.Href)</span>@d.Label</button>
                        <button class="mnb-mas" title="@TituloNuevo(tipo)" aria-label="@TituloNuevo(tipo)" @onclick="() => Nuevo(tipo)">+</button>
                    </span>
                }
                else
                {
                    <button class="mnb-directo @(EsActual(d.Href) ? "on" : "")" style="@EstiloCard(d.Href)" @onclick="() => Ir(d)"><span class="mnb-ico-e @(MenuNuevoCatalogo.IconoDe(Svc.Actual.Iconos, d.Href) != null ? "propio" : "")">@IconoBoton(d.Href)</span>@d.Label</button>
                }
                @Numerito(d.Href)
                @* 2026-11-10: lapicito para cambiarle el ícono y el color a este botón. *@
                <button class="mnb-lapiz" title="Cambiar ícono y color" aria-label="Cambiar ícono y color de @d.Label"
                        @onclick="e => OnLapiz?.Invoke(d.Href, d.Label, e.ClientX - 60, e.ClientY + 14)" @onclick:stopPropagation="true">✏</button>
            </span>
        }
        @* 2026-11-10: Shell Flota al lado de MAPEO: el saldo a la vista y el ⟳ lo vuelve a leer. *@
        @if (shell != null)
        {
            <span class="mnb-cont">
                <span class="mnb-shell" style="@EstiloCard("shell")" role="button" tabindex="0" title="Ir a Shell Flota" @onclick='() => NavigateTo("/integraciones/shell")'>
                    <span class="mnb-ico-e propio">@(MenuNuevoCatalogo.IconoDe(Svc.Actual.Iconos, "shell") ?? "⛽")</span>
                    <span class="mnb-shell-txt">
                        <small>Shell Flota</small>
                        <b>@(leyendoShell ? "leyendo…" : string.IsNullOrEmpty(shell.LastSaldo) ? "sin saldo" : "$" + shell.LastSaldo)</b>
                    </span>
                    <button class="mnb-shell-ref @(leyendoShell ? "girando" : "")" disabled="@leyendoShell"
                            title="@(TituloShell())" aria-label="Leer el saldo de Shell ahora"
                            @onclick="LeerShellAhora" @onclick:stopPropagation="true"><span>⟳</span></button>
                </span>
                <button class="mnb-lapiz" title="Cambiar el ícono" aria-label="Cambiar el ícono de Shell Flota"
                        @onclick='e => OnLapiz?.Invoke("shell", "Shell Flota", e.ClientX - 60, e.ClientY + 14)' @onclick:stopPropagation="true">✏</button>
            </span>
        }
    }
    @* 2026-11-10: las secciones pasaron al menú de la izquierda; acá solo aparecen al acomodar. *@
    @if (editando)
    {
    <span class="mnb-sep"></span>
    var primeroDeTodos = true;
    @foreach (var ga in (editando ? Svc.Actual.Grupos : Svc.Actual.Grupos))
    {
        var g = ga.Grupo;
        var items = editando ? Lista(g.Titulo) : ga.Items.Where(Visible).ToList();
        if (!editando && items.Count == 0) continue;
        if (!g.DelNegocio && primeroDeTodos)
        {
            primeroDeTodos = false;
            <span class="mnb-sep"></span>
        }
        @Desplegable(g.Titulo, g.Titulo, g.Subtitulo, items, g.Nuevo)
    }
    }
    @if (editando)
    {
        <span class="mnb-sep"></span>
        @Desplegable(COSTADO, "◧ Costado", "sueltas en el menú de la izquierda", Lista(COSTADO))
        @Desplegable(MAS, "⋯ Más pantallas", "en el costado, casi no se usan", Lista(MAS))
    }
    @* 2026-11-10: "Acomodar" pasó a ⚙ Organizar y "Buscar" a la lupa de los iconitos. *@
</div>
@if (abierto != null)
{
    <div class="mnb-fondo" @onclick="() => { abierto = null; moviendo = null; }"></div>
}

@code {
    [Parameter, EditorRequired] public Func<string, bool> HasPerm { get; set; } = default!;
    [Parameter, EditorRequired] public Action<string> NavigateTo { get; set; } = default!;
    [Parameter] public EventCallback OnBuscar { get; set; }
    /// <summary>El + pegado a un botón: carga uno nuevo (venta, cobranza, alquiler, pago).</summary>
    [Parameter] public Action<string>? OnNuevo { get; set; }
    /// <summary>Solo el dueño acomoda; lo que acomoda vale para todos los que usen el menú nuevo.</summary>
    [Parameter] public bool PuedeAcomodar { get; set; }
    /// <summary>2026-11-10: tocaron el lápiz ✏ de un botón (clave, nombre, x, y) → MainLayout abre la ventanita.</summary>
    [Parameter] public Action<string, string, double, double>? OnLapiz { get; set; }

    /// <summary>Color que eligió el dueño para la tarjetita del botón de arriba.</summary>
    private string EstiloCard(string clave)
        => MenuNuevoCatalogo.Pastel(MenuNuevoCatalogo.IconoDe(Svc.Actual.Colores, clave)) is { } p ? $"background:{p.Fondo};border-color:{p.Borde};" : "";

    private const string DIRECTOS = "★";
    private const string MAS = "⋯";
    private const string COSTADO = MenuNuevoCatalogo.CLAVE_COSTADO;

    private string? abierto;
    private bool editando, guardando;
    /// <summary>Copia que se edita; recién al Guardar va a la base.</summary>
    private Dictionary<string, List<MenuNuevoCatalogo.Item>> borrador = new();
    /// <summary>Renglón al que se le tocó "Mover a…" (se despliegan los destinos abajo).</summary>
    private (string Lista, string Href)? moviendo;
    /// <summary>Renglón al que se le tocó 🎨 (se despliegan los circulitos de color).</summary>
    private string? pintando;
    /// <summary>Colores del borrador (sección o pantalla → pastel).</summary>
    private Dictionary<string, string> colores = new(StringComparer.OrdinalIgnoreCase);

    // ───────── Colores pastel ─────────
    private string? ColorDe(string clave)
    {
        var d = editando ? colores : Svc.Actual.Colores;
        return d.TryGetValue(clave, out var c) ? c : null;
    }
    /// <summary>Botón de la barra (sección o directo): fondo pastel + rayita abajo.</summary>
    private string EstiloBoton(string clave)
        => MenuNuevoCatalogo.Pastel(ColorDe(clave)) is { } p ? $"background:{p.Fondo};box-shadow:inset 0 -2px 0 {p.Borde};" : "";
    /// <summary>Renglón adentro del desplegable: fondo pastel + rayita a la izquierda.</summary>
    private string EstiloItem(string href)
        => MenuNuevoCatalogo.Pastel(ColorDe(href)) is { } p ? $"background:{p.Fondo};box-shadow:inset 3px 0 0 {p.Borde};" : "";

    private void PonerColor(string clave, string? color)
    {
        if (color == null) colores.Remove(clave); else colores[clave] = color;
    }

    private RenderFragment Circulos(string clave) => __builder =>
    {
        var actual = colores.TryGetValue(clave, out var c) ? c : null;
        foreach (var p in MenuNuevoCatalogo.Pasteles)
        {
            <button class="mnb-circulo @(actual == p.Clave ? "on" : "")" title="@p.Nombre"
                    style="background:@p.Fondo;border-color:@p.Borde" @onclick="() => PonerColor(clave, p.Clave)"></button>
        }
        <button class="mnb-destino" title="Sacar el color" @onclick="() => PonerColor(clave, null)">sin color</button>
    };

    // ───────── Íconos que elige el dueño (2026-11-10) ─────────
    /// <summary>Íconos del borrador (sección o pantalla → emoji).</summary>
    private Dictionary<string, string> iconos = new(StringComparer.OrdinalIgnoreCase);
    /// <summary>Renglón al que se le tocó 😀 (se despliegan los emojis abajo).</summary>
    private string? iconeando;

    private RenderFragment Emojis(string clave) => __builder =>
    {
        var actual = iconos.TryGetValue(clave, out var e) ? e : null;
        foreach (var em in MenuNuevoCatalogo.Emojis)
        {
            <button class="mnb-emoji @(actual == em ? "on" : "")" title="Usar @em" @onclick="() => PonerIcono(clave, em)">@em</button>
        }
        <button class="mnb-destino" title="Sacar el ícono" @onclick="() => PonerIcono(clave, null)">sin ícono</button>
    };

    private void PonerIcono(string clave, string? emoji)
    {
        if (emoji == null) iconos.Remove(clave); else iconos[clave] = emoji;
    }

    /// <summary>Ícono que se muestra en el botón: el que eligió el dueño o el de fábrica.</summary>
    private string IconoBoton(string href)
        => MenuNuevoCatalogo.IconoDe(Svc.Actual.Iconos, href) ?? IconoDe(href);

    protected override async Task OnInitializedAsync()
    {
        Svc.OnChange += Repintar;
        await Svc.EnsureLoadedAsync();
        // 2026-11-10: los numeritos se refrescan solos cada minuto.
        _ = CargarNumeritos();
        reloj = new System.Threading.Timer(_ => _ = CargarNumeritos(), null, TimeSpan.FromSeconds(60), TimeSpan.FromSeconds(60));
    }
    private void Repintar() => InvokeAsync(StateHasChanged);
    public void Dispose()
    {
        Svc.OnChange -= Repintar;
        reloj?.Dispose();
    }

    // ───────── Numeritos (2026-11-10) ─────────
    // 📦 Preparación = pedidos para armar · 🚚 Ventas = ventas sin entregar (misma regla que el
    // resumen del listado de Ventas) · 💰 Cobranzas = cobros de repartidores para volcar (lo que
    // antes era la bolsita de arriba). Al pasar el mouse se ve la lista; tocando el número se va a
    // la pantalla. Si no hay nada, no se muestra.
    private System.Threading.Timer? reloj;
    private int prepN, ventasN, cobN;
    private List<(string Izq, string Der)> prepL = new(), ventasL = new(), cobL = new();
    private bool cargando;

    private record SinEntregarResp(int Total, List<SinEntregarItem> Items);
    private record SinEntregarItem(int Id, string Numero, DateTime Fecha, string Cliente, string? EntregaPor, string? EstadoPreparacion, bool Retira);

    private async Task CargarNumeritos()
    {
        if (cargando) return;
        cargando = true;
        try
        {
            var ar = new System.Globalization.CultureInfo("es-AR");
            if (!leyendoShell) await CargarShell();
            try
            {
                var prep = await Api.GetCafePreparacionAsync(7) ?? new();
                prepN = prep.Count;
                prepL = prep.Take(5).Select(p => (p.ClienteNombre, "$" + p.Total.ToString("N0", ar))).ToList();
            }
            catch { }
            try
            {
                var r = await Http.GetFromJsonAsync<SinEntregarResp>("/api/cafe/ventas/sin-entregar-resumen?max=5");
                if (r != null)
                {
                    ventasN = r.Total;
                    ventasL = r.Items.Select(i => (i.Cliente,
                        i.Retira ? "retira" : !string.IsNullOrWhiteSpace(i.EntregaPor) ? i.EntregaPor! : "sin repartidor")).ToList();
                }
            }
            catch { }
            try
            {
                cobN = await Api.GetCountCobranzasPendientesAsync() + await Api.GetCountAlqCobranzasPendientesAsync()
                     + await Api.GetCountRediPendientesAsync();
                var cobs = await Api.GetCobranzasPendientesAsync() ?? new();
                cobL = cobs.Take(5).Select(c => ((c.ClienteNombre ?? c.VentaNumero) + " · " + c.RepartidorNombre,
                    "$" + c.Importe.ToString("N0", ar))).ToList();
            }
            catch { }
            await InvokeAsync(StateHasChanged);
        }
        finally { cargando = false; }
    }

    // ───────── Shell Flota (2026-11-10) ─────────
    private Web.Models.ShellAccountDto? shell;
    private bool leyendoShell;

    private async Task CargarShell()
    {
        try { shell = await Api.GetShellAccountAsync(); } catch { }
    }

    private string TituloShell()
    {
        if (leyendoShell) return "Leyendo el saldo en Shell… (tarda unos segundos)";
        var cuando = shell?.LastSaldoAt is DateTime t ? " · última lectura " + t.ToArTime().ToString("dd/MM HH:mm") : "";
        return "Leer el saldo de Shell ahora" + cuando;
    }

    private async Task LeerShellAhora()
    {
        if (leyendoShell) return;
        leyendoShell = true;
        StateHasChanged();
        try
        {
            var r = await Api.SincronizarShellAsync();
            if (r is { Ok: false }) Toast.Error("No se pudo leer el saldo de Shell" + (string.IsNullOrWhiteSpace(r.Error) ? "" : ": " + r.Error));
            await CargarShell();
            if (r is { Ok: true }) Toast.Success("Saldo de Shell actualizado");
        }
        catch (Exception ex) { Toast.Error("No se pudo leer el saldo de Shell: " + ex.Message); }
        finally { leyendoShell = false; StateHasChanged(); }
    }

    private static string IconoDe(string href) => href.ToLowerInvariant() switch
    {
        "/cafe/preparacion" => "📦",
        "/cafe/ventas" => "🧾",
        "/cafe/tesoreria/cobranzas" => "💵",
        "/cafe/tesoreria/pagos" => "📤",
        "/mapeo?full=1" => "🗺",
        _ => "",
    };

    private RenderFragment Numerito(string href) => __builder =>
    {
        var (n, lista, ico, clase, titulo, destino) = href.ToLowerInvariant() switch
        {
            "/cafe/preparacion" => (prepN, prepL, "📦", "prep", "para armar", "/cafe/preparacion"),
            "/cafe/ventas" => (ventasN, ventasL, "🚚", "ven", "ventas sin entregar", "/cafe/ventas"),
            "/cafe/tesoreria/cobranzas" => (cobN, cobL, "💰", "cob", "cobros de repartidores para volcar", "/cafe/cobranzas-pendientes"),
            _ => (0, new List<(string, string)>(), "", "", "", ""),
        };
        if (n <= 0) return;
        <button class="mnb-num @clase" title="@($"{n} {titulo}")" @onclick="() => NavigateTo(destino)">@ico @(n > 99 ? "99+" : n.ToString())</button>
        <div class="mnb-pop" @onclick="() => NavigateTo(destino)">
            <div class="mnb-pop-t">@n @titulo</div>
            @foreach (var (izq, der) in lista)
            {
                <div class="mnb-pop-f"><span>@izq</span><small>@der</small></div>
            }
            <div class="mnb-pop-mas">@(n > lista.Count ? $"y {n - lista.Count} más · " : "")ver todo ›</div>
        </div>
    };

    // ───────── Un desplegable (normal o acomodando) ─────────
    private RenderFragment Desplegable(string clave, string titulo, string subtitulo, List<MenuNuevoCatalogo.Item> items, string? nuevo = null) => __builder =>
    {
        var conMas = !editando && nuevo != null;
        <div class="mnb-wrap @(conMas ? "mnb-doble" : "")">
            <button class="mnb-grupo @(abierto == clave ? "abierto" : "") @(!editando && items.Any(i => EsActual(i.Href)) ? "on" : "")"
                    style="@EstiloBoton(clave)" @onclick="() => Alternar(clave)">
                @titulo
                @if (editando) { <span class="mnb-cuenta">@items.Count</span> }
                <span class="mnb-caret">▾</span>
            </button>
            @if (conMas)
            {
                <button class="mnb-mas" title="@TituloNuevo(nuevo!)" aria-label="@TituloNuevo(nuevo!)" @onclick="() => Nuevo(nuevo!)">+</button>
            }
            @if (abierto == clave)
            {
                <div class="mnb-menu @(AbreALaIzquierda(clave) ? "derecha" : "") @(editando ? "ancho" : "")" @onclick:stopPropagation="true">
                    @if (!string.IsNullOrEmpty(subtitulo))
                    {
                        <div class="mnb-sub">@subtitulo</div>
                    }
                    @if (editando && clave != DIRECTOS && clave != MAS && clave != COSTADO)
                    {
                        @* 2026-11-10: color e ícono se cambian con el lápiz ✏ de cada botón (ya no acá). *@
                    }
                    @if (items.Count == 0)
                    {
                        <div class="mnb-sub">Vacío. Traé pantallas con "Mover a…" desde otra sección.</div>
                    }
                    @for (int n = 0; n < items.Count; n++)
                    {
                        var it = items[n];
                        var idx = n;
                        if (!editando)
                        {
                            if (it.Seccion != null && MenuNuevoCatalogo.GrupoDeFabrica.TryGetValue(it.Href, out var gf) && gf == clave)
                            {
                                <div class="mnb-seccion">@it.Seccion</div>
                            }
                            <button class="mnb-item @(EsActual(it.Href) ? "on" : "")" style="@EstiloItem(it.Href)" @onclick="() => Ir(it)">@it.Label</button>
                        }
                        else
                        {
                            <div class="mnb-fila-ed" style="@EstiloItem(it.Href)">
                                <span class="mnb-nombre">@it.Label</span>
                                <button class="mnb-ico" title="Subir" disabled="@(idx == 0)" @onclick="() => Correr(clave, idx, -1)">▲</button>
                                <button class="mnb-ico" title="Bajar" disabled="@(idx == items.Count - 1)" @onclick="() => Correr(clave, idx, +1)">▼</button>
                                @if (clave == DIRECTOS)
                                {
                                    @if (it.Nuevo == null && !MenuNuevoCatalogo.EsDirectoDeFabrica(it.Href))
                                    {
                                        <button class="mnb-ico" title="Sacar de los directos (vuelve a su sección)" @onclick="() => SacarDirecto(it.Href)">✕</button>
                                    }
                                }
                                else
                                {
                                    var esDirecto = borrador[DIRECTOS].Any(d => d.Href == it.Href);
                                    @if (!MenuNuevoCatalogo.NoDirectos.Contains(it.Href))
                                    {
                                        <button class="mnb-ico @(esDirecto ? "on" : "")" title="@(esDirecto ? "Ya es botón directo (tocá para sacarlo)" : "Hacerlo botón directo de un clic")"
                                                @onclick="() => AlternarDirecto(it)">★</button>
                                    }
                                    <button class="mnb-mover @(moviendo?.Href == it.Href ? "on" : "")" @onclick="() => moviendo = moviendo?.Href == it.Href ? null : (clave, it.Href)">Mover a…</button>
                                }
                            </div>
                            @if (pintando == it.Href)
                            {
                                <div class="mnb-destinos">@Circulos(it.Href)</div>
                            }
                            @if (iconeando == it.Href)
                            {
                                <div class="mnb-destinos mnb-emojis">@Emojis(it.Href)</div>
                            }
                            @if (moviendo is { } m && m.Href == it.Href && m.Lista == clave)
                            {
                                <div class="mnb-destinos">
                                    @foreach (var dest in Destinos().Where(d => d.Clave != clave))
                                    {
                                        <button class="mnb-destino" @onclick="() => Mover(clave, it.Href, dest.Clave)">@dest.Nombre</button>
                                    }
                                </div>
                            }
                        }
                    }
                </div>
            }
        </div>
    };

    // ───────── Navegar ─────────
    private bool Visible(MenuNuevoCatalogo.Item i) => i.Permiso == null || HasPerm(i.Permiso);

    private void Alternar(string clave)
    {
        abierto = abierto == clave ? null : clave;
        moviendo = null;
    }

    /// <summary>Los de la punta derecha abren hacia la izquierda para no cortarse contra el borde.</summary>
    private bool AbreALaIzquierda(string clave)
    {
        // Costado y Más pantallas quedan en la 2ª renglón, pegados a la izquierda: abren normal.
        if (clave == MAS || clave == COSTADO) return false;
        var i = Array.FindIndex(MenuNuevoCatalogo.Grupos, g => g.Titulo == clave);
        return i >= MenuNuevoCatalogo.Grupos.Length - 2;
    }

    private bool EsActual(string href)
    {
        var actual = "/" + Nav.ToBaseRelativePath(Nav.Uri).Split('#')[0];
        if (href.Contains('?')) return string.Equals(actual, href, StringComparison.OrdinalIgnoreCase);
        return string.Equals(actual.Split('?')[0], href, StringComparison.OrdinalIgnoreCase);
    }

    private void Ir(MenuNuevoCatalogo.Item it)
    {
        abierto = null;
        if (it.Externo) Nav.NavigateTo(it.Href, forceLoad: true);
        else NavigateTo(it.Href);
    }

    private void Nuevo(string tipo)
    {
        abierto = null;
        OnNuevo?.Invoke(tipo);
    }

    private static string TituloNuevo(string tipo) => tipo switch
    {
        "venta" => "Cargar una venta nueva (atajo: N y después V)",
        "cobranza" => "Cargar una cobranza nueva (atajo: N y después C)",
        "alquiler" => "Cargar una reserva de alquiler nueva (atajo: N y después A)",
        "pago" => "Cargar un pago a proveedor nuevo (atajo: N y después P)",
        "stock" => "Cargar stock",
        "compra" => "Cargar una compra nueva",
        _ => "Cargar nuevo"
    };

    /// <summary>MainLayout lo llama al cambiar de pantalla (por si se navegó por otro lado).</summary>
    public void Cerrar()
    {
        if (abierto == null || editando) return;
        abierto = null;
        StateHasChanged();
    }

    // ───────── Acomodar ─────────
    private List<MenuNuevoCatalogo.Item> Lista(string clave) => borrador.TryGetValue(clave, out var l) ? l : new();

    private IEnumerable<(string Clave, string Nombre)> Destinos()
        => MenuNuevoCatalogo.Grupos.Select(g => (g.Titulo, g.Titulo))
            .Append((COSTADO, "◧ Costado izquierdo")).Append((MAS, "⋯ Más pantallas"));

    /// <summary>Lo llama "✏ Acomodar menú" desde ⚙ Organizar (menú de la izquierda).</summary>
    public void EmpezarAcomodar()
    {
        var a = Svc.Actual;
        borrador = new Dictionary<string, List<MenuNuevoCatalogo.Item>>
        {
            [DIRECTOS] = a.Directos.ToList(),
            [MAS] = a.Mas.ToList(),
            [COSTADO] = a.Costado.ToList(),
        };
        foreach (var g in a.Grupos) borrador[g.Grupo.Titulo] = g.Items.ToList();
        colores = new Dictionary<string, string>(a.Colores, StringComparer.OrdinalIgnoreCase);
        iconos = new Dictionary<string, string>(a.Iconos ?? new(), StringComparer.OrdinalIgnoreCase);
        pintando = null;
        iconeando = null;
        editando = true;
        abierto = MenuNuevoCatalogo.Grupos[0].Titulo;
        moviendo = null;
        StateHasChanged();
    }

    private void Correr(string clave, int idx, int delta)
    {
        var l = borrador[clave];
        var j = idx + delta;
        if (j < 0 || j >= l.Count) return;
        (l[idx], l[j]) = (l[j], l[idx]);
    }

    private void Mover(string desde, string href, string hacia)
    {
        var it = borrador[desde].FirstOrDefault(i => i.Href == href);
        if (it == null) return;
        borrador[desde].Remove(it);
        borrador[hacia].Add(it);
        moviendo = null;
        var nombre = hacia == MAS ? "Más pantallas" : hacia == COSTADO ? "el costado izquierdo" : hacia;
        Toast.Success($"\"{it.Label}\" pasó a {nombre} (queda al final)");
    }

    private void AlternarDirecto(MenuNuevoCatalogo.Item it)
    {
        var d = borrador[DIRECTOS];
        var ya = d.FirstOrDefault(x => x.Href == it.Href);
        if (ya != null) d.Remove(ya); else d.Add(it);
    }

    private void SacarDirecto(string href) => borrador[DIRECTOS].RemoveAll(x => x.Href == href);

    private async Task Guardar()
    {
        guardando = true;
        try
        {
            var armado = new MenuNuevoCatalogo.Armado(
                borrador[DIRECTOS],
                MenuNuevoCatalogo.Grupos.Select(g => new MenuNuevoCatalogo.GrupoArmado(g, borrador[g.Titulo])).ToList(),
                borrador[MAS],
                colores,
                borrador[COSTADO],
                iconos,
                // 2026-11-10: lo que no se toca al acomodar (pastillas y favoritos) se conserva tal cual.
                Svc.Actual.Pastillas, Svc.Actual.Favoritos, Svc.Actual.FavEstilo);
            await Svc.GuardarAsync(armado);
            editando = false; abierto = null; moviendo = null;
            Toast.Success("Menú guardado");
        }
        catch (Exception ex) { Toast.Error("No se pudo guardar: " + ex.Message); }
        finally { guardando = false; }
    }

    private void Cancelar() { editando = false; abierto = null; moviendo = null; }

    private async Task VolverAlOriginal()
    {
        guardando = true;
        try
        {
            await Svc.VolverAlOriginalAsync();
            editando = false; abierto = null; moviendo = null;
            Toast.Success("Menú vuelto al orden original");
        }
        catch (Exception ex) { Toast.Error("No se pudo: " + ex.Message); }
        finally { guardando = false; }
    }
}
