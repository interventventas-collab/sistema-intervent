    private string PreviewRespuestaPwa(ApiClient.TwMsgDto m)
    {
        if (!string.IsNullOrWhiteSpace(m.Cuerpo)) return Recortar2(m.Cuerpo, 60);
        if (!string.IsNullOrWhiteSpace(m.MediaUrl))
        {
            if (EsAudio(m.MediaUrl)) return "🎤 Nota de voz";
            if (EsImagen(m.MediaUrl)) return "📷 Imagen";
            return "📎 Archivo";
        }
        return "Mensaje";
    }

    // === 2026-08-06: nota de voz (grabar con micrófono y enviar como audio) — reusa el mismo
    // grabador (window.waAudio) y endpoint (SendTwMediaAsync) que la pantalla grande de WhatsApp. ===
    private bool grabandoAudio, enviandoAudio;
    private class WaUploadRes { public string? Url { get; set; } public string? OriginalFilename { get; set; } }

    private async Task ToggleGrabarAudio()
    {
        if (!grabandoAudio)
        {
            bool ok;
            try { ok = await JS.InvokeAsync<bool>("waAudio.start"); }
            catch { ok = false; }
            if (!ok) { Toast.Error("No pude acceder al micrófono. Revisá los permisos del navegador (y que estés en HTTPS)."); return; }
            grabandoAudio = true;
        }
        else
        {
            grabandoAudio = false;
            enviandoAudio = true;
            StateHasChanged();
            WaUploadRes? res = null;
            try { res = await JS.InvokeAsync<WaUploadRes?>("waAudio.stopAndUpload"); }
            catch { }
            if (res == null || string.IsNullOrEmpty(res.Url))
            {
                enviandoAudio = false;
                Toast.Error("No se pudo grabar o subir el audio");
                StateHasChanged();
                return;
            }
            var (ok, err) = await Api.SendTwMediaAsync(Numero, res.Url, null, res.OriginalFilename, LineaPhoneId);
            enviandoAudio = false;
            if (!ok) Toast.Error(err ?? "No se pudo enviar la nota de voz");
            else await Cargar();
            StateHasChanged();
        }
    }

    private async Task CancelarAudio()
    {
        grabandoAudio = false;
        try { await JS.InvokeVoidAsync("waAudio.cancel"); } catch { }
    }

