    // -- Mandar saldo (inserta el texto en el cuadro; se revisa y se manda) --
    private string salQuery = "";
    private List<ApiClient.TwClienteBuscarDto> salResult = new();
    private bool salBuscando, salCargando;
    private void AbrirSaldo() { masVista = "saldo"; salQuery = ""; salResult = new(); StateHasChanged(); }
    private async Task BuscarSaldo(ChangeEventArgs e)
    {
        salQuery = e.Value?.ToString() ?? "";
        if (salQuery.Trim().Length < 2) { salResult = new(); StateHasChanged(); return; }
        salBuscando = true; StateHasChanged();
        try { salResult = await Api.BuscarTwClientesAsync(salQuery.Trim()); }
        catch { salResult = new(); }
        salBuscando = false; StateHasChanged();
    }
    private async Task PonerSaldoTexto(int clienteId)
    {
        salCargando = true; StateHasChanged();
        try
        {
            var s = await Api.GetClienteSaldoAsync(clienteId);
            if (s is null) { Toast.Error("No se pudo traer el saldo"); return; }
            var ar = System.Globalization.CultureInfo.GetCultureInfo("es-AR");
            var linea = $"{s.ClienteNombre} - ${s.Saldo.ToString("N0", ar)}";
            composer = string.IsNullOrWhiteSpace(composer) ? linea : composer.TrimEnd() + "\n" + linea;
            mostrarMas = false;
        }
        finally { salCargando = false; StateHasChanged(); }
    }

    // === 2026-08-06: adjuntar foto/archivo (sube y manda, reusa el camino del WhatsApp grande) ===
    private bool subiendo;
    private const long MaxUploadBytes = 16L * 1024 * 1024;
    private async Task OnAdjuntar(InputFileChangeEventArgs e)
    {
        var file = e.File;
        if (file == null) return;
        if (file.Size > MaxUploadBytes) { Toast.Error($"El archivo {file.Name} supera los 16 MB"); return; }
        subiendo = true;
        StateHasChanged();
        try
        {
            using var stream = file.OpenReadStream(MaxUploadBytes);
            var (up, err) = await Api.UploadTwArchivoAsync(stream, file.Name, file.ContentType);
            if (up == null) { Toast.Error(err ?? "No se pudo subir el archivo"); return; }
            var (ok, serr) = await Api.SendTwMediaAsync(Numero, up.Url, null, up.OriginalFilename, LineaPhoneId);
            if (!ok) Toast.Error(serr ?? "No se pudo enviar el archivo");
            else await Cargar();
        }
        catch (Exception ex) { Toast.Error("No se pudo enviar el archivo: " + ex.Message); }
        finally { subiendo = false; StateHasChanged(); }
    }

    private static bool EsAudio(string? url)
    {
        if (string.IsNullOrEmpty(url)) return false;
        var l = url.ToLowerInvariant();
        return l.EndsWith(".ogg") || l.EndsWith(".opus") || l.EndsWith(".mp3") || l.EndsWith(".m4a")
            || l.EndsWith(".amr") || l.EndsWith(".wav") || l.EndsWith(".webm");
    }

    private static bool EsImagen(string? url)
    {
        if (string.IsNullOrEmpty(url)) return false;
        var l = url.ToLowerInvariant();
        return l.EndsWith(".jpg") || l.EndsWith(".jpeg") || l.EndsWith(".png") || l.EndsWith(".gif") || l.EndsWith(".webp");
    }

    // 2026-08-07: stickers (.webp) chiquitos, no como una foto.
    private static bool EsSticker(string? url) => !string.IsNullOrEmpty(url) && url.ToLowerInvariant().EndsWith(".webp");

    private async Task AbrirEnGrande()
    {
        // solo=1 → abre SOLO esta conversación (sin la lista de todos los chats).
        var url = $"/whatsapp?numero={Uri.EscapeDataString(Numero)}&solo=1"
                + (string.IsNullOrEmpty(LineaPhoneId) ? "" : $"&linea={Uri.EscapeDataString(LineaPhoneId)}");
        try { await JS.InvokeVoidAsync("open", url, "_blank"); }
        catch { }
    }

    private string InicialContacto()
        => string.IsNullOrWhiteSpace(TituloContacto) ? "?" : TituloContacto.Trim()[..1].ToUpperInvariant();

    private static string FormatHora(DateTime utc)
    {
        var local = utc.ToArTime();
        var ahora = DateTime.UtcNow.ToArTime();
        if (local.Date == ahora.Date) return local.ToString("HH:mm");
        if (local.Date == ahora.Date.AddDays(-1)) return "Ayer " + local.ToString("HH:mm");
        return local.ToString("dd/MM HH:mm");
    }

