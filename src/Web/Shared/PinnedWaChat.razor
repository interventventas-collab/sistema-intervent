@code {
    /// <summary>Número del contacto tal cual está guardado, ej. "whatsapp:+5491158464160".</summary>
    [Parameter, EditorRequired] public string Numero { get; set; } = "";
    /// <summary>PhoneId de la línea nuestra (ej. FIJO TRANSRADIO). Null = línea sin registrar.</summary>
    [Parameter] public string? LineaPhoneId { get; set; }
    [Parameter] public string TituloContacto { get; set; } = "Conversación";
    [Parameter] public string NombreLinea { get; set; } = "";
    /// <summary>Muestra el botón "Abrir ⤢" (para usuarios que sí pueden ver la pantalla completa de WhatsApp).</summary>
    [Parameter] public bool PuedeAbrirEnGrande { get; set; } = true;
    /// <summary>2026-08-07: muestra las acciones extra (Respuestas rápidas + Menú rol). Solo en móvil / card
    /// flotante; en el chat de venta/depósito/dashboard queda apagado para no recargar.</summary>
    [Parameter] public bool AccionesCompletas { get; set; } = false;

    private List<ApiClient.TwMsgDto>? mensajes;
    private string composer = "";
    private bool sending;
    private System.Threading.Timer? refreshTimer;

    // 2026-08-06: firma del Depósito (responde firmando quién lo hace). Nombres FIJOS por ahora.
    private bool esDeposito;
    private string? firmante;
    private static readonly string[] FirmantesDeposito = { "alex", "nacho", "benja", "rodri", "gon", "ger" };
    private static string Capitalizar(string s) => string.IsNullOrEmpty(s) ? s : char.ToUpperInvariant(s[0]) + s.Substring(1);

    // ===== 2026-08-12: ventana de 24 hs de WhatsApp =====
    // Fuera de las 24 hs desde el último mensaje del cliente, WhatsApp NO deja escribir texto libre:
    // hay que mandar una plantilla aprobada. Misma lógica que la pantalla grande de WhatsApp, acá en
    // versión mini (celular y chats flotantes). Mientras los mensajes cargan no bloqueamos (evita el
    // "flash" de "pasaron 24 hs" antes de tener el historial).
    private bool EsChatIgPwa() => Numero?.StartsWith("ig:") ?? false;
    private DateTime? UltimoEntranteWa()
        => mensajes?.Where(m => m.Direccion == "INCOMING").Select(m => (DateTime?)m.CreatedAt).Max();
    private bool VentanaWaAbierta()
    {
        if (mensajes is null) return true;     // todavía cargando: no bloquear
        if (EsChatIgPwa()) return false;       // Instagram: sin plantillas, se maneja aparte
        var ult = UltimoEntranteWa();
        return ult != null && ult.Value.AddHours(24) > DateTime.UtcNow;
    }

    // Selector de plantilla dentro del chat (para cuando la ventana de 24 hs está cerrada).
    private List<ApiClient.TwPlantillaDto>? plantillasWa;
    private string plantillaName = "";
    private List<string> plantillaVars = new();
    private bool plantillaEnviando;
    private ApiClient.TwPlantillaDto? PlantillaSelWa() => plantillasWa?.FirstOrDefault(p => p.Name == plantillaName);
    private void OnPlantillaChange(ChangeEventArgs e)
    {
        plantillaName = e.Value?.ToString() ?? "";
        var count = PlantillaSelWa()?.VariableCount ?? 0;
        plantillaVars = Enumerable.Range(0, count).Select(_ => "").ToList();
    }
    private void SetPlantillaVar(int idx, string val)
    {
        while (plantillaVars.Count <= idx) plantillaVars.Add("");
        plantillaVars[idx] = val;
    }
    private string PreviewPlantillaWa()
    {
        var p = PlantillaSelWa();
        return p == null ? "" : RenderPreviewWa(p.BodyText, plantillaVars);
    }
    private static string RenderPreviewWa(string body, List<string> vars)
    {
        if (string.IsNullOrEmpty(body)) return "";
        return System.Text.RegularExpressions.Regex.Replace(body, @"\{\{\s*(\d+)\s*\}\}", m =>
        {
            if (int.TryParse(m.Groups[1].Value, out var idx) && idx >= 1 && idx <= vars.Count && !string.IsNullOrEmpty(vars[idx - 1]))
                return vars[idx - 1];
            return m.Value;
        });
    }
    private static string PlaceholderVarWa(ApiClient.TwPlantillaDto? p, int idx)
    {
        if (p != null && (p.Name.Contains("deuda") || p.Name.Contains("pago")))
            return idx == 0 ? "Nombre del cliente" : "Monto (ej: $5.000)";
        return idx == 0 ? "Nombre del cliente" : $"Dato {idx + 1}";
    }
    private async Task EnviarPlantillaWa()
    {
        var p = PlantillaSelWa();
        if (p == null) { Toast.Warning("Elegí una plantilla"); return; }
        for (int i = 0; i < p.VariableCount; i++)
            if (i >= plantillaVars.Count || string.IsNullOrWhiteSpace(plantillaVars[i]))
            { Toast.Warning("Completá todos los datos de la plantilla"); return; }
        var digits = new string(Numero.Where(char.IsDigit).ToArray());
        plantillaEnviando = true; StateHasChanged();
        var (ok, err, _) = await Api.IniciarTwConversacionAsync(digits, p.Name, p.Language, LineaPhoneId, plantillaVars, p.BodyText);
        plantillaEnviando = false;
        if (!ok) { Toast.Error(err ?? "No se pudo enviar la plantilla"); return; }
        Toast.Success("Plantilla enviada ✓");
        plantillaName = ""; plantillaVars = new();
        await Cargar();
        StateHasChanged();
    }

    protected override async Task OnInitializedAsync()
    {
        // ¿Es usuario Depósito? (mismo criterio que el resto del sistema: deposito y NO cafe/oficina)
        try
        {
            var user = await AuthSvc.GetUserAsync();
            var perms = user?.Permissions ?? new();
            esDeposito = perms.Contains("deposito") && !perms.Contains("cafe") && !perms.Contains("oficina");
        }
        catch { esDeposito = false; }
        await Cargar();
        // Refresco liviano cada 12s para ver mensajes nuevos sin recargar la página.
        refreshTimer = new System.Threading.Timer(async _ =>
        {
            await InvokeAsync(async () =>
            {
                if (!sending) { await Cargar(); StateHasChanged(); }
            });
        }, null, 12_000, 12_000);
    }

    private async Task Cargar()
    {
        try
        {
            // El endpoint espera el sentinela "null" (string) para la línea sin registrar.
            var linea = LineaPhoneId ?? "null";
            var lista = await Api.GetTwMensajesAsync(Numero, linea);
            // Respaldo: si por esta línea todavía no hay nada (típico en DESARROLLO, donde el
            // historial real vive en PRODUCCIÓN), mostramos el hilo del contacto sin filtrar por
            // línea para no dejar la card vacía. En PROD no se usa (la línea tiene historial).
            if (lista.Count == 0)
                lista = await Api.GetTwMensajesAsync(Numero, null);
            mensajes = lista;
            // 2026-08-12: si la ventana de 24 hs está cerrada y todavía no traje las plantillas
            // aprobadas, las cargo una vez para poder ofrecer el selector en el chat.
            if (plantillasWa is null && !EsChatIgPwa() && !VentanaWaAbierta())
                try { plantillasWa = await Api.GetTwPlantillasAsync(); } catch { plantillasWa = new(); }
        }
        catch { mensajes ??= new(); }
    }

    private async Task OnKey(Microsoft.AspNetCore.Components.Web.KeyboardEventArgs e)
    {
        // Enter envía; Shift+Enter hace renglón nuevo (como WhatsApp).
        if (e.Key == "Enter" && !e.ShiftKey) await Enviar();
    }

    private async Task Enviar()
    {
        var texto = (composer ?? "").Trim();
        if (sending || string.IsNullOrWhiteSpace(texto)) return;
        // Depósito: exige elegir firmante y lo agrega al final -> "OK (alex)".
        if (esDeposito)
        {
            if (string.IsNullOrWhiteSpace(firmante))
            {
                Toast.Warning("Elegí quién responde (arriba del cuadro de escribir).");
                return;
            }
            texto = $"{texto} ({firmante})";
        }
        sending = true;
        var replyId = respondiendoA?.Id;   // 2026-08-12: si estás respondiendo citando, va el id del mensaje citado
        var (ok, err) = await Api.SendTwMensajeAsync(Numero, texto, LineaPhoneId, replyId);
        sending = false;
        if (ok)
        {
            composer = "";
            respondiendoA = null;   // se limpió la cita solo si salió bien (si falló, no perdés a quién le respondías)
            await Cargar();
        }
        else
        {
            Toast.Error(err ?? "No se pudo enviar el mensaje");
        }
    }

    // ===== 2026-08-12: toque sostenido (long-press) sobre un mensaje -> menú con reaccionar / responder =====
    // Igual que el WhatsApp real: mantené apretado el mensaje ~medio segundo y se abre el menú.
    // Un toque normal (corto) o un scroll cancelan el temporizador y no abren nada.
    private int? menuMsgId;
    private System.Threading.CancellationTokenSource? pressCts;
    private static readonly string[] QuickEmojisPwa = { "👍", "❤️", "😂", "😮", "😢", "🙏", "☕", "✅" };

    private async Task PressStart(int msgId)
    {
        pressCts?.Cancel();
        var cts = new System.Threading.CancellationTokenSource();
        pressCts = cts;
        try { await Task.Delay(500, cts.Token); }
        catch { return; }
        if (cts.IsCancellationRequested) return;
        menuMsgId = msgId;
        StateHasChanged();
    }
    private void PressEnd() => pressCts?.Cancel();
    private void CerrarMenuMsg() { menuMsgId = null; }

    private async Task ReaccionarPwa(int msgId, string emoji)
    {
        menuMsgId = null;
        var r = await Api.ToggleReaccionAsync(msgId, emoji);
        if (r is null) { Toast.Error("No se pudo reaccionar"); return; }
        if (r.EnviadaAlCliente) Toast.Success($"{emoji} enviada — el cliente la ve en su WhatsApp");
        await Cargar();
        StateHasChanged();
    }

    // Responder citando (reply). respondiendoA = mensaje al que le estás contestando (null = ninguno).
    private ApiClient.TwMsgDto? respondiendoA;
    private void IniciarResponderPwa(ApiClient.TwMsgDto m) { respondiendoA = m; menuMsgId = null; }
    private void CancelarResponderPwa() => respondiendoA = null;
    private string PreviewRespuestaPwa(ApiClient.TwMsgDto m)
    {
        if (!string.IsNullOrWhiteSpace(m.Cuerpo)) return Recortar2(m.Cuerpo, 60);
        if (!string.IsNullOrWhiteSpace(m.MediaUrl))
        {
            if (EsAudio(m.MediaUrl)) return "🎤 Nota de voz";
            if (EsImagen(m.MediaUrl)) return "📷 Imagen";
            return "📎 Archivo";
        }
        return "Mensaje";
    }

    // === 2026-08-06: nota de voz (grabar con micrófono y enviar como audio) — reusa el mismo
    // grabador (window.waAudio) y endpoint (SendTwMediaAsync) que la pantalla grande de WhatsApp. ===
    private bool grabandoAudio, enviandoAudio;
    private class WaUploadRes { public string? Url { get; set; } public string? OriginalFilename { get; set; } }

    private async Task ToggleGrabarAudio()
    {
        if (!grabandoAudio)
        {
            bool ok;
            try { ok = await JS.InvokeAsync<bool>("waAudio.start"); }
            catch { ok = false; }
            if (!ok) { Toast.Error("No pude acceder al micrófono. Revisá los permisos del navegador (y que estés en HTTPS)."); return; }
            grabandoAudio = true;
        }
        else
        {
            grabandoAudio = false;
            enviandoAudio = true;
            StateHasChanged();
            WaUploadRes? res = null;
            try { res = await JS.InvokeAsync<WaUploadRes?>("waAudio.stopAndUpload"); }
            catch { }
            if (res == null || string.IsNullOrEmpty(res.Url))
            {
                enviandoAudio = false;
                Toast.Error("No se pudo grabar o subir el audio");
                StateHasChanged();
                return;
            }
            var (ok, err) = await Api.SendTwMediaAsync(Numero, res.Url, null, res.OriginalFilename, LineaPhoneId);
            enviandoAudio = false;
            if (!ok) Toast.Error(err ?? "No se pudo enviar la nota de voz");
            else await Cargar();
            StateHasChanged();
        }
    }

    private async Task CancelarAudio()
    {
        grabandoAudio = false;
        try { await JS.InvokeVoidAsync("waAudio.cancel"); } catch { }
    }

    // 2026-08-07: ocultar/mostrar un mensaje a Depósito (solo admin/oficina).
    private async Task ToggleOcultar(ApiClient.TwMsgDto m)
    {
