@* 2026-08-05: Mini-chat FIJO para el Dashboard. Muestra UNA conversación puntual
   (número + línea) para leer los últimos mensajes y responder ahí mismo (solo texto).
   Se usa para la conversación "importante" (Gabriel + FIJO TRANSRADIO) y también la
   ve el usuario "depósito". El backend (/api/whatsapp/twilio/*) es [Authorize] a secas,
   así que cualquier usuario logueado puede leer y escribir en esta conversación. *@
@using Web.Services
@inject Web.Services.ApiClient Api
@inject Web.Services.ToastService Toast
@inject Web.Services.AuthService AuthSvc
@inject Web.Services.OperatorService Op
@inject Microsoft.JSInterop.IJSRuntime JS
@inject Web.Services.WaAparienciaService Apariencia
@inject Web.Services.PresenceService Vivo
@implements IDisposable

@* 2026-08-15: se pinta según el tema de SU línea (oscuro/claro) + la letra elegida. *@
<div class="pwa-card @Apariencia.ClasesPara(LineaPhoneId)">
    @if (!Movil)
    {
    <div class="pwa-head">
        <div class="pwa-head-l">
            <span class="pwa-avatar">@InicialContacto()</span>
            <div class="pwa-head-txt">
                <div class="pwa-head-name" title="@TituloContacto">@TituloContacto</div>
                <div class="pwa-head-line">🟢 @NombreLinea</div>
            </div>
        </div>
        <div class="pwa-head-r">
            <span class="pwa-pin" title="Conversación fijada">📌 Fijada</span>
            @if (PuedeAbrirEnGrande)
            {
                <button class="pwa-open" @onclick="AbrirEnGrande" title="Abrir esta conversación en grande, en una pestaña nueva">Abrir ⤢</button>
            }
        </div>
    </div>
    }

    <div class="pwa-body">
        @if (mensajes is null)
        {
            <div class="pwa-info">Cargando conversación…</div>
        }
        else if (mensajes.Count == 0)
        {
            <div class="pwa-info">Todavía no hay mensajes en esta conversación.</div>
        }
        else
        {
            @* column-reverse: renderizamos del más nuevo al más viejo; el CSS lo
               muestra con el más nuevo abajo y el scroll pegado al fondo, sin JS. *@
            @foreach (var m in Enumerable.Reverse(mensajes))
            {
                var mine = m.Direccion == "OUTGOING";
                <div class="pwa-row @(mine ? "out" : "in")">
                    <div id="@($"pwamsg-{m.Id}")" class="pwa-bubble @(mine ? "out" : "in") @(menuMsgId == m.Id ? "sel" : "") @(m.Anulado ? "pwa-anulado" : "")"
                         @onpointerdown="() => PressStart(m.Id)" @onpointerup="PressEnd"
                         @onpointerleave="PressEnd" @onpointercancel="PressEnd"
                         @oncontextmenu:preventDefault="true">
                        @if (esDeposito && m.OcultoDeposito)
                        {
                            @* Depósito: no ve el contenido, solo el cartelito. *@
                            <div class="pwa-oculto">🚫 Mensaje ocultado</div>
                        }
                        else
                        {
                            @* 2026-08-07: cita del mensaje al que responde (responder citando) *@
                            @if (!string.IsNullOrWhiteSpace(m.ReplyPreview))
                            {
                                @* 2026-08-18: tocar la cajita lleva al mensaje original y lo resalta,
                                   como WhatsApp. Antes era solo decorativa. *@
                                <div class="pwa-reply-quote pwa-reply-clic" title="Tocá para ir al mensaje original"
                                     @onclick="() => IrAlCitado(m)" @onclick:stopPropagation="true">
                                    <span class="pwa-reply-who">@(m.ReplyFromMe ? "Vos" : TituloContacto)</span>
                                    <span class="pwa-reply-text">@m.ReplyPreview</span>
                                </div>
                            }
                            @if (!string.IsNullOrWhiteSpace(m.MediaUrl))
                            {
                                @if (EsAudio(m.MediaUrl))
                                {
                                    @* Nota de voz: se escucha acá mismo, como en WhatsApp *@
                                    <audio controls preload="none" src="@m.MediaUrl" class="pwa-audio"></audio>
                                }
                                else if (EsImagen(m.MediaUrl))
                                {
                                    <a href="@m.MediaUrl" target="_blank" rel="noopener" draggable="false" @ondragstart:preventDefault="true"><img src="@m.MediaUrl" class="pwa-img @(EsSticker(m.MediaUrl) ? "pwa-sticker" : "")" alt="imagen" draggable="false" /></a>
                                }
                                else
                                {
                                    <a class="pwa-media" href="@m.MediaUrl" target="_blank" rel="noopener">📎 @(string.IsNullOrWhiteSpace(m.MediaFilename) ? "Archivo adjunto" : m.MediaFilename)</a>
                                }
                            }
                            @if (!string.IsNullOrWhiteSpace(m.Cuerpo))
                            {
                                <div class="pwa-text">@m.Cuerpo</div>
                            }
                            @if (m.OcultoDeposito)
                            {
                                <div class="pwa-oculto-badge">🚫 oculto a Depósito</div>
                            }
                            @* 2026-08-19: se mandó una corrección de este mensaje. El cliente lo sigue
                               viendo normal en su celular; el tachado es solo de nuestro lado. *@
                            @if (m.Anulado)
                            {
                                <div class="pwa-anulado-badge">⚠️ anulado@(string.IsNullOrEmpty(m.AnuladoPor) ? "" : $" por {m.AnuladoPor}")</div>
                            }
                            @* 2026-08-19: en los globitos con foto, audio o archivo el toque sostenido no
                               siempre llega (el reproductor y los enlaces se quedan con el toque), asi que
                               les damos un boton propio que abre el MISMO menu de reaccionar/responder. *@
                            @if (!string.IsNullOrWhiteSpace(m.MediaUrl))
                            {
                                <button type="button" class="pwa-opts-btn" @onclick="() => AbrirMenuMsg(m.Id)"
                                        title="Opciones: reaccionar o responder este mensaje">⋮ Opciones</button>
                            }
                        }
                        <div class="pwa-time">
                            @FormatHora(m.CreatedAt)
                            @* 2026-08-18: tildes de enviado/entregado/leído, como en la pantalla grande *@
                            @if (mine)
                            {
                                <span class="@TildeCss(m.EstadoEntrega)" title="@TildeTitulo(m.EstadoEntrega)">@TildeTexto(m.EstadoEntrega)</span>
                            }
                        </div>
                        @* 2026-08-07: reacciones (solo se muestran) *@
                        @if (!(esDeposito && m.OcultoDeposito) && m.Reacciones != null && m.Reacciones.Count > 0)
                        {
                            <div class="pwa-reacciones">
                                @foreach (var r in m.Reacciones)
                                {
                                    <span class="pwa-reaccion-chip">@r.Emoji@(r.Count > 1 ? $" {r.Count}" : "")</span>
                                }
                            </div>
                        }
                        @* 2026-08-07: ocultar/mostrar a Depósito — solo admin/oficina.
                           2026-08-12: y SOLO en los chats que ve Depósito. *@
                        @if (!esDeposito && EsChatVisibleDeposito)
                        {
                            <button type="button" class="pwa-ocultar-btn" @onclick="() => ToggleOcultar(m)"
                                    title="@(m.OcultoDeposito ? "Mostrar este mensaje a Depósito" : "Ocultar este mensaje a Depósito")">
                                @(m.OcultoDeposito ? "👁 Mostrar a Depósito" : "🚫 Ocultar a Depósito")
                            </button>
                        }
                    </div>
                </div>
            }
        }
    </div>

    @* 2026-08-06: SOLO para el usuario Depósito — barrita para elegir QUIÉN responde. El mensaje
       sale firmado, ej "OK (alex)". Es obligatorio elegir antes de enviar. Los demás usuarios no
       ven esta barra. Misma lógica que la pantalla grande de WhatsApp, acá en versión mini. *@
    @if (esDeposito && VentanaWaAbierta())
    {
        <div class="pwa-firma">
            <span class="pwa-firma-lbl">✍️ Responde:</span>
            @foreach (var f in FirmantesDeposito)
            {
                <button type="button" class="pwa-firma-btn @(firmante == f ? "on" : "")" @onclick="() => firmante = f">@Capitalizar(f)</button>
            }
            <span class="pwa-firma-hint">@(string.IsNullOrWhiteSpace(firmante) ? "👈 elegí quién responde" : $"sale como … ({firmante})")</span>
        </div>
    }

    @* 2026-08-07: acciones extra (solo cuando AccionesCompletas=true: móvil / card flotante).
       2026-08-18: la barra fija con ➕ / ⚡ Respuestas / 👋 Menú rol se comía un renglón de pantalla
       SIEMPRE. Ahora Respuestas y Menú rol viven adentro del ➕ (que quedó en el composer, al lado
       del clip), y acá abajo solo queda el panel de respuestas cuando se abre. *@
    @if (AccionesCompletas && VentanaWaAbierta())
    {
        @if (showResp)
        {
            <div class="pwa-resp-panel">
                @if (respuestas is null)
                {
                    <div class="pwa-resp-vacio">Cargando…</div>
                }
                else if (!respuestas.Any(x => x.Activo))
                {
                    <div class="pwa-resp-vacio">No hay respuestas rápidas cargadas.</div>
                }
                else
                {
                    @foreach (var r in respuestas.Where(x => x.Activo).OrderBy(x => x.Orden))
                    {
                        <button type="button" class="pwa-resp-item" @onclick="() => UsarRespuestaAsync(r)">
                            <span class="pwa-resp-nom">@r.Nombre</span>
                            <span class="pwa-resp-txt">@Recortar2(r.Texto, 70)</span>
                        </button>
                    }
                }
            </div>
        }
    }

    @* 2026-08-18: confirmación antes de mandar el menú de opciones al cliente. *@
    @if (confirmarMenuRol)
    {
        <div class="pwa-confirmar">
            <div class="pwa-confirmar-txt">
                ¿Le mando a <strong>@TituloContacto</strong> el menú de opciones
                ("¿con quién te querés contactar?")?
            </div>
            <div class="pwa-confirmar-btns">
                <button type="button" class="pwa-confirmar-no" @onclick="CancelarMenuRol">No</button>
                <button type="button" class="pwa-confirmar-si" @onclick="ConfirmarMenuRol" disabled="@enviandoMenuRol">
                    @(enviandoMenuRol ? "Enviando…" : "Sí, mandalo")
                </button>
            </div>
        </div>
    }

    @* 2026-08-12: barra "Respondiendo a…" (responder citando). Aparece arriba del cuadro de escribir. *@
    @if (respondiendoA is not null && VentanaWaAbierta())
    {
        <div class="pwa-replybar">
            <div class="pwa-replybar-body">
                <span class="pwa-replybar-who">↩️ Respondiendo a @(respondiendoA.Direccion == "OUTGOING" ? "vos" : TituloContacto)</span>
                <span class="pwa-replybar-text">@PreviewRespuestaPwa(respondiendoA)</span>
            </div>
            <button type="button" class="pwa-replybar-x" @onclick="CancelarResponderPwa" title="Cancelar respuesta">×</button>
        </div>
    }
    @* 2026-08-19: el archivo que está ESPERANDO para salir. Se ve grande, se puede descartar con la
       ✖ y sale recién al tocar Enviar (con el texto del cuadro de pie de foto). *@
    @if (adjuntoPend is not null && VentanaWaAbierta())
    {
        <div class="pwa-adj-prev">
            <div class="pwa-adj-head">📎 Para enviar — escribí un texto si querés y tocá <b>Enviar</b></div>
            <div class="pwa-adj-body">
                @if (adjuntoPend.EsImagen)
                {
                    <img class="pwa-adj-img" src="@adjuntoPend.Url" alt="vista previa" />
                }
                else
                {
                    <div class="pwa-adj-ico">📄</div>
                }
                <span class="pwa-adj-nom" title="@adjuntoPend.FileName">@adjuntoPend.FileName</span>
                <button type="button" class="pwa-adj-x" @onclick="QuitarAdjuntoPend" title="No mandarlo">×</button>
            </div>
        </div>
    }
    @if (VentanaWaAbierta())
    {
    <div class="pwa-composer">
        @if (grabandoAudio)
        {
            @* Grabando nota de voz: parar+enviar o cancelar *@
            <span class="pwa-rec-label">● grabando nota de voz…</span>
            <button class="pwa-mic pwa-mic-cancel" @onclick="CancelarAudio" title="Cancelar">✖️</button>
            <button class="pwa-mic pwa-mic-stop" @onclick="ToggleGrabarAudio" title="Parar y enviar">⏹️</button>
        }
        else
        {
            @* 2026-08-18: el ➕ pasó acá (antes estaba en la barra de arriba que ocupaba un renglón fijo).
               Adentro están Respuestas rápidas, Menú rol, adjuntar del servidor, contacto y saldo. *@
            @if (AccionesCompletas)
            {
                <button type="button" class="pwa-attach" @onclick="AbrirMas" title="Más: respuestas rápidas, menú de opciones, adjuntar del servidor, contacto, saldo">➕</button>
            }
            @* Adjuntar foto/archivo de la PC o del celu (máx 16 MB) *@
            <label class="pwa-attach" title="Adjuntar foto o archivo">
                <InputFile OnChange="OnAdjuntar" disabled="@(sending || enviandoAudio || subiendo)" style="display:none;" />
                @(subiendo ? "⏳" : "📎")
            </label>
            @* Sacar una foto con la cámara (en el celu abre la cámara; en la PC, el explorador) *@
            <label class="pwa-attach" title="Sacar una foto">
                <InputFile OnChange="OnAdjuntar" accept="image/*" capture="environment" disabled="@(sending || enviandoAudio || subiendo)" style="display:none;" />
                📷
            </label>
            @* 2026-08-18: @oninput propio (en vez de @bind con oninput) para NO redibujar los 200
               mensajes en cada tecla — en el celu eso se sentia como teclado trabado. Ver ShouldRender.
               2026-08-19: ADEMAS ya no lleva value="@composer". Ese atributo hacia que, cada vez que
               la pantalla se redibujaba (y ahora los mensajes entran al instante), Blazor le
               reescribiera el texto al cuadro y le cortara al teclado del celu la palabra que estaba
               proponiendo: el predictivo quedaba inutil. Ahora el texto del cuadro lo maneja el
               navegador y .NET solo lo toca cuando hace falta (waComposer.setValor).
               Los atributos de abajo le piden al teclado el comportamiento de WhatsApp: sugerencias,
               corrección y mayúscula al empezar la oración. *@
            <textarea @ref="composerRef" class="pwa-input"
                      placeholder="@(Movil ? "Escribir mensaje…" : "Escribir mensaje… (Enter para enviar)")"
                      autocapitalize="sentences" autocorrect="on" spellcheck="true"
                      enterkeyhint="@(Movil ? "enter" : "send")" autocomplete="off"
                      @oninput="OnComposerInput" @onkeydown="OnKey" rows="1" disabled="@(sending || enviandoAudio || subiendo)"></textarea>
            @* 2026-08-19: con un archivo esperando, el botón es SIEMPRE Enviar aunque no haya texto
               (si no, no habría con qué mandarlo: sin texto salía el micrófono). *@
            @if (string.IsNullOrWhiteSpace(composer) && adjuntoPend is null)
            {
                @* Sin texto: botón de micrófono para nota de voz (como WhatsApp) *@
                <button class="pwa-mic" @onclick="ToggleGrabarAudio" disabled="@(sending || enviandoAudio)" title="Grabar nota de voz">
                    @(enviandoAudio ? "⏳" : "🎤")
                </button>
            }
            else
            {
                <button class="pwa-send" @onclick="Enviar" disabled="@sending">
                    @(sending ? "⏳" : "Enviar")
                </button>
            }
        }
    </div>
    }
    else if (EsChatIgPwa())
    {
        @* Instagram fuera de las 24 hs: no hay plantillas, solo se puede esperar. *@
        <div class="pwa-cerrada">
            <div class="pwa-cerrada-head">
                <span class="pwa-cerrada-ico">📷</span>
                <div>
                    <div class="pwa-cerrada-title">Pasaron más de 24 hs</div>
                    <div class="pwa-cerrada-sub">En Instagram no se puede escribir fuera de las 24 hs. Hay que esperar a que te vuelva a escribir.</div>
                </div>
            </div>
        </div>
    }
    else
    {
        @* Ventana de WhatsApp cerrada: NO se puede escribir libre. Ofrecemos plantilla acá mismo. *@
        <div class="pwa-cerrada">
            <div class="pwa-cerrada-head">
                <span class="pwa-cerrada-ico">✍️</span>
                <div>
                    <div class="pwa-cerrada-title">Pasaron más de 24 hs</div>
                    <div class="pwa-cerrada-sub">WhatsApp no deja escribirle texto libre. Mandale una plantilla aprobada; cuando te conteste, volvés a escribirle normal.</div>
                </div>
            </div>
            @if (plantillasWa is null)
            {
                <div class="pwa-cerrada-info">Cargando plantillas…</div>
            }
            else if (plantillasWa.Count == 0)
            {
                <div class="pwa-cerrada-info">No hay plantillas aprobadas disponibles. Revisá la configuración de WhatsApp.</div>
            }
            else
            {
                <select class="pwa-cerrada-sel" value="@plantillaName" @onchange="OnPlantillaChange">
                    <option value="">— Elegí una plantilla —</option>
                    @foreach (var p in plantillasWa)
                    {
                        <option value="@p.Name">@p.Name.Replace("_", " ") (@p.Category.ToLower())</option>
                    }
                </select>
                @if (PlantillaSelWa() is {} psel)
                {
                    @if (psel.VariableCount > 0)
                    {
                        @for (int i = 0; i < psel.VariableCount; i++)
                        {
                            var idx = i;
                            <input class="pwa-cerrada-sel" style="margin-top:0.4rem;"
                                   placeholder="@PlaceholderVarWa(psel, idx)"
                                   value="@(idx < plantillaVars.Count ? plantillaVars[idx] : "")"
                                   @oninput="e => SetPlantillaVar(idx, e.Value?.ToString() ?? string.Empty)" />
                        }
                    }
                    <div class="pwa-cerrada-preview">@PreviewPlantillaWa()</div>
                    <button class="pwa-cerrada-enviar" disabled="@plantillaEnviando" @onclick="EnviarPlantillaWa">
                        @(plantillaEnviando ? "Enviando…" : "📨 Enviar plantilla")
                    </button>
                }
            }
        </div>
    }

    @* 2026-08-12: menú que abre el TOQUE SOSTENIDO sobre un mensaje: reaccionar (emojis) + responder. *@
    @if (menuMsgId is int _mid && mensajes?.FirstOrDefault(x => x.Id == _mid) is {} _mm)
    {
        <div class="pwa-msgmenu-backdrop" @onclick="CerrarMenuMsg">
            <div class="pwa-msgmenu" @onclick:stopPropagation="true">
                <div class="pwa-msgmenu-emojis">
                    @foreach (var em in QuickEmojisPwa)
                    {
                        <button type="button" class="pwa-msgmenu-emoji" @onclick="() => ReaccionarPwa(_mm.Id, em)">@em</button>
                    }
                </div>
                @if (VentanaWaAbierta())
                {
                    <button type="button" class="pwa-msgmenu-op" @onclick="() => IniciarResponderPwa(_mm)">↩️ Responder</button>
                    @* 2026-08-19: corregir — solo sobre los mensajes que mandamos nosotros *@
                    @if (_mm.Direccion == "OUTGOING" && !_mm.Anulado)
                    {
                        <button type="button" class="pwa-msgmenu-op" style="margin-top:6px;" @onclick="() => IniciarCorregirPwa(_mm)">⚠️ Corregir</button>
                    }
                }
            </div>
        </div>
    }

    @* 2026-08-07 (Fase 2): panel del ➕ — Adjuntar del servidor / Contacto / Saldo. Overlay sobre la card. *@
    @if (mostrarMas)
    {
        <div class="pwa-mas">
            <div class="pwa-mas-head">
                @if (masVista != "menu")
                {
                    <button type="button" class="pwa-mas-back" @onclick="VolverMenuMas" title="Volver">←</button>
                }
                <span class="pwa-mas-title">@TituloMas()</span>
                <button type="button" class="pwa-mas-x" @onclick="CerrarMas" title="Cerrar">✕</button>
            </div>
            <div class="pwa-mas-body">
                @if (masVista == "menu")
                {
                    @* 2026-08-18: acá adentro entran ahora Respuestas rápidas y Menú rol *@
                    @if (AccionesCompletas)
                    {
                        <button type="button" class="pwa-mas-op" @onclick="AbrirRespuestasDesdeMas">⚡ Respuestas rápidas</button>
                        <button type="button" class="pwa-mas-op" @onclick="PedirConfirmarMenuRol">👋 Mandar el menú de opciones</button>
                    }
                    <button type="button" class="pwa-mas-op" @onclick="AbrirServidor">📁 Adjuntar del servidor</button>
                    <button type="button" class="pwa-mas-op" @onclick="AbrirContacto">👤 Compartir un contacto</button>
                    <button type="button" class="pwa-mas-op" @onclick="AbrirSaldo">💰 Mandar el saldo de un cliente</button>
                }
                else if (masVista == "servidor")
                {
                    <div class="pwa-mas-tabs">
                        @foreach (var t in SrvTabs)
                        {
                            <button type="button" class="pwa-mas-tab @(srvTab == t.Key ? "on" : "")" @onclick="() => CambiarTab(t.Key)">@t.Label</button>
                        }
                    </div>
                    <input class="pwa-mas-search" placeholder="Buscar…" value="@srvSearch" @oninput="OnSrvSearch" />
                    @if (srvLoading)
                    {
                        <div class="pwa-mas-info">Cargando…</div>
                    }
                    else if (srvItems.Count == 0)
                    {
                        <div class="pwa-mas-info">Sin resultados.</div>
                    }
                    else
                    {
                        @foreach (var f in srvItems)
                        {
                            <button type="button" class="pwa-mas-item" @onclick="() => EnviarServidor(f)" disabled="@srvEnviando">
                                <span class="pwa-mas-item-ic">@(string.IsNullOrWhiteSpace(f.Icon) ? "📎" : f.Icon)</span>
                                <span class="pwa-mas-item-txt">
                                    <span class="pwa-mas-item-lbl">@f.Label</span>
                                    @if (!string.IsNullOrWhiteSpace(f.SubLabel))
                                    {
                                        <span class="pwa-mas-item-sub">@f.SubLabel</span>
                                    }
                                </span>
                            </button>
                        }
                    }
                }
                else if (masVista == "contacto")
                {
                    <input class="pwa-mas-search" placeholder="Buscar contacto por nombre o número…" value="@contQuery" @oninput="BuscarContacto" />
                    @if (contBuscando)
                    {
                        <div class="pwa-mas-info">Buscando…</div>
                    }
                    else if (contQuery.Trim().Length >= 2 && contResult.Count == 0)
                    {
                        <div class="pwa-mas-info">Sin contactos con teléfono para esa búsqueda.</div>
                    }
                    @foreach (var c in contResult)
                    {
                        <button type="button" class="pwa-mas-item" @onclick="() => EnviarContacto(c)" disabled="@contEnviando">
                            <span class="pwa-mas-item-ic">👤</span>
                            <span class="pwa-mas-item-txt">
                                <span class="pwa-mas-item-lbl">@c.Nombre</span>
                                <span class="pwa-mas-item-sub">@c.Numero · @c.Origen</span>
                            </span>
                        </button>
                    }
                }
                else if (masVista == "saldo")
                {
                    <input class="pwa-mas-search" placeholder="Buscar cliente por nombre…" value="@salQuery" @oninput="BuscarSaldo" />
                    @if (salBuscando)
                    {
                        <div class="pwa-mas-info">Buscando…</div>
                    }
                    else if (salQuery.Trim().Length >= 2 && salResult.Count == 0)
                    {
                        <div class="pwa-mas-info">Sin resultados.</div>
                    }
                    @foreach (var cli in salResult.Take(15))
                    {
                        <button type="button" class="pwa-mas-item" @onclick="() => PonerSaldoTexto(cli.Id)" disabled="@salCargando">
                            <span class="pwa-mas-item-ic">💰</span>
                            <span class="pwa-mas-item-txt">
                                <span class="pwa-mas-item-lbl">@cli.Nombre @(string.IsNullOrWhiteSpace(cli.CodigoInterno) ? "" : $"(#{cli.CodigoInterno})")</span>
                            </span>
                        </button>
                    }
                    @if (salCargando)
                    {
                        <div class="pwa-mas-info">Trayendo saldo…</div>
                    }
                }
            </div>
        </div>
    }
</div>

