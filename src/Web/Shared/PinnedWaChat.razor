    private async Task OnKey(Microsoft.AspNetCore.Components.Web.KeyboardEventArgs e)
    {
        // En la compu: Enter envía, Shift+Enter hace renglón nuevo (como WhatsApp Web).
        // 2026-08-18: en el CELU Enter baja de línea y se manda con el botón, como la app:
        // ahí no hay Shift, así que antes no se podía escribir un mensaje de dos renglones.
        if (Movil) return;
        if (e.Key == "Enter" && !e.ShiftKey) await Enviar();
    }

    private async Task Enviar()
    {
        var texto = (composer ?? "").Trim();
        if (sending) return;
        // 2026-08-19: si hay un archivo esperando, lo que sale es el archivo (con el texto de pie).
        if (adjuntoPend is not null)
        {
            var pie = texto;
            // En los chats de Depósito el pie también lleva la firma, igual que un mensaje normal.
            if (!string.IsNullOrEmpty(pie))
            {
                var f = EsChatVisibleDeposito ? Web.Services.OperatorService.FirmaCorta(Op.Current) : "";
                if (!string.IsNullOrEmpty(f)) pie = $"{pie} ({f})";
                else if (esDeposito && !string.IsNullOrWhiteSpace(firmante)) pie = $"{pie} ({firmante})";
            }
            await EnviarAdjuntoPendiente(pie);
            return;
        }
        if (string.IsNullOrWhiteSpace(texto)) return;
        // 2026-08-12: en los chats que ve Depósito, firma AUTOMÁTICA con el operador del PIN (os/ger/ga).
        // Sin operador con abreviatura -> sin firma (opción b). Tiene prioridad sobre la firma manual.
        var firmaAuto = EsChatVisibleDeposito ? Web.Services.OperatorService.FirmaCorta(Op.Current) : "";
        if (!string.IsNullOrEmpty(firmaAuto))
        {
            texto = $"{texto} ({firmaAuto})";
        }
        // Depósito: exige elegir firmante y lo agrega al final -> "OK (alex)".
        else if (esDeposito)
        {
            if (string.IsNullOrWhiteSpace(firmante))
            {
                Toast.Warning("Elegí quién responde (arriba del cuadro de escribir).");
                return;
            }
            texto = $"{texto} ({firmante})";
        }
        sending = true;
        var replyId = respondiendoA?.Id;   // 2026-08-12: si estás respondiendo citando, va el id del mensaje citado
        // 2026-08-19: si esto es una corrección, a cuál mensaje corrige. Se marca solo si sale bien.
        var corrigeA = corrigiendoIdPwa;
        corrigiendoIdPwa = null;

        // 2026-08-18: la burbuja aparece AL INSTANTE con el relojito, como WhatsApp, en vez de
        // esperar la respuesta del servidor mirando la pantalla quieta. Si sale bien, la recarga
        // la reemplaza por la de verdad; si falla, se saca y queda el texto para reintentar.
        var provisorio = new ApiClient.TwMsgDto(
            Id: -1, Direccion: "OUTGOING", Numero: Numero, NombrePerfil: null,
            Cuerpo: texto, MediaUrl: null, MediaFilename: null, NumMedia: 0,
            Procesado: false, RespuestaEnviada: null, CreatedAt: DateTime.UtcNow,
            EstadoEntrega: "pendiente", Reacciones: null);
        var textoOriginal = composer ?? "";
        mensajes ??= new();
        mensajes.Add(provisorio);   // la lista viene de más viejo a más nuevo
        composer = "";
        await SincronizarComposer();   // vaciar el cuadro en el navegador
        StateHasChanged();

        var (ok, err) = await Api.SendTwMensajeAsync(Numero, texto, LineaPhoneId, replyId);
        sending = false;
        if (ok)
        {
            respondiendoA = null;   // se limpió la cita solo si salió bien (si falló, no perdés a quién le respondías)
            if (corrigeA is int _anu) await Api.AnularMensajeAsync(_anu, true);
            await Cargar();
        }
        else
        {
            mensajes.Remove(provisorio);
            composer = textoOriginal;   // no perder lo escrito
            corrigiendoIdPwa = corrigeA;   // tampoco se pierde que estabas corrigiendo
            await SincronizarComposer();
            Toast.Error(err ?? "No se pudo enviar el mensaje");
        }
    }

    // ===== 2026-08-12: toque sostenido (long-press) sobre un mensaje -> menú con reaccionar / responder =====
    // Igual que el WhatsApp real: mantené apretado el mensaje ~medio segundo y se abre el menú.
    // Un toque normal (corto) o un scroll cancelan el temporizador y no abren nada.
    private int? menuMsgId;
    private System.Threading.CancellationTokenSource? pressCts;
    private static readonly string[] QuickEmojisPwa = { "👍", "❤️", "😂", "😮", "😢", "🙏", "☕", "✅", "❌" };

    private async Task PressStart(int msgId)
    {
        pressCts?.Cancel();
        var cts = new System.Threading.CancellationTokenSource();
        pressCts = cts;
        try { await Task.Delay(500, cts.Token); }
        catch { return; }
        if (cts.IsCancellationRequested) return;
        menuMsgId = msgId;
        StateHasChanged();
    }
    private void PressEnd() => pressCts?.Cancel();
    // 2026-08-19: abre el menu del mensaje sin toque sostenido (boton "⋮ Opciones" de fotos/audios/archivos).
    private void AbrirMenuMsg(int msgId) { pressCts?.Cancel(); menuMsgId = msgId; }
