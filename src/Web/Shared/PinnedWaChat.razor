@* 2026-08-05: Mini-chat FIJO para el Dashboard. Muestra UNA conversación puntual
   (número + línea) para leer los últimos mensajes y responder ahí mismo (solo texto).
   Se usa para la conversación "importante" (Gabriel + FIJO TRANSRADIO) y también la
   ve el usuario "depósito". El backend (/api/whatsapp/twilio/*) es [Authorize] a secas,
   así que cualquier usuario logueado puede leer y escribir en esta conversación. *@
@using Web.Services
@inject Web.Services.ApiClient Api
@inject Web.Services.ToastService Toast
@inject Web.Services.AuthService AuthSvc
@inject Microsoft.JSInterop.IJSRuntime JS
@implements IDisposable

<div class="pwa-card">
    <div class="pwa-head">
        <div class="pwa-head-l">
            <span class="pwa-avatar">@InicialContacto()</span>
            <div class="pwa-head-txt">
                <div class="pwa-head-name" title="@TituloContacto">@TituloContacto</div>
                <div class="pwa-head-line">🟢 @NombreLinea</div>
            </div>
        </div>
        <div class="pwa-head-r">
            <span class="pwa-pin" title="Conversación fijada">📌 Fijada</span>
            @if (PuedeAbrirEnGrande)
            {
                <button class="pwa-open" @onclick="AbrirEnGrande" title="Abrir esta conversación en grande, en una pestaña nueva">Abrir ⤢</button>
            }
        </div>
    </div>

    <div class="pwa-body">
        @if (mensajes is null)
        {
            <div class="pwa-info">Cargando conversación…</div>
        }
        else if (mensajes.Count == 0)
        {
            <div class="pwa-info">Todavía no hay mensajes en esta conversación.</div>
        }
        else
        {
            @* column-reverse: renderizamos del más nuevo al más viejo; el CSS lo
               muestra con el más nuevo abajo y el scroll pegado al fondo, sin JS. *@
            @foreach (var m in Enumerable.Reverse(mensajes))
            {
                var mine = m.Direccion == "OUTGOING";
                <div class="pwa-row @(mine ? "out" : "in")">
                    <div class="pwa-bubble @(mine ? "out" : "in")">
                        @if (!string.IsNullOrWhiteSpace(m.MediaUrl))
                        {
                            @if (EsAudio(m.MediaUrl))
                            {
                                @* Nota de voz: se escucha acá mismo, como en WhatsApp *@
                                <audio controls preload="none" src="@m.MediaUrl" class="pwa-audio"></audio>
                            }
                            else if (EsImagen(m.MediaUrl))
                            {
                                <a href="@m.MediaUrl" target="_blank" rel="noopener"><img src="@m.MediaUrl" class="pwa-img" alt="imagen" /></a>
                            }
                            else
                            {
                                <a class="pwa-media" href="@m.MediaUrl" target="_blank" rel="noopener">📎 @(string.IsNullOrWhiteSpace(m.MediaFilename) ? "Archivo adjunto" : m.MediaFilename)</a>
                            }
                        }
                        @if (!string.IsNullOrWhiteSpace(m.Cuerpo))
                        {
                            <div class="pwa-text">@m.Cuerpo</div>
                        }
                        <div class="pwa-time">@FormatHora(m.CreatedAt)</div>
                    </div>
                </div>
            }
        }
    </div>

    @* 2026-08-06: SOLO para el usuario Depósito — barrita para elegir QUIÉN responde. El mensaje
       sale firmado, ej "OK (alex)". Es obligatorio elegir antes de enviar. Los demás usuarios no
       ven esta barra. Misma lógica que la pantalla grande de WhatsApp, acá en versión mini. *@
    @if (esDeposito)
    {
        <div class="pwa-firma">
            <span class="pwa-firma-lbl">✍️ Responde:</span>
            @foreach (var f in FirmantesDeposito)
            {
                <button type="button" class="pwa-firma-btn @(firmante == f ? "on" : "")" @onclick="() => firmante = f">@Capitalizar(f)</button>
            }
            <span class="pwa-firma-hint">@(string.IsNullOrWhiteSpace(firmante) ? "👈 elegí quién responde" : $"sale como … ({firmante})")</span>
        </div>
    }

    @* 2026-08-07: acciones extra (solo cuando AccionesCompletas=true: móvil / card flotante).
       Respuestas rápidas (abre lista) + Menú rol (un toque). 📎/📷/🎤 quedan en el composer. *@
    @if (AccionesCompletas)
    {
        <div class="pwa-acciones">
            <button type="button" class="pwa-acc-btn pwa-acc-mas" @onclick="AbrirMas" title="Más: adjuntar del servidor, contacto, saldo">➕</button>
            <button type="button" class="pwa-acc-btn @(showResp ? "on" : "")" @onclick="ToggleResp" title="Respuestas rápidas">⚡ Respuestas</button>
            <button type="button" class="pwa-acc-btn" @onclick="EnviarMenuRolMini" disabled="@enviandoMenuRol" title="Enviar el menú de opciones (¿con quién te querés contactar?)">@(enviandoMenuRol ? "⏳ Enviando…" : "👋 Menú rol")</button>
        </div>
        @if (showResp)
        {
            <div class="pwa-resp-panel">
                @if (respuestas is null)
                {
                    <div class="pwa-resp-vacio">Cargando…</div>
                }
                else if (!respuestas.Any(x => x.Activo))
                {
                    <div class="pwa-resp-vacio">No hay respuestas rápidas cargadas.</div>
                }
                else
                {
                    @foreach (var r in respuestas.Where(x => x.Activo).OrderBy(x => x.Orden))
                    {
                        <button type="button" class="pwa-resp-item" @onclick="() => UsarRespuesta(r)">
                            <span class="pwa-resp-nom">@r.Nombre</span>
                            <span class="pwa-resp-txt">@Recortar2(r.Texto, 70)</span>
                        </button>
                    }
                }
            </div>
        }
    }

    <div class="pwa-composer">
        @if (grabandoAudio)
        {
            @* Grabando nota de voz: parar+enviar o cancelar *@
            <span class="pwa-rec-label">● grabando nota de voz…</span>
            <button class="pwa-mic pwa-mic-cancel" @onclick="CancelarAudio" title="Cancelar">✖️</button>
            <button class="pwa-mic pwa-mic-stop" @onclick="ToggleGrabarAudio" title="Parar y enviar">⏹️</button>
        }
        else
        {
            @* Adjuntar foto/archivo de la PC o del celu (máx 16 MB) *@
            <label class="pwa-attach" title="Adjuntar foto o archivo">
                <InputFile OnChange="OnAdjuntar" disabled="@(sending || enviandoAudio || subiendo)" style="display:none;" />
                @(subiendo ? "⏳" : "📎")
            </label>
            @* Sacar una foto con la cámara (en el celu abre la cámara; en la PC, el explorador) *@
            <label class="pwa-attach" title="Sacar una foto">
                <InputFile OnChange="OnAdjuntar" accept="image/*" capture="environment" disabled="@(sending || enviandoAudio || subiendo)" style="display:none;" />
                📷
            </label>
            <textarea class="pwa-input" placeholder="Escribir mensaje… (Enter para enviar)"
                      @bind="composer" @bind:event="oninput" @onkeydown="OnKey" rows="1" disabled="@(sending || enviandoAudio || subiendo)"></textarea>
            @if (string.IsNullOrWhiteSpace(composer))
            {
                @* Sin texto: botón de micrófono para nota de voz (como WhatsApp) *@
                <button class="pwa-mic" @onclick="ToggleGrabarAudio" disabled="@(sending || enviandoAudio)" title="Grabar nota de voz">
                    @(enviandoAudio ? "⏳" : "🎤")
                </button>
            }
            else
            {
                <button class="pwa-send" @onclick="Enviar" disabled="@sending">
                    @(sending ? "⏳" : "Enviar")
                </button>
            }
        }
    </div>

    @* 2026-08-07 (Fase 2): panel del ➕ — Adjuntar del servidor / Contacto / Saldo. Overlay sobre la card. *@
    @if (mostrarMas)
    {
        <div class="pwa-mas">
            <div class="pwa-mas-head">
                @if (masVista != "menu")
                {
                    <button type="button" class="pwa-mas-back" @onclick="VolverMenuMas" title="Volver">←</button>
                }
                <span class="pwa-mas-title">@TituloMas()</span>
                <button type="button" class="pwa-mas-x" @onclick="CerrarMas" title="Cerrar">✕</button>
            </div>
            <div class="pwa-mas-body">
                @if (masVista == "menu")
                {
                    <button type="button" class="pwa-mas-op" @onclick="AbrirServidor">📁 Adjuntar del servidor</button>
                    <button type="button" class="pwa-mas-op" @onclick="AbrirContacto">👤 Compartir un contacto</button>
                    <button type="button" class="pwa-mas-op" @onclick="AbrirSaldo">💰 Mandar el saldo de un cliente</button>
                }
                else if (masVista == "servidor")
                {
                    <div class="pwa-mas-tabs">
                        @foreach (var t in SrvTabs)
                        {
                            <button type="button" class="pwa-mas-tab @(srvTab == t.Key ? "on" : "")" @onclick="() => CambiarTab(t.Key)">@t.Label</button>
                        }
                    </div>
                    <input class="pwa-mas-search" placeholder="Buscar…" value="@srvSearch" @oninput="OnSrvSearch" />
                    @if (srvLoading)
                    {
                        <div class="pwa-mas-info">Cargando…</div>
                    }
                    else if (srvItems.Count == 0)
                    {
                        <div class="pwa-mas-info">Sin resultados.</div>
                    }
                    else
                    {
                        @foreach (var f in srvItems)
                        {
                            <button type="button" class="pwa-mas-item" @onclick="() => EnviarServidor(f)" disabled="@srvEnviando">
                                <span class="pwa-mas-item-ic">@(string.IsNullOrWhiteSpace(f.Icon) ? "📎" : f.Icon)</span>
                                <span class="pwa-mas-item-txt">
                                    <span class="pwa-mas-item-lbl">@f.Label</span>
                                    @if (!string.IsNullOrWhiteSpace(f.SubLabel))
                                    {
                                        <span class="pwa-mas-item-sub">@f.SubLabel</span>
                                    }
                                </span>
                            </button>
                        }
                    }
                }
                else if (masVista == "contacto")
                {
                    <input class="pwa-mas-search" placeholder="Buscar contacto por nombre o número…" value="@contQuery" @oninput="BuscarContacto" />
                    @if (contBuscando)
                    {
                        <div class="pwa-mas-info">Buscando…</div>
                    }
                    else if (contQuery.Trim().Length >= 2 && contResult.Count == 0)
                    {
                        <div class="pwa-mas-info">Sin contactos con teléfono para esa búsqueda.</div>
                    }
                    @foreach (var c in contResult)
                    {
                        <button type="button" class="pwa-mas-item" @onclick="() => EnviarContacto(c)" disabled="@contEnviando">
                            <span class="pwa-mas-item-ic">👤</span>
                            <span class="pwa-mas-item-txt">
                                <span class="pwa-mas-item-lbl">@c.Nombre</span>
                                <span class="pwa-mas-item-sub">@c.Numero · @c.Origen</span>
                            </span>
                        </button>
                    }
                }
                else if (masVista == "saldo")
                {
                    <input class="pwa-mas-search" placeholder="Buscar cliente por nombre…" value="@salQuery" @oninput="BuscarSaldo" />
                    @if (salBuscando)
                    {
                        <div class="pwa-mas-info">Buscando…</div>
                    }
                    else if (salQuery.Trim().Length >= 2 && salResult.Count == 0)
                    {
                        <div class="pwa-mas-info">Sin resultados.</div>
                    }
                    @foreach (var cli in salResult.Take(15))
                    {
                        <button type="button" class="pwa-mas-item" @onclick="() => PonerSaldoTexto(cli.Id)" disabled="@salCargando">
                            <span class="pwa-mas-item-ic">💰</span>
                            <span class="pwa-mas-item-txt">
                                <span class="pwa-mas-item-lbl">@cli.Nombre @(string.IsNullOrWhiteSpace(cli.CodigoInterno) ? "" : $"(#{cli.CodigoInterno})")</span>
                            </span>
                        </button>
                    }
                    @if (salCargando)
                    {
                        <div class="pwa-mas-info">Trayendo saldo…</div>
                    }
                }
            </div>
        </div>
    }
</div>

<style>
    .pwa-card { position: relative; display: flex; flex-direction: column; height: 100%; min-height: 320px;
        background: #fff; border: 1px solid #e5e7eb; border-radius: 16px; overflow: hidden;
        box-shadow: 0 4px 16px rgba(0,0,0,0.10); }

    .pwa-head { display: flex; align-items: center; justify-content: space-between; gap: 8px;
        padding: 0.6rem 0.8rem; border-bottom: 1px solid #eef0f2; background: #f8fafb; }
    .pwa-head-l { display: flex; align-items: center; gap: 10px; min-width: 0; }
    .pwa-avatar { width: 36px; height: 36px; border-radius: 50%; background: #25d366; color: #fff;
        display: flex; align-items: center; justify-content: center; font-weight: 800; font-size: 0.95rem; flex: none; }
    .pwa-head-txt { min-width: 0; }
    .pwa-head-name { font-weight: 800; color: #111827; font-size: 0.95rem;
        white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
    .pwa-head-line { font-size: 0.72rem; color: #16a34a; font-weight: 700; }
    .pwa-head-r { display: flex; align-items: center; gap: 8px; flex: none; }
    .pwa-pin { font-size: 0.68rem; color: #6b7280; font-weight: 700; background: #eef2f7;
        padding: 3px 8px; border-radius: 999px; white-space: nowrap; }
    .pwa-open { border: 1px solid #d1d5db; background: #fff; color: #374151; font-weight: 700;
        font-size: 0.74rem; padding: 5px 10px; border-radius: 8px; cursor: pointer; white-space: nowrap; }
    .pwa-open:hover { background: #f3f4f6; }

    .pwa-body { flex: 1; min-height: 0; overflow-y: auto; padding: 0.7rem 0.8rem;
        display: flex; flex-direction: column-reverse; gap: 0.4rem;
        background: #e9ece6; }
    .pwa-info { margin: auto; color: #6b7280; font-size: 0.82rem; text-align: center; padding: 1rem; }
    .pwa-row { display: flex; }
    .pwa-row.in { justify-content: flex-start; }
    .pwa-row.out { justify-content: flex-end; }
    .pwa-bubble { max-width: 78%; padding: 0.4rem 0.6rem; border-radius: 10px;
        box-shadow: 0 1px 0.5px rgba(0,0,0,0.13); font-size: 0.86rem; line-height: 1.25; }
    .pwa-bubble.in { background: #fff; color: #111827; border-top-left-radius: 2px; }
    .pwa-bubble.out { background: #d9fdd3; color: #111827; border-top-right-radius: 2px; }
    .pwa-media { font-size: 0.8rem; font-weight: 600; color: #374151; margin-bottom: 2px; }
    .pwa-text { white-space: pre-wrap; word-break: break-word; }
    .pwa-time { font-size: 0.62rem; color: #6b7280; text-align: right; margin-top: 2px; }

    /* Media recibida: audio reproducible, imagen inline, resto link */
    .pwa-audio { max-width: 100%; height: 40px; display: block; margin-bottom: 0.2rem; }
    .pwa-img { max-width: 220px; max-height: 260px; border-radius: 8px; display: block; margin-bottom: 0.2rem; }

    /* Micrófono / grabación de nota de voz */
    .pwa-attach { border: none; border-radius: 12px; padding: 0.55rem 0.7rem; font-size: 1.1rem;
        cursor: pointer; background: #eef2f7; color: #374151; display: inline-flex; align-items: center;
        line-height: 1; flex: none; }
    .pwa-attach:hover { background: #e2e8f0; }

    .pwa-mic { border: none; border-radius: 12px; padding: 0.55rem 0.95rem; font-size: 1rem;
        cursor: pointer; background: #25d366; color: #fff; white-space: nowrap; line-height: 1; }
    .pwa-mic:hover:not(:disabled) { filter: brightness(1.05); }
    .pwa-mic:disabled { background: #cbd5d3; cursor: not-allowed; }
    .pwa-mic-stop { background: #ef4444; }
    .pwa-mic-cancel { background: #6b7280; }
    .pwa-rec-label { flex: 1; color: #ef4444; font-weight: 700; font-size: 0.85rem; align-self: center;
        display: inline-flex; align-items: center; }

    /* Acciones extra (Respuestas rápidas / Menú rol) */
    .pwa-acciones { display: flex; gap: 6px; padding: 0.4rem 0.7rem 0; background: #f8fafb; }
    .pwa-acc-btn { border: 1px solid #d1d5db; background: #fff; color: #374151; border-radius: 999px;
        padding: 5px 12px; font-size: 0.78rem; font-weight: 700; cursor: pointer; white-space: nowrap; }
    .pwa-acc-btn:hover:not(:disabled) { background: #f3f4f6; }
    .pwa-acc-btn.on { background: #0b7a4b; color: #fff; border-color: #0b7a4b; }
    .pwa-acc-btn:disabled { opacity: 0.6; cursor: wait; }
    .pwa-acc-mas { font-weight: 800; padding: 5px 11px; }

    /* Panel del ➕ (overlay sobre la card): Adjuntar del servidor / Contacto / Saldo */
    .pwa-mas { position: absolute; inset: 0; z-index: 6; background: #fff; display: flex; flex-direction: column; }
    .pwa-mas-head { display: flex; align-items: center; gap: 8px; background: #0b7a4b; color: #fff; padding: 8px 12px; flex: 0 0 auto; }
    .pwa-mas-title { font-weight: 800; font-size: 0.92rem; flex: 1; }
    .pwa-mas-back, .pwa-mas-x { background: rgba(255,255,255,0.18); border: none; color: #fff; border-radius: 7px;
        width: 28px; height: 26px; cursor: pointer; flex: none; }
    .pwa-mas-back:hover, .pwa-mas-x:hover { background: rgba(255,255,255,0.34); }
    .pwa-mas-body { flex: 1; min-height: 0; overflow-y: auto; padding: 8px; }
    .pwa-mas-op { display: block; width: 100%; text-align: left; border: 1px solid #e5e7eb; background: #fff;
        border-radius: 12px; padding: 14px; margin-bottom: 8px; font-size: 0.95rem; font-weight: 700; color: #111827; cursor: pointer; }
    .pwa-mas-op:hover { background: #f0fdf4; }
    .pwa-mas-tabs { display: flex; gap: 6px; overflow-x: auto; padding-bottom: 6px; }
    .pwa-mas-tab { border: 1px solid #d1d5db; background: #fff; color: #374151; border-radius: 999px;
        padding: 5px 11px; font-size: 0.76rem; font-weight: 700; cursor: pointer; white-space: nowrap; flex: none; }
    .pwa-mas-tab.on { background: #0b7a4b; color: #fff; border-color: #0b7a4b; }
    .pwa-mas-search { width: 100%; box-sizing: border-box; border: 1px solid #d1d5db; border-radius: 10px;
        padding: 10px 12px; font-size: 16px; font-family: inherit; margin: 8px 0; }
    .pwa-mas-search:focus { outline: none; border-color: #25d366; box-shadow: 0 0 0 2px rgba(37,211,102,0.18); }
    .pwa-mas-info { color: #6b7280; font-size: 0.85rem; text-align: center; padding: 1rem; }
    .pwa-mas-item { display: flex; align-items: center; gap: 10px; width: 100%; text-align: left;
        border: none; border-bottom: 1px solid #f3f4f6; background: transparent; padding: 10px 6px; cursor: pointer; }
    .pwa-mas-item:hover { background: #f0fdf4; }
    .pwa-mas-item:disabled { opacity: 0.6; cursor: wait; }
    .pwa-mas-item-ic { font-size: 1.2rem; flex: none; }
    .pwa-mas-item-txt { min-width: 0; }
    .pwa-mas-item-lbl { display: block; font-weight: 700; color: #111827; font-size: 0.86rem;
        white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
    .pwa-mas-item-sub { display: block; color: #6b7280; font-size: 0.76rem;
        white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
    .pwa-resp-panel { background: #fff; border: 1px solid #e5e7eb; border-radius: 10px; margin: 6px 0.7rem 0;
        max-height: 190px; overflow-y: auto; box-shadow: 0 4px 14px rgba(0,0,0,0.10); }
    .pwa-resp-vacio { color: #6b7280; font-size: 0.82rem; text-align: center; padding: 0.9rem; }
    .pwa-resp-item { display: block; width: 100%; text-align: left; border: none; background: transparent;
        border-bottom: 1px solid #f3f4f6; padding: 8px 12px; cursor: pointer; }
    .pwa-resp-item:hover { background: #f0fdf4; }
    .pwa-resp-nom { display: block; font-weight: 700; color: #111827; font-size: 0.82rem; }
    .pwa-resp-txt { display: block; color: #6b7280; font-size: 0.76rem;
        white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }

    .pwa-firma { display: flex; align-items: center; flex-wrap: wrap; gap: 5px;
        padding: 0.4rem 0.7rem 0; background: #f8fafb; }
    .pwa-firma-lbl { font-size: 0.72rem; font-weight: 800; color: #374151; }
    .pwa-firma-btn { border: 1px solid #d1d5db; background: #fff; color: #374151;
        border-radius: 999px; padding: 2px 9px; font-size: 0.72rem; font-weight: 700; cursor: pointer; }
    .pwa-firma-btn:hover { background: #f3f4f6; }
    .pwa-firma-btn.on { background: #16a34a; color: #fff; border-color: #15803d; }
    .pwa-firma-hint { font-size: 0.68rem; color: #6b7280; margin-left: auto; }

    .pwa-composer { display: flex; align-items: flex-end; gap: 8px; padding: 0.55rem 0.7rem;
        border-top: 1px solid #eef0f2; background: #f8fafb; }
    .pwa-input { flex: 1; resize: none; border: 1px solid #d1d5db; border-radius: 12px;
        padding: 0.55rem 0.75rem; font-size: 0.88rem; font-family: inherit; max-height: 110px; line-height: 1.3; }
    .pwa-input:focus { outline: none; border-color: #25d366; box-shadow: 0 0 0 2px rgba(37,211,102,0.18); }
    .pwa-send { border: none; border-radius: 12px; padding: 0.55rem 1.1rem; font-weight: 700;
        color: #fff; background: #25d366; cursor: pointer; white-space: nowrap; }
    .pwa-send:hover:not(:disabled) { filter: brightness(1.05); }
    .pwa-send:disabled { background: #cbd5d3; cursor: not-allowed; }

    /* 2026-08-06: en celu, todo más grande y cómodo. font-size 16px en el input evita que
       iOS haga zoom al tocar para escribir. Burbujas y audio un toque más grandes. */
    @@media (max-width: 640px) {
        .pwa-body { padding: 0.8rem 0.7rem; gap: 0.5rem; }
        .pwa-bubble { max-width: 85%; font-size: 0.95rem; padding: 0.5rem 0.7rem; }
        .pwa-input { font-size: 16px; padding: 0.7rem 0.9rem; }
        .pwa-send, .pwa-mic { padding: 0.7rem 1.05rem; font-size: 1.05rem; }
        .pwa-audio { height: 44px; }
        .pwa-firma-btn { padding: 4px 11px; font-size: 0.8rem; }
    }
</style>

@code {
    /// <summary>Número del contacto tal cual está guardado, ej. "whatsapp:+5491158464160".</summary>
    [Parameter, EditorRequired] public string Numero { get; set; } = "";
    /// <summary>PhoneId de la línea nuestra (ej. FIJO TRANSRADIO). Null = línea sin registrar.</summary>
    [Parameter] public string? LineaPhoneId { get; set; }
    [Parameter] public string TituloContacto { get; set; } = "Conversación";
    [Parameter] public string NombreLinea { get; set; } = "";
    /// <summary>Muestra el botón "Abrir ⤢" (para usuarios que sí pueden ver la pantalla completa de WhatsApp).</summary>
    [Parameter] public bool PuedeAbrirEnGrande { get; set; } = true;
    /// <summary>2026-08-07: muestra las acciones extra (Respuestas rápidas + Menú rol). Solo en móvil / card
    /// flotante; en el chat de venta/depósito/dashboard queda apagado para no recargar.</summary>
    [Parameter] public bool AccionesCompletas { get; set; } = false;

    private List<ApiClient.TwMsgDto>? mensajes;
    private string composer = "";
    private bool sending;
    private System.Threading.Timer? refreshTimer;

    // 2026-08-06: firma del Depósito (responde firmando quién lo hace). Nombres FIJOS por ahora.
    private bool esDeposito;
    private string? firmante;
    private static readonly string[] FirmantesDeposito = { "alex", "nacho", "benja", "rodri", "gon", "ger" };
    private static string Capitalizar(string s) => string.IsNullOrEmpty(s) ? s : char.ToUpperInvariant(s[0]) + s.Substring(1);

    protected override async Task OnInitializedAsync()
    {
        // ¿Es usuario Depósito? (mismo criterio que el resto del sistema: deposito y NO cafe/oficina)
        try
        {
            var user = await AuthSvc.GetUserAsync();
            var perms = user?.Permissions ?? new();
            esDeposito = perms.Contains("deposito") && !perms.Contains("cafe") && !perms.Contains("oficina");
        }
        catch { esDeposito = false; }
        await Cargar();
        // Refresco liviano cada 12s para ver mensajes nuevos sin recargar la página.
        refreshTimer = new System.Threading.Timer(async _ =>
        {
            await InvokeAsync(async () =>
            {
                if (!sending) { await Cargar(); StateHasChanged(); }
            });
        }, null, 12_000, 12_000);
    }

    private async Task Cargar()
    {
        try
        {
            // El endpoint espera el sentinela "null" (string) para la línea sin registrar.
            var linea = LineaPhoneId ?? "null";
            var lista = await Api.GetTwMensajesAsync(Numero, linea);
            // Respaldo: si por esta línea todavía no hay nada (típico en DESARROLLO, donde el
            // historial real vive en PRODUCCIÓN), mostramos el hilo del contacto sin filtrar por
            // línea para no dejar la card vacía. En PROD no se usa (la línea tiene historial).
            if (lista.Count == 0)
                lista = await Api.GetTwMensajesAsync(Numero, null);
            mensajes = lista;
        }
        catch { mensajes ??= new(); }
    }

    private async Task OnKey(Microsoft.AspNetCore.Components.Web.KeyboardEventArgs e)
    {
        // Enter envía; Shift+Enter hace renglón nuevo (como WhatsApp).
        if (e.Key == "Enter" && !e.ShiftKey) await Enviar();
    }

    private async Task Enviar()
    {
        var texto = (composer ?? "").Trim();
        if (sending || string.IsNullOrWhiteSpace(texto)) return;
        // Depósito: exige elegir firmante y lo agrega al final -> "OK (alex)".
        if (esDeposito)
        {
            if (string.IsNullOrWhiteSpace(firmante))
            {
                Toast.Warning("Elegí quién responde (arriba del cuadro de escribir).");
                return;
            }
            texto = $"{texto} ({firmante})";
        }
        sending = true;
        var (ok, err) = await Api.SendTwMensajeAsync(Numero, texto, LineaPhoneId);
        sending = false;
        if (ok)
        {
            composer = "";
            await Cargar();
        }
        else
        {
            Toast.Error(err ?? "No se pudo enviar el mensaje");
        }
    }

    // === 2026-08-06: nota de voz (grabar con micrófono y enviar como audio) — reusa el mismo
    // grabador (window.waAudio) y endpoint (SendTwMediaAsync) que la pantalla grande de WhatsApp. ===
    private bool grabandoAudio, enviandoAudio;
    private class WaUploadRes { public string? Url { get; set; } public string? OriginalFilename { get; set; } }

    private async Task ToggleGrabarAudio()
    {
        if (!grabandoAudio)
        {
            bool ok;
            try { ok = await JS.InvokeAsync<bool>("waAudio.start"); }
            catch { ok = false; }
            if (!ok) { Toast.Error("No pude acceder al micrófono. Revisá los permisos del navegador (y que estés en HTTPS)."); return; }
            grabandoAudio = true;
        }
        else
        {
            grabandoAudio = false;
            enviandoAudio = true;
            StateHasChanged();
            WaUploadRes? res = null;
            try { res = await JS.InvokeAsync<WaUploadRes?>("waAudio.stopAndUpload"); }
            catch { }
            if (res == null || string.IsNullOrEmpty(res.Url))
            {
                enviandoAudio = false;
                Toast.Error("No se pudo grabar o subir el audio");
                StateHasChanged();
                return;
            }
            var (ok, err) = await Api.SendTwMediaAsync(Numero, res.Url, null, res.OriginalFilename, LineaPhoneId);
            enviandoAudio = false;
            if (!ok) Toast.Error(err ?? "No se pudo enviar la nota de voz");
            else await Cargar();
            StateHasChanged();
        }
    }

    private async Task CancelarAudio()
    {
        grabandoAudio = false;
        try { await JS.InvokeVoidAsync("waAudio.cancel"); } catch { }
    }

    // === 2026-08-07: Respuestas rápidas + Menú rol (solo con AccionesCompletas) ===
    private List<ApiClient.TwRespRapidaDto>? respuestas;
    private bool showResp;
    private bool enviandoMenuRol;

    private async Task ToggleResp()
    {
        showResp = !showResp;
        if (showResp && respuestas is null)
        {
            try { respuestas = await Api.GetTwRespuestasAsync(); }
            catch { respuestas = new(); }
        }
        StateHasChanged();
    }

    private void UsarRespuesta(ApiClient.TwRespRapidaDto r)
    {
        composer = string.IsNullOrWhiteSpace(composer) ? r.Texto : (composer.TrimEnd() + " " + r.Texto);
        showResp = false;
        StateHasChanged();
    }

    private async Task EnviarMenuRolMini()
    {
        if (enviandoMenuRol) return;
        enviandoMenuRol = true;
        StateHasChanged();
        var (ok, err) = await Api.SendTwMenuRolAsync(Numero, LineaPhoneId);
        enviandoMenuRol = false;
        if (ok) { Toast.Info("Menú enviado"); await Cargar(); }
        else Toast.Error(err ?? "No se pudo enviar el menú");
        StateHasChanged();
    }

    private static string Recortar2(string? s, int max)
    {
        if (string.IsNullOrWhiteSpace(s)) return "";
        s = s.Replace("\n", " ").Trim();
        return s.Length <= max ? s : s.Substring(0, max) + "…";
    }

    // === 2026-08-07 (Fase 2): ➕ Adjuntar del servidor / Contacto / Saldo ===
    private bool mostrarMas;
    private string masVista = "menu";
    private void AbrirMas() { mostrarMas = true; masVista = "menu"; StateHasChanged(); }
    private void CerrarMas() { mostrarMas = false; StateHasChanged(); }
    private void VolverMenuMas() { masVista = "menu"; StateHasChanged(); }
    private string TituloMas() => masVista switch
    {
        "servidor" => "🗂️ Adjuntar del servidor",
        "contacto" => "👤 Compartir contacto",
        "saldo" => "💰 Mandar saldo",
        _ => "➕ Más"
    };

    // -- Adjuntar del servidor --
    private static readonly (string Key, string Label)[] SrvTabs = new[]
    {
        ("CATALOGO", "📚 Catálogos"), ("LISTA", "💲 Listas"), ("VENTA", "🧾 Facturas"),
        ("COBRANZA", "💰 Recibos"), ("ALQUILER", "🎪 Alquileres"), ("VISITA", "📋 Visitas"), ("UPLOAD", "📁 Subidos")
    };
    private string srvTab = "CATALOGO";
    private string srvSearch = "";
    private List<ApiClient.TwServerFileDto> srvItems = new();
    private bool srvLoading, srvEnviando;

    private async Task AbrirServidor() { masVista = "servidor"; srvTab = "CATALOGO"; srvSearch = ""; await CargarSrv(); }
    private async Task CambiarTab(string t) { srvTab = t; srvSearch = ""; await CargarSrv(); }
    private async Task OnSrvSearch(ChangeEventArgs e) { srvSearch = e.Value?.ToString() ?? ""; await CargarSrv(); }
    private async Task CargarSrv()
    {
        srvLoading = true; StateHasChanged();
        try { srvItems = await Api.GetTwServerFilesAsync(srvTab, string.IsNullOrWhiteSpace(srvSearch) ? null : srvSearch); }
        catch { srvItems = new(); }
        srvLoading = false; StateHasChanged();
    }
    private async Task EnviarServidor(ApiClient.TwServerFileDto f)
    {
        if (srvEnviando) return;
        srvEnviando = true; StateHasChanged();
        var (ok, err) = await Api.SendTwServerFileAsync(Numero, f.Tipo, f.Id, null, LineaPhoneId);
        srvEnviando = false;
        if (ok) { Toast.Info("Enviado"); mostrarMas = false; await Cargar(); }
        else Toast.Error(err ?? "No se pudo enviar");
        StateHasChanged();
    }

    // -- Compartir contacto --
    private string contQuery = "";
    private List<ApiClient.TwDestinatarioDto> contResult = new();
    private bool contBuscando, contEnviando;
    private void AbrirContacto() { masVista = "contacto"; contQuery = ""; contResult = new(); StateHasChanged(); }
    private async Task BuscarContacto(ChangeEventArgs e)
    {
        contQuery = e.Value?.ToString() ?? "";
        if (contQuery.Trim().Length < 2) { contResult = new(); StateHasChanged(); return; }
        contBuscando = true; StateHasChanged();
        try { contResult = await Api.BuscarTwDestinatariosAsync(contQuery.Trim()); }
        catch { contResult = new(); }
        contBuscando = false; StateHasChanged();
    }
    private async Task EnviarContacto(ApiClient.TwDestinatarioDto c)
    {
        if (contEnviando) return;
        contEnviando = true; StateHasChanged();
        var (ok, err) = await Api.EnviarTwContactoAsync(Numero, c.Nombre, c.Numero, LineaPhoneId);
        contEnviando = false;
        if (ok) { Toast.Info("Contacto enviado"); mostrarMas = false; await Cargar(); }
        else Toast.Error(err ?? "No se pudo enviar el contacto");
        StateHasChanged();
    }

    // -- Mandar saldo (inserta el texto en el cuadro; se revisa y se manda) --
    private string salQuery = "";
    private List<ApiClient.TwClienteBuscarDto> salResult = new();
    private bool salBuscando, salCargando;
    private void AbrirSaldo() { masVista = "saldo"; salQuery = ""; salResult = new(); StateHasChanged(); }
    private async Task BuscarSaldo(ChangeEventArgs e)
    {
        salQuery = e.Value?.ToString() ?? "";
        if (salQuery.Trim().Length < 2) { salResult = new(); StateHasChanged(); return; }
        salBuscando = true; StateHasChanged();
        try { salResult = await Api.BuscarTwClientesAsync(salQuery.Trim()); }
        catch { salResult = new(); }
        salBuscando = false; StateHasChanged();
    }
    private async Task PonerSaldoTexto(int clienteId)
    {
        salCargando = true; StateHasChanged();
        try
        {
            var s = await Api.GetClienteSaldoAsync(clienteId);
            if (s is null) { Toast.Error("No se pudo traer el saldo"); return; }
            var ar = System.Globalization.CultureInfo.GetCultureInfo("es-AR");
            var linea = $"{s.ClienteNombre} - ${s.Saldo.ToString("N0", ar)}";
            composer = string.IsNullOrWhiteSpace(composer) ? linea : composer.TrimEnd() + "\n" + linea;
            mostrarMas = false;
        }
        finally { salCargando = false; StateHasChanged(); }
    }

    // === 2026-08-06: adjuntar foto/archivo (sube y manda, reusa el camino del WhatsApp grande) ===
    private bool subiendo;
    private const long MaxUploadBytes = 16L * 1024 * 1024;
    private async Task OnAdjuntar(InputFileChangeEventArgs e)
    {
        var file = e.File;
        if (file == null) return;
        if (file.Size > MaxUploadBytes) { Toast.Error($"El archivo {file.Name} supera los 16 MB"); return; }
        subiendo = true;
        StateHasChanged();
        try
        {
            using var stream = file.OpenReadStream(MaxUploadBytes);
            var (up, err) = await Api.UploadTwArchivoAsync(stream, file.Name, file.ContentType);
            if (up == null) { Toast.Error(err ?? "No se pudo subir el archivo"); return; }
            var (ok, serr) = await Api.SendTwMediaAsync(Numero, up.Url, null, up.OriginalFilename, LineaPhoneId);
            if (!ok) Toast.Error(serr ?? "No se pudo enviar el archivo");
            else await Cargar();
        }
        catch (Exception ex) { Toast.Error("No se pudo enviar el archivo: " + ex.Message); }
        finally { subiendo = false; StateHasChanged(); }
    }

    private static bool EsAudio(string? url)
    {
        if (string.IsNullOrEmpty(url)) return false;
        var l = url.ToLowerInvariant();
        return l.EndsWith(".ogg") || l.EndsWith(".opus") || l.EndsWith(".mp3") || l.EndsWith(".m4a")
            || l.EndsWith(".amr") || l.EndsWith(".wav") || l.EndsWith(".webm");
    }

    private static bool EsImagen(string? url)
    {
        if (string.IsNullOrEmpty(url)) return false;
        var l = url.ToLowerInvariant();
        return l.EndsWith(".jpg") || l.EndsWith(".jpeg") || l.EndsWith(".png") || l.EndsWith(".gif") || l.EndsWith(".webp");
    }

    private async Task AbrirEnGrande()
    {
        // solo=1 → abre SOLO esta conversación (sin la lista de todos los chats).
        var url = $"/whatsapp?numero={Uri.EscapeDataString(Numero)}&solo=1"
                + (string.IsNullOrEmpty(LineaPhoneId) ? "" : $"&linea={Uri.EscapeDataString(LineaPhoneId)}");
        try { await JS.InvokeVoidAsync("open", url, "_blank"); }
        catch { }
    }

    private string InicialContacto()
        => string.IsNullOrWhiteSpace(TituloContacto) ? "?" : TituloContacto.Trim()[..1].ToUpperInvariant();

    private static string FormatHora(DateTime utc)
    {
        var local = utc.ToArTime();
        var ahora = DateTime.UtcNow.ToArTime();
        if (local.Date == ahora.Date) return local.ToString("HH:mm");
        if (local.Date == ahora.Date.AddDays(-1)) return "Ayer " + local.ToString("HH:mm");
        return local.ToString("dd/MM HH:mm");
    }

    public void Dispose() => refreshTimer?.Dispose();
}
