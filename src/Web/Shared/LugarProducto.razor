@* 2026-09-24: dónde está el producto en el depósito, en chiquito y gris: "📍 PB · TOST".
   Color solo si es alarma: alguien avisó que "no estaba acá" → la parte del aviso en ámbar.
   Editable=true (páginas con login): si no tiene lugar sale "📍 agregar lugar" con un mini editor
   (botones PB / P1 / Otro depósito + zona opcional, SIN desplegables); si tiene lugar sale
   "no está acá" para avisar que fueron a buscarlo y no estaba.
   Después de guardar muestra el cambio al toque y avisa al padre (OnCambio) por si quiere recargar. *@
@inject ApiClient Api
@inject ToastService ToastService
@inject IJSRuntime JS

@{
    var lugar = overrideLugar.HasValue ? overrideLugar.Value.Lugar : Lugar;
    var dudoso = overrideLugar.HasValue ? overrideLugar.Value.Dudoso : Dudoso;
    var puedeEditar = Editable && ProductoId is not null;
}
@if (!string.IsNullOrEmpty(lugar))
{
    <span style="font-size:@Tamano; color:#64748b;">📍 @lugar
        @if (dudoso)
        {
            <span style="color:#b45309; font-weight:600;">· ⚠ no estaba acá</span>
        }
    </span>
    @if (puedeEditar && !dudoso && OfrecerNoEsta)
    {
        <button type="button" @onclick="NoEsta" @onclick:stopPropagation="true" disabled="@guardando"
                title="Fuiste a buscarlo y no estaba: queda marcado para revisar"
                style="background:none; border:none; padding:0 0 0 0.4rem; color:#94a3b8; font-size:0.72rem; text-decoration:underline; cursor:pointer;">no está acá</button>
    }
}
else if (puedeEditar)
{
    @if (!abierto)
    {
        <button type="button" @onclick="() => abierto = true" @onclick:stopPropagation="true"
                title="Anotar en qué parte del depósito está"
                style="background:none; border:none; padding:0; color:#94a3b8; font-size:0.74rem; text-decoration:underline; cursor:pointer;">📍 agregar lugar</button>
    }
    else
    {
        <span style="display:inline-flex; align-items:center; gap:0.3rem; flex-wrap:wrap; font-size:0.78rem;" @onclick:stopPropagation="true">
            @foreach (var (cod, txt) in Plantas)
            {
                <button type="button" @onclick="() => planta = cod"
                        style="border:1px solid @(planta == cod ? "#1e293b" : "#cbd5e1"); background:@(planta == cod ? "#1e293b" : "white"); color:@(planta == cod ? "white" : "#334155"); border-radius:999px; padding:0.1rem 0.55rem; cursor:pointer; font-size:0.78rem;">@txt</button>
            }
            <input @bind="zona" @bind:event="oninput" placeholder="Zona (opcional, ej. TOST)" maxlength="30"
                   style="width:11.5rem; padding:0.12rem 0.4rem; border:1px solid #cbd5e1; border-radius:6px; font-size:0.78rem;" />
            <button type="button" @onclick="Guardar" disabled="@(planta is null || guardando)"
                    style="border:1px solid #1e293b; background:#1e293b; color:white; border-radius:6px; padding:0.1rem 0.6rem; cursor:pointer; font-size:0.78rem; opacity:@(planta is null ? "0.4" : "1");">@(guardando ? "Guardando…" : "Guardar")</button>
            <button type="button" @onclick="Cerrar"
                    style="background:none; border:none; color:#94a3b8; cursor:pointer; font-size:0.78rem; text-decoration:underline;">cancelar</button>
        </span>
    }
}

@code {
    [Parameter] public int? ProductoId { get; set; }
    [Parameter] public string? Lugar { get; set; }
    [Parameter] public bool Dudoso { get; set; }
    /// <summary>true = se puede agregar lugar / avisar "no está acá" (solo en páginas con login).</summary>
    [Parameter] public bool Editable { get; set; }
    [Parameter] public string Tamano { get; set; } = "0.78rem";
    [Parameter] public EventCallback OnCambio { get; set; }
    /// <summary>false = no muestra "no está acá" (ej. el listado de Productos de la oficina, donde nadie fue a buscarlo).</summary>
    [Parameter] public bool OfrecerNoEsta { get; set; } = true;

    private static readonly (string, string)[] Plantas = { ("PB", "PB"), ("P1", "P1"), ("OTRO", "Otro depósito") };

    private bool abierto;
    private bool guardando;
    private string? planta;
    private string zona = "";
    private (string? Lugar, bool Dudoso)? overrideLugar;
    private (int?, string?, bool) ultimosParametros;

    protected override void OnParametersSet()
    {
        // Si el padre trae datos nuevos (recargó), mandan esos.
        var p = (ProductoId, Lugar, Dudoso);
        if (p != ultimosParametros) { overrideLugar = null; ultimosParametros = p; }
    }

    private void Cerrar() { abierto = false; planta = null; zona = ""; }

    private async Task Guardar()
    {
        if (ProductoId is null || planta is null) return;
        guardando = true;
        try
        {
            var z = string.IsNullOrWhiteSpace(zona) ? null : zona.Trim().ToUpperInvariant();
            var r = await Api.AsignarUbicacionAsync(new List<int> { ProductoId.Value }, planta, z, null);
            var texto = !string.IsNullOrEmpty(r?.Lugar) ? r!.Lugar : (z is null ? planta : $"{planta} · {z}");
            overrideLugar = (texto, false);
            Cerrar();
            await OnCambio.InvokeAsync();
        }
        catch (Exception ex) { ToastService.Error("No pude guardar el lugar: " + ex.Message); }
        finally { guardando = false; }
    }

    private async Task NoEsta()
    {
        if (ProductoId is null) return;
        bool ok;
        try { ok = await JS.InvokeAsync<bool>("confirm", "¿Fuiste a buscarlo y no estaba ahí? Queda marcado para revisar el lugar."); }
        catch { ok = false; }
        if (!ok) return;
        guardando = true;
        try
        {
            await Api.MarcarUbicacionNoEstaAsync(ProductoId.Value);
            overrideLugar = (overrideLugar.HasValue ? overrideLugar.Value.Lugar : Lugar, true);
            ToastService.Success("Listo, queda marcado para revisar");
            await OnCambio.InvokeAsync();
        }
        catch (Exception ex) { ToastService.Error("No pude marcarlo: " + ex.Message); }
        finally { guardando = false; }
    }
}
