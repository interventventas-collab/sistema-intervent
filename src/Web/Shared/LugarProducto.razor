@* 2026-09-24: dónde está el producto en el depósito, en chiquito y gris: "📍 PB · TOST".
   Color solo si es alarma: alguien avisó que "no estaba acá" → la parte del aviso en ámbar.
   Editable=true (páginas con login): si no tiene lugar sale "📍 agregar lugar" con un mini editor
   (botones PB / P1 / Otro depósito + zona opcional, SIN desplegables); si tiene lugar sale
   "no está acá" para avisar que fueron a buscarlo y no estaba.
   Después de guardar muestra el cambio al toque y avisa al padre (OnCambio) por si quiere recargar.
   2026-11-26: ConEstante=true suma el chip "📦 Estante" (rack · posición · nivel del plano del
   depósito, con ElegirEstante) y "🗺 Ver en el plano" cuando el lugar es un estante (ej. PB · H-1-2).
   Al tocar la ubicación de un estante se abre el planito emergente (PlanoEmergente). *@
@inject ApiClient Api
@inject ToastService ToastService
@inject IJSRuntime JS

@{
    var lugar = overrideLugar.HasValue ? overrideLugar.Value.Lugar : Lugar;
    var dudoso = overrideLugar.HasValue ? overrideLugar.Value.Dudoso : Dudoso;
    var puedeEditar = Editable && ProductoId is not null;
}
@if (abierto && puedeEditar)
{
    <span style="display:inline-flex; align-items:center; gap:0.3rem; flex-wrap:wrap; font-size:0.78rem;" @onclick:stopPropagation="true">
        @foreach (var (cod, txt) in Plantas)
        {
            <button type="button" @onclick="() => { planta = cod; enEstante = false; }"
                    style="border:1px solid @(!enEstante && planta == cod ? "#1e293b" : "#cbd5e1"); background:@(!enEstante && planta == cod ? "#1e293b" : "white"); color:@(!enEstante && planta == cod ? "white" : "#334155"); border-radius:999px; padding:0.1rem 0.55rem; cursor:pointer; font-size:0.78rem;">@txt</button>
        }
        @if (ConEstante)
        {
            <button type="button" @onclick="() => enEstante = true" title="Elegir rack, posición y nivel del plano del depósito"
                    style="border:1px solid @(enEstante ? "#1e293b" : "#cbd5e1"); background:@(enEstante ? "#1e293b" : "white"); color:@(enEstante ? "white" : "#334155"); border-radius:999px; padding:0.1rem 0.55rem; cursor:pointer; font-size:0.78rem;">📦 Estante</button>
        }
        @if (!enEstante)
        {
            <input @bind="zona" @bind:event="oninput" placeholder="Zona (opcional, ej. TOST)" maxlength="30"
                   style="width:11.5rem; padding:0.12rem 0.4rem; border:1px solid #cbd5e1; border-radius:6px; font-size:0.78rem;" />
            <button type="button" @onclick="Guardar" disabled="@(planta is null || guardando)"
                    style="border:1px solid #1e293b; background:#1e293b; color:white; border-radius:6px; padding:0.1rem 0.6rem; cursor:pointer; font-size:0.78rem; opacity:@(planta is null ? "0.4" : "1");">@(guardando ? "Guardando…" : "Guardar")</button>
        }
        <button type="button" @onclick="Cerrar"
                style="background:none; border:none; color:#94a3b8; cursor:pointer; font-size:0.78rem; text-decoration:underline;">cancelar</button>
        @if (enEstante)
        {
            <span style="flex-basis:100%;">
                <Web.Pages.Deposito.ElegirEstante ProductoId="ProductoId!.Value" Planta="@planta" OnGuardado="GuardadoEnEstante" />
            </span>
        }
    </span>
}
else if (!string.IsNullOrEmpty(lugar))
{
    var estLugar = ConEstante ? EstanteDe(lugar) : null;
    @if (estLugar is not null)
    {
        @* 2026-11-26: si está en un estante del plano, al tocar la ubicación se abre el planito emergente *@
        @* 2026-11-27: un solo botón-pastilla "📍 PB · D2-1-3  🗺 Ver" (antes texto + link subrayado) *@
        @* 2026-11-27: al pasar el cursor, el código escrito: "Calle 3 · Rack 4 · Altura 3" *@
        <button type="button" class="lp-plano" @onclick="() => AbrirPlano(estLugar)" @onclick:stopPropagation="true" title="@(ApiClient.DesgloseEstante(estLugar) is string dsg ? dsg + " — tocá para verlo en el plano" : "Ver en el plano dónde está")"
                style="font-size:@Tamano;">
            <span class="lp-plano-lugar">📍 @lugar@Sufijo</span>
            <span class="lp-plano-ver">@TextoVer</span>
        </button>
        @if (dudoso)
        {
            <span style="font-size:@Tamano; color:#b45309; font-weight:600;">· ⚠ no estaba acá</span>
        }
    }
    else
    {
        <span style="font-size:@Tamano; color:#64748b;" title="@(ApiClient.DesgloseEstante(EstanteDe(lugar) ?? (lugar.Contains(" · ") ? lugar.Split(" · ", 2)[1] : lugar)))">📍 @lugar@Sufijo
            @if (dudoso)
            {
                <span style="color:#b45309; font-weight:600;">· ⚠ no estaba acá</span>
            }
        </span>
    }
    @if (puedeEditar && PermitirCambiar)
    {
        <button type="button" @onclick="() => Abrir(lugar)" @onclick:stopPropagation="true"
                title="Cambiar en qué parte del depósito está"
                style="background:none; border:none; padding:0 0 0 0.4rem; color:#94a3b8; font-size:0.72rem; text-decoration:underline; cursor:pointer;">cambiar</button>
    }
    @if (puedeEditar && !dudoso && OfrecerNoEsta)
    {
        <button type="button" @onclick="NoEsta" @onclick:stopPropagation="true" disabled="@guardando"
                title="Fuiste a buscarlo y no estaba: queda marcado para revisar"
                style="background:none; border:none; padding:0 0 0 0.4rem; color:#94a3b8; font-size:0.72rem; text-decoration:underline; cursor:pointer;">no está acá</button>
    }
}
else if (puedeEditar)
{
    <button type="button" @onclick="() => Abrir(null)" @onclick:stopPropagation="true"
            title="Anotar en qué parte del depósito está"
            style="background:none; border:none; padding:0; color:#94a3b8; font-size:0.74rem; text-decoration:underline; cursor:pointer;">📍 agregar lugar</button>
}

@if (planoAbierto is not null)
{
    @* solo si el layout no tiene el lugar fijo del planito (PlanoEmergenteHost) *@
    <Web.Pages.Deposito.PlanoEmergente Codigo="@planoAbierto" OnCerrar="() => planoAbierto = null" />
}

@code {
    [Parameter] public int? ProductoId { get; set; }
    [Parameter] public string? Lugar { get; set; }
    [Parameter] public bool Dudoso { get; set; }
    /// <summary>true = se puede agregar lugar / avisar "no está acá" (solo en páginas con login).</summary>
    [Parameter] public bool Editable { get; set; }
    [Parameter] public string Tamano { get; set; } = "0.78rem";
    [Parameter] public EventCallback OnCambio { get; set; }
    /// <summary>false = no muestra "no está acá" (ej. el listado de Productos de la oficina, donde nadie fue a buscarlo).</summary>
    [Parameter] public bool OfrecerNoEsta { get; set; } = true;
    /// <summary>true = si ya tiene lugar, ofrece "cambiar" (abre el mismo editor con lo actual cargado).</summary>
    [Parameter] public bool PermitirCambiar { get; set; }
    /// <summary>2026-11-26: true = suma "📦 Estante" al editor y "🗺 Ver en el plano" si el lugar es un estante.</summary>
    [Parameter] public bool ConEstante { get; set; }

    /// <summary>2026-11-26: texto chico después del lugar (ej. " (D401)" en un pack: el lugar es el del producto suelto).</summary>
    [Parameter] public string? Sufijo { get; set; }

    private string? planoAbierto;

    [Inject] private PlanoEmergenteService PlanoSvc { get; set; } = default!;

    /// <summary>Abre el planito arriba de toda la página (en el layout); si no hay lugar fijo, acá mismo.</summary>
    /// <summary>2026-11-27: si viene, "Ver en el plano" llama a esto en vez de abrir el planito
    /// (ej. el armado de pedidos abre el plano 3D con todo el pedido).</summary>
    [Parameter] public EventCallback<string> OnVerPlano { get; set; }

    /// <summary>Texto del botón de la pastilla (en lugares angostos, más corto: "🗺 3D").</summary>
    [Parameter] public string TextoVer { get; set; } = "🗺 Ver en el plano";

    private async Task AbrirPlano(string codigo)
    {
        if (OnVerPlano.HasDelegate) { await OnVerPlano.InvokeAsync(codigo); return; }
        if (PlanoSvc.HayHost) PlanoSvc.Abrir(codigo);
        else planoAbierto = codigo;
    }

    private static readonly (string, string)[] Plantas = { ("PB", "PB"), ("P1", "P1"), ("OTRO", "Otro depósito") };

    private bool abierto;
    private bool enEstante;
    private bool guardando;
    private string? planta;
    private string zona = "";
    private (string? Lugar, bool Dudoso)? overrideLugar;
    private (int?, string?, bool) ultimosParametros;

    protected override void OnParametersSet()
    {
        // Si el padre trae datos nuevos (recargó), mandan esos.
        var p = (ProductoId, Lugar, Dudoso);
        if (p != ultimosParametros) { overrideLugar = null; ultimosParametros = p; }
    }

    private void Cerrar() { abierto = false; planta = null; zona = ""; enEstante = false; }

    /// <summary>"PB · H-1-2" → "H-1-2" si la zona es un estante del plano; si no, null.</summary>
    private static string? EstanteDe(string? lugar)
    {
        if (string.IsNullOrEmpty(lugar)) return null;
        var partes = lugar.Split(" · ", 2);
        return partes.Length > 1 && ApiClient.EsCodigoEstante(partes[1]) ? partes[1].Trim() : null;
    }

    private async Task GuardadoEnEstante((string Codigo, string Planta) r)
    {
        overrideLugar = ($"{r.Planta} · {r.Codigo}", false);
        Cerrar();
        await OnCambio.InvokeAsync();
    }

    /// <summary>Abre el editor; si ya tiene lugar ("PB · TOST") arranca con esa planta y zona.</summary>
    private void Abrir(string? actual)
    {
        planta = null; zona = "";
        if (!string.IsNullOrEmpty(actual))
        {
            var partes = actual.Split(" · ", 2);
            planta = partes[0];
            zona = partes.Length > 1 ? partes[1] : "";
        }
        abierto = true;
    }

    private async Task Guardar()
    {
        if (ProductoId is null || planta is null) return;
        guardando = true;
        try
        {
            var z = string.IsNullOrWhiteSpace(zona) ? null : zona.Trim().ToUpperInvariant();
            var r = await Api.AsignarUbicacionAsync(new List<int> { ProductoId.Value }, planta, z, null);
            var texto = !string.IsNullOrEmpty(r?.Lugar) ? r!.Lugar : (z is null ? planta : $"{planta} · {z}");
            overrideLugar = (texto, false);
            Cerrar();
            await OnCambio.InvokeAsync();
        }
        catch (Exception ex) { ToastService.Error("No pude guardar el lugar: " + ex.Message); }
        finally { guardando = false; }
    }

    private async Task NoEsta()
    {
        if (ProductoId is null) return;
        bool ok;
        try { ok = await JS.InvokeAsync<bool>("confirm", "¿Fuiste a buscarlo y no estaba ahí? Queda marcado para revisar el lugar."); }
        catch { ok = false; }
        if (!ok) return;
        guardando = true;
        try
        {
            await Api.MarcarUbicacionNoEstaAsync(ProductoId.Value);
            overrideLugar = (overrideLugar.HasValue ? overrideLugar.Value.Lugar : Lugar, true);
            ToastService.Success("Listo, queda marcado para revisar");
            await OnCambio.InvokeAsync();
        }
        catch (Exception ex) { ToastService.Error("No pude marcarlo: " + ex.Message); }
        finally { guardando = false; }
    }
}
