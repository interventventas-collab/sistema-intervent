@inject ApiClient Api
@inject IJSRuntime JS
@inject OperatorService Operador
@inject AuthenticationStateProvider AuthState
@implements IAsyncDisposable

@*
   2026-11-26: telefono dentro del sistema (interno 103 de la central, ver telefonia/).
   - Boton redondo 📞 en la barra de arriba, con puntito verde = conectado.
   - Al tocarlo: ventanita con los internos (Oficina 101, Notebook 102) y un teclado.
   - Llamada entrante: cartel con Atender / Cortar, suena con el parlante de la compu.
   - Hablando: cartel chico abajo a la derecha con el tiempo, Silenciar y Cortar.
   2026-11-26 (2a vuelta): un interno por persona (lo decide la API segun el usuario y el PIN):
   Osmar 201, German 202, Gabriel 203, Deposito 210 (+ 211-215 "busca a ALEXIS..." en las
   compus del deposito). La lista muestra un puntito verde en quien esta conectado ahora.
   Si cambia el PIN, el telefono se reconecta con el interno de la persona nueva.
*@

@if (config is { Habilitado: true })
{
    <button class="topbar-bell tel-btn" @onclick="Alternar"
            title="@(estado == "conectado" ? "Teléfono · conectado, te pueden llamar" : estado == "conectando" ? "Teléfono · conectando…" : "Teléfono · desconectado")">
        <i class="fa-solid fa-phone"></i>
        <span class="tel-dot @(estado == "conectado" ? "on" : estado == "conectando" ? "wait" : "off")"></span>
        @if (perdidas.Count > 0)
        {
            <span class="tel-badge" title="Llamadas perdidas">@perdidas.Count</span>
        }
    </button>

    @if (abierto && modo == Modo.Libre)
    {
        <div class="tel-win">
            <div class="tel-wh">
                <b>Teléfono</b>
                <span>@config.MiNombre · @config.Usuario · @(estado == "conectado" ? "conectado" : estado == "conectando" ? "conectando…" : "desconectado")</span>
                <button class="tel-x" @onclick="Cerrar" title="Cerrar">✕</button>
            </div>
            @if (perdidasVistas.Count > 0)
            {
                <div class="tel-perd">
                    <div class="tel-grupo tel-grupo-perd">Llamadas perdidas</div>
                    @foreach (var p in perdidasVistas)
                    {
                        <div class="tel-row">
                            <b>@p.Nombre@(string.IsNullOrEmpty(p.Busca) ? "" : $" buscaba a {p.Busca}")</b>
                            <i>@(p.FechaAr.Date == DateTime.UtcNow.AddHours(-3).Date ? p.FechaAr.ToString("HH:mm") : p.FechaAr.ToString("dd/MM HH:mm"))</i>
                            @if (config.Internos.Any(x => x.Numero == p.De))
                            {
                                <button class="tel-call" disabled="@(estado != "conectado")" @onclick="() => Llamar(p.De)"><i class="fa-solid fa-phone"></i> Devolver</button>
                            }
                        </div>
                    }
                </div>
            }
            <div class="tel-lista">
                @foreach (var grupo in config.Internos.Where(x => x.Numero != config.Usuario && !(x.Numero == "200" && EsDeLaOficina)).GroupBy(x => x.Grupo))
                {
                    <div class="tel-grupo">@grupo.Key</div>
                    @foreach (var i in grupo)
                    {
                        var on = conectados.Contains(i.Numero);
                        <div class="tel-row @(on ? "" : "tel-off")">
                            <span class="tel-pres @(on ? "on" : "")" title="@(on ? "Conectado" : "No conectado")"></span>
                            <b>@i.Nombre</b><i>@i.Numero</i>
                            <button class="tel-call" disabled="@(estado != "conectado" || !on)" @onclick="() => Llamar(i.Numero)"><i class="fa-solid fa-phone"></i> Llamar</button>
                        </div>
                    }
                }
            </div>
            <div class="tel-num">
                <input @bind="numero" @bind:event="oninput" placeholder="Número" @onkeydown="TeclaInput" />
                <div class="tel-pad">
                    @foreach (var t in new[] { "1", "2", "3", "4", "5", "6", "7", "8", "9", "*", "0", "#" })
                    {
                        <button @onclick="() => numero += t">@t</button>
                    }
                </div>
                <button class="tel-go" disabled="@(estado != "conectado" || string.IsNullOrWhiteSpace(numero))" @onclick="() => Llamar(numero)">Llamar</button>
                @if (!string.IsNullOrEmpty(aviso))
                {
                    <div class="tel-aviso">@aviso</div>
                }
            </div>
            @if (esAdmin)
            {
                <button class="tel-link" @onclick="AbrirMensajes">🗓 Mensajes programados</button>
            }
        </div>
    }

    @if (verMensajes)
    {
        <div class="tel-fondo" @onclick="() => verMensajes = false"></div>
        <div class="tel-msgs">
            <div class="tel-wh"><b>Mensajes programados</b><span>el sistema llama y lo lee en voz alta</span><button class="tel-x" @onclick="() => verMensajes = false">✕</button></div>
            @if (editando is null)
            {
                <div class="tel-msg-lista">
                    @if (mensajes.Count == 0)
                    {
                        <div class="tel-vacio">Todavía no hay mensajes programados.</div>
                    }
                    @foreach (var m in mensajes)
                    {
                        <div class="tel-msg @(m.Activo ? "" : "tel-off")">
                            <div class="tel-msg-txt">@m.Texto</div>
                            <div class="tel-msg-meta">
                                @NombreDestino(m.Destino) · @m.Hora · @DiasTexto(m)
                                @if (!m.Activo) { <span> · pausado</span> }
                                @if (m.UltimoEscuchadoAr is { } esc) { <span> · escuchado @esc.ToString("dd/MM HH:mm")</span> }
                                else if (m.UltimoEnvioAr is { } env) { <span> · llamó @env.ToString("dd/MM HH:mm"), nadie atendió</span> }
                            </div>
                            <div class="tel-msg-acc">
                                <button @onclick="() => Editar(m)">Editar</button>
                                <button @onclick="() => Borrar(m)">Borrar</button>
                            </div>
                        </div>
                    }
                </div>
                <div class="tel-msg-pie"><button class="tel-go" @onclick="Nuevo">+ Nuevo mensaje</button></div>
            }
            else
            {
                <div class="tel-form">
                    <label>Mensaje (lo lee en voz alta, dos veces)</label>
                    <textarea rows="3" maxlength="500" @bind="editando.Texto" @bind:event="oninput" placeholder="Ej: Buen día, hoy hay 12 envíos Flex, salen a las 11."></textarea>
                    <div class="tel-form-fila">
                        <div>
                            <label>A quién</label>
                            <select @bind="editando.Destino">
                                <option value="todos">Todos los conectados</option>
                                @foreach (var i in config.Internos.Where(x => x.Numero is not ("200" or "211" or "212" or "213" or "214" or "215")))
                                {
                                    <option value="@i.Numero">@i.Nombre</option>
                                }
                            </select>
                        </div>
                        <div>
                            <label>Hora</label>
                            <input type="time" value="@editando.Hora" @onchange="e => { if (editando != null) editando.Hora = e.Value?.ToString() ?? editando.Hora; }" />
                        </div>
                    </div>
                    <label>Días</label>
                    <div class="tel-dias">
                        @foreach (var d in "LMXJVSD")
                        {
                            var letra = d.ToString();
                            <button class="@(editando.Dias.Contains(d) ? "on" : "")" @onclick="() => AlternarDia(letra)">@letra</button>
                        }
                        <span class="tel-o">o una sola vez el</span>
                        <input type="date" value="@(editando.Fecha?.ToString("yyyy-MM-dd"))" @onchange="CambiarFecha" disabled="@(editando.Dias.Length > 0)" />
                    </div>
                    <label class="tel-check"><input type="checkbox" @bind="editando.Activo" /> Activo</label>
                    @if (!string.IsNullOrEmpty(errorMsg))
                    {
                        <div class="tel-error">@errorMsg</div>
                    }
                    @if (!string.IsNullOrEmpty(okMsg))
                    {
                        <div class="tel-aviso">@okMsg</div>
                    }
                    <div class="tel-form-btns">
                        <button class="tel-sec" @onclick="() => editando = null">Volver</button>
                        <button class="tel-sec" @onclick="Probar">▶ Probar ahora</button>
                        <button class="tel-go" @onclick="Guardar">Guardar</button>
                    </div>
                </div>
            }
        </div>
    }

    @if (modo == Modo.Entrante)
    {
        <div class="tel-card tel-centro">
            @if (!string.IsNullOrEmpty(busca))
            {
                <small>Te están llamando</small>
                <div class="tel-who">@NombreDe(otroNum, otroNom) busca a</div>
                <div class="tel-busca">@busca</div>
            }
            else
            {
                <small>Te están llamando</small>
                <div class="tel-who">@NombreDe(otroNum, otroNom)</div>
                <small>interno @otroNum</small>
            }
            <div class="tel-btns">
                <button class="tel-ok" @onclick="Atender">Atender</button>
                <button class="tel-no" @onclick="Cortar">Cortar</button>
            </div>
        </div>
    }

    @if (modo == Modo.Llamando || modo == Modo.Hablando)
    {
        <div class="tel-card tel-esquina">
            <small>@(modo == Modo.Llamando ? "Llamando a" : "Hablando con")</small>
            <div class="tel-who">@NombreDe(otroNum, otroNom)</div>
            <div class="tel-timer">@(modo == Modo.Llamando ? "sonando…" : Tiempo())</div>
            <div class="tel-btns">
                @if (modo == Modo.Hablando)
                {
                    <button class="tel-grey" @onclick="Silenciar">@(silenciado ? "🎙 Activar micrófono" : "🎙 Silenciar")</button>
                }
                <button class="tel-no" @onclick="Cortar">Cortar</button>
            </div>
        </div>
    }
}

<style>
    .tel-btn { position: relative; }
    .tel-badge { position: absolute; left: 0.1rem; top: 0.05rem; background: #ef4444; color: #fff; font-size: 0.62rem; font-weight: 700; border-radius: 999px; min-width: 1rem; padding: 0.05rem 0.3rem; line-height: 1.2; }
    .tel-perd { border-bottom: 1px solid #e5e7eb; }
    .tel-grupo-perd { color: #ef4444; }
    .tel-link { width: 100%; border: 0; border-top: 1px solid #e5e7eb; background: #fafafa; padding: 9px; font-size: 13px; color: #374151; cursor: pointer; }
    .tel-link:hover { background: #f3f4f6; }
    .tel-fondo { position: fixed; inset: 0; background: rgba(0,0,0,.25); z-index: 3002; }
    .tel-msgs { position: fixed; top: 70px; left: 50%; transform: translateX(-50%); width: 520px; max-width: 96vw; max-height: 80vh; display: flex; flex-direction: column; background: #fff; border-radius: 14px; box-shadow: 0 18px 50px rgba(0,0,0,.25); z-index: 3003; color: #111827; font-size: 14px; overflow: hidden; }
    .tel-msg-lista { overflow-y: auto; flex: 1; }
    .tel-vacio { padding: 24px; text-align: center; color: #6b7280; }
    .tel-msg { padding: 10px 14px; border-bottom: 1px solid #f3f4f6; }
    .tel-msg.tel-off .tel-msg-txt { color: #9ca3af; }
    .tel-msg-txt { white-space: pre-wrap; }
    .tel-msg-meta { font-size: 12px; color: #6b7280; margin-top: 3px; }
    .tel-msg-acc { margin-top: 6px; display: flex; gap: 6px; }
    .tel-msg-acc button, .tel-sec { border: 1px solid #d1d5db; background: #fff; border-radius: 8px; padding: 5px 10px; font-size: 13px; cursor: pointer; }
    .tel-msg-pie { padding: 10px 14px; border-top: 1px solid #e5e7eb; }
    .tel-msg-pie .tel-go { margin-top: 0; }
    .tel-form { padding: 12px 14px; overflow-y: auto; }
    .tel-form label { display: block; font-size: 12px; color: #6b7280; margin: 10px 0 4px; }
    .tel-form textarea, .tel-form select, .tel-form input[type=time], .tel-form input[type=date] { width: 100%; box-sizing: border-box; border: 1px solid #d1d5db; border-radius: 8px; padding: 7px 9px; font-size: 14px; font-family: inherit; }
    .tel-form-fila { display: flex; gap: 10px; }
    .tel-form-fila > div { flex: 1; }
    .tel-dias { display: flex; align-items: center; gap: 5px; flex-wrap: wrap; }
    .tel-dias button { width: 32px; height: 32px; border-radius: 50%; border: 1px solid #d1d5db; background: #fff; cursor: pointer; font-weight: 600; }
    .tel-dias button.on { background: #111827; color: #fff; border-color: #111827; }
    .tel-dias input[type=date] { width: auto; }
    .tel-o { font-size: 12px; color: #6b7280; margin: 0 4px 0 8px; }
    .tel-check { display: flex !important; align-items: center; gap: 6px; color: #111827 !important; font-size: 14px !important; }
    .tel-error { margin-top: 8px; color: #ef4444; font-size: 13px; }
    .tel-form-btns { display: flex; gap: 8px; margin-top: 14px; align-items: center; }
    .tel-form-btns .tel-go { width: auto; flex: 1; margin-top: 0; }
    .tel-dot { position: absolute; right: 0.25rem; top: 0.2rem; width: 9px; height: 9px; border-radius: 50%; border: 2px solid #fff; }
    .tel-dot.on { background: #10b981; }
    .tel-dot.wait { background: #d1d5db; }
    .tel-dot.off { background: #9ca3af; }
    .tel-win { position: fixed; top: 64px; right: 16px; width: 300px; background: #fff; border-radius: 14px; box-shadow: 0 14px 40px rgba(0,0,0,.18); z-index: 3000; overflow: hidden; color: #111827; font-size: 14px; }
    .tel-wh { display: flex; align-items: center; gap: 8px; padding: 10px 14px; border-bottom: 1px solid #e5e7eb; }
    .tel-wh b { flex: 1; }
    .tel-wh span { color: #6b7280; font-size: 12px; }
    .tel-x { border: 0; background: transparent; color: #9ca3af; cursor: pointer; font-size: 14px; }
    .tel-lista { max-height: 340px; overflow-y: auto; }
    .tel-grupo { padding: 8px 14px 2px; font-size: 11px; color: #9ca3af; text-transform: uppercase; letter-spacing: .05em; }
    .tel-row { display: flex; align-items: center; gap: 8px; padding: 6px 14px; border-bottom: 1px solid #f3f4f6; }
    .tel-row.tel-off b { color: #9ca3af; }
    .tel-pres { width: 8px; height: 8px; border-radius: 50%; background: #d1d5db; flex: none; }
    .tel-pres.on { background: #10b981; }
    .tel-busca { font-size: 30px; font-weight: 800; letter-spacing: .02em; margin: 2px 0 4px; }
    .tel-row b { flex: 1; font-weight: 500; }
    .tel-row i { font-style: normal; color: #9ca3af; font-size: 12px; margin-right: 6px; }
    .tel-call { border: 1px solid #d1d5db; border-radius: 8px; padding: 4px 10px; font-size: 13px; background: #fff; cursor: pointer; }
    .tel-call:disabled, .tel-go:disabled { opacity: .45; cursor: default; }
    .tel-num { padding: 10px 14px; }
    .tel-num input { width: 100%; box-sizing: border-box; border: 1px solid #d1d5db; border-radius: 8px; padding: 8px 10px; font-size: 16px; letter-spacing: .08em; }
    .tel-pad { display: grid; grid-template-columns: repeat(3, 1fr); gap: 6px; margin-top: 8px; }
    .tel-pad button { padding: 7px 0; border-radius: 8px; background: #f3f4f6; border: 0; font-size: 15px; cursor: pointer; }
    .tel-pad button:hover { background: #e5e7eb; }
    .tel-go { width: 100%; margin-top: 8px; padding: 9px; border-radius: 8px; background: #10b981; color: #fff; font-weight: 600; border: 0; cursor: pointer; }
    .tel-aviso { margin-top: 6px; font-size: 12px; color: #6b7280; }
    .tel-card { position: fixed; z-index: 3001; width: 300px; background: #fff; border-radius: 14px; box-shadow: 0 14px 40px rgba(0,0,0,.25); padding: 16px; text-align: center; color: #111827; }
    .tel-centro { top: 90px; left: 50%; transform: translateX(-50%); }
    .tel-esquina { right: 16px; bottom: 16px; }
    .tel-card small { color: #6b7280; display: block; }
    .tel-who { font-size: 20px; font-weight: 700; margin: 4px 0 2px; }
    .tel-timer { font-size: 24px; font-variant-numeric: tabular-nums; margin-top: 6px; color: #374151; }
    .tel-btns { display: flex; gap: 10px; margin-top: 14px; }
    .tel-btns button { flex: 1; padding: 10px; border-radius: 10px; color: #fff; font-weight: 600; border: 0; cursor: pointer; font-size: 14px; }
    .tel-ok { background: #10b981; }
    .tel-no { background: #ef4444; }
    .tel-btns .tel-grey { background: #f3f4f6; color: #111827; font-weight: 500; }
</style>

@code {
    private enum Modo { Libre, Entrante, Llamando, Hablando }

    private TelefonoConfig? config;
    private DotNetObjectReference<TelefonoSistema>? yo;
    private string estado = "conectando";
    private bool abierto;
    private Modo modo = Modo.Libre;
    private string numero = "";
    private string otroNum = "", otroNom = "", busca = "";
    private HashSet<string> conectados = new();
    private List<TelefonoPerdida> perdidas = new();       // las no vistas (numerito rojo)
    private List<TelefonoPerdida> perdidasVistas = new(); // las que se muestran en la ventanita abierta
    private bool esAdmin;
    private bool verMensajes;
    private List<TelefonoMensaje> mensajes = new();
    private TelefonoMensaje? editando;
    private string errorMsg = "", okMsg = "";
    private bool EsDeLaOficina => config?.Usuario is "201" or "202" or "203";
    private System.Threading.Timer? sondeo;
    private string? usuarioActual;
    private string aviso = "";
    private bool silenciado;
    private DateTime? desde;
    private System.Threading.Timer? reloj;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;
        Operador.OnChange += AlCambiarOperador;
        try { esAdmin = (await AuthState.GetAuthenticationStateAsync()).User.IsInRole("admin"); } catch { }
        await Conectar();
        sondeo = new System.Threading.Timer(async _ => await InvokeAsync(Sondear), null, 2000, 10000);
    }

    // Pide a la API que interno le toca a esta compu (segun usuario y PIN) y se conecta.
    private async Task Conectar()
    {
        TelefonoConfig? nueva;
        try { nueva = await Api.GetTelefonoConfigAsync(); } catch { return; }
        if (nueva is not { Habilitado: true })
        {
            if (usuarioActual != null) { try { await JS.InvokeVoidAsync("telefono.apagar"); } catch { } }
            usuarioActual = null; config = nueva; StateHasChanged();
            return;
        }
        config = nueva;
        yo ??= DotNetObjectReference.Create(this);
        if (usuarioActual != config.Usuario)
        {
            usuarioActual = config.Usuario;
            estado = "conectando";
            try
            {
                await JS.InvokeVoidAsync("telefono.init", new
                {
                    wsUrl = config.WsUrl,
                    dominio = config.Dominio,
                    usuario = config.Usuario,
                    clave = config.Clave,
                    nombre = config.MiNombre
                }, yo);
            }
            catch { estado = "desconectado"; }
        }
        StateHasChanged();
    }

    private void AlCambiarOperador() => InvokeAsync(Conectar);

    private async Task Sondear()
    {
        // todavia sin interno (ej. recien entrado, sin PIN): volver a preguntar
        if (config is not { Habilitado: true }) { await Conectar(); return; }
        try
        {
            var e = await Api.GetTelefonoEstadoAsync();
            conectados = e?.Conectados.ToHashSet() ?? new();
            perdidas = await Api.GetTelefonoPerdidasAsync();
            StateHasChanged();
        }
        catch { }
    }

    private string NombreDe(string num, string nom)
    {
        var i = config?.Internos.FirstOrDefault(x => x.Numero == num);
        if (i != null) return i.Nombre;
        if (num == "600") return "Prueba de eco";
        return string.IsNullOrWhiteSpace(nom) ? num : nom;
    }

    private string Tiempo()
    {
        if (desde is null) return "00:00";
        var t = DateTime.UtcNow - desde.Value;
        return $"{(int)t.TotalMinutes:00}:{t.Seconds:00}";
    }

    private async Task Alternar()
    {
        if (abierto) { await Cerrar(); return; }
        abierto = true; aviso = "";
        await Sondear();
        perdidasVistas = perdidas.ToList();
    }

    // al cerrar la ventanita, las perdidas que se mostraron quedan vistas
    private async Task Cerrar()
    {
        abierto = false;
        if (perdidasVistas.Count > 0)
        {
            perdidasVistas.Clear(); perdidas.Clear();
            await Api.MarcarTelefonoPerdidasVistasAsync();
        }
    }

    // ---- mensajes programados ----
    private async Task AbrirMensajes()
    {
        abierto = false; verMensajes = true; editando = null;
        mensajes = await Api.GetTelefonoMensajesAsync();
    }

    private void Nuevo()
    {
        errorMsg = okMsg = "";
        editando = new TelefonoMensaje { Destino = "todos", Hora = "09:00", Dias = "LMXJV", Activo = true };
    }

    private void Editar(TelefonoMensaje m)
    {
        errorMsg = okMsg = "";
        editando = new TelefonoMensaje { Id = m.Id, Texto = m.Texto, Destino = m.Destino, Hora = m.Hora, Dias = m.Dias, Fecha = m.Fecha, Activo = m.Activo };
    }

    private async Task Borrar(TelefonoMensaje m)
    {
        if (!await JS.InvokeAsync<bool>("confirm", "¿Borrar este mensaje programado?")) return;
        await Api.BorrarTelefonoMensajeAsync(m.Id);
        mensajes = await Api.GetTelefonoMensajesAsync();
    }

    private void AlternarDia(string d)
    {
        if (editando is null) return;
        editando.Dias = editando.Dias.Contains(d) ? editando.Dias.Replace(d, "") : new string("LMXJVSD".Where(c => editando.Dias.Contains(c) || c.ToString() == d).ToArray());
        if (editando.Dias.Length > 0) editando.Fecha = null;
    }

    private void CambiarFecha(ChangeEventArgs e)
    {
        if (editando is null) return;
        editando.Fecha = DateTime.TryParse(e.Value?.ToString(), out var f) ? f : null;
    }

    private async Task Guardar()
    {
        if (editando is null) return;
        errorMsg = okMsg = "";
        var (ok, err) = await Api.GuardarTelefonoMensajeAsync(editando);
        if (!ok) { errorMsg = err ?? "No se pudo guardar"; return; }
        editando = null;
        mensajes = await Api.GetTelefonoMensajesAsync();
    }

    private async Task Probar()
    {
        if (editando is null) return;
        errorMsg = okMsg = "";
        var (ok, err) = await Api.ProbarTelefonoMensajeAsync(editando);
        if (ok) okMsg = "Llamando… atendé para escucharlo."; else errorMsg = err ?? "No se pudo probar";
    }

    private string NombreDestino(string d) => d == "todos" ? "Todos los conectados" : config?.Internos.FirstOrDefault(i => i.Numero == d)?.Nombre ?? d;

    private static string DiasTexto(TelefonoMensaje m)
    {
        if (string.IsNullOrEmpty(m.Dias)) return m.Fecha is { } f ? "una vez, el " + f.ToString("dd/MM") : "una vez";
        if (m.Dias == "LMXJVSD") return "todos los días";
        if (m.Dias == "LMXJV") return "lunes a viernes";
        if (m.Dias == "LMXJVS") return "lunes a sábado";
        return string.Join(" ", m.Dias.ToCharArray());
    }

    private async Task Llamar(string num)
    {
        aviso = "";
        if (string.IsNullOrWhiteSpace(num)) return;
        var ok = await JS.InvokeAsync<bool>("telefono.llamar", num);
        if (!ok) aviso = "No se pudo llamar (¿está conectado?)";
    }

    private async Task TeclaInput(KeyboardEventArgs e)
    {
        if (e.Key == "Enter") await Llamar(numero);
    }

    private async Task Atender() => await JS.InvokeVoidAsync("telefono.atender");
    private async Task Cortar() => await JS.InvokeVoidAsync("telefono.cortar");

    private async Task Silenciar()
    {
        silenciado = !silenciado;
        await JS.InvokeVoidAsync("telefono.silenciar", silenciado);
    }

    // ---- avisos desde telefono.js ----
    [JSInvokable] public void OnEstado(string e) { estado = e; InvokeAsync(StateHasChanged); }

    [JSInvokable] public void OnEntrante(string num, string nom, string? quien)
    {
        otroNum = num; otroNom = nom; busca = quien ?? ""; modo = Modo.Entrante; abierto = false;
        InvokeAsync(StateHasChanged);
    }

    [JSInvokable] public void OnLlamando(string num, string nom)
    {
        otroNum = num; otroNom = nom; busca = ""; modo = Modo.Llamando; abierto = false;
        InvokeAsync(StateHasChanged);
    }

    [JSInvokable] public void OnHablando(string num, string nom)
    {
        if (!string.IsNullOrEmpty(num)) otroNum = num;
        if (!string.IsNullOrEmpty(nom)) otroNom = nom;
        modo = Modo.Hablando; desde = DateTime.UtcNow; silenciado = false;
        reloj?.Dispose();
        reloj = new System.Threading.Timer(_ => InvokeAsync(StateHasChanged), null, 1000, 1000);
        InvokeAsync(StateHasChanged);
    }

    [JSInvokable] public void OnFin(string causa)
    {
        reloj?.Dispose(); reloj = null;
        var eraLlamando = modo == Modo.Llamando;
        modo = Modo.Libre; desde = null; silenciado = false;
        if (eraLlamando && !string.IsNullOrEmpty(causa) && causa != "Canceled")
        {
            aviso = causa switch
            {
                "Busy" => "Está ocupado",
                "Temporarily Unavailable" => "No está conectado",
                "Unavailable" or "Not Found" => "No está conectado",
                "No Answer" => "No atendió",
                "User Denied Media Access" => "El navegador no dejó usar el micrófono",
                _ => "La llamada terminó: " + causa
            };
            abierto = true;
        }
        InvokeAsync(StateHasChanged);
    }

    public async ValueTask DisposeAsync()
    {
        Operador.OnChange -= AlCambiarOperador;
        sondeo?.Dispose();
        reloj?.Dispose();
        try { await JS.InvokeVoidAsync("telefono.apagar"); } catch { }
        yo?.Dispose();
    }
}
