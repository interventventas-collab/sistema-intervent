@code {
    /// <summary>Qué hacer con el mensaje armado (el chat lo deja escrito abajo).</summary>
    [Parameter] public EventCallback<string> OnListo { get; set; }
    [Parameter] public string TextoBoton { get; set; } = "Pasar al chat";

    private static readonly CultureInfo ARS = CultureInfo.GetCultureInfo("es-AR");
    private static readonly decimal[] Escalones = { 0m, 100m, 500m, 1000m };

    private class Renglon
    {
        public string Sku = "";
        public string Nombre = "";
        public decimal? Bar;          // sin IVA
        public decimal? Comercial;    // sin IVA
        public decimal Costo;         // sin IVA (para "Mi %")
        public decimal IvaPct = 21m;
        public List<CafePrecioFormatoDto> Formatos = new();  // solo cafés: 1 kg / ½ / ¼
        public string? Formato;       // el elegido de Formatos
        public decimal Cantidad = 1m;
        public decimal? PrecioManual; // pisado a mano: se respeta tal cual
        public CafePrecioFormatoDto? Fmt => Formatos.FirstOrDefault(f => f.Formato == Formato);
    }

    private readonly List<Renglon> items = new();
    private List<CatalogItem> sugerencias = new();
    private string busq = "";
    private bool catalogoCargado;
    private bool agregando;

    private string lista = "bar";     // "bar" | "com" | "pct"
    private string pctTxt = "";
    private bool conIva = true;
    private decimal redondeo = 500m;

    private string texto = "";
    private bool textoEditado;

    protected override async Task OnInitializedAsync()
    {
        try { await Catalog.EnsureLoadedAsync(); catalogoCargado = Catalog.Count > 0; }
        catch { catalogoCargado = false; }
    }

    // ── Buscar y agregar ──
    private void OnBusq(ChangeEventArgs e)
    {
        busq = e.Value?.ToString() ?? "";
        var q = busq.Trim();
        sugerencias = (q.Length < 2 || !catalogoCargado)
            ? new()
            : Catalog.Search(q, 8, it => it.Tipo == "producto").Select(h => h.Item).ToList();
    }

    private async Task OnBusqKey(KeyboardEventArgs e)
    {
        if (e.Key != "Enter") return;
        if (sugerencias.Count > 0) await Agregar(sugerencias[0].Sku);
        else if (!string.IsNullOrWhiteSpace(busq)) await Agregar(busq.Trim());
    }

    private async Task Agregar(string codigo)
    {
        if (agregando) return;
        sugerencias = new();
        agregando = true;
        try
        {
            var r = await Api.BuscarPrecioCafeAsync(codigo);
            if (r is null || !r.Encontrado) { Toast.Error(r?.Mensaje ?? "No encontré ese producto."); return; }

            // Si ya está, le sumo uno en vez de repetir el renglón. Los cafés no: el mismo café
            // puede ir en dos tamaños (1 kg y ¼), así que cada vez es un renglón nuevo.
            var ya = (r.Formatos?.Count ?? 0) == 0 ? items.FirstOrDefault(x => x.Sku == r.Sku) : null;
            if (ya is not null) { ya.Cantidad += 1m; }
            else
            {
                var fila = new Renglon
                {
                    Sku = r.Sku,
                    Nombre = r.Nombre,
                    IvaPct = r.IvaPct > 0m ? r.IvaPct : 21m,
                    Costo = r.CostoSinIva,
                    Formatos = r.Formatos ?? new(),
                };
                fila.Formato = fila.Formatos.FirstOrDefault()?.Formato;
                // Con OEM viene un solo "Sugerido": vale para las dos listas.
                var sug = r.Precios.FirstOrDefault(p => p.Etiqueta.StartsWith("Sugerido"));
                fila.Bar = sug?.SinIva ?? r.Precios.FirstOrDefault(p => p.Etiqueta.StartsWith("Precio Bar"))?.SinIva;
                fila.Comercial = sug?.SinIva ?? r.Precios.FirstOrDefault(p => p.Etiqueta.StartsWith("Precio Comercial"))?.SinIva;
                items.Add(fila);
            }
            busq = "";
            Cambio();
        }
        catch (Exception ex) { Toast.Error("No pude traer el precio: " + ex.Message); }
        finally { agregando = false; }
    }

    // ── Opciones ──
    private void CambiarLista(string l) { lista = l; Cambio(); }
    private void OnPct(ChangeEventArgs e) { pctTxt = e.Value?.ToString() ?? ""; Cambio(); }
    private decimal? Pct => ParseNum(pctTxt);
    private void CambiarFormato(Renglon r, string f) { r.Formato = f; r.PrecioManual = null; Cambio(); }
    private void CambiarIva(bool v) { conIva = v; Cambio(); }
    private void CambiarRedondeo(decimal v) { redondeo = v; Cambio(); }

    private void Sacar(Renglon r) { items.Remove(r); Cambio(); }
    private void Cant(Renglon r, int d) { r.Cantidad = Math.Max(1m, r.Cantidad + d); Cambio(); }
    private void SetCant(Renglon r, ChangeEventArgs e)
    {
        if (ParseNum(e.Value?.ToString()) is decimal n && n > 0m) r.Cantidad = n;
        Cambio();
    }
    private void SetPrecio(Renglon r, ChangeEventArgs e)
    {
        var n = ParseNum(e.Value?.ToString());
        r.PrecioManual = n is decimal v && v > 0m ? v : null;   // vacío = vuelve al de lista
        Cambio();
    }

    // ── Cuentas ──
    /// <summary>Precio c/u que se muestra y se manda: el manual tal cual, si no el de lista
    /// (con IVA si corresponde) redondeado para ARRIBA al escalón elegido.</summary>
    private decimal PrecioDe(Renglon r)
    {
        if (r.PrecioManual is decimal m) return m;
        var baseSin = BaseSinIva(r) ?? 0m;
        var p = conIva ? baseSin * (1m + r.IvaPct / 100m) : baseSin;
        if (redondeo > 0m) return Math.Ceiling(p / redondeo) * redondeo;
        return Math.Round(p, 2);
    }

    /// <summary>Precio sin IVA antes de redondear, según la lista elegida y el formato del café.</summary>
    private decimal? BaseSinIva(Renglon r)
    {
        var fmt = r.Fmt;
        if (lista == "pct")
        {
            var costo = fmt?.Costo ?? r.Costo;
            if (Pct is not decimal pct || costo <= 0m) return null;
            return costo * (1m + pct / 100m);
        }
        if (fmt is not null)
        {
            var v = lista == "bar" ? fmt.Bar : fmt.Comercial;
            return v > 0m ? v : null;
        }
        return lista == "bar" ? r.Bar ?? r.Comercial : r.Comercial ?? r.Bar;
    }

    private string? AvisoDe(Renglon r)
    {
        if (BaseSinIva(r) is decimal b && b > 0m) return null;
        if (lista == "pct")
            return Pct is null ? "Poné el % que querés ganar." : "No tiene costo cargado: poné el precio a mano.";
        return "No tiene precio de lista: ponelo a mano.";
    }

    private decimal Total => items.Sum(r => PrecioDe(r) * r.Cantidad);

    // ── Mensaje ──
    private string Texto => texto;

    private string ArmarTexto()
    {
        var sb = new System.Text.StringBuilder();
        sb.AppendLine("*Presupuesto*");
        foreach (var r in items)
        {
            var p = PrecioDe(r);
            var nombre = r.Fmt is { } f ? $"{r.Nombre} {f.Etiqueta}" : r.Nombre;
            if (r.Cantidad == 1m)
                sb.AppendLine($"{Num(r.Cantidad)} × {nombre} — {Plata(p)}");
            else
                sb.AppendLine($"{Num(r.Cantidad)} × {nombre} — {Plata(p)} c/u = {Plata(p * r.Cantidad)}");
        }
        sb.AppendLine();
        sb.AppendLine($"*Total: {Plata(Total)}*");
        sb.Append(conIva ? "Precios con IVA incluido." : "Precios sin IVA.");
        return sb.ToString();
    }

    /// <summary>Cada cambio en la lista rehace el mensaje, salvo que ya lo hayan escrito a mano:
    /// ahí no se le pisa lo que escribió (para eso está "Rehacer").</summary>
    private void Cambio()
    {
        if (!textoEditado) texto = items.Count == 0 ? "" : ArmarTexto();
    }

    private void OnEditarTexto(ChangeEventArgs e)
    {
        texto = e.Value?.ToString() ?? "";
        textoEditado = true;
    }

    private void RehacerTexto() { textoEditado = false; Cambio(); }

    private async Task Listo()
    {
        if (string.IsNullOrWhiteSpace(texto)) return;
        await OnListo.InvokeAsync(texto.TrimEnd());
    }

    public void Limpiar()
    {
        items.Clear();
        busq = "";
        sugerencias = new();
        texto = "";
        textoEditado = false;
        StateHasChanged();
    }

    // ── Formatos ──
    private static string Plata(decimal v)
        => "$" + v.ToString(v == Math.Round(v) ? "N0" : "N2", ARS);

    private static string Num(decimal v) => v.ToString("0.##", ARS);
    private static string Miles(decimal v) => v.ToString("#,0.##", ARS);

    /// <summary>Acepta coma o punto. "28.500" (miles) = 28500; "28,5" = 28,5.</summary>
    private static decimal? ParseNum(string? s)
    {
        if (string.IsNullOrWhiteSpace(s)) return null;
        s = s.Trim().Replace(" ", "").Replace("$", "");
        if (s.Contains(',')) s = s.Replace(".", "").Replace(",", ".");
        else if (System.Text.RegularExpressions.Regex.IsMatch(s, @"^\d{1,3}(\.\d{3})+$")) s = s.Replace(".", "");
        return decimal.TryParse(s, NumberStyles.Number, CultureInfo.InvariantCulture, out var n) ? n : null;
    }
}
