@* ══════════════════════════════════════════════════════════════════════════════════
   COTIZADOR DE PRODUCTOS — 2026-10-14. Hermano del CotizadorAlquiler, para productos.

   Pedido del dueño: "agregar varios tipo cotización escrita detallada", precio POR RENGLÓN
   (a diferencia del de alquileres, que solo muestra el total), redondear CADA precio, y poder
   editar el mensaje antes de pasarlo.

   Qué hace: buscás producto por código o nombre (el mismo buscador de CalcuPrecios), se agrega
   con el precio de la lista elegida (Bar / Comercial; si el producto tiene OEM, el sugerido),
   con o sin IVA, redondeado para ARRIBA al escalón elegido. El precio c/u se puede pisar a mano.
   2026-10-14 (2ª vuelta): "Mi %" = costo sin IVA + el % que se quiere ganar (como CalcuPrecios), y
   los cafés se eligen en 1 kg / ½ / ¼ con los precios del MISMO motor que la venta (la API los manda
   en Formatos: la fracción no es el kilo dividido, suma fraccionamiento y redondea).
   Abajo se ve el mensaje armado en un cuadro editable.

   Qué NO hace: mandar ni crear ventas. Pasa el texto por OnListo y el que lo usa decide
   (el chat lo deja escrito abajo; el envío SIEMPRE lo decide una persona).
   ══════════════════════════════════════════════════════════════════════════════════ *@

@using System.Globalization
@using Web.Models.Mobile
@inject ApiClient Api
@inject ToastService Toast
@inject Web.Services.Mobile.CatalogIndex Catalog

<div class="cotprod">
    <input class="cotprod-inp" placeholder="Código o nombre del producto…" value="@busq"
           @oninput="OnBusq" @onkeydown="OnBusqKey" autocomplete="off" />
    @if (agregando)
    {
        <div class="cotprod-info">⏳ Trayendo el precio…</div>
    }
    @if (sugerencias.Count > 0)
    {
        <div class="cotprod-sug">
            @foreach (var s in sugerencias)
            {
                <button class="cotprod-sug-i" @onclick="() => Agregar(s.Sku)">
                    <span class="cotprod-sug-sku">@s.Sku</span> @s.Nombre
                </button>
            }
        </div>
    }

    <div class="cotprod-opc">
        <span class="cotprod-opc-l">Lista</span>
        <button class="cotprod-chip @(lista == "bar" ? "on" : "")" @onclick='() => CambiarLista("bar")'>Bar</button>
        <button class="cotprod-chip @(lista == "com" ? "on" : "")" @onclick='() => CambiarLista("com")'>Comercial</button>
        @* 2026-10-14: como en CalcuPrecios — costo sin IVA + el % que se quiere ganar. *@
        <button class="cotprod-chip @(lista == "pct" ? "on" : "")" @onclick='() => CambiarLista("pct")'>Mi %</button>
    </div>
    @if (lista == "pct")
    {
        <div class="cotprod-opc">
            <span class="cotprod-opc-l">Ganar</span>
            <input class="cotprod-pct" inputmode="decimal" placeholder="ej: 30" value="@pctTxt"
                   onfocus="this.select()" @oninput="OnPct" />
            <span class="cotprod-opc-l">% sobre el costo</span>
        </div>
    }
    <div class="cotprod-opc">
        <span class="cotprod-opc-l">Precio</span>
        <button class="cotprod-chip @(!conIva ? "on" : "")" @onclick="() => CambiarIva(false)">Sin IVA</button>
        <button class="cotprod-chip @(conIva ? "on" : "")" @onclick="() => CambiarIva(true)">Con IVA</button>
    </div>
    <div class="cotprod-opc">
        <span class="cotprod-opc-l">Redondear</span>
        @foreach (var r in Escalones)
        {
            var v = r;
            <button class="cotprod-chip @(redondeo == v ? "on" : "")" @onclick="() => CambiarRedondeo(v)">
                @(v == 0 ? "No" : Plata(v))
            </button>
        }
    </div>

    @if (items.Count == 0)
    {
        <div class="cotprod-info">Buscá un producto arriba y tocalo para agregarlo. Podés agregar todos los que quieras.</div>
    }
    else
    {
        <div class="cotprod-lista">
            @foreach (var it in items)
            {
                var fila = it;
                <div class="cotprod-fila">
                    <div class="cotprod-fila-1">
                        <span class="cotprod-nom" title="@fila.Sku">@fila.Nombre</span>
                        <button class="cotprod-x" @onclick="() => Sacar(fila)" title="Sacar">×</button>
                    </div>
                    <div class="cotprod-fila-2">
                        <button class="cotprod-mas" @onclick="() => Cant(fila, -1)">−</button>
                        <input class="cotprod-cant" inputmode="decimal" value="@Num(fila.Cantidad)"
                               onfocus="this.select()" @onchange="e => SetCant(fila, e)" />
                        <button class="cotprod-mas" @onclick="() => Cant(fila, 1)">+</button>
                        <span class="cotprod-por">×</span>
                        <input class="cotprod-precio @(fila.PrecioManual.HasValue ? "manual" : "")" inputmode="decimal"
                               value="@Miles(PrecioDe(fila))" onfocus="this.select()" @onchange="e => SetPrecio(fila, e)"
                               title="@(fila.PrecioManual.HasValue ? "Precio puesto a mano" : "Precio c/u — tocalo para cambiarlo a mano")" />
                    </div>
                    @if (fila.Formatos.Count > 0)
                    {
                        @* 2026-10-14: cafés en 1 kg / ½ / ¼ — precio del motor de ventas (fraccionamiento incluido). *@
                        <div class="cotprod-fmt">
                            @foreach (var f in fila.Formatos)
                            {
                                var ff = f;
                                <button class="cotprod-chip @(fila.Formato == ff.Formato ? "on" : "")"
                                        @onclick="() => CambiarFormato(fila, ff.Formato)">@ff.Etiqueta</button>
                            }
                        </div>
                    }
                    @if (fila.PrecioManual is null && AvisoDe(fila) is string aviso)
                    {
                        <div class="cotprod-nota cotprod-alerta">@aviso</div>
                    }
                </div>
            }
        </div>

        <div class="cotprod-total">
            <span>Total @(conIva ? "con IVA" : "sin IVA")</span>
            <b>@Plata(Total)</b>
        </div>

        <label class="cotprod-lbl">
            Mensaje @(textoEditado ? "(editado a mano)" : "— lo podés cambiar")
        </label>
        <textarea class="cotprod-texto" rows="8" value="@Texto" @oninput="OnEditarTexto"></textarea>
        @if (textoEditado)
        {
            <button class="cotprod-rehacer" @onclick="RehacerTexto"
                    title="Tira lo que escribiste a mano y vuelve a armar el mensaje con la lista de arriba">
                ↻ Rehacer el mensaje con la lista
            </button>
        }

        <button class="cotprod-btn-main" @onclick="Listo">@TextoBoton</button>
        <button class="cotprod-btn-limpiar" @onclick="Limpiar">Vaciar y empezar de nuevo</button>
    }
</div>

