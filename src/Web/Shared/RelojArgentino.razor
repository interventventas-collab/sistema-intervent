@* 2026-08-26: RELOJ de la barra de arriba, con hora de ARGENTINA + alarmas.

   Reemplaza al chip de hora que había antes (mostraba HH:mm y se refrescaba cada 30 segundos).
   Ahora es un display de siete segmentos con segundero, a pedido del dueño — "tipo radio reloj
   antiguo". Empezó siendo una ventanita flotante, pero se tapaba con el botón de WhatsApp y el
   propio dueño propuso lo obvio: usar el lugar que ya estaba reservado para la hora.

   Por qué importa que se vea siempre: maneja el negocio argentino desde España. Tener Buenos
   Aires a la vista evita la cuenta mental — y delata cualquier pantalla que muestre otra hora
   (así se descubrió el error del panel de mensajes programados).

   La hora sale de DateTimeExt (UTC-3 fijo), NUNCA del reloj del navegador. *@

@implements IDisposable
@inject ApiClient Api
@inject ToastService Toast
@inject IJSRuntime JS

<div class="rl-chip @(sonando != null ? "sonando" : "")" title="Hora de Argentina">
    <div class="rl-chip-hora">
        <div class="rl-face">
            @Digito(Ahora.Hour / 10)@Digito(Ahora.Hour % 10)
            <span class="rl-colon @(Ahora.Second % 2 == 0 ? "on" : "")"><span></span><span></span></span>
            @Digito(Ahora.Minute / 10)@Digito(Ahora.Minute % 10)
            <span class="rl-secs">@Digito(Ahora.Second / 10, true)@Digito(Ahora.Second % 10, true)</span>
        </div>
        <div class="rl-date">@FechaLinda()</div>
    </div>

    <button class="rl-alarma-btn @(alarmasPendientes.Count > 0 ? "tiene" : "")"
            @onclick="ToggleAlarmas"
            title="@(alarmasPendientes.Count > 0 ? $"Tenés {alarmasPendientes.Count} alarma(s) puesta(s)" : "Poner una alarma")">
        ⏰@(alarmasPendientes.Count > 0 ? $" {alarmasPendientes.Count}" : "")
    </button>

    @if (panelAlarmas)
    {
        <div class="rl-drop">
            <div class="rl-panel-tit">
                ⏰ Alarmas de <b>@quienSoy</b>
                <button class="rl-tool" @onclick="ToggleAlarmas" title="Cerrar">×</button>
            </div>

            @if (alarmasPendientes.Count == 0)
            {
                <div class="rl-vacio">No tenés ninguna alarma puesta.</div>
            }
            else
            {
                @foreach (var a in alarmasPendientes)
                {
                    <div class="rl-item">
                        <span class="rl-item-hora">@CuandoCorto(a.Cuando.ToArTime())</span>
                        <span class="rl-item-nota" title="@a.Nota">@(string.IsNullOrWhiteSpace(a.Nota) ? "(sin nota)" : a.Nota)</span>
                        <button class="rl-item-x" @onclick="() => Borrar(a)" title="Sacar esta alarma">✖</button>
                    </div>
                }
            }

            <div class="rl-nueva">
                <div class="rl-nueva-fila">
                    <input type="time" class="rl-input rl-input-hora" @bind="nuevaHora" />
                    <input type="date" class="rl-input" @bind="nuevaFecha" />
                </div>
                <input class="rl-input" placeholder="¿De qué te tengo que acordar?" maxlength="300"
                       @bind="nuevaNota" @bind:event="oninput" />
                <div class="rl-sonidos">
                    @foreach (var s in Sonidos)
                    {
                        <button class="rl-son @(nuevoSonido == s.Key ? "sel" : "")"
                                @onclick="() => ElegirSonido(s.Key)" title="Tocá para elegirlo y escucharlo">
                            @s.Label
                        </button>
                    }
                </div>
                <button class="rl-poner" disabled="@guardando" @onclick="Poner">
                    @(guardando ? "Poniendo…" : "⏰ Poner la alarma")
                </button>
            </div>
        </div>
    }
</div>

@* El cartel de cuando SUENA va al medio de la pantalla, aparte del chip: una alarma que aparece
   en un rincón de 40 píxeles no es una alarma. *@
@if (sonando != null)
{
    <div class="rl-ring">
        <div class="rl-ring-ico">⏰</div>
        <div class="rl-ring-body">
            <div class="rl-ring-hora">
                @CuandoCorto(sonando.Cuando.ToArTime())
                @if (LlegaTarde(sonando)) { <span class="rl-ring-tarde">· era para más temprano, no estabas</span> }
            </div>
            <div class="rl-ring-nota">@(string.IsNullOrWhiteSpace(sonando.Nota) ? "Sin nota" : sonando.Nota)</div>
        </div>
        <button class="rl-ring-off" @onclick="Apagar">Apagar</button>
    </div>
}

@code {
    DateTime Ahora = DateTimeExt.AhoraAr();
    bool panelAlarmas = false;
    bool guardando = false;
    string quienSoy = "";
    List<ApiClient.AlarmaDto> alarmasPendientes = new();
    ApiClient.AlarmaDto? sonando = null;

    TimeOnly nuevaHora = TimeOnly.FromDateTime(DateTimeExt.AhoraAr().AddHours(1));
    DateTime nuevaFecha = DateTimeExt.AhoraAr().Date;
    string nuevaNota = "";
    string nuevoSonido = "despertador";

    System.Threading.Timer? tic;
    int vueltas = 0;

    static readonly (string Key, string Label)[] Sonidos = new[]
    {
        ("despertador", "⏰ Despertador"),
        ("chime", "🔔 Campanita"),
        ("msn", "🟢 Ding-dong"),
        ("levelup", "🎺 Level up"),
        ("laser", "👾 Láser")
    };

    protected override async Task OnInitializedAsync()
    {
        // Cada segundo corre el segundero; las alarmas se preguntan cada 30 vueltas (30 s).
        tic = new System.Threading.Timer(async _ =>
        {
            Ahora = DateTimeExt.AhoraAr();
            vueltas++;
            if (vueltas % 30 == 1) await CargarAlarmas();
            await InvokeAsync(StateHasChanged);
        }, null, 0, 1000);

        await CargarAlarmas();
    }

    async Task CargarAlarmas()
    {
        var resp = await Api.GetAlarmasAsync();
        if (resp == null) return;
        quienSoy = resp.Quien ?? "";
        alarmasPendientes = (resp.Alarmas ?? new()).OrderBy(a => a.Cuando).ToList();

        // La vencida es la que tiene que sonar. Si venció mientras esta persona no estaba, suena
        // igual ahora: por eso una alarma no se pierde nunca en silencio.
        var toca = alarmasPendientes.FirstOrDefault(a => a.Vencida);
        if (toca != null && sonando?.Id != toca.Id)
        {
            sonando = toca;
            try { await JS.InvokeVoidAsync("reloj.sonarHasta", toca.Sonido); } catch { }
        }
    }

    async Task Poner()
    {
        var cuandoAr = nuevaFecha.Date.Add(nuevaHora.ToTimeSpan());
        if (cuandoAr <= DateTimeExt.AhoraAr()) { Toast.Warning("Esa hora ya pasó. Elegí una que venga."); return; }
        guardando = true;
        try
        {
            var (ok, err) = await Api.PonerAlarmaAsync(cuandoAr.ArToUtc(), nuevaNota, nuevoSonido);
            if (!ok) { Toast.Error(err ?? "No se pudo poner la alarma"); return; }
            Toast.Success($"Alarma puesta para {CuandoCorto(cuandoAr)}.");
            nuevaNota = "";
            await CargarAlarmas();
        }
        finally { guardando = false; }
    }

    async Task Borrar(ApiClient.AlarmaDto a)
    {
        var (ok, err) = await Api.BorrarAlarmaAsync(a.Id);
        if (!ok) { Toast.Error(err ?? "No se pudo sacar"); return; }
        if (sonando?.Id == a.Id) await Apagar();
        await CargarAlarmas();
    }

    async Task Apagar()
    {
        try { await JS.InvokeVoidAsync("reloj.callar"); } catch { }
        if (sonando != null) await Api.ApagarAlarmaAsync(sonando.Id);
        sonando = null;
        await CargarAlarmas();
    }

    void ElegirSonido(string key)
    {
        nuevoSonido = key;
        _ = JS.InvokeVoidAsync("reloj.probar", key);   // se elige escuchándolo, como en el chat
    }

    void ToggleAlarmas() => panelAlarmas = !panelAlarmas;

    /// <summary>¿Suena tarde? (la hora pasó hace más de un minuto porque no había nadie).</summary>
    bool LlegaTarde(ApiClient.AlarmaDto a) => (DateTime.UtcNow - a.Cuando).TotalMinutes > 1;

    static readonly string[] Dias = { "dom", "lun", "mar", "mié", "jue", "vie", "sáb" };
    string FechaLinda() => $"{Dias[(int)Ahora.DayOfWeek]} {Ahora:dd/MM}";

    string CuandoCorto(DateTime ar)
    {
        var hoy = DateTimeExt.AhoraAr().Date;
        if (ar.Date == hoy) return ar.ToString("HH:mm");
        if (ar.Date == hoy.AddDays(1)) return $"mañana {ar:HH:mm}";
        return $"{ar:dd/MM} {ar:HH:mm}";
    }

    /// <summary>Un dígito de siete segmentos. Los apagados se dibujan igual pero oscuros: eso es
    /// lo que lo hace parecer un display de verdad y no números escritos.</summary>
    static readonly Dictionary<char, string> Segmentos = new()
    {
        ['a'] = "10,3 30,3 33,6 30,9 10,9 7,6",
        ['b'] = "31,7 34,10 34,30 31,33 28,30 28,10",
        ['c'] = "31,37 34,40 34,60 31,63 28,60 28,40",
        ['d'] = "10,61 30,61 33,64 30,67 10,67 7,64",
        ['e'] = "9,37 12,40 12,60 9,63 6,60 6,40",
        ['f'] = "9,7 12,10 12,30 9,33 6,30 6,10",
        ['g'] = "10,32 30,32 33,35 30,38 10,38 7,35",
    };
    static readonly string[] Encendidos =
    {
        "abcdef", "bc", "abged", "abgcd", "fgbc", "afgcd", "afgecd", "abc", "abcdefg", "abcdfg"
    };

    MarkupString Digito(int n, bool chico = false)
    {
        var on = Encendidos[Math.Clamp(n, 0, 9)];
        var alto = chico ? 9 : 18;   // que el chip mida lo mismo que los vecinos de la barra
        var ancho = (int)Math.Round(alto * (40.0 / 70.0));
        var sb = new System.Text.StringBuilder();
        sb.Append($"<svg viewBox=\"0 0 40 70\" width=\"{ancho}\" height=\"{alto}\" aria-hidden=\"true\" class=\"rl-dig\">");
        foreach (var kv in Segmentos)
            sb.Append($"<polygon points=\"{kv.Value}\" class=\"{(on.Contains(kv.Key) ? "seg on" : "seg")}\"/>");
        sb.Append("</svg>");
        return (MarkupString)sb.ToString();
    }

    public void Dispose() => tic?.Dispose();
}
