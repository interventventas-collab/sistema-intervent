@* Panel flotante de WhatsApp: ventanita chica que se abre desde el boton verde de la topbar.
   Permite ver las conversaciones y responder sin salir de la pantalla en la que estas trabajando.
   Tiene un boton para abrirlo en una pestaña aparte (pantalla completa) y usarlo al costado.
   Vive en MainLayout, asi que funciona en cualquier pantalla del sistema.
   Pedido del usuario 2026-07-23. Reusa los mismos endpoints que la pantalla /whatsapp. *@

@using static Web.Services.ApiClient
@inject ApiClient Api
@inject ToastService ToastService
@inject OperatorService Op
@inject IJSRuntime JS
@implements IDisposable

@if (visible)
{
    <div class="waf-panel">

        @* ---------- Encabezado ---------- *@
        <div class="waf-header">
            @if (chatAbierto is null)
            {
                <span class="waf-title">💬 WhatsApp</span>
            }
            else
            {
                <button class="waf-icon-btn" @onclick="VolverALista" title="Volver a las conversaciones">←</button>
                <span class="waf-title waf-title-chat" title="@NombreDe(chatAbierto)">@NombreDe(chatAbierto)</span>
            }
            <span class="waf-spacer"></span>
            <button class="waf-icon-btn" @onclick="ToggleSonido" title="@(sonidoActivo ? "Silenciar el sonido de avisos" : "Activar el sonido de avisos")">@(sonidoActivo ? "🔔" : "🔕")</button>
            <a class="waf-icon-btn" href="/whatsapp" target="_blank" title="Abrir en una pestaña aparte">↗</a>
            <button class="waf-icon-btn" @onclick="Close" title="Cerrar">×</button>
        </div>

        @* ---------- Cuerpo ---------- *@
        <div class="waf-body">

            @if (cargando && convs.Count == 0)
            {
                <div class="waf-vacio">Cargando…</div>
            }
            else if (chatAbierto is null)
            {
                @* ----- Lista de conversaciones ----- *@
                @if (convs.Count == 0)
                {
                    <div class="waf-vacio">Todavía no hay conversaciones.</div>
                }
                else
                {
                    @foreach (var c in convs)
                    {
                        <div class="waf-conv" @onclick="() => AbrirChat(c)">
                            <div class="waf-avatar">@Inicial(c)</div>
                            <div class="waf-conv-txt">
                                <div class="waf-conv-top">
                                    <span class="waf-conv-nombre">@NombreDe(c)</span>
                                    <span class="waf-conv-hora">@Cuando(c.UltimoAt)</span>
                                </div>
                                <div class="waf-conv-ultimo">
                                    @if (c.UltimoDireccion == "OUTGOING") { <span class="waf-tick">✓</span> }
                                    @Recortar(c.UltimoMensaje, 42)
                                </div>
                            </div>
                        </div>
                    }
                }
            }
            else
            {
                @* ----- Chat abierto ----- *@
                <div class="waf-msgs" id="waf-msgs">
                    @if (msgs.Count == 0)
                    {
                        <div class="waf-vacio">Sin mensajes.</div>
                    }
                    else
                    {
                        @foreach (var m in msgs)
                        {
                            <div class="waf-msg @(m.Direccion == "OUTGOING" ? "waf-out" : "waf-in") @(menuMsgIdWaf == m.Id ? "sel" : "")"
                                 @onpointerdown="() => PressStartWaf(m.Id)" @onpointerup="PressEndWaf"
                                 @onpointerleave="PressEndWaf" @onpointercancel="PressEndWaf"
                                 @oncontextmenu:preventDefault="true">
                                @* 2026-08-12: cita del mensaje al que responde (responder citando) *@
                                @if (!string.IsNullOrWhiteSpace(m.ReplyPreview))
                                {
                                    <div class="waf-reply-quote">
                                        <span class="waf-reply-who">@(m.ReplyFromMe ? "Vos" : NombreDe(chatAbierto))</span>
                                        <span class="waf-reply-text">@m.ReplyPreview</span>
                                    </div>
                                }
                                @if (!string.IsNullOrWhiteSpace(m.Cuerpo))
                                {
                                    <div class="waf-msg-txt">@m.Cuerpo</div>
                                }
                                @if (!string.IsNullOrWhiteSpace(m.MediaUrl))
                                {
                                    @* 2026-07-23: mostrar el nombre del archivo si lo tenemos (link para abrirlo) *@
                                    <div class="waf-msg-adj"><a href="@m.MediaUrl" target="_blank" rel="noopener" style="color:inherit; text-decoration:none;">📎 @(string.IsNullOrWhiteSpace(m.MediaFilename) ? "Adjunto" : m.MediaFilename)</a></div>
                                }
                                <div class="waf-msg-hora">@m.CreatedAt.ToLocalTime().ToString("HH:mm")</div>
                                @* 2026-08-12: reacciones (chips) *@
                                @if (m.Reacciones != null && m.Reacciones.Count > 0)
                                {
                                    <div class="waf-reacciones">
                                        @foreach (var r in m.Reacciones)
                                        {
                                            <span class="waf-reaccion-chip">@r.Emoji@(r.Count > 1 ? $" {r.Count}" : "")</span>
                                        }
                                    </div>
                                }
                            </div>
                        }
                    }
                </div>
            }
        </div>

        @* ---------- Barra de envio (solo con un chat abierto) ---------- *@
        @if (chatAbierto is not null)
        {
            @if (VentanaWafAbierta())
            {
                @* 2026-08-12: barra "Respondiendo a…" (responder citando) *@
                @if (respondiendoAWaf is not null)
                {
                    <div class="waf-replybar">
                        <div class="waf-replybar-body">
                            <span class="waf-replybar-who">↩️ Respondiendo a @(respondiendoAWaf.Direccion == "OUTGOING" ? "vos" : NombreDe(chatAbierto))</span>
                            <span class="waf-replybar-text">@PreviewRespuestaWaf(respondiendoAWaf)</span>
                        </div>
                        <button type="button" class="waf-replybar-x" @onclick="CancelarResponderWaf" title="Cancelar respuesta">×</button>
                    </div>
                }
                <div class="waf-send">
                    <input class="waf-input" placeholder="Escribir mensaje…" @bind="texto" @bind:event="oninput"
                           @onkeydown="OnKeyDown" disabled="@enviando" />
                    <button class="waf-send-btn" @onclick="Enviar" disabled="@(enviando || string.IsNullOrWhiteSpace(texto))"
                            title="Enviar">
                        @(enviando ? "…" : "➤")
                    </button>
                </div>
            }
            else if (EsChatIgWaf())
            {
                <div class="waf-cerrada">
                    <div class="waf-cerrada-title">📷 Pasaron más de 24 hs</div>
                    <div class="waf-cerrada-sub">En Instagram no se puede escribir fuera de las 24 hs. Hay que esperar a que te vuelva a escribir.</div>
                </div>
            }
            else
            {
                <div class="waf-cerrada">
                    <div class="waf-cerrada-title">✍️ Pasaron más de 24 hs</div>
                    <div class="waf-cerrada-sub">WhatsApp no deja escribir texto libre. Mandale una plantilla; cuando conteste, volvés a escribirle normal.</div>
                    @if (plantillasWaf is null)
                    {
                        <div class="waf-cerrada-sub">Cargando plantillas…</div>
                    }
                    else if (plantillasWaf.Count == 0)
                    {
                        <div class="waf-cerrada-sub">No hay plantillas aprobadas disponibles.</div>
                    }
                    else
                    {
                        <select class="waf-cerrada-sel" value="@plantillaNameWaf" @onchange="OnPlantillaChangeWaf">
                            <option value="">— Elegí una plantilla —</option>
                            @foreach (var p in plantillasWaf)
                            {
                                <option value="@p.Name">@p.Name.Replace("_", " ") (@p.Category.ToLower())</option>
                            }
                        </select>
                        @if (PlantillaSelWaf() is {} psel)
                        {
                            @if (psel.VariableCount > 0)
                            {
                                @for (int i = 0; i < psel.VariableCount; i++)
                                {
                                    var idx = i;
                                    <input class="waf-cerrada-sel" style="margin-top:4px;"
                                           placeholder="@(idx == 0 ? "Nombre del cliente" : $"Dato {idx + 1}")"
                                           value="@(idx < plantillaVarsWaf.Count ? plantillaVarsWaf[idx] : "")"
                                           @oninput="e => SetPlantillaVarWaf(idx, e.Value?.ToString() ?? string.Empty)" />
                                }
                            }
                            <div class="waf-cerrada-preview">@PreviewPlantillaWaf()</div>
                            <button class="waf-cerrada-enviar" disabled="@plantillaEnviandoWaf" @onclick="EnviarPlantillaWaf">
                                @(plantillaEnviandoWaf ? "Enviando…" : "📨 Enviar plantilla")
                            </button>
                        }
                    }
                </div>
            }
        }

        @* 2026-08-12: menú que abre el TOQUE SOSTENIDO sobre un mensaje: reaccionar (emojis) + responder. *@
        @if (menuMsgIdWaf is int _mid && msgs.FirstOrDefault(x => x.Id == _mid) is {} _mm)
        {
            <div class="waf-msgmenu-backdrop" @onclick="CerrarMenuMsgWaf">
                <div class="waf-msgmenu" @onclick:stopPropagation="true">
                    <div class="waf-msgmenu-emojis">
                        @foreach (var em in QuickEmojisWaf)
                        {
                            <button type="button" class="waf-msgmenu-emoji" @onclick="() => ReaccionarWaf(_mm.Id, em)">@em</button>
                        }
                    </div>
                    @if (VentanaWafAbierta())
                    {
                        <button type="button" class="waf-msgmenu-op" @onclick="() => IniciarResponderWaf(_mm)">↩️ Responder</button>
                    }
                </div>
            </div>
        }
    </div>
}

<style>
    .waf-panel {
        position: fixed; right: 18px; bottom: 18px; z-index: 2147483000;
        width: 370px; height: 540px; max-height: calc(100vh - 90px);
        display: flex; flex-direction: column;
        background: #fff; border-radius: 14px; overflow: hidden;
        box-shadow: 0 18px 48px rgba(0,0,0,.28); border: 1px solid rgba(0,0,0,.08);
        font-size: 13px;
    }
    .waf-header {
        display: flex; align-items: center; gap: 6px;
        background: #25d366; color: #fff; padding: 9px 10px; flex: 0 0 auto;
    }
    .waf-title { font-weight: 700; font-size: 14px; }
    .waf-title-chat { max-width: 190px; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
    .waf-spacer { flex: 1 1 auto; }
    .waf-icon-btn {
        background: rgba(255,255,255,.18); border: 0; color: #fff; cursor: pointer;
        width: 26px; height: 26px; border-radius: 7px; font-size: 15px; line-height: 1;
        display: inline-flex; align-items: center; justify-content: center; text-decoration: none;
    }
    .waf-icon-btn:hover { background: rgba(255,255,255,.32); }

    .waf-body { flex: 1 1 auto; overflow-y: auto; background: #f6f7f9; }
    .waf-vacio { padding: 22px 14px; text-align: center; color: #8b93a1; }

    .waf-conv { display: flex; gap: 9px; padding: 9px 11px; cursor: pointer; border-bottom: 1px solid #eceef1; background: #fff; }
    .waf-conv:hover { background: #f0fdf4; }
    .waf-avatar {
        flex: 0 0 auto; width: 34px; height: 34px; border-radius: 50%;
        background: #25d366; color: #fff; font-weight: 700;
        display: flex; align-items: center; justify-content: center;
    }
    .waf-conv-txt { flex: 1 1 auto; min-width: 0; }
    .waf-conv-top { display: flex; justify-content: space-between; gap: 6px; }
    .waf-conv-nombre { font-weight: 600; color: #1f2937; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
    .waf-conv-hora { flex: 0 0 auto; color: #9aa1ac; font-size: 11px; }
    .waf-conv-ultimo { color: #6b7280; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
    .waf-tick { color: #25d366; margin-right: 3px; }

    .waf-msgs { padding: 10px; display: flex; flex-direction: column; gap: 7px; }
    .waf-msg { max-width: 78%; padding: 6px 9px; border-radius: 9px; box-shadow: 0 1px 1px rgba(0,0,0,.06);
        /* el toque sostenido no debe marcar texto ni abrir el menú del navegador */
        -webkit-user-select: none; user-select: none; -webkit-touch-callout: none; }
    .waf-msg.sel { outline: 2px solid #25d366; }
    .waf-in  { align-self: flex-start; background: #fff; }
    .waf-out { align-self: flex-end;   background: #dcf8c6; }
    .waf-msg-txt { white-space: pre-wrap; word-break: break-word; color: #111827; }
    .waf-msg-adj { color: #4b5563; font-style: italic; }
    .waf-msg-hora { text-align: right; color: #9aa1ac; font-size: 10px; margin-top: 2px; }
    /* Cita (responder citando) */
    .waf-reply-quote { border-left: 3px solid #25d366; background: rgba(0,0,0,.05); border-radius: 5px;
        padding: 3px 6px; margin-bottom: 3px; }
    .waf-reply-who { display: block; font-size: 10px; font-weight: 800; color: #0b7a4b; }
    .waf-reply-text { display: block; font-size: 11px; color: #4b5563;
        white-space: nowrap; overflow: hidden; text-overflow: ellipsis; max-width: 200px; }
    /* Reacciones (chips) */
    .waf-reacciones { display: flex; flex-wrap: wrap; gap: 3px; margin-top: 3px; }
    .waf-reaccion-chip { background: #fff; border: 1px solid #e5e7eb; border-radius: 999px;
        padding: 0 5px; font-size: 12px; line-height: 1.35; box-shadow: 0 1px 1px rgba(0,0,0,.08); }
    /* Barra "Respondiendo a…" */
    .waf-replybar { display: flex; align-items: center; gap: 6px; padding: 5px 9px;
        background: #eef7f0; border-top: 1px solid #d6e6db; }
    .waf-replybar-body { flex: 1; min-width: 0; display: flex; flex-direction: column; }
    .waf-replybar-who { font-size: 10.5px; font-weight: 800; color: #0b7a4b; }
    .waf-replybar-text { font-size: 11.5px; color: #4b5563;
        white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
    .waf-replybar-x { border: 0; background: transparent; color: #6b7280; font-size: 17px;
        cursor: pointer; line-height: 1; padding: 0 3px; }
    /* Menú del toque sostenido */
    .waf-msgmenu-backdrop { position: absolute; inset: 0; z-index: 60; background: rgba(0,0,0,.15);
        display: flex; align-items: flex-end; justify-content: center; }
    .waf-msgmenu { width: 100%; background: #fff; border-top-left-radius: 14px; border-top-right-radius: 14px;
        box-shadow: 0 -6px 20px rgba(0,0,0,.18); padding: 9px 10px 12px; }
    .waf-msgmenu-emojis { display: flex; justify-content: space-between; gap: 4px; margin-bottom: 7px; }
    .waf-msgmenu-emoji { flex: 1; border: 0; background: #f3f4f6; border-radius: 999px;
        padding: 7px 0; font-size: 20px; cursor: pointer; }
    .waf-msgmenu-emoji:hover { background: #e5e7eb; }
    .waf-msgmenu-op { width: 100%; border: 1px solid #d1d5db; background: #fff; border-radius: 9px;
        padding: 9px; font-size: 13px; font-weight: 700; color: #111827; cursor: pointer; }
    .waf-msgmenu-op:hover { background: #f3f4f6; }

    .waf-send { display: flex; gap: 6px; padding: 8px; background: #fff; border-top: 1px solid #eceef1; flex: 0 0 auto; }
    .waf-input { flex: 1 1 auto; border: 1px solid #d7dbe0; border-radius: 18px; padding: 7px 12px; outline: none; font-size: 13px; }
    .waf-input:focus { border-color: #25d366; }
    .waf-send-btn {
        flex: 0 0 auto; width: 34px; height: 34px; border-radius: 50%; border: 0;
        background: #25d366; color: #fff; cursor: pointer; font-size: 15px;
    }
    .waf-send-btn:disabled { background: #b9bfc7; cursor: default; }

    /* 2026-08-12: ventana de 24 hs cerrada -> aviso + selector de plantilla en vez del cuadro de escribir */
    .waf-cerrada { padding: 10px; background: #fffdf5; border-top: 1px solid #eceef1; flex: 0 0 auto; max-height: 46%; overflow-y: auto; }
    .waf-cerrada-title { font-weight: 800; color: #92400e; font-size: 13px; }
    .waf-cerrada-sub { color: #6b7280; font-size: 11.5px; line-height: 1.3; margin-top: 2px; }
    .waf-cerrada-sel { width: 100%; margin-top: 6px; padding: 7px 9px; font-size: 13px; box-sizing: border-box;
        border: 1px solid #d7dbe0; border-radius: 8px; background: #fff; color: #111827; }
    .waf-cerrada-preview { margin-top: 6px; padding: 6px 8px; background: #f3f4f6; border-radius: 8px;
        font-size: 12px; color: #374151; white-space: pre-wrap; word-break: break-word; }
    .waf-cerrada-enviar { margin-top: 7px; width: 100%; padding: 8px; border: 0; border-radius: 8px;
        background: #25d366; color: #fff; font-weight: 800; font-size: 13px; cursor: pointer; }
    .waf-cerrada-enviar:disabled { background: #b9bfc7; cursor: default; }

    @@media (max-width: 640px) {
        .waf-panel { right: 8px; left: 8px; width: auto; height: 70vh; }
    }
</style>

@code {
    private bool visible;
    private bool cargando;
    private bool enviando;
    private string texto = "";

    private List<TwConvDto> convs = new();
    private TwConvDto? chatAbierto;
    private List<TwMsgDto> msgs = new();

    // 2026-08-12: ventana de 24 hs. Fuera de esa ventana WhatsApp NO deja escribir texto libre;
    // hay que mandar una plantilla aprobada. Misma lógica que la pantalla grande, acá en el flotante.
    private bool EsChatIgWaf() => chatAbierto?.Numero?.StartsWith("ig:") ?? false;
    private DateTime? UltimoEntranteWaf() => msgs.Where(m => m.Direccion == "INCOMING").Select(m => (DateTime?)m.CreatedAt).Max();

    // ===== 2026-08-12: toque sostenido (long-press) sobre un mensaje -> reaccionar / responder =====
    private int? menuMsgIdWaf;
    private System.Threading.CancellationTokenSource? pressCtsWaf;
    private static readonly string[] QuickEmojisWaf = { "👍", "❤️", "😂", "😮", "😢", "🙏", "☕", "✅" };
    private TwMsgDto? respondiendoAWaf;

    private async Task PressStartWaf(int msgId)
    {
        pressCtsWaf?.Cancel();
        var cts = new System.Threading.CancellationTokenSource();
        pressCtsWaf = cts;
        try { await Task.Delay(500, cts.Token); }
        catch { return; }
        if (cts.IsCancellationRequested) return;
        menuMsgIdWaf = msgId;
        StateHasChanged();
    }
    private void PressEndWaf() => pressCtsWaf?.Cancel();
    private void CerrarMenuMsgWaf() { menuMsgIdWaf = null; }

    private async Task ReaccionarWaf(int msgId, string emoji)
    {
        menuMsgIdWaf = null;
        var r = await Api.ToggleReaccionAsync(msgId, emoji);
        if (r is null) { ToastService.Error("No se pudo reaccionar"); return; }
        if (r.EnviadaAlCliente) ToastService.Success($"{emoji} enviada — el cliente la ve en su WhatsApp");
        await CargarMensajes();
        StateHasChanged();
    }

    private void IniciarResponderWaf(TwMsgDto m) { respondiendoAWaf = m; menuMsgIdWaf = null; }
    private void CancelarResponderWaf() => respondiendoAWaf = null;
    private string PreviewRespuestaWaf(TwMsgDto m)
    {
        if (!string.IsNullOrWhiteSpace(m.Cuerpo)) return m.Cuerpo.Length > 60 ? m.Cuerpo.Substring(0, 60) + "…" : m.Cuerpo;
        if (!string.IsNullOrWhiteSpace(m.MediaUrl)) return "📎 Adjunto";
        return "Mensaje";
    }
    private bool VentanaWafAbierta()
    {
        if (EsChatIgWaf()) return false;
        var ult = UltimoEntranteWaf();
        return ult != null && ult.Value.AddHours(24) > DateTime.UtcNow;
    }
    private List<TwPlantillaDto>? plantillasWaf;
    private string plantillaNameWaf = "";
    private List<string> plantillaVarsWaf = new();
    private bool plantillaEnviandoWaf;
    private TwPlantillaDto? PlantillaSelWaf() => plantillasWaf?.FirstOrDefault(p => p.Name == plantillaNameWaf);
    private void OnPlantillaChangeWaf(ChangeEventArgs e)
    {
        plantillaNameWaf = e.Value?.ToString() ?? "";
        var count = PlantillaSelWaf()?.VariableCount ?? 0;
        plantillaVarsWaf = Enumerable.Range(0, count).Select(_ => "").ToList();
    }
    private void SetPlantillaVarWaf(int idx, string val)
    {
        while (plantillaVarsWaf.Count <= idx) plantillaVarsWaf.Add("");
        plantillaVarsWaf[idx] = val;
    }
    private string PreviewPlantillaWaf()
    {
        var p = PlantillaSelWaf();
        if (p == null) return "";
        return System.Text.RegularExpressions.Regex.Replace(p.BodyText, @"\{\{\s*(\d+)\s*\}\}", m =>
        {
            if (int.TryParse(m.Groups[1].Value, out var i) && i >= 1 && i <= plantillaVarsWaf.Count && !string.IsNullOrEmpty(plantillaVarsWaf[i - 1]))
                return plantillaVarsWaf[i - 1];
            return m.Value;
        });
    }
    private async Task EnviarPlantillaWaf()
    {
        var p = PlantillaSelWaf();
        if (p == null || chatAbierto is null) { ToastService.Warning("Elegí una plantilla"); return; }
        for (int i = 0; i < p.VariableCount; i++)
            if (i >= plantillaVarsWaf.Count || string.IsNullOrWhiteSpace(plantillaVarsWaf[i]))
            { ToastService.Warning("Completá todos los datos de la plantilla"); return; }
        var digits = new string(chatAbierto.Numero.Where(char.IsDigit).ToArray());
        plantillaEnviandoWaf = true; StateHasChanged();
        var (ok, err, _) = await Api.IniciarTwConversacionAsync(digits, p.Name, p.Language, chatAbierto.Linea, plantillaVarsWaf, p.BodyText);
        plantillaEnviandoWaf = false;
        if (!ok) { ToastService.Error(err ?? "No se pudo enviar la plantilla"); return; }
        ToastService.Success("Plantilla enviada ✓");
        plantillaNameWaf = ""; plantillaVarsWaf = new();
        await CargarMensajes(); await ScrollAlFinal();
    }

    private PeriodicTimer? timer;
    private CancellationTokenSource? cts;

    // 2026-08-01: el refresco corre SIEMPRE (aunque el panel esté cerrado) para poder avisar con
    // sonido cuando entra un mensaje nuevo, sin importar en qué pantalla estés.
    protected override void OnInitialized() => ArrancarRefresco();

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender && !sonidoPrefCargada)
        {
            sonidoPrefCargada = true;
            await CargarLineaSonidos();
            try
            {
                var v = await JS.InvokeAsync<string>("localStorage.getItem", "wa.sonido");
                if (v == "0") { sonidoActivo = false; StateHasChanged(); }
            }
            catch { }
        }
    }

    /// <summary>Abre/cierra el panel. Lo llama el boton de WhatsApp de la topbar.</summary>
    public async Task ToggleAsync()
    {
        visible = !visible;
        if (visible) await CargarConversaciones();
        StateHasChanged();
    }

    private void Close()
    {
        visible = false;
        chatAbierto = null;
    }

    private void VolverALista()
    {
        chatAbierto = null;
        msgs.Clear();
    }

    // ---------- Datos ----------

    private async Task CargarConversaciones()
    {
        try
        {
            cargando = true;
            convs = await Api.GetTwConversacionesAsync();
        }
        catch { /* si falla, dejamos lo que habia */ }
        finally { cargando = false; }
    }

    private async Task AbrirChat(TwConvDto c)
    {
        chatAbierto = c;
        msgs = new();
        await CargarMensajes();
        await ScrollAlFinal();
    }

    private async Task CargarMensajes()
    {
        if (chatAbierto is null) return;
        try
        {
            msgs = await Api.GetTwMensajesAsync(chatAbierto.Numero, chatAbierto.Linea ?? "null");
            // 2026-08-12: si la ventana de 24 hs está cerrada y aún no traje las plantillas, las cargo.
            if (plantillasWaf is null && !EsChatIgWaf() && !VentanaWafAbierta())
                try { plantillasWaf = await Api.GetTwPlantillasAsync(); } catch { plantillasWaf = new(); }
        }
        catch { /* silencioso: es un refresco de fondo */ }
    }

    private async Task Enviar()
    {
        if (chatAbierto is null || string.IsNullOrWhiteSpace(texto)) return;
        var cuerpo = texto.Trim();
        // 2026-08-12: en los chats que ve Depósito, firma automática con el operador del PIN (os/ger/ga).
        if (DepositoChats.EsVisible(chatAbierto.Numero, chatAbierto.Linea))
        {
            var firmaAuto = OperatorService.FirmaCorta(Op.Current);
            if (!string.IsNullOrEmpty(firmaAuto)) cuerpo = $"{cuerpo} ({firmaAuto})";
        }
        try
        {
            enviando = true;
            var replyId = respondiendoAWaf?.Id;   // 2026-08-12: si estás respondiendo citando, va el id del mensaje citado
            var (ok, error) = await Api.SendTwMensajeAsync(chatAbierto.Numero, cuerpo, chatAbierto.Linea, replyId);
            if (ok)
            {
                texto = "";
                respondiendoAWaf = null;   // limpio la cita solo si salió bien
                await CargarMensajes();
                await ScrollAlFinal();
            }
            else
            {
                ToastService.Error(error ?? "No se pudo enviar el mensaje");
            }
        }
        catch (Exception ex) { ToastService.Error("Error al enviar: " + ex.Message); }
        finally { enviando = false; }
    }

    private async Task OnKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Enter" && !e.ShiftKey) await Enviar();
    }

    // ---------- Refresco automatico (cada 10s) ----------

    private void ArrancarRefresco()
    {
        DetenerRefresco();
        cts = new CancellationTokenSource();
        timer = new PeriodicTimer(TimeSpan.FromSeconds(10));
        _ = LoopRefresco(cts.Token);
    }

    private async Task LoopRefresco(CancellationToken ct)
    {
        try
        {
            while (timer is not null && await timer.WaitForNextTickAsync(ct))
            {
                // Siempre refrescamos la lista (para el sonido de aviso + el globito), aunque esté cerrado.
                await CargarConversaciones();
                await CargarLineaSonidos();   // 2026-08-01: refrescar sonidos por línea (cambios sin recargar)
                await DetectarYSonarNuevos();
                if (visible)
                {
                    if (chatAbierto is not null) await CargarMensajes();
                }
                await InvokeAsync(StateHasChanged);
            }
        }
        catch (OperationCanceledException) { /* normal al cerrar */ }
    }

    private void DetenerRefresco()
    {
        try { cts?.Cancel(); } catch { }
        timer?.Dispose();
        timer = null;
        cts?.Dispose();
        cts = null;
    }

    // ---------- Sonido de aviso (2026-08-01) ----------
    private bool sonidoActivo = true;
    private bool sonidoPrefCargada;
    private Dictionary<string, string?> lineaSonidos = new();      // LineaId -> clave de sonido
    private Dictionary<string, DateTime> ultimoInPorLinea = new();  // LineaId -> último entrante visto
    private bool sonidoSeedeado;

    private async Task CargarLineaSonidos()
    {
        try
        {
            var list = await Api.GetTwLineaSonidosAsync();
            lineaSonidos = list.ToDictionary(x => x.LineaId, x => x.Sonido);
        }
        catch { }
    }

    // Detecta mensajes ENTRANTES nuevos por línea y suena el sonido elegido de ESA línea.
    // El silencio maestro (localStorage wa.sonido) lo respeta waPlaySound en el JS.
    private async Task DetectarYSonarNuevos()
    {
        var porLinea = convs.Where(c => c.UltimoDireccion == "INCOMING")
            .GroupBy(c => c.Linea ?? "∅")
            .ToDictionary(g => g.Key, g => g.Max(x => x.UltimoAt));
        if (!sonidoSeedeado) { ultimoInPorLinea = porLinea; sonidoSeedeado = true; return; } // 1ra vuelta: no suena
        foreach (var kv in porLinea)
        {
            var esNuevo = !ultimoInPorLinea.TryGetValue(kv.Key, out var prev) || kv.Value > prev;
            ultimoInPorLinea[kv.Key] = kv.Value;
            if (esNuevo)
            {
                var sonido = (kv.Key != "∅" && lineaSonidos.TryGetValue(kv.Key, out var s) && !string.IsNullOrEmpty(s)) ? s! : "chime";
                try { await JS.InvokeVoidAsync("waPlaySound", sonido); } catch { }
            }
        }
    }

    private async Task ToggleSonido()
    {
        sonidoActivo = !sonidoActivo;
        try { await JS.InvokeVoidAsync("localStorage.setItem", "wa.sonido", sonidoActivo ? "1" : "0"); } catch { }
        if (sonidoActivo) { try { await JS.InvokeVoidAsync("waNotifSound"); } catch { } } // feedback al prender
        StateHasChanged();
    }

    // ---------- Helpers de presentacion ----------

    private async Task ScrollAlFinal()
    {
        try { await JS.InvokeVoidAsync("eval", "setTimeout(function(){var e=document.getElementById('waf-msgs'); if(e){e.scrollTop=e.scrollHeight;}},60)"); }
        catch { }
    }

    private static string NombreDe(TwConvDto c)
        => !string.IsNullOrWhiteSpace(c.ClienteNombre) ? c.ClienteNombre!
         : !string.IsNullOrWhiteSpace(c.NombrePerfil) ? c.NombrePerfil!
         : c.Numero.Replace("whatsapp:", "");

    private static string Inicial(TwConvDto c)
    {
        var n = NombreDe(c).Trim();
        return string.IsNullOrEmpty(n) ? "?" : n.Substring(0, 1).ToUpperInvariant();
    }

    private static string Recortar(string? s, int max)
    {
        if (string.IsNullOrWhiteSpace(s)) return "";
        s = s.Replace("\n", " ");
        return s.Length <= max ? s : s.Substring(0, max) + "…";
    }

    private static string Cuando(DateTime utc)
    {
        var l = utc.ToLocalTime();
        var hoy = DateTime.Now.Date;
        if (l.Date == hoy) return l.ToString("HH:mm");
        if (l.Date == hoy.AddDays(-1)) return "Ayer";
        return l.ToString("dd/MM");
    }

    public void Dispose() => DetenerRefresco();
}
