                            @foreach (var m in fi.Mensajes)
                            {
                                <p><b>@(m.De == "comprador" ? "Comprador" : "Nosotros"):</b> @m.Texto <span class="sub-i">@(m.Fecha is DateTime fm ? Dia(fm) + " " + fm.ToString("HH:mm") : "")</span></p>
                            }
                            <h4>Notas de la venta (@fi.Notas.Count)</h4>
