                                <p>@n.Texto</p>
                            }
                            <a class="dp-det-l" href="@($"/deposito/ordenes-meli?orden={o.Numero}")">Abrir la ficha completa →</a>
                        }
                    </div>
                }
            }
        </div>
    </div>
}

