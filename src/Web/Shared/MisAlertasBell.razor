@inject ApiClient Api
@inject NavigationManager Navigation
@inject IJSRuntime JS
@inject MenuNuevoService Svc
@implements IDisposable

@* 2026-07-10 — Campanita del motor de alertas configurables ("Mis Alertas").
   - Solo aparece cuando hay al menos una alerta disparada.
   - Hover (mouse encima) → despliega el detalle y las marca como vistas (baja el contador).
   - Click → te lleva a /mis-alertas.
   Refresca cada 30 seg. *@

@if (disparadas.Count > 0)
{
    <div class="mab-wrap"
         @onmouseenter="OnHover"
         @onmouseleave="OnLeave"
         @onclick="@(() => Navigation.NavigateTo("/mis-alertas"))">
        <div class="mab-badge @(noVistas > 0 ? "mab-badge-blink" : "")" title="Tenés alertas — click para ver Mis Alertas">
            <span class="mab-icon">🔔</span>
            <span class="mab-txt">Alertas</span>
            @if (noVistas > 0)
            {
                <span class="mab-num">@noVistas</span>
            }
        </div>

        @if (showDropdown)
        {
            <div class="mab-dropdown" @onclick:stopPropagation="true" @onclick="@(() => Navigation.NavigateTo("/mis-alertas"))">
                <div class="mab-dd-header">
                    <span>🔔 Alertas activas</span>
                    <span class="mab-dd-count">@disparadas.Count</span>
                </div>
                <div class="mab-dd-list">
                    @foreach (var a in disparadas)
                    {
                        <div class="mab-dd-row" @onclick:stopPropagation="true"
                             @onclick="@(() => Navigation.NavigateTo(Ruta(a)))"
                             title="Ir a resolver este aviso">
                            <span class="mab-dd-emoji">@Emoji(a.Tipo)</span>
                            <div class="mab-dd-mid">
                                <div class="mab-dd-msg">@a.Mensaje</div>
                                @if (!string.IsNullOrWhiteSpace(a.Detalle))
                                {
                                    <div class="mab-dd-sub">@a.Detalle</div>
                                }
                                @if (Lugar(a.Tipo) is string lugar)
                                {
                                    <div class="mab-dd-lugar">→ @lugar</div>
                                }
                            </div>
                        </div>
                    }
                </div>
                <div class="mab-dd-footer">
                    <span class="mab-dd-link">Ver Mis Alertas →</span>
                </div>
            </div>
        }
    </div>
}

<style>
    .mab-wrap { position: relative; display: inline-block; }
    .mab-badge {
        display: inline-flex; align-items: center; gap: 0.3rem;
        padding: 0.35rem 0.7rem;
        background: #FAEEDA; color: #633806;
        border: 1px solid #EF9F27;
        border-radius: 999px;
        font-weight: 700; font-size: 0.85rem;
        cursor: pointer; margin: 0 0.3rem;
        transition: transform 0.15s;
    }
    .mab-badge:hover { transform: scale(1.06); }
    /* Titila mientras haya alertas sin ver */
    .mab-badge-blink { animation: mab-blink 1s ease-in-out infinite; }
    @@keyframes mab-blink {
        0%, 100% { background: #FAEEDA; box-shadow: 0 0 0 0 rgba(239,159,39,0.5); }
        50%      { background: #FAC775; box-shadow: 0 0 0 6px rgba(239,159,39,0); }
    }
    .mab-icon { font-size: 1rem; }
    .mab-num {
        background: #BA7517; color: white;
        font-size: 0.72rem; padding: 1px 6px;
        border-radius: 6px; margin-left: 2px; font-weight: 800;
    }
    .mab-dropdown {
        position: absolute; top: calc(100% + 6px); right: 0;
        background: white; border: 1px solid #d1d5db; border-radius: 10px;
        box-shadow: 0 6px 24px rgba(0,0,0,0.12);
        width: 380px; max-width: 92vw; z-index: 9500;
        cursor: pointer; overflow: hidden;
    }
    .mab-dd-header {
        padding: 10px 14px 8px;
        border-bottom: 1px solid #f3f4f6;
        display: flex; align-items: center; justify-content: space-between;
        font-size: 0.83rem; font-weight: 700; color: #111827;
    }
    .mab-dd-count { font-size: 0.7rem; color: #6b7280; font-weight: 600; }
    .mab-dd-list { padding: 6px 8px; display: flex; flex-direction: column; gap: 4px; }
    .mab-dd-row {
        display: flex; align-items: center; gap: 10px;
        padding: 8px 8px; border-radius: 8px; background: #FFFBF3;
    }
    .mab-dd-emoji { font-size: 1.2rem; width: 24px; text-align: center; }
    .mab-dd-mid { flex: 1; min-width: 0; }
    .mab-dd-msg { font-size: 0.85rem; font-weight: 600; color: #111827; }
    .mab-dd-sub { font-size: 0.72rem; color: #6b7280; }
    .mab-dd-lugar { font-size: 0.68rem; color: #9ca3af; }
    .mab-dd-footer {
        padding: 8px 14px;
        border-top: 1px solid #f3f4f6;
        display: flex; align-items: center; justify-content: flex-end;
        font-size: 0.78rem;
    }
    .mab-dd-link { color: #BA7517; font-weight: 700; }
</style>

@code {
    private List<ApiClient.AlertaDisparadaDto> disparadas = new();
    private int noVistas;
    private int? prevNoVistas;
    private HashSet<int>? gastosVistos;   // para detectar alertas nuevas y sonar solo entonces
    private bool showDropdown;
    private System.Threading.Timer? timer;

    protected override async Task OnInitializedAsync()
    {
        await Refresh();
        timer = new System.Threading.Timer(async _ => await InvokeAsync(Refresh), null, 30_000, 30_000);
    }

    private async Task Refresh()
    {
        try
        {
            var r = await Api.GetAlertasDisparadasAsync();
            disparadas = r?.Disparadas ?? new();
            noVistas = r?.NoVistas ?? 0;
            PonerNumeritos(r?.Numeritos);

            // 18/11/2026: #gasto por WhatsApp nuevo → ruidito de caja registradora (se apaga en
            // Compras → Gastos por WhatsApp; queda guardado en esta compu/celu).
            var gastosAhora = disparadas.Where(a => a.Tipo == "GASTO_WA").Select(a => a.Id).ToHashSet();
            var gastoNuevo = gastosVistos is not null && gastosAhora.Any(id => !gastosVistos.Contains(id));
            gastosVistos = gastosAhora;

            // Suena solo cuando ENTRA una alerta nueva (el contador sin ver subió).
            // En la primera carga fijamos la línea de base sin sonar.
            if (gastoNuevo)
            {
                try
                {
                    if (await JS.InvokeAsync<string?>("localStorage.getItem", "gasto.sonido") != "0")
                        await JS.InvokeVoidAsync("playCajaSound");
                    else
                        await JS.InvokeVoidAsync("playAlertaSound");
                }
                catch { }
            }
            else if (prevNoVistas.HasValue && noVistas > prevNoVistas.Value)
            {
                try { await JS.InvokeVoidAsync("playAlertaSound"); } catch { }
            }
            prevNoVistas = noVistas;

            StateHasChanged();
        }
        catch { /* no critico */ }
    }

    // 19/11/2026: el mismo aviso también va como numerito rojo en el botón de la tarjeta donde se resuelve
    // (Facturas recibidas, Extracto banco, ¿A quién le debo?, Impuestos y VEP). Solo estas claves: las demás
    // (Ventas, Preparación, Gastos por WhatsApp…) las llenan otros.
    private static readonly string[] RutasNumeritos =
        { "/compras/facturas-recibidas", "/cafe/tesoreria/extracto-banco", "/cafe/proveedores-ctacte", "/impuestos" };
    private void PonerNumeritos(Dictionary<string, int>? n)
    {
        if (n is null) return;
        var cambio = false;
        foreach (var k in RutasNumeritos)
        {
            var v = n.TryGetValue(k, out var x) ? x : 0;
            if ((Svc.Numeros.TryGetValue(k, out var antes) ? antes : 0) == v) continue;
            if (v > 0) Svc.Numeros[k] = v; else Svc.Numeros.Remove(k);
            cambio = true;
        }
        if (cambio) Svc.AvisarNumeros();
    }

    private async Task OnHover()
    {
        showDropdown = true;
        // Al abrir el detalle, las damos por vistas (baja el contador).
        if (noVistas > 0)
        {
            try { await Api.MarcarAlertasVistasAsync(); } catch { }
            noVistas = 0;
            prevNoVistas = 0;
            StateHasChanged();
        }
    }

    private void OnLeave() { showDropdown = false; }

    private static string Emoji(string tipo) => tipo switch
    {
        "SHELL_BAJO" => "⛽",
        "BANCO_BAJO" => "🏦",
        "CHEQUE_VENCE" => "📄",
        "FECHA_MES" => "📅",
        "EMAIL_REMITENTE" => "📧",
        "VENTA_MELI" => "🛒",
        "FICHADA" => "🕐",
        "PUBLI_MELI" => "⚠️",
        "ALTA_CLIENTE" => "🆕",
        "ENVIO_RECHAZADO" => "🚫",
        "UBICACION_ERRONEA" => "📍",
        "PAGO_WHATSAPP" => "💵",
        "PAGO_PROGRAMADO" => "💲",
        "PAGO_PROG_ATRASADO" => "🔴",
        "FACTURAS_NUEVAS" => "🧾",
        "VEP_VENCE" => "🏛",
        "VEP_VENCIDO" => "🔴",
        "GASTO_WA" => "💸",
        "TRANSF_SIN_REG" => "🏦",
        "SHELL_CARGA" => "⛽",
        "SHELL_CARGA_RARA" => "⛽",
        _ => "🔔"
    };

    // A dónde te lleva tocar un aviso puntual de la campanita (por defecto, la pantalla de Mis Alertas).
    // 17/11/2026: pago a proveedor programado (Id = -IdProgramado) → abre la ventana "Transferir a ...".
    private static string Ruta(ApiClient.AlertaDisparadaDto a)
        => a.Tipo.StartsWith("PAGO_PROG") ? $"/cafe/proveedores-ctacte?transferir={-a.Id}"
         : a.Tipo is "FACTURAS_NUEVAS" or "TRANSF_SIN_REG" ? "/compras/facturas-recibidas"
         : a.Tipo.StartsWith("VEP_") ? "/impuestos"
         : a.Tipo == "GASTO_WA" ? $"/cafe/tesoreria/pagos?gasto={-4000000 - a.Id}"
         : a.Tipo.StartsWith("SHELL_CARGA") ? "/combustible"
         : RutaPorTipo(a.Tipo);

    // 19/11/2026: en qué botón de las tarjetas está ese aviso (ahí también sale el numerito rojo).
    private static string? Lugar(string tipo)
        => tipo.StartsWith("PAGO_PROG") ? "Compras › ¿A quién le debo?"
         : tipo is "FACTURAS_NUEVAS" or "TRANSF_SIN_REG" ? "Compras › Facturas recibidas"
         : tipo.StartsWith("VEP_") ? "Impuestos › Impuestos y VEP"
         : tipo == "GASTO_WA" ? "Compras › Gastos por WhatsApp"
         : tipo.StartsWith("SHELL_CARGA") ? "Logística › Combustible"
         : null;

    private static string RutaPorTipo(string tipo) => tipo switch
    {
        "PAGO_WHATSAPP" => "/tesoreria/pagos-pendientes",
        _ => "/mis-alertas"
    };

    public void Dispose() => timer?.Dispose();
}
