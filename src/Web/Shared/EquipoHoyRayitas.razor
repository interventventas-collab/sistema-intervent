@using Web.Services
@inject ApiClient Api
@inject IJSRuntime JS
@inject NavigationManager Nav
@* 2026-11-10 (2ª): "Equipo hoy" pasó de rayitas a una TABLA simple (el dueño: "no se entiende nada").
   Una fila por persona, en palabras: quién · estado · entregas de hoy con barrita · última entrega ·
   aviso. Tocando la fila se abre el detalle de siempre. El nombre del archivo quedó por historia. *@
<style>
    .eqt { width:100%; border-collapse:collapse; margin-top:0.4rem; }
    .eqt th { font-size:0.68rem; text-transform:uppercase; letter-spacing:0.05em; color:#6b7280; text-align:left; font-weight:600; padding:0.35rem 0.5rem; border-bottom:1px solid #e5e7eb; }
    .eqt td { padding:0.5rem; border-bottom:1px solid #f1f2f4; vertical-align:middle; font-size:0.86rem; color:#111827; }
    .eqt tr.fila { cursor:pointer; }
    .eqt tr.fila:hover td { background:#f9fafb; }
    .eqt-who { display:flex; align-items:center; gap:0.55rem; font-weight:700; }
    .eqt-av { width:30px; height:30px; border-radius:50%; display:grid; place-items:center; color:#fff; font-size:0.68rem; font-weight:700; flex-shrink:0; }
    .eqt-st { display:inline-block; border-radius:999px; padding:0.1rem 0.6rem; font-size:0.76rem; font-weight:600; white-space:nowrap; }
    .eqt-st.on { background:#dcfce7; color:#166534; }
    .eqt-st.fue { background:#f1f5f9; color:#475569; }
    .eqt-st.sf { background:#ffedd5; color:#9a3412; }
    .eqt-st.no { background:#f3f4f6; color:#9ca3af; }
    .eqt-muted { color:#6b7280; font-size:0.8rem; }
    .eqt-bar { display:flex; align-items:center; gap:0.5rem; white-space:nowrap; }
    .eqt-bar b { font-size:0.95rem; }
    .eqt-track { width:120px; height:8px; background:#e5e7eb; border-radius:4px; overflow:hidden; flex-shrink:0; }
    .eqt-fill { display:block; height:100%; background:#22c55e; }
    .eqt-warn { color:#b45309; font-weight:700; white-space:nowrap; }
    .eqt-ok { color:#166534; white-space:nowrap; }
    .eqt-paga { white-space:nowrap; }
    .eqt-paga b { font-size:0.95rem; }
    .eqt-paga.atr b { color:#b91c1c; }
    .eqt-paga a { margin-left:0.4rem; border:1px solid #d1d5db; border-radius:6px; padding:1px 8px; font-size:0.76rem; color:#111827; text-decoration:none; background:#fff; }
    .eqt-paga a:hover { background:#f9fafb; }
    .eqt-tot { font-size:0.86rem; margin:0.3rem 0 0.1rem; }
    .eqt-tot b { color:#111827; }
    .eqt tr.fila.abierta td { background:#f9fafb; border-bottom:none; }
    .eqt-chev { color:#9ca3af; font-size:0.7rem; width:10px; }
    .eqt-um { max-width:420px; overflow:hidden; text-overflow:ellipsis; white-space:nowrap; font-size:0.82rem; }
    .eqt-um-cuando { font-weight:600; color:#111827; }
    .eqt tr.eqf-row > td { background:#f9fafb; padding:0 0.5rem 1rem 2.6rem; border-bottom:1px solid #e5e7eb; }
    @@media (max-width: 900px) { .eqt .col-ult { display:none; } .eqt-track { width:70px; } }
</style>
@{ var totPagar = Items.Sum(x => x.PagarHoy); var hayPagar = totPagar > 0; }
@if (hayPagar)
{
    <div class="eqt-tot">💵 Hoy hay que pagar <b>$@totPagar.ToString("N0", Es)</b>
        <span class="eqt-muted">· feriados, horas extra, comisiones, plus o aguinaldo con fecha de pago hoy@(Items.Any(x => x.PagarHoyAtrasado) ? " o atrasados" : "")</span></div>
}
<table class="eqt">
    <tr><th>Quién</th><th>Estado</th><th class="col-ult">Último movimiento en el sistema</th><th>Entregas de hoy</th>@if (hayPagar) {<th>Hoy se le paga</th>}<th>Aviso</th></tr>
    @foreach (var e in Items)
    {
        var emp = e;
        var tipo = Tipo(e);
        var total = e.RutaEntregadas + e.RutaFaltan + e.RutaNoEntregadas;
        var quieto = e.MinutosSinMarcar >= UmbralQuietoMin && e.RutaFaltan > 0;
        var termino = total > 0 && e.RutaFaltan == 0;
        var abierto = abiertoId == e.NomEmpleadoId;
        <tr class="fila @(abierto ? "abierta" : "")" @onclick="() => Toggle(emp)" title="@(abierto ? "Tocá para cerrar" : "Tocá para ver todo de esta persona")">
            <td>
                <div class="eqt-who">
                    <span class="eqt-chev">@(abierto ? "▾" : "▸")</span>
                    <span class="eqt-av" style="background:@OperatorService.ShortBgColor(e.ApodoKiosko ?? e.Nombre);">@OperatorService.ShortLabel(e.ApodoKiosko ?? e.Nombre)</span>
                    @ShortName(e.Nombre)
                </div>
            </td>
            <td>
                @if (e.Estado == "trabajando")
                {
                    <span class="eqt-st on">trabajando</span> <span class="eqt-muted">· desde @e.HoraEntrada</span>
                }
                else if (e.Estado == "salio")
                {
                    <span class="eqt-st fue">se fue @e.HoraSalida</span> <span class="eqt-muted">· entró @e.HoraEntrada</span>
                }
                else if (tipo == "repartiendo")
                {
                    <span class="eqt-st sf">repartiendo sin fichar</span>
                }
                else
                {
                    <span class="eqt-st no">@(e.Estado == "no_ficha" ? "no ficha" : "no vino")</span>
                }
            </td>
            <td class="col-ult">
                @if (ultimos.TryGetValue(e.NomEmpleadoId, out var um))
                {
                    var reciente = (DateTime.UtcNow - um.CuandoUtc).TotalHours < 12;
                    <div class="eqt-um" title="@um.Texto">
                        <span class="@(reciente ? "eqt-um-cuando" : "eqt-muted")">@Hace(um.CuandoUtc)</span>
                        <span class="eqt-muted"> · @um.Texto</span>
                    </div>
                }
                else if (ultimosCargados)
                {
                    <span class="eqt-muted">nada en los últimos 7 días</span>
                }
            </td>
            <td>
                @if (total > 0)
                {
                    var pct = (100.0 * e.RutaEntregadas / total).ToString("0.#", System.Globalization.CultureInfo.InvariantCulture);
                    <div class="eqt-bar"><b>@e.RutaEntregadas de @total</b><span class="eqt-track"><span class="eqt-fill" style="width:@pct%;"></span></span></div>
                    @if (e.MinutosSinMarcar >= 0 && !string.IsNullOrWhiteSpace(e.UltimoDomicilio))
                    {
                        <div class="eqt-muted" style="max-width:240px; overflow:hidden; text-overflow:ellipsis; white-space:nowrap;" title="@e.UltimoDomicilio">última hace @Minutos(e.MinutosSinMarcar) · @e.UltimoDomicilio</div>
                    }
                }
                else if (!e.TieneRepartidor)
                {
                    <span class="eqt-muted">no reparte</span>
                }
                else
                {
                    <span class="eqt-muted">sin entregas hoy</span>
                }
            </td>
            @if (hayPagar)
            {
                <td @onclick:stopPropagation="true">
                    @if (e.PagarHoy > 0)
                    {
                        <span class="eqt-paga @(e.PagarHoyAtrasado ? "atr" : "")">
                            <b>$@e.PagarHoy.ToString("N0", Es)</b> <span class="eqt-muted">@e.PagarHoyDetalle</span>
                            <a href="/nominas/extras/@e.PagarHoyTipo?anio=@e.PagarHoyAnio&mes=@e.PagarHoyMes" title="Ir a pagarlo">Pagar</a>
                        </span>
                    }
                    else
                    {
                        <span class="eqt-muted">—</span>
                    }
                </td>
            }
            <td>
                @if (quieto)
                {
                    <span class="eqt-warn">⚠ @Minutos(e.MinutosSinMarcar) quieto</span>
                }
                else if (termino)
                {
                    <span class="eqt-ok">✅ terminó</span>
                }
            </td>
        </tr>
        @if (abierto)
        {
            <tr class="eqf-row"><td colspan="@(hayPagar ? 6 : 5)">
                <EquipoFichaEmpleado Ficha="ficha" Cargando="fichaCargando" Item="emp"
                                     OnCambiarDia="CambiarDia" OnVerReparto="() => OnClickEmp.InvokeAsync(emp)" />
            </td></tr>
        }
    }
</table>

@code {
    [Parameter] public List<ApiClient.DashboardEquipoItem> Items { get; set; } = new();
    [Parameter] public Dictionary<int, List<string>> Horas { get; set; } = new();
    [Parameter] public EventCallback<ApiClient.DashboardEquipoItem> OnClickEmp { get; set; }

    private static readonly System.Globalization.CultureInfo Es = new("es-AR");

    // 2026-11-13: último movimiento de cada uno + ficha desplegable (una a la vez).
    private Dictionary<int, ApiClient.EquipoUltimoDto> ultimos = new();
    private bool ultimosCargados;
    private DateTime ultimosAt = DateTime.MinValue;
    private int? abiertoId;
    private ApiClient.EquipoFichaDto? ficha;
    private bool fichaCargando;

    protected override async Task OnParametersSetAsync()
    {
        // El tablero refresca "Equipo hoy" solo; esto acompaña como mucho una vez por minuto.
        if ((DateTime.UtcNow - ultimosAt).TotalSeconds < 60) return;
        ultimosAt = DateTime.UtcNow;
        try
        {
            var l = await Api.GetEquipoUltimosAsync();
            if (l is not null) { ultimos = l.ToDictionary(x => x.EmpId); ultimosCargados = true; }
        }
        catch { /* si falla, la columna queda vacía */ }
        if (abiertoId is int id && ficha?.Dia.Date == DateTimeExt.AhoraAr().Date) await CargarFicha(id, null);
    }

    private async Task Toggle(ApiClient.DashboardEquipoItem e)
    {
        if (abiertoId == e.NomEmpleadoId) { abiertoId = null; ficha = null; return; }
        abiertoId = e.NomEmpleadoId;
        ficha = null;
        await CargarFicha(e.NomEmpleadoId, null);
    }

    private async Task CambiarDia(DateTime dia)
    {
        if (abiertoId is int id) await CargarFicha(id, dia);
    }

    private async Task CargarFicha(int id, DateTime? dia)
    {
        fichaCargando = true;
        StateHasChanged();
        try
        {
            var f = await Api.GetEquipoFichaAsync(id, dia);
            if (abiertoId == id) ficha = f;
        }
        catch { }
        finally { fichaCargando = false; }
    }

    private static string Hace(DateTime utc)
    {
        var min = (int)Math.Max(0, (DateTime.UtcNow - utc).TotalMinutes);
        if (min < 1) return "recién";
        if (min < 60) return $"hace {min} min";
        var ar = utc.ToArTime();
        var hoy = DateTimeExt.AhoraAr().Date;
        if (ar.Date == hoy) return min < 180 ? $"hace {min / 60} h {min % 60} min" : $"hoy {ar:HH:mm}";
        if (ar.Date == hoy.AddDays(-1)) return $"ayer {ar:HH:mm}";
        return ar.ToString("dd/MM HH:mm");
    }

    // El mismo umbral que el aviso "Hace X min que no marca nada" del Dashboard de siempre.
    public const int UmbralQuietoMin = 45;
    private const double Desde = 7 * 60, Hasta = 20 * 60;

    // Hora ARGENTINA de ahora, en minutos desde las 00:00 (nunca DateTime.Now).
    private double AhoraMin => DateTimeExt.AhoraAr().TimeOfDay.TotalMinutes;

    /// <summary>Lo que se ve de cada persona: fichado (verde), repartiendo sin fichar (naranja) o nada (gris).</summary>
    public static string Tipo(ApiClient.DashboardEquipoItem e)
    {
        if (e.Estado is "trabajando" or "salio") return "fichado";
        var total = e.RutaEntregadas + e.RutaFaltan + e.RutaNoEntregadas;
        if (e.TieneRepartidor && (total > 0 || e.VentasEntregadasHoy > 0 || e.AlqEntregadosHoy > 0 || e.AlqRetiradosHoy > 0))
            return "repartiendo";
        return "nada";
    }

    private static string Pct(double minutos, bool posicion = true)
    {
        double v = posicion
            ? (Math.Clamp(minutos, Desde, Hasta) - Desde) / (Hasta - Desde) * 100
            : Math.Clamp(minutos / (Hasta - Desde) * 100, 0, 100);
        return v.ToString("0.##", System.Globalization.CultureInfo.InvariantCulture) + "%";
    }

    private static double? Min(string? hhmm)
        => TimeSpan.TryParse(hhmm, out var t) ? t.TotalMinutes : null;

    private (double, double)? Fichado(ApiClient.DashboardEquipoItem e)
    {
        if (e.Estado is not ("trabajando" or "salio")) return null;
        var ini = Min(e.HoraEntrada);
        if (ini is null) return null;
        var fin = e.Estado == "salio" ? (Min(e.HoraSalida) ?? AhoraMin) : AhoraMin;
        var a = Math.Clamp(ini.Value, Desde, Hasta);
        var b = Math.Clamp(fin, Desde, Hasta);
        return (a, b);
    }

    private List<double> HorasDe(ApiClient.DashboardEquipoItem e)
        => Horas.TryGetValue(e.NomEmpleadoId, out var l)
            ? l.Select(Min).Where(x => x.HasValue).Select(x => x!.Value).OrderBy(x => x).ToList()
            : new List<double>();

    /// <summary>Las que faltan: repartidas a la derecha de "ahora", cada ~25 min (o más juntas si no entran).</summary>
    private List<double> Pendientes(int n)
    {
        var res = new List<double>();
        if (n <= 0) return res;
        n = Math.Min(n, 15);
        var ahora = Math.Max(AhoraMin, Desde);
        var lugar = Math.Max(0, Hasta - ahora);
        var paso = Math.Min(25.0, lugar / (n + 1));
        if (paso < 4) paso = 4;
        for (var i = 1; i <= n; i++) res.Add(Math.Min(Hasta - 2, ahora + paso * i));
        return res;
    }

    private static string Duracion(string? trabajado)
    {
        // Viene como "8h 15m" → "8 h 15"
        if (string.IsNullOrWhiteSpace(trabajado)) return "";
        var t = trabajado.Replace("h ", " h ").Replace("m", "").Trim();
        return t;
    }

    private static string SubTexto(ApiClient.DashboardEquipoItem e, string tipo)
    {
        if (e.Estado == "trabajando")
            return $"desde {e.HoraEntrada}" + (string.IsNullOrWhiteSpace(e.Trabajado) ? "" : $" · {Duracion(e.Trabajado)}");
        if (e.Estado == "salio")
            return $"{e.HoraEntrada} a {e.HoraSalida}" + (string.IsNullOrWhiteSpace(e.Trabajado) ? "" : $" · {Duracion(e.Trabajado)}");
        return e.Estado == "no_ficha" && tipo != "repartiendo" ? "no ficha" : "sin fichar";
    }

    private static string EstadoLargo(ApiClient.DashboardEquipoItem e, string tipo) => tipo switch
    {
        "fichado" => e.Estado == "salio" ? $"ya se fue · {e.HoraEntrada} a {e.HoraSalida}" : $"trabajando desde {e.HoraEntrada}",
        "repartiendo" => "repartiendo sin fichar",
        _ => e.Estado == "no_ficha" ? "no ficha" : "sin fichar hoy",
    };

    private static string Minutos(int m) => m >= 120 ? $"{m / 60} h {m % 60} min" : $"{m} min";

    private static string ShortName(string nombre)
    {
        if (string.IsNullOrWhiteSpace(nombre)) return "";
        var first = nombre.Trim().Split(' ', 2)[0];
        return char.ToUpper(first[0]) + first.Substring(1).ToLower();
    }
}
