@inject NavigationManager Navigation

@* 2026-10-02: botón "📷 Fotos" del Dashboard y de Preparación (ahí arrancan los de depósito). En la compu
   abre el QR para seguir en el celu la pantalla de fotos con fondo verde/azul (/cafe/fotos-chroma);
   en el celu el QR no sirve y queda sólo "Abrir acá". *@

<span class="fqr-wrap">
    <button class="@Clase" @onclick="() => abierto = !abierto">📷 Fotos</button>
    @if (abierto)
    {
        <div class="fqr-back" @onclick="() => abierto = false"></div>
        <div class="fqr-box" style="@(AbrirHaciaDerecha ? "left:0; right:auto;" : "")">
            <div class="fqr-tit">📷 Fotos de productos con fondo verde o azul</div>
            <img class="fqr-qr" src="@($"https://api.qrserver.com/v1/create-qr-code/?size=220x220&data={Uri.EscapeDataString(Url)}")" alt="QR" />
            <div class="fqr-txt fqr-qr">Escanealo con la cámara del celu. La primera vez te pide entrar con tu usuario.</div>
            <div class="fqr-txt fqr-qr">O escribí en el celu: <b>@Url.Replace("https://", "")</b></div>
            <div class="fqr-acc">
                <button class="fqr-ir" @onclick="Abrir">Abrir acá</button>
                <button class="fqr-cerrar" @onclick="() => abierto = false">Cerrar</button>
            </div>
        </div>
    }
</span>

<style>
    .fqr-wrap { position: relative; display: inline-block; }
    .fqr-btn { background: #111827; color: #fff; border: none; border-radius: 8px; padding: 0.5rem 1rem;
        font-size: 0.95rem; font-weight: 600; cursor: pointer; }
    .fqr-back { position: fixed; inset: 0; z-index: 900; }
    .fqr-box { position: absolute; right: 0; top: calc(100% + 6px); z-index: 901; width: 280px; background: #fff;
        border: 1px solid #e5e7eb; border-radius: 10px; box-shadow: 0 10px 28px rgba(0,0,0,0.15); padding: 0.9rem; text-align: center; }
    .fqr-tit { font-weight: 700; font-size: 0.92rem; margin-bottom: 0.5rem; color: #111827; }
    .fqr-box img { width: 200px; height: 200px; display: block; margin: 0 auto 0.5rem; }
    .fqr-txt { font-size: 0.8rem; color: #6b7280; margin-top: 0.25rem; }
    .fqr-acc { display: flex; gap: 0.5rem; margin-top: 0.7rem; }
    .fqr-acc button { flex: 1; padding: 0.5rem; border-radius: 8px; border: 1px solid #d1d5db; background: #fff; cursor: pointer; font-size: 0.9rem; }
    .fqr-acc .fqr-ir { background: #111827; color: #fff; border-color: #111827; }
    /* En el celu el QR no sirve (ya estás en el celu): queda sólo "Abrir acá". */
    @@media (max-width: 700px) { .fqr-box .fqr-qr { display: none; } .fqr-box { left: auto; right: 0; width: 220px; } }
</style>

@code {
    /// <summary>Clase del botón: por defecto oscuro; en Preparación va como los botones de al lado.</summary>
    [Parameter] public string Clase { get; set; } = "fqr-btn";
    /// <summary>Para qué lado se abre el cartel del QR ("derecha" = alineado a la izquierda del botón).</summary>
    [Parameter] public bool AbrirHaciaDerecha { get; set; }

    private bool abierto;
    private string Url => Navigation.BaseUri.TrimEnd('/') + "/cafe/fotos-chroma";
    private void Abrir() { abierto = false; Navigation.NavigateTo("/cafe/fotos-chroma"); }
}
