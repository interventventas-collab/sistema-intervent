    private static string MapsUrl(MeliMe1ShipmentDto s)
    {
        var partes = new[] { s.AddressLine, s.City, s.State, "Argentina" }.Where(x => !string.IsNullOrWhiteSpace(x));
        return $"https://www.google.com/maps/search/?api=1&query={Uri.EscapeDataString(string.Join(", ", partes))}";
    }

    private string RetiroTxt(AlqReservaDto r)
    {
        var d = r.FechaRetiro.Date;
        if (d < HoyAr) return $"vencido {d:dd/MM}";
        if (d == HoyAr) return "retira hoy";
        if (d == HoyAr.AddDays(1)) return "retira mañana";
        return $"retira {d:dd/MM}";
    }

    private static readonly string[] Dias = { "domingo", "lunes", "martes", "miércoles", "jueves", "viernes", "sábado" };
    private string ProximoCheque(ApiClient.ChequeProximoDto c)
    {
        if (c.FechaPago is null) return "";
        var d = c.FechaPago.Value.Date;
        if (d < HoyAr) return $"hay uno vencido del {d:dd/MM}";
        if (d == HoyAr) return "el próximo vence hoy";
        if (d == HoyAr.AddDays(1)) return "el próximo vence mañana";
        if (d <= HoyAr.AddDays(6)) return $"el próximo vence el {Dias[(int)d.DayOfWeek]}";
        return $"el próximo vence el {d:dd/MM}";
    }

    private static string Plata(decimal v) => v.ToString("N0", new System.Globalization.CultureInfo("es-AR"));

    private static string Corto(string? t, int max)
    {
        if (string.IsNullOrWhiteSpace(t)) return "";
        t = t.Trim().Replace('\n', ' ');
        return t.Length <= max ? t : t.Substring(0, max) + "…";
    }

    private static string Hace(DateTime utc)
    {
        var dif = DateTime.UtcNow - utc;
        if (dif.TotalMinutes < 1) return "recién";
        if (dif.TotalMinutes < 60) return $"hace {(int)dif.TotalMinutes} min";
        if (dif.TotalHours < 24) return $"hace {(int)dif.TotalHours} h";
        return utc.ToArTime().ToString("dd/MM HH:mm");
    }

