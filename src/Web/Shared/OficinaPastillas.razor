@using Web.Services
@using Web.Models
@implements IDisposable
@inject ApiClient Api
@inject ToastService ToastService
@inject NavigationManager Nav
@inject IJSRuntime JS

@* 2026-11-10: columna de pastillas vivas a la derecha del Dashboard (solo admin; maqueta aprobada
   Todo_junto_PROPUESTA). Mismo estilo que las pastillas del depósito (DepoPastillas, clases .dp-*),
   copiado acá con prefijo .op- para no pisarse. Seis pastillas de la oficina: preguntas MeLi, ME1 sin
   repartidor, alquileres, cheques por pagar, pagos a confirmar y faltantes para pedir. Se refrescan
   cada 60 s. Avisa con un cartelito negro solo si entra una pregunta nueva o un faltante nuevo. *@

<style>
    .op-col { display:flex; flex-direction:column; gap:0.7rem; position:sticky; top:8px; align-self:start; z-index:20; }
    .op-big { position:relative; border-radius:22px; padding:0.75rem 1rem; box-shadow:0 2px 7px rgba(0,0,0,.09); cursor:pointer; transition:transform .15s ease, box-shadow .15s ease; }
    .op-big:hover { transform:translateY(-2px); box-shadow:0 6px 14px rgba(0,0,0,.14); }
    .op-big.pre { background:linear-gradient(135deg,#ddd6fe,#f5f3ff); }
    .op-big.me1 { background:linear-gradient(135deg,#fed7aa,#fff7ed); }
    .op-big.alq { background:linear-gradient(135deg,#fde68a,#fef3c7); }
    .op-big.che { background:linear-gradient(135deg,#fbcfe8,#fdf2f8); }
    .op-big.pag { background:linear-gradient(135deg,#bbf7d0,#ecfdf5); }
    .op-big.fal { background:linear-gradient(135deg,#a5f3fc,#ecfeff); }
    .op-big.nueva { outline:3px solid #dc2626; outline-offset:1px; }
    .op-big.sel { outline:3px solid #111827; outline-offset:1px; }
    .op-t { display:flex; align-items:center; gap:0.45rem; font-size:1rem; font-weight:600; color:#111827; }
    .op-n { margin-left:auto; background:#dc2626; color:#fff; border-radius:999px; font-size:1.05rem; font-weight:800; padding:0 0.65rem; line-height:1.45; }
    .op-n.cero { background:rgba(17,24,39,.12); color:#4b5563; }
    .op-l { font-size:0.8rem; margin-top:0.35rem; color:#374151; line-height:1.35; display:-webkit-box; -webkit-line-clamp:2; -webkit-box-orient:vertical; overflow:hidden; }
    .op-l.gris { color:#6b7280; }
    .op-tag { background:#dc2626; color:#fff; font-size:0.66rem; font-weight:800; border-radius:6px; padding:1px 6px; }
    .op-prev { display:none; position:absolute; right:100%; top:0; margin-right:10px; width:360px; background:#fff; border:1px solid #d1d5db; border-radius:12px; box-shadow:0 10px 28px rgba(0,0,0,.25); padding:0.55rem 0.8rem 0.65rem; cursor:pointer; z-index:30; }
    .op-prev::after { content:""; position:absolute; top:0; bottom:0; right:-12px; width:12px; }
    .op-big:hover .op-prev { display:block; }
    .op-col.sin-prev .op-prev { display:none !important; }
    .op-prev-t { font-size:0.72rem; font-weight:700; color:#6b7280; text-transform:uppercase; letter-spacing:0.03em; margin-bottom:0.15rem; }
    .op-prev-f { padding:0.3rem 0; border-top:1px solid #f3f4f6; font-size:0.82rem; color:#374151; line-height:1.3; }
    .op-prev-f b { font-weight:600; color:#111827; }
    .op-prev-f small { display:block; color:#6b7280; font-size:0.74rem; }
    .op-prev-m { display:flex; justify-content:space-between; gap:0.5rem; }
    .op-prev-mas { padding-top:0.35rem; border-top:1px solid #f3f4f6; font-size:0.78rem; color:#111827; font-weight:600; }

    .op-avisos { position:fixed; right:320px; top:70px; z-index:905; width:380px; display:flex; flex-direction:column; gap:0.5rem; }
    .op-aviso { background:#111827; color:#fff; border-radius:14px; padding:0.7rem 1rem; box-shadow:0 10px 26px rgba(0,0,0,.3); font-size:0.9rem; animation:op-entra .25s ease; }
    @@keyframes op-entra { from { opacity:0; transform:translateX(20px); } to { opacity:1; transform:none; } }
    .op-aviso small { display:block; color:#d1d5db; font-size:0.8rem; margin-top:2px; overflow:hidden; display:-webkit-box; -webkit-line-clamp:2; -webkit-box-orient:vertical; }
    .op-aviso-bs { margin-top:0.5rem; display:flex; gap:0.5rem; align-items:center; }
    .op-aviso-bs button { background:#fff; color:#111827; border:none; border-radius:999px; padding:0.3rem 0.85rem; font:inherit; font-size:0.8rem; font-weight:700; cursor:pointer; }
    .op-aviso-bs button.des { background:none; color:#d1d5db; font-weight:400; }

    .op-big.cor { background:linear-gradient(135deg,#e2e8f0,#f8fafc); }
    .op-big.pos { background:linear-gradient(135deg,#fef08a,#fefce8); }
    .op-big.cal { background:linear-gradient(135deg,#e0e7ff,#f5f7ff); }
    .op-vent.op-vent-cal { width:900px; max-width:calc(100vw - 340px); }
    .op-cal-cuerpo { overflow:auto; padding:0.4rem 0.6rem 0.6rem; }
    .op-cal-cuerpo > * { zoom:0.74; }
    .op-vent.op-vent-ancha { width:860px; max-width:calc(100vw - 420px); }
    .op-tabs { display:flex; flex-wrap:wrap; gap:0.3rem; padding:0.5rem 1rem; border-bottom:1px solid #eef0f3; flex-shrink:0; }
    .op-tab { border:1px solid #e5e7eb; background:#fff; border-radius:999px; padding:0.25rem 0.75rem; font:inherit; font-size:0.82rem; cursor:pointer; }
    .op-tab.on { background:#111827; border-color:#111827; color:#fff; }
    .op-tabla { width:100%; border-collapse:collapse; font-size:0.86rem; }
    .op-tabla th { text-align:left; font-size:0.7rem; text-transform:uppercase; letter-spacing:0.04em; color:#6b7280; padding:0.45rem 0.6rem; border-bottom:1px solid #e5e7eb; position:sticky; top:0; background:#fff; }
    .op-tabla td { padding:0.45rem 0.6rem; border-bottom:1px solid #f1f2f4; vertical-align:top; }
    .op-tabla .sub { color:#6b7280; font-size:0.76rem; }
    .op-est { background:#f3f4f6; border-radius:999px; padding:0.1rem 0.5rem; font-size:0.75rem; white-space:nowrap; }
    .op-vent { position:fixed; right:320px; top:70px; z-index:905; width:520px; max-width:calc(100vw - 340px); max-height:calc(100vh - 90px);
        display:flex; flex-direction:column; background:#fff; border-radius:14px; border:1px solid #d1d5db; box-shadow:0 14px 40px rgba(0,0,0,.33); overflow:hidden; }
    .op-vh { display:flex; align-items:center; gap:0.6rem; padding:0.7rem 1rem; border-bottom:1px solid #e5e7eb; font-size:1.02rem; font-weight:600; flex-shrink:0; }
    .op-vh small { font-size:0.76rem; font-weight:400; color:#6b7280; }
    .op-x { margin-left:auto; background:none; border:none; font-size:1.3rem; cursor:pointer; color:#374151; line-height:1; }
    .op-lista { overflow-y:auto; flex:1; min-height:0; }
    .op-fila { display:flex; align-items:flex-start; gap:0.6rem; padding:0.6rem 1rem; border-top:1px solid #eef0f3; font-size:0.82rem; }
    .op-fila .sub { display:block; color:#6b7280; font-size:0.74rem; margin-top:1px; }
    .op-copiar { color:#1d4ed8; font-family:monospace; cursor:pointer; }
    .op-vacio { padding:2rem; text-align:center; color:#6b7280; }
    .op-pie { padding:0.5rem 1rem; border-top:1px solid #eef0f3; font-size:0.8rem; text-align:right; flex-shrink:0; }
    .op-pie a { color:#111827; font-weight:700; cursor:pointer; }

    @@media (max-width: 899px) {
        .op-col { position:static; flex-direction:row; overflow-x:auto; gap:0.6rem; padding:0.2rem 0.1rem 0.6rem; -webkit-overflow-scrolling:touch; }
        .op-big { flex:0 0 230px; }
        .op-big:hover { transform:none; }
        .op-prev { display:none !important; }
        .op-avisos, .op-vent { right:10px; left:10px; width:auto; max-width:none; top:62px; }
    }
</style>

<aside class="op-col @(ventana is null ? "" : "sin-prev")">
    @* 2026-11-10: con ConDeposito, Preguntas y Faltantes las muestran las pastillas del depósito
       (DepoPastillas), que abren su ventana al costado. Acá quedan las de oficina. *@
    @if (!ConDeposito)
    {
    @* 💬 Preguntas MeLi *@
    <div class="op-big pre @Marcas("pre")" @onclick='() => Tocar("pre")'>
        <div class="op-t">💬 Preguntas MeLi @Nuevo("pre") <span class="op-n @(preguntas.Count == 0 ? "cero" : "")">@preguntas.Count</span></div>
        <div class="op-l @(preguntas.Count == 0 ? "gris" : "")">
            @if (preguntas.Count == 0) { <text>Todo respondido</text> }
            else { <text>@(nuevas.Contains("pre") ? "Nueva: " : "Última: ")“@preguntas[0].Text”</text> }
        </div>
        <div class="op-prev">
            <div class="op-prev-t">Preguntas sin responder</div>
            @if (preguntas.Count == 0) { <div class="op-prev-f">No hay preguntas sin responder</div> }
            @foreach (var q in preguntas.Take(5))
            {
                <div class="op-prev-f"><b>“@Corto(q.Text, 90)”</b><small>@(q.ItemTitle ?? q.ItemId) · @Hace(q.DateCreated)</small></div>
            }
            @Mas(preguntas.Count)
        </div>
    </div>

    }

    @* 2026-11-10: con ConDeposito, ME1 (despachar, imprimir y asignar) es una sola pastilla del depósito. *@
    @if (!ConDeposito)
    {
    @* 🚚 ME1 sin repartidor *@
    <div class="op-big me1 @Marcas("me1")" @onclick='() => Tocar("me1")'>
        <div class="op-t">🚚 ME1 sin repartidor <span class="op-n @(Me1SinRep.Count == 0 ? "cero" : "")">@Me1SinRep.Count</span></div>
        <div class="op-l @(Me1SinRep.Count == 0 ? "gris" : "")">
            @if (me1 is null) { <text>Cargando…</text> }
            else if (Me1SinRep.Count == 0) { <text>Todos con repartidor</text> }
            else { <text>@Me1Quien(Me1SinRep[0])@(string.IsNullOrWhiteSpace(Me1SinRep[0].City) ? "" : $" · {Me1SinRep[0].City}")</text> }
        </div>
        <div class="op-prev">
            <div class="op-prev-t">Envíos ME1 sin repartidor</div>
            @if (Me1SinRep.Count == 0) { <div class="op-prev-f">Todos tienen repartidor asignado</div> }
            @foreach (var s in Me1SinRep.Take(5))
            {
                <div class="op-prev-f"><b>@Me1Quien(s)</b><small>@(s.City ?? s.AddressLine ?? "") · @Me1Estado(s)</small></div>
            }
            @if (Me1SinRep.Count > 0) { <div class="op-prev-mas">Tocá para asignar ›</div> }
        </div>
    </div>

    }
    @* 🎪 Alquileres *@
    <div class="op-big alq @Marcas("alq")" @onclick='() => Tocar("alq")'>
        <div class="op-t">🎪 Alquileres <span class="op-n @(AlqNumero == 0 ? "cero" : "")">@AlqNumero</span></div>
        <div class="op-l gris">
            @if (alq is null) { <text>Cargando…</text> }
            else { <text>@alq.ARetirarHoy a retirar hoy · @alq.Vencidos vencido@(alq.Vencidos == 1 ? "" : "s") · @alq.EnCalle afuera</text> }
        </div>
        <div class="op-prev">
            <div class="op-prev-t">Alquileres afuera</div>
            @if (alqCalle.Count == 0) { <div class="op-prev-f">No hay alquileres afuera</div> }
            @foreach (var r in alqCalle.Take(5))
            {
                <div class="op-prev-f op-prev-m"><span><b>@r.ClienteNombre</b><small>@r.Numero</small></span><span style="white-space:nowrap; color:@(r.FechaRetiro.Date < HoyAr ? "#b91c1c" : "#374151");">@RetiroTxt(r)</span></div>
            }
            @Mas(alqCalle.Count)
        </div>
    </div>

    @* 📅 Almanaque de cheques (2026-11-10): antes era un almanaque enorme abajo del Dashboard. *@
    <div class="op-big cal @Marcas("cal")" @onclick='() => Tocar("cal")'>
        <div class="op-t">📅 Almanaque</div>
        <div class="op-l gris">cheques, alquileres, ventas y notas</div>
    </div>

    @* 🏦 Banco Galicia (13/11/2026): reemplaza a la pastilla Cheques (misma clave "che" y clase .che, así
       conserva el lugar y el color que cada uno le eligió). Junta lo que hay que hacer con el banco: plata que
       entró sin cobranza, transferencias que salieron sin decir qué pagaron (desde el 13/11) y cheques a pagar
       esta semana. El saldo va tapado como en la tarjeta vieja del Panorama (que se sacó). *@
    <div class="op-big che @Marcas("che")" @onclick='() => Tocar("che")'>
        <div class="op-t">🏦 Banco Galicia @Nuevo("che") <span class="op-n @(BancoNumero == 0 ? "cero" : "")">@BancoNumero</span></div>
        <div class="op-l @(BancoNumero == 0 ? "gris" : "")">
            @if (!bancoOk) { <text>Cargando…</text> }
            else if (BancoNumero == 0) { <text>Todo al día</text> }
            else { <text>@BancoResumen</text> }
        </div>
        <div class="op-l gris" style="margin-top:0.15rem;">
            <span @onclick="ToggleSaldo" @onclick:stopPropagation="true" title="@(verSaldo ? "Tapar el saldo" : "Ver el saldo")" style="cursor:pointer;">
                @(saldoBanco is null || saldoBanco.CantidadMovimientos == 0 ? "$ —" : verSaldo ? "$" + Plata(saldoBanco.Saldo) : "$ ••••••") @(verSaldo ? "👁" : "🙈")
            </span>
            @if (saldoBanco?.UltimoImportadoAt is DateTime ua) { <text> · al día @ua.ToArTime().ToString("HH:mm")</text> }
        </div>
        <div class="op-prev">
            <div class="op-prev-t">Para hacer con el banco</div>
            <div class="op-prev-f op-prev-m"><span><b>💰 Entraron</b><small>transferencias y cheques sin cobranza</small></span><span>@Entraron.Count</span></div>
            <div class="op-prev-f op-prev-m"><span><b>💸 Salieron</b><small>transferencias sin decir qué pagaron</small></span><span>@salieron.Count</span></div>
            <div class="op-prev-f op-prev-m"><span><b>📄 Cheques a pagar</b><small>@(cheques is { Count: > 0 } ? ProximoCheque(cheques[0]) : "no hay cheques por pagar")</small></span><span>@ChequesSemana.Count</span></div>
            <div class="op-prev-mas">Tocá para verlos ›</div>
        </div>
    </div>

    @* 2026-11-10: con ConDeposito no va "Pagos a confirmar" (el dueño cree que no se usa; la pantalla sigue en el menú Plata).
       En su lugar, 📧 Correos importantes. *@
    @if (!ConDeposito)
    {
    @* ✅ Pagos a confirmar *@
    <div class="op-big pag @Marcas("pag")" @onclick='() => Tocar("pag")'>
        <div class="op-t">✅ Pagos a confirmar <span class="op-n @(pagos.Count == 0 ? "cero" : "")">@pagos.Count</span></div>
        <div class="op-l gris">
            @if (!pagosOk) { <text>Cargando…</text> }
            else if (pagos.Count == 0) { <text>Todo al día</text> }
            else { <text>@Corto(pagos[0].Concepto, 40) · $@Plata(pagos[0].Monto)</text> }
        </div>
        <div class="op-prev">
            <div class="op-prev-t">Pagos cargados desde el celu</div>
            @if (pagos.Count == 0) { <div class="op-prev-f">Nada para confirmar</div> }
            @foreach (var p in pagos.Take(5))
            {
                <div class="op-prev-f op-prev-m"><span><b>@Corto(p.Concepto, 50)</b><small>@(p.EmpleadoNombre ?? p.ProveedorNombre ?? "") · cargó @p.CreadoPor</small></span><span style="white-space:nowrap;">$@Plata(p.Monto)</span></div>
            }
            @Mas(pagos.Count)
        </div>
    </div>

    }
    @if (ConDeposito)
    {
        @* 📧 Correos importantes (2026-11-10): antes era una tarjeta grande abajo del Dashboard. *@
        <div class="op-big cor @Marcas("cor")" @onclick='() => Tocar("cor")'>
            <div class="op-t">📧 Correos importantes <span class="op-n @(correos.Count == 0 ? "cero" : "")">@correos.Count</span></div>
            <div class="op-l gris">
                @if (correos.Count == 0) { <text>Nada importante sin leer</text> }
                else { <text>@Corto(NombreCorreo(correos[0]), 60)</text> }
            </div>
            <div class="op-prev">
                <div class="op-prev-t">Correos importantes</div>
                @if (correos.Count == 0) { <div class="op-prev-f">No hay correos importantes sin leer</div> }
                @foreach (var c in correos.Take(5))
                {
                    <div class="op-prev-f"><b>@NombreCorreo(c)</b><small>@(string.IsNullOrWhiteSpace(c.Asunto) ? "(sin asunto)" : Corto(c.Asunto!, 80))</small></div>
                }
                @Mas(correos.Count)
            </div>
        </div>
    }

    @if (ConDeposito)
    {
        @* 📝 Postits del equipo (13/11/2026): antes era una tarjeta abajo del Panorama. Los mismos postits
           compartidos (scope "dashboard"); se ven y se editan en la ventanita. *@
        <div class="op-big pos @Marcas("pos")" @onclick='() => Tocar("pos")'>
            <div class="op-t">📝 Postits del equipo <span class="op-n cero">@(postitsCant?.ToString() ?? "")</span></div>
            <div class="op-l gris">@(postitPrimero is null ? "notas compartidas del equipo" : Corto(postitPrimero, 60))</div>
        </div>
    }

    @if (!ConDeposito)
    {
    @* 🛒 Faltantes para pedir *@
    <div class="op-big fal @Marcas("fal")" @onclick='() => Tocar("fal")'>
        <div class="op-t">🛒 Faltantes para pedir @Nuevo("fal") <span class="op-n @(Faltantes.Count == 0 ? "cero" : "")">@Faltantes.Count</span></div>
        <div class="op-l gris">
            @if (!faltOk) { <text>Cargando…</text> }
            else if (Faltantes.Count == 0) { <text>No falta nada por pedir</text> }
            else { <text>@string.Join(" · ", PorMarca.Take(3).Select(g => $"{g.Key} {g.Count()}"))</text> }
        </div>
        <div class="op-prev">
            <div class="op-prev-t">Para pedir</div>
            @if (Faltantes.Count == 0) { <div class="op-prev-f">No falta nada por pedir</div> }
            @foreach (var f in Faltantes.Take(5))
            {
                <div class="op-prev-f"><b>@Corto(f.Nombre, 60)</b><small>@(string.IsNullOrWhiteSpace(f.Marca) ? "Sin marca" : f.Marca) · hay @f.StockAhora.ToString("0.##")</small></div>
            }
            @Mas(Faltantes.Count)
        </div>
    </div>
    }
</aside>

@if (avisos.Count > 0 && ventana is null)
{
    <div class="op-avisos">
        @foreach (var a in avisos.Take(3))
        {
            var av = a;
            <div class="op-aviso" @key="av.Id">
                🔔 <b>@av.Titulo</b>
                <small>@av.Texto</small>
                <div class="op-aviso-bs">
                    <button @onclick="() => VerAviso(av)">Ver</button>
                    <button class="des" @onclick="() => avisos.Remove(av)">Después</button>
                </div>
            </div>
        }
    </div>
}

@if (ventana == "pos")
{
    <div class="op-vent">
        <div class="op-vh">
            📝 Postits del equipo <small>los ve todo el equipo</small>
            <button class="op-x" title="Cerrar" @onclick="Cerrar">✕</button>
        </div>
        <div class="op-lista" style="padding:0.5rem 0.8rem;">
            <PostitsWidget Scope="dashboard" Title="Postits del equipo" CardStyle="max-height:none; box-shadow:none; border:0; padding:0;" />
        </div>
    </div>
}

@if (ventana == "cal")
{
    @* 2026-11-10: almanaque para todo (cheques, alquileres, ventas, notas), por semana, mes o año. *@
    <AlmanaqueGeneral OnCerrar="Cerrar" />
}

@if (ventana == "che")
{
    <div class="op-vent op-vent-ancha">
        <div class="op-vh">
            🏦 Banco Galicia
            <small>@(saldoBanco?.UltimoImportadoAt is DateTime u2 ? $"se actualiza solo · última vez {u2.ToArTime():dd/MM HH:mm}" : "")</small>
            <span style="margin-left:auto; font-size:1rem; font-weight:800; cursor:pointer;" @onclick="ToggleSaldo" title="@(verSaldo ? "Tapar el saldo" : "Ver el saldo")">
                @(saldoBanco is null ? "" : verSaldo ? "$" + Plata(saldoBanco.Saldo) : "$ ••••••") @(verSaldo ? "👁" : "🙈")
            </span>
            <button class="op-x" style="margin-left:0.6rem;" title="Cerrar" @onclick="Cerrar">✕</button>
        </div>
        <div class="op-tabs">
            <button class="op-tab @(bancoVista == "ent" ? "on" : "")" @onclick='() => bancoVista = "ent"'>💰 Entraron (@Entraron.Count)</button>
            <button class="op-tab @(bancoVista == "sal" ? "on" : "")" @onclick='() => bancoVista = "sal"'>💸 Salieron (@salieron.Count)</button>
            <button class="op-tab @(bancoVista == "che" ? "on" : "")" @onclick='() => { bancoVista = "che"; _ = VerCheques(chVista); }'>📄 Cheques (@ChequesSemana.Count)</button>
        </div>
        @if (bancoVista == "ent")
        {
            <div class="op-l gris" style="padding:0.45rem 1rem; margin:0;">Plata que entró al banco y todavía no es cobranza de nadie</div>
            <div class="op-lista">
                @if (Entraron.Count == 0) { <div class="op-vacio">No hay nada para aplicar. Todo al día.</div> }
                @foreach (var it in Entraron)
                {
                    var item = it;
                    <div class="op-fila">
                        <span style="width:3.2rem; color:#6b7280;">@PlataAcciones.Cuando(item)</span>
                        <span style="flex:1;"><b>@(item.ClienteNombre ?? item.DeQuien ?? "(sin nombre)")</b>
                            <span class="sub">@item.QueEs@(string.IsNullOrWhiteSpace(item.PorQue) ? "" : " · " + item.PorQue)</span></span>
                        <span style="white-space:nowrap; font-weight:700;">@PlataAcciones.Plata(item.Importe)</span>
                        <button class="op-tab" @onclick="() => Aplicar(item)">@(PlataAcciones.Url(item) is null ? "elegir cliente" : "cobrar")</button>
                    </div>
                }
            </div>
            <div class="op-pie"><a @onclick='() => Nav.NavigateTo("/cafe/cobranzas-pendientes")'>Ir a Plata que entró ›</a></div>
        }
        else if (bancoVista == "sal")
        {
            <div class="op-l gris" style="padding:0.45rem 1rem; margin:0;">Transferencias que hiciste desde el @Web.Services.ApiClient.SalieronDesde.ToString("dd/MM") y todavía no dicen qué pagaron</div>
            <div class="op-lista">
                @if (salieron.Count == 0) { <div class="op-vacio">No hay transferencias para explicar.</div> }
                @foreach (var sm in salieron)
                {
                    var m = sm;
                    <div class="op-fila" style="flex-wrap:wrap;">
                        <span style="width:3.2rem; color:#6b7280;">@m.Fecha.ToString("dd/MM")</span>
                        <span style="flex:1; min-width:12rem;"><b>@(m.ProveedorNombre ?? m.Nombre ?? "(sin nombre)")</b>
                            <span class="sub">@(m.ConCuentaCorriente ? "proveedor con cuenta corriente" : m.ProveedorId is not null ? "proveedor sin cuenta corriente" : $"CUIT {m.Cuit} · no es un proveedor cargado")</span></span>
                        <span style="white-space:nowrap; font-weight:700;">$@Plata2(m.Importe)</span>
                        @if (salAbierta == m.Id)
                        {
                            <div style="flex-basis:100%; padding:0.4rem 0 0 3.8rem;">
                                @if (m.ConCuentaCorriente)
                                {
                                    @if (salFacturas is null) { <span class="sub">Buscando facturas…</span> }
                                    else if (salFacturas.Count == 0) { <span class="sub">No tiene nada pendiente. Puede que la factura todavía no haya entrado de AFIP.</span> }
                                    else
                                    {
                                        <div class="sub" style="margin-bottom:0.25rem;">¿Qué pagó esta transferencia?</div>
                                        @foreach (var f in salFacturas)
                                        {
                                            var fac = f;
                                            var igual = Math.Abs(fac.Saldo - m.Importe) < 0.01m;
                                            <div style="display:flex; gap:0.5rem; align-items:center; padding:0.15rem 0;">
                                                <span style="flex:1;">@(fac.Etiqueta ?? fac.IdComprobante) <span class="sub" style="display:inline;">@fac.FechaEmision?.ToString("dd/MM")</span>@if (igual) { <b style="color:#065f46;"> · mismo monto</b> }</span>
                                                <span style="white-space:nowrap;">$@Plata2(fac.Saldo)</span>
                                                <button class="op-tab @(igual ? "on" : "")" disabled="@salGuardando" @onclick="() => AsociarSalida(m, fac)">Asociar</button>
                                            </div>
                                        }
                                        <div class="sub" style="margin-top:0.25rem;">Si pagó varias juntas, hacelo desde el <a style="cursor:pointer; text-decoration:underline;" @onclick='() => Nav.NavigateTo("/cafe/tesoreria/extracto-banco")'>extracto</a>.</div>
                                    }
                                }
                                else
                                {
                                    <div style="display:flex; gap:0.4rem; flex-wrap:wrap;">
                                        <button class="op-tab" @onclick='() => Nav.NavigateTo("/cafe/proveedores-ctacte")'>Es de un proveedor → llevarle cuenta corriente</button>
                                        <button class="op-tab" disabled="@salGuardando" @onclick="() => NoEsProveedor(m)">No es pago a proveedor</button>
                                    </div>
                                }
                            </div>
                        }
                        else
                        {
                            <button class="op-tab @(m.ConCuentaCorriente ? "on" : "")" @onclick="() => AbrirSalida(m)">@(m.ConCuentaCorriente ? "Asociar factura" : "¿Qué fue?")</button>
                        }
                    </div>
                }
            </div>
            <div class="op-pie"><a @onclick='() => Nav.NavigateTo("/cafe/tesoreria/extracto-banco")'>Ir al extracto completo ›</a></div>
        }
        else
        {
            <div class="op-tabs">
                @foreach (var (k, l) in SolapasCheques)
                {
                    <button class="op-tab @(chVista == k ? "on" : "")" @onclick="() => VerCheques(k)">@l @(chResp is null ? "" : $"({ConteoCh(k)})")</button>
                }
            </div>
            <div class="op-lista">
                @if (chCargando) { <div class="op-vacio">Cargando…</div> }
                else if ((chResp?.Filas.Count ?? 0) == 0) { <div class="op-vacio">No hay cheques en esta lista.</div> }
                else
                {
                    <table class="op-tabla">
                        <tr><th>Vence</th><th>Cheque</th><th>De / para</th><th style="text-align:right;">Importe</th><th>Estado</th></tr>
                        @foreach (var c in chResp!.Filas.OrderBy(c => c.Vence.HasValue && c.Vence.Value.Date >= HoyAr ? 0 : 1).ThenBy(c => c.Vence.HasValue && c.Vence.Value.Date >= HoyAr ? c.Vence.Value.Ticks : -(c.Vence?.Ticks ?? 0)))
                        {
                            var vencido = c.Vence.HasValue && c.Vence.Value.Date < HoyAr && c.Vista is "EN_MANO" or "A_PAGAR";
                            <tr>
                                <td style="white-space:nowrap; @(vencido ? "color:#b91c1c; font-weight:700;" : "")">@(c.Vence?.ToString("dd/MM/yy") ?? "—")</td>
                                <td>#@c.Numero<div class="sub">@c.Banco</div></td>
                                <td>@(c.ClienteNombre ?? c.Emisor ?? "—")@if (!string.IsNullOrWhiteSpace(c.FueA)) { <div class="sub">→ @c.FueA</div> }</td>
                                <td style="text-align:right; white-space:nowrap; font-weight:700;">$@Plata(c.Importe)</td>
                                <td><span class="op-est">@c.EstadoTexto</span></td>
                            </tr>
                        }
                    </table>
                }
            </div>
            <div class="op-pie"><a @onclick='() => Nav.NavigateTo($"/cafe/tesoreria/cheques-todos?vista={chVista}")'>Ir a la pantalla de cheques ›</a></div>
        }
    </div>
}

