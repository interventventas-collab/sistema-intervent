@code {
    private sealed class Aviso { public int Id; public string Pastilla = ""; public string Titulo = ""; public string Texto = ""; public DateTime Hasta; }

    private List<MeliQuestionDto> preguntas = new();
    private List<MeliMe1ShipmentDto>? me1;
    private List<RepartidorDto> repartidores = new();
    // ───────── Ventanas de Cheques y Alquileres (2026-11-10) ─────────
    private static readonly (string Key, string Label)[] SolapasCheques =
    {
        ("TODOS", "Todos"), ("EN_MANO", "Tengo en mano"), ("EN_BANCO", "En el banco"),
        ("A_PAGAR", "Tengo que pagar"), ("USADOS", "Ya los usé"), ("RECHAZADOS", "Rebotaron"),
    };
    private string chVista = "TODOS";
    private ChequesUnificadoResponse? chResp;
    private bool chCargando;
    private int ConteoCh(string k) => chResp is null ? 0 : k switch
    {
        "EN_MANO" => chResp.Conteos.EnMano, "EN_BANCO" => chResp.Conteos.EnBanco, "USADOS" => chResp.Conteos.Usados,
        "RECHAZADOS" => chResp.Conteos.Rechazados, "A_PAGAR" => chResp.Conteos.APagar, _ => chResp.Conteos.Todos,
    };
    private async Task VerCheques(string k)
    {
        chVista = k; chCargando = true; StateHasChanged();
        try { chResp = await Api.GetChequesUnificadoAsync(k); }
        catch { }
        finally { chCargando = false; StateHasChanged(); }
    }
    private string alqVista = "calle";
    private List<AlqReservaDto> alqTodas = new();
    private List<AlqReservaDto> AlqProximas => alqTodas
        .Where(r => r.Estado is "reservado" or "confirmado" && r.FechaEntrega.Date >= HoyAr)
        .OrderBy(r => r.FechaEntrega).Take(40).ToList();
    private async Task CargarProximas()
    {
        try { alqTodas = await Api.GetAlqReservasAsync() ?? new(); StateHasChanged(); }
        catch { }
    }

    private AlqDashboardResumen? alq;
    private List<AlqReservaDto> alqCalle = new();
    private List<ApiClient.ChequeProximoDto>? cheques;
    private List<PendienteListDto> pagos = new();
    private List<StockIdealPendienteDto> faltantes = new();
    private bool pagosOk, faltOk, pregOk;
    private readonly HashSet<int> vistasPreg = new(), vistosFalt = new();
    private readonly HashSet<string> nuevas = new();
    private readonly List<Aviso> avisos = new();
    private int proximoAviso;
    private string? ventana;
    private int? asignando;
    private bool ocupado, cerrado;
    private System.Threading.Timer? timer;

    private DateTime HoyAr => DateTimeExt.AhoraAr().Date;

    private static bool Me1Pendiente(MeliMe1ShipmentDto s)
        => s.Status != "delivered" && s.Status != "not_delivered" && s.Status != "cancelled";
    private List<MeliMe1ShipmentDto> Me1SinRep =>
        me1?.Where(s => Me1Pendiente(s) && s.RepartidorAsignadoId == null).ToList() ?? new();
    private int AlqNumero => alq is null ? 0 : alq.ARetirarHoy + alq.Vencidos;
    private List<ApiClient.ChequeProximoDto> ChequesSemana =>
        cheques?.Where(c => c.FechaPago.HasValue && c.FechaPago.Value.Date <= HoyAr.AddDays(7)).ToList() ?? new();
    private List<StockIdealPendienteDto> Faltantes => faltantes.Where(f => !f.Pedido && !f.YaRepuesto && !f.EnArmado).ToList();
    private List<IGrouping<string, StockIdealPendienteDto>> PorMarca => Faltantes
        .GroupBy(f => string.IsNullOrWhiteSpace(f.Marca) ? "Sin marca" : f.Marca!.Trim(), StringComparer.OrdinalIgnoreCase)
        .OrderByDescending(g => g.Count()).ThenBy(g => g.Key).ToList();

    private RenderFragment Nuevo(string p) => __builder =>
    {
        @if (nuevas.Contains(p)) { <span class="op-tag">NUEVO</span> }
    };
    private RenderFragment Mas(int total) => __builder =>
    {
        @if (total > 5) { <div class="op-prev-mas">y @(total - 5) más · ver todas ›</div> }
        else if (total > 0) { <div class="op-prev-mas">ver todas ›</div> }
    };
    private string Marcas(string p) => (ventana == p ? "sel " : "") + (nuevas.Contains(p) ? "nueva" : "");

    protected override void OnInitialized()
    {
        timer = new System.Threading.Timer(async _ =>
        {
            if (cerrado) return;
            await InvokeAsync(Vuelta);
        }, null, 0, 60000);
    }

    private async Task Vuelta()
    {
        if (ocupado) return;
        ocupado = true;
        try
        {
            avisos.RemoveAll(a => a.Hasta < DateTime.UtcNow);
            await Task.WhenAll(CargarPreguntas(), CargarMe1(), CargarAlq(), CargarCheques(), CargarBanco(), CargarPagos(), CargarFaltantes());
            if (!cerrado) StateHasChanged();
        }
        finally { ocupado = false; }
    }

    private async Task CargarPreguntas()
    {
        try
        {
            var r = await Api.GetMeliQuestionsAsync("UNANSWERED");
            if (r is null) return;
            preguntas = r.OrderByDescending(q => q.DateCreated).ToList();
            var entraron = preguntas.Where(q => !vistasPreg.Contains(q.Id)).ToList();
            if (pregOk && entraron.Count > 0)
            {
                nuevas.Add("pre");
                Avisar("pre", entraron.Count == 1 ? "Pregunta nueva de MercadoLibre" : $"{entraron.Count} preguntas nuevas",
                    entraron.Count == 1 ? $"“{entraron[0].Text}” · {entraron[0].ItemTitle}" : string.Join(" · ", entraron.Take(3).Select(q => $"“{Corto(q.Text, 40)}”")));
            }
            foreach (var q in preguntas) vistasPreg.Add(q.Id);
            pregOk = true;
        }
        catch { }
    }

    private async Task CargarMe1()
    {
        try
        {
            if (repartidores.Count == 0)
                repartidores = (await Api.GetRepartidoresAsync() ?? new()).Where(r => r.IsActive).ToList();
            me1 = await Api.GetMeliMe1ShipmentsAsync("todos") ?? new();
        }
        catch { }
    }

    private async Task CargarAlq()
    {
        try
        {
            alq = await Api.GetAlqResumenDashboardAsync();
            var entregadas = await Api.GetAlqReservasAsync(estado: "entregado");
            alqCalle = entregadas?.Where(r => r.EntregadoPorRepartidorId.HasValue && !r.RetiradoPorRepartidorId.HasValue)
                .OrderBy(r => r.FechaRetiro).ToList() ?? new();
        }
        catch { }
    }

    // 2026-11-10: correos importantes (pastilla).
    private List<ApiClient.CorreoImportanteDto> correos = new();
    private static string NombreCorreo(ApiClient.CorreoImportanteDto c)
        => string.IsNullOrWhiteSpace(c.Remitente) ? (c.RemitenteEmail ?? "(desconocido)") : c.Remitente!;
    // 13/11/2026: postits del equipo (pastilla).
    private int? postitsCant;
    private string? postitPrimero;
    private async Task CargarPostits()
    {
        try
        {
            var ps = await Api.GetPostitsAsync("dashboard");
            if (ps is null) return;
            postitsCant = ps.Count;
            postitPrimero = ps.Select(x => x.Texto).FirstOrDefault(t => !string.IsNullOrWhiteSpace(t));
        }
        catch { }
    }

    private async Task CargarCorreos()
    {
        if (!ConDeposito) return;
        await CargarPostits();
        try { correos = await Api.GetCorreosImportantesAsync(); }
        catch { }
    }

    // ───────── 🏦 Banco Galicia (13/11/2026) ─────────
    private SaldoBancoDto? saldoBanco;
    private List<PlataItemDto> plataEntro = new();
    private List<SalidaBancoDto> salieron = new();
    private bool bancoOk, verSaldo;
    private string bancoVista = "ent";
    private readonly HashSet<string> vistosBanco = new();
    private int? salAbierta;
    private List<FacturaCompraImpagaDto>? salFacturas;
    private bool salGuardando;

    /// <summary>De "Plata que entró" solo lo del banco (transferencias y cheques); los cobros de repartidor no.</summary>
    private List<PlataItemDto> Entraron => plataEntro.Where(i => i.Tipo is "TRANSFERENCIA" or "ECHEQ" or "CHEQUE").ToList();
    private int BancoNumero => Entraron.Count + salieron.Count + ChequesSemana.Count;
    private string BancoResumen => string.Join(" · ", new[]
    {
        Entraron.Count == 0 ? null : $"{Entraron.Count} cobranza{(Entraron.Count == 1 ? "" : "s")}",
        salieron.Count == 0 ? null : $"{salieron.Count} pago{(salieron.Count == 1 ? "" : "s")}",
        ChequesSemana.Count == 0 ? null : $"{ChequesSemana.Count} cheque{(ChequesSemana.Count == 1 ? "" : "s")} a pagar",
    }.Where(x => x != null));

    private void ToggleSaldo() => verSaldo = !verSaldo;

    private async Task CargarBanco()
    {
        try
        {
            var tSaldo = Api.GetSaldoBancoAsync();
            var tEnt = Api.GetPlataListaAsync("por-volcar");
            var tSal = Api.GetSalieronBancoAsync();
            saldoBanco = await tSaldo;
            plataEntro = await tEnt;
            salieron = await tSal ?? new();
            // Aviso cuando llega info nueva del banco (no en la primera carga).
            var claves = Entraron.Select(i => i.Key).Concat(salieron.Select(m => "S-" + m.Id)).ToList();
            if (bancoOk)
            {
                var ent = Entraron.Count(i => !vistosBanco.Contains(i.Key));
                var sal = salieron.Count(m => !vistosBanco.Contains("S-" + m.Id));
                if (ent + sal > 0)
                {
                    nuevas.Add("che");
                    Avisar("che", "Entró info del Galicia", string.Join(" · ", new[]
                    {
                        ent == 0 ? null : $"+{ent} para cobrar",
                        sal == 0 ? null : $"+{sal} pago{(sal == 1 ? "" : "s")} para explicar",
                    }.Where(x => x != null)));
                }
            }
            foreach (var k in claves) vistosBanco.Add(k);
            bancoOk = true;
        }
        catch { }
    }

    private void Aplicar(PlataItemDto i)
        => Nav.NavigateTo(PlataAcciones.Url(i) ?? "/cafe/cobranzas-pendientes");

    private async Task AbrirSalida(SalidaBancoDto m)
    {
        if (salAbierta == m.Id) { salAbierta = null; return; }
        salAbierta = m.Id; salFacturas = null;
        if (!m.ConCuentaCorriente || string.IsNullOrEmpty(m.Cuit)) return;
        try { salFacturas = await Api.GetFacturasImpagasProveedorAsync(m.Cuit) ?? new(); }
        catch { salFacturas = new(); }
    }

    private async Task AsociarSalida(SalidaBancoDto m, FacturaCompraImpagaDto f)
    {
        salGuardando = true;
        try
        {
            var r = await Api.PagarComprasDesdeBancoAsync(m.Id, new List<string> { f.IdComprobante },
                Math.Abs(f.Saldo - m.Importe) < 0.01m ? null : new Dictionary<string, decimal> { [f.IdComprobante] = Math.Min(f.Saldo, m.Importe) });
            if (r is { Ok: true })
            {
                ToastService.Success($"✓ Transferencia asociada a {f.Etiqueta ?? f.IdComprobante}");
                salieron.Remove(m); salAbierta = null;
            }
            else ToastService.Error(r?.Error ?? "No se pudo asociar");
        }
        catch (Exception ex) { ToastService.Error($"Error: {ex.Message}"); }
        finally { salGuardando = false; }
    }

    private async Task NoEsProveedor(SalidaBancoDto m)
    {
        salGuardando = true;
        try
        {
            if (await Api.IgnorarMovimientoExtractoAsync(m.Id, "no es pago a proveedor"))
            {
                ToastService.Success("✓ Listo, no se pide más");
                salieron.Remove(m); salAbierta = null;
            }
            else ToastService.Error("No se pudo apartar");
        }
        catch (Exception ex) { ToastService.Error($"Error: {ex.Message}"); }
        finally { salGuardando = false; }
    }

    private static string Plata2(decimal v) => v.ToString("N2", new System.Globalization.CultureInfo("es-AR"));

    private async Task CargarCheques()
    {
        await CargarCorreos();
        try { cheques = await Api.GetChequesProximosPagarAsync(50); }
        catch { }
    }

    private async Task CargarPagos()
    {
        try
        {
            var r = await Api.GetPagosMovilPendientesAsync();
            if (r is null) return;
            pagos = r.OrderBy(p => p.CreatedAt).ToList();
            pagosOk = true;
        }
        catch { }
    }

    private async Task CargarFaltantes()
    {
        try
        {
            var r = await Api.GetStockIdealPendientesAsync();
            if (r is null) return;
            faltantes = r.Filas;
            if (faltOk)
            {
                var entraron = Faltantes.Where(f => !vistosFalt.Contains(f.Id)).ToList();
                if (entraron.Count > 0)
                {
                    nuevas.Add("fal");
                    Avisar("fal", entraron.Count == 1 ? "Hay que pedir un producto" : $"Hay que pedir {entraron.Count} productos",
                        string.Join(" · ", entraron.Take(3).Select(f => $"{Corto(f.Nombre, 40)} (hay {f.StockAhora:0.##})"))
                        + (entraron.Count > 3 ? $" · y {entraron.Count - 3} más" : ""));
                }
            }
            foreach (var f in faltantes) vistosFalt.Add(f.Id);
            faltOk = true;
        }
        catch { }
    }

    /// <summary>2026-11-10: en el Dashboard van también las pastillas del depósito (Ventas MeLi, ME1,
    /// Faltantes, Preguntas): acá no se repiten Preguntas ni Faltantes, ni sus avisos.</summary>
    [Parameter] public bool ConDeposito { get; set; }

    private void Avisar(string pastilla, string titulo, string texto)
    {
        if (ConDeposito && pastilla is "pre" or "fal") return;
        avisos.Insert(0, new Aviso { Id = ++proximoAviso, Pastilla = pastilla, Titulo = titulo, Texto = texto, Hasta = DateTime.UtcNow.AddMinutes(5) });
    }

    private void VerAviso(Aviso a)
    {
        avisos.Remove(a);
        Tocar(a.Pastilla);
    }

    private void Tocar(string p)
    {
        nuevas.Remove(p);
        avisos.RemoveAll(a => a.Pastilla == p);
        if (p == "cal") { ventana = ventana == "cal" ? null : "cal"; return; }
        if (p == "pos") { ventana = ventana == "pos" ? null : "pos"; return; }
        if (p == "che")
        {
            if (ventana == "che") { Cerrar(); return; }
            ventana = "che";
            // Abre en la solapa que tiene algo para hacer.
            bancoVista = Entraron.Count > 0 ? "ent" : salieron.Count > 0 ? "sal" : "che";
            if (bancoVista == "che") _ = VerCheques(chVista);
            return;
        }
        if (p == "alq") { if (ventana == "alq") { Cerrar(); return; } ventana = "alq"; _ = CargarProximas(); return; }
        if (p == "me1")
        {
            // Con envíos sin repartidor se abre la ventanita al costado para asignar; si no hay, va a la pantalla.
            if (ventana == "me1") { Cerrar(); return; }
            if (Me1SinRep.Count > 0) { ventana = "me1"; return; }
        }
        var url = p switch
        {
            "pre" => "/meli/preguntas",
            "me1" => "/meli/me1/entregas",
            "alq" => "/alquileres",
            "che" => "/cafe/tesoreria/cheques-todos?vista=A_PAGAR",
            "pag" => "/tesoreria/pagos-pendientes",
            "cor" => "/mis-alertas",
            "fal" => "/stock/ideal",
            _ => null
        };
        if (url is not null) Nav.NavigateTo(url);
    }

    private void Cerrar() => ventana = null;

    private async Task Asignar(MeliMe1ShipmentDto s, string? value)
    {
        if (!int.TryParse(value, out var repId)) return;
        asignando = s.Id;
        try
        {
            var ok = await Api.AsignarRepartidorMe1Async(s.Id, repId);
            if (ok)
            {
                s.RepartidorAsignadoId = repId;
                s.RepartidorAsignadoNombre = repartidores.FirstOrDefault(r => r.Id == repId)?.Nombre;
                ToastService.Success($"✓ Asignado a {s.RepartidorAsignadoNombre}");
                if (Me1SinRep.Count == 0) ventana = null;
            }
            else ToastService.Error("No se pudo asignar el repartidor");
        }
        catch (Exception ex) { ToastService.Error($"Error: {ex.Message}"); }
        finally { asignando = null; }
    }

