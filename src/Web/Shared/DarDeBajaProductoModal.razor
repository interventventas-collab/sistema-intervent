@inject ApiClient Api
@inject ToastService ToastService

@* 2026-11-12: dar de baja un producto. Dos opciones (stock en 0 / stock como está) y, en las dos,
   se pausan en MercadoLibre todas las publicaciones que lo contienen (sueltas, sets, packs, combos).
   Se usa en Productos (editar) y en Stock ideal → Configurar. *@
<div @onclick="Cerrar"
     style="position:fixed; inset:0; background:rgba(17,24,39,0.5); display:flex; align-items:center; justify-content:center; z-index:9999; padding:0.75rem;">
    <div @onclick:stopPropagation="true"
         style="background:#fff; border-radius:14px; padding:1.1rem 1.2rem; width:min(94vw,560px); max-height:92vh; overflow-y:auto; box-shadow:0 10px 40px rgba(0,0,0,0.3); font-size:0.9rem; color:#111827;">
        <div style="display:flex; align-items:flex-start; gap:0.6rem;">
            <div style="flex:1;">
                <div style="font-weight:700; font-size:1.02rem;">Dar de baja @(dto?.Sku ?? "")</div>
                <div style="color:#6b7280; font-size:0.85rem;">
                    @(dto?.Nombre ?? Nombre)
                    @if (dto is not null)
                    {
                        <span> · stock @StockTxt</span>
                    }
                </div>
            </div>
            <button type="button" @onclick="Cerrar" aria-label="Cerrar"
                    style="border:none; background:#f3f4f6; border-radius:8px; width:32px; height:32px; cursor:pointer;">✕</button>
        </div>

        @if (dto is null)
        {
            <div style="padding:1.2rem 0; text-align:center; color:#6b7280;">@(error ?? "Buscando sus publicaciones…")</div>
        }
        else if (resultado is not null)
        {
            <div style="margin-top:0.9rem; font-weight:600; color:@(resultado.Fallaron > 0 ? "#b91c1c" : "#111827");">@resultado.Mensaje</div>
            @if (resultado.Detalle.Count > 0)
            {
                <div style="margin-top:0.5rem; font-size:0.8rem; line-height:1.55;">
                    @foreach (var d in resultado.Detalle)
                    {
                        <div style="color:@(d.Ok ? "#374151" : "#b91c1c");">
                            <span style="font-family:monospace;">@d.MeliItemId</span> · @d.Titulo · <b>@d.Mensaje</b>
                        </div>
                    }
                </div>
            }
            <div style="display:flex; justify-content:flex-end; margin-top:1rem;">
                <button class="btn btn-secondary" @onclick="Cerrar">Listo</button>
            </div>
        }
        else
        {
            <div style="margin-top:0.9rem; font-weight:600;">Qué querés hacer</div>
            <label style="display:flex; gap:0.6rem; align-items:flex-start; padding:0.6rem 0; border-top:1px solid #e5e7eb; margin-top:0.4rem; cursor:pointer;">
                <input type="radio" name="baja-op" checked="@stockEnCero" @onchange="() => stockEnCero = true" style="margin-top:0.25rem;" />
                <span>Dar de baja y dejar el stock en 0<br /><span style="color:#6b7280; font-size:0.82rem;">No queda nada en el depósito</span></span>
            </label>
            <label style="display:flex; gap:0.6rem; align-items:flex-start; padding:0.6rem 0; border-top:1px solid #e5e7eb; border-bottom:1px solid #e5e7eb; cursor:pointer;">
                <input type="radio" name="baja-op" checked="@(!stockEnCero)" @onchange="() => stockEnCero = false" style="margin-top:0.25rem;" />
                <span>Dar de baja y dejar el stock como está (@StockTxt)<br /><span style="color:#6b7280; font-size:0.82rem;">Queda anotado lo que hay, pero no se vende más</span></span>
            </label>
            @if (dto.StockEnFull > 0 && stockEnCero)
            {
                <div style="color:#6b7280; font-size:0.82rem; margin-top:0.4rem;">Las @dto.StockEnFull u. que están en Full de MercadoLibre no se tocan (están en su depósito).</div>
            }

            @if (Pausar.Count == 0 && Compartidas.Count == 0)
            {
                <div style="margin:0.9rem 0; color:#374151;">No tiene publicaciones en MercadoLibre.</div>
            }
            else
            {
                <div style="margin:0.9rem 0; padding:0.6rem 0.75rem; border:1px solid #fcd34d; background:#fffbeb; color:#92400e; border-radius:8px;">
                    @if (Pausar.Count > 0)
                    {
                        <div style="font-weight:700; margin-bottom:0.3rem;">
                            ⚠ Se van a pausar @Pausar.Count publicación(es) de MercadoLibre
                            @if (YaPausadas > 0) { <span style="font-weight:400;"> (@YaPausadas ya estaban pausadas)</span> }
                        </div>
                        <div style="font-size:0.8rem; line-height:1.55;">
                            @foreach (var pub in (verTodas ? Pausar : Pausar.Take(4)))
                            {
                                <div><span style="font-family:monospace;">@pub.MeliItemId</span> · @pub.Titulo@(pub.Estado == "paused" ? " · ya pausada" : "")</div>
                            }
                            @if (!verTodas && Pausar.Count > 4)
                            {
                                <a href="javascript:void(0)" @onclick="() => verTodas = true" style="color:#92400e; text-decoration:underline;">… y @(Pausar.Count - 4) más · ver todas</a>
                            }
                        </div>
                        <div style="font-size:0.78rem; margin-top:0.35rem;">Se pausan, no se finalizan: si te equivocaste, activás el producto y las prendés de nuevo.</div>
                    }
                    @if (Compartidas.Count > 0)
                    {
                        <div style="font-size:0.8rem; margin-top:@(Pausar.Count > 0 ? "0.5rem" : "0");">
                            <b>Siguen activas</b> porque tienen otros colores que sí se venden@(stockEnCero ? " (este color queda en 0)" : " — OJO: este color sigue con stock, mejor elegí stock en 0"):
                            @foreach (var pub in Compartidas)
                            {
                                <div><span style="font-family:monospace;">@pub.MeliItemId</span> · @pub.Titulo</div>
                            }
                        </div>
                    }
                </div>
            }

            <div style="display:flex; justify-content:flex-end; gap:0.5rem;">
                <button class="btn btn-secondary" disabled="@enviando" @onclick="Cerrar">Cancelar</button>
                <button class="btn" disabled="@enviando" @onclick="Confirmar"
                        style="background:#dc2626; color:#fff; border:none;">
                    @(enviando ? "Dando de baja…" : (Pausar.Count(x => x.Estado != "paused") > 0 ? "Dar de baja y pausar" : "Dar de baja"))
                </button>
            </div>
        }
    </div>
</div>

@code {
    [Parameter, EditorRequired] public int ProductoId { get; set; }
    [Parameter] public string? Nombre { get; set; }
    /// <summary>Pantalla desde donde se da de baja (queda anotado en el registro).</summary>
    [Parameter] public string Desde { get; set; } = "Productos";
    [Parameter] public EventCallback OnClose { get; set; }
    /// <summary>Se llama cuando el producto quedó dado de baja (para refrescar la lista).</summary>
    [Parameter] public EventCallback OnDadoDeBaja { get; set; }

    private ProductoBajaPreviewDto? dto;
    private ProductoBajaResultadoDto? resultado;
    private string? error;
    private bool stockEnCero = true;
    private bool verTodas;
    private bool enviando;

    private List<ProductoBajaPubliDto> Pausar => dto?.Publicaciones.Where(p => !p.CompartidaConOtrosColores).ToList() ?? new();
    private List<ProductoBajaPubliDto> Compartidas => dto?.Publicaciones.Where(p => p.CompartidaConOtrosColores).ToList() ?? new();
    private int YaPausadas => Pausar.Count(p => p.Estado == "paused");

    private string StockTxt => dto is null ? "" :
        dto.StockGramos > 0 ? $"{dto.StockGramos / 1000m:0.###} kg" : $"{dto.StockUnidades} u.";

    protected override async Task OnInitializedAsync()
    {
        try
        {
            dto = await Api.GetProductoBajaPreviewAsync(ProductoId);
            if (dto is null) error = "No se encontró el producto.";
            else if (dto.StockUnidades == 0 && dto.StockGramos == 0) stockEnCero = true;
        }
        catch (Exception ex) { error = "No se pudo cargar: " + ex.Message; }
    }

    private async Task Confirmar()
    {
        enviando = true;
        try
        {
            resultado = await Api.DarDeBajaProductoAsync(ProductoId, stockEnCero, Desde);
            if (resultado is null) { ToastService.Error("No se pudo dar de baja."); return; }
            if (resultado.Fallaron > 0) ToastService.Error(resultado.Mensaje);
            else ToastService.Success(resultado.Mensaje);
            await OnDadoDeBaja.InvokeAsync();
        }
        catch (Exception ex) { ToastService.Error("No se pudo dar de baja: " + ex.Message); }
        finally { enviando = false; }
    }

    private Task Cerrar() => enviando ? Task.CompletedTask : OnClose.InvokeAsync();
}
